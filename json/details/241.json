{"height": 12, "weight": 755, "base_experience": 172, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Milk Cow Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ミルタンク"}, {"language": "ja-roma", "name": "Miltank"}, {"language": "ko", "name": "밀탱크"}, {"language": "zh-hant", "name": "大奶罐"}, {"language": "fr", "name": "Écrémeuh"}, {"language": "de", "name": "Miltank"}, {"language": "es", "name": "Miltank"}, {"language": "it", "name": "Miltank"}, {"language": "ja", "name": "ミルタンク"}, {"language": "zh-hans", "name": "大奶罐"}, {"language": "es-419", "name": "Miltank"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "Its milk is packed with nutrition, making it the ultimate beverage for the sick or weary."}, {"versions": ["silver"], "text": "If it has just had a baby, the milk it produces con­ tains much more nutrition than usual."}, {"versions": ["crystal"], "text": "In order to milk a MILTANK, one must have a knack for rhythmically pull­ ing up and down on its udders."}, {"versions": ["ruby", "sapphire"], "text": "MILTANK gives over five gallons of milk on a daily basis. Its sweet milk is enjoyed by children and grown-ups alike. People who can’t drink milk turn it into yogurt and eat it instead."}, {"versions": ["emerald"], "text": "It gives over five gallons of milk daily. Its sweet milk is enjoyed by children and grown-ups alike. People who can’t drink milk turn it into yogurt and eat it instead."}, {"versions": ["firered"], "text": "If it has just had a baby, the milk it produces contains much more nutrition than usual."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It is said that kids who drink MILTANK’s milk grow up to become hearty, healthy adults."}, {"versions": ["soulsilver", "x"], "text": "If it is around babies, the milk it produces contains much more nutrition than usual."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "It is said that kids who drink Miltank’s milk grow up to become hearty, healthy adults."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Miltank gives over five gallons of milk on a daily basis. Its sweet milk is enjoyed by children and grown-ups alike. People who can’t drink milk turn it into yogurt and eat it instead."}, {"versions": ["sun"], "text": "Its milk is high in calories and packed with nutrients. Therefore, if you drink too much of it, you may wind up with a body like Miltank’s."}, {"versions": ["moon"], "text": "Most people raise it for its milk, but it’s quite tough and strong, so it’s also well suited for battle."}, {"versions": ["ultra-sun"], "text": "It produces over five gallons of milk a day. The higher the quality of the pastures it lives in, the richer and tastier its milk becomes."}, {"versions": ["ultra-moon"], "text": "Its milk is delicious and chock-full of nutrients. However, if you drink too much, it could make your stomach hurt, so be careful."}, {"versions": ["sword"], "text": "Miltank produces highly nutritious milk, so it’s been supporting the lives of people and other Pokémon since ancient times."}, {"versions": ["shield"], "text": "This Pokémon needs to be milked every day, or else it will fall ill. The flavor of Miltank milk changes with the seasons."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/241.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/241.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/241.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/241.png"}, "silver": {"normal": "https://raw.githubusercontent.c