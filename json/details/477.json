{"height": 22, "weight": 1066, "base_experience": 236, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-defense", "value": 2}], "genus": "Gripper Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヨノワール"}, {"language": "ja-roma", "name": "Yonoir"}, {"language": "ko", "name": "야느와르몽"}, {"language": "zh-hant", "name": "黑夜魔靈"}, {"language": "fr", "name": "Noctunoir"}, {"language": "de", "name": "Zwirrfinst"}, {"language": "es", "name": "Dusknoir"}, {"language": "it", "name": "Dusknoir"}, {"language": "ja", "name": "ヨノワール"}, {"language": "zh-hans", "name": "黑夜魔灵"}, {"language": "es-419", "name": "Dusknoir"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "y", "alpha-sapphire"], "text": "The antenna on its head captures radio waves from the world of spirits that command it to take people there."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x", "omega-ruby"], "text": "It is said to take lost spirits into its pliant body and guide them home."}, {"versions": ["heartgold", "soulsilver"], "text": "This feared Pokémon is said to travel to worlds unknown. Some even believe that it takes lost spirits along with it."}, {"versions": ["sword"], "text": "At the bidding of transmissions from the spirit world, it steals people and Pokémon away. No one knows whether it has a will of its own."}, {"versions": ["shield"], "text": "With the mouth on its belly, Dusknoir swallows its target whole. The soul is the only thing eaten— Dusknoir disgorges the body before departing."}, {"versions": ["legends-arceus"], "text": "Comes to those whose lives have come to an end and escorts their souls to the afterlife. Known to mistakenly take the souls of those who yet have life left in them, albeit rarely."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sp