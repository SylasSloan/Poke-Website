{"height": 17, "weight": 765, "base_experience": 169, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Coffin Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["mineral", "indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "デスカーン"}, {"language": "ja-roma", "name": "Desukarn"}, {"language": "ko", "name": "데스니칸"}, {"language": "zh-hant", "name": "死神棺"}, {"language": "fr", "name": "Tutankafer"}, {"language": "de", "name": "Echnatoll"}, {"language": "es", "name": "Cofagrigus"}, {"language": "it", "name": "Cofagrigus"}, {"language": "ja", "name": "デスカーン"}, {"language": "zh-hans", "name": "迭失棺"}, {"language": "es-419", "name": "Cofagrigus"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "It has been said that they swallow those who get too close and turn them into mummies. They like to eat gold nuggets."}, {"versions": ["white"], "text": "They pretend to be elaborate coffins to teach lessons to grave robbers. Their bodies are covered in pure gold."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "Grave robbers who mistake them for real coffins and get too close end up trapped inside their bodies."}, {"versions": ["sword"], "text": "This Pokémon has a body of sparkling gold. People say it no longer remembers that it was once human."}, {"versions": ["shield"], "text": "There are many depictions of Cofagrigus decorating ancient tombs. They’re symbols of the wealth that kings of bygone eras had."}], "sprites_by_gen": {"generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/563.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/563.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokem