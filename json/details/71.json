{"height": 17, "weight": 155, "base_experience": 221, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Flycatcher Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ウツボット"}, {"language": "ja-roma", "name": "Utsubot"}, {"language": "ko", "name": "우츠보트"}, {"language": "zh-hant", "name": "大食花"}, {"language": "fr", "name": "Empiflor"}, {"language": "de", "name": "Sarzenia"}, {"language": "es", "name": "Victreebel"}, {"language": "it", "name": "Victreebel"}, {"language": "ja", "name": "ウツボット"}, {"language": "zh-hans", "name": "大食花"}, {"language": "es-419", "name": "Victreebel"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x"], "text": "Said to live in huge colonies deep in jungles, although no one has ever returned from there."}, {"versions": ["yellow"], "text": "Lures prey with the sweet aroma of honey. Swallowed whole, the prey is melted in a day, bones and all."}, {"versions": ["gold"], "text": "ACID that has dis­ solved many prey becomes sweeter, making it even more effective at attracting prey."}, {"versions": ["silver"], "text": "This horrifying plant POKéMON at­ tracts prey with aromatic honey, then melts them in its mouth."}, {"versions": ["crystal"], "text": "Once ingested into this POKéMON's body, even the hardest object will melt into nothing."}, {"versions": ["ruby", "sapphire"], "text": "VICTREEBEL has a long vine that extends from its head. This vine is waved and flicked about as if it were an animal to attract prey. When an unsuspecting prey draws near, this POKéMON swallows it whole."}, {"versions": ["emerald"], "text": "The long vine extending from its head is waved about as if it were a living thing to attract prey. When an unsuspecting victim approaches, it is swallowed whole."}, {"versions": ["firered"], "text": "Lures prey into its mouth with a honeylike aroma. The helpless prey is melted with a dissolving fluid."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It pools in its mouth a fluid with a honeylike scent, which is really an acid that dissolves anything."}, {"versions": ["heartgold"], "text": "Acid that has dissolved many prey becomes sweeter, making it even more effective at attracting prey."}, {"versions": ["soulsilver"], "text": "This horrifying plant Pokémon attracts prey with aromatic honey, then melts them in its mouth."}, {"versions": ["black-2", "white-2"], "text": "It pools in its mouth a fluid with a honey-like scent, which is really an acid that dissolves anything."}, {"versions": ["y"], "text": "Once ingested into this Pokémon’s body, even the hardest object will melt into nothing."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Victreebel has a long vine that extends from its head. This vine is waved and flicked about as if it were an animal to attract prey. When an unsuspecting prey draws near, this Pokémon swallows it whole."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Lures prey with the sweet aroma of honey. Swallowed whole, the prey is dissolved in a day, bones and all."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/71.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/71.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/71.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/71.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/71.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/spri