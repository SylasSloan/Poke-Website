{"height": 11, "weight": 558, "base_experience": 158, "ev_yield": [{"stat": "hp", "value": 1}, {"stat": "attack", "value": 1}], "genus": "Swine Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "イノムー"}, {"language": "ja-roma", "name": "Inomoo"}, {"language": "ko", "name": "메꾸리"}, {"language": "zh-hant", "name": "長毛豬"}, {"language": "fr", "name": "Cochignon"}, {"language": "de", "name": "Keifel"}, {"language": "es", "name": "Piloswine"}, {"language": "it", "name": "Piloswine"}, {"language": "ja", "name": "イノムー"}, {"language": "zh-hans", "name": "长毛猪"}, {"language": "es-419", "name": "Piloswine"}], "pokedex_entries": [{"versions": ["crystal", "x", "shield"], "text": "Although its legs are short, its rugged hooves prevent it from slipping, even on icy ground."}, {"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "Because the long hair all over its body obscures its sight, it just keeps charging repeatedly."}, {"versions": ["silver"], "text": "If it charges at an enemy, the hairs on its back stand up straight. It is very sensi­ tive to sound."}, {"versions": ["ruby", "sapphire"], "text": "PILOSWINE is covered by a thick coat of long hair that enables it to endure the freezing cold. This POKéMON uses its tusks to dig up food that has been buried under ice."}, {"versions": ["emerald"], "text": "A PILOSWINE is covered by a thick coat of long hair for enduring freezing cold. It uses its tusks to dig up food that has been buried under ice."}, {"versions": ["firered", "soulsilver", "sword"], "text": "If it charges at an enemy, the hairs on its back stand up straight. It is very sensitive to sound."}, {"versions": ["diamond", "pearl"], "text": "Its shaggy coat makes it unable to see. It checks surroundings with its sensitive nose instead."}, {"versions": ["platinum", "black", "white"], "text": "Covered by a shaggy coat, it is strong aga