{"height": 5, "weight": 95, "base_experience": 53, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Flash Pokémon", "capture_rate": 235, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コリンク"}, {"language": "ja-roma", "name": "Kolink"}, {"language": "ko", "name": "꼬링크"}, {"language": "zh-hant", "name": "小貓怪"}, {"language": "fr", "name": "Lixy"}, {"language": "de", "name": "Sheinux"}, {"language": "es", "name": "Shinx"}, {"language": "it", "name": "Shinx"}, {"language": "ja", "name": "コリンク"}, {"language": "zh-hans", "name": "小猫怪"}, {"language": "es-419", "name": "Shinx"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "All of its fur dazzles if danger is sensed. It flees while the foe is momentarily blinded."}, {"versions": ["pearl"], "text": "Its forelegs have a muscle-based system of generating electricity. Its body shines if endangered."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x", "omega-ruby"], "text": "The extension and contraction of its muscles generates electricity. It glows when in trouble."}, {"versions": ["heartgold", "soulsilver"], "text": "The extension and contraction of its muscles generates electricity. Its fur glows when it’s in trouble."}, {"versions": ["sword"], "text": "This Pokémon generates electricity by contracting its muscles. Excited trembling is a sign that Shinx is generating a tremendous amount of electricity."}, {"versions": ["shield"], "text": "Electricity makes this Pokémon’s fur glow. Shinx sends signals to others of its kind by shaking the tip of its tail while the tail tip is shining brightly."}, {"versions": ["legends-arceus"], "text": "Shakes its body to generate electricity. Its stature belies its aggression—one must be patient to tame this Pokémon."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/Pok