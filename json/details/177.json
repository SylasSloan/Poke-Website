{"height": 2, "weight": 20, "base_experience": 64, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Tiny Bird Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ネイティ"}, {"language": "ja-roma", "name": "Naty"}, {"language": "ko", "name": "네이티"}, {"language": "zh-hant", "name": "天然雀"}, {"language": "fr", "name": "Natu"}, {"language": "de", "name": "Natu"}, {"language": "es", "name": "Natu"}, {"language": "it", "name": "Natu"}, {"language": "ja", "name": "ネイティ"}, {"language": "zh-hans", "name": "天然雀"}, {"language": "es-419", "name": "Natu"}], "pokedex_entries": [{"versions": ["gold"], "text": "Because its wings aren't yet fully grown, it has to hop to get around. It is always star­ ing at something."}, {"versions": ["silver", "firered", "soulsilver", "y"], "text": "It usually forages for food on the ground but may, on rare occasions, hop onto branches to peck at shoots."}, {"versions": ["crystal", "sword"], "text": "It is extremely good at climbing tree trunks and likes to eat the new sprouts on the trees."}, {"versions": ["ruby"], "text": "NATU cannot fly because its wings are not yet fully grown. If your eyes meet with this POKéMON’s eyes, it will stare back intently at you. But if you move even slightly, it will hop away to safety."}, {"versions": ["sapphire"], "text": "NATU has a highly developed jumping ability. The POKéMON flaps and leaps onto tree branches that are taller than grown-up people to pick at the tree’s new shoots."}, {"versions": ["emerald"], "text": "It runs up short trees that grow on the savanna to peck at new shoots. A NATU’s eyes look as if they are always observing something."}, {"versions": ["leafgreen", "heartgold", "x", "shield"], "text": "Because its wings aren’t yet fully grown, it has to hop to get around. It is always staring at something."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It picks food from cactus plants, deftly avoiding buds and spines. It seems to skip about to move."}, {"versions": ["omega-ruby"], "text": "Natu cannot fly because its wings are not yet fully grown. If your eyes meet with this Pokémon’s eyes, it will stare back intently at you. But if you move even slightly, it will hop away to safety."}, {"versions": ["alpha-sapphire"], "text": "Natu has a highly developed jumping ability. The Pokémon flaps and leaps onto tree branches that are taller than grown-up people to pick at the tree’s new shoots."}, {"versions": ["ultra-sun"], "text": "Although it still can’t fly, its jumping power is outstanding. It jumps way up into trees and plucks the buds from the branches."}, {"versions": ["ultra-moon"], "text": "The look in its eyes gives the impression that it’s carefully observing you. If you approach it, Natu will hop away."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/177.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/177.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/177.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/177.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/177.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/177.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/177.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versi