{"height": 12, "weight": 2025, "base_experience": 147, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Iron Claw Pokémon", "capture_rate": 3, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "メタング"}, {"language": "ja-roma", "name": "Metang"}, {"language": "ko", "name": "메탕구"}, {"language": "zh-hant", "name": "金屬怪"}, {"language": "fr", "name": "Métang"}, {"language": "de", "name": "Metang"}, {"language": "es", "name": "Metang"}, {"language": "it", "name": "Metang"}, {"language": "ja", "name": "メタング"}, {"language": "zh-hans", "name": "金属怪"}, {"language": "es-419", "name": "Metang"}], "pokedex_entries": [{"versions": ["ruby"], "text": "When two BELDUM fuse together, METANG is formed. The brains of the BELDUM are joined by a magnetic nervous system. By linking its brains magnetically, this POKéMON generates strong psychokinetic power."}, {"versions": ["sapphire"], "text": "When two BELDUM fuse together, METANG is formed. The brains of the BELDUM are joined by a magnetic nervous system. This POKéMON turns its arms to the rear for traveling at high speed."}, {"versions": ["emerald"], "text": "The claws tipping its arms pack the destructive power to tear through thick iron sheets as if they were silk. It flies at over 60 miles per hour."}, {"versions": ["firered", "leafgreen"], "text": "It floats midair using magnetism. Its body is so tough, even a crash with a jet plane won’t leave a scratch."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It is formed by two BELDUM joining together. Its steel body won’t be scratched if it collides with a jet."}, {"versions": ["heartgold", "soulsilver"], "text": "When two BELDUM fuse together, a magnetic nervous system places their brains in union."}, {"versions": ["black", "white", "x"], "text": "It is formed by two Beldum joining together. Its steel body won’t be scratched if it collides with a jet."}, {"versions": ["black-2", "white-2", "y"], "text": "It is formed by two Beldum joining together. Its two brains are linked, amplifying its psychic power."}, {"versions": ["omega-ruby"], "text": "When two Beldum fuse together, Metang is formed. The brains of the Beldum are joined by a magnetic nervous system. By linking its brains magnetically, this Pokémon generates strong psychokinetic power."}, {"versions": ["alpha-sapphire"], "text": "When two Beldum fuse together, Metang is formed. The brains of the Beldum are joined by a magnetic nervous system. This Pokémon turns its arms to the rear for traveling at high speed."}, {"versions": ["sun"], "text": "When two Beldum link together, their psychic power is doubled. Their intelligence, however, remains unchanged."}, {"versions": ["moon"], "text": "It adores magnetic minerals, so it pursues Nosepass at speeds exceeding 60 mph."}, {"versions": ["ultra-sun"], "text": "With its two brains, it fires powerful psychic energy to stop its prey in their tracks."}, {"versions": ["ultra-moon"], "text": "It flies at high speeds around the skies. When it finds its prey, Metang takes a firm grip with its sharp claws and never lets go."}, {"versions": ["sword"], "text": "Two Beldum have become stuck together via their own magnetic forces. With two brains, the resulting Metang has doubled psychic powers."}, {"versions": ["shield"], "text": "Using magnetic forces to stay aloft, this Pokémon flies at high speeds, weaving through harsh mountain terrain in pursuit of prey."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/375.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/375.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/375.png", "shiny": "https://raw.git