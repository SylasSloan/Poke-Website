{"height": 2, "weight": 9, "base_experience": 130, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Single Bloom Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["fairy"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "フラエッテ"}, {"language": "ja-roma", "name": "Floette"}, {"language": "ko", "name": "플라엣테"}, {"language": "zh-hant", "name": "花葉蒂"}, {"language": "fr", "name": "Floette"}, {"language": "de", "name": "Floette"}, {"language": "es", "name": "Floette"}, {"language": "it", "name": "Floette"}, {"language": "ja", "name": "フラエッテ"}, {"language": "zh-hans", "name": "花叶蒂"}, {"language": "es-419", "name": "Floette"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "It flutters around fields of flowers and cares for flowers that are starting to wilt. It draws out the hidden power of flowers to battle."}, {"versions": ["y", "alpha-sapphire"], "text": "When the flowers of a well-tended flower bed bloom, it appears and celebrates with an elegant dance."}, {"versions": ["ultra-sun"], "text": "It raises flowers and uses them as weapons. The more gorgeous the blossom, the more power it contains."}, {"versions": ["ultra-moon"], "text": "It gives its own power to flowers, pouring its heart into caring for them. Floette never forgives anyone who messes up a flower bed."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/670.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/670.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/670.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites