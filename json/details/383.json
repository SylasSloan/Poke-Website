{"height": 35, "weight": 9500, "base_experience": 302, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Continent Pokémon", "capture_rate": 3, "base_happiness": 0, "hatch_counter": 120, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "グラードン"}, {"language": "ja-roma", "name": "Groudon"}, {"language": "ko", "name": "그란돈"}, {"language": "zh-hant", "name": "固拉多"}, {"language": "fr", "name": "Groudon"}, {"language": "de", "name": "Groudon"}, {"language": "es", "name": "Groudon"}, {"language": "it", "name": "Groudon"}, {"language": "ja", "name": "グラードン"}, {"language": "zh-hans", "name": "固拉多"}, {"language": "es-419", "name": "Groudon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "GROUDON has long been described in mythology as the POKéMON that raised lands and expanded continents. This POKéMON took to sleep after a cataclysmic battle with KYOGRE."}, {"versions": ["sapphire"], "text": "GROUDON has the power to scatter rain clouds and make water evaporate with light and heat. It came as a savior to people who had been suffering from terrible floods."}, {"versions": ["emerald"], "text": "GROUDON has appeared in mythology as the creator of the land. It sleeps in magma underground and is said to make volcanoes erupt on awakening."}, {"versions": ["firered", "leafgreen"], "text": "This legendary POKéMON is said to represent the land. It went to sleep after dueling KYOGRE."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It had been asleep in underground magma ever since it fiercely fought KYOGRE long ago."}, {"versions": ["heartgold", "soulsilver"], "text": "Said to have expanded the lands by evaporating water with raging heat. It battled titanically with KYOGRE."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "It had been asleep in underground magma ever since it fiercely fought Kyogre long ago."}, {"versions": ["x"], "text": "Said to have expanded the lands by evaporating water with raging heat. It battled titanically with Kyogre."}, {"versions": ["y"], "text": "This legendary Pokémon is said to represent the land. It went to sleep after dueling Kyogre."}, {"versions": ["omega-ruby"], "text": "Groudon is said to be the personification of the land itself. Legends tell of its many clashes against Kyogre, as each sought to gain the power of nature."}, {"versions": ["alpha-sapphire"], "text": "Through Primal Reversion and with nature’s full power, it will take back its true form. It can cause magma to erupt and expand the landmass of the world."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/383.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/383.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/383.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/383.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/383.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/383.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/383.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/383.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/383.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/