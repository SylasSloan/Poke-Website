{"height": 7, "weight": 152, "base_experience": 58, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Desert Croc Pokémon", "capture_rate": 180, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "メグロコ"}, {"language": "ja-roma", "name": "Meguroco"}, {"language": "ko", "name": "깜눈크"}, {"language": "zh-hant", "name": "黑眼鱷"}, {"language": "fr", "name": "Mascaïman"}, {"language": "de", "name": "Ganovil"}, {"language": "es", "name": "Sandile"}, {"language": "it", "name": "Sandile"}, {"language": "ja", "name": "メグロコ"}, {"language": "zh-hans", "name": "黑眼鳄"}, {"language": "es-419", "name": "Sandile"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "They live buried in the sands of the desert. The sun-warmed sands prevent their body temperature from dropping."}, {"versions": ["white", "x", "omega-ruby"], "text": "It moves along below the sand’s surface, except for its nose and eyes. A dark membrane shields its eyes from the sun."}, {"versions": ["black-2", "white-2"], "text": "They live hidden under hot desert sands in order to keep their body temperature from dropping."}, {"versions": ["sun"], "text": "It submerges itself in sand and moves as if swimming. This wise behavior keeps its enemies from finding it and maintains its temperature."}, {"versions": ["moon"], "text": "It conceals itself in the sand and chomps down on the legs of any prey that unwarily walk over it. Its favorite food is Trapinch."}, {"versions": ["ultra-sun"], "text": "Alola, where it’s warm all year round, is a comfortable environment for this Pokémon. Sometimes you’ll even see it outside of deserts."}, {"versions": ["ultra-moon"], "text": "Sandile’s still not good at hunting, so it mostly eats things that have collapsed in the desert. It’s called “the cleaner of the desert.”"}, {"versions": ["sword"], "text": "The desert gets cold at night, so when the sun sets, this Pokémon burrows deep into the sand and sleeps until sunrise."}, {"versions": ["shield"], "text": "Sandile is small, but its legs and lower body are powerful. Pushing sand aside as it goes, Sandile moves through the desert as if it’s swimming."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/551.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/551.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/551.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/551.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/551.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/551.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/551.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/551.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/551.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/551.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/551.png", "shiny": null}}}, "m