{"height": 20, "weight": 1286, "base_experience": 187, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Vine Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "モジャンボ"}, {"language": "ja-roma", "name": "Mojumbo"}, {"language": "ko", "name": "덩쿠림보"}, {"language": "zh-hant", "name": "巨蔓藤"}, {"language": "fr", "name": "Bouldeneu"}, {"language": "de", "name": "Tangoloss"}, {"language": "es", "name": "Tangrowth"}, {"language": "it", "name": "Tangrowth"}, {"language": "ja", "name": "モジャンボ"}, {"language": "zh-hans", "name": "巨蔓藤"}, {"language": "es-419", "name": "Tangrowth"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "x", "omega-ruby"], "text": "It ensnares prey by extending arms made of vines. Losing arms to predators does not trouble it."}, {"versions": ["platinum", "black", "white"], "text": "Its arms are made of plants that bind themselves to things. They grow back right away if cut."}, {"versions": ["heartgold"], "text": "When it remains still, it appears to be a large shrub. Unsuspecting prey that wander near get ensnared by its vines."}, {"versions": ["soulsilver", "y", "alpha-sapphire"], "text": "Its vines grow so profusely that, in the warm season, you can’t even see its eyes."}, {"versions": ["black-2", "white-2"], "text": "Even if one of its arms is eaten, it’s fine. The Pokémon regenerates quickly and will go right back to normal."}, {"versions": ["sword"], "text": "Tangrowth has two arms that it can extend as it pleases. Recent research has shown that these arms are, in fact, bundles of vines."}, {"versions": ["shield"], "text": "Vine growth is accelerated for Tangrowth living in warm climates. If the vines grow long, Tangrowth shortens them by tearing parts of them off."}, {"versions": ["legends-arceus"], "text": "Draped with long vines, it resembles a shrub in appearance. It swings bundles of vines as though they were arms, wrapping them around prey to ensnare them."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/465.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/465.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/465.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/465.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/465.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/465.png"}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/465.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/465.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/465.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/465.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/465.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/465.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/465.