{"height": 6, "weight": 310, "base_experience": 66, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Trash Bag Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤブクロン"}, {"language": "ja-roma", "name": "Yabukuron"}, {"language": "ko", "name": "깨봉이"}, {"language": "zh-hant", "name": "破破袋"}, {"language": "fr", "name": "Miamiasme"}, {"language": "de", "name": "Unratütox"}, {"language": "es", "name": "Trubbish"}, {"language": "it", "name": "Trubbish"}, {"language": "ja", "name": "ヤブクロン"}, {"language": "zh-hans", "name": "破破袋"}, {"language": "es-419", "name": "Trubbish"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "Inhaling the gas they belch will make you sleep for a week. They prefer unsanitary places."}, {"versions": ["white", "x", "omega-ruby"], "text": "The combination of garbage bags and industrial waste caused the chemical reaction that created this Pokémon."}, {"versions": ["black-2", "white-2"], "text": "Wanting more garbage, they follow people who litter. They always belch poison gas."}, {"versions": ["sun"], "text": "Unsanitary places are what they like best. They can be spotted in Alola, often with Grimer in hot pursuit."}, {"versions": ["moon"], "text": "It gorges on trash until its stomach is full. Then it belches toxic gas. An unlucky whiff of gas will put a person in the hospital."}, {"versions": ["ultra-sun"], "text": "Poisonous gas leaks out of it when it breathes. Muk that catch a whiff of that stench will come drooling."}, {"versions": ["ultra-moon"], "text": "If a young Pokémon or child breathes in the toxic gas that Trubbish belches out, it could be a life-threatening situation."}, {"versions": ["sword"], "text": "Its favorite places are unsanitary ones. If you leave trash lying around, you could even find one of these Pokémon living in your room."}, {"versions": ["shield"], "