{"height": 2, "weight": 7, "base_experience": 167, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Disguise Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ミミッキュ"}, {"language": "ja-roma", "name": "Mimikkyu"}, {"language": "ko", "name": "따라큐"}, {"language": "zh-hant", "name": "謎擬Ｑ"}, {"language": "fr", "name": "Mimiqui"}, {"language": "de", "name": "Mimigma"}, {"language": "es", "name": "Mimikyu"}, {"language": "it", "name": "Mimikyu"}, {"language": "ja", "name": "ミミッキュ"}, {"language": "zh-hans", "name": "谜拟丘"}, {"language": "es-419", "name": "Mimikyu"}], "pokedex_entries": [{"versions": ["sun"], "text": "Its actual appearance is unknown. A scholar who saw what was under its rag was overwhelmed by terror and died from the shock."}, {"versions": ["moon"], "text": "A lonely Pokémon, it conceals its terrifying appearance beneath an old rag so it can get closer to people and other Pokémon."}, {"versions": ["ultra-sun"], "text": "Although it’s a quiet, lonely Pokémon, if you try to look at what’s under its rag, it will become agitated and resist violently."}, {"versions": ["ultra-moon"], "text": "A gust of wind revealed what hides under this Pokémon’s rag to a passing Trainer, who went home and died painfully that very night."}, {"versions": ["sword"], "text": "It wears a rag fashioned into a Pikachu costume in an effort to look less scary. Unfortunately, the costume only makes it creepier."}, {"versions": ["shield"], "text": "There was a scientist who peeked under Mimikyu’s old rag in the name of research. The scientist died of a mysterious disease."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/778.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.gi