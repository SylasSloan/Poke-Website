{"height": 4, "weight": 200, "base_experience": 60, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Rock Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "イシツブテ"}, {"language": "ja-roma", "name": "Isitsubute"}, {"language": "ko", "name": "꼬마돌"}, {"language": "zh-hant", "name": "小拳石"}, {"language": "fr", "name": "Racaillou"}, {"language": "de", "name": "Kleinstein"}, {"language": "es", "name": "Geodude"}, {"language": "it", "name": "Geodude"}, {"language": "ja", "name": "イシツブテ"}, {"language": "zh-hans", "name": "小拳石"}, {"language": "es-419", "name": "Geodude"}], "pokedex_entries": [{"versions": ["x", "red", "blue", "leafgreen"], "text": "Found in fields and mountains. Mistaking them for boulders, people often step or trip on them."}, {"versions": ["yellow"], "text": "Commonly found near mountain trails, etc. If you step on one by accident, it gets angry."}, {"versions": ["gold", "heartgold"], "text": "Most people may not notice, but a closer look should reveal that there are many GEODUDE around."}, {"versions": ["silver", "soulsilver"], "text": "It uses its arms to steadily climb steep mountain paths. It swings its fists around if angered."}, {"versions": ["crystal"], "text": "Proud of their sturdy bodies, they bash against each other in a contest to prove whose is harder."}, {"versions": ["ruby"], "text": "The longer a GEODUDE lives, the more its edges are chipped and worn away, making it more rounded in appearance. However, this POKéMON’s heart will remain hard, craggy, and rough always."}, {"versions": ["sapphire"], "text": "When GEODUDE sleeps deeply, it buries itself halfway into the ground. It will not awaken even if hikers step on it unwittingly. In the morning, this POKéMON rolls downhill in search of food."}, {"versions": ["emerald"], "text": "It climbs mountain paths using only the power of its arms. Because they look just like boulders lining paths, hikers may step on them without noticing."}, {"versions": ["firered"], "text": "Its round form makes it easy to pick up. Some people have used them to hurl at each other in a snowball fight."}, {"versions": ["diamond"], "text": "Many live on mountain trails and remain half buried while keeping an eye on climbers."}, {"versions": ["pearl", "y"], "text": "It is impossible to distinguish from rocks. It slams against others in contests of hardness."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "At rest, it looks just like a rock. Carelessly stepping on it will make it swing its fists angrily."}, {"versions": ["omega-ruby"], "text": "The longer a Geodude lives, the more its edges are chipped and worn away, making it more rounded in appearance. However, this Pokémon’s heart will remain hard, craggy, and rough always."}, {"versions": ["alpha-sapphire"], "text": "When Geodude sleeps deeply, it buries itself halfway into the ground. It will not awaken even if hikers step on it unwittingly. In the morning, this Pokémon rolls downhill in search of food."}, {"versions": ["sun"], "text": "Its round body makes it easy to pick up, but it is hard and heavy. It’s dangerous to play with them as if they were snowballs."}, {"versions": ["moon"], "text": "There are plenty of them to be found along any road. A scholar with too much free time once counted a hundred of them along a single route."}, {"versions": ["ultra-sun"], "text": "Geodude that have lived a long life have had all their edges smoothed out until they’re totally round. They also have a calm, quiet disposition."}, {"versions": ["ultra-moon"], "text": "It uses both hands to climb precipitous cliffs. People who see it in action have been known to take up bouldering."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Commonly found near mountain trails and the like. If you step on one by accident, it gets angry."}, {"versions": ["legends-arceus"], "text": "Makes its home in mountainous regions, using its arms to climb along harsh mountain roads. Can be troublesome—carelessly kicking one will cause it to fly into a rage and chase after you."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/74.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/74.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/74.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/74.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/74.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/74.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/74.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/74.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/74.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/74.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/74.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/74.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/P