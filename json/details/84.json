{"height": 14, "weight": 392, "base_experience": 62, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Twin Bird Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドードー"}, {"language": "ja-roma", "name": "Dodo"}, {"language": "ko", "name": "두두"}, {"language": "zh-hant", "name": "嘟嘟"}, {"language": "fr", "name": "Doduo"}, {"language": "de", "name": "Dodu"}, {"language": "es", "name": "Doduo"}, {"language": "it", "name": "Doduo"}, {"language": "ja", "name": "ドードー"}, {"language": "zh-hans", "name": "嘟嘟"}, {"language": "es-419", "name": "Doduo"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "A bird that makes up for its poor flying with its fast foot speed. Leaves giant footprints."}, {"versions": ["yellow"], "text": "Its short wings make flying dif­ ficult. Instead, this POKéMON runs at high speed on developed legs."}, {"versions": ["gold"], "text": "By alternately raising and lower­ ing its two heads, it balances itself to be more stable while running."}, {"versions": ["silver", "soulsilver"], "text": "It races through grassy plains with powerful strides, leaving footprints up to four inches deep."}, {"versions": ["crystal"], "text": "It lives on a grassy plain where it can see a long way. If it sees an enemy, it runs away at 60 mph."}, {"versions": ["ruby"], "text": "DODUO’s two heads never sleep at the same time. Its two heads take turns sleeping, so one head can always keep watch for enemies while the other one sleeps."}, {"versions": ["sapphire"], "text": "DODUO’s two heads contain completely identical brains. A scientific study reported that on rare occasions, there will be examples of this POKéMON possessing different sets of brains."}, {"versions": ["emerald"], "text": "Even while eating or sleeping, one of the heads remains always vigilant for any sign of danger. When threatened, it flees at over 60 miles per hour."}, {"versions": ["firered"], "text": "A two-headed POKéMON that was discovered as a sudden mutation. It runs at a pace of over 60 miles per hour."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "The brains in its two heads appear to communicate emotions to each other with a telepathic power."}, {"versions": ["heartgold"], "text": "By alternately raising and lowering its two heads, it balances itself to be more stable while running."}, {"versions": ["x"], "text": "A two-headed Pokémon that was discovered as a sudden mutation. It runs at a pace of over 60 miles per hour."}, {"versions": ["omega-ruby"], "text": "Doduo’s two heads never sleep at the same time. Its two heads take turns sleeping, so one head can always keep watch for enemies while the other one sleeps."}, {"versions": ["alpha-sapphire"], "text": "Doduo’s two heads contain completely identical brains. A scientific study reported that on rare occasions, there will be examples of this Pokémon possessing different sets of brains."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its short wings make flying difficult. Instead, this Pokémon runs at high speed on developed legs."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/84.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/84.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/84.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/84.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/84.png", "sh