{"height": 14, "weight": 270, "base_experience": 159, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Bug Catcher Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マスキッパ"}, {"language": "ja-roma", "name": "Muskippa"}, {"language": "ko", "name": "무스틈니"}, {"language": "zh-hant", "name": "尖牙籠"}, {"language": "fr", "name": "Vortente"}, {"language": "de", "name": "Venuflibis"}, {"language": "es", "name": "Carnivine"}, {"language": "it", "name": "Carnivine"}, {"language": "ja", "name": "マスキッパ"}, {"language": "zh-hans", "name": "尖牙笼"}, {"language": "es-419", "name": "Carnivine"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It attracts prey with its sweet- smelling saliva, then chomps down. It takes a whole day to eat prey."}, {"versions": ["pearl"], "text": "Hanging from branches using its tentacles, it looks like a plant. It awaits prey, mouth wide open."}, {"versions": ["platinum", "black", "white"], "text": "It binds itself to trees in marshes. It attracts prey with its sweet- smelling drool and gulps them down."}, {"versions": ["heartgold", "soulsilver"], "text": "It walks around on its tentacles in search of a tree branch where it can dangle down and ambush prey."}, {"versions": ["black-2", "white-2"], "text": "Using its tentacles to lash itself to trees, it lies in wait for prey, luring it close with sweet-smelling drool."}, {"versions": ["x", "omega-ruby"], "text": "It attracts prey with its sweet-smelling saliva, then chomps down. It takes a whole day to eat prey."}, {"versions": ["y", "alpha-sapphire"], "text": "It binds itself to trees in marshes. It attracts prey with its sweet-smelling drool and gulps them down."}, {"versions": ["legends-arceus"], "text": "Though this is a plant Pokémon, it has a gluttonous and unruly temperament. Carnivine attacks its prey with its cavernous maw wide open."}], "sprites_by_gen"