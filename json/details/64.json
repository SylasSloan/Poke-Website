{"height": 13, "weight": 565, "base_experience": 140, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Psi Pokémon", "capture_rate": 100, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "ユンゲラー"}, {"language": "ja-roma", "name": "Yungerer"}, {"language": "ko", "name": "윤겔라"}, {"language": "zh-hant", "name": "勇基拉"}, {"language": "fr", "name": "Kadabra"}, {"language": "de", "name": "Kadabra"}, {"language": "es", "name": "Kadabra"}, {"language": "it", "name": "Kadabra"}, {"language": "ja", "name": "ユンゲラー"}, {"language": "zh-hans", "name": "勇基拉"}, {"language": "es-419", "name": "Kadabra"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "It emits special alpha waves from its body that induce headaches just by being close by."}, {"versions": ["yellow"], "text": "Many odd things happen if this POKéMON is close by. For example, it makes clocks run backwards."}, {"versions": ["gold", "heartgold"], "text": "It possesses strong spiritual power. The more danger it faces, the stronger its psychic power."}, {"versions": ["silver", "soulsilver", "y"], "text": "If it uses its abilities, it emits special alpha waves that cause machines to malfunction."}, {"versions": ["crystal"], "text": "When it closes its eyes, twice as many alpha parti­ cles come out of the surface of its body."}, {"versions": ["ruby"], "text": "KADABRA emits a peculiar alpha wave if it develops a headache. Only those people with a particularly strong psyche can hope to become a TRAINER of this POKéMON."}, {"versions": ["sapphire"], "text": "KADABRA holds a silver spoon in its hand. The spoon is used to amplify the alpha waves in its brain. Without the spoon, the POKéMON is said to be limited to half the usual amount of its telekinetic powers."}, {"versions": ["emerald"], "text": "It is rumored that a boy with psychic abilities suddenly transformed into KADABRA while he was assisting research into extrasensory powers."}, {"versions": ["firered"], "text": "It happened one morning - a boy with extrasensory powers awoke in bed transformed into KADABRA."}, {"versions": ["leafgreen"], "text": "It emits special alpha waves from its body that induce headaches just by being close."}, {"versions": ["diamond"], "text": "If one is nearby, an eerie shadow appears on TV screens. Seeing the shadow is said to bring bad luck."}, {"versions": ["pearl"], "text": "When it uses its psychic power, it emits strong ha waves that can ruin precision devices."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It stares at its silver spoon to focus its mind. It emits more alpha waves while doing so."}, {"versions": ["x"], "text": "When it uses its psychic power, it emits strong alpha waves that can ruin precision devices."}, {"versions": ["omega-ruby"], "text": "Kadabra emits a peculiar alpha wave if it develops a headache. Only those people with a particularly strong psyche can hope to become a Trainer of this Pokémon."}, {"versions": ["alpha-sapphire"], "text": "Kadabra holds a silver spoon in its hand. The spoon is used to amplify the alpha waves in its brain. Without the spoon, the Pokémon is said to be limited to half the usual amount of its telekinetic powers."}, {"versions": ["sun"], "text": "A theory exists that this Pokémon was a young boy who couldn’t control his psychic powers and ended up transformed into this Pokémon."}, {"versions": ["moon"], "text": "Kadabra’s presence infests televisions and monitors with creepy shadows that bring bad luck."}, {"versions": ["ultra-sun"], "text": "It stares at a silver spoon to amplify its psychic powers before it lets loose. Apparently, gold spoons are no good."}, {"versions": ["ultra-moon"], "text": "It possesses strong mental capabilities, but its psychic powers are halved when it’s not holding a silver spoon."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Many odd things happen if this Pokémon is close by. For example, it makes clocks run backward."}, {"versions": ["sword"], "text": "Using its psychic power, Kadabra levitates as it sleeps. It uses its springy tail as a pillow."}, {"versions": ["shield"], "text": "This Pokémon’s telekinesis is immensely powerful. To prepare for evolution, Kadabra stores up psychic energy in the star on its forehead."}, {"versions": ["legends-arceus"], "text": "There are rumors that a child with mystical powers became a Kadabra; however, this remains unverified. I suspect that the spoon Kadabra holds enhances its brain waves."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/64.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/64.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/64.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/64.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/64.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/64.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/64.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/64.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/64.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g