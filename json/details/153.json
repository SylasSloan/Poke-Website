{"height": 12, "weight": 158, "base_experience": 142, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Leaf Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "plant"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ベイリーフ"}, {"language": "ja-roma", "name": "Bayleaf"}, {"language": "ko", "name": "베이리프"}, {"language": "zh-hant", "name": "月桂葉"}, {"language": "fr", "name": "Macronium"}, {"language": "de", "name": "Lorblatt"}, {"language": "es", "name": "Bayleef"}, {"language": "it", "name": "Bayleef"}, {"language": "ja", "name": "ベイリーフ"}, {"language": "zh-hans", "name": "月桂叶"}, {"language": "es-419", "name": "Bayleef"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold"], "text": "The scent of spices comes from around its neck. Somehow, sniffing it makes you want to fight."}, {"versions": ["silver"], "text": "A spicy aroma ema­ nates from around its neck. The aroma acts as a stimulant to re­ store health."}, {"versions": ["crystal"], "text": "The scent that wafts from the leaves on its neck causes anyone who smells it to become energetic."}, {"versions": ["ruby", "sapphire"], "text": "BAYLEEF’s neck is ringed by curled-up leaves. Inside each tubular leaf is a small shoot of a tree. The fragrance of this shoot makes people peppy."}, {"versions": ["emerald"], "text": "A BAYLEEF’s neck is ringed by curled-up leaves. Inside each leaf is a small tree shoot. The fragrance of this shoot makes people peppy."}, {"versions": ["firered", "soulsilver", "x"], "text": "A spicy aroma emanates from around its neck. The aroma acts as a stimulant to restore health."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "The buds that ring its neck give off a spicy aroma that perks people up."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Bayleef’s neck is ringed by curled-u