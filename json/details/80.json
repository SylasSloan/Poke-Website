{"height": 16, "weight": 785, "base_experience": 172, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Hermit Crab Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster", "water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤドラン"}, {"language": "ja-roma", "name": "Yadoran"}, {"language": "ko", "name": "야도란"}, {"language": "zh-hant", "name": "呆殼獸"}, {"language": "fr", "name": "Flagadoss"}, {"language": "de", "name": "Lahmus"}, {"language": "es", "name": "Slowbro"}, {"language": "it", "name": "Slowbro"}, {"language": "ja", "name": "ヤドラン"}, {"language": "zh-hans", "name": "呆壳兽"}, {"language": "es-419", "name": "Slowbro"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The SHELLDER that is latched onto SLOWPOKE's tail is said to feed on the host's left over scraps."}, {"versions": ["yellow"], "text": "Lives lazily by the sea. If the SHELLDER on its tail comes off, it becomes a SLOWPOKE again."}, {"versions": ["gold"], "text": "If the tail-biting SHELLDER is thrown off in a harsh battle, it reverts to being an ordi­ nary SLOWPOKE."}, {"versions": ["silver"], "text": "Naturally dull to begin with, it lost its ability to feel pain due to SHELLDER's seeping poison."}, {"versions": ["crystal"], "text": "An attached SHELLDER won't let go because of the tasty flavor that oozes out of its tail."}, {"versions": ["ruby", "sapphire"], "text": "SLOWBRO’s tail has a SHELLDER firmly attached with a bite. As a result, the tail can’t be used for fishing anymore. This causes SLOWBRO to grudgingly swim and catch prey instead."}, {"versions": ["emerald"], "text": "Its tail has a SHELLDER firmly attached with a bite. As a result, the tail can’t be used for fishing anymore. This forces it to reluctantly swim and catch prey."}, {"versions": ["firered"], "text": "When a SLOWPOKE went hunting in the sea, its tail was bitten by a SHELLDER. That made it evolve into SLOWBRO."}, {"versions": ["leafgreen"], "text": "The SHELLDER that latches onto SLOWPOKE’s tail is said to feed on the host’s leftover scraps."}, {"versions": ["diamond", "pearl", "platinum"], "text": "Though usually dim witted, it seems to become inspired if the SHELLDER on its tail bites down."}, {"versions": ["heartgold"], "text": "If the tail-biting SHELLDER is thrown off in a harsh battle, it reverts to being an ordinary SLOWPOKE."}, {"versions": ["soulsilver"], "text": "Naturally dull to begin with, it lost its ability to feel pain due to SHELLDER’s seeping poison."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "Though usually dim witted, it seems to become inspired if the Shellder on its tail bites down."}, {"versions": ["x"], "text": "An attached Shellder won’t let go because of the tasty flavor that oozes out of its tail."}, {"versions": ["y"], "text": "When a Slowpoke went hunting in the sea, its tail was bitten by a Shellder. That made it evolve into Slowbro."}, {"versions": ["ultra-sun"], "text": "Spacing out is basically all it does. It turns back into Slowpoke if its tail, along with Shellder, breaks off."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Slowbro’s tail has a Shellder firmly attached with a bite. As a result, the tail can’t be used for fishing anymore. This causes Slowbro to grudgingly swim and catch prey instead."}, {"versions": ["sun"], "text": "It spaces out while gazing at the sea. With Shellder’s poison flowing through its body, it becomes even spacier."}, {"versions": ["moon"], "text": "Whenever Shellder bites down hard on its tail, it gives Slowbro a flash of inspiration...which it forgets a moment later."}, {"versions": ["ultra-moon"], "text": "Shellder, in its greed to suck out more and more sweetness from Slowbro’s tail, has metamorphosed into a spiral-shaped shell."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Lives lazily by the sea. If the Shellder on its tail comes off, it becomes a Slowpoke again."}, 