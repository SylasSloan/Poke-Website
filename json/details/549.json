{"height": 11, "weight": 163, "base_experience": 168, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Flowering Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["plant"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ドレディア"}, {"language": "ja-roma", "name": "Dredear"}, {"language": "ko", "name": "드레디어"}, {"language": "zh-hant", "name": "裙兒小姐"}, {"language": "fr", "name": "Fragilady"}, {"language": "de", "name": "Dressella"}, {"language": "es", "name": "Lilligant"}, {"language": "it", "name": "Lilligant"}, {"language": "ja", "name": "ドレディア"}, {"language": "zh-hans", "name": "裙儿小姐"}, {"language": "es-419", "name": "Lilligant"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "Even veteran Trainers face a challenge in getting its beautiful flower to bloom. This Pokémon is popular with celebrities."}, {"versions": ["white", "x", "omega-ruby"], "text": "The fragrance of the garland on its head has a relaxing effect. It withers if a Trainer does not take good care of it."}, {"versions": ["black-2", "white-2"], "text": "The fragrance of the garland on its head has a relaxing effect, but taking care of it is very difficult."}, {"versions": ["sun"], "text": "No matter how much time and money is spent raising it, its flowers are the most beautiful when they bloom in the wild."}, {"versions": ["moon"], "text": "As soon as it finds a male to be its partner, the beautiful flower on its head darkens, droops, and withers away."}, {"versions": ["ultra-sun"], "text": "The fragrance of its flower differs slightly depending on the soil where it grew up. Sniffing the aroma calms your heart and mind."}, {"versions": ["ultra-moon"], "text": "It’s well liked by other Pokémon because of its beauty. The flower on its head needs constant care, or it will soon wither and rot."}, {"versions": ["sword"], "text": "It’s believed that even first-rate gardeners have a hard time getting the flower on a Lilligant’s head to bloom."}, {"versions": ["shield"], "text": "Essential oils made from Lilligant flowers have a sublime scent, but they’re also staggeringly expensive."}, {"versions": ["legends-arceus"], "text": "I suspect that its well-developed legs are the result of a life spent on mountains covered in deep snow. The scent it exudes from its flower crown heartens those in proximity."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/549.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/549.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/549.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/549.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/549.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/549.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/549.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/549.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/549.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/549.png"}}, "generati