{"height": 15, "weight": 840, "base_experience": 221, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Loud Noise Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "バクオング"}, {"language": "ja-roma", "name": "Bakuong"}, {"language": "ko", "name": "폭음룡"}, {"language": "zh-hant", "name": "爆音怪"}, {"language": "fr", "name": "Brouhabam"}, {"language": "de", "name": "Krawumms"}, {"language": "es", "name": "Exploud"}, {"language": "it", "name": "Exploud"}, {"language": "ja", "name": "バクオング"}, {"language": "zh-hans", "name": "爆音怪"}, {"language": "es-419", "name": "Exploud"}], "pokedex_entries": [{"versions": ["ruby"], "text": "EXPLOUD triggers earthquakes with the tremors it creates by bellowing. If this POKéMON violently inhales from the ports on its body, it’s a sign that it is preparing to let loose a huge bellow."}, {"versions": ["sapphire"], "text": "EXPLOUD communicates its feelings to the others by emitting whistle-like sounds from the tubes on its body. This POKéMON only raises its voice when it is in battle."}, {"versions": ["emerald"], "text": "It has sound-generating organs all over its body. It communicates with others by adjusting the tone and volume of the cries it emits."}, {"versions": ["firered", "leafgreen"], "text": "It emits a variety of sounds from the holes all over its body. Its loud cries can be heard from over six miles away."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Its howls can be heard over six miles away. It emits all sorts of noises from the ports on its body."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "Its roar in battle shakes the ground like a tremor--or like an earthquake has struck."}, {"versions": ["omega-ruby"], "text": "Exploud triggers earthquakes with the tremors it creates by bellowing. If this Pokémon violen