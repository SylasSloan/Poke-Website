{"height": 7, "weight": 212, "base_experience": 52, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Owl Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ホーホー"}, {"language": "ja-roma", "name": "Hoho"}, {"language": "ko", "name": "부우부"}, {"language": "zh-hant", "name": "咕咕"}, {"language": "fr", "name": "Hoothoot"}, {"language": "de", "name": "Hoothoot"}, {"language": "es", "name": "Hoothoot"}, {"language": "it", "name": "Hoothoot"}, {"language": "ja", "name": "ホーホー"}, {"language": "zh-hans", "name": "咕咕"}, {"language": "es-419", "name": "Hoothoot"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y", "sword"], "text": "It always stands on one foot. It changes feet so fast, the movement can rarely be seen."}, {"versions": ["silver", "firered", "soulsilver", "x"], "text": "It has a perfect sense of time. Whatever happens, it keeps rhythm by precisely tilting its head in time."}, {"versions": ["crystal"], "text": "It begins to hoot at the same time every day. Some trainers use them in place of clocks."}, {"versions": ["ruby", "sapphire"], "text": "HOOTHOOT has an internal organ that senses and tracks the earth’s rotation. Using this special organ, this POKéMON begins hooting at precisely the same time every day."}, {"versions": ["emerald"], "text": "It has an internal organ that senses the earth’s rotation. Using this special organ, a HOOTHOOT begins hooting at precisely the same time every day."}, {"versions": ["diamond"], "text": "It always stands on one foot. Even when attacked, it does not brace itself using both feet."}, {"versions": ["pearl"], "text": "It switches its standing foot so quickly, it can’t be seen. It cries at the same time every day."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It marks time precisely. Some countries consider it to be a wise friend, versed 