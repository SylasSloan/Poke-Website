{"height": 12, "weight": 225, "base_experience": 161, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Light Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ランターン"}, {"language": "ja-roma", "name": "Lantern"}, {"language": "ko", "name": "랜턴"}, {"language": "zh-hant", "name": "電燈怪"}, {"language": "fr", "name": "Lanturn"}, {"language": "de", "name": "Lanturn"}, {"language": "es", "name": "Lanturn"}, {"language": "it", "name": "Lanturn"}, {"language": "ja", "name": "ランターン"}, {"language": "zh-hans", "name": "电灯怪"}, {"language": "es-419", "name": "Lanturn"}], "pokedex_entries": [{"versions": ["gold"], "text": "The light it emits is so bright that it can illuminate the sea's surface from a depth of over three miles."}, {"versions": ["silver", "firered"], "text": "It blinds prey with an intense burst of light, then swallows the immobilized prey in a single gulp."}, {"versions": ["crystal"], "text": "This POKéMON uses the bright part of its body, which changed from a dorsal fin, to lure prey."}, {"versions": ["ruby"], "text": "LANTURN is nicknamed “the deep-sea star” for its illuminated antenna. This POKéMON produces light by causing a chemical reaction between bacteria and its bodily fluids inside the antenna."}, {"versions": ["sapphire"], "text": "LANTURN is known to emit light. If you peer down into the dark sea from a ship at night, you can sometimes see this POKéMON’s light rising from the depths where it swims. It gives the sea an appearance of a starlit night."}, {"versions": ["emerald"], "text": "The light-emitting orbs on its back are very bright. They are formed from a part of its dorsal fin. This POKéMON illuminates the inky darkness of deep seas."}, {"versions": ["leafgreen", "heartgold", "sword"], "text": "The light it emits is so bright that it can illuminate the sea’s surface from a depth of over three miles."}, {"versions": ["diamond", "pearl", "platinum"], "text": "LANTURN’s light can shine up from great depths. It is nicknamed “The Deep-Sea Star.”"}, {"versions": ["soulsilver", "y"], "text": "It blinds prey with an intense burst of light. With the prey incapacitated, the Pokémon swallows it in a single gulp."}, {"versions": ["black", "white", "black-2", "white-2", "x"], "text": "Lanturn’s light can shine up from great depths. It is nicknamed “The Deep-Sea Star.”"}, {"versions": ["omega-ruby"], "text": "Lanturn is nicknamed “the deep-sea star” for its illuminated antenna. This Pokémon produces light by causing a chemical reaction between bacteria and its bodily fluids inside the antenna."}, {"versions": ["alpha-sapphire"], "text": "Lanturn is known to emit light. If you peer down into the dark sea from a ship at night, you can sometimes see this Pokémon’s light rising from the depths where it swims. It gives the sea an appearance of a starlit night."}, {"versions": ["sun"], "text": "Should you peer into the ocean at night and see a light shining like the stars, that is Lanturn."}, {"versions": ["moon", "shield"], "text": "This Pokémon flashes a bright light that blinds its prey. This creates an opening for it to deliver an electrical attack."}, {"versions": ["ultra-sun"], "text": "When the bacteria living inside its antennae absorb Lanturn’s bodily fluids, a strong luminescent effect is produced."}, {"versions": ["ultra-moon"], "text": "It lives far down in the depths of the ocean. It blinds its prey with light, using the moment they’re dazzled to swallow them whole."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/171.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/171.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i