{"height": 15, "weight": 380, "base_experience": 245, "ev_yield": [{"stat": "special-attack", "value": 2}, {"stat": "special-defense", "value": 1}], "genus": "Jubilee Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["flying", "fairy"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "トゲキッス"}, {"language": "ja-roma", "name": "Togekiss"}, {"language": "ko", "name": "토게키스"}, {"language": "zh-hant", "name": "波克基斯"}, {"language": "fr", "name": "Togekiss"}, {"language": "de", "name": "Togekiss"}, {"language": "es", "name": "Togekiss"}, {"language": "it", "name": "Togekiss"}, {"language": "ja", "name": "トゲキッス"}, {"language": "zh-hans", "name": "波克基斯"}, {"language": "es-419", "name": "Togekiss"}], "pokedex_entries": [{"versions": ["diamond", "pearl"], "text": "It will never appear where there is strife. Its sightings have become rare recently."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y", "alpha-sapphire"], "text": "It shares many blessings with people who respect one another’s rights and avoid needless strife."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "As everyone knows, it visits peaceful regions, bringing them gifts of kindness and sweet blessings."}, {"versions": ["sword"], "text": "These Pokémon are never seen anywhere near conflict or turmoil. In recent times, they’ve hardly been seen at all."}, {"versions": ["shield"], "text": "Known as a bringer of blessings, it’s been depicted on good-luck charms since ancient times."}, {"versions": ["legends-arceus"], "text": "Scant few have ever sighted this Pokémon. After studying what literature remains, I am certain Togekiss will reveal itself when peace reigns in the land."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/468.png", "shiny": "https://raw.githubuserconte