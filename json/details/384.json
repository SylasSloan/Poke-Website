{"height": 70, "weight": 2065, "base_experience": 306, "ev_yield": [{"stat": "attack", "value": 2}, {"stat": "special-attack", "value": 1}], "genus": "Sky High Pokémon", "capture_rate": 45, "base_happiness": 0, "hatch_counter": 120, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "レックウザ"}, {"language": "ja-roma", "name": "Rayquaza"}, {"language": "ko", "name": "레쿠쟈"}, {"language": "zh-hant", "name": "烈空坐"}, {"language": "fr", "name": "Rayquaza"}, {"language": "de", "name": "Rayquaza"}, {"language": "es", "name": "Rayquaza"}, {"language": "it", "name": "Rayquaza"}, {"language": "ja", "name": "レックウザ"}, {"language": "zh-hans", "name": "烈空坐"}, {"language": "es-419", "name": "Rayquaza"}], "pokedex_entries": [{"versions": ["ruby"], "text": "RAYQUAZA lived for hundreds of millions of years in the earth’s ozone layer, never descending to the ground. This POKéMON appears to feed on water and particles in the atmosphere."}, {"versions": ["sapphire"], "text": "RAYQUAZA is said to have lived for hundreds of millions of years in the earth’s ozone layer, above the clouds. Its existence had been completely unknown because it lived so high in the sky."}, {"versions": ["emerald"], "text": "A POKéMON that flies endlessly in the ozone layer. It is said it would descend to the ground if KYOGRE and GROUDON were to fight."}, {"versions": ["firered", "leafgreen"], "text": "It has lived for hundreds of millions of years in the ozone layer. Its flying form looks like a meteor."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It lives in the ozone layer far above the clouds and cannot be seen from the ground."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It flies in the ozone layer, way up high in the sky. Until recently, no one had ever seen it."}, {"versions": ["omega-ruby"], "text": "Rayquaza is said to have lived for hundreds of millions of years. Legends rem