{"height": 5, "weight": 83, "base_experience": 66, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Water Gun Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "slow", "egg_groups": ["water1", "water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ウデッポウ"}, {"language": "ja-roma", "name": "Udeppou"}, {"language": "ko", "name": "완철포"}, {"language": "zh-hant", "name": "鐵臂槍蝦"}, {"language": "fr", "name": "Flingouste"}, {"language": "de", "name": "Scampisto"}, {"language": "es", "name": "Clauncher"}, {"language": "it", "name": "Clauncher"}, {"language": "ja", "name": "ウデッポウ"}, {"language": "zh-hans", "name": "铁臂枪虾"}, {"language": "es-419", "name": "Clauncher"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "They knock down flying prey by firing compressed water from their massive claws like shooting a pistol."}, {"versions": ["y", "alpha-sapphire"], "text": "Through controlled explosions of internal gas, it can expel water like a pistol shot. At close distances, it can shatter rock."}, {"versions": ["ultra-sun"], "text": "Its claws occasionally fall off, and it keeps a low profile until they grow back. The meat of its claws is so delicious!"}, {"versions": ["ultra-moon"], "text": "It moves around by jetting water from its right pincer. It has a poor sense of balance, so it’s terrible at swimming straight."}, {"versions": ["sword"], "text": "Clauncher’s claws can fall off during battle, but they’ll regenerate. The meat inside the claws is popular as a delicacy in Galar."}, {"versions": ["shield"], "text": "By detonating gas that accumulates in its right claw, this Pokémon launches water like a bullet. This is how Clauncher defeats its enemies."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/692.png", "shiny": null}}, "generation-v": {"black-white": {"nor