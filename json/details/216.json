{"height": 6, "weight": 88, "base_experience": 66, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Little Bear Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヒメグマ"}, {"language": "ja-roma", "name": "Himeguma"}, {"language": "ko", "name": "깜지곰"}, {"language": "zh-hant", "name": "熊寶寶"}, {"language": "fr", "name": "Teddiursa"}, {"language": "de", "name": "Teddiursa"}, {"language": "es", "name": "Teddiursa"}, {"language": "it", "name": "Teddiursa"}, {"language": "ja", "name": "ヒメグマ"}, {"language": "zh-hans", "name": "熊宝宝"}, {"language": "es-419", "name": "Teddiursa"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "If it finds honey, its crescent mark glows. It always licks its paws because they are soaked with honey."}, {"versions": ["silver"], "text": "Before food be­ comes scarce in wintertime, its habit is to hoard food in many hid­ den locations."}, {"versions": ["crystal"], "text": "It always licks honey. Its palm tastes sweet because of all the honey it has absorbed."}, {"versions": ["ruby", "sapphire"], "text": "This POKéMON likes to lick its palms that are sweetened by being soaked in honey. TEDDIURSA concocts its own honey by blending fruits and pollen collected by BEEDRILL."}, {"versions": ["emerald"], "text": "It licks its palms that are sweetened by being soaked in honey. A TEDDIURSA makes its own honey by blending fruits and pollen collected by BEEDRILL."}, {"versions": ["firered", "soulsilver", "y"], "text": "Before food becomes scarce in wintertime, its habit is to hoard food in many hidden locations."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It lets honey soak into its paws so it can lick them all the time. Every set of paws tastes unique."}, {"versions": ["heartgold", "x"], "text": "If it finds honey, its crescent mark glows. It always licks its paws because they’re soaked with honey."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "This Pokémon likes to lick its palms that are sweetened by being soaked in honey. Teddiursa concocts its own honey by blending fruits and pollen collected by Beedrill."}, {"versions": ["legends-arceus"], "text": "It licks its paws because of the sweet honey that has soaked into them. It is cunning, stealing into the nests of Combee and taking for itself the honey that the Combee have amassed."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/216.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/216.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/216.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/216.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/216.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/216.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/216.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/216.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/216.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/216.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI