{"height": 2, "weight": 22, "base_experience": 151, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Antenna Pokémon", "capture_rate": 180, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "デデンネ"}, {"language": "ja-roma", "name": "Dedenne"}, {"language": "ko", "name": "데덴네"}, {"language": "zh-hant", "name": "咚咚鼠"}, {"language": "fr", "name": "Dedenne"}, {"language": "de", "name": "Dedenne"}, {"language": "es", "name": "Dedenne"}, {"language": "it", "name": "Dedenne"}, {"language": "ja", "name": "デデンネ"}, {"language": "zh-hans", "name": "咚咚鼠"}, {"language": "es-419", "name": "Dedenne"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "Its whiskers serve as antennas. By sending and receiving electrical waves, it can communicate with others over vast distances."}, {"versions": ["y", "alpha-sapphire"], "text": "It uses its tail to absorb electricity from power plants or from outlets in houses, and then it fires the electricity from its whiskers."}, {"versions": ["ultra-sun"], "text": "It sneaks into people’s homes and steals electricity from their outlets. When your electric bill seems off, it’s the handiwork of this rascal."}, {"versions": ["ultra-moon"], "text": "Its upper whiskers are sensors that survey its surroundings. Its lower whiskers are organs that shoot electricity."}, {"versions": ["sword"], "text": "A Dedenne’s whiskers pick up electrical waves other Dedenne send out. These Pokémon share locations of food or electricity with one another."}, {"versions": ["shield"], "text": "Since Dedenne can’t generate much electricity on its own, it steals electricity from outlets or other electric Pokémon."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/702.png", "shiny": null}}, "generation-v": {"black-whit