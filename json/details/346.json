{"height": 15, "weight": 604, "base_experience": 173, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Barnacle Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ユレイドル"}, {"language": "ja-roma", "name": "Yuradle"}, {"language": "ko", "name": "릴리요"}, {"language": "zh-hant", "name": "搖籃百合"}, {"language": "fr", "name": "Vacilys"}, {"language": "de", "name": "Wielie"}, {"language": "es", "name": "Cradily"}, {"language": "it", "name": "Cradily"}, {"language": "ja", "name": "ユレイドル"}, {"language": "zh-hans", "name": "摇篮百合"}, {"language": "es-419", "name": "Cradily"}], "pokedex_entries": [{"versions": ["ruby"], "text": "CRADILY roams around the ocean floor in search of food. This POKéMON freely extends its tree trunk-like neck and captures unwary prey using its eight tentacles."}, {"versions": ["sapphire"], "text": "CRADILY’s body serves as an anchor, preventing it from being washed away in rough seas. This POKéMON secretes a strong digestive fluid from its tentacles."}, {"versions": ["emerald"], "text": "It drags its heavy body along the seafloor. It makes its nest in the shallows of warm seas. CRADILY can be seen on beaches when the tide goes out."}, {"versions": ["firered", "leafgreen", "y"], "text": "It ensnares prey with its eight tentacles. It then melts the prey with a strong acid before feeding."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It lives in the shallows of warm seas. When the tide goes out, it digs up prey from beaches."}, {"versions": ["heartgold", "soulsilver"], "text": "It lives in warm seas. Its heavy body weighs it down so it won’t get washed away in rough weather."}, {"versions": ["omega-ruby"], "text": "Cradily roams around the ocean floor in search of food. This Pokémon freely extends its tree trunk-like neck and captures unwary prey using its eight tentacles."}, {"versions": ["alpha-sapphire"], "text": "Cradily’s body serves as an anchor, preventing it from being washed away in rough seas. This Pokémon secretes a strong digestive fluid from its tentacles."}, {"versions": ["ultra-sun"], "text": "Normally, it lived on shallow sea shoals. When the tide went out, this Pokémon came up on land to search for prey."}, {"versions": ["ultra-moon"], "text": "This carnivorous Pokémon lived in primordial seas. It catches prey in its eight tentacles and dissolves them with digestive fluid as it eats."}, {"versions": ["sword"], "text": "It has short legs and can’t walk very fast, but its neck and tentacles can extend to over three times their usual length to nab distant prey."}, {"versions": ["shield"], "text": "Once Cradily catches prey in its tentacles, it digests them whole and absorbs their nutrients."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/346.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/346.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/346.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/346.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/346.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/346.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/346.png", "shiny": "https://raw.githubusercontent.com/PokeAPI