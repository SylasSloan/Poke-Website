{"height": 6, "weight": 85, "base_experience": 62, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Lizard Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "dragon"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ヒトカゲ"}, {"language": "ja-roma", "name": "Hitokage"}, {"language": "ko", "name": "파이리"}, {"language": "zh-hant", "name": "小火龍"}, {"language": "fr", "name": "Salamèche"}, {"language": "de", "name": "Glumanda"}, {"language": "es", "name": "Charmander"}, {"language": "it", "name": "Charmander"}, {"language": "ja", "name": "ヒトカゲ"}, {"language": "zh-hans", "name": "小火龙"}, {"language": "es-419", "name": "Charmander"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Obviously prefers hot places. When it rains, steam is said to spout from the tip of its tail."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "The flame at the tip of its tail makes a sound as it burns. You can only hear it in quiet places."}, {"versions": ["gold", "heartgold"], "text": "The flame on its tail shows the strength of its life force. If it is weak, the flame also burns weakly."}, {"versions": ["silver"], "text": "The flame on its tail indicates CHARMANDER's life force. If it is healthy, the flame burns brightly."}, {"versions": ["crystal"], "text": "If it's healthy, the flame on the tip of its tail will burn vigor­ ously, even if it gets a bit wet."}, {"versions": ["ruby", "sapphire"], "text": "The flame that burns at the tip of its tail is an indication of its emotions. The flame wavers when CHARMANDER is enjoying itself. If the POKéMON becomes enraged, the flame burns fiercely."}, {"versions": ["emerald"], "text": "The flame that burns at the tip of its tail is an indication of its emotions. The flame wavers when CHARMANDER is happy, and blazes when it is enraged."}, {"versions": ["firered", "y", "shield"], "text": "From the time it is born, a flame burns at the tip of its tail. Its life would end if the flame were to go out."}, {"versions": ["leafgreen", "sword"], "text": "It has a preference for hot things. When it rains, steam is said to spout from the tip of its tail."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "The fire on the tip of its tail is a measure of its life. If healthy, its tail burns intensely."}, {"versions": ["soulsilver"], "text": "The flame on its tail indicates CHARMANDER’s life force. If it is healthy, the flame burns brightly."}, {"versions": ["x"], "text": "The flame on its tail indicates Charmander’s life force. If it is healthy, the flame burns brightly."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "The flame that burns at the tip of its tail is an indication of its emotions. The flame wavers when Charmander is enjoying itself. If the Pokémon becomes enraged, the flame burns fiercely."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/4.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/4.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/4.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/4.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/4.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/4.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/4.png", "shiny": "https://raw.githubusercontent.com/Poke