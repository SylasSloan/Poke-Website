{"height": 4, "weight": 42, "base_experience": 58, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Scratch Cat Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ニャース"}, {"language": "ja-roma", "name": "Nyarth"}, {"language": "ko", "name": "나옹"}, {"language": "zh-hant", "name": "喵喵"}, {"language": "fr", "name": "Miaouss"}, {"language": "de", "name": "Mauzi"}, {"language": "es", "name": "Meowth"}, {"language": "it", "name": "Meowth"}, {"language": "ja", "name": "ニャース"}, {"language": "zh-hans", "name": "喵喵"}, {"language": "es-419", "name": "Meowth"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Adores circular objects. Wanders the streets on a nightly basis to look for dropped loose change."}, {"versions": ["yellow"], "text": "Appears to be more active at night. It loves round and shiny things. It can't stop from picking them up."}, {"versions": ["gold"], "text": "It is fascinated by round objects. It can't stop playing with them until it tires and falls asleep."}, {"versions": ["silver"], "text": "It loves anything that shines. It especially adores coins that it picks up and se­ cretly hoards."}, {"versions": ["crystal"], "text": "It loves things that sparkle. When it sees a shiny object, the gold coin on its head shines too."}, {"versions": ["ruby", "sapphire"], "text": "MEOWTH withdraws its sharp claws into its paws to slinkily sneak about without making any incriminating footsteps. For some reason, this POKéMON loves shiny coins that glitter with light."}, {"versions": ["emerald"], "text": "MEOWTH withdraw their sharp claws into their paws to silently sneak about. For some reason, this POKéMON loves shiny coins that glitter with light."}, {"versions": ["firered"], "text": "All it does is sleep during the daytime. At night, it patrols its territory with its eyes aglow."}, {"versions": ["leafgreen", "y"], "text": "Adores round objects. It wanders the streets on a nightly basis to look for dropped loose change."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It is nocturnal in nature. If it spots something shiny, its eyes glitter brightly."}, {"versions": ["heartgold"], "text": "It is fascinated by round objects. It can’t stop playing with them until it tires and falls asleep."}, {"versions": ["soulsilver"], "text": "It loves anything that shines. It especially adores coins that it picks up and secretly hoards."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Meowth withdraws its sharp claws into its paws to slinkily sneak about without making any incriminating footsteps. For some reason, this Pokémon loves shiny coins that glitter with light."}, {"versions": ["sun"], "text": "It lies around all day, becoming active near dusk. At night, it wanders the city in search of loose change."}, {"versions": ["moon"], "text": "It loves shiny things. It often fights with Murkrow over prey they’re both trying to catch."}, {"versions": ["ultra-sun"], "text": "When visiting a junkyard, you may catch sight of it having an intense fight with Murkrow over shiny objects."}, {"versions": ["ultra-moon"], "text": "It loves coins, so if you give it one, you can make friends with Meowth easily. But it’s fickle, so you can’t count on that friendship lasting."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Appears to be more active at night. It loves round and shiny things. It can’t stop itself from picking them up."}, {"versions": ["sword"], "text": "It loves to collect shiny things. If it’s in a good mood, it might even let its Trainer have a look at its hoard of treasures."}, {"versions": ["shield"], "text": "It washes its face regularly to keep the coin on its forehead spotless. It doesn’t get along with Galarian Meowth."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.c