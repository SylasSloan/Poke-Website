{"height": 3, "weight": 20, "base_experience": 52, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Tiny Bird Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オニスズメ"}, {"language": "ja-roma", "name": "Onisuzume"}, {"language": "ko", "name": "깨비참"}, {"language": "zh-hant", "name": "烈雀"}, {"language": "fr", "name": "Piafabec"}, {"language": "de", "name": "Habitak"}, {"language": "es", "name": "Spearow"}, {"language": "it", "name": "Spearow"}, {"language": "ja", "name": "オニスズメ"}, {"language": "zh-hans", "name": "烈雀"}, {"language": "es-419", "name": "Spearow"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "y"], "text": "Eats bugs in grassy areas. It has to flap its short wings at high speed to stay airborne."}, {"versions": ["yellow"], "text": "Inept at flying high. However, it can fly around very fast to protect its ter­ ritory."}, {"versions": ["gold", "heartgold"], "text": "It flaps its short wings to flush out insects from tall grass. It then plucks them with its stubby beak."}, {"versions": ["silver", "soulsilver", "x"], "text": "Very protective of its territory, it flaps its short wings busily to dart around at high speed."}, {"versions": ["crystal"], "text": "To protect its territory, it flies around ceaselessly, making high- pitched cries."}, {"versions": ["ruby", "sapphire"], "text": "SPEAROW has a very loud cry that can be heard over half a mile away. If its high, keening cry is heard echoing all around, it is a sign that they are warning each other of danger."}, {"versions": ["emerald"], "text": "Its loud cry can be heard over half a mile away. If its high, keening cry is heard echoing all around, it is a sign that they are warning each other of danger."}, {"versions": ["firered"], "text": "It busily flits around here and there. Even if it is frail, it can be a tough foe that uses MIRROR MOVE."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It flaps its small wings busily to fly. Using its beak, it searches in grass for prey."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Spearow has a very loud cry that can be heard over half a mile away. If its high, keening cry is heard echoing all around, it is a sign that they are warning each other of danger."}, {"versions": ["sun"], "text": "Its short wings make it inept at flying. It moves about hurriedly and pecks at Bug-type Pokémon in the tall grass."}, {"versions": ["moon"], "text": "Farmers whose fields are troubled by bug Pokémon appreciate Spearow for its vigorous appetite and look after it."}, {"versions": ["ultra-sun"], "text": "Its reckless nature leads it to stand up to others—even large Pokémon—if it has to protect its territory."}, {"versions": ["ultra-moon"], "text": "Due to its short wings, it can’t fly long distances. It wanders about restlessly and pecks at bug Pokémon."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Inept at flying high. However, it can fly around very fast to protect its territory."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/21.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/21.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/21.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/21.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/21.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/ver