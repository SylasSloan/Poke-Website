{"height": 5, "weight": 90, "base_experience": 74, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Diapered Pokémon", "capture_rate": 190, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["flying"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "バルチャイ"}, {"language": "ja-roma", "name": "Valchai"}, {"language": "ko", "name": "벌차이"}, {"language": "zh-hant", "name": "禿鷹丫頭"}, {"language": "fr", "name": "Vostourno"}, {"language": "de", "name": "Skallyk"}, {"language": "es", "name": "Vullaby"}, {"language": "it", "name": "Vullaby"}, {"language": "ja", "name": "バルチャイ"}, {"language": "zh-hans", "name": "秃鹰丫头"}, {"language": "es-419", "name": "Vullaby"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "Its wings are too tiny to allow it to fly. As the time approaches for it to evolve, it discards the bones it was wearing."}, {"versions": ["white"], "text": "They tend to guard their posteriors with suitable bones they have found. They pursue weak Pokémon."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "Their wings are too tiny to allow them to fly. They guard their posteriors with bones that were gathered by Mandibuzz."}, {"versions": ["sun"], "text": "It protects its plump posterior with the bones of prey it has consumed. As it grows, it replaces the bones."}, {"versions": ["moon"], "text": "It can’t fly yet and must wait until its wings have developed more. Since it’s still at a playful age, it hops around friskily."}, {"versions": ["ultra-sun"], "text": "Mandibuzz gives it the bones it wears. Vullaby’s wings are short, so it can’t fly yet, but it jumps around, dreaming of wide open skies."}, {"versions": ["ultra-moon"], "text": "Its healthy appetite leads to visible growth spurts. It often has to replace the bones it wears as its size increases."}, {"versions": ["sword"], "text": "It wears a bone to protect its rear. It often squabbles with others of its kind over particularly comfy bones."}, {"versions": ["shield"], "text": "Vullaby grow quickly. Bones that have gotten too small for older Vullaby to wear often get passed down to younger ones in the nest."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/629.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/629.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/629.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/629.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/629.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/629.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/629.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/629.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/629.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/629.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/629.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation V", "level_up": [{