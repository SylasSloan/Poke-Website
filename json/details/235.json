{"height": 12, "weight": 580, "base_experience": 88, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Painter Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドーブル"}, {"language": "ja-roma", "name": "Doble"}, {"language": "ko", "name": "루브도"}, {"language": "zh-hant", "name": "圖圖犬"}, {"language": "fr", "name": "Queulorior"}, {"language": "de", "name": "Farbeagle"}, {"language": "es", "name": "Smeargle"}, {"language": "it", "name": "Smeargle"}, {"language": "ja", "name": "ドーブル"}, {"language": "zh-hans", "name": "图图犬"}, {"language": "es-419", "name": "Smeargle"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold"], "text": "A special fluid oozes from the tip of its tail. It paints the fluid everywhere to mark its territory."}, {"versions": ["silver", "firered", "soulsilver", "y"], "text": "Once it becomes an adult, it has a tendency to let its comrades plant footprints on its back."}, {"versions": ["crystal"], "text": "The color of the mysterious fluid secreted from its tail is predeter­ mined for each SMEARGLE."}, {"versions": ["ruby", "sapphire"], "text": "SMEARGLE marks the boundaries of its territory using a body fluid that leaks out from the tip of its tail. Over 5,000 different marks left by this POKéMON have been found."}, {"versions": ["emerald"], "text": "A SMEARGLE marks its territory using a fluid that leaks out from the tip of its tail. About 5,000 different marks left by this POKéMON have been found."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It marks its territory by using its tail like a paintbrush. There are more than 5,000 different marks."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Smeargle marks the boundaries of its territory using a body fluid that leaks out from the tip of its tail. Over 5,000 different marks left by this Pokémon have been found."}, {"versions": ["sun"], "text": "The unique creations produced by each Smeargle are painted using the fluid that oozes from its tail. This is how it marks its territory."}, {"versions": ["moon"], "text": "It draws symbols all over the place to mark its territory. In towns with many Smeargle, the walls are covered in graffiti."}, {"versions": ["ultra-sun"], "text": "The fluid of Smeargle’s tail secretions changes in the intensity of its hue as the Pokémon’s emotions change."}, {"versions": ["ultra-moon"], "text": "It draws symbols with the fluid that oozes from the tip of its tail. Depending on the symbol, Smeargle fanatics will pay big money for them."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/235.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/235.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/235.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/235.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/235.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/235.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/235.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/235.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/235.png", "shiny": "https://raw.githubuserconte