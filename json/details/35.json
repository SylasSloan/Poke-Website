{"height": 6, "weight": 75, "base_experience": 113, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Fairy Pokémon", "capture_rate": 150, "base_happiness": 140, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["fairy"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ピッピ"}, {"language": "ja-roma", "name": "Pippi"}, {"language": "ko", "name": "삐삐"}, {"language": "zh-hant", "name": "皮皮"}, {"language": "fr", "name": "Mélofée"}, {"language": "de", "name": "Piepi"}, {"language": "es", "name": "Clefairy"}, {"language": "it", "name": "Clefairy"}, {"language": "ja", "name": "ピッピ"}, {"language": "zh-hans", "name": "皮皮"}, {"language": "es-419", "name": "Clefairy"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its magical and cute appeal has many admirers. It is rare and found only in certain areas."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Adored for their cute looks and playfulness. They are thought to be rare, as they do not appear often."}, {"versions": ["gold", "heartgold", "y"], "text": "The moonlight that it stores in the wings on its back apparently gives it the ability to float in midair."}, {"versions": ["silver"], "text": "Its adorable be­ havior and cry make it highly popular. However, this cute POKéMON is rarely found."}, {"versions": ["crystal"], "text": "Though rarely seen, it becomes easier to spot, for some reason, on the night of a full moon."}, {"versions": ["ruby", "sapphire"], "text": "On every night of a full moon, groups of this POKéMON come out to play. When dawn arrives, the tired CLEFAIRY return to their quiet mountain retreats and go to sleep nestled up against each other."}, {"versions": ["emerald"], "text": "On every night of a full moon, they come out to play. When dawn arrives, the tired CLEFAIRY go to sleep nestled up against each other in deep and quiet mountains."}, {"versions": ["firered"], "text": "Its adorable appearance makes it popular as a pet. However, it is rare and difficult to find."}, {"versions": ["leafgreen"], "text": "With its magical and cute appeal, it has many admirers. It is rare and found only in certain areas."}, {"versions": ["diamond"], "text": "Thought to live with others on quiet mountains, it is popular for its adorable nature."}, {"versions": ["pearl"], "text": "It flies using the wings on its back to collect moonlight. This Pokémon is difficult to find."}, {"versions": ["platinum"], "text": "It is said that happiness will come to those who see a gathering of CLEFAIRY dancing under a full moon."}, {"versions": ["soulsilver", "shield"], "text": "Its adorable behavior and cry make it highly popular. However, this cute Pokémon is rarely found."}, {"versions": ["black", "white", "x", "sword"], "text": "It is said that happiness will come to those who see a gathering of Clefairy dancing under a full moon."}, {"versions": ["black-2", "white-2"], "text": "On nights with a full moon, Clefairy gather from all over and dance. Bathing in moonlight makes them float."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "On every night of a full moon, groups of this Pokémon come out to play. When dawn arrives, the tired Clefairy return to their quiet mountain retreats and go to sleep nestled up against each other."}, {"versions": ["sun"], "text": "Its adorable behavior and appearance make it popular with men and women, young and old. Its numbers are few, however."}, {"versions": ["moon"], "text": "On nights with a full moon, they gather together and dance. The surrounding area is enveloped in an abnormal magnetic field."}, {"versions": ["ultra-sun"], "text": "They’re popular, but they’re rare. Trainers who show them off recklessly may be targeted by thieves."}, {"versions": ["ultra-moon"], "text": "Bathed in moonlight, its wings glow faintly. Without even flapping, Clefairy rises into the air, where it dances around."}, {"versions": ["legends-arceus"], "text": "It can be found in quiet mountain areas on a full moon's night. Its dancing and its tiny, faintly glowing wings confer upon it a lovely fairylike quality."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/35.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/35.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/35.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/35.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/35.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/35.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/35.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/35.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/35.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/35.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/35.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/35.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/35.png", "shiny": "https://r