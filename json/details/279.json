{"height": 12, "weight": 280, "base_experience": 154, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Water Bird Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ペリッパー"}, {"language": "ja-roma", "name": "Pelipper"}, {"language": "ko", "name": "패리퍼"}, {"language": "zh-hant", "name": "大嘴鷗"}, {"language": "fr", "name": "Bekipan"}, {"language": "de", "name": "Pelipper"}, {"language": "es", "name": "Pelipper"}, {"language": "it", "name": "Pelipper"}, {"language": "ja", "name": "ペリッパー"}, {"language": "zh-hans", "name": "大嘴鸥"}, {"language": "es-419", "name": "Pelipper"}], "pokedex_entries": [{"versions": ["ruby"], "text": "PELIPPER is a flying transporter that carries small POKéMON and eggs inside its massive bill. This POKéMON builds its nest on steep cliffs facing the sea."}, {"versions": ["sapphire"], "text": "PELIPPER searches for food while in flight by skimming the wave tops. This POKéMON dips its large bill in the sea to scoop up food, then swallows everything in one big gulp."}, {"versions": ["emerald"], "text": "It skims the tops of waves as it flies. When it spots prey, it uses its large beak to scoop up the victim with water. It protects its eggs in its beak."}, {"versions": ["firered", "leafgreen"], "text": "It is a flying transporter that carries small POKéMON in its beak. It bobs on the waves to rest its wings."}, {"versions": ["diamond", "x"], "text": "It dips its large bill in the sea, then scoops up numerous prey along with water."}, {"versions": ["pearl"], "text": "It acts as a delivery service by carrying small Pokémon in its bill. It bobs on the waves to rest."}, {"versions": ["platinum", "black", "white", "y", "sword"], "text": "It is a messenger of the skies, carrying small Pokémon and eggs to safety in its bill."}, {"versions": ["heartgold", "soulsilver"], "text": "It protects its young in its beak. It bobs on waves, resting on them on days when the waters are calm."}, {"versions": ["black-2", "white-2", "shield"], "text": "Skimming the water’s surface, it dips its large bill in the sea, scoops up food and water, and carries it."}, {"versions": ["omega-ruby"], "text": "Pelipper is a flying transporter that carries small Pokémon and eggs inside its massive bill. This Pokémon builds its nest on steep cliffs facing the sea."}, {"versions": ["alpha-sapphire"], "text": "Pelipper searches for food while in flight by skimming the wave tops. This Pokémon dips its large bill in the sea to scoop up food, then swallows everything in one big gulp."}, {"versions": ["sun"], "text": "Its spacious beak is large enough for a small child to fit right inside."}, {"versions": ["moon"], "text": "Gathering food is the work of young males. They store food in their capacious beaks and carry it back to others waiting in the nest."}, {"versions": ["ultra-sun"], "text": "It places small Pokémon into its spacious beak and carries them around. No one knows where it’s taking them."}, {"versions": ["ultra-moon"], "text": "It scoops up Wishiwashi in its huge beak and swallows them whole. It can devour more than 30 at one go!"}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/279.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/279.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/279.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/279.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/279.png", "shiny": "ht