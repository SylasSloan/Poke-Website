{"height": 12, "weight": 395, "base_experience": 179, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Bone Vulture Pokémon", "capture_rate": 60, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["flying"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "バルジーナ"}, {"language": "ja-roma", "name": "Vulgina"}, {"language": "ko", "name": "버랜지나"}, {"language": "zh-hant", "name": "禿鷹娜"}, {"language": "fr", "name": "Vaututrice"}, {"language": "de", "name": "Grypheldis"}, {"language": "es", "name": "Mandibuzz"}, {"language": "it", "name": "Mandibuzz"}, {"language": "ja", "name": "バルジーナ"}, {"language": "zh-hans", "name": "秃鹰娜"}, {"language": "es-419", "name": "Mandibuzz"}], "pokedex_entries": [{"versions": ["black"], "text": "It makes a nest out of bones it finds. It grabs weakened prey in its talons and hauls it to its nest of bones."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "Watching from the sky, they swoop to strike weakened Pokémon on the ground. They decorate themselves with bones."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "They fly in circles around the sky. When they spot prey, they attack and carry it back to their nest with ease."}, {"versions": ["sun"], "text": "They adorn themselves beautifully with bones. This is supposedly an effort to attract males, but no male Mandibuzz have ever been found."}, {"versions": ["moon"], "text": "It circles in the sky, keeping a keen eye out for Pokémon in a weakened state. Its choicest food is Cubone."}, {"versions": ["ultra-sun"], "text": "It skillfully arranges the bones of its prey to construct its nest. Most of the bones are Cubone."}, {"versions": ["ultra-moon"], "text": "It’s always searching for food for Vullaby. When it finds a weak Pokémon, Mandibuzz swoops it right off to its nest."}, {"versions": ["sword"], "text": "Although it’s a bit of a ruffian, this Pokémon will take lost Vullaby under its wing and care for them till they’re ready to leave the nest."}, {"versions": ["shield"], "text": "They adorn themselves with bones. There seem to be fashion trends among them, as different bones come into and fall out of popularity."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/630.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/630.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/630.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/630.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/630.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/630.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/630.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/630.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/630.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/630.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/630.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation