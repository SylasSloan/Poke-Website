{"height": 15, "weight": 410, "base_experience": 179, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Valiant Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["flying"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "ウォーグル"}, {"language": "ja-roma", "name": "Warrgle"}, {"language": "ko", "name": "워글"}, {"language": "zh-hant", "name": "勇士雄鷹"}, {"language": "fr", "name": "Gueriaigle"}, {"language": "de", "name": "Washakwil"}, {"language": "es", "name": "Braviary"}, {"language": "it", "name": "Braviary"}, {"language": "ja", "name": "ウォーグル"}, {"language": "zh-hans", "name": "勇士雄鹰"}, {"language": "es-419", "name": "Braviary"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "They fight for their friends without any thought about danger to themselves. One can carry a car while flying."}, {"versions": ["white"], "text": "The more scars they have, the more respect these brave soldiers of the sky get from their peers."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "For the sake of its friends, this brave warrior of the sky will not stop battling, even if injured."}, {"versions": ["sun"], "text": "With its brave disposition, it fears nothing—not even death. Ancient Alolan people respected it, referring to it as “the hero of the sky.”"}, {"versions": ["moon"], "text": "It’s thought that people disturbed their habitats in the past, so Braviary banded together to fight back."}, {"versions": ["ultra-sun"], "text": "The more scars it has on its front, the more heroic it’s considered to be. Those with many scars on their back are mocked by the flock."}, {"versions": ["ultra-moon"], "text": "Known as “the hero of the skies,” this Pokémon is so proud and so brave that it will never retreat, even when it’s injured."}, {"versions": ["sword"], "text": "Known for its bravery and pride, this majestic Pokémon is often seen as a motif for various kinds of emblems."}, {"versions": ["shield"], "text": "Because this Pokémon is hotheaded and belligerent, it’s Corviknight that’s taken the role of transportation in Galar."}, {"versions": ["legends-arceus"], "text": "Screaming a bloodcurdling battle cry, this huge and ferocious bird Pokémon goes out on the hunt. It blasts lakes with shock waves, then scoops up any prey that float to the water's surface."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/628.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/628.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/628.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/628.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/628.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/628.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/628.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/628.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/628.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/628.png"}}, "generation-viii": {"icons": {"