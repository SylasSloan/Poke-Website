{"height": 10, "weight": 120, "base_experience": 196, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Balloon Pokémon", "capture_rate": 50, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["fairy"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "プクリン"}, {"language": "ja-roma", "name": "Pukurin"}, {"language": "ko", "name": "푸크린"}, {"language": "zh-hant", "name": "胖可丁"}, {"language": "fr", "name": "Grodoudou"}, {"language": "de", "name": "Knuddeluff"}, {"language": "es", "name": "Wigglytuff"}, {"language": "it", "name": "Wigglytuff"}, {"language": "ja", "name": "プクリン"}, {"language": "zh-hans", "name": "胖可丁"}, {"language": "es-419", "name": "Wigglytuff"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "y"], "text": "The body is soft and rubbery. When angered, it will suck in air and inflate itself to an enormous size."}, {"versions": ["yellow"], "text": "Its body is full of elasticity. By inhaling deeply, it can continue to inflate itself without limit."}, {"versions": ["gold"], "text": "Their fur feels so good that if two of them snuggle together, they won't want to be separated."}, {"versions": ["silver"], "text": "It has a very fine fur. Take care not to make it angry, or it may inflate steadily and hit with a BODY SLAM."}, {"versions": ["crystal"], "text": "The rich, fluffy fur that covers its body feels so good that anyone who feels it can't stop touching it."}, {"versions": ["ruby"], "text": "WIGGLYTUFF has large, saucerlike eyes. The surfaces of its eyes are always covered with a thin layer of tears. If any dust gets in this POKéMON’s eyes, it is quickly washed away."}, {"versions": ["sapphire"], "text": "WIGGLYTUFF’s body is very flexible. By inhaling deeply, this POKéMON can inflate itself seemingly without end. Once inflated, WIGGLYTUFF bounces along lightly like a balloon."}, {"versions": ["emerald"], "text": "Its fur is the ultimate in luxuriousness. Sleeping alongside a WIGGLYTUFF is simply divine. Its body expands seemingly without end when it inhales."}, {"versions": ["firered"], "text": "Its fur is extremely fine, dense, and supple. The exquisitely pleasant fur conveys an image of luxury."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Its fine fur feels sublime to the touch. It can expand its body by inhaling air."}, {"versions": ["heartgold", "x"], "text": "Their fur feels so good that if two of them snuggle together, they won’t want to be separated."}, {"versions": ["soulsilver"], "text": "It has a very fine fur. Take care not to make it angry, or it may inflate steadily and hit with a body slam."}, {"versions": ["black-2", "white-2"], "text": "Its fine fur feels so pleasant, those who accidentally touch it cannot take their hands away."}, {"versions": ["omega-ruby"], "text": "Wigglytuff has large, saucerlike eyes. The surfaces of its eyes are always covered with a thin layer of tears. If any dust gets in this Pokémon’s eyes, it is quickly washed away."}, {"versions": ["alpha-sapphire"], "text": "Wigglytuff’s body is very flexible. By inhaling deeply, this Pokémon can inflate itself seemingly without end. Once inflated, Wigglytuff bounces along lightly like a balloon."}, {"versions": ["sun"], "text": "It sheds its fine fur when the seasons change. The fur is gathered and spun into a luxurious yarn."}, {"versions": ["moon"], "text": "As it inhales, it expands...and expands...and expands. Wigglytuff compete to see which one can inflate itself the most."}, {"versions": ["ultra-sun"], "text": "Thanks to its bouncy body and fine fur, this Pokémon is sought after. Holding one in your arms while you sleep feels great."}, {"versions": ["ultra-moon"], "text": "When it gets angry, it inhales with all its might, and its body gradually inflates. Sometimes they can grow 20 times larger!"}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its body is very elastic. By inhaling deeply, it can continue to inflate itself without limit."}, {"versions": ["sword"], "text": "The more air it takes in, the more it inflates. If opponents catch it in a bad mood, it will inflate itself to an enormous size to intimidate them."}, {"versions": ["shield"], "text": "It’s proud of its fur, which is fine and delicate. In particular, the curl on its forehead has a texture that’s perfectly heavenly."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/40.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/40.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/40.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/40.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/40.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/40.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/40.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/40.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/40.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/40.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/40.png", "shiny": "https://raw.githubusercontent.co