{"height": 19, "weight": 1200, "base_experience": 170, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Drill Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "サイドン"}, {"language": "ja-roma", "name": "Sidon"}, {"language": "ko", "name": "코뿌리"}, {"language": "zh-hant", "name": "鑽角犀獸"}, {"language": "fr", "name": "Rhinoféros"}, {"language": "de", "name": "Rizeros"}, {"language": "es", "name": "Rhydon"}, {"language": "it", "name": "Rhydon"}, {"language": "ja", "name": "サイドン"}, {"language": "zh-hans", "name": "钻角犀兽"}, {"language": "es-419", "name": "Rhydon"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Protected by an armor-like hide, it is capable of living in molten lava of 3,600 degrees."}, {"versions": ["yellow"], "text": "Walks on its hind legs. Shows signs of intelligence. Its armor-like hide even repels molten lava."}, {"versions": ["gold", "heartgold"], "text": "Its rugged hide protects it from even the heat of lava. However, the hide also makes it insensitive."}, {"versions": ["silver"], "text": "Its brain devel­ oped when it began walking on hind legs. Its thick hide protects it even in magma."}, {"versions": ["crystal"], "text": "By lightly spin­ ning its drill- like horn, it can easily shatter even a diamond in the rough."}, {"versions": ["ruby"], "text": "RHYDON’s horn can crush even uncut diamonds. One sweeping blow of its tail can topple a building. This POKéMON’s hide is extremely tough. Even direct cannon hits don’t leave a scratch."}, {"versions": ["sapphire"], "text": "RHYDON has a horn that serves as a drill. It is used for destroying rocks and boulders. This POKéMON occasionally rams into streams of magma, but the armor-like hide prevents it from feeling the heat."}, {"versions": ["emerald"], "text": "Its horn, which rotates like a drill, destroys tall buildings with one strike. It stands on its hind legs, and its brain is well developed."}, {"versions": ["firered", "y", "sword"], "text": "It begins walking on its hind legs after evolution. It can punch holes through boulders with its horn."}, {"versions": ["leafgreen", "x", "shield"], "text": "Protected by an armor-like hide, it is capable of living in molten lava of 3,600 degrees Fahrenheit."}, {"versions": ["diamond", "pearl"], "text": "Its brain developed after it stood up on its hind legs. Its drill horn bores tunnels through solid rock."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Standing on its hind legs freed its forelegs and made it smarter. It is very forgetful, however."}, {"versions": ["soulsilver"], "text": "Its brain developed when it began walking on hind legs. Its thick hide protects it even in magma."}, {"versions": ["omega-ruby"], "text": "Rhydon’s horn can crush even uncut diamonds. One sweeping blow of its tail can topple a building. This Pokémon’s hide is extremely tough. Even direct cannon hits don’t leave a scratch."}, {"versions": ["alpha-sapphire"], "text": "Rhydon has a horn that serves as a drill. It is used for destroying rocks and boulders. This Pokémon occasionally rams into streams of magma, but the armor-like hide prevents it from feeling the heat."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its brain developed when it began walking on its hind legs. Its armor-like hide even repels molten lava."}, {"versions": ["legends-arceus"], "text": "Rapidly rotates its horn to bore through bedrock. It swaggers around volcanic regions, protected from the lava's heat by its tough, armorlike hide."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/112.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/112.png", "shiny