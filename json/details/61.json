{"height": 10, "weight": 200, "base_experience": 135, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Tadpole Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ニョロゾ"}, {"language": "ja-roma", "name": "Nyorozo"}, {"language": "ko", "name": "슈륙챙이"}, {"language": "zh-hant", "name": "蚊香君"}, {"language": "fr", "name": "Têtarte"}, {"language": "de", "name": "Quaputzi"}, {"language": "es", "name": "Poliwhirl"}, {"language": "it", "name": "Poliwhirl"}, {"language": "ja", "name": "ニョロゾ"}, {"language": "zh-hans", "name": "蚊香君"}, {"language": "es-419", "name": "Poliwhirl"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Capable of living in or out of water. When out of water, it sweats to keep its body slimy."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Under attack, it uses its belly spiral to put the foe to sleep. It then makes its escape."}, {"versions": ["gold"], "text": "The swirl on its belly subtly un­ dulates. Staring at it may gradual­ ly cause drowsi­ ness."}, {"versions": ["silver", "soulsilver"], "text": "The skin on most of its body is moist. However, the skin on its belly spiral feels smooth."}, {"versions": ["crystal"], "text": "Though it is skilled at walk­ ing, it prefers to live underwater where there is less danger."}, {"versions": ["ruby", "sapphire"], "text": "The surface of POLIWHIRL’s body is always wet and slick with an oily fluid. Because of this greasy covering, it can easily slip and slide out of the clutches of any enemy in battle."}, {"versions": ["emerald"], "text": "Its body surface is always wet and slick with an oily fluid. Because of this greasy covering, it can easily slip and slide out of the clutches of any enemy in battle."}, {"versions": ["firered", "y"], "text": "Its two legs are well developed. Even though it can live on the ground, it prefers living in water."}, {"versions": ["leafgreen", "x"], "text": "It can live in or out of water. When out of water, it constantly sweats to keep its body slimy."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "The spiral pattern on its belly subtly undulates. Staring at it gradually causes drowsiness."}, {"versions": ["heartgold"], "text": "The swirl on its belly subtly undulates. Staring at it may gradually cause drowsiness."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "The surface of Poliwhirl’s body is always wet and slick with a slimy fluid. Because of this slippery covering, it can easily slip and slide out of the clutches of any enemy in battle."}, {"versions": ["sun"], "text": "Although it can live on land, it prefers to stay in the water, where it has fewer natural enemies."}, {"versions": ["moon"], "text": "It marches over the land in search of bug Pokémon to eat. Then it takes them underwater so it can dine on them where it’s safe."}, {"versions": ["ultra-sun"], "text": "Although it has become capable of living on land, it spends its time in the water, where its prey, fish Pokémon, are plentiful."}, {"versions": ["ultra-moon"], "text": "Its health suffers when its skin dries out, so be sure to moisturize it diligently."}, {"versions": ["sword"], "text": "Staring at the swirl on its belly causes drowsiness. This trait of Poliwhirl’s has been used in place of lullabies to get children to go to sleep."}, {"versions": ["shield"], "text": "This Pokémon’s sweat is a slimy mucus. When captured, Poliwhirl can slither from its enemies’ grasp and escape."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/61.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/61.png", "shiny": null}}, "generation-ii": {"crys