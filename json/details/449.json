{"height": 8, "weight": 495, "base_experience": 66, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Hippo Pokémon", "capture_rate": 140, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヒポポタス"}, {"language": "ja-roma", "name": "Hippopotas"}, {"language": "ko", "name": "히포포타스"}, {"language": "zh-hant", "name": "沙河馬"}, {"language": "fr", "name": "Hippopotas"}, {"language": "de", "name": "Hippopotas"}, {"language": "es", "name": "Hippopotas"}, {"language": "it", "name": "Hippopotas"}, {"language": "ja", "name": "ヒポポタス"}, {"language": "zh-hans", "name": "沙河马"}, {"language": "es-419", "name": "Hippopotas"}], "pokedex_entries": [{"versions": ["diamond", "x", "omega-ruby"], "text": "It lives in arid places. Instead of perspiration, it expels grainy sand from its body."}, {"versions": ["pearl", "y", "alpha-sapphire"], "text": "It enshrouds itself with sand to protect itself from germs. It does not enjoy getting wet."}, {"versions": ["platinum", "black", "white"], "text": "It shuts its nostrils tight then travels through sand as if walking. They form colonies of around ten."}, {"versions": ["heartgold", "soulsilver"], "text": "It shrouds itself in sand to ward off germs. It travels easily through the sands of the desert."}, {"versions": ["black-2", "white-2"], "text": "It shuts its nostrils tight then travels through sand as if walking. They form colonies of around 10."}, {"versions": ["sword"], "text": "It moves through the sands with its mouth open, swallowing sand along with its prey. It gets rid of the sand by spouting it from its nose."}, {"versions": ["shield"], "text": "This Pokémon is active during the day and passes the cold desert nights burrowed snugly into the sand."}, {"versions": ["legends-arceus"], "text": "Though large and languid, Hippopotas is difficult to detect due to its tendency to burrow into and lurk beneath the soil. When agitated or excit