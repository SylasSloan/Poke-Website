{"height": 3, "weight": 30, "base_experience": 44, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Star Shape Pokémon", "capture_rate": 150, "base_happiness": 140, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["no-eggs"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ピィ"}, {"language": "ja-roma", "name": "Py"}, {"language": "ko", "name": "삐"}, {"language": "zh-hant", "name": "皮寶寶"}, {"language": "fr", "name": "Mélo"}, {"language": "de", "name": "Pii"}, {"language": "es", "name": "Cleffa"}, {"language": "it", "name": "Cleffa"}, {"language": "ja", "name": "ピィ"}, {"language": "zh-hans", "name": "皮宝宝"}, {"language": "es-419", "name": "Cleffa"}], "pokedex_entries": [{"versions": ["gold"], "text": "Because of its unusual, star-like silhouette, people believe that it came here on a meteor."}, {"versions": ["silver"], "text": "When numerous me­ teors illuminate the night sky, sightings of CLEFFA strangely increase."}, {"versions": ["crystal"], "text": "If the impact site of a meteorite is found, this POKéMON is certain to be within the immediate area."}, {"versions": ["ruby", "sapphire"], "text": "On nights with many shooting stars, CLEFFA can be seen dancing in a ring. They dance through the night and stop only at the break of day, when these POKéMON quench their thirst with the morning dew."}, {"versions": ["emerald"], "text": "On nights with many shooting stars, CLEFFA can be seen dancing in a ring. They dance until daybreak, when they quench their thirst with the morning dew."}, {"versions": ["firered", "soulsilver"], "text": "When numerous meteors illuminate the night sky, sightings of CLEFFA strangely increase."}, {"versions": ["leafgreen", "heartgold", "x", "shield"], "text": "Because of its unusual, starlike silhouette, people believe that it came here on a meteor."}, {"versions": ["diamond"], "text": "Its silhouette is like a star. It is believed to arrive riding on shooting stars."}, {"versions": ["pearl", "y"], "text": "Many appear when the night skies are filled with shooting stars. They disappear with sunrise."}, {"versions": ["platinum", "black", "white"], "text": "It is often seen when shooting stars fill the night skies. It’s said to arrive riding on a shooting star."}, {"versions": ["black-2", "white-2", "sword"], "text": "According to local rumors, Cleffa are often seen in places where shooting stars have fallen."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "On nights with many shooting stars, Cleffa can be seen dancing in a ring. They dance through the night and stop only at the break of day, when these Pokémon quench their thirst with the morning dew."}, {"versions": ["sun"], "text": "On late nights illuminated by shooting stars, it gazes intently skyward, as if thinking of its home."}, {"versions": ["moon"], "text": "Because of its silhouette, it’s believed to be a star reborn. For some reason, it loves Minior."}, {"versions": ["ultra-sun"], "text": "On nights with many shooting stars, they gather in packs and dance in circles. If you should see them, something good will happen!"}, {"versions": ["ultra-moon"], "text": "Said to have ridden here on a shooting star, Cleffa seem to appear in places where meteorites have struck in the past."}, {"versions": ["legends-arceus"], "text": "In silhouette, they resemble twinkling starlight. When shooting stars rain from the night sky, Cleffa gather in numbers and dance as though they are indeed incarnations of the stars."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/173.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/173.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/173.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/