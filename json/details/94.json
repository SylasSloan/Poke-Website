{"height": 15, "weight": 405, "base_experience": 225, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Shadow Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゲンガー"}, {"language": "ja-roma", "name": "Gangar"}, {"language": "ko", "name": "팬텀"}, {"language": "zh-hant", "name": "耿鬼"}, {"language": "fr", "name": "Ectoplasma"}, {"language": "de", "name": "Gengar"}, {"language": "es", "name": "Gengar"}, {"language": "it", "name": "Gengar"}, {"language": "ja", "name": "ゲンガー"}, {"language": "zh-hans", "name": "耿鬼"}, {"language": "es-419", "name": "Gengar"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Under a full moon, this POKéMON likes to mimic the shadows of people and laugh at their fright."}, {"versions": ["yellow"], "text": "A GENGAR is close by if you feel a sudden chill. It may be trying to lay a curse on you."}, {"versions": ["gold"], "text": "It steals heat from its surround­ ings. If you feel a sudden chill, it is certain that a GENGAR appeared."}, {"versions": ["silver"], "text": "To steal the life of its target, it slips into the prey's shadow and silently waits for an opportunity."}, {"versions": ["crystal"], "text": "Hiding in people's shadows at night, it absorbs their heat. The chill it causes makes the victims shake."}, {"versions": ["ruby", "sapphire"], "text": "Sometimes, on a dark night, your shadow thrown by a streetlight will suddenly and startlingly overtake you. It is actually a GENGAR running past you, pretending to be your shadow."}, {"versions": ["emerald"], "text": "Deep in the night, your shadow cast by a streetlight may suddenly overtake you. It is actually a GENGAR running past you, pretending to be your shadow."}, {"versions": ["firered", "shield"], "text": "It is said to emerge from darkness to steal the lives of those who become lost in mountains."}, {"versions": ["leafgreen"], "text": "On the night of a full moon, if shadows move on their own and laugh, it must be GENGAR’s doing."}, {"versions": ["diamond"], "text": "It hides in shadows. It is said that if GENGAR is hiding, it cools the area by nearly 10 degrees F."}, {"versions": ["pearl"], "text": "Lurking in the shadowy corners of rooms, it awaits chances to steal its prey’s life force."}, {"versions": ["platinum"], "text": "The leer that floats in darkness belongs to a GENGAR delighting in casting curses on people."}, {"versions": ["heartgold"], "text": "It steals heat from its surroundings. If you feel a sudden chill, it is certain that a GENGAR appeared."}, {"versions": ["soulsilver"], "text": "To steal the life of its target, it slips into the prey’s shadow and silently waits for an opportunity."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "The leer that floats in darkness belongs to a Gengar delighting in casting curses on people."}, {"versions": ["x"], "text": "It hides in shadows. It is said that if Gengar is hiding, it cools the area by nearly 10 degrees Fahrenheit."}, {"versions": ["y"], "text": "Hiding in people’s shadows at night, it absorbs their heat. The chill it causes makes the victims shake."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Sometimes, on a dark night, your shadow thrown by a streetlight will suddenly and startlingly overtake you. It is actually a Gengar running past you, pretending to be your shadow."}, {"versions": ["sun"], "text": "Should you feel yourself attacked by a sudden chill, it is evidence of an approaching Gengar. There is no escaping it. Give up."}, {"versions": ["moon"], "text": "It apparently wishes for a traveling companion. Since it was once human itself, it tries to create one by taking the lives of other humans."}, {"versions": ["ultra-sun"], "text": "You can hear tales told all over the world about how Gengar will pay a visit to children who are naughty."}, {"versions": ["ultra-moon"], "text": "Even your home isn’t safe. Gengar will lurk in whatever dark corner of a room it can find and wait for its chance to catch its prey."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A Gengar is close by if you feel a sudden chill. It may be trying to lay a curse on you."}, {"versions": ["sword"], "text": "On the night of a full moon, if shadows move on their own and laugh, it must be Gengar’s doing."}, {"versions": ["legends-arceus"], "text": "Possesses potential victims' shadows in an effort to steal away the victims' lives. If your shadow begins to laugh, you must take hold of a protective charm posthaste!"}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/94.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/94.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/94.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/94.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/94.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/94.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/94.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/94.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/94.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites