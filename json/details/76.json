{"height": 14, "weight": 3000, "base_experience": 223, "ev_yield": [{"stat": "defense", "value": 3}], "genus": "Megaton Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴローニャ"}, {"language": "ja-roma", "name": "Golonya"}, {"language": "ko", "name": "딱구리"}, {"language": "zh-hant", "name": "隆隆岩"}, {"language": "fr", "name": "Grolem"}, {"language": "de", "name": "Geowaz"}, {"language": "es", "name": "Golem"}, {"language": "it", "name": "Golem"}, {"language": "ja", "name": "ゴローニャ"}, {"language": "zh-hans", "name": "隆隆岩"}, {"language": "es-419", "name": "Golem"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its boulder-like body is extremely hard. It can easily withstand dynamite blasts without damage."}, {"versions": ["yellow"], "text": "Once it sheds its skin, its body turns tender and whitish. Its hide hardens when it's exposed to air."}, {"versions": ["gold"], "text": "It sheds its skin once a year. The discarded shell immediately hard­ ens and crumbles away."}, {"versions": ["silver", "soulsilver"], "text": "It is capable of blowing itself up. It uses this explosive force to jump from mountain to mountain."}, {"versions": ["crystal"], "text": "Its rock-like body is so durable, even high-powered dynamite blasts fail to scratch its rugged hide."}, {"versions": ["ruby"], "text": "GOLEM live up on mountains. If there is a large earthquake, these POKéMON will come rolling down off the mountains en masse to the foothills below."}, {"versions": ["sapphire"], "text": "GOLEM is known for rolling down from mountains. To prevent them from rolling into the homes of people downhill, grooves have been dug into the sides of mountains to serve as guideways for diverting this POKéMON’s course."}, {"versions": ["emerald"], "text": "It is said to live in volcanic craters on mountain peaks. Once a year, it sheds its hide and grows larger. The shed hide crumbles and returns to the soil."}, {"versions": ["firered"], "text": "It is enclosed in a hard shell that is as rugged as slabs of rock. It sheds skin once a year to grow larger."}, {"versions": ["leafgreen"], "text": "Its boulder-like body is extremely hard. It can easily withstand dynamite blasts without taking damage."}, {"versions": ["diamond"], "text": "It sheds its hide once a year. Its boulderlike body is so tough, even dynamite can’t harm it."}, {"versions": ["pearl", "x"], "text": "It tumbles down mountains, leaving grooves from peak to base. Stay clear of these grooves."}, {"versions": ["platinum", "black", "white"], "text": "Even dynamite can’t harm its hard, boulderlike body. It sheds its hide just once a year."}, {"versions": ["heartgold"], "text": "It sheds its skin once a year. The discarded shell immediately hardens and crumbles away."}, {"versions": ["black-2", "white-2", "y"], "text": "Even dynamite can’t harm its hard, boulder-like body. It sheds its hide just once a year."}, {"versions": ["omega-ruby"], "text": "Golem live up on mountains. If there is a large earthquake, these Pokémon will come rolling down off the mountains en masse to the foothills below."}, {"versions": ["alpha-sapphire"], "text": "Golem is known for rolling down from mountains. To prevent them from rolling into the homes of people downhill, grooves have been dug into the sides of mountains to serve as guideways for diverting this Pokémon’s course."}, {"versions": ["sun"], "text": "Its body can survive dynamite blasts without a single scratch, but it hates rain and humidity."}, {"versions": ["moon"], "text": "Once a year, this Pokémon molts, and its shed shell returns to the soil. This process creates enriched soil, so farmers collect the shells."}, {"versions": ["ultra-sun"], "text": "When Golem grow old, they stop shedding their shells. Those that have lived a long, long time have shells green with moss."}, {"versions": ["ultra-moon"], "text": "It detonates its own body. The power from that explosion can propel it up steep mountain paths with amazing speed."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Once it sheds its skin, its body turns tender and whitish. Its hide hardens when it’s exposed to air."}, {"versions": ["legends-arceus"], "text": "The rocklike shell is shed each year. The cast-off shell then crumbles, reverting to a mass of soil, which can be spread across fields to promote crop growth."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/76.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/76.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/76.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/76.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/76.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/76.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/76.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/76.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/76.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/76.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/mast