{"height": 5, "weight": 104, "base_experience": 66, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Ball Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ビリリダマ"}, {"language": "ja-roma", "name": "Biriridama"}, {"language": "ko", "name": "찌리리공"}, {"language": "zh-hant", "name": "霹靂電球"}, {"language": "fr", "name": "Voltorbe"}, {"language": "de", "name": "Voltobal"}, {"language": "es", "name": "Voltorb"}, {"language": "it", "name": "Voltorb"}, {"language": "ja", "name": "ビリリダマ"}, {"language": "zh-hans", "name": "霹雳电球"}, {"language": "es-419", "name": "Voltorb"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Usually found in power plants. Easily mistaken for a POKé BALL, they have zapped many people."}, {"versions": ["yellow"], "text": "It is said to camouflage itself as a POKé BALL. It will self-destruct with very little stimulus."}, {"versions": ["gold", "heartgold"], "text": "It rolls to move. If the ground is uneven, a sudden jolt from hitting a bump can cause it to explode."}, {"versions": ["silver"], "text": "It was discovered when POKé BALLS were introduced. It is said that there is some connection."}, {"versions": ["crystal"], "text": "During the study of this POKéMON, it was discovered that its compo­ nents are not found in nature."}, {"versions": ["ruby"], "text": "VOLTORB was first sighted at a company that manufactures POKé BALLS. The link between that sighting and the fact that this POKéMON looks very similar to a POKé BALL remains a mystery."}, {"versions": ["sapphire"], "text": "VOLTORB is extremely sensitive - it explodes at the slightest of shocks. It is rumored that it was first created when a POKé BALL was exposed to a powerful pulse of energy."}, {"versions": ["emerald"], "text": "It bears an uncanny and unexplained resemblance to a POKé BALL. Because it explodes at the slightest shock, even veteran TRAINERS treat it with caution."}, {"versions": ["firered"], "text": "A life-form whose identity is unknown. It is said to SCREECH or suddenly SELFDESTRUCT."}, {"versions": ["leafgreen"], "text": "Usually found in power plants. Easily mistaken for a POKé BALL, it has zapped many people."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It looks just like a Poké Ball. It is dangerous because it may electrocute or explode on touch."}, {"versions": ["soulsilver", "x"], "text": "It was discovered when Poké Balls were introduced. It is said that there is some connection."}, {"versions": ["black-2", "white-2"], "text": "It looks just like a Poké Ball. It is dangerous because it may electrocute or explode on contact."}, {"versions": ["y"], "text": "Usually found in power plants. Easily mistaken for a Poké Ball, it has zapped many people."}, {"versions": ["omega-ruby"], "text": "Voltorb was first sighted at a company that manufactures Poké Balls. The link between that sighting and the fact that this Pokémon looks very similar to a Poké Ball remains a mystery."}, {"versions": ["alpha-sapphire"], "text": "Voltorb is extremely sensitive—it explodes at the slightest of shocks. It is rumored that it was first created when a Poké Ball was exposed to a powerful pulse of energy."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "It is said to camouflage itself as a Poké Ball. It will self-destruct with very little stimulus."}, {"versions": ["legends-arceus"], "text": "An enigmatic Pokémon that happens to bear a resemblance to a Poké Ball. When excited, it discharges the electric current it has stored in its belly, then lets out a great, uproarious laugh."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/100.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemo