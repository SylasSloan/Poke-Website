{"height": 88, "weight": 2100, "base_experience": 77, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Rock Snake Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "イワーク"}, {"language": "ja-roma", "name": "Iwark"}, {"language": "ko", "name": "롱스톤"}, {"language": "zh-hant", "name": "大岩蛇"}, {"language": "fr", "name": "Onix"}, {"language": "de", "name": "Onix"}, {"language": "es", "name": "Onix"}, {"language": "it", "name": "Onix"}, {"language": "ja", "name": "イワーク"}, {"language": "zh-hans", "name": "大岩蛇"}, {"language": "es-419", "name": "Onix"}], "pokedex_entries": [{"versions": ["white", "platinum", "black"], "text": "It burrows through the ground at a speed of 50 mph while feeding on large boulders."}, {"versions": ["black-2", "white-2"], "text": "Opening its large mouth, it ingests massive amounts of soil and creates long tunnels."}, {"versions": ["red", "blue"], "text": "As it grows, the stone portions of its body harden to become similar to a diamond, but colored black."}, {"versions": ["yellow"], "text": "Burrows at high speed in search of food. The tunnels it leaves are used as homes by DIGLETTs."}, {"versions": ["gold", "heartgold"], "text": "It twists and squirms through the ground. The thunderous roar of its tunneling echoes a long way."}, {"versions": ["silver"], "text": "It rapidly bores through the ground at 50 mph by squirming and twisting its mas­ sive, rugged body."}, {"versions": ["crystal", "sword"], "text": "As it digs through the ground, it absorbs many hard objects. This is what makes its body so solid."}, {"versions": ["ruby", "sapphire"], "text": "ONIX has a magnet in its brain. It acts as a compass so that this POKéMON does not lose direction while it is tunneling. As it grows older, its body becomes increasingly rounder and smoother."}, {"versions": ["emerald"], "text": "There is a magnet in its brain that prevents an ONIX from losing direction while tunneling. As it grows older, its body becomes steadily rounder and smoother."}, {"versions": ["firered", "y"], "text": "It usually lives underground. It searches for food while boring its way through the ground at 50 miles per hour."}, {"versions": ["leafgreen"], "text": "As it grows, the stone portions of its body harden to become similar to black-colored diamonds."}, {"versions": ["diamond"], "text": "When it travels underground, it causes rumbling and tremors. It can move at 50 mph."}, {"versions": ["pearl"], "text": "It squirms through the ground using its long and rugged body. It always eats while burrowing."}, {"versions": ["soulsilver", "shield"], "text": "It rapidly bores through the ground at 50 mph by squirming and twisting its massive, rugged body."}, {"versions": ["x", "lets-go-pikachu", "lets-go-eevee"], "text": "Burrows at high speed in search of food. The tunnels it leaves are used as homes by Diglett."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Onix has a magnet in its brain. It acts as a compass so that this Pokémon does not lose direction while it is tunneling. As it grows older, its body becomes increasingly rounder and smoother."}, {"versions": ["legends-arceus"], "text": "This chain of immense stones resembles a giant serpent. Tremors shake the earth above as it burrows deep beneath the ground, feeding on boulders as it goes."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/95.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/95.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/95.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sp