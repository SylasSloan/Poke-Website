{"height": 16, "weight": 782, "base_experience": 270, "ev_yield": [{"stat": "defense", "value": 3}], "genus": "Scaly Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ジャラランガ"}, {"language": "ja-roma", "name": "Jyararanga"}, {"language": "ko", "name": "짜랑고우거"}, {"language": "zh-hant", "name": "杖尾鱗甲龍"}, {"language": "fr", "name": "Ékaïser"}, {"language": "de", "name": "Grandiras"}, {"language": "es", "name": "Kommo-o"}, {"language": "it", "name": "Kommo-o"}, {"language": "ja", "name": "ジャラランガ"}, {"language": "zh-hans", "name": "杖尾鳞甲龙"}, {"language": "es-419", "name": "Kommo-o"}], "pokedex_entries": [{"versions": ["sun"], "text": "When it spots enemies, it threatens them by jingling the scales on its tail. Weak opponents will crack and flee in panic."}, {"versions": ["moon"], "text": "Its rigid scales function as offense and defense. In the past, its scales were processed and used to make weapons and other commodities."}, {"versions": ["ultra-sun"], "text": "When it howls after finishing off its prey, the metallic sounds of its celebrating comrades can be heard from all around."}, {"versions": ["ultra-moon"], "text": "It battles valiantly with its fists, which are armored in steel scales. Kommo-o specializes in uppercuts."}, {"versions": ["sword"], "text": "It clatters its tail scales to unnerve opponents. This Pokémon will battle only those who stand steadfast in the face of this display."}, {"versions": ["shield"], "text": "Certain ruins have paintings of ancient warriors wearing armor made of Kommo-o scales."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/784.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/version