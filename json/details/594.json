{"height": 12, "weight": 316, "base_experience": 165, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Caring Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "fast", "egg_groups": ["water1", "water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ママンボウ"}, {"language": "ja-roma", "name": "Mamanbou"}, {"language": "ko", "name": "맘복치"}, {"language": "zh-hant", "name": "保母曼波"}, {"language": "fr", "name": "Mamanbo"}, {"language": "de", "name": "Mamolida"}, {"language": "es", "name": "Alomomola"}, {"language": "it", "name": "Alomomola"}, {"language": "ja", "name": "ママンボウ"}, {"language": "zh-hans", "name": "保姆曼波"}, {"language": "es-419", "name": "Alomomola"}], "pokedex_entries": [{"versions": ["black"], "text": "The special membrane enveloping Alomomola has the ability to heal wounds."}, {"versions": ["white", "x", "omega-ruby"], "text": "Floating in the open sea is how they live. When they find a wounded Pokémon, they embrace it and bring it to shore."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "It gently holds injured and weak Pokémon in its fins. Its special membrane heals their wounds."}, {"versions": ["sun"], "text": "It uses its special mucus to close the wounds of injured Pokémon. The reason for this behavior remains unknown."}, {"versions": ["moon"], "text": "They float upon the open sea. Many water Pokémon gather in the area around Alomomola."}, {"versions": ["ultra-sun"], "text": "Fishermen take them along on long voyages, because if you have an Alomomola with you, there’ll be no need for a doctor or medicine."}, {"versions": ["ultra-moon"], "text": "The reason it helps Pokémon in a weakened condition is that any Pokémon coming after them may also attack Alomomola."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/594.png", "shiny": null}}, "generat