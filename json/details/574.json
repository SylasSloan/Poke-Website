{"height": 4, "weight": 58, "base_experience": 58, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Fixation Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["humanshape"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ゴチム"}, {"language": "ja-roma", "name": "Gothimu"}, {"language": "ko", "name": "고디탱"}, {"language": "zh-hant", "name": "哥德寶寶"}, {"language": "fr", "name": "Scrutella"}, {"language": "de", "name": "Mollimorba"}, {"language": "es", "name": "Gothita"}, {"language": "it", "name": "Gothita"}, {"language": "ja", "name": "ゴチム"}, {"language": "zh-hans", "name": "哥德宝宝"}, {"language": "es-419", "name": "Gothita"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "Their ribbonlike feelers increase their psychic power. They are always staring at something."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "They intently observe both Trainers and Pokémon. Apparently, they are looking at something that only Gothita can see."}, {"versions": ["black-2", "white-2"], "text": "It stares intently at everything. It can become so obsessed with watching that it doesn’t notice attacks."}, {"versions": ["sword"], "text": "Though they’re still only babies, there’s psychic power stored in their ribbonlike feelers, and sometimes they use that power to fight."}, {"versions": ["shield"], "text": "Even when nobody seems to be around, Gothita can still be heard making a muted cry. Many believe it’s speaking to something only it can see."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/574.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/574.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/spr