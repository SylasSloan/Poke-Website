{"height": 16, "weight": 550, "base_experience": 180, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Jellyfish Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドククラゲ"}, {"language": "ja-roma", "name": "Dokukurage"}, {"language": "ko", "name": "독파리"}, {"language": "zh-hant", "name": "毒刺水母"}, {"language": "fr", "name": "Tentacruel"}, {"language": "de", "name": "Tentoxa"}, {"language": "es", "name": "Tentacruel"}, {"language": "it", "name": "Tentacruel"}, {"language": "ja", "name": "ドククラゲ"}, {"language": "zh-hans", "name": "毒刺水母"}, {"language": "es-419", "name": "Tentacruel"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x"], "text": "The tentacles are normally kept short. On hunts, they are extended to ensnare and immobilize prey."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Its 80 tentacles can stretch and contract freely. They wrap around prey and weaken it with poison."}, {"versions": ["gold"], "text": "Its 80 tentacles absorb water and stretch almost endlessly to CON­ STRICT its prey and enemies."}, {"versions": ["silver"], "text": "In battle, it extends all 80 of its tentacles to entrap its oppo­ nent inside a poisonous net."}, {"versions": ["crystal"], "text": "When its 80 feel­ ers absorb water, it stretches to become like a net to entangle its prey."}, {"versions": ["ruby"], "text": "TENTACRUEL has large red orbs on its head. The orbs glow before lashing the vicinity with a harsh ultrasonic blast. This POKéMON’s outburst creates rough waves around it."}, {"versions": ["sapphire"], "text": "TENTACRUEL has tentacles that can be freely elongated and shortened at will. It ensnares prey with its tentacles and weakens the prey by dosing it with a harsh toxin. It can catch up to 80 prey at the same time."}, {"versions": ["emerald"], "text": "It lives in complex rock formations on the ocean floor and traps prey using its 80 tentacles. Its red orbs glow when it grows excited or agitated."}, {"versions": ["firered", "y"], "text": "It has 80 tentacles that move about freely. They can sting, causing poisoning and sharp, stabbing pain."}, {"versions": ["diamond"], "text": "With 80 tentacles for ensnaring victims, it prevents escape until the prey is weakened by poison."}, {"versions": ["pearl"], "text": "It alerts others to danger by stridently flashing the red orbs on its head."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It extends its 80 tentacles to form an encircling poisonous net that is difficult to escape."}, {"versions": ["heartgold"], "text": "Its 80 tentacles absorb water and stretch almost endlessly to constrict its prey and enemies."}, {"versions": ["soulsilver"], "text": "In battle, it extends all 80 of its tentacles to entrap its opponent inside a poisonous net."}, {"versions": ["omega-ruby"], "text": "Tentacruel has large red orbs on its head. The orbs glow before lashing the vicinity with a harsh ultrasonic blast. This Pokémon’s outburst creates rough waves around it."}, {"versions": ["alpha-sapphire"], "text": "Tentacruel has tentacles that can be freely elongated and shortened at will. It ensnares prey with its tentacles and weakens the prey by dosing it with a harsh toxin. It can catch up to 80 prey at the same time."}, {"versions": ["sun"], "text": "Normally, it has 80 poisonous tentacles. The longer one has been alive, the fewer tentacles it will have."}, {"versions": ["moon"], "text": "Although these Pokémon are rare, when a large outbreak of them occurs, all fish Pokémon disappear from the surrounding sea."}, {"versions": ["ultra-sun"], "text": "It fires off ultrasonic waves from its red orbs to weaken its prey, and then it wraps them up in its 80 tentacles."}, {"versions": ["ultra-moon"], "text": "It communicates with others of its kind by lighting up the red orbs on its head. When the orbs are blinking, it’s a warning sign."}, {"versions": ["sword"], "text": "When the red orbs on Tentacruel’s head glow brightly, watch out. The Pokémon is about to fire off a burst of ultrasonic waves."}, {"versions": ["shield"], "text": "Its 80 tentacles can stretch and shrink freely. Tentacruel ensnares prey in a net of spread-out tentacles, delivering venomous stings to its catch."}, {"versions": ["legends-arceus"], "text": "It has 80 tentacles, each with a venomous tip. These tentacles are also extendible, lengthening when Tentacruel attempts to catch prey. Use caution."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/73.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/73.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/73.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/73.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/73.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/73.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/73.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/73.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/73.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/e