{"height": 9, "weight": 190, "base_experience": 142, "ev_yield": [{"stat": "special-attack", "value": 1}, {"stat": "speed", "value": 1}], "genus": "Volcano Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "マグマラシ"}, {"language": "ja-roma", "name": "Magmarashi"}, {"language": "ko", "name": "마그케인"}, {"language": "zh-hant", "name": "火岩鼠"}, {"language": "fr", "name": "Feurisson"}, {"language": "de", "name": "Igelavar"}, {"language": "es", "name": "Quilava"}, {"language": "it", "name": "Quilava"}, {"language": "ja", "name": "マグマラシ"}, {"language": "zh-hans", "name": "火岩鼠"}, {"language": "es-419", "name": "Quilava"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "Be careful if it turns its back during battle. It means that it will attack with the fire on its back."}, {"versions": ["silver", "firered"], "text": "This POKéMON is fully covered by nonflammable fur. It can withstand any kind of fire attack."}, {"versions": ["crystal", "x"], "text": "Before battle, it turns its back on its opponent to demonstrate how ferociously its fire blazes."}, {"versions": ["ruby", "sapphire"], "text": "QUILAVA keeps its foes at bay with the intensity of its flames and gusts of superheated air. This POKéMON applies its outstanding nimbleness to dodge attacks even while scorching the foe with flames."}, {"versions": ["emerald"], "text": "It intimidates foes with intense gusts of flames and superheated air. Its quick nimbleness lets it dodge attacks even while scorching an enemy."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It intimidates foes with the heat of its flames. The fire burns more strongly when it readies to fight."}, {"versions": ["soulsilver"], "text": "This Pokémon is fully covered by nonflammable fur. It can withstand any kind of fire attack."}, {"vers