{"height": 22, "weight": 2100, "base_experience": 270, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Dragon Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カイリュー"}, {"language": "ja-roma", "name": "Kairyu"}, {"language": "ko", "name": "망나뇽"}, {"language": "zh-hant", "name": "快龍"}, {"language": "fr", "name": "Dracolosse"}, {"language": "de", "name": "Dragoran"}, {"language": "es", "name": "Dragonite"}, {"language": "it", "name": "Dragonite"}, {"language": "ja", "name": "カイリュー"}, {"language": "zh-hans", "name": "快龙"}, {"language": "es-419", "name": "Dragonite"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "An extremely rarely seen marine POKéMON. Its intelligence is said to match that of humans."}, {"versions": ["yellow"], "text": "It is said that this POKéMON lives somewhere in the sea and that it flies. However, it is only a rumor."}, {"versions": ["gold"], "text": "It is said that this POKéMON con­ stantly flies over the immense seas and rescues drown­ ing people."}, {"versions": ["silver"], "text": "This marine POKé­ MON has an impres­ sive build that lets it freely fly over raging seas without trouble."}, {"versions": ["crystal"], "text": "It is said that somewhere in the ocean lies an island where these gather. Only they live there."}, {"versions": ["ruby", "sapphire"], "text": "DRAGONITE is capable of circling the globe in just sixteen hours. It is a kindhearted POKéMON that leads lost and foundering ships in a storm to the safety of land."}, {"versions": ["emerald"], "text": "It can circle the globe in just 16 hours. It is a kindhearted POKéMON that leads lost and foundering ships in a storm to the safety of land."}, {"versions": ["firered", "x"], "text": "It can fly in spite of its big and bulky physique. It circles the globe in just 16 hours."}, {"versions": ["leafgreen"], "text": "Only a very few people ever see this POKéMON. Its intelligence is said to match that of humans."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It is said to make its home somewhere in the sea. It guides crews of shipwrecks to shore."}, {"versions": ["heartgold"], "text": "It is said that this Pokémon constantly flies over the immense seas and rescues drowning people."}, {"versions": ["soulsilver"], "text": "This marine Pokémon has an impressive build that lets it freely fly over raging seas without trouble."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Dragonite is capable of circling the globe in just 16 hours. It is a kindhearted Pokémon that leads lost and foundering ships in a storm to the safety of land."}, {"versions": ["sun"], "text": "This Pokémon saved a shipwrecked man, taking him to a remote island—a paradise occupied solely by Dragonite."}, {"versions": ["moon"], "text": "Incur the wrath of this normally calm Pokémon at your peril, because it will smash everything to smithereens before it’s satisfied."}, {"versions": ["ultra-sun"], "text": "It flies over raging seas as if they were nothing. Observing this, a ship’s captain dubbed this Pokémon “the sea incarnate.”"}, {"versions": ["ultra-moon"], "text": "You’ll often hear tales of this kindhearted Pokémon rescuing people or Pokémon that are drowning."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "It is said that this Pokémon lives somewhere in the sea and that it flies. However, these are only rumors."}, {"versions": ["sword"], "text": "It’s a kindhearted Pokémon. If it spots a drowning person or Pokémon, Dragonite simply must help them."}, {"versions": ["shield"], "text": "This Pokémon is known as the Sea Incarnate. Figureheads that resemble Dragonite decorate the bows of many ships."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g