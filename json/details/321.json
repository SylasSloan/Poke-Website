{"height": 145, "weight": 3980, "base_experience": 175, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Float Whale Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "fast-then-very-slow", "egg_groups": ["ground", "water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ホエルオー"}, {"language": "ja-roma", "name": "Whaloh"}, {"language": "ko", "name": "고래왕"}, {"language": "zh-hant", "name": "吼鯨王"}, {"language": "fr", "name": "Wailord"}, {"language": "de", "name": "Wailord"}, {"language": "es", "name": "Wailord"}, {"language": "it", "name": "Wailord"}, {"language": "ja", "name": "ホエルオー"}, {"language": "zh-hans", "name": "吼鲸王"}, {"language": "es-419", "name": "Wailord"}], "pokedex_entries": [{"versions": ["ruby"], "text": "WAILORD is the largest of all identified POKéMON up to now. This giant POKéMON swims languorously in the vast open sea, eating massive amounts of food at once with its enormous mouth."}, {"versions": ["sapphire"], "text": "When chasing prey, WAILORD herds them by leaping out of the water and making a humongous splash. It is breathtaking to see this POKéMON leaping out of the sea with others in its pod."}, {"versions": ["emerald"], "text": "It breathes through nostrils that it raises above the sea. By inhaling to its maximum capacity, a WAILORD can dive close to 10,000 feet beneath the waves."}, {"versions": ["firered", "leafgreen"], "text": "It is among the largest of all POKéMON. It herds prey in a pack then swallows the massed prey in one gulp."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "The biggest of all Pokémon. It can dive to a depth of almost 10,000 feet on only one breath."}, {"versions": ["heartgold", "soulsilver"], "text": "It is the largest of all identified Pokémon. They jump as a pack to herd their prey."}, {"versions": ["black-2", "white-2", "x", "sword"], "text": "It can sometimes knock out opponents with the shock created by breaching and crashing its big body onto the water."}, {"versions": ["omega-ruby"], "text": "Wailord is the largest of all identified Pokémon up to now. This giant Pokémon swims languorously in the vast open sea, eating massive amounts of food at once with its enormous mouth."}, {"versions": ["alpha-sapphire"], "text": "When chasing prey, Wailord herds them by leaping out of the water and making a humongous splash. It is breathtaking to see this Pokémon leaping out of the sea with others in its pod."}, {"versions": ["sun"], "text": "Wailord pursue their prey in pods. With their large mouths, they can swallow entire schools of Wishiwashi whole."}, {"versions": ["moon", "shield"], "text": "Its immense size is the reason for its popularity. Wailord watching is a favorite sightseeing activity in various parts of the world."}, {"versions": ["ultra-sun"], "text": "They eat so many fish Pokémon that when Wailord become too numerous, fishermen have to chase them off."}, {"versions": ["ultra-moon"], "text": "When a small Wailmer is attacked by Sharpedo or Dhelmise, its whole pod works together to protect it."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/321.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/321.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/321.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/321.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/321.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/321.png"