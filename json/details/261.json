{"height": 5, "weight": 136, "base_experience": 56, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Bite Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ポチエナ"}, {"language": "ja-roma", "name": "Pochiena"}, {"language": "ko", "name": "포챠나"}, {"language": "zh-hant", "name": "土狼犬"}, {"language": "fr", "name": "Medhyèna"}, {"language": "de", "name": "Fiffyen"}, {"language": "es", "name": "Poochyena"}, {"language": "it", "name": "Poochyena"}, {"language": "ja", "name": "ポチエナ"}, {"language": "zh-hans", "name": "土狼犬"}, {"language": "es-419", "name": "Poochyena"}], "pokedex_entries": [{"versions": ["ruby"], "text": "At first sight, POOCHYENA takes a bite at anything that moves. This POKéMON chases after prey until the victim becomes exhausted. However, it may turn tail if the prey strikes back."}, {"versions": ["sapphire"], "text": "POOCHYENA is an omnivore - it will eat anything. A distinguishing feature is how large its fangs are compared to its body. This POKéMON tries to intimidate its foes by making the hair on its tail bristle out."}, {"versions": ["emerald"], "text": "It savagely threatens foes with bared fangs. It chases after fleeing targets tenaciously. It turns tail and runs, however, if the foe strikes back."}, {"versions": ["firered", "leafgreen", "y"], "text": "It has a very tenacious nature. Its acute sense of smell lets it chase a chosen prey without ever losing track."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "A Pokémon with a persistent nature, it chases its chosen prey until the prey becomes exhausted."}, {"versions": ["heartgold", "soulsilver"], "text": "It chases its prey until the victim becomes exhausted. However, it turns tail if the prey strikes back."}, {"versions": ["omega-ruby"], "text": "At first sight, Poochyena takes a bite at anything that moves. This Pokémon chases after prey until the victim becomes exhausted. However, it may turn tail if the prey strikes back."}, {"versions": ["alpha-sapphire"], "text": "Poochyena is an omnivore—it will eat anything. A distinguishing feature is how large its fangs are compared to its body. This Pokémon tries to intimidate its foes by making the hair on its tail bristle out."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/261.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/261.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/261.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/261.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/261.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/261.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/261.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/261.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/261.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/261.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generat