{"height": 10, "weight": 600, "base_experience": 163, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Magnet Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "レアコイル"}, {"language": "ja-roma", "name": "Rarecoil"}, {"language": "ko", "name": "레어코일"}, {"language": "zh-hant", "name": "三合一磁怪"}, {"language": "fr", "name": "Magnéton"}, {"language": "de", "name": "Magneton"}, {"language": "es", "name": "Magneton"}, {"language": "it", "name": "Magneton"}, {"language": "ja", "name": "レアコイル"}, {"language": "zh-hans", "name": "三合一磁怪"}, {"language": "es-419", "name": "Magneton"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Formed by several MAGNEMITEs linked together. They frequently appear when sunspots flare up."}, {"versions": ["yellow"], "text": "Generates strange radio signals. It raises the tem­ perature by 3.6F degrees within 3,300 feet."}, {"versions": ["gold", "heartgold"], "text": "Three MAGNEMITE are linked by a strong magnetic force. Earaches will occur if you get too close."}, {"versions": ["silver"], "text": "The MAGNEMITE are united by a mag­ netism so power­ ful, it dries all moisture in its vicinities."}, {"versions": ["crystal"], "text": "When many MAGNETON gather together, the resulting magnetic storm disrupts radio waves."}, {"versions": ["ruby"], "text": "MAGNETON emits a powerful magnetic force that is fatal to mechanical devices. As a result, large cities sound sirens to warn citizens of large-scale outbreaks of this POKéMON."}, {"versions": ["sapphire"], "text": "MAGNETON emits a powerful magnetic force that is fatal to electronics and precision instruments. Because of this, it is said that some towns warn people to keep this POKéMON inside a POKé BALL."}, {"versions": ["emerald"], "text": "It is actually three MAGNEMITE linked by magnetism. It generates powerful radio waves that raise temperatures by 3.6 degrees F within a 3,300-foot radius."}, {"versions": ["firered"], "text": "A linked cluster formed of several MAGNEMITE. It discharges powerful magnetic waves at high voltage."}, {"versions": ["leafgreen"], "text": "Formed by several MAGNEMITE linked together. They frequently appear when sunspots flare up."}, {"versions": ["diamond", "pearl"], "text": "It is actually three MAGNEMITE linked by magnetism. A group can set off a magnetic storm."}, {"versions": ["platinum", "black", "white"], "text": "Many mysteriously appear when more sunspots dot the sun. They stop TV sets from displaying properly."}, {"versions": ["soulsilver"], "text": "The MAGNEMITE are united by a magnetism so powerful, it dries all moisture in its vicinity."}, {"versions": ["black-2", "white-2"], "text": "The stronger electromagnetic waves from the three linked Magnemite are enough to dry out surrounding moisture."}, {"versions": ["x"], "text": "A linked cluster formed of several Magnemite. It discharges powerful magnetic waves at high voltage."}, {"versions": ["y", "lets-go-pikachu", "lets-go-eevee"], "text": "Generates strange radio signals. It raises the temperature by 3.6 degrees Fahrenheit within 3,300 feet."}, {"versions": ["omega-ruby"], "text": "Magneton emits a powerful magnetic force that is fatal to mechanical devices. As a result, large cities sound sirens to warn citizens of large-scale outbreaks of this Pokémon."}, {"versions": ["alpha-sapphire"], "text": "Magneton emits a powerful magnetic force that is fatal to electronics and precision instruments. Because of this, it is said that some towns warn people to keep this Pokémon inside a Poké Ball."}, {"versions": ["sun"], "text": "When three Magnemite link together, their brains also become one. They do not become three times more intelligent."}, {"versions": ["moon"], "text": "It has about three times the electrical power of Magnemite. For some reason, outbreaks of this Pokémon happen when lots of sunspots appear."}, {"versions": ["ultra-sun"], "text": "Delicate equipment can malfunction in areas inhabited by Magneton, which send out mysterious electrical signals."}, {"versions": ["ultra-moon"], "text": "When rain clouds form, many Magneton gather in high places to wait for lightning to strike."}, {"versions": ["sword"], "text": "This Pokémon is three Magnemite that have linked together. Magneton sends out powerful radio waves to study its surroundings."}, {"versions": ["shield"], "text": "This Pokémon is constantly putting out a powerful magnetic force. Most computers go haywire when a Magneton approaches."}, {"versions": ["legends-arceus"], "text": "Three Magnemite gathered to evolve into this Pokémon. The source of much vexation on my part, as its powerful magnetism destroys my research equipment."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/82.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/82.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/82.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/82.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/82.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/82.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/82.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/82.png"}}, "generation-iii": {"emerald": {"normal": "https://r