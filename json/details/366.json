{"height": 4, "weight": 525, "base_experience": 69, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Bivalve Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "パールル"}, {"language": "ja-roma", "name": "Pearlulu"}, {"language": "ko", "name": "진주몽"}, {"language": "zh-hant", "name": "珍珠貝"}, {"language": "fr", "name": "Coquiperl"}, {"language": "de", "name": "Perlu"}, {"language": "es", "name": "Clamperl"}, {"language": "it", "name": "Clamperl"}, {"language": "ja", "name": "パールル"}, {"language": "zh-hans", "name": "珍珠贝"}, {"language": "es-419", "name": "Clamperl"}], "pokedex_entries": [{"versions": ["ruby"], "text": "CLAMPERL’s sturdy shell is not only good for protection - it is also used for clamping and catching prey. A fully grown CLAMPERL’s shell will be scored with nicks and scratches all over."}, {"versions": ["sapphire"], "text": "CLAMPERL grows while being protected by its rock-hard shell. When its body becomes too large to fit inside the shell, it is sure evidence that this POKéMON is getting close to evolution."}, {"versions": ["emerald"], "text": "A CLAMPERL slams its shell closed on prey to prevent escape. The pearl it creates upon evolution is said to be infused with a mysterious energy."}, {"versions": ["firered", "leafgreen", "y"], "text": "It is protected by a sturdy shell. Once in a lifetime, it makes a magnificent pearl."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It makes a single pearl during its lifetime. The pearl is said to amplify psychic power."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "When it evolves, it makes a mysterious pearl that amplifies psychic powers when it’s held."}, {"versions": ["omega-ruby"], "text": "Clamperl’s sturdy shell is not only good for protection—it is also used for clamping and catching prey. A fully grown Clamperl’s shell will be scored with nicks and scratches all over."}, {"versions": ["alpha-sapphire"], "text": "Clamperl grows while being protected by its rock-hard shell. When its body becomes too large to fit inside the shell, it is sure evidence that this Pokémon is getting close to evolution."}, {"versions": ["ultra-sun"], "text": "Despite its appearance, it’s carnivorous. It clamps down on its prey with both sides of its shell and doesn’t let go until they stop moving."}, {"versions": ["ultra-moon"], "text": "Clamperl’s pearls are exceedingly precious. They can be more than 10 times as costly as Shellder’s pearls."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/366.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/366.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/366.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/366.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/366.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/366.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/366.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/366.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/366.png", "shiny": "ht