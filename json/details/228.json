{"height": 6, "weight": 108, "base_experience": 66, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Dark Pokémon", "capture_rate": 120, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "デルビル"}, {"language": "ja-roma", "name": "Delvil"}, {"language": "ko", "name": "델빌"}, {"language": "zh-hant", "name": "戴魯比"}, {"language": "fr", "name": "Malosse"}, {"language": "de", "name": "Hunduster"}, {"language": "es", "name": "Houndour"}, {"language": "it", "name": "Houndour"}, {"language": "ja", "name": "デルビル"}, {"language": "zh-hans", "name": "戴鲁比"}, {"language": "es-419", "name": "Houndour"}], "pokedex_entries": [{"versions": ["gold", "heartgold"], "text": "It uses different kinds of cries for communicating with others of its kind and for pursuing its prey."}, {"versions": ["silver"], "text": "To corner prey, they check each other's location using barks that only they can understand."}, {"versions": ["crystal", "x"], "text": "Around dawn, its ominous howl echoes through the area to announce that this is its territory."}, {"versions": ["ruby", "sapphire"], "text": "HOUNDOUR hunt as a coordinated pack. They communicate with each other using a variety of cries to corner their prey. This POKéMON’s remarkable teamwork is unparalleled."}, {"versions": ["emerald"], "text": "HOUNDOUR communicate with each other using a variety of cries to corner their prey. This POKéMON’s remarkable teamwork is simply unparalleled."}, {"versions": ["firered", "soulsilver", "y"], "text": "To corner prey, they check each other’s location using barks that only they can understand."}, {"versions": ["leafgreen"], "text": "It uses different kinds of cries for communicating with others of its kind and for pursuing prey."}, {"versions": ["diamond", "pearl"], "text": "It conveys its feelings using different cries. It works in a pack to cleverly take down prey."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It is smart enough to hunt in packs. It uses a variety of cries for communicating with others."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Houndour hunt as a coordinated pack. They communicate with each other using a variety of cries to corner their prey. This Pokémon’s remarkable teamwork is unparalleled."}, {"versions": ["ultra-sun"], "text": "It cooperates with others skillfully. When it becomes your partner, it’s very loyal to you as its Trainer and will obey your orders."}, {"versions": ["ultra-moon"], "text": "They make repeated eerie howls before dawn to call attention to their pack."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/228.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/228.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/228.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/228.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/228.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/228.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/228.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/228.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/228.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master