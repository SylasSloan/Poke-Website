{"height": 10, "weight": 324, "base_experience": 66, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Hypnosis Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "スリープ"}, {"language": "ja-roma", "name": "Sleepe"}, {"language": "ko", "name": "슬리프"}, {"language": "zh-hant", "name": "催眠貘"}, {"language": "fr", "name": "Soporifik"}, {"language": "de", "name": "Traumato"}, {"language": "es", "name": "Drowzee"}, {"language": "it", "name": "Drowzee"}, {"language": "ja", "name": "スリープ"}, {"language": "zh-hans", "name": "催眠貘"}, {"language": "es-419", "name": "Drowzee"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Puts enemies to sleep then eats their dreams. Occasionally gets sick from eating bad dreams."}, {"versions": ["yellow"], "text": "If you sleep by it all the time, it will sometimes show you dreams it has eaten in the past."}, {"versions": ["gold"], "text": "If you think that you had a good dream, but you can't remember it, a DROWZEE has probably eaten it."}, {"versions": ["silver"], "text": "It remembers every dream it eats. It rarely eats the dreams of adults because children's are much tastier."}, {"versions": ["crystal"], "text": "When it twitches its nose, it can tell where someone is sleeping and what that person is dreaming about."}, {"versions": ["ruby", "sapphire"], "text": "If your nose becomes itchy while you are sleeping, it’s a sure sign that one of these POKéMON is standing above your pillow and trying to eat your dream through your nostrils."}, {"versions": ["emerald"], "text": "If your nose becomes itchy while you are sleeping, it’s a sure sign that a DROWZEE is standing above your pillow and trying to eat your dream through your nostrils."}, {"versions": ["firered"], "text": "A descendent of the legendary animal baku, which is said to eat dreams. It is skilled at hypnotism."}, {"versions": ["leafgreen", "x"], "text": "Puts enemies to sleep, then eats their dreams. Occasionally gets sick from eating only bad dreams."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It can tell what people are dreaming by sniffing with its big nose. It loves fun dreams."}, {"versions": ["heartgold"], "text": "If you think that you had a good dream but you can’t remember it, a DROWZEE has probably eaten it."}, {"versions": ["soulsilver"], "text": "It remembers every dream it eats. It rarely eats the dreams of adults because children’s are much tastier."}, {"versions": ["y"], "text": "If you think that you had a good dream but you can’t remember it, a Drowzee has probably eaten it."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "If your nose becomes itchy while you are sleeping, it’s a sure sign that one of these Pokémon is standing above your pillow and trying to eat your dream through your nostrils."}, {"versions": ["sun"], "text": "A Pokémon that nourishes itself by eating dreams, it is thought to share common ancestry with Munna and Musharna."}, {"versions": ["moon"], "text": "It finds really fun dreams tasty. When it makes friends with people, it may show them the most delicious dreams it’s ever eaten."}, {"versions": ["ultra-sun"], "text": "It can be spotted near recreational facilities, intending to eat the pleasant dreams of children who enjoyed themselves there that day."}, {"versions": ["ultra-moon"], "text": "It puts its prey to sleep and devours their dreams. It seems that bad dreams taste sour, so Drowzee doesn’t particularly like eating them."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "If you sleep by it all the time, it will sometimes show you dreams it had eaten in the past."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/96.png", "shiny": null}, "yellow"