{"height": 12, "weight": 360, "base_experience": 63, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Dopey Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster", "water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤドン"}, {"language": "ja-roma", "name": "Yadon"}, {"language": "ko", "name": "야돈"}, {"language": "zh-hant", "name": "呆呆獸"}, {"language": "fr", "name": "Ramoloss"}, {"language": "de", "name": "Flegmon"}, {"language": "es", "name": "Slowpoke"}, {"language": "it", "name": "Slowpoke"}, {"language": "ja", "name": "ヤドン"}, {"language": "zh-hans", "name": "呆呆兽"}, {"language": "es-419", "name": "Slowpoke"}], "pokedex_entries": [{"versions": ["crystal"], "text": "It is always so absent-minded that it won't react, even if its flavorful tail is bitten."}, {"versions": ["red", "blue"], "text": "Incredibly slow and dopey. It takes 5 seconds for it to feel pain when under attack."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Incredibly slow and sluggish. It is quite content to loll about without worrying about the time."}, {"versions": ["gold"], "text": "It lazes vacantly near water. If something bites its tail, it won't even notice for a whole day."}, {"versions": ["silver"], "text": "A sweet sap leaks from its tail's tip. Although not nutritious, the tail is pleasant to chew on."}, {"versions": ["ruby", "sapphire"], "text": "SLOWPOKE uses its tail to catch prey by dipping it in water at the side of a river. However, this POKéMON often forgets what it’s doing and often spends entire days just loafing at water’s edge."}, {"versions": ["emerald"], "text": "It catches prey by dipping its tail in water at the side of a river. But it often forgets what it is doing and spends entire days just loafing at water’s edge."}, {"versions": ["firered", "x"], "text": "It is always vacantly lost in thought, but no one knows what it is thinking about. It is good at fishing with its tail."}, {"versions": ["leafgreen"], "text": "Incredibly slow and dopey. It takes five seconds for it to feel pain when under attack."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Although slow, it is skilled at fishing with its tail. It does not feel pain if its tail is bitten."}, {"versions": ["heartgold", "y"], "text": "It lazes vacantly near water. If something bites its tail, it won’t even notice for a whole day."}, {"versions": ["soulsilver"], "text": "A sweet sap leaks from its tail’s tip. Although not nutritious, the tail is pleasant to chew on."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Slowpoke uses its tail to catch prey by dipping it in water at the side of a river. However, this Pokémon often forgets what it’s doing and often spends entire days just loafing at water’s edge."}, {"versions": ["sun"], "text": "Its long tail often breaks off. It doesn’t really feel any pain, though, and the tail grows back, so Slowpoke isn’t particularly bothered."}, {"versions": ["moon"], "text": "Alolan home cooking involves drying Slowpoke tails and then simmering them into a salty stew."}, {"versions": ["ultra-sun"], "text": "There are some places where Slowpoke is worshiped because of a long-standing belief that whenever Slowpoke yawns, it rains."}, {"versions": ["ultra-moon"], "text": "Although their tails, which fall off naturally, can easily be found lying around, they’re a precious ingredient for cooking."}, {"versions": ["sword"], "text": "Slow-witted and oblivious, this Pokémon won’t feel any pain if its tail gets eaten. It won’t notice when its tail grows back, either."}, {"versions": ["shield"], "text": "When this Pokémon’s tail is soaked in water, sweetness seeps from it. Slowpoke uses this trait to lure in and fish up other Pokémon."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g