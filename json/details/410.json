{"height": 5, "weight": 570, "base_experience": 70, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Shield Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["monster"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "タテトプス"}, {"language": "ja-roma", "name": "Tatetops"}, {"language": "ko", "name": "방패톱스"}, {"language": "zh-hant", "name": "盾甲龍"}, {"language": "fr", "name": "Dinoclier"}, {"language": "de", "name": "Schilterus"}, {"language": "es", "name": "Shieldon"}, {"language": "it", "name": "Shieldon"}, {"language": "ja", "name": "タテトプス"}, {"language": "zh-hans", "name": "盾甲龙"}, {"language": "es-419", "name": "Shieldon"}], "pokedex_entries": [{"versions": ["diamond"], "text": "A Pokémon that lived in jungles around 100 million years ago. Its facial hide is extremely hard."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It habitually polishes its face by rubbing it against tree trunks. It is weak to attacks from behind."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It is outstandingly armored. As a result, it can eat grass and berries without having to fight."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "It was generated from a fossil dug out of a layer of clay that was older than anyone knows. It has a sturdy face."}, {"versions": ["sun"], "text": "Many fossils of this Pokémon have been found, but almost none have shown signs of damage to the face."}, {"versions": ["moon"], "text": "This Pokémon lived in primeval jungles. Few enemies would have been willing to square off against its heavily armored face, so it’s thought."}, {"versions": ["ultra-sun"], "text": "A mild-mannered, herbivorous Pokémon, it used its face to dig up tree roots to eat. The skin on its face was plenty tough."}, {"versions": ["ultra-moon"], "text": "Although its fossils can be found in layers of primeval rock, nothing but its face has ever been discovered."}, {"versions": ["legends-arceus"], "text": "Much remains unknown about this Pokémon, as few have ever seen it. However, we know that it is calm and dislikes conflict, and it enjoys polishing its face against trees and rocks."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/410.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/410.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/410.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/410.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/410.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/410.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/410.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/410.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/410.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/410.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/410.png"}, "x-y": {"normal": "htt