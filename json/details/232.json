{"height": 11, "weight": 1200, "base_experience": 175, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Armor Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドンファン"}, {"language": "ja-roma", "name": "Donfan"}, {"language": "ko", "name": "코리갑"}, {"language": "zh-hant", "name": "頓甲"}, {"language": "fr", "name": "Donphan"}, {"language": "de", "name": "Donphan"}, {"language": "es", "name": "Donphan"}, {"language": "it", "name": "Donphan"}, {"language": "ja", "name": "ドンファン"}, {"language": "zh-hans", "name": "顿甲"}, {"language": "es-419", "name": "Donphan"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It has sharp, hard tusks and a rugged hide. Its TACKLE is strong enough to knock down a house."}, {"versions": ["silver", "soulsilver", "y"], "text": "The longer and bigger its tusks, the higher its rank in its herd. The tusks take long to grow."}, {"versions": ["crystal"], "text": "Because this POKéMON's skin is so tough, a normal attack won't even leave a scratch on it."}, {"versions": ["ruby"], "text": "DONPHAN’s favorite attack is curling its body into a ball, then charging at its foe while rolling at high speed. Once it starts rolling, this POKéMON can’t stop very easily."}, {"versions": ["sapphire"], "text": "If DONPHAN were to tackle with its hard body, even a house could be destroyed. Using its massive strength, the POKéMON helps clear rock and mud slides that block mountain trails."}, {"versions": ["emerald"], "text": "A DONPHAN is so strong it can easily haul a dump truck. Its hide has toughened to a rock-hard state. An ordinary sort of attack won’t even leave a scratch."}, {"versions": ["firered"], "text": "The longer and bigger its tusks, the higher its rank in its herd. The tusks take a long time to grow."}, {"versions": ["diamond", "pearl", "platinum", "black", "whi