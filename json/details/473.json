{"height": 25, "weight": 2910, "base_experience": 239, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Twin Tusk Pokémon", "capture_rate": 50, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "it", "name": "Mamoswine"}, {"language": "ja-hrkt", "name": "マンムー"}, {"language": "ja-roma", "name": "Mammoo"}, {"language": "ko", "name": "맘모꾸리"}, {"language": "zh-hant", "name": "象牙豬"}, {"language": "fr", "name": "Mammochon"}, {"language": "de", "name": "Mamutel"}, {"language": "es", "name": "Mamoswine"}, {"language": "ja", "name": "マンムー"}, {"language": "zh-hans", "name": "象牙猪"}, {"language": "es-419", "name": "Mamoswine"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "y", "alpha-sapphire"], "text": "Its impressive tusks are made of ice. The population thinned when it turned warm after the ice age."}, {"versions": ["platinum", "black", "white"], "text": "A frozen one was dug up from soil dating back 10,000 years. It woke up to much amazement."}, {"versions": ["heartgold"], "text": "A frozen MAMOSWINE was dug from ice dating back 10,000 years. This Pokémon has been around a long, long, long time."}, {"versions": ["soulsilver"], "text": "It flourished worldwide during the ice age but its population declined when the masses of ice began to dwindle."}, {"versions": ["black-2", "white-2"], "text": "When the temperature rose at the end of the ice age, most Mamoswine disappeared."}, {"versions": ["x", "omega-ruby"], "text": "A frozen Mamoswine was dug from ice dating back 10,000 years. This Pokémon has been around a long, long, long time."}, {"versions": ["sword"], "text": "This Pokémon can be spotted in wall paintings from as far back as 10,000 years ago. For a while, it was thought to have gone extinct."}, {"versions": ["shield"], "text": "It looks strong, and that’s exactly what it is. As the weather grows colder, its ice tusks grow longer, thicker, and more impressive."}, {"versions": ["legends-arceus"], "text": "This species reached its zenith during the period known as the ice age. I suspect that Hisui's frigid climate is in harmony with Mamoswine's constitution, thus awakening hidden potential."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/473.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/473.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/473.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/473.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/473.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/473.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/473.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/473.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/473.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/473.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/473.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/P