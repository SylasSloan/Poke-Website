{"height": 8, "weight": 345, "base_experience": 68, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Star Shape Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water3"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ヒトデマン"}, {"language": "ja-roma", "name": "Hitodeman"}, {"language": "ko", "name": "별가사리"}, {"language": "zh-hant", "name": "海星星"}, {"language": "fr", "name": "Stari"}, {"language": "de", "name": "Sterndu"}, {"language": "es", "name": "Staryu"}, {"language": "it", "name": "Staryu"}, {"language": "ja", "name": "ヒトデマン"}, {"language": "zh-hans", "name": "海星星"}, {"language": "es-419", "name": "Staryu"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "An enigmatic POKéMON that can effortlessly regenerate any appendage it loses in battle."}, {"versions": ["yellow"], "text": "As long as the center section is unharmed, it can grow back fully even if it is chopped to bits."}, {"versions": ["gold"], "text": "At night, the cen­ ter of its body slowly flickers with the same rhythm as a human heartbeat."}, {"versions": ["silver"], "text": "Even if its body is torn, it can regenerate as long as the glowing central core re­ mains intact."}, {"versions": ["crystal"], "text": "When the stars twinkle at night, it floats up from the sea floor, and its body's center core flickers."}, {"versions": ["ruby"], "text": "STARYU’s center section has an organ called the core that shines bright red. If you go to a beach toward the end of summer, the glowing cores of these POKéMON look like the stars in the sky."}, {"versions": ["sapphire"], "text": "STARYU apparently communicates with the stars in the night sky by flashing the red core at the center of its body. If parts of its body are torn, this POKéMON simply regenerates the missing pieces and limbs."}, {"versions": ["emerald"], "text": "It gathers with others in the night and makes its red core glow on and off with the twinkling stars. It can regenerate limbs if they are severed from its body."}, {"versions": ["firered", "y"], "text": "It appears in large numbers by seashores. At night, its central core flashes with a red light."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "If its body is torn, it can grow back if the red core remains. The core flashes at midnight."}, {"versions": ["heartgold"], "text": "At night, the middle of its body slowly flickers with the same rhythm as a human heartbeat."}, {"versions": ["soulsilver", "x"], "text": "Even if its body is torn, it can regenerate as long as the glowing central core remains intact."}, {"versions": ["black-2", "white-2"], "text": "As long as its red core remains, it can regenerate its body instantly, even if it’s torn apart."}, {"versions": ["omega-ruby"], "text": "Staryu’s center section has an organ called the core that shines bright red. If you go to a beach toward the end of summer, the glowing cores of these Pokémon look like the stars in the sky."}, {"versions": ["alpha-sapphire"], "text": "Staryu apparently communicates with the stars in the night sky by flashing the red core at the center of its body. If parts of its body are torn, this Pokémon simply regenerates the missing pieces and limbs."}, {"versions": ["sun"], "text": "Large numbers of these Pokémon make their home at the seaside. At night, a strange red glow radiates from the center of their bodies."}, {"versions": ["moon"], "text": "This Pokémon gets nibbled on by Lumineon and others. Thanks to its red core, it regenerates fast, so it’s unconcerned by their snack attacks."}, {"versions": ["ultra-sun"], "text": "In many places, there are folktales of stardust falling into the ocean and becoming Staryu."}, {"versions": ["ultra-moon"], "text": "No number of injuries can bother Staryu. Its amazing regenerative powers return it to its previous state in half a day!"}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "As long as the center section is unharmed, this Pokémon can grow back fully even if it is chopped to bits."}, {"versions": ["sword"], "text": "If you visit a beach at the end of summer, you’ll be able to see groups of Staryu lighting up in a steady rhythm."}, {"versions": ["shield"], "text": "Fish Pokémon nibble at it, but Staryu isn’t bothered. Its body regenerates quickly, even if part of it is completely torn off."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/120.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/120.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/120.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/120.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/120.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/120.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/120.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/120.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/120.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/120.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgre