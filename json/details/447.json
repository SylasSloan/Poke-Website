{"height": 7, "weight": 202, "base_experience": 57, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Emanation Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium-slow", "egg_groups": ["no-eggs"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "リオル"}, {"language": "ja-roma", "name": "Riolu"}, {"language": "ko", "name": "리오르"}, {"language": "zh-hant", "name": "利歐路"}, {"language": "fr", "name": "Riolu"}, {"language": "de", "name": "Riolu"}, {"language": "es", "name": "Riolu"}, {"language": "it", "name": "Riolu"}, {"language": "ja", "name": "リオル"}, {"language": "zh-hans", "name": "利欧路"}, {"language": "es-419", "name": "Riolu"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "The aura that emanates from its body intensifies to alert others if it is afraid or sad."}, {"versions": ["pearl"], "text": "Its body is lithe yet powerful. It can crest three mountains and cross two canyons in one night."}, {"versions": ["platinum", "black", "white"], "text": "It has the peculiar power of being able to see emotions such as joy and rage in the form of waves."}, {"versions": ["heartgold", "soulsilver"], "text": "They communicate with one another using their auras. They are able to run all through the night."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "It uses the shapes of auras, which change according to emotion, to communicate with others."}, {"versions": ["sun"], "text": "It can discern the physical and emotional states of people, Pokémon, and other natural things from the shape of their aura waves."}, {"versions": ["moon"], "text": "It’s tough enough to run right through the night, and it’s also a hard worker, but it’s still just a youngster."}, {"versions": ["ultra-sun"], "text": "It knows how people and Pokémon feel by looking at their auras. It doesn’t approach dangerous opponents."}, {"versions": ["ultra-moon"], "text": "It uses waves called auras to communicate with others of its kind. It doesn’t make any noise during this time, so its enemies can’t detect it."}, {"versions": ["sword"], "text": "It’s exceedingly energetic, with enough stamina to keep running all through the night. Taking it for walks can be a challenging experience."}, {"versions": ["shield"], "text": "It can use waves called auras to gauge how others are feeling. These same waves can also tell this Pokémon about the state of the environment."}, {"versions": ["legends-arceus"], "text": "Though infantile in appearance, it has the mysterious ability to read the minds of humans. The pure of heart are met with Riolu's approval, while those of ill nature earn only its loathing."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/447.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/447.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/447.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/447.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/447.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/447.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/447.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/447.png", "shiny": "https://raw.githubusercontent.com/PokeAPI