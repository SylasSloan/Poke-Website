{"height": 9, "weight": 315, "base_experience": 70, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Head Butt Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["monster"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ズガイドス"}, {"language": "ja-roma", "name": "Zugaidos"}, {"language": "ko", "name": "두개도스"}, {"language": "zh-hant", "name": "頭蓋龍"}, {"language": "fr", "name": "Kranidos"}, {"language": "de", "name": "Koknodon"}, {"language": "es", "name": "Cranidos"}, {"language": "it", "name": "Cranidos"}, {"language": "ja", "name": "ズガイドス"}, {"language": "zh-hans", "name": "头盖龙"}, {"language": "es-419", "name": "Cranidos"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It lived in jungles around 100 million years ago. Its skull is as hard as iron."}, {"versions": ["pearl"], "text": "It was resurrected from an iron ball-like fossil. It downs prey with its head butts."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "A lifelong jungle dweller from 100 million years ago, it would snap obstructing trees with head butts."}, {"versions": ["heartgold", "soulsilver"], "text": "CRANIDOS toughen up their already rock-hard heads by headbutting one another."}, {"versions": ["x", "omega-ruby"], "text": "It was resurrected from an iron ball-like fossil. It downs prey with its headbutts."}, {"versions": ["y", "alpha-sapphire"], "text": "A lifelong jungle dweller from 100 million years ago, it would snap obstructing trees with headbutts."}, {"versions": ["sun"], "text": "It lived in jungles around a hundred million years ago. It used its skillful headbutts to combat Aerodactyl."}, {"versions": ["moon"], "text": "In rock layers where Cranidos fossils are found, the fossilized trunks of trees snapped in two are also often found."}, {"versions": ["ultra-sun"], "text": "A primeval Pokémon, it possesses a hard and sturdy skull, lacking any intelligence within."}, {"versions": ["ultra-moon"], "text": "Its hard skull is its distinguishing feature. It snapped trees by headbutting them, and then it fed on their ripe berries."}, {"versions": ["legends-arceus"], "text": "An incredibly rare sight. They duel each other by ramming their heads together, and the resulting sound echoes throughout the area like the pealing of a bell."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/408.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/408.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/408.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/408.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/408.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/408.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/408.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/408.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/408.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/408.png", "shiny": "https://raw.githubusercontent.com/PokeAP