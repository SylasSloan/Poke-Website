{"height": 8, "weight": 115, "base_experience": 72, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Long Tail Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "エイパム"}, {"language": "ja-roma", "name": "Eipam"}, {"language": "ko", "name": "에이팜"}, {"language": "zh-hant", "name": "長尾怪手"}, {"language": "fr", "name": "Capumain"}, {"language": "de", "name": "Griffel"}, {"language": "es", "name": "Aipom"}, {"language": "it", "name": "Aipom"}, {"language": "ja", "name": "エイパム"}, {"language": "zh-hans", "name": "长尾怪手"}, {"language": "es-419", "name": "Aipom"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "Its tail is so powerful that it can use it to grab a tree branch and hold itself up in the air."}, {"versions": ["silver"], "text": "It lives atop tall trees. When leap­ ing from branch to branch, it deftly uses its tail for balance."}, {"versions": ["crystal"], "text": "It uses its tail to hang on to tree branches. It uses its momentum to swing from one branch to another."}, {"versions": ["ruby", "sapphire"], "text": "AIPOM’s tail ends in a hand-like appendage that can be cleverly manipulated. However, because the POKéMON uses its tail so much, its real hands have become rather clumsy."}, {"versions": ["emerald"], "text": "Its tail ends with a dexterous, handlike appendage. However, because it uses the tail so much, AIPOM’s real hands have become rather clumsy."}, {"versions": ["firered", "soulsilver", "x"], "text": "It lives atop tall trees. When leaping from branch to branch, it deftly uses its tail for balance."}, {"versions": ["diamond"], "text": "It uses its tail to pluck fruits that are out of reach. Its tail is more adept than its real hands."}, {"versions": ["pearl"], "text": "It lives atop giant trees. It wraps its tail around a branch so it won’t fall off while asleep."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It lives high among the treetops. It can use its tail as freely and cleverly as its hands."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Aipom’s tail ends in a hand-like appendage that can be cleverly manipulated. However, because the Pokémon uses its tail so much, its real hands have become rather clumsy."}, {"versions": ["ultra-sun"], "text": "As it did more and more with its tail, its hands became clumsy. It makes its nest high in the treetops."}, {"versions": ["ultra-moon"], "text": "It searches for prey from the tops of trees. When it spots its favorite food, Bounsweet, Aipom gets excited and pounces."}, {"versions": ["legends-arceus"], "text": "This treetop dweller possesses a tail as dexterous as a hand. Ancient writings describe this Pokémon as a one-armed oddity."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/190.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/190.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/190.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/190.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/190.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/190.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/190.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/190.png"}, "ruby-sapphire": {"nor