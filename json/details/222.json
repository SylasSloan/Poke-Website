{"height": 6, "weight": 50, "base_experience": 144, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Coral Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["water1", "water3"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "サニーゴ"}, {"language": "ja-roma", "name": "Sunnygo"}, {"language": "ko", "name": "코산호"}, {"language": "zh-hant", "name": "太陽珊瑚"}, {"language": "fr", "name": "Corayon"}, {"language": "de", "name": "Corasonn"}, {"language": "es", "name": "Corsola"}, {"language": "it", "name": "Corsola"}, {"language": "ja", "name": "サニーゴ"}, {"language": "zh-hans", "name": "太阳珊瑚"}, {"language": "es-419", "name": "Corsola"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It continuously sheds and grows. The tip of its head is prized as a treasure for its beauty."}, {"versions": ["silver"], "text": "In a south sea nation, the people live in communi­ ties that are built on groups of these POKéMON."}, {"versions": ["crystal"], "text": "The points on its head absorb nutrients from clean water. They cannot survive in polluted water."}, {"versions": ["ruby"], "text": "CORSOLA’s branches glitter very beautifully in seven colors when they catch sunlight. If any branch breaks off, this POKéMON grows it back in just one night."}, {"versions": ["sapphire"], "text": "Clusters of CORSOLA congregate in warm seas where they serve as ideal hiding places for smaller POKéMON. When the water temperature falls, this POKéMON migrates to the southern seas."}, {"versions": ["emerald"], "text": "CORSOLA live in warm southern seas. If the sea becomes polluted, the beautiful coral stalks become discolored and crumble away in tatters."}, {"versions": ["firered"], "text": "In a south sea nation, the people live in communities that are built on groups of these POKéMON."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Many live in the clean seas of the south. They apparently can’t live in polluted waters."}, {"versions": ["heartgold", "x"], "text": "It continuously sheds and grows. The tip of its head is prized as a treasure because of its beauty."}, {"versions": ["soulsilver"], "text": "In a south-sea nation, the people live in communities that are built on groups of these Pokémon."}, {"versions": ["black-2", "white-2", "y"], "text": "They prefer unpolluted southern seas. Their coral branches lose their color and deteriorate in dirty water."}, {"versions": ["omega-ruby"], "text": "Corsola’s branches glitter very beautifully in seven colors when they catch sunlight. If any branch breaks off, this Pokémon grows it back in just one night."}, {"versions": ["alpha-sapphire"], "text": "Clusters of Corsola congregate in warm seas where they serve as ideal hiding places for smaller Pokémon. When the water temperature falls, this Pokémon migrates to the southern seas."}, {"versions": ["sun"], "text": "Coral branches grow from its head. They break off quite easily, but they grow back in about three days."}, {"versions": ["moon"], "text": "Pursued by Mareanie for the branches on its head, this Pokémon will sometimes snap its own branches off as a diversion while it escapes."}, {"versions": ["ultra-sun"], "text": "The pink of Corsola that live in Alola is deep and vibrant, thanks to seas filled with nutrition."}, {"versions": ["ultra-moon"], "text": "In Alola, where their natural enemies Mareanie are plentiful, many Corsola have stubby branches on their heads."}, {"versions": ["sword"], "text": "It will regrow any branches that break off its head. People keep particularly beautiful Corsola branches as charms to promote safe childbirth."}, {"versions": ["shield"], "text": "These Pokémon live in warm seas. In prehistoric times, many lived in the oceans around the Galar region as well."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/