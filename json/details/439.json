{"height": 6, "weight": 130, "base_experience": 62, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Mime Pokémon", "capture_rate": 145, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["no-eggs"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マネネ"}, {"language": "ja-roma", "name": "Manene"}, {"language": "ko", "name": "흉내내"}, {"language": "zh-hant", "name": "魔尼尼"}, {"language": "fr", "name": "Mime Jr."}, {"language": "de", "name": "Pantimimi"}, {"language": "es", "name": "Mime Jr."}, {"language": "it", "name": "Mime Jr."}, {"language": "ja", "name": "マネネ"}, {"language": "zh-hans", "name": "魔尼尼"}, {"language": "es-419", "name": "Mime Jr."}], "pokedex_entries": [{"versions": ["soulsilver", "heartgold", "x", "omega-ruby"], "text": "In an attempt to confuse its enemy, it mimics the enemy’s movements. Then it wastes no time in making itself scarce!"}, {"versions": ["diamond", "y", "alpha-sapphire"], "text": "It habitually mimics foes. Once mimicked, the foe cannot take its eyes off this Pokémon."}, {"versions": ["pearl"], "text": "It likes places where people gather. It mimics foes to confuse them, then makes its getaway."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It mimics the expressions and motions of those it sees to understand the feelings of others."}, {"versions": ["ultra-sun"], "text": "It does its absolute best to mimic the movements and expressions of its opponents, but it’s still not very good at it."}, {"versions": ["ultra-moon"], "text": "When this gifted mimic surprises an opponent, Mime Jr. feels so happy that it ends up forgetting it was imitating something."}, {"versions": ["sword"], "text": "It mimics everyone it sees, but it puts extra effort into copying the graceful dance steps of Mr. Rime as practice."}, {"versions": ["shield"], "text": "It looks for a Mr. Rime that’s a good dancer and carefully copies the Mr. Rime’s steps like an apprentice."}, {"v