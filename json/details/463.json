{"height": 17, "weight": 1400, "base_experience": 180, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Licking Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ベロベルト"}, {"language": "ja-roma", "name": "Berobelt"}, {"language": "ko", "name": "내룸벨트"}, {"language": "zh-hant", "name": "大舌舔"}, {"language": "fr", "name": "Coudlangue"}, {"language": "de", "name": "Schlurplek"}, {"language": "es", "name": "Lickilicky"}, {"language": "it", "name": "Lickilicky"}, {"language": "ja", "name": "ベロベルト"}, {"language": "zh-hans", "name": "大舌舔"}, {"language": "es-419", "name": "Lickilicky"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "x", "omega-ruby"], "text": "It wraps things with its extensible tongue. Getting too close to it will leave you soaked with drool."}, {"versions": ["platinum", "black", "white"], "text": "The long tongue is always soggy with slobber. The saliva contains a solvent that causes numbness."}, {"versions": ["heartgold"], "text": "Its saliva can decompose anything. It wraps its long tongue around things to coat them with its sticky saliva."}, {"versions": ["soulsilver"], "text": "It has space in its throat to store saliva. It can also roll up its tongue and store it in the same spot."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "Their saliva contains lots of components that can dissolve anything. The numbness caused by their lick does not dissipate."}, {"versions": ["ultra-sun"], "text": "A contest is under way to determine which one can stick its tongue out the farthest. The current record is...more than 82 feet."}, {"versions": ["ultra-moon"], "text": "It uses its tongue much more skillfully than its hands or its feet. It can deftly pick up a single small bean with its tongue."}, {"versions": ["sword"], "text": "Lickilicky’s strange tongue can stretch to many times the length of its body. No one has figured out how Lickilicky’s tongue can stretch so far."}, {"versions": ["shield"], "text": "Lickilicky can do just about anything with its tongue, which is as dexterous as the human hand. In contrast, Lickilicky’s use of its fingers is clumsy."}, {"versions": ["legends-arceus"], "text": "Its tongue can extend and contract freely, and it is capable of reaching lengths over 10 times Lickilicky's height. Beware of the saliva, as it contains corrosive elements."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/463.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/463.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/463.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/463.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/463.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/463.png"}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/463.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/463.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/463.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/s