{"height": 15, "weight": 150, "base_experience": 165, "ev_yield": [{"stat": "special-attack", "value": 1}, {"stat": "speed", "value": 1}], "genus": "Mystic Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ネイティオ"}, {"language": "ja-roma", "name": "Natio"}, {"language": "ko", "name": "네이티오"}, {"language": "zh-hant", "name": "天然鳥"}, {"language": "fr", "name": "Xatu"}, {"language": "de", "name": "Xatu"}, {"language": "es", "name": "Xatu"}, {"language": "it", "name": "Xatu"}, {"language": "ja", "name": "ネイティオ"}, {"language": "zh-hans", "name": "天然鸟"}, {"language": "es-419", "name": "Xatu"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y", "sword"], "text": "They say that it stays still and quiet because it is seeing both the past and future at the same time."}, {"versions": ["silver", "firered", "soulsilver"], "text": "In South America, it is said that its right eye sees the future and its left eye views the past."}, {"versions": ["crystal"], "text": "Once it begins to meditate at sun­ rise, the entire day will pass before it will move again."}, {"versions": ["ruby"], "text": "XATU stands rooted and still in one spot all day long. People believe that this POKéMON does so out of fear of the terrible things it has foreseen in the future."}, {"versions": ["sapphire"], "text": "XATU is known to stand motionless while staring at the sun all day long. Some people revere it as a mystical POKéMON out of their belief that XATU is in possession of the power to see into the future."}, {"versions": ["emerald"], "text": "It has the enigmatic power of foreseeing the future. Some people in different lands have long believed that XATU are emissaries from another world."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "shield"], "text": "This odd Pokémon can see both the past and the future. It eyes the sun’s movement all day."}, {"versions": ["x"], "text": "Once it begins to meditate at sunrise, the entire day will pass before it will move again."}, {"versions": ["omega-ruby"], "text": "Xatu stands rooted and still in one spot all day long. People believe that this Pokémon does so out of fear of the terrible things it has foreseen in the future."}, {"versions": ["alpha-sapphire"], "text": "Xatu is known to stand motionless while staring at the sun all day long. Some people revere it as a mystical Pokémon out of their belief that Xatu is in possession of the power to see into the future."}, {"versions": ["ultra-sun"], "text": "It’s said that while this Pokémon has the power to predict the future, it’s not powerful enough to change the future it sees."}, {"versions": ["ultra-moon"], "text": "While it can see the future, it has no desire to change it, which is probably why it remains motionless at all times."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/178.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/178.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/178.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/178.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/178.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/178.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/178.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites