{"height": 8, "weight": 36, "base_experience": 159, "ev_yield": [{"stat": "special-attack", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Eyeball Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["water1", "bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アメモース"}, {"language": "ja-roma", "name": "Amemoth"}, {"language": "ko", "name": "비나방"}, {"language": "zh-hant", "name": "雨翅蛾"}, {"language": "fr", "name": "Maskadra"}, {"language": "de", "name": "Maskeregen"}, {"language": "es", "name": "Masquerain"}, {"language": "it", "name": "Masquerain"}, {"language": "ja", "name": "アメモース"}, {"language": "zh-hans", "name": "雨翅蛾"}, {"language": "es-419", "name": "Masquerain"}], "pokedex_entries": [{"versions": ["ruby"], "text": "MASQUERAIN intimidates enemies with the eyelike patterns on its antennas. This POKéMON flaps its four wings to freely fly in any direction - even sideways and backwards - as if it were a helicopter."}, {"versions": ["sapphire"], "text": "MASQUERAIN’s antennas have eyelike patterns that usually give it an angry look. If the “eyes” are droopy and appear sad, it is said to be a sign that a heavy rainfall is on its way."}, {"versions": ["emerald"], "text": "It intimidates foes with the large eyelike patterns on its antennae. Because it can’t fly if its wings get wet, it shelters itself from rain under large trees and eaves."}, {"versions": ["firered", "leafgreen"], "text": "The antennae have distinctive patterns that look like eyes. When it rains, they grow heavy, making flight impossible."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Its antennae have eye patterns on them. Its four wings enable it to hover and fly in any direction."}, {"versions": ["heartgold", "soulsilver"], "text": "It flaps its four wings to hover and fly freely in any direction-- to and fro and sideways."}, {"versions": ["y"], "text": "It flaps its four wings to hover and fly freely in any direction--to and fro and sideways."}, {"versions": ["omega-ruby"], "text": "Masquerain intimidates enemies with the eyelike patterns on its antennas. This Pokémon flaps its four wings to freely fly in any direction—even sideways and backwards—as if it were a helicopter."}, {"versions": ["alpha-sapphire"], "text": "Masquerain’s antennas have eyelike patterns that usually give it an angry look. If the “eyes” are droopy and appear sad, it is said to be a sign that a heavy rainfall is on its way."}, {"versions": ["sun"], "text": "It intimidates enemies with the eye-like patterns on its antennae. Its four wings allow it to fly in any direction."}, {"versions": ["moon"], "text": "Its wings and antennae don’t cope well with moisture. After a rain, it faces sunward to dry off."}, {"versions": ["ultra-sun"], "text": "Masquerain intimidates enemies with the eyelike patterns of its eyespots. If that doesn’t work, it deftly makes its escape on its set of four wings."}, {"versions": ["ultra-moon"], "text": "Its thin, winglike antennae are highly absorbent. It waits out rainy days in tree hollows."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/284.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/284.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/284.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/284.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/284.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sp