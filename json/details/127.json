{"height": 15, "weight": 550, "base_experience": 175, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Stag Beetle Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カイロス"}, {"language": "ja-roma", "name": "Kailios"}, {"language": "ko", "name": "쁘사이저"}, {"language": "zh-hant", "name": "凱羅斯"}, {"language": "fr", "name": "Scarabrute"}, {"language": "de", "name": "Pinsir"}, {"language": "es", "name": "Pinsir"}, {"language": "it", "name": "Pinsir"}, {"language": "ja", "name": "カイロス"}, {"language": "zh-hans", "name": "凯罗斯"}, {"language": "es-419", "name": "Pinsir"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "If it fails to crush the victim in its pincers, it will swing it around and toss it hard."}, {"versions": ["yellow"], "text": "Grips its prey in its pincers and squeezes hard! It can't move if it's cold, so it lives in warm places."}, {"versions": ["gold"], "text": "With its horns, it digs burrows to sleep in at night. In the morning, damp soil clings to its body."}, {"versions": ["silver"], "text": "Swings its long antlers wildly to attack. During cold periods, it hides deep in forests."}, {"versions": ["crystal"], "text": "When the tempera­ ture drops at night, it sleeps on treetops or among roots where it is well hidden."}, {"versions": ["ruby"], "text": "PINSIR is astoundingly strong. It can grip a foe weighing twice its weight in its horns and easily lift it. This POKéMON’s movements turn sluggish in cold places."}, {"versions": ["sapphire"], "text": "PINSIR has a pair of massive horns Protruding from the surface of these horns are thorns. These thorns are driven deeply into the foe’s body when the pincer closes, making it tough for the foe to escape."}, {"versions": ["emerald"], "text": "Their pincers are strong enough to shatter thick logs. Because they dislike cold, PINSIR burrow and sleep under the ground on chilly nights."}, {"versions": ["firered"], "text": "Its two long pincer horns are powerful. Once they grip an enemy, they won’t release until the foe is torn."}, {"versions": ["leafgreen"], "text": "If it fails to crush the foe in its pincers, it will swing around and toss the opponent."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "It grips prey with its pincers until the prey is torn in half. What it can’t tear, it tosses far."}, {"versions": ["heartgold"], "text": "With its pincer horns, it digs burrows to sleep in at night. In the morning, damp soil clings to its body."}, {"versions": ["soulsilver", "y"], "text": "It swings its long pincer horns wildly to attack. During cold periods, it hides deep in forests."}, {"versions": ["black-2", "white-2"], "text": "It grips prey with its powerful pincers and will not let go until the prey is torn in half."}, {"versions": ["omega-ruby"], "text": "Pinsir is astoundingly strong. It can grip a foe weighing twice its weight in its horns and easily lift it. This Pokémon’s movements turn sluggish in cold places."}, {"versions": ["alpha-sapphire"], "text": "Pinsir has a pair of massive horns. Protruding from the surface of these horns are thorns. These thorns are driven deeply into the foe’s body when the pincer closes, making it tough for the foe to escape."}, {"versions": ["sun"], "text": "It grips its prey in its pincers and splits them apart. Although it is a powerful Pokémon, it can’t deal with the cold."}, {"versions": ["moon"], "text": "One solid blow from its horns is enough to split apart a large tree. Its greatest rival in Alola is Vikavolt."}, {"versions": ["ultra-sun"], "text": "It gets into territorial disputes with Vikavolt. For some reason, it apparently gets along well with Heracross in Alola."}, {"versions": ["ultra-moon"], "text": "Although it’s tough, it can’t handle cold well. When night falls, it buries itself in leafage and sleeps."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Grips its prey in its pincers and squeezes hard! It can’t move if it’s cold out, so it lives in warm places."}, {"versions": ["sword"], "text": "These Pokémon judge one another based on pincers. Thicker, more impressive pincers make for more popularity with the opposite gender."}, {"versions": ["shield"], "text": "This Pokémon clamps its pincers down on its prey and then either splits the prey in half or flings it away."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/127.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/127.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/127.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/127.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/127.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/127.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/127.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/127.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/127.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/127.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/