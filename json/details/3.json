{"height": 20, "weight": 1000, "base_experience": 236, "ev_yield": [{"stat": "special-attack", "value": 2}, {"stat": "special-defense", "value": 1}], "genus": "Seed Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "plant"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "フシギバナ"}, {"language": "ja-roma", "name": "Fushigibana"}, {"language": "ko", "name": "이상해꽃"}, {"language": "zh-hant", "name": "妙蛙花"}, {"language": "fr", "name": "Florizarre"}, {"language": "de", "name": "Bisaflor"}, {"language": "es", "name": "Venusaur"}, {"language": "it", "name": "Venusaur"}, {"language": "ja", "name": "フシギバナ"}, {"language": "zh-hans", "name": "妙蛙花"}, {"language": "es-419", "name": "Venusaur"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The plant blooms when it is absorbing solar energy. It stays on the move to seek sunlight."}, {"versions": ["yellow"], "text": "The flower on its back catches the sun's rays. The sunlight is then absorbed and used for energy."}, {"versions": ["gold"], "text": "By spreading the broad petals of its flower and catching the sun's rays, it fills its body with power."}, {"versions": ["silver"], "text": "It is able to con­ vert sunlight into energy. As a result, it is more powerful in the summertime."}, {"versions": ["crystal"], "text": "As it warms it­ self and absorbs the sunlight, its flower petals release a pleasant fragrance."}, {"versions": ["ruby", "sapphire"], "text": "There is a large flower on VENUSAUR’s back. The flower is said to take on vivid colors if it gets plenty of nutrition and sunlight. The flower’s aroma soothes the emotions of people."}, {"versions": ["emerald"], "text": "VENUSAUR’s flower is said to take on vivid colors if it gets plenty of nutrition and sunlight. The flower’s aroma soothes the emotions of people."}, {"versions": ["firered", "shield"], "text": "A bewitching aroma wafts from its flower. The fragrance becalms t