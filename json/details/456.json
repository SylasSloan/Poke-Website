{"height": 4, "weight": 70, "base_experience": 66, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Wing Fish Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ケイコウオ"}, {"language": "ja-roma", "name": "Keikouo"}, {"language": "ko", "name": "형광어"}, {"language": "zh-hant", "name": "螢光魚"}, {"language": "fr", "name": "Écayon"}, {"language": "de", "name": "Finneon"}, {"language": "es", "name": "Finneon"}, {"language": "it", "name": "Finneon"}, {"language": "ja", "name": "ケイコウオ"}, {"language": "zh-hans", "name": "荧光鱼"}, {"language": "es-419", "name": "Finneon"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "After long exposure to sunlight, the patterns on its tail fins shine vividly when darkness arrives."}, {"versions": ["pearl"], "text": "The way its two tail fins flutter while it swims has earned it the nickname “BEAUTIFLY of the Sea.”"}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x", "omega-ruby"], "text": "The line running down its side can store sunlight. It shines vividly at night."}, {"versions": ["heartgold", "soulsilver"], "text": "Swimming and fluttering its two tail fins, it looks like a BEAUTIFLY. At night, the patterns on its tail fins softly shine."}, {"versions": ["sun"], "text": "It absorbs sunlight with the pink areas of its skin, which then shine. This appears to be a form of camouflage."}, {"versions": ["moon"], "text": "Its double tail fins propel its energetic jumps. When it breaks the surface of the sea, Wingull swoop down to grab it on the fly."}, {"versions": ["ultra-sun"], "text": "When night falls, their pink patterns begin to shine. They’re popular with divers, so there are resorts that feed them to keep them close."}, {"versions": ["ultra-moon"], "text": "It lures in prey with its shining tail fins. It stays near the surface during the day and moves to the depths when night falls."}, {"versions": ["legends-arceus"], "text": "What a gorgeous sight this Pokémon is as it swims with its long, pink-painted caudal fins fluttering behind it. Finneon's beautiful appearance has led to its nickname: ”finery fish.”"}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/456.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/456.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/456.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/456.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/456.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/456.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/456.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/456.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/456.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/456.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/456.png"}, "x-