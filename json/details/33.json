{"height": 9, "weight": 195, "base_experience": 128, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Poison Pin Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "ニドリーノ"}, {"language": "ja-roma", "name": "Nidorino"}, {"language": "ko", "name": "니드리노"}, {"language": "zh-hant", "name": "尼多力諾"}, {"language": "fr", "name": "Nidorino"}, {"language": "de", "name": "Nidorino"}, {"language": "es", "name": "Nidorino"}, {"language": "it", "name": "Nidorino"}, {"language": "ja", "name": "ニドリーノ"}, {"language": "zh-hans", "name": "尼多力诺"}, {"language": "es-419", "name": "Nidorino"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "An aggressive POKéMON that is quick to attack. The horn on its head secretes a powerful venom."}, {"versions": ["yellow"], "text": "Its horns contain venom. If they are stabbed into an enemy, the impact makes the poison leak out."}, {"versions": ["gold"], "text": "It raises its big ears to check its surroundings. If it senses any­ thing, it attacks immediately."}, {"versions": ["silver", "soulsilver"], "text": "Quick to anger, it stabs enemies with its horn to inject a powerful poison when it becomes agitated."}, {"versions": ["crystal"], "text": "It is easily agitated and uses its horn for offense as soon as it notices an attacker."}, {"versions": ["ruby", "sapphire"], "text": "NIDORINO has a horn that is harder than a diamond. If it senses a hostile presence, all the barbs on its back bristle up at once, and it challenges the foe with all its might."}, {"versions": ["emerald"], "text": "Its horn is harder than a diamond. If it senses a hostile presence, all the barbs on its back bristle up at once, and it challenges the foe with all its might."}, {"versions": ["firered"], "text": "It is easily angered. By swinging its well- developed horn wildly, it can even punch through diamond."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It has a violent disposition and stabs foes with its horn, which oozes poison upon impact."}, {"versions": ["heartgold", "x"], "text": "It raises its big ears to check its surroundings. If it senses anything, it attacks immediately."}, {"versions": ["y"], "text": "An aggressive Pokémon that is quick to attack. The horn on its head secretes a powerful venom."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Nidorino has a horn that is harder than a diamond. If it senses a hostile presence, all the barbs on its back bristle up at once, and it challenges the foe with all its might."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its horn contains venom. If it stabs an enemy with the horn, the impact makes the poison leak out."}, {"versions": ["sword"], "text": "With a horn that’s harder than diamond, this Pokémon goes around shattering boulders as it searches for a moon stone."}, {"versions": ["shield"], "text": "It’s nervous and quick to act aggressively. The potency of its poison increases along with the level of adrenaline present in its body."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/33.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/33.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/33.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/33.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/33.png", "shiny": "https://raw.githubusercontent.com/PokeAP