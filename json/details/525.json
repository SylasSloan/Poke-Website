{"height": 9, "weight": 1020, "base_experience": 137, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Ore Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ガントル"}, {"language": "ja-roma", "name": "Gantle"}, {"language": "ko", "name": "암트르"}, {"language": "zh-hant", "name": "地幔岩"}, {"language": "fr", "name": "Géolithe"}, {"language": "de", "name": "Sedimantur"}, {"language": "es", "name": "Boldore"}, {"language": "it", "name": "Boldore"}, {"language": "ja", "name": "ガントル"}, {"language": "zh-hans", "name": "地幔岩"}, {"language": "es-419", "name": "Boldore"}], "pokedex_entries": [{"versions": ["black"], "text": "When it overflows with power, the orange crystal on its body glows. It looks for underground water in caves."}, {"versions": ["white", "x", "omega-ruby"], "text": "Because its energy was too great to be contained, the energy leaked and formed orange crystals."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "When it is healthy, its core sticks out. Always facing the same way, it swiftly moves front to back and left to right."}, {"versions": ["sun"], "text": "Its orange crystal is a mass of energy. Just one crystal fragment would provide enough fuel for a hundred dump trucks."}, {"versions": ["moon"], "text": "It explores caves in search of underground water. It’s not comfortable around water, so this Pokémon takes great care in lapping it up."}, {"versions": ["ultra-sun"], "text": "The energy overflowing from its body has turned into orange crystals that are hard enough to smash diamonds."}, {"versions": ["ultra-moon"], "text": "Its orange crystals are lumps of powerful energy. They’re valuable, so Boldore is sometimes targeted for them."}, {"versions": ["sword"], "text": "If you see its orange crystals start to glow, be wary. It’s about to fire off bursts of energy."}, {"versions": ["shield"], "text": "It relies on sound in order to monitor what’s in its vicinity. When angered, it will attack without ever changing the direction it’s facing."}], "sprites_by_gen": {"generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/525.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/525.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/525.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/525.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/525.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/525.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/525.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/525.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/525.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/525.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation V", "level_up": [{"level": 1, "label": "Level 1", "name": "Sand Attack"}, {"level": 1, "label": "Level 1", "name": "Headbutt"}, {"level": 1, "label": "Level 1", "name": "Tackle"}, {"level": 1, "label": "Level