{"height": 62, "weight": 1620, "base_experience": 189, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Tender Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ミロカロス"}, {"language": "ja-roma", "name": "Milokaross"}, {"language": "ko", "name": "밀로틱"}, {"language": "zh-hant", "name": "美納斯"}, {"language": "fr", "name": "Milobellus"}, {"language": "de", "name": "Milotic"}, {"language": "es", "name": "Milotic"}, {"language": "it", "name": "Milotic"}, {"language": "ja", "name": "ミロカロス"}, {"language": "zh-hans", "name": "美纳斯"}, {"language": "es-419", "name": "Milotic"}], "pokedex_entries": [{"versions": ["firered", "leafgreen"], "text": "MILOTIC is breathtakingly beautiful. Those that see it are said to forget their combative spirits."}, {"versions": ["ruby"], "text": "MILOTIC is said to be the most beautiful of all the POKéMON. It has the power to becalm such emotions as anger and hostility to quell bitter feuding."}, {"versions": ["sapphire"], "text": "MILOTIC live at the bottom of large lakes. When this POKéMON’s body glows a vivid pink, it releases a pulsing wave of energy that brings soothing calm to restless spirits."}, {"versions": ["emerald"], "text": "It is said to live at the bottom of large lakes. Considered to be the most beautiful of all POKéMON, it has been depicted in paintings and statues."}, {"versions": ["diamond"], "text": "When people bicker, it is said to arise from the depths of lakes to becalm violent hearts."}, {"versions": ["pearl"], "text": "It is the world’s most beautiful Pokémon. There are many works of art featuring MILOTIC."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Its lovely scales are described as rainbow colored. They change color depending on the viewing angle."}, {"versions": ["heartgold", "soulsilver"], "text": "It’s said that a glimpse of a MILOTIC and its beauty will calm any hostile emotions you’re feeling."}, {"versions": ["x"], "text": "Milotic is breathtakingly beautiful. Those that see it are said to forget their combative spirits."}, {"versions": ["y"], "text": "It is the world’s most beautiful Pokémon. There are many works of art featuring Milotic."}, {"versions": ["omega-ruby"], "text": "Milotic is said to be the most beautiful of all the Pokémon. It has the power to becalm such emotions as anger and hostility to quell bitter feuding."}, {"versions": ["alpha-sapphire"], "text": "Milotic live at the bottom of large lakes. When this Pokémon’s body glows a vivid pink, it releases a pulsing wave of energy that brings soothing calm to troubled hearts."}, {"versions": ["sun", "sword"], "text": "Milotic has provided inspiration to many artists. It has even been referred to as the most beautiful Pokémon of all."}, {"versions": ["moon"], "text": "It lives at the bottom of clear lakes. In times of war, it shows itself, which soothes people’s minds and hearts."}, {"versions": ["ultra-sun"], "text": "While Milotic is said to be the most beautiful Pokémon, Trainers who like Feebas and have raised it are seemingly disappointed by Milotic."}, {"versions": ["ultra-moon"], "text": "Its dwelling place is the bottom of big lakes. Those who behold its loveliness are said to have their hearts purified."}, {"versions": ["shield"], "text": "It’s said that a glimpse of a Milotic and its beauty will calm any hostile emotions you’re feeling."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/350.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/350.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/350.png", "shiny": "