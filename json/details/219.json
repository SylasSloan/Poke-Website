{"height": 8, "weight": 550, "base_experience": 151, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Lava Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マグカルゴ"}, {"language": "ja-roma", "name": "Magcargot"}, {"language": "ko", "name": "마그카르고"}, {"language": "zh-hant", "name": "熔岩蝸牛"}, {"language": "fr", "name": "Volcaropod"}, {"language": "de", "name": "Magcargo"}, {"language": "es", "name": "Magcargo"}, {"language": "it", "name": "Magcargo"}, {"language": "ja", "name": "マグカルゴ"}, {"language": "zh-hans", "name": "熔岩蜗牛"}, {"language": "es-419", "name": "Magcargo"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold"], "text": "The shell on its back is just skin that has cooled and hardened. It breaks easily with a slight touch."}, {"versions": ["silver"], "text": "Its brittle shell occasionally spouts intense flames that cir­ culate throughout its body."}, {"versions": ["crystal", "y"], "text": "Its body is as hot as lava and is always billowing. Flames will occasionally burst from its shell."}, {"versions": ["ruby"], "text": "MAGCARGO’s shell is actually its skin that hardened as a result of cooling. Its shell is very brittle and fragile - just touching it causes it to crumble apart. This POKéMON returns to its original size by dipping itself in magma."}, {"versions": ["sapphire"], "text": "MAGCARGO’s body temperature is approximately 18,000 degrees F. Water is vaporized on contact. If this POKéMON is caught in the rain, the raindrops instantly turn into steam, cloaking the area in a thick fog."}, {"versions": ["emerald"], "text": "The shell on its back is made of hardened magma. Tens of thousands of years spent living in volcanic craters have turned MAGCARGO’s bodies into magma."}, {"versions": ["firered", "soulsilver", "x"], "text": "Its brittle shell occasionally spouts intense flames that circulate throughout its body."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Its body temperature is roughly 18,000 degrees F. Flames spout from gaps in its hardened shell."}, {"versions": ["omega-ruby"], "text": "Magcargo’s shell is actually its skin that hardened as a result of cooling. Its shell is very brittle and fragile—just touching it causes it to crumble apart. This Pokémon returns to its original size by dipping itself in magma."}, {"versions": ["alpha-sapphire"], "text": "Magcargo’s body temperature is approximately 18,000 degrees Fahrenheit. Water is vaporized on contact. If this Pokémon is caught in the rain, the raindrops instantly turn into steam, cloaking the area in a thick fog."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/219.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/219.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/219.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/219.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/219.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/219.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/219.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/219.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/