{"height": 8, "weight": 150, "base_experience": 59, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Requiem Pokémon", "capture_rate": 190, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヨマワル"}, {"language": "ja-roma", "name": "Yomawaru"}, {"language": "ko", "name": "해골몽"}, {"language": "zh-hant", "name": "夜巡靈"}, {"language": "fr", "name": "Skelénox"}, {"language": "de", "name": "Zwirrlicht"}, {"language": "es", "name": "Duskull"}, {"language": "it", "name": "Duskull"}, {"language": "ja", "name": "ヨマワル"}, {"language": "zh-hans", "name": "夜巡灵"}, {"language": "es-419", "name": "Duskull"}], "pokedex_entries": [{"versions": ["ruby"], "text": "DUSKULL can pass through any wall no matter how thick it may be. Once this POKéMON chooses a target, it will doggedly pursue the intended victim until the break of dawn."}, {"versions": ["sapphire"], "text": "DUSKULL wanders lost among the deep darkness of midnight. There is an oft- told admonishment given to misbehaving children that this POKéMON will spirit away bad children who earn scoldings from their mothers."}, {"versions": ["emerald"], "text": "A glare from its single scarlet eye makes even burly grown-ups freeze in utter fear. It is a nocturnal POKéMON that roams about under the cloak of darkness."}, {"versions": ["firered", "leafgreen", "shield"], "text": "Making itself invisible, it silently sneaks up to prey. It has the ability to slip through thick walls."}, {"versions": ["diamond", "pearl", "x"], "text": "It doggedly pursues its prey wherever it goes. However, the chase is abandoned at sunrise."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It loves the crying of children. It startles bad kids by passing through walls and making them cry."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "If it finds bad children who won’t listen to their parents, it w