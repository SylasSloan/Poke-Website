{"height": 3, "weight": 3, "base_experience": 261, "ev_yield": [{"stat": "attack", "value": 2}, {"stat": "special-attack", "value": 1}], "genus": "Willpower Pokémon", "capture_rate": 3, "base_happiness": 140, "hatch_counter": 80, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "アグノム"}, {"language": "ja-roma", "name": "Agnome"}, {"language": "ko", "name": "아그놈"}, {"language": "zh-hant", "name": "亞克諾姆"}, {"language": "fr", "name": "Créfadet"}, {"language": "de", "name": "Tobutz"}, {"language": "es", "name": "Azelf"}, {"language": "it", "name": "Azelf"}, {"language": "ja", "name": "アグノム"}, {"language": "zh-hans", "name": "亚克诺姆"}, {"language": "es-419", "name": "Azelf"}], "pokedex_entries": [{"versions": ["y", "alpha-sapphire"], "text": "It is thought that Uxie, Mesprit, and Azelf all came from the same egg."}, {"versions": ["diamond", "x", "omega-ruby"], "text": "Known as “The Being of Willpower.” It sleeps at the bottom of a lake to keep the world in balance."}, {"versions": ["pearl"], "text": "It is thought that UXIE, MESPRIT and AZELF all came from the same egg."}, {"versions": ["platinum"], "text": "When AZELF flew, people gained the determination to do things. It was the birth of willpower."}, {"versions": ["heartgold", "soulsilver"], "text": "This Pokémon is said to have endowed humans with the determination needed to face any of life’s difficulties."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "When Azelf flew, people gained the determination to do things. It was the birth of willpower."}, {"versions": ["legends-arceus"], "text": "The dreaded Being of Willpower. Legends tell of this Pokémon manipulating the will of its adversaries and turning them into puppets of its own."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/482.png", "shiny": "https://raw