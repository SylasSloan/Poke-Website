{"height": 17, "weight": 766, "base_experience": 175, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Duck Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴルダック"}, {"language": "ja-roma", "name": "Golduck"}, {"language": "ko", "name": "골덕"}, {"language": "zh-hant", "name": "哥達鴨"}, {"language": "fr", "name": "Akwakwak"}, {"language": "de", "name": "Entoron"}, {"language": "es", "name": "Golduck"}, {"language": "it", "name": "Golduck"}, {"language": "ja", "name": "ゴルダック"}, {"language": "zh-hans", "name": "哥达鸭"}, {"language": "es-419", "name": "Golduck"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Often seen swim­ ming elegantly by lake shores. It is often mistaken for the Japanese monster, Kappa."}, {"versions": ["yellow"], "text": "Its slim and long limbs end in broad flippers. They are used for swim­ ming gracefully in lakes."}, {"versions": ["gold"], "text": "When it swims at full speed using its long, webbed limbs, its fore­ head somehow be­ gins to glow."}, {"versions": ["silver"], "text": "It appears by waterways at dusk. It may use tele­ kinetic powers if its forehead glows mysteriously."}, {"versions": ["crystal"], "text": "It swims grace­ fully along on the quiet, slow-moving rivers and lakes of which it is so fond."}, {"versions": ["ruby"], "text": "The webbed flippers on its forelegs and hind legs and the streamlined body of GOLDUCK give it frightening speed. This POKéMON is definitely much faster than even the most athletic swimmer."}, {"versions": ["sapphire"], "text": "GOLDUCK is the fastest swimmer among all POKéMON. It swims effortlessly, even in a rough, stormy sea. It sometimes rescues people from wrecked ships floundering in high seas."}, {"versions": ["emerald"], "text": "A GOLDUCK is an adept swimmer. It sometimes joins competitive swimmers in training. It uses psychic powers when its forehead shimmers with light."}, {"versions": ["firered", "y"], "text": "The forelegs are webbed, helping to make it an adept swimmer. It can be seen swimming elegantly in lakes, etc."}, {"versions": ["leafgreen"], "text": "Often seen swimming elegantly by lakeshores. It is often mistaken for the Japanese monster Kappa."}, {"versions": ["diamond"], "text": "A Pokémon that lives in lakes. It swims faster than any human swimming champion."}, {"versions": ["pearl"], "text": "The flippers of its well-developed limbs give it shocking speed. It is the best swimmer among Pokémon."}, {"versions": ["platinum", "black", "white"], "text": "It is seen swimming dynamically and elegantly using its well-developed limbs and flippers."}, {"versions": ["heartgold"], "text": "When it swims at full speed using its long, webbed limbs, its forehead somehow begins to glow."}, {"versions": ["soulsilver", "x"], "text": "It appears by waterways at dusk. It may use telekinetic powers if its forehead glows mysteriously."}, {"versions": ["black-2", "white-2"], "text": "When its forehead shines mysteriously, Golduck can use the full extent of its power."}, {"versions": ["omega-ruby"], "text": "The webbed flippers on its forelegs and hind legs and the streamlined body of Golduck give it frightening speed. This Pokémon is definitely much faster than even the most athletic swimmer."}, {"versions": ["alpha-sapphire"], "text": "Golduck is the fastest swimmer among all Pokémon. It swims effortlessly, even in a rough, stormy sea. It sometimes rescues people from wrecked ships floundering in high seas."}, {"versions": ["sun"], "text": "It is said that the red part of its forehead grants supernatural powers to those who possess one, so it was over-hunted in the past."}, {"versions": ["moon"], "text": "It swims along the banks of lakes and catches fish Pokémon. It takes them to the shore and quietly eats them up."}, {"versions": ["ultra-sun"], "text": "Even fast-swimming fish Pokémon can be disabled by Golduck. It brings them to a standstill and seizes them."}, {"versions": ["ultra-moon"], "text": "A professional swimmer, it can continue swimming for two days straight by waving its long tail skillfully."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its long, slim limbs end in broad flippers. They are used for swimming gracefully in lakes."}, {"versions": ["sword"], "text": "This Pokémon lives in gently flowing rivers. It paddles through the water with its long limbs, putting its graceful swimming skills on display."}, {"versions": ["shield"], "text": "Old tales tell of Golduck punishing those that defiled its river. The guilty were dragged into the water and taken away."}, {"versions": ["legends-arceus"], "text": "Its body is strong, and it has webbing on its hands and feet. Golduck can swim easily through rough seas, clawing its way through the high waves."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/55.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/55.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/55.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/55.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/55.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/55.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/55.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokem