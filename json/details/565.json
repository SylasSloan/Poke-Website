{"height": 12, "weight": 810, "base_experience": 173, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Prototurtle Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["water1", "water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "アバゴーラ"}, {"language": "ja-roma", "name": "Abagoura"}, {"language": "ko", "name": "늑골라"}, {"language": "zh-hant", "name": "肋骨海龜"}, {"language": "fr", "name": "Mégapagos"}, {"language": "de", "name": "Karippas"}, {"language": "es", "name": "Carracosta"}, {"language": "it", "name": "Carracosta"}, {"language": "ja", "name": "アバゴーラ"}, {"language": "zh-hans", "name": "肋骨海龟"}, {"language": "es-419", "name": "Carracosta"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "They can live both in the ocean and on land. A slap from one of them is enough to open a hole in the bottom of a tanker."}, {"versions": ["white"], "text": "Incredible jaw strength enables them to chew up steel beams and rocks along with their prey."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "It could knock out a foe with a slap from one of its developed front appendages and chew it up, shell or bones and all."}, {"versions": ["sun"], "text": "It constructed its sturdy shell by crunching and swallowing the hard shells or bones of its prey."}, {"versions": ["moon"], "text": "Active both on land and in the sea, this Pokémon drags its land-based prey into the water to finish it off."}, {"versions": ["ultra-sun"], "text": "Its jaws are terrifyingly powerful. It could eat Omastar and Omanyte whole and not be bothered in the slightest by their shells."}, {"versions": ["ultra-moon"], "text": "Carracosta eats every last bit of the prey it catches, even the shells and bones, to further strengthen its sturdy shell."}, {"versions": ["sword"], "text": "Carracosta completely devours its prey—bones, shells, and all. Because of this, Carracosta’s own shell grows thick and sturdy."}, {"versions": ["shield"], "text": "This Pokémon emerges from the water in search of prey despite the fact that it moves more slowly on land."}], "sprites_by_gen": {"generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/565.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/565.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/565.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/565.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/565.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/565.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/565.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/565.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/565.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/565.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation V", "level_up": [{"level": 1, "label": "Level 1", "name": "Water Gun"}, {"level": 1, "label": "Level 1", "name": "Withdraw"}, {"level": 1, "label": "Level 1", "name": "Bide"}, {"level": 1, "label": "Level 1", "name": "Rollout"}