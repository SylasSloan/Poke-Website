{"height": 7, "weight": 115, "base_experience": 72, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Cocoon Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マユルド"}, {"language": "ja-roma", "name": "Mayuld"}, {"language": "ko", "name": "카스쿤"}, {"language": "zh-hant", "name": "盾甲繭"}, {"language": "fr", "name": "Blindalys"}, {"language": "de", "name": "Panekon"}, {"language": "es", "name": "Cascoon"}, {"language": "it", "name": "Cascoon"}, {"language": "ja", "name": "マユルド"}, {"language": "zh-hans", "name": "盾甲茧"}, {"language": "es-419", "name": "Cascoon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "CASCOON makes its protective cocoon by wrapping its body entirely with a fine silk from its mouth. Once the silk goes around its body, it hardens. This POKéMON prepares for its evolution inside the cocoon."}, {"versions": ["sapphire"], "text": "If it is attacked, CASCOON remains motionless however badly it may be hurt. It does so because if it were to move, its body would be weak upon evolution. This POKéMON will also not forget the pain it endured."}, {"versions": ["emerald"], "text": "To avoid detection by its enemies, it hides motionlessly beneath large leaves and in the gaps of branches. It also attaches dead leaves to its body for camouflage."}, {"versions": ["firered", "leafgreen", "x"], "text": "Its body, which is made of soft silk, hardens over time. When cracks appear, evolution is near."}, {"versions": ["diamond"], "text": "It is hot inside its cocoon. All the cells in its body create the energy for it to evolve."}, {"versions": ["pearl"], "text": "Encased within its tough cocoon, it endures attacks. It never forgets the appearance of its foes."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y"], "text": "It never forgets any attack it endured while in the cocoon. After evolution, it seeks payback."}, {"versions": ["heartgold", "soulsilver"], "text": "It endures attacks with patience, because the more pain before evolution, the sturdier it becomes."}, {"versions": ["omega-ruby"], "text": "Cascoon makes its protective cocoon by wrapping its body entirely with a fine silk from its mouth. Once the silk goes around its body, it hardens. This Pokémon prepares for its evolution inside the cocoon."}, {"versions": ["alpha-sapphire"], "text": "If it is attacked, Cascoon remains motionless however badly it may be hurt. It does so because if it were to move, its body would be weak upon evolution. This Pokémon will also not forget the pain it endured."}, {"versions": ["legends-arceus"], "text": "The silk coating its body is thin but sufficiently strong. Cascoon's silk has a luster and texture superior to that of Silcoon's, and clothes made using Cascoon silk are regarded as top-notch."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/268.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/268.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/268.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/268.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/268.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/268.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/268.png", "shiny": "https://raw.githubusercon