{"height": 8, "weight": 395, "base_experience": 58, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Clap Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "タマザラシ"}, {"language": "ja-roma", "name": "Tamazarashi"}, {"language": "ko", "name": "대굴레오"}, {"language": "zh-hant", "name": "海豹球"}, {"language": "fr", "name": "Obalie"}, {"language": "de", "name": "Seemops"}, {"language": "es", "name": "Spheal"}, {"language": "it", "name": "Spheal"}, {"language": "ja", "name": "タマザラシ"}, {"language": "zh-hans", "name": "海豹球"}, {"language": "es-419", "name": "Spheal"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SPHEAL is much faster rolling than walking to get around. When groups of this POKéMON eat, they all clap at once to show their pleasure. Because of this, their mealtimes are noisy."}, {"versions": ["sapphire"], "text": "SPHEAL always travels by rolling around on its ball-like body. When the season for ice floes arrives, this POKéMON can be seen rolling about on ice and crossing the sea."}, {"versions": ["emerald"], "text": "It is completely covered with plushy fur. As a result, it never feels the cold even when it is rolling about on ice floes or diving in the sea."}, {"versions": ["firered", "leafgreen", "y"], "text": "Its body is covered in fluffy fur. The fur keeps it from feeling cold while it is rolling on ice."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It rolls across ice floes to reach shore because its body is poorly shaped for swimming."}, {"versions": ["heartgold", "soulsilver"], "text": "It crosses the oceans by rolling itself on drifting ice. Fluffy fur keeps it warm when the temperature is below freezing."}, {"versions": ["black-2", "white-2", "x"], "text": "They can’t swim well yet, and they move much faster by rolling. When they’re happy, they clap fins."}, {"versions": ["omega-ruby"], "text": "Spheal is much faster rolling than walking to get around. When groups of this Pokémon eat, they all clap at once to show their pleasure. Because of this, their mealtimes are noisy."}, {"versions": ["alpha-sapphire"], "text": "Spheal always travels by rolling around on its ball-like body. When the season for ice floes arrives, this Pokémon can be seen rolling about on ice and crossing the sea."}, {"versions": ["sword"], "text": "This Pokémon’s body is covered in blubber and impressively round. It’s faster for Spheal to roll around than walk."}, {"versions": ["shield"], "text": "As it drifts among the waves, Spheal probes the sea. As soon as it spots prey, it informs the Walrein in its herd."}, {"versions": ["legends-arceus"], "text": "During the season when drift ice approaches the shore, Spheal prefers living on the ice—where fewer predators lurk—rather than the land. Its fur retains heat superbly and resists harsh cold."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/363.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/363.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/363.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/363.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/363.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/363.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-