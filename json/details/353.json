{"height": 6, "weight": 23, "base_experience": 59, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Puppet Pokémon", "capture_rate": 225, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カゲボウズ"}, {"language": "ja-roma", "name": "Kagebouzu"}, {"language": "ko", "name": "어둠대신"}, {"language": "zh-hant", "name": "怨影娃娃"}, {"language": "fr", "name": "Polichombr"}, {"language": "de", "name": "Shuppet"}, {"language": "es", "name": "Shuppet"}, {"language": "it", "name": "Shuppet"}, {"language": "ja", "name": "カゲボウズ"}, {"language": "zh-hans", "name": "怨影娃娃"}, {"language": "es-419", "name": "Shuppet"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SHUPPET is attracted by feelings of jealousy and vindictiveness. If someone develops strong feelings of vengeance, this POKéMON will appear in a swarm and line up beneath the eaves of that person’s home."}, {"versions": ["sapphire"], "text": "SHUPPET grows by feeding on dark emotions, such as vengefulness and envy, in the hearts of people. It roams through cities in search of grudges that taint people."}, {"versions": ["emerald"], "text": "This POKéMON roams about deep in the night seeking such negative emotions as grudges and envy. It retreats to its nest when the sun begins to rise."}, {"versions": ["firered", "leafgreen"], "text": "It loves to feed on feelings like envy and malice. Its upright horn catches the emotions of people."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "It loves vengeful emotions and hangs in rows under the eaves of houses where vengeful people live."}, {"versions": ["heartgold", "soulsilver"], "text": "It uses its horn to feed on envy and malice, or so it’s said. It’s very active at night."}, {"versions": ["black-2", "white-2"], "text": "It feeds on the dark emotions of sadness and hatred, which make it grow steadily stronger."}, {"versions": ["x"], 