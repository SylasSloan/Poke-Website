{"height": 9, "weight": 300, "base_experience": 65, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Sludge Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ベトベター"}, {"language": "ja-roma", "name": "Betbeter"}, {"language": "ko", "name": "질퍽이"}, {"language": "zh-hant", "name": "臭泥"}, {"language": "fr", "name": "Tadmorv"}, {"language": "de", "name": "Sleima"}, {"language": "es", "name": "Grimer"}, {"language": "it", "name": "Grimer"}, {"language": "ja", "name": "ベトベター"}, {"language": "zh-hans", "name": "臭泥"}, {"language": "es-419", "name": "Grimer"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Appears in filthy areas. Thrives by sucking up polluted sludge that is pumped out of factories."}, {"versions": ["yellow"], "text": "Made of hardened sludge. It smells too putrid to touch. Even weeds won't grow in its path."}, {"versions": ["gold"], "text": "As it moves, it loses bits of its body from which new GRIMER emerge. This worsens the stench around it."}, {"versions": ["silver", "soulsilver"], "text": "Wherever GRIMER has passed, so many germs are left behind that no plants will ever grow again."}, {"versions": ["crystal"], "text": "When two of these POKéMON's bodies are combined together, new poisons are created."}, {"versions": ["ruby"], "text": "GRIMER’s sludgy and rubbery body can be forced through any opening, however small it may be. This POKéMON enters sewer pipes to drink filthy wastewater."}, {"versions": ["sapphire"], "text": "GRIMER emerged from the sludge that settled on a polluted seabed. This POKéMON loves anything filthy. It constantly leaks a horribly germ- infested fluid from all over its body."}, {"versions": ["emerald"], "text": "Born from polluted sludge in the sea, GRIMER’s favorite food is anything filthy. They feed on wastewater pumped out from factories."}, {"versions": ["firered"], "text": "Sludge exposed to X rays from the moon transformed into GRIMER. It loves feeding on filthy things."}, {"versions": ["leafgreen", "y"], "text": "Appears in filthy areas. It thrives by sucking up polluted sludge that is pumped out of factories."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It was born when sludge in a dirty stream was exposed to the moon’s X-rays. It appears among filth."}, {"versions": ["heartgold"], "text": "As it moves, it loses bits of its body, from which new GRIMER emerge. This worsens the stench around it."}, {"versions": ["black-2", "white-2"], "text": "Born from sludge, these Pokémon now gather in polluted places and increase the bacteria in their bodies."}, {"versions": ["x"], "text": "Sludge exposed to X-rays from the moon transformed into Grimer. It loves feeding on filthy things."}, {"versions": ["omega-ruby"], "text": "Grimer’s sludgy and rubbery body can be forced through any opening, however small it may be. This Pokémon enters sewer pipes to drink filthy wastewater."}, {"versions": ["alpha-sapphire"], "text": "Grimer emerged from the sludge that settled on a polluted seabed. This Pokémon loves anything filthy. It constantly leaks a horribly germ-infested fluid from all over its body."}, {"versions": ["sun"], "text": "Its main source of food is the slimy industrial waste of factories. This Pokémon’s numbers have been decreasing in recent years."}, {"versions": ["moon"], "text": "It was born from sludge transformed by exposure to X-rays from the moon. When its internal load of germs decreases, it dies."}, {"versions": ["ultra-sun"], "text": "It was born from sludge on the ocean floor. In a sterile environment, the germs within its body can’t multiply, and it dies."}, {"versions": ["ultra-moon"], "text": "The wastewater coming from factories is clean these days, so Grimer have nothing to eat. They’re said to be on the verge of extinction."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Made of congealed sludge. It smells too putrid to touch. Even weeds won’t grow in its path."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/88.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/88.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/88.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/88.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/88.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/88.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/88.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/88.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/88.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/88.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/88.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/88.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/88.png", "shiny": "https://raw.gith