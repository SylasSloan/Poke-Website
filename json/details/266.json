{"height": 6, "weight": 100, "base_experience": 72, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Cocoon Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カラサリス"}, {"language": "ja-roma", "name": "Karasalis"}, {"language": "ko", "name": "실쿤"}, {"language": "zh-hant", "name": "甲殼繭"}, {"language": "fr", "name": "Armulys"}, {"language": "de", "name": "Schaloko"}, {"language": "es", "name": "Silcoon"}, {"language": "it", "name": "Silcoon"}, {"language": "ja", "name": "カラサリス"}, {"language": "zh-hans", "name": "甲壳茧"}, {"language": "es-419", "name": "Silcoon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SILCOON tethers itself to a tree branch using silk to keep from falling. There, this POKéMON hangs quietly while it awaits evolution. It peers out of the silk cocoon through a small hole."}, {"versions": ["sapphire"], "text": "SILCOON was thought to endure hunger and not consume anything before its evolution. However, it is now thought that this POKéMON slakes its thirst by drinking rainwater that collects on its silk."}, {"versions": ["emerald"], "text": "It prepares for evolution using the energy it stored while it was a WURMPLE. It keeps watch over the surroundings with its two eyes."}, {"versions": ["firered", "leafgreen"], "text": "It conserves its energy by moving as little as possible. It awaits evolution while drinking only a little rainwater."}, {"versions": ["diamond"], "text": "It anchors itself by wrapping twigs with the silk from its body. It motionlessly awaits evolution."}, {"versions": ["pearl", "y"], "text": "It drinks dew that collects on its silk and waits for evolution. Its hard cocoon repels attacks."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x"], "text": "It wraps silk around the branches of a tree. It drinks rainwater on its silk while awaiting evolution."}, {"versions": ["heartgold", "soulsilver"], "text": "Having wrapped silk around the branches of a tree, it quiescently awaits evolution."}, {"versions": ["omega-ruby"], "text": "Silcoon tethers itself to a tree branch using silk to keep from falling. There, this Pokémon hangs quietly while it awaits evolution. It peers out of the silk cocoon through a small hole."}, {"versions": ["alpha-sapphire"], "text": "Silcoon was thought to endure hunger and not consume anything before its evolution. However, it is now thought that this Pokémon slakes its thirst by drinking rainwater that collects on its silk."}, {"versions": ["legends-arceus"], "text": "Wraps itself in thin strings of silk while it stores energy for evolution. It can't extend its limbs and its movement is slow, but its eyes keep a sharp lookout—Silcoon is always on guard."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/266.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/266.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/266.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/266.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/266.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/266.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/266.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/he