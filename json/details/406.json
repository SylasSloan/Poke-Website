{"height": 2, "weight": 12, "base_experience": 56, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Bud Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["no-eggs"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "スボミー"}, {"language": "ja-roma", "name": "Subomie"}, {"language": "ko", "name": "꼬몽울"}, {"language": "zh-hant", "name": "含羞苞"}, {"language": "fr", "name": "Rozbouton"}, {"language": "de", "name": "Knospi"}, {"language": "es", "name": "Budew"}, {"language": "it", "name": "Budew"}, {"language": "ja", "name": "スボミー"}, {"language": "zh-hans", "name": "含羞苞"}, {"language": "es-419", "name": "Budew"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "Over the winter, it closes its bud and endures the cold. In spring, the bud opens and releases pollen."}, {"versions": ["pearl"], "text": "It lives alongside clear ponds. It scatters pollen that induces harsh sneezing and runny noses."}, {"versions": ["platinum", "black", "white"], "text": "Sensitive to changing temperature, the bud is said to bloom when it feels the sun’s warm touch."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "When it feels the sun’s warm touch, it opens its bud to release pollen. It lives alongside clear pools."}, {"versions": ["black-2", "white-2"], "text": "Sensitive to changing temperatures, the bud blooms when it’s warm, releasing toxic pollen."}, {"versions": ["sword"], "text": "The pollen it releases contains poison. If this Pokémon is raised on clean water, the poison’s toxicity is increased."}, {"versions": ["shield"], "text": "This Pokémon is highly sensitive to temperature changes. When its bud starts to open, that means spring is right around the corner."}, {"versions": ["legends-arceus"], "text": "When the sun's light strengthens, the bud atop this Pokémon's head opens. This is a sign to the people that the harsh winter is over, and th