{"height": 20, "weight": 795, "base_experience": 172, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Royal Pokémon", "capture_rate": 70, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster", "water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤドキング"}, {"language": "ja-roma", "name": "Yadoking"}, {"language": "ko", "name": "야도킹"}, {"language": "zh-hant", "name": "呆呆王"}, {"language": "fr", "name": "Roigada"}, {"language": "de", "name": "Laschoking"}, {"language": "es", "name": "Slowking"}, {"language": "it", "name": "Slowking"}, {"language": "ja", "name": "ヤドキング"}, {"language": "zh-hans", "name": "呆呆王"}, {"language": "es-419", "name": "Slowking"}], "pokedex_entries": [{"versions": ["gold"], "text": "It has incredible intellect and in­ tuition. Whatever the situation, it remains calm and collected."}, {"versions": ["silver"], "text": "When its head was bitten, toxins entered SLOWPOKE's head and unlocked an extraordinary power."}, {"versions": ["crystal"], "text": "Every time it ya­ wns, SHELLDER injects more poi­ son into it. The poison makes it more intelligent."}, {"versions": ["ruby", "sapphire"], "text": "SLOWKING undertakes research every day in an effort to solve the mysteries of the world. However, this POKéMON apparently forgets everything it has learned if the SHELLDER on its head comes off."}, {"versions": ["emerald"], "text": "It undertakes research every day to solve the mysteries of the world. However, it apparently forgets everything if the SHELLDER on its head comes off."}, {"versions": ["firered", "soulsilver"], "text": "When its head was bitten, toxins entered SLOWPOKE’s head and unlocked an extraordinary power."}, {"versions": ["leafgreen", "heartgold", "x"], "text": "It has incredible intellect and intuition. Whatever the situation, it remains calm and collected."}, {"versions": ["diamond", "pearl", "platinum"], "text": "Being bitten by SHELLDER gave it intelligence comparable to that of award-winning scientists."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "Being bitten by Shellder gave it intelligence comparable to that of award-winning scientists."}, {"versions": ["y"], "text": "When its head was bitten, toxins entered Slowpoke’s head and unlocked an extraordinary power."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Slowking undertakes research every day in an effort to solve the mysteries of the world. However, this Pokémon apparently forgets everything it has learned if the Shellder on its head comes off."}, {"versions": ["sun"], "text": "A poisonous bite reacted with its system, blessing it with the enhanced intellect of a genius. It has full control of its psychic powers."}, {"versions": ["moon"], "text": "This Pokémon is so famed for its intellect that a proverb still persists in some regions: “When in doubt, ask Slowking.”"}, {"versions": ["ultra-sun"], "text": "It’s constantly coming up with new ideas that would change the world, but as soon as it hits upon a new idea, it forgets it."}, {"versions": ["ultra-moon"], "text": "It’s called “the sage of the sea.” It engages in battles of wits with Oranguru, but the result is usually a draw."}, {"versions": ["sword"], "text": "Miraculously, this former Slowpoke’s latent intelligence was drawn out when Shellder poison raced through its brain."}, {"versions": ["shield"], "text": "Slowking can solve any problem presented to it, but no one can understand a thing Slowking says."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/199.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/199.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/199.png", "shiny": "https://raw.githubusercontent.com