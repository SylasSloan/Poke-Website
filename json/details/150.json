{"height": 20, "weight": 1220, "base_experience": 306, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Genetic Pokémon", "capture_rate": 3, "base_happiness": 0, "hatch_counter": 120, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ミュウツー"}, {"language": "ja-roma", "name": "Mewtwo"}, {"language": "ko", "name": "뮤츠"}, {"language": "zh-hant", "name": "超夢"}, {"language": "fr", "name": "Mewtwo"}, {"language": "de", "name": "Mewtu"}, {"language": "es", "name": "Mewtwo"}, {"language": "it", "name": "Mewtwo"}, {"language": "ja", "name": "ミュウツー"}, {"language": "zh-hans", "name": "超梦"}, {"language": "es-419", "name": "Mewtwo"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "It was created by a scientist after years of horrific gene splicing and DNA engineering experiments."}, {"versions": ["yellow"], "text": "Its DNA is almost the same as MEW's. However, its size and disposition are vastly dif­ ferent."}, {"versions": ["gold"], "text": "Because its battle abilities were raised to the ultimate level, it thinks only of de­ feating its foes."}, {"versions": ["silver"], "text": "It usually remains motionless to con­ serve energy, so that it may un­ leash its full power in battle."}, {"versions": ["crystal"], "text": "Said to rest qui­ etly in an undiscovered cave, this POKéMON was created solely for battling."}, {"versions": ["ruby", "sapphire"], "text": "MEWTWO is a POKéMON that was created by genetic manipulation. However, even though the scientific power of humans created this POKéMON’s body, they failed to endow MEWTWO with a compassionate heart."}, {"versions": ["emerald"], "text": "A POKéMON that was created by genetic manipulation. However, even though the scientific power of humans made its body, they failed to give it a warm heart."}, {"versions": ["firered"], "text": "A POKéMON whose genetic code was repeatedly recombined for research. It turned vicious as a result."}, {"versions": ["leafgreen"], "text": "It was created by a scientist after years of horrific gene-splicing and DNA- engineering experiments."}, {"versions": ["diamond", "pearl", "platinum"], "text": "A Pokémon created by recombining MEW’s genes. It’s said to have the most savage heart among Pokémon."}, {"versions": ["heartgold"], "text": "Because its battle abilities were raised to the ultimate level, it thinks only of defeating its foes."}, {"versions": ["soulsilver"], "text": "It usually remains motionless to conserve energy, so that it may unleash its full power in battle."}, {"versions": ["black", "white", "black-2", "white-2", "y"], "text": "A Pokémon created by recombining Mew’s genes. It’s said to have the most savage heart among Pokémon."}, {"versions": ["x"], "text": "It was created by a scientist after years of horrific gene-splicing and DNA-engineering experiments."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Mewtwo is a Pokémon that was created by genetic manipulation. However, even though the scientific power of humans created this Pokémon’s body, they failed to endow Mewtwo with a compassionate heart."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its DNA is almost the same as Mew’s. However, its size and disposition are vastly different."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/150.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/150.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/150.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/150.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/s