{"height": 6, "weight": 72, "base_experience": 58, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Bagworm Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "クヌギダマ"}, {"language": "ja-roma", "name": "Kunugidama"}, {"language": "ko", "name": "피콘"}, {"language": "zh-hant", "name": "榛果球"}, {"language": "fr", "name": "Pomdepik"}, {"language": "de", "name": "Tannza"}, {"language": "es", "name": "Pineco"}, {"language": "it", "name": "Pineco"}, {"language": "ja", "name": "クヌギダマ"}, {"language": "zh-hans", "name": "榛果球"}, {"language": "es-419", "name": "Pineco"}], "pokedex_entries": [{"versions": ["gold"], "text": "It likes to make its shell thicker by adding layers of tree bark. The additional weight doesn't bother it."}, {"versions": ["silver", "soulsilver"], "text": "It hangs and waits for flying insect prey to come near. It does not move about much on its own."}, {"versions": ["crystal"], "text": "It spits out a fluid that it uses to glue tree bark to its body. The fluid hardens when it touches air."}, {"versions": ["ruby", "sapphire"], "text": "PINECO hangs from a tree branch and patiently waits for prey to come along. If the POKéMON is disturbed while eating by someone shaking its tree, it drops down to the ground and explodes with no warning."}, {"versions": ["emerald"], "text": "A PINECO hangs from a tree branch and waits for prey. While eating, if it is disturbed by someone shaking its tree, it falls on the ground and suddenly explodes."}, {"versions": ["firered"], "text": "It hangs and waits for flying-insect prey to come near. It does not move about much on its own."}, {"versions": ["leafgreen"], "text": "It likes to make its shell thicker by adding layers of tree bark. The extra weight doesn’t bother it."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It looks just like a pinecone. Its shell protects it from bird Pokémon that peck it by mistake."}, {"versions": ["heartgold", "x"], "text": "It likes to make its shell thicker by adding layers of tree bark. The additional weight doesn’t bother it."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Pineco hangs from a tree branch and patiently waits for prey to come along. If the Pokémon is disturbed while eating by someone shaking its tree, it drops down to the ground and explodes with no warning."}, {"versions": ["ultra-sun"], "text": "Motionless, it hangs from trees, waiting for its bug Pokémon prey to come to it. Its favorite in Alola is Cutiefly."}, {"versions": ["ultra-moon"], "text": "It sticks tree bark to itself with its saliva, making itself thicker and larger. Elderly Pineco are ridiculously huge."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/204.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/204.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/204.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/204.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/204.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/204.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/204.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/204.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeA