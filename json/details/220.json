{"height": 4, "weight": 65, "base_experience": 50, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Pig Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ウリムー"}, {"language": "ja-roma", "name": "Urimoo"}, {"language": "ko", "name": "꾸꾸리"}, {"language": "zh-hant", "name": "小山豬"}, {"language": "fr", "name": "Marcacrin"}, {"language": "de", "name": "Quiekel"}, {"language": "es", "name": "Swinub"}, {"language": "it", "name": "Swinub"}, {"language": "ja", "name": "ウリムー"}, {"language": "zh-hans", "name": "小山猪"}, {"language": "es-419", "name": "Swinub"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "x", "sword"], "text": "It rubs its snout on the ground to find and dig up food. It sometimes discovers hot springs."}, {"versions": ["silver"], "text": "If it smells some­ thing enticing, it dashes headlong off to find the source of the aroma."}, {"versions": ["crystal"], "text": "It uses the tip of its nose to dig for food. Its nose is so tough that even frozen ground poses no problem."}, {"versions": ["ruby", "sapphire"], "text": "SWINUB roots for food by rubbing its snout against the ground. Its favorite food is a mushroom that grows under the cover of dead grass. This POKéMON occasionally roots out hot springs."}, {"versions": ["emerald"], "text": "It roots for food by rubbing its snout against the ground. Its favorite food is a mushroom that grows under dried grass. It occasionally roots out hot springs."}, {"versions": ["firered", "soulsilver", "y", "shield"], "text": "If it smells something enticing, it dashes off headlong to find the source of the aroma."}, {"versions": ["diamond", "pearl"], "text": "It loves eating mushrooms that grow under dead grass. It also finds hot springs while foraging."}, {"versions": ["platinum", "black", "white"], "text": "It has a very sensitive nose. It can locate mushrooms, berries, and even hot springs buried under ice."}, {"versions": ["black-2", "white-2"], "text": "Rooting the tip of its snout into the ground, it searches for food. Sometimes it even digs up a hot spring."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Swinub roots for food by rubbing its snout against the ground. Its favorite food is a mushroom that grows under the cover of dead grass. This Pokémon occasionally roots out hot springs."}, {"versions": ["legends-arceus"], "text": "Swinub excels at sniffing out mushrooms buried beneath grass or snow. Since ancient times, the people of Hisui have often relied upon this skill."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/220.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/220.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/220.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/220.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/220.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/220.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/220.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/220.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/220.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versio