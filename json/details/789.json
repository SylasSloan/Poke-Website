{"height": 2, "weight": 1, "base_experience": 40, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Nebula Pokémon", "capture_rate": 45, "base_happiness": 0, "hatch_counter": 120, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "コスモッグ"}, {"language": "ja-roma", "name": "Cosmog"}, {"language": "ko", "name": "코스모그"}, {"language": "zh-hant", "name": "科斯莫古"}, {"language": "fr", "name": "Cosmog"}, {"language": "de", "name": "Cosmog"}, {"language": "es", "name": "Cosmog"}, {"language": "it", "name": "Cosmog"}, {"language": "ja", "name": "コスモッグ"}, {"language": "zh-hans", "name": "科斯莫古"}, {"language": "es-419", "name": "Cosmog"}], "pokedex_entries": [{"versions": ["sun"], "text": "Its body is gaseous and frail. It slowly grows as it collects dust from the atmosphere."}, {"versions": ["moon"], "text": "In ages past, it was called the child of the stars. It’s said to be a Pokémon from another world, but no specific details are known."}, {"versions": ["ultra-sun"], "text": "Even though its helpless, gaseous body can be blown away by the slightest breeze, it doesn’t seem to care."}, {"versions": ["ultra-moon"], "text": "Whether or not it’s a Pokémon from this world is a mystery. When it’s in a jam, it warps away to a safe place to hide."}, {"versions": ["sword"], "text": "This Pokémon came from another universe. Its gaseous body is so light that even a gentle breeze can blow it away."}, {"versions": ["shield"], "text": "Cosmog is very curious but not very cautious, often placing itself in danger. If things start to look dicey, it teleports away."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/789.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/789.png", "shin