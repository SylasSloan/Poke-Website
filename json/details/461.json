{"height": 11, "weight": 340, "base_experience": 179, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "speed", "value": 1}], "genus": "Sharp Claw Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マニューラ"}, {"language": "ja-roma", "name": "Manyula"}, {"language": "ko", "name": "포푸니라"}, {"language": "zh-hant", "name": "瑪狃拉"}, {"language": "fr", "name": "Dimoret"}, {"language": "de", "name": "Snibunna"}, {"language": "es", "name": "Weavile"}, {"language": "it", "name": "Weavile"}, {"language": "ja", "name": "マニューラ"}, {"language": "zh-hans", "name": "玛狃拉"}, {"language": "es-419", "name": "Weavile"}], "pokedex_entries": [{"versions": ["white-2", "black-2"], "text": "They communicate by clawing signs in boulders and work together to surround enemies."}, {"versions": ["diamond", "y", "alpha-sapphire"], "text": "They live in cold regions, forming groups of four or five that hunt prey with impressive coordination."}, {"versions": ["pearl"], "text": "It sends signals to others by carving odd patterns in frost- covered trees and ice."}, {"versions": ["platinum", "black", "white"], "text": "Evolution made it even more devious. It communicates by clawing signs in boulders."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "It lives in snowy regions. It carves patterns in trees with its claws as a signal to others."}, {"versions": ["sun"], "text": "They travel in groups of four or five, leaving signs for one another on trees and rocks. They bring down their prey with coordinated attacks."}, {"versions": ["moon"], "text": "They dwell in cold places. This Pokémon’s main food source in Alola is Vulpix and Sandshrew, which they carefully divide among their group."}, {"versions": ["ultra-sun"], "text": "One Weavile will trip a Sandshrew and flip it over, and then another Weavile will deal the finishing blow with its sharp claws."}, {"versions": ["ultra-moon"], "text": "Thanks to its increased intelligence, scrapping over food is a thing of the past. A scratch from its claws will give you a case of frostbite!"}, {"versions": ["sword"], "text": "They attack their quarry in packs. Prey as large as Mamoswine easily fall to the teamwork of a group of Weavile."}, {"versions": ["shield"], "text": "With its claws, it leaves behind signs for its friends to find. The number of distinct signs is said to be over 500."}, {"versions": ["legends-arceus"], "text": "This species corners prey as a pack, under the guidance of a leader. Weavile displays increased cunning, leading me to speculate that its evolution caused further brain development."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/461.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/461.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/461.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/461.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/461.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/461.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/461.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/461.png", "shiny": "https://raw.git