{"height": 16, "weight": 5500, "base_experience": 270, "ev_yield": [{"stat": "defense", "value": 3}], "genus": "Iron Leg Pokémon", "capture_rate": 3, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "メタグロス"}, {"language": "ja-roma", "name": "Metagross"}, {"language": "ko", "name": "메타그로스"}, {"language": "zh-hant", "name": "巨金怪"}, {"language": "fr", "name": "Métalosse"}, {"language": "de", "name": "Metagross"}, {"language": "es", "name": "Metagross"}, {"language": "it", "name": "Metagross"}, {"language": "ja", "name": "メタグロス"}, {"language": "zh-hans", "name": "巨金怪"}, {"language": "es-419", "name": "Metagross"}], "pokedex_entries": [{"versions": ["ruby"], "text": "METAGROSS has four brains in total. Combined, the four brains can breeze through difficult calculations faster than a supercomputer. This POKéMON can float in the air by tucking in its four legs."}, {"versions": ["sapphire"], "text": "METAGROSS is the result of two METANG achieving fusion. When hunting, this POKéMON pins the prey to the ground under its massive body. It then eats the helpless victim using the large mouth on its stomach."}, {"versions": ["emerald"], "text": "METAGROSS has four brains that are joined by a complex neural network. As a result of integration, this POKéMON is smarter than a supercomputer."}, {"versions": ["firered", "leafgreen"], "text": "It is formed by two METANG fusing. Its four brains are said to be superior to a supercomputer."}, {"versions": ["diamond", "pearl", "platinum"], "text": "METANG combined to form it. With four brains, it has the intelligence of a supercomputer."}, {"versions": ["heartgold", "soulsilver"], "text": "It folds its four legs when flying. Its four brains are said to be superior to a supercomputer."}, {"versions": ["black", "white", "y"], "text": "Metang combined to form it. With four brains, it has the intelligence of a supercomputer."}, {"versions": ["black-2", "white-2", "x"], "text": "With four linked brains, it’s more intelligent than a supercomputer, and it uses calculations to analyze foes."}, {"versions": ["omega-ruby"], "text": "Metagross has four brains in total. Combined, the four brains can breeze through difficult calculations faster than a supercomputer. This Pokémon can float in the air by tucking in its four legs."}, {"versions": ["ultra-moon"], "text": "It analyzes its opponents with more accuracy than a supercomputer, which enables it to calmly back them into a corner."}, {"versions": ["alpha-sapphire"], "text": "Metagross is the result of two Metang achieving fusion. When hunting, this Pokémon pins the prey to the ground under its massive body. It then eats the helpless victim using the large mouth on its stomach."}, {"versions": ["sun"], "text": "It firmly pins its prey using its four claws and large body. Then the teeth in the mouth on its stomach chew the prey to bits."}, {"versions": ["moon"], "text": "A linkage of two Metang, this Pokémon can perform any calculation in a flash by utilizing parallel processing in its four brains."}, {"versions": ["ultra-sun"], "text": "It boasts not only psychic powers but also fantastic strength. It grabs its prey with its four legs and holds them in place with its claws."}, {"versions": ["sword"], "text": "Because the magnetic powers of these Pokémon get stronger in freezing temperatures, Metagross living on snowy mountains are full of energy."}, {"versions": ["shield"], "text": "Metagross is the result of the fusion of two Metang. This Pokémon defeats its opponents through use of its supercomputer-level brain."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/376.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/376.png"}, "ruby-sapphire": {"normal": "https://