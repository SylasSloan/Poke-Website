{"height": 8, "weight": 60, "base_experience": 43, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Scout Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オタチ"}, {"language": "ja-roma", "name": "Otachi"}, {"language": "ko", "name": "꼬리선"}, {"language": "zh-hant", "name": "尾立"}, {"language": "fr", "name": "Fouinette"}, {"language": "de", "name": "Wiesor"}, {"language": "es", "name": "Sentret"}, {"language": "it", "name": "Sentret"}, {"language": "ja", "name": "オタチ"}, {"language": "zh-hans", "name": "尾立"}, {"language": "es-419", "name": "Sentret"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It has a very nervous nature. It stands up high on its tail so it can scan wide areas."}, {"versions": ["gold", "leafgreen"], "text": "A very cautious POKéMON, it raises itself up using its tail to get a better view of its surroundings."}, {"versions": ["silver", "firered", "soulsilver", "y"], "text": "It stands on its tail so it can see a long way. If it spots an enemy, it cries loudly to warn its kind."}, {"versions": ["crystal", "x"], "text": "When acting as a lookout, it warns others of danger by screeching and hitting the ground with its tail."}, {"versions": ["ruby", "sapphire"], "text": "When SENTRET sleeps, it does so while another stands guard. The sentry wakes the others at the first sign of danger. When this POKéMON becomes separated from its pack, it becomes incapable of sleep due to fear."}, {"versions": ["emerald"], "text": "They take turns standing guard when it is time to sleep. The sentry awakens the others if it senses danger. If one becomes separated, it turns sleepless with fear."}, {"versions": ["heartgold"], "text": "A very cautious Pokémon, it raises itself up using its tail to get a better view of its surroundings."}, {"versions": ["omega-ruby"