{"height": 8, "weight": 175, "base_experience": 158, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Soft Tissue Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヌメイル"}, {"language": "ja-roma", "name": "Numeil"}, {"language": "ko", "name": "미끄네일"}, {"language": "zh-hant", "name": "黏美兒"}, {"language": "fr", "name": "Colimucus"}, {"language": "de", "name": "Viscargot"}, {"language": "es", "name": "Sliggoo"}, {"language": "it", "name": "Sliggoo"}, {"language": "ja", "name": "ヌメイル"}, {"language": "zh-hans", "name": "黏美儿"}, {"language": "es-419", "name": "Sliggoo"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "It drives away opponents by excreting a sticky liquid that can dissolve anything. Its eyes devolved, so it can’t see anything."}, {"versions": ["y", "alpha-sapphire"], "text": "Its four horns are a high-performance radar system. It uses them to sense sounds and smells, rather than using ears or a nose."}, {"versions": ["sun"], "text": "It has trouble drawing a line between friends and food. It will calmly try to melt and eat even those it gets along well with."}, {"versions": ["moon"], "text": "This Pokémon’s mucous can dissolve anything. Toothless, it sprays mucous on its prey. Once they’re nicely dissolved, it slurps them up."}, {"versions": ["ultra-sun"], "text": "It crawls along sluggishly. The swirly protrusion on its back is filled with its brain and other organs."}, {"versions": ["ultra-moon"], "text": "Its entire body is covered with gooey mucus that can dissolve anything. Be sure to put gloves on if you’re going to touch it."}, {"versions": ["sword"], "text": "Although this Pokémon isn’t very strong, its body is coated in a caustic slime that can melt through anything, so predators steer clear of it."}, {"versions": ["shield"], "text": "The lump on its back contains its tiny brain. It thinks only of food and escaping its enemies."}, {"versions": ["legends-arceus"], "text": "A creature given to melancholy. I suspect its metallic shell developed as a result of the mucus on its skin reacting with the iron in Hisui's water."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/705.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/705.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/705.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/705.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/705.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/705.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/705.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/705.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/705.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/705.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/705.png", "shiny": null}}}, "moves_by_genera