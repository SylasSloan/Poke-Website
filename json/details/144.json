{"height": 17, "weight": 554, "base_experience": 261, "ev_yield": [{"stat": "special-defense", "value": 3}], "genus": "Freeze Pokémon", "capture_rate": 3, "base_happiness": 35, "hatch_counter": 80, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "フリーザー"}, {"language": "ja-roma", "name": "Freezer"}, {"language": "ko", "name": "프리져"}, {"language": "zh-hant", "name": "急凍鳥"}, {"language": "fr", "name": "Artikodin"}, {"language": "de", "name": "Arktos"}, {"language": "es", "name": "Articuno"}, {"language": "it", "name": "Articuno"}, {"language": "ja", "name": "フリーザー"}, {"language": "zh-hans", "name": "急冻鸟"}, {"language": "es-419", "name": "Articuno"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "A legendary bird POKéMON that is said to appear to doomed people who are lost in icy mountains."}, {"versions": ["yellow"], "text": "A legendary bird POKéMON. It freezes water that is contained in winter air and makes it snow."}, {"versions": ["gold"], "text": "The magnificent, seemingly translu­ cent wings of this legendary bird POKéMON are said to be made of ice."}, {"versions": ["silver"], "text": "One of the legen­ dary bird POKéMON, it chills moisture in the atmosphere to create snow while flying."}, {"versions": ["crystal"], "text": "Legendary bird POKéMON. As it flies through the sky, it cools the air, causing snow to fall."}, {"versions": ["ruby", "sapphire", "emerald"], "text": "ARTICUNO is a legendary bird POKéMON that can control ice. The flapping of its wings chills the air. As a result, it is said that when this POKéMON flies, snow will fall."}, {"versions": ["firered"], "text": "One of the legendary bird POKéMON. With its long tail trailing behind, its flying form is magnificent."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "A legendary bird Pokémon. It can create blizzards by freezing moisture in the air."}, {"versions