{"height": 92, "weight": 4000, "base_experience": 179, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Iron Snake Pokémon", "capture_rate": 25, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハガネール"}, {"language": "ja-roma", "name": "Haganeil"}, {"language": "ko", "name": "강철톤"}, {"language": "zh-hant", "name": "大鋼蛇"}, {"language": "fr", "name": "Steelix"}, {"language": "de", "name": "Stahlos"}, {"language": "es", "name": "Steelix"}, {"language": "it", "name": "Steelix"}, {"language": "ja", "name": "ハガネール"}, {"language": "zh-hans", "name": "大钢蛇"}, {"language": "es-419", "name": "Steelix"}], "pokedex_entries": [{"versions": ["gold", "heartgold"], "text": "Its body has been compressed deep under the ground. As a result, it is even harder than a diamond."}, {"versions": ["silver", "firered"], "text": "It is said that if an ONIX lives for over 100 years, its composition changes to become diamond-like."}, {"versions": ["crystal"], "text": "The many small metal particles that cover this POKéMON's body reflect bright light well."}, {"versions": ["ruby", "sapphire"], "text": "STEELIX lives even further underground than ONIX. This POKéMON is known to dig towards the earth’s core. There are records of this POKéMON reaching a depth of over six-tenths of a mile underground."}, {"versions": ["emerald"], "text": "STEELIX live even further underground than ONIX. This POKéMON is known to dig toward the earth’s core, reaching a depth of over six-tenths of a mile underground."}, {"versions": ["leafgreen"], "text": "Its body has been compressed deep under the ground. As a result, it is even harder than diamond."}, {"versions": ["diamond", "x"], "text": "Tempered underground under high pressure and heat, its body is harder than any metal."}, {"versions": ["pearl", "y"], "text": "It chews its way through boulders with its sturdy jaws. Its eyes can see in the darkness underground."}, {"versions": ["platinum", "black", "white", "shield"], "text": "It is thought its body transformed as a result of iron accumulating internally from swallowing soil."}, {"versions": ["soulsilver"], "text": "It’s said that if an ONIX lives for 100 years, its composition becomes diamondlike as it evolves into a STEELIX."}, {"versions": ["black-2", "white-2"], "text": "The iron it ingested with the soil it swallowed transformed its body and made it harder than diamonds."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Steelix lives even further underground than Onix. This Pokémon is known to dig toward the earth’s core. There are records of this Pokémon reaching a depth of over six-tenths of a mile underground."}, {"versions": ["sword"], "text": "It is said that if an Onix lives for over 100 years, its composition changes to become diamond-like."}, {"versions": ["legends-arceus"], "text": "This Pokémon evolved through use of a strange item. Its body is coated with steel powder and notably hard—not even diamond can leave so much as a scratch."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/208.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/208.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/208.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/208.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/208.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/208.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprite