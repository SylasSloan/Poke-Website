{"height": 5, "weight": 105, "base_experience": 70, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Eaglet Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["flying"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "ワシボン"}, {"language": "ja-roma", "name": "Washibon"}, {"language": "ko", "name": "수리둥보"}, {"language": "zh-hant", "name": "毛頭小鷹"}, {"language": "fr", "name": "Furaiglon"}, {"language": "de", "name": "Geronimatz"}, {"language": "es", "name": "Rufflet"}, {"language": "it", "name": "Rufflet"}, {"language": "ja", "name": "ワシボン"}, {"language": "zh-hans", "name": "毛头小鹰"}, {"language": "es-419", "name": "Rufflet"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "They crush berries with their talons. They bravely stand up to any opponent, no matter how strong it is."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "They will challenge anything, even strong opponents, without fear. Their frequent fights help them become stronger."}, {"versions": ["black-2", "white-2"], "text": "It stands up to massive opponents, not out of courage, but out of recklessness. But that is how it gets stronger."}, {"versions": ["sun"], "text": "They pick fights indiscriminately. They grow stronger and more powerful each time they faint or are injured."}, {"versions": ["moon"], "text": "With its sharp claws, this Pokémon pierces its prey, and then it pecks at them. Although it also consumes berries, it’s a carnivore at heart."}, {"versions": ["ultra-sun"], "text": "With its powerful legs and sturdy claws, it can crack even the hard shells of Shellder and pluck out their insides."}, {"versions": ["ultra-moon"], "text": "Known as a natural-born warrior, soon after its hatching, it will challenge its parent to a fight in order to gain their acceptance."}, {"versions": ["sword"], "text": "If it spies a strong Pokémon, Rufflet can’t resist challenging it to a battle. But if Rufflet loses, it starts bawling."}, {"versions": ["shield"], "text": "A combative Pokémon, it’s ready to pick a fight with anyone. It has talons that can crush hard berries."}, {"versions": ["legends-arceus"], "text": "Its chick-like looks belie its hotheadedness. It challenges its parents at every opportunity, desperate to prove its strength."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/627.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/627.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/627.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/627.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/627.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/627.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/627.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/627.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/627.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/627.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeA