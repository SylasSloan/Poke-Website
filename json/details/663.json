{"height": 12, "weight": 245, "base_experience": 175, "ev_yield": [{"stat": "speed", "value": 3}], "genus": "Scorching Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ファイアロー"}, {"language": "ja-roma", "name": "Fiarrow"}, {"language": "ko", "name": "파이어로"}, {"language": "zh-hant", "name": "烈箭鷹"}, {"language": "fr", "name": "Flambusard"}, {"language": "de", "name": "Fiaro"}, {"language": "es", "name": "Talonflame"}, {"language": "it", "name": "Talonflame"}, {"language": "ja", "name": "ファイアロー"}, {"language": "zh-hans", "name": "烈箭鹰"}, {"language": "es-419", "name": "Talonflame"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "In the fever of an exciting battle, it showers embers from the gaps between its feathers and takes to the air."}, {"versions": ["y", "alpha-sapphire"], "text": "When attacking prey, it can reach speeds of up to 310 mph. It finishes its prey off with a colossal kick."}, {"versions": ["sun"], "text": "Its favorite foods are Wingull and Pikipek. It attacks with a powerful kick and grasps them firmly in its talons."}, {"versions": ["moon"], "text": "It zooms directly at its prey at flight speeds of close to 310 mph, while fiery embers scatter from gaps in its feathers."}, {"versions": ["ultra-sun"], "text": "Its tough wings don’t allow fire to pass through them. A long time ago, firefighters’ outfits were made from Talonflame wings."}, {"versions": ["ultra-moon"], "text": "Bird Pokémon make up most of its diet. It approaches at high speeds and smacks them down to the ground with its powerful kick."}, {"versions": ["sword"], "text": "Talonflame mainly preys upon other bird Pokémon. To intimidate opponents, it sends embers spewing from gaps between its feathers."}, {"versions": ["shield"], "text": "Talonflame dives toward prey at speeds of up to 310 mph and assaults them with powerful kicks, givin