{"height": 7, "weight": 125, "base_experience": 71, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Old Shrimp Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "アノプス"}, {"language": "ja-roma", "name": "Anopth"}, {"language": "ko", "name": "아노딥스"}, {"language": "zh-hant", "name": "太古羽蟲"}, {"language": "fr", "name": "Anorith"}, {"language": "de", "name": "Anorith"}, {"language": "es", "name": "Anorith"}, {"language": "it", "name": "Anorith"}, {"language": "ja", "name": "アノプス"}, {"language": "zh-hans", "name": "太古羽虫"}, {"language": "es-419", "name": "Anorith"}], "pokedex_entries": [{"versions": ["ruby"], "text": "ANORITH was regenerated from a prehistoric fossil. This primitive POKéMON once lived in warm seas. It grips its prey firmly between its two large claws."}, {"versions": ["sapphire"], "text": "ANORITH is said to be a type of POKéMON predecessor, with eight wings at the sides of its body. This POKéMON swam in the primordial sea by undulating these eight wings."}, {"versions": ["emerald"], "text": "It was resurrected from a fossil using the power of science. It swims by undulating the eight wings at its sides. They were feet that adapted to life in the sea."}, {"versions": ["firered", "leafgreen"], "text": "It is a kind of POKéMON progenitor. It uses its extending claws to catch prey hiding among rocks on the seafloor."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "A Pokémon ancestor that was reanimated from a fossil. It lived in the sea and hunted with claws."}, {"versions": ["heartgold", "soulsilver"], "text": "An ancestral Pokémon that lived in the ocean. Over time, its eight feet transformed into wings."}, {"versions": ["x"], "text": "It is a kind of Pokémon progenitor. It uses its extending claws to catch prey hiding among rocks on the seafloor."}, 