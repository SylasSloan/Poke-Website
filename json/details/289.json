{"height": 20, "weight": 1305, "base_experience": 252, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Lazy Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ケッキング"}, {"language": "ja-roma", "name": "Kekking"}, {"language": "ko", "name": "게을킹"}, {"language": "zh-hant", "name": "請假王"}, {"language": "fr", "name": "Monaflèmit"}, {"language": "de", "name": "Letarking"}, {"language": "es", "name": "Slaking"}, {"language": "it", "name": "Slaking"}, {"language": "ja", "name": "ケッキング"}, {"language": "zh-hans", "name": "请假王"}, {"language": "es-419", "name": "Slaking"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SLAKING spends all day lying down and lolling about. It eats grass growing within its reach. If it eats all the grass it can reach, this POKéMON reluctantly moves to another spot."}, {"versions": ["sapphire"], "text": "Wherever SLAKING live, rings of over a yard in diameter appear in grassy fields. They are made by the POKéMON as it eats all the grass within reach while lying prone on the ground."}, {"versions": ["emerald"], "text": "Hordes of SLAKING gather around trees when fruits come into season. They wait around patiently for ripened fruits to fall out of the trees."}, {"versions": ["firered", "leafgreen"], "text": "It is the world’s most slothful POKéMON. However, it can exert horrifying power by releasing pent-up energy all at once."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "The world’s laziest Pokémon. When it is lounging, it is actually saving energy for striking back."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "The world’s laziest Pokémon. It moves to another spot when there’s no food left within its reach."}, {"versions": ["black-2", "white-2"], "text": "This Pokémon lives lying on its side. It only rolls over and moves when there is no more grass to eat."}, {"vers