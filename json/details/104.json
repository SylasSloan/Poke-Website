{"height": 4, "weight": 65, "base_experience": 64, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Lonely Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カラカラ"}, {"language": "ja-roma", "name": "Karakara"}, {"language": "ko", "name": "탕구리"}, {"language": "zh-hant", "name": "卡拉卡拉"}, {"language": "fr", "name": "Osselait"}, {"language": "de", "name": "Tragosso"}, {"language": "es", "name": "Cubone"}, {"language": "it", "name": "Cubone"}, {"language": "ja", "name": "カラカラ"}, {"language": "zh-hans", "name": "卡拉卡拉"}, {"language": "es-419", "name": "Cubone"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Because it never removes its skull helmet, no one has ever seen this POKéMON's real face."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Wears the skull of its deceased mother. Its cries echo inside the skull and come out as a sad melody."}, {"versions": ["gold"], "text": "If it is sad or lonely, the skull it wears shakes, and emits a plain­ tive and mournful sound."}, {"versions": ["silver", "soulsilver", "y"], "text": "It always wears the skull of its dead mother, so no one has any idea what its hidden face looks like."}, {"versions": ["crystal"], "text": "It lost its mother after its birth. It wears its mother's skull, never revealing its true face."}, {"versions": ["ruby", "sapphire"], "text": "CUBONE pines for the mother it will never see again. Seeing a likeness of its mother in the full moon, it cries. The stains on the skull the POKéMON wears are made by the tears it sheds."}, {"versions": ["emerald"], "text": "It pines for the mother it will never see again. Seeing a likeness of its mother in the full moon, it cries. The stains on the skull it wears are from its tears."}, {"versions": ["firered", "x"], "text": "It wears the skull of its dead mother on its head. When it becomes lonesome, it is said to cry loudly."}, {"versions": ["leafgreen"], "text": "Because it never removes its skull helmet, no one has ever seen this POKéMON’s real face."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "When it thinks of its dead mother, it cries. Its crying makes the skull it wears rattle hollowly."}, {"versions": ["heartgold"], "text": "If it is sad or lonely, the skull it wears shakes and emits a plaintive and mournful sound."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Cubone pines for the mother it will never see again. Seeing a likeness of its mother in the full moon, it cries. The stains on the skull the Pokémon wears are made by the tears it sheds."}, {"versions": ["sun"], "text": "When it thinks of its deceased mother, it weeps loudly. Mandibuzz that hear its cries will attack it from the air."}, {"versions": ["moon"], "text": "The skull it wears on its head is that of its dead mother. According to some, it will evolve when it comes to terms with the pain of her death."}, {"versions": ["ultra-sun"], "text": "At night, it weeps loudly for its dead mother, but those cries only attract its natural enemy—Mandibuzz."}, {"versions": ["ultra-moon"], "text": "It wears its mother’s skull on its head, so no one knows what its bare face looks like. However, it’s clear that it’s always crying."}, {"versions": ["sword"], "text": "When the memory of its departed mother brings it to tears, its cries echo mournfully within the skull it wears on its head."}, {"versions": ["shield"], "text": "This Pokémon wears the skull of its deceased mother. Sometimes Cubone’s dreams make it cry, but each tear Cubone sheds makes it stronger."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/104.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites