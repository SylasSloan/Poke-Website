{"height": 10, "weight": 970, "base_experience": 75, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Compass Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ノズパス"}, {"language": "ja-roma", "name": "Nosepass"}, {"language": "ko", "name": "코코파스"}, {"language": "zh-hant", "name": "朝北鼻"}, {"language": "fr", "name": "Tarinor"}, {"language": "de", "name": "Nasgnet"}, {"language": "es", "name": "Nosepass"}, {"language": "it", "name": "Nosepass"}, {"language": "ja", "name": "ノズパス"}, {"language": "zh-hans", "name": "朝北鼻"}, {"language": "es-419", "name": "Nosepass"}], "pokedex_entries": [{"versions": ["ruby"], "text": "NOSEPASS’s magnetic nose is always pointed to the north. If two of these POKéMON meet, they cannot turn their faces to each other when they are close because their magnetic noses repel one another."}, {"versions": ["sapphire"], "text": "NOSEPASS had been said to be completely unmoving, with its magnetic nose pointed due north. However, close observation has revealed that the POKéMON actually moves by a little over 3/8 of an inch every year."}, {"versions": ["emerald"], "text": "Its body emits a powerful magnetism. It feeds on prey that is pulled in by the force. Its magnetism is stronger in cold seasons."}, {"versions": ["firered", "leafgreen"], "text": "Its magnetic nose consistently faces north. Travelers check NOSEPASS to get their bearings."}, {"versions": ["diamond", "pearl"], "text": "Its nose is a magnet. As a result, this Pokémon always keeps its face pointing north."}, {"versions": ["platinum", "black", "white"], "text": "When endangered, it may protect itself by raising its magnetism and drawing iron objects to its body."}, {"versions": ["heartgold", "soulsilver"], "text": "If two of these meet, they cannot get too close because their noses repel each other."}, {"versions": ["black-2", "white-2", "x"], "text": "Its magnetic nose always faces north and draws iron objects to its body to protect itself better."}, {"versions": ["y"], "text": "Its magnetic nose consistently faces north. Travelers check Nosepass to get their bearings."}, {"versions": ["omega-ruby"], "text": "Nosepass’s magnetic nose is always pointed to the north. If two of these Pokémon meet, they cannot turn their faces to each other when they are close because their magnetic noses repel one another."}, {"versions": ["alpha-sapphire"], "text": "Nosepass had been said to be completely unmoving, with its magnetic nose pointed due north. However, close observation has revealed that the Pokémon actually moves by a little over 3/8 of an inch every year."}, {"versions": ["sun"], "text": "The magnet in Nosepass’s nose provides an unerring compass, making it an excellent partner for Trainers going on a journey."}, {"versions": ["moon"], "text": "It uses powerful magnetism to drag its prey toward it. It’s also been known to pull in metal, which it collects and uses to protect itself."}, {"versions": ["ultra-sun"], "text": "It moves less than an inch a year, but when it’s in a jam, it will spin and drill down into the ground in a split second."}, {"versions": ["ultra-moon"], "text": "It hunts without twitching a muscle by pulling in its prey with powerful magnetism. But sometimes it pulls natural enemies in close."}, {"versions": ["legends-arceus"], "text": "Once the people of Hisui discovered that its red nose always points north, they grew to rely on it greatly when traveling afar. The nose seems to work in a similar way to ancient compasses."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/299.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/299.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/P