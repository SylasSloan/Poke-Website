{"height": 18, "weight": 226, "base_experience": 170, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "South Sea Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "zh-hant", "name": "櫻花魚"}, {"language": "ja-hrkt", "name": "サクラビス"}, {"language": "ja-roma", "name": "Sakurabyss"}, {"language": "ko", "name": "분홍장이"}, {"language": "fr", "name": "Rosabyss"}, {"language": "de", "name": "Saganabyss"}, {"language": "es", "name": "Gorebyss"}, {"language": "it", "name": "Gorebyss"}, {"language": "ja", "name": "サクラビス"}, {"language": "zh-hans", "name": "樱花鱼"}, {"language": "es-419", "name": "Gorebyss"}], "pokedex_entries": [{"versions": ["ruby"], "text": "GOREBYSS lives in the southern seas at extreme depths. Its body is built to withstand the enormous pressure of water at incredible depths. Because of this, this POKéMON’s body is unharmed by ordinary attacks."}, {"versions": ["sapphire"], "text": "Although GOREBYSS is the very picture of elegance and beauty while swimming, it is also cruel. When it spots prey, this POKéMON inserts its thin mouth into the prey’s body and drains the prey of its body fluids."}, {"versions": ["emerald"], "text": "A GOREBYSS siphons the body fluids of prey through its thin, tubular mouth. Its light pink body color turns vivid when it finishes feeding."}, {"versions": ["firered", "leafgreen", "y"], "text": "Its swimming form is exquisitely elegant. With its thin mouth, it feeds on seaweed that grows between rocks."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It lives at the bottom of the sea. In the springtime, its pink body turns more vivid for some reason."}, {"versions": ["heartgold", "soulsilver"], "text": "Its pink body becomes more vivid with the rise of water temperatures in the springtime."}, {"versions": ["omega-ruby"], "text": "Gorebyss lives in the southern seas at extreme depths. Its body is built to withstand the enormous pressure of water at incredible depths. Because of this, this Pokémon’s body is unharmed by ordinary attacks."}, {"versions": ["alpha-sapphire"], "text": "Although Gorebyss is the very picture of elegance and beauty while swimming, it is also cruel. When it spots prey, this Pokémon inserts its thin mouth into the prey’s body and drains the prey of its body fluids."}, {"versions": ["ultra-sun"], "text": "The color of its body changes with the water temperature. The coloration of Gorebyss in Alola is almost blindingly vivid."}, {"versions": ["ultra-moon"], "text": "It sucks bodily fluids out of its prey. The leftover meat sinks to the seafloor, where it becomes food for other Pokémon."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/368.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/368.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/368.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/368.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/368.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/368.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/368.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/368.png"}, "platinum":