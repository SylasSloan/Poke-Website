{"height": 13, "weight": 600, "base_experience": 227, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Drill Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["no-eggs"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ニドクイン"}, {"language": "ja-roma", "name": "Nidoqueen"}, {"language": "ko", "name": "니드퀸"}, {"language": "zh-hant", "name": "尼多后"}, {"language": "fr", "name": "Nidoqueen"}, {"language": "de", "name": "Nidoqueen"}, {"language": "es", "name": "Nidoqueen"}, {"language": "it", "name": "Nidoqueen"}, {"language": "ja", "name": "ニドクイン"}, {"language": "zh-hans", "name": "尼多后"}, {"language": "es-419", "name": "Nidoqueen"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Its hard scales provide strong protection. It uses its hefty bulk to execute powerful moves."}, {"versions": ["yellow"], "text": "Tough scales cover the sturdy body of this POKéMON. It appears that the scales grow in cycles."}, {"versions": ["gold"], "text": "Its body is cover­ ed with needle- like scales. It never shows signs of shrinking from any attack."}, {"versions": ["silver", "soulsilver", "x"], "text": "It uses its scaly, rugged body to seal the entrance of its nest and protect its young from predators."}, {"versions": ["crystal"], "text": "The hard scales that cover its strong body serve as excellent protection from any attack."}, {"versions": ["ruby", "sapphire"], "text": "NIDOQUEEN’s body is encased in extremely hard scales. It is adept at sending foes flying with harsh tackles. This POKéMON is at its strongest when it is defending its young."}, {"versions": ["emerald"], "text": "It is adept at sending foes flying with harsh tackles using its tough, scaly body. This POKéMON is at its strongest when it is defending its young."}, {"versions": ["firered"], "text": "The body is covered by stiff, needle- like scales. If it becomes excited, the needles bristle outwards."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Its entire body is armored with hard scales. It will protect the young in its burrow with its life."}, {"versions": ["heartgold"], "text": "Its body is covered with needle-like scales. It never shows signs of shrinking from any attack."}, {"versions": ["y"], "text": "The body is covered by stiff, needlelike scales. If it becomes excited, the needles bristle outwards."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Nidoqueen’s body is encased in extremely hard scales. It is adept at sending foes flying with harsh tackles. This Pokémon is at its strongest when it is defending its young."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Tough scales cover the sturdy body of this Pokémon. It appears that the scales grow in cycles."}, {"versions": ["sword"], "text": "Nidoqueen is better at defense than offense. With scales like armor, this Pokémon will shield its children from any kind of attack."}, {"versions": ["shield"], "text": "It pacifies offspring by placing them in the gaps between the spines on its back. The spines will never secrete poison while young are present."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/31.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/31.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/31.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/31.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/31.png", "shiny": "https://raw.githubusercontent.com/Poke