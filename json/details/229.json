{"height": 14, "weight": 350, "base_experience": 175, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Dark Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヘルガー"}, {"language": "ja-roma", "name": "Hellgar"}, {"language": "ko", "name": "헬가"}, {"language": "zh-hant", "name": "黑魯加"}, {"language": "fr", "name": "Démolosse"}, {"language": "de", "name": "Hundemon"}, {"language": "es", "name": "Houndoom"}, {"language": "it", "name": "Houndoom"}, {"language": "ja", "name": "ヘルガー"}, {"language": "zh-hans", "name": "黑鲁加"}, {"language": "es-419", "name": "Houndoom"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold"], "text": "If you are burned by the flames it shoots from its mouth, the pain will never go away."}, {"versions": ["silver", "firered"], "text": "Upon hearing its eerie howls, other POKéMON get the shivers and head straight back to their nests."}, {"versions": ["crystal"], "text": "The pungent- smelling flame that shoots from its mouth results from toxins burn­ ing in its body."}, {"versions": ["ruby", "sapphire"], "text": "In a HOUNDOOM pack, the one with its horns raked sharply towards the back serves a leadership role. These POKéMON choose their leader by fighting amongst themselves."}, {"versions": ["emerald"], "text": "In a HOUNDOOM pack, the one with its horns raked sharply back serves a leadership role. They choose their leader by fighting among themselves."}, {"versions": ["diamond", "pearl", "x"], "text": "Long ago, people imagined its eerie howls to be the call of the grim reaper."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y"], "text": "The flames it breathes when angry contain toxins. If they cause a burn, it will hurt forever."}, {"versions": ["soulsilver"], "text": "Upon hearing its eerie howls, other Pokémon get the shivers and head straight back to their nests."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "In a Houndoom pack, the one with its horns raked sharply toward the back serves a leadership role. These Pokémon choose their leader by fighting among themselves."}, {"versions": ["ultra-sun"], "text": "They spew flames mixed with poison to finish off their opponents. They divvy up their prey evenly among the members of their pack."}, {"versions": ["ultra-moon"], "text": "Identifiable by its eerie howls, people a long time ago thought it was the grim reaper and feared it."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/229.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/229.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/229.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/229.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/229.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/229.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/229.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/229.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/229.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/229.png"}}, "generation-iv": {"diamond-pearl": {"normal": "ht