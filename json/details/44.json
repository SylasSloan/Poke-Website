{"height": 8, "weight": 86, "base_experience": 138, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Weed Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "クサイハナ"}, {"language": "ja-roma", "name": "Kusaihana"}, {"language": "ko", "name": "냄새꼬"}, {"language": "zh-hant", "name": "臭臭花"}, {"language": "fr", "name": "Ortide"}, {"language": "de", "name": "Duflor"}, {"language": "es", "name": "Gloom"}, {"language": "it", "name": "Gloom"}, {"language": "ja", "name": "クサイハナ"}, {"language": "zh-hans", "name": "臭臭花"}, {"language": "es-419", "name": "Gloom"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The fluid that oozes from its mouth isn't drool. It is a nectar that is used to attract prey."}, {"versions": ["yellow"], "text": "Smells incredibly foul! However, around 1 out of 1,000 people enjoy sniffing its nose- bending stink."}, {"versions": ["gold", "heartgold", "shield"], "text": "What appears to be drool is actually sweet honey. It is very sticky and clings stubbornly if touched."}, {"versions": ["silver", "soulsilver"], "text": "It secretes a sticky, drool-like honey. Although sweet, it smells too repulsive to get very close."}, {"versions": ["crystal"], "text": "The smell from its drool-like syrup and the pollen on its petals is so bad, it may make opponents faint."}, {"versions": ["ruby"], "text": "GLOOM releases a foul fragrance from the pistil of its flower. When faced with danger, the stench worsens. If this POKéMON is feeling calm and secure, it does not release its usual stinky aroma."}, {"versions": ["sapphire"], "text": "From its mouth GLOOM drips honey that smells absolutely horrible. Apparently, it loves the horrid stench. It sniffs the noxious fumes and then drools even more of its honey."}, {"versions": ["emerald"], "text": "A horribly noxious honey drools from its mouth. One whiff of the honey can result in memory loss. Some fans are said to enjoy this overwhelming stink, however."}, {"versions": ["firered", "sword"], "text": "Its pistils exude an incredibly foul odor. The horrid stench can cause fainting at a distance of 1.25 miles."}, {"versions": ["leafgreen"], "text": "The fluid that oozes from its mouth isn’t drool. It is a nectar that is used to attract prey."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "The honey it drools from its mouth smells so atrocious, it can curl noses more than a mile away."}, {"versions": ["x", "lets-go-pikachu", "lets-go-eevee"], "text": "Smells incredibly foul! However, around one out of a thousand people enjoy sniffing its nose-bending stink."}, {"versions": ["omega-ruby"], "text": "Gloom releases a foul fragrance from the pistil of its flower. When faced with danger, the stench worsens. If this Pokémon is feeling calm and secure, it does not release its usual stinky aroma."}, {"versions": ["alpha-sapphire"], "text": "From its mouth Gloom drips honey that smells absolutely horrible. Apparently, it loves the horrid stench. It sniffs the noxious fumes and then drools even more of its honey."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/44.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/44.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/44.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/44.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/44.png", "shiny": "https://raw.git