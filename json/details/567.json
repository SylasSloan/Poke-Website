{"height": 14, "weight": 320, "base_experience": 177, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "First Bird Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["flying", "water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "アーケオス"}, {"language": "ja-roma", "name": "Archeos"}, {"language": "ko", "name": "아케오스"}, {"language": "zh-hant", "name": "始祖大鳥"}, {"language": "fr", "name": "Aéroptéryx"}, {"language": "de", "name": "Aeropteryx"}, {"language": "es", "name": "Archeops"}, {"language": "it", "name": "Archeops"}, {"language": "ja", "name": "アーケオス"}, {"language": "zh-hans", "name": "始祖大鸟"}, {"language": "es-419", "name": "Archeops"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "They are intelligent and will cooperate to catch prey. From the ground, they use a running start to take flight."}, {"versions": ["white"], "text": "It runs better than it flies. It catches prey by running at speeds comparable to those of an automobile."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "It runs better than it flies. It takes off into the sky by running at a speed of 25 mph."}, {"versions": ["sun"], "text": "Although apparently able to fly, they tended to run along the ground, averaging speeds of roughly 25 mph."}, {"versions": ["moon"], "text": "They hunted in flocks. When one Archeops had the prey cornered, another would swoop on it."}, {"versions": ["ultra-sun"], "text": "This ancient Pokémon’s plumage is delicate, so if anyone other than an experienced professional tries to restore it, they will fail."}, {"versions": ["ultra-moon"], "text": "Said to be an ancestor of bird Pokémon, the muscles it uses to flap its wings are still weak, so it needs a long runway in order to take off."}, {"versions": ["sword"], "text": "It needs a running start to take off. If Archeops wants to fly, it first needs to run nearly 25 mph, building speed over a course of about 2.5 miles."}, {"versions": ["shield"], "text": "Though capable of flight, Archeops was apparently better at hunting on the ground."}], "sprites_by_gen": {"generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/567.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/567.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/567.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/567.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/567.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/567.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/567.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/567.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/567.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/567.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation V", "level_up": [{"level": 1, "label": "Level 1", "name": "Wing Attack"}, {"level": 1, "label": "Level 1", "name": "Leer"}, {"level": 1, "label": "Level 1", "name": "Rock Throw"}, {"level": 1, "label": "Level 1", "name": "Quick Attack"}, {"leve