{"height": 21, "weight": 3600, "base_experience": 239, "ev_yield": [{"stat": "defense", "value": 3}], "genus": "Iron Armor Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 35, "growth_rate": "slow", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ボスゴドラ"}, {"language": "ja-roma", "name": "Bossgodora"}, {"language": "ko", "name": "보스로라"}, {"language": "zh-hant", "name": "波士可多拉"}, {"language": "fr", "name": "Galeking"}, {"language": "de", "name": "Stolloss"}, {"language": "es", "name": "Aggron"}, {"language": "it", "name": "Aggron"}, {"language": "ja", "name": "ボスゴドラ"}, {"language": "zh-hans", "name": "波士可多拉"}, {"language": "es-419", "name": "Aggron"}], "pokedex_entries": [{"versions": ["ruby"], "text": "AGGRON claims an entire mountain as its own territory. It mercilessly beats up anything that violates its environment. This POKéMON vigilantly patrols its territory at all times."}, {"versions": ["sapphire"], "text": "AGGRON is surprisingly protective of its environment. If its mountain is ravaged by a landslide or a fire, this POKéMON will haul topsoil to the area, plant trees, and beautifully restore its own territory."}, {"versions": ["emerald"], "text": "Its iron horns grow longer a little at a time. They are used to determine the AGGRON’s age. The gouges in its armor are worn with pride as mementos from battles."}, {"versions": ["firered", "leafgreen"], "text": "It claims a large mountain as its sole territory. It mercilessly thrashes those that violate its space."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "While seeking iron for food, it digs tunnels by breaking through bedrock with its steel horns."}, {"versions": ["heartgold", "soulsilver"], "text": "You can tell its age by the length of its iron horns. It claims an entire mountain as its territory."}, {"versions": ["black-2", "white-2", "x"], "text": "It claims an entire mountain as its own. The more wounds it has, the more it has battled, so don’t take it lightly."}, {"versions": ["omega-ruby"], "text": "Aggron claims an entire mountain as its own territory. It mercilessly beats up anything that violates its environment. This Pokémon vigilantly patrols its territory at all times."}, {"versions": ["alpha-sapphire"], "text": "Aggron is protective of its environment. If its mountain is ravaged by a landslide or a fire, this Pokémon will haul topsoil to the area, plant trees, and beautifully restore its own territory."}, {"versions": ["sword"], "text": "Aggron has a horn sharp enough to perforate thick iron sheets. It brings down its opponents by ramming into them horn first."}, {"versions": ["shield"], "text": "Long ago, there was a king who wore a helmet meant to resemble the head of an Aggron. He was trying to channel the Pokémon’s strength."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/306.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/306.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/306.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/306.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/306.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/306.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/306.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/vers