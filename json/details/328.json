{"height": 7, "weight": 150, "base_experience": 58, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Ant Pit Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["bug", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ナックラー"}, {"language": "ja-roma", "name": "Nuckrar"}, {"language": "ko", "name": "톱치"}, {"language": "zh-hant", "name": "大顎蟻"}, {"language": "fr", "name": "Kraknoix"}, {"language": "de", "name": "Knacklion"}, {"language": "es", "name": "Trapinch"}, {"language": "it", "name": "Trapinch"}, {"language": "ja", "name": "ナックラー"}, {"language": "zh-hans", "name": "大颚蚁"}, {"language": "es-419", "name": "Trapinch"}], "pokedex_entries": [{"versions": ["ruby"], "text": "TRAPINCH’s nest is a sloped, bowl-like pit dug in sand. This POKéMON patiently waits for prey to tumble down the pit. Its giant jaws have enough strength to crush even boulders."}, {"versions": ["sapphire"], "text": "TRAPINCH is a patient hunter. It digs an inescapable pit in a desert and waits for its prey to come tumbling down. This POKéMON can go a whole week without access to any water."}, {"versions": ["emerald"], "text": "Its big jaws crunch through boulders. Because its head is so big, it has a hard time getting back upright if it tips over onto its back."}, {"versions": ["firered", "leafgreen", "x"], "text": "It lives in arid deserts. It makes a sloping pit trap in sand where it patiently awaits prey."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It makes a conical pit in desert sand and lies in wait at the bottom for prey to come tumbling down."}, {"versions": ["heartgold", "soulsilver", "sword"], "text": "Its nest is a sloped, bowl-like pit in the desert. Once something has fallen in, there is no escape."}, {"versions": ["black-2", "white-2", "y", "shield"], "text": "It makes an inescapable conical pit and lies in wait at the bottom for prey to come tumbling down."}, {"versions": ["omega-ruby"], "text": "Trapinch’s nest is a sloped, bowl-like pit dug in sand. This Pokémon patiently waits for prey to tumble down the pit. Its giant jaws have enough strength to crush even boulders."}, {"versions": ["alpha-sapphire"], "text": "Trapinch is a patient hunter. It digs an inescapable pit in a desert and waits for its prey to come tumbling down. This Pokémon can go a whole week without access to any water."}, {"versions": ["sun"], "text": "It can live for a week without eating a thing. It waits patiently at the bottom of its nest for prey to appear."}, {"versions": ["moon"], "text": "As it digs through the sand, its giant jaws crush any rocks that obstruct its path. It builds a funnel-shaped nest."}, {"versions": ["ultra-sun"], "text": "Its jaws are strong enough to crush rocks but so heavy that it can’t get up if it flips over. Sandile seize those moments as their chance."}, {"versions": ["ultra-moon"], "text": "It builds nests that double as traps, lying in wait for its prey to get caught. When night falls, it digs itself a spot beneath the sand to sleep."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/328.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/328.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/328.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/328.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/328.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/3