{"height": 9, "weight": 273, "base_experience": 177, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Big Boss Pokémon", "capture_rate": 30, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドンカラス"}, {"language": "ja-roma", "name": "Dongkarasu"}, {"language": "ko", "name": "돈크로우"}, {"language": "zh-hant", "name": "烏鴉頭頭"}, {"language": "fr", "name": "Corboss"}, {"language": "de", "name": "Kramshef"}, {"language": "es", "name": "Honchkrow"}, {"language": "it", "name": "Honchkrow"}, {"language": "ja", "name": "ドンカラス"}, {"language": "zh-hans", "name": "乌鸦头头"}, {"language": "es-419", "name": "Honchkrow"}], "pokedex_entries": [{"versions": ["diamond"], "text": "Becoming active at night, it is known to swarm with numerous MURKROW in tow."}, {"versions": ["pearl"], "text": "It makes its MURKROW cronies bring it food. It idles its time away, grooming itself in its nest."}, {"versions": ["platinum"], "text": "If one utters a deep cry, many MURKROW gather quickly. For this, it is called “Summoner of Night.”"}, {"versions": ["heartgold", "soulsilver"], "text": "It is merciless by nature. It is said that it never forgives the mistakes of its MURKROW followers."}, {"versions": ["black", "white", "black-2", "white-2", "x", "omega-ruby"], "text": "If one utters a deep cry, many Murkrow gather quickly. For this, it is called “Summoner of Night.”"}, {"versions": ["y", "alpha-sapphire"], "text": "Becoming active at night, it is known to swarm with numerous Murkrow in tow."}, {"versions": ["sun"], "text": "A single cry from this nocturnal Pokémon, and more than a hundred of its Murkrow cronies will assemble."}, {"versions": ["moon"], "text": "If its Murkrow cronies fail to catch food for it, or if it feels they have betrayed it, it will hunt them down wherever they are and punish them."}, {"versions": ["ultra-sun"], "text": "It will absolutely not forgive failure from or betrayal by its goons. It has no choice in this if it wants to maintain the order of the flock."}, {"versions": ["ultra-moon"], "text": "Its goons take care of most of the fighting for it. The only time it dirties its own hands is in delivering a final blow to finish off an opponent."}, {"versions": ["legends-arceus"], "text": "One cry from this Pokémon, and a murder of Murkrow come flying. At such times, one would think the curtain of night had fallen, plunging the world into jet-black darkness."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/430.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/430.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/430.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/430.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/430.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/430.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/430.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/430.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/430.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/ma