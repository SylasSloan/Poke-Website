{"height": 10, "weight": 350, "base_experience": 87, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Vine Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "モンジャラ"}, {"language": "ja-roma", "name": "Monjara"}, {"language": "ko", "name": "덩쿠리"}, {"language": "zh-hant", "name": "蔓藤怪"}, {"language": "fr", "name": "Saquedeneu"}, {"language": "de", "name": "Tangela"}, {"language": "es", "name": "Tangela"}, {"language": "it", "name": "Tangela"}, {"language": "ja", "name": "モンジャラ"}, {"language": "zh-hans", "name": "蔓藤怪"}, {"language": "es-419", "name": "Tangela"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The whole body is swathed with wide vines that are similar to sea­ weed. Its vines shake as it walks."}, {"versions": ["yellow"], "text": "Its identity is obscured by masses of thick, blue vines. The vines are said to never stop growing."}, {"versions": ["gold"], "text": "The vines that cloak its entire body are always jiggling. They effectively un­ nerve its foes."}, {"versions": ["silver", "soulsilver", "y"], "text": "It tangles any moving thing with its vines. Their subtle shaking is ticklish if you get ensnared."}, {"versions": ["crystal"], "text": "During battle, it constantly moves the vines that cover its body in order to annoy its opponent."}, {"versions": ["ruby", "sapphire"], "text": "TANGELA’s vines snap off easily if they are grabbed. This happens without pain, allowing it to make a quick getaway. The lost vines are replaced by newly grown vines the very next day."}, {"versions": ["emerald"], "text": "Its vines snap off easily and painlessly if they are grabbed, allowing it to make a quick getaway. The lost vines are replaced by new growth the very next day."}, {"versions": ["firered"], "text": "Blue plant vines cloak the POKéMON’s identity in a tangled mass. It entangles anything that gets close."}, {"versions": ["leafgreen"], "text": "The whole body is swathed with wide vines that are similar to seaweed. The vines sway as it walks."}, {"versions": ["diamond", "pearl"], "text": "It is shrouded by blue vines. No one has seen the face hidden behind this growth of vines."}, {"versions": ["platinum", "black", "white"], "text": "The blue vines shrouding its body are covered in a growth of fine hair. It is known to be ticklish."}, {"versions": ["heartgold"], "text": "The vines that cloak its entire body are always jiggling. They effectively unnerve its foes."}, {"versions": ["black-2", "white-2", "x"], "text": "Many writhing vines cover it, so its true identity remains unknown. The blue vines grow its whole life long."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Tangela’s vines snap off easily if they are grabbed. This happens without pain, allowing it to make a quick getaway. The lost vines are replaced by newly grown vines the very next day."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its identity is obscured by masses of thick blue vines. The vines are said to never stop growing."}, {"versions": ["sword"], "text": "Hidden beneath a tangle of vines that grows nonstop even if the vines are torn off, this Pokémon’s true appearance remains a mystery."}, {"versions": ["shield"], "text": "The vines of a Tangela have a distinct scent. In some parts of Galar, Tangela vines are used as herbs."}, {"versions": ["legends-arceus"], "text": "It is cloaked entirely in blue vines, preventing any glimpse of its true identity. The vines impart a refreshing sensation when chewed—they're useful as a spice."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/114.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/114.png", "shiny": null}}, "generat