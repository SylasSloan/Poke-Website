{"height": 12, "weight": 1258, "base_experience": 163, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Bagworm Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "フォレトス"}, {"language": "ja-roma", "name": "Foretos"}, {"language": "ko", "name": "쏘콘"}, {"language": "zh-hant", "name": "佛烈托斯"}, {"language": "fr", "name": "Foretress"}, {"language": "de", "name": "Forstellka"}, {"language": "es", "name": "Forretress"}, {"language": "it", "name": "Forretress"}, {"language": "ja", "name": "フォレトス"}, {"language": "zh-hans", "name": "佛烈托斯"}, {"language": "es-419", "name": "Forretress"}], "pokedex_entries": [{"versions": ["gold"], "text": "Its entire body is shielded by a steel-hard shell. What lurks inside the armor is a total mystery."}, {"versions": ["silver"], "text": "It remains immova­ bly rooted to its tree. It scatters pieces of its hard shell to drive its enemies away."}, {"versions": ["crystal"], "text": "Usually found hanging on to a fat tree trunk. It shoots out bits of its shell when it sees action."}, {"versions": ["ruby", "sapphire"], "text": "FORRETRESS conceals itself inside its hardened steel shell. The shell is opened when the POKéMON is catching prey, but it does so at such a quick pace that the shell’s inside cannot be seen."}, {"versions": ["emerald"], "text": "It keeps itself inside its steel shell. The shell is opened when it is catching prey, but it is so quick that the shell’s inside cannot be seen."}, {"versions": ["firered", "soulsilver", "y"], "text": "It remains immovably rooted to its tree. It scatters pieces of its hard shell to drive its enemies away."}, {"versions": ["leafgreen"], "text": "Its entire body is shielded by a steel- hard shell. What lurks inside the armor is a total mystery."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It is encased in a 