{"height": 3, "weight": 29, "base_experience": 39, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Worm Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キャタピー"}, {"language": "ja-roma", "name": "Caterpie"}, {"language": "ko", "name": "캐터피"}, {"language": "zh-hant", "name": "綠毛蟲"}, {"language": "fr", "name": "Chenipan"}, {"language": "de", "name": "Raupy"}, {"language": "es", "name": "Caterpie"}, {"language": "it", "name": "Caterpie"}, {"language": "ja", "name": "キャタピー"}, {"language": "zh-hans", "name": "绿毛虫"}, {"language": "es-419", "name": "Caterpie"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "shield"], "text": "Its short feet are tipped with suction pads that enable it to tirelessly climb slopes and walls."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "If you touch the feeler on top of its head, it will release a horrible stink to protect itself."}, {"versions": ["gold"], "text": "For protection, it releases a horri­ ble stench from the antenna on its head to drive away enemies."}, {"versions": ["silver", "soulsilver", "y"], "text": "Its feet have suction cups designed to stick to any surface. It tenaciously climbs trees to forage."}, {"versions": ["crystal"], "text": "It crawls into foliage where it camouflages itself among leaves that are the same color as its body."}, {"versions": ["ruby", "sapphire"], "text": "CATERPIE has a voracious appetite. It can devour leaves bigger than its body right before your eyes. From its antenna, this POKéMON releases a terrifically strong odor."}, {"versions": ["emerald"], "text": "Its voracious appetite compels it to devour leaves bigger than itself without hesitation. It releases a terribly strong odor from its antennae."}, {"versions": ["firered"], "text": "It is covered with a green skin. When it grows, it sheds the skin, covers itself with silk, and becomes a cocoon."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It releases a stench from its red antenna to repel enemies. It grows by molting repeatedly."}, {"versions": ["heartgold", "x"], "text": "For protection, it releases a horrible stench from the antennae on its head to drive away enemies."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Caterpie has a voracious appetite. It can devour leaves bigger than its body right before your eyes. From its antenna, this Pokémon releases a terrifically strong odor."}, {"versions": ["sun"], "text": "When attacked by bird Pokémon, it resists by releasing a terrifically strong odor from its antennae, but it often becomes their prey."}, {"versions": ["moon"], "text": "It’s easy to catch, and it grows quickly, making it one of the top recommendations for novice Pokémon Trainers."}, {"versions": ["ultra-sun"], "text": "Perhaps because it would like to grow up quickly, it has a voracious appetite, eating a hundred leaves a day."}, {"versions": ["ultra-moon"], "text": "Its body is soft and weak. In nature, its perpetual fate is to be seen by others as food."}, {"versions": ["sword"], "text": "For protection, it releases a horrible stench from the antenna on its head to drive away enemies."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/10.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/10.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/10.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/10.png"}, "gold": {"normal": "https://raw.githubusercontent.com