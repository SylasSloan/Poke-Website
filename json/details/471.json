{"height": 8, "weight": 259, "base_experience": 184, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Fresh Snow Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "グレイシア"}, {"language": "ja-roma", "name": "Glacia"}, {"language": "ko", "name": "글레이시아"}, {"language": "zh-hant", "name": "冰伊布"}, {"language": "fr", "name": "Givrali"}, {"language": "de", "name": "Glaziola"}, {"language": "es", "name": "Glaceon"}, {"language": "it", "name": "Glaceon"}, {"language": "ja", "name": "グレイシア"}, {"language": "zh-hans", "name": "冰伊布"}, {"language": "es-419", "name": "Glaceon"}], "pokedex_entries": [{"versions": ["diamond", "pearl"], "text": "As a protective technique, it can completely freeze its fur to make its hairs stand like needles."}, {"versions": ["platinum", "black", "white", "x", "omega-ruby"], "text": "By controlling its body heat, it can freeze the atmosphere around it to make a diamond-dust flurry."}, {"versions": ["heartgold", "soulsilver"], "text": "It causes small ice crystals to form by lowering the temperature of the surrounding atmosphere."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "It lowers its body heat to freeze its fur. The hairs then become like needles it can fire."}, {"versions": ["sun"], "text": "It can control its body temperature at will. This enables it to freeze the moisture in the atmosphere, creating flurries of diamond dust."}, {"versions": ["moon"], "text": "It freezes its fur into icicles, spiky and sharp, and tackles its prey."}, {"versions": ["ultra-sun"], "text": "It protects itself by freezing its fur into sharp needles. It can drop its body temperature below –75 degrees Fahrenheit."}, {"versions": ["ultra-moon"], "text": "It can instantaneously freeze any moisture that’s around it, creating ice pellets to shoot at its prey."}, {"versions": ["sword"], "text": "Any who become captivated by the beauty of the snowfall that Glaceon creates will be frozen before they know it."}, {"versions": ["shield"], "text": "The coldness emanating from Glaceon causes powdery snow to form, making it quite a popular Pokémon at ski resorts."}, {"versions": ["legends-arceus"], "text": "Glaceon is able to lower its body temperature very quickly. It freezes the atmosphere, creating diamond dust that glitters like gems while it flutters and dances around."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/471.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/471.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/471.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/471.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/471.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/471.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/471.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/471.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/471.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/