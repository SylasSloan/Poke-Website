{"height": 7, "weight": 160, "base_experience": 134, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Ember Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヒノヤコマ"}, {"language": "ja-roma", "name": "Hinoyakoma"}, {"language": "ko", "name": "불화살빈"}, {"language": "zh-hant", "name": "火箭雀"}, {"language": "fr", "name": "Braisillon"}, {"language": "de", "name": "Dartignis"}, {"language": "es", "name": "Fletchinder"}, {"language": "it", "name": "Fletchinder"}, {"language": "ja", "name": "ヒノヤコマ"}, {"language": "zh-hans", "name": "火箭雀"}, {"language": "es-419", "name": "Fletchinder"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "From its beak, it expels embers that set the tall grass on fire. Then it pounces on the bewildered prey that pop out of the grass."}, {"versions": ["y", "alpha-sapphire"], "text": "The hotter the flame sac on its belly, the faster it can fly, but it takes some time to get the fire going."}, {"versions": ["sun"], "text": "From its beak, it fires embers at its prey. Once it has caught them, it grills them at high heat before feasting upon them."}, {"versions": ["moon"], "text": "It will not tolerate other Fletchinder entering its territory, which has a radius of several miles."}, {"versions": ["ultra-sun"], "text": "It scatters embers in the tall grass. Then bug Pokémon, frightened by the flames, come flying out, and Fletchinder gobbles them up."}, {"versions": ["ultra-moon"], "text": "Its speed right after takeoff already puts it in the top speed class of all bird Pokémon."}, {"versions": ["sword"], "text": "Fletchinder launches embers into the den of its prey. When the prey comes leaping out, Fletchinder’s sharp talons finish it off."}, {"versions": ["shield"], "text": "Fletchinder are exceedingly territorial and aggressive. These Pokémon fight among themselves over feeding grounds."}], 