{"height": 4, "weight": 5, "base_experience": 50, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Cottonweed Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["fairy", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハネッコ"}, {"language": "ja-roma", "name": "Hanecco"}, {"language": "ko", "name": "통통코"}, {"language": "zh-hant", "name": "毽子草"}, {"language": "fr", "name": "Granivol"}, {"language": "de", "name": "Hoppspross"}, {"language": "es", "name": "Hoppip"}, {"language": "it", "name": "Hoppip"}, {"language": "ja", "name": "ハネッコ"}, {"language": "zh-hans", "name": "毽子草"}, {"language": "es-419", "name": "Hoppip"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "To keep from being blown away by the wind, they gather in clusters. They do enjoy gentle breezes, though."}, {"versions": ["silver", "firered", "soulsilver", "x"], "text": "Its body is so light, it must grip the ground firmly with its feet to keep from being blown away."}, {"versions": ["crystal"], "text": "It can be carried away on even the gentlest breeze. It may even float all the way to the next town."}, {"versions": ["ruby", "sapphire"], "text": "This POKéMON drifts and floats with the wind. If it senses the approach of strong winds, HOPPIP links its leaves with other HOPPIP to prepare against being blown away."}, {"versions": ["emerald"], "text": "This POKéMON drifts and floats with the wind. If it senses the approach of strong winds, a HOPPIP links leaves with others to prepare against being blown away."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It drifts on winds. It is said that when HOPPIP gather in fields and mountains, spring is on the way."}, {"versions": ["heartgold"], "text": "To keep from being blown away by the wind, they gather in clusters. But they do enjoy gentle breezes."}, {"versions": ["black", "white", "black-2", "white-2", "y"], "text": "It drifts on winds. It is said that when Hoppip gather in fields and mountains, spring is on the way."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "This Pokémon drifts and floats with the wind. If it senses the approach of strong winds, Hoppip links its leaves with other Hoppip to prepare against being blown away."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/187.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/187.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/187.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/187.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/187.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/187.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/187.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/187.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/187.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/187.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/187.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generatio