{"height": 5, "weight": 66, "base_experience": 56, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Bulb Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["plant"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "チュリネ"}, {"language": "ja-roma", "name": "Churine"}, {"language": "ko", "name": "치릴리"}, {"language": "zh-hant", "name": "百合根娃娃"}, {"language": "fr", "name": "Chlorobule"}, {"language": "de", "name": "Lilminip"}, {"language": "es", "name": "Petilil"}, {"language": "it", "name": "Petilil"}, {"language": "ja", "name": "チュリネ"}, {"language": "zh-hans", "name": "百合根娃娃"}, {"language": "es-419", "name": "Petilil"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "The leaves on its head are very bitter. Eating one of these leaves is known to refresh a tired body."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "Since they prefer moist, nutrient-rich soil, the areas where Petilil live are known to be good for growing plants."}, {"versions": ["black-2", "white-2"], "text": "The leaves on its head grow right back even if they fall out. These bitter leaves refresh those who eat them."}, {"versions": ["sun"], "text": "Although the leaves on its head are bitter enough to cause dizziness, they provide relief from weariness—even more so when boiled."}, {"versions": ["moon"], "text": "By pruning the leaves on its head with regularity, this Pokémon can be grown into a fine plump shape."}, {"versions": ["ultra-sun"], "text": "Some say if you dry the leaves on its head, boil them down, and drink the infusion, your vigor will return, so Petilil is popular with the elderly."}, {"versions": ["ultra-moon"], "text": "They prefer clean water and soil. When the environment they live in turns bad, the whole bunch will up and move to a new area."}, {"versions": ["sword"], "text": "Petilil appears around sources of clean water. Boiling leaves from this Pokémon’s head results in a liquid that’s sometimes used as a bug repellent."}, {"versions": ["shield"], "text": "The deeper the color of a Petilil’s leaves, the healthier the Pokémon is. Petilil sometimes makes its home in a well-tended field or flowerbed."}, {"versions": ["legends-arceus"], "text": "The leaves on its head are highly valued for medicinal purposes. Dry the leaves in the sun, boil them, and then drink the bitter decoction for remarkably effective relief from fatigue."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/548.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/548.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/548.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/548.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/548.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/548.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/548.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/548.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/548.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/gen