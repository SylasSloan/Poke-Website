{"height": 10, "weight": 450, "base_experience": 149, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Bone Keeper Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ガラガラ"}, {"language": "ja-roma", "name": "Garagara"}, {"language": "ko", "name": "텅구리"}, {"language": "zh-hant", "name": "嘎啦嘎啦"}, {"language": "fr", "name": "Ossatueur"}, {"language": "de", "name": "Knogga"}, {"language": "es", "name": "Marowak"}, {"language": "it", "name": "Marowak"}, {"language": "ja", "name": "ガラガラ"}, {"language": "zh-hans", "name": "嘎啦嘎啦"}, {"language": "es-419", "name": "Marowak"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "y"], "text": "The bone it holds is its key weapon. It throws the bone skillfully like a boomerang to KO targets."}, {"versions": ["yellow"], "text": "Small and weak, this POKéMON is adept with its bone club. It has grown more vicious over the ages."}, {"versions": ["gold"], "text": "It has been seen pounding boulders with the bone it carries in order to tap out mes­ sages to others."}, {"versions": ["silver"], "text": "It collects bones from an unknown place. A MAROWAK graveyard exists somewhere in the world, rumors say."}, {"versions": ["crystal"], "text": "Somewhere in the world is a ceme­ tery just for MAROWAK. It gets its bones from those graves."}, {"versions": ["ruby", "sapphire"], "text": "MAROWAK is the evolved form of a CUBONE that has overcome its sadness at the loss of its mother and grown tough. This POKéMON’s tempered and hardened spirit is not easily broken."}, {"versions": ["emerald"], "text": "A MAROWAK is the evolved form of a CUBONE that has grown tough by overcoming the grief of losing its mother. Its tempered and hardened spirit is not easily broken."}, {"versions": ["firered", "x"], "text": "It is small and was originally very weak. Its temperament turned ferocious when it began using bones."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "From its birth, this savage Pokémon constantly holds bones. It is skilled in using them as weapons."}, {"versions": ["heartgold"], "text": "It has been seen pounding boulders with the bone it carries in order to tap out messages to others."}, {"versions": ["soulsilver"], "text": "It collects bones from an unknown place. Some whisper that a MAROWAK graveyard exists somewhere in the world."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Marowak is the evolved form of a Cubone that has overcome its sadness at the loss of its mother and grown tough. This Pokémon’s tempered and hardened spirit is not easily broken."}, {"versions": ["sun"], "text": "Originally, it was weak and timid. After evolution, its temperament becomes violent, and it begins to wield bones as weapons."}, {"versions": ["moon"], "text": "This Pokémon is out for vengeance on its natural enemy, Mandibuzz. It throws bones like boomerangs to try to take it down."}, {"versions": ["ultra-sun"], "text": "It throws bones at Mandibuzz to knock it down. It’s thought that Marowak is trying to avenge its parent."}, {"versions": ["ultra-moon"], "text": "They thump their bones rhythmically to communicate among themselves. There are nearly 50 different rhythmic patterns."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Small and weak, this Pokémon is adept with its bone club. It has grown more vicious over the ages."}, {"versions": ["sword"], "text": "This Pokémon overcame its sorrow to evolve a sturdy new body. Marowak faces its opponents bravely, using a bone as a weapon."}, {"versions": ["shield"], "text": "When this Pokémon evolved, the skull of its mother fused to it. Marowak’s temperament also turned vicious at the same time."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generatio