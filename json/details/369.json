{"height": 10, "weight": 234, "base_experience": 170, "ev_yield": [{"stat": "hp", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Longevity Pokémon", "capture_rate": 25, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["water1", "water2"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ジーランス"}, {"language": "ja-roma", "name": "Glanth"}, {"language": "ko", "name": "시라칸"}, {"language": "zh-hant", "name": "古空棘魚"}, {"language": "fr", "name": "Relicanth"}, {"language": "de", "name": "Relicanth"}, {"language": "es", "name": "Relicanth"}, {"language": "it", "name": "Relicanth"}, {"language": "ja", "name": "ジーランス"}, {"language": "zh-hans", "name": "古空棘鱼"}, {"language": "es-419", "name": "Relicanth"}], "pokedex_entries": [{"versions": ["ruby"], "text": "RELICANTH is a POKéMON species that existed for a hundred million years without ever changing its form. This ancient POKéMON feeds on microscopic organisms with its toothless mouth."}, {"versions": ["sapphire"], "text": "RELICANTH is a rare species that was discovered in deep-sea explorations. This POKéMON’s body withstands the enormous water pressure of the ocean depths. Its body is covered in tough scales that are like craggy rocks."}, {"versions": ["emerald"], "text": "A POKéMON that was once believed to have been extinct. The species has not changed its form for 100 million years. It walks on the seafloor using its pectoral fins."}, {"versions": ["firered", "leafgreen", "x"], "text": "It has remained unchanged for 100 million years. It was discovered during a deep-sea exploration."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "A rare Pokémon discovered during a deep-sea exploration. It has not changed in over 100 million years."}, {"versions": ["heartgold", "soulsilver"], "text": "Discovered by chance during deep-sea explorations, it has not changed since ancient times."}, {"versions": ["omega-ruby"], "text": "Relicanth is a Pokémon species that existed for a hundred million years without ever changing its form. This ancient Pokémon feeds on microscopic organisms with its toothless mouth."}, {"versions": ["alpha-sapphire"], "text": "Relicanth is a rare species that was discovered in deep-sea explorations. This Pokémon’s body withstands the enormous water pressure of the ocean depths. Its body is covered in tough scales that are like craggy rocks."}, {"versions": ["sun"], "text": "Its form has remained the same for one hundred million years. Its body is filled with fat, so it can withstand the water pressure of the deep sea."}, {"versions": ["moon"], "text": "It was fortuitously discovered during a deep sea expedition. Its teeth have atrophied, so it now survives on microscopic organisms it sucks up."}, {"versions": ["ultra-sun"], "text": "Thought to have gone extinct, Relicanth was given a name that is a variation of the name of the person who discovered it."}, {"versions": ["ultra-moon"], "text": "The reason it hasn’t changed at all in a hundred million years is that it’s apparently already a perfect life-form."}, {"versions": ["sword"], "text": "Rock-hard scales and oil-filled swim bladders allow this Pokémon to survive the intense water pressure of the deep sea."}, {"versions": ["shield"], "text": "This Pokémon was discovered during deep-sea exploration. Its appearance hasn’t changed in 100,000,000 years, so it’s called a living fossil."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/369.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/369.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/369.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemo