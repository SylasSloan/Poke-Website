{"height": 18, "weight": 1180, "base_experience": 175, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Pincer Pokémon", "capture_rate": 25, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハッサム"}, {"language": "ja-roma", "name": "Hassam"}, {"language": "ko", "name": "핫삼"}, {"language": "zh-hant", "name": "巨鉗螳螂"}, {"language": "fr", "name": "Cizayox"}, {"language": "de", "name": "Scherox"}, {"language": "es", "name": "Scizor"}, {"language": "it", "name": "Scizor"}, {"language": "ja", "name": "ハッサム"}, {"language": "zh-hans", "name": "巨钳螳螂"}, {"language": "es-419", "name": "Scizor"}], "pokedex_entries": [{"versions": ["gold"], "text": "It swings its eye- patterned pincers up to scare its foes. This makes it look like it has three heads."}, {"versions": ["silver", "firered", "soulsilver"], "text": "Its wings are not used for flying. They are flapped at high speed to adjust its body temperature."}, {"versions": ["crystal"], "text": "This POKéMON's pincers, which contain steel, can crush any hard object it gets a hold of into bits."}, {"versions": ["ruby", "sapphire"], "text": "SCIZOR has a body with the hardness of steel. It is not easily fazed by ordinary sorts of attacks. This POKéMON flaps its wings to regulate its body temperature."}, {"versions": ["emerald"], "text": "A SCIZOR has a body with the hardness of steel. It is not easily fazed by ordinary sorts of attacks. It flaps its wings to regulate its body temperature."}, {"versions": ["leafgreen", "heartgold"], "text": "It swings its eye-patterned pincers up to scare its foes. This makes it look like it has three heads."}, {"versions": ["diamond", "pearl", "y"], "text": "It has a steel-hard body. It intimidates foes by upraising its eye-patterned pincers."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It raises its pincers with eyelike markings for intimidation. It also swings them down dangerously."}, {"versions": ["x"], "text": "This Pokémon’s pincers, which contain steel, can crush any hard object it gets ahold of into bits."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Scizor has a body with the hardness of steel. It is not easily fazed by ordinary sorts of attacks. This Pokémon flaps its wings to regulate its body temperature."}, {"versions": ["sun"], "text": "It uses its wings to adjust its body temperature. Otherwise, its metal body would become too hot and melt in the heat of battle."}, {"versions": ["moon"], "text": "Once it has identified an enemy, this Pokémon smashes it mercilessly with pincers hard as steel."}, {"versions": ["ultra-sun"], "text": "Its body is like steel. Its tough, heavy pincers are more suited to smashing enemies than grabbing them."}, {"versions": ["ultra-moon"], "text": "Once it has identified something as an enemy, it will continue beating them with its steel-hard pincers until there’s nothing left but scraps."}, {"versions": ["sword"], "text": "Bulky pincers account for one third of Scizor’s body weight. A single swing of one of these pincers will crush a boulder completely."}, {"versions": ["shield"], "text": "Though its body is slim, Scizor has tremendous attacking power. Even Scizor’s muscles are made of metal."}, {"versions": ["legends-arceus"], "text": "Evolved by way of a curious item. The shell covering its body has been shown to be stronger than forged steel."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/212.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/212.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/212.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions