{"height": 13, "weight": 1495, "base_experience": 173, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Shield Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["monster"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "トリデプス"}, {"language": "ja-roma", "name": "Torideps"}, {"language": "ko", "name": "바리톱스"}, {"language": "zh-hant", "name": "護城龍"}, {"language": "fr", "name": "Bastiodon"}, {"language": "de", "name": "Bollterus"}, {"language": "es", "name": "Bastiodon"}, {"language": "it", "name": "Bastiodon"}, {"language": "ja", "name": "トリデプス"}, {"language": "zh-hans", "name": "护城龙"}, {"language": "es-419", "name": "Bastiodon"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "Any frontal attack is repulsed. It is a docile Pokémon that feeds on grass and berries."}, {"versions": ["pearl"], "text": "When attacked, they form a wall with their shieldlike faces to protect their young."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x", "omega-ruby"], "text": "When they lined up side by side, no foe could break through. They shielded their young in that way."}, {"versions": ["heartgold", "soulsilver"], "text": "When attacked, they form a wall. Their rock-hard faces serve to protect them from the attacks."}, {"versions": ["sun"], "text": "While it can guard against any sort of attack from the front, it is left without recourse when attacked from behind."}, {"versions": ["moon"], "text": "It lived in the same environments as Rampardos. Their fossils have been found together— seemingly from after they’d fought to the finish."}, {"versions": ["ultra-sun"], "text": "The bones of its face are huge and hard, so they were mistaken for its spine until after this Pokémon was successfully restored."}, {"versions": ["ultra-moon"], "text": "This Pokémon is from roughly 100 million years ago. Its terrifyingly tough face is harder than steel."}, {"versions": ["legends-arceus"], "text": "Its face is sturdy—as strong as diamond—and this hardness offers a very stable defense. Much about this species is still unknown, such as its natural habitat."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/411.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/411.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/411.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/411.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/411.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/411.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/411.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/411.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/411.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/411.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/411.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/m