{"height": 11, "weight": 328, "base_experience": 164, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Rogue Pokémon", "capture_rate": 155, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "fast-then-very-slow", "egg_groups": ["water1", "water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "シザリガー"}, {"language": "ja-roma", "name": "Shizariger"}, {"language": "ko", "name": "가재장군"}, {"language": "zh-hant", "name": "鐵螯龍蝦"}, {"language": "fr", "name": "Colhomard"}, {"language": "de", "name": "Krebutack"}, {"language": "es", "name": "Crawdaunt"}, {"language": "it", "name": "Crawdaunt"}, {"language": "ja", "name": "シザリガー"}, {"language": "zh-hans", "name": "铁螯龙虾"}, {"language": "es-419", "name": "Crawdaunt"}], "pokedex_entries": [{"versions": ["ruby"], "text": "CRAWDAUNT has an extremely violent nature that compels it to challenge other living things to battle. Other life-forms refuse to live in ponds inhabited by this POKéMON, making them desolate places."}, {"versions": ["sapphire"], "text": "CRAWDAUNT molts (sheds) its shell regularly. Immediately after molting, its shell is soft and tender. Until the shell hardens, this POKéMON hides in its streambed burrow to avoid attack from its foes."}, {"versions": ["emerald"], "text": "A brutish POKéMON that loves to battle. A veteran CRAWDAUNT that has prevailed in hundreds of battles has giant pincers marked with countless scars."}, {"versions": ["firered", "leafgreen", "sword"], "text": "A rough customer that wildly flails its giant claws. It is said to be extremely hard to raise."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "It is a ruffian that uses its pincers to pick up and toss out other Pokémon from its pond."}, {"versions": ["heartgold", "soulsilver", "shield"], "text": "A brutish Pokémon that loves to battle. It will crash itself into any foe that approaches its nest."}, {"versions": ["black-2", "white-2", "y"], "text": "Loving to battle, this Pokémon pinches all Pokémon that enter its territory with its pincers and throws them out."}, {"versions": ["omega-ruby"], "text": "Crawdaunt has an extremely violent nature that compels it to challenge other living things to battle. Other life-forms refuse to live in ponds inhabited by this Pokémon, making them desolate places."}, {"versions": ["alpha-sapphire"], "text": "Crawdaunt molts (sheds) its shell regularly. Immediately after molting, its shell is soft and tender. Until the shell hardens, this Pokémon hides in its streambed burrow to avoid attack from its foes."}, {"versions": ["ultra-sun"], "text": "Its temperament is rough and it loves to fight, but as soon as its pincers break off, it turns cowardly. It stays timid until they grow back."}, {"versions": ["ultra-moon"], "text": "Its pincers often fall off. Unlike with Crabrawler or Clauncher, the meat in its claws is utterly nasty and stinking."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/342.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/342.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/342.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/342.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/342.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/342.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/342.png", "shiny": "https://raw