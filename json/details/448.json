{"height": 12, "weight": 540, "base_experience": 184, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "special-attack", "value": 1}], "genus": "Aura Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium-slow", "egg_groups": ["ground", "humanshape"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ルカリオ"}, {"language": "ja-roma", "name": "Lucario"}, {"language": "ko", "name": "루카리오"}, {"language": "zh-hant", "name": "路卡利歐"}, {"language": "fr", "name": "Lucario"}, {"language": "de", "name": "Lucario"}, {"language": "es", "name": "Lucario"}, {"language": "it", "name": "Lucario"}, {"language": "ja", "name": "ルカリオ"}, {"language": "zh-hans", "name": "路卡利欧"}, {"language": "es-419", "name": "Lucario"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It has the ability to sense the auras of all things. It understands human speech."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "By catching the aura emanating from others, it can read their thoughts and movements."}, {"versions": ["platinum", "black", "white"], "text": "A well-trained one can sense auras to identify and take in the feelings of creatures over half a mile away."}, {"versions": ["heartgold", "soulsilver"], "text": "It’s said that no foe can remain invisible to LUCARIO, since it can detect auras. Even foes it could not otherwise see."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "By reading the auras of all things, it can tell how others are feeling from over half a mile away."}, {"versions": ["sun"], "text": "Not only does it perceive auras, but it has also gained the power to control them. It employs them in battle."}, {"versions": ["moon"], "text": "They can detect the species of a living being— and its emotions—from over half a mile away. They control auras and hunt their prey in packs."}, {"versions": ["ultra-sun"], "text": "It concentrates its mental energy and fires off mysterious waves called auras, which can crush boulders of large size to dust."}, {"versions": ["ultra-moon"], "text": "Lucario reads its opponent’s feelings with its aura waves. It finds out things it would rather not know, so it gets stressed out easily."}, {"versions": ["sword"], "text": "It controls waves known as auras, which are powerful enough to pulverize huge rocks. It uses these waves to take down its prey."}, {"versions": ["shield"], "text": "It can tell what people are thinking. Only Trainers who have justice in their hearts can earn this Pokémon’s trust."}, {"versions": ["legends-arceus"], "text": "A most gallant-looking creature. It emits energy waves and controls them with precision, using them to sense even faraway beings. I have given the name ”aura” to this power."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/448.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/448.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/448.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/448.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/448.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/448.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/448.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/448