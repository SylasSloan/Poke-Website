{"height": 6, "weight": 120, "base_experience": 60, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Jet Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "テッポウオ"}, {"language": "ja-roma", "name": "Teppouo"}, {"language": "ko", "name": "총어"}, {"language": "zh-hant", "name": "鐵炮魚"}, {"language": "fr", "name": "Rémoraid"}, {"language": "de", "name": "Remoraid"}, {"language": "es", "name": "Remoraid"}, {"language": "it", "name": "Remoraid"}, {"language": "ja", "name": "テッポウオ"}, {"language": "zh-hans", "name": "铁炮鱼"}, {"language": "es-419", "name": "Remoraid"}], "pokedex_entries": [{"versions": ["gold"], "text": "It has superb ac­ curacy. The water it shoots out can strike even moving prey from more than 300 feet."}, {"versions": ["silver"], "text": "Using its dorsal fin as a suction pad, it clings to a MANTINE's under­ side to scavenge for leftovers."}, {"versions": ["crystal"], "text": "To escape from an attacker, it may shoot water out of its mouth, then use that force to swim backward."}, {"versions": ["ruby", "sapphire"], "text": "REMORAID sucks in water, then expels it at high velocity using its abdominal muscles to shoot down flying prey. When evolution draws near, this POKéMON travels downstream from rivers."}, {"versions": ["emerald"], "text": "A REMORAID uses its abdominal muscles to forcefully expel swallowed water, then shoot down flying prey. When evolution approaches, it travels down rivers."}, {"versions": ["firered", "soulsilver"], "text": "Using its dorsal fin as a suction pad, it clings to a MANTINE’s underside to scavenge for leftovers."}, {"versions": ["leafgreen"], "text": "It has superb accuracy. The water it shoots out can strike even moving prey from more than 100 yards."}, {"versions": ["diamond"], "text": "It squirts water forcefully from its mouth to shoot down flying prey."}, {"versions": ["pearl"], "text": "It clings to MANTINE to feed on the big Pokémon’s scraps. This is an adaptation to avoid foes."}, {"versions": ["platinum"], "text": "It forcefully squirts water. The water jet never misses prey even if the REMORAID is deep in the sea."}, {"versions": ["heartgold", "x"], "text": "It has superb accuracy. The water it shoots out can strike moving prey from more than 300 feet away."}, {"versions": ["black", "white"], "text": "It forcefully squirts water. The water jet never misses prey even if the Remoraid is deep in the sea."}, {"versions": ["black-2", "white-2", "sword"], "text": "The water they shoot from their mouths can hit moving prey from more than 300 feet away."}, {"versions": ["y", "shield"], "text": "Using its dorsal fin as a suction pad, it clings to a Mantine’s underside to scavenge for leftovers."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Remoraid sucks in water, then expels it at high velocity using its abdominal muscles to shoot down flying prey. When evolution draws near, this Pokémon travels downstream from rivers."}, {"versions": ["ultra-sun"], "text": "This Pokémon clings to Mantine and shares in its prosperity. When its Mantine is attacked, Remoraid will fight alongside it!"}, {"versions": ["ultra-moon"], "text": "Also known as the “sniper of the seas,” its water gun can hit prey without fail from over 300 feet away."}, {"versions": ["legends-arceus"], "text": "Spits water from its mouth with incredible accuracy. It captures Burmy by shooting them down off the branches from which they dangle."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/223.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/223.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii