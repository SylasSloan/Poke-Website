{"height": 13, "weight": 1, "base_experience": 62, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Gas Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴース"}, {"language": "ja-roma", "name": "Ghos"}, {"language": "ko", "name": "고오스"}, {"language": "zh-hant", "name": "鬼斯"}, {"language": "fr", "name": "Fantominus"}, {"language": "de", "name": "Nebulak"}, {"language": "es", "name": "Gastly"}, {"language": "it", "name": "Gastly"}, {"language": "ja", "name": "ゴース"}, {"language": "zh-hans", "name": "鬼斯"}, {"language": "es-419", "name": "Gastly"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Almost invisible, this gaseous POKéMON cloaks the target and puts it to sleep without notice."}, {"versions": ["yellow"], "text": "Said to appear in decrepit, deserted buildings. It has no real shape as it appears to be made of a gas."}, {"versions": ["gold", "heartgold", "shield"], "text": "With its gas-like body, it can sneak into any place it desires. However, it can be blown away by wind."}, {"versions": ["silver"], "text": "Its thin body is made of gas. It can envelop an opponent of any size and cause suffocation."}, {"versions": ["crystal"], "text": "It wraps its op­ ponent in its gas- like body, slowly weakening its prey by poisoning it through the skin."}, {"versions": ["ruby", "sapphire"], "text": "GASTLY is largely composed of gaseous matter. When exposed to a strong wind, the gaseous body quickly dwindles away. Groups of this POKéMON cluster under the eaves of houses to escape the ravages of wind."}, {"versions": ["emerald"], "text": "When exposed to a strong wind, a GASTLY’s gaseous body quickly dwindles away. They cluster under the eaves of houses to escape the ravages of wind."}, {"versions": ["firered"], "text": "A being that exists as a thin gas. It can topple an Indian elephant by enveloping the prey in two seconds."}, {"versions": ["diamond"], "text": "This Pokémon’s body is 95% made up of gases, which are blown away by strong gusts of wind."}, {"versions": ["pearl"], "text": "A Pokémon born from poison gases. It defeats even the largest foes by enveloping them in gas."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y", "sword"], "text": "Born from gases, anyone would faint if engulfed by its gaseous body, which contains poison."}, {"versions": ["soulsilver", "x"], "text": "Its body is made of gas. Despite lacking substance, it can envelop an opponent of any size and cause suffocation."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Gastly is largely composed of gaseous matter. When exposed to a strong wind, the gaseous body quickly dwindles away. Groups of this Pokémon cluster under the eaves of houses to escape the ravages of wind."}, {"versions": ["sun"], "text": "Should a strange light be seen flickering in an abandoned building, Gastly is lurking there."}, {"versions": ["moon"], "text": "Although Gastly is barely visible, when it’s near, a faint sweet smell lingers."}, {"versions": ["ultra-sun"], "text": "It’s said that gas emanating from a graveyard was possessed by the grievances of the deceased and thus became a Pokémon."}, {"versions": ["ultra-moon"], "text": "Poisonous gas comprises 95% of its body. It’s said that the remaining 5% is made up of the souls of those who died from the gas."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Said to appear in decrepit, deserted buildings. It has no real shape, as it appears to be made of a gas."}, {"versions": ["legends-arceus"], "text": "Gaseous and completely impalpable. Also highly dangerous— inhaling part of its poisonous body will cause one to faint instantly."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/92.png", "s