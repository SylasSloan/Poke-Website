{"height": 8, "weight": 133, "base_experience": 128, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Wool Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "モココ"}, {"language": "ja-roma", "name": "Mokoko"}, {"language": "ko", "name": "보송송"}, {"language": "zh-hant", "name": "茸茸羊"}, {"language": "fr", "name": "Lainergie"}, {"language": "de", "name": "Waaty"}, {"language": "es", "name": "Flaaffy"}, {"language": "it", "name": "Flaaffy"}, {"language": "ja", "name": "モココ"}, {"language": "zh-hans", "name": "茸茸羊"}, {"language": "es-419", "name": "Flaaffy"}], "pokedex_entries": [{"versions": ["gold"], "text": "As a result of storing too much electricity, it developed patches where even downy wool won't grow."}, {"versions": ["silver", "firered", "soulsilver", "x"], "text": "Its fluffy fleece easily stores electricity. Its rubbery hide keeps it from being electrocuted."}, {"versions": ["crystal"], "text": "Because of its rubbery, electric­ ity-resistant skin, it can store lots of electric­ ity in its fur."}, {"versions": ["ruby", "sapphire"], "text": "FLAAFFY’s wool quality changes so that it can generate a high amount of static electricity with a small amount of wool. The bare and slick parts of its hide are shielded against electricity."}, {"versions": ["emerald"], "text": "Its fleece quality changes to generate strong static electricity with a small amount of wool. The bare, slick parts of its hide are shielded against electricity."}, {"versions": ["leafgreen", "heartgold"], "text": "As a result of storing too much electricity, it developed patches where even downy wool won’t grow."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "If its coat becomes fully charged with electricity, its tail lights up. It fires hair that zaps on impact."}, {"versions": ["black-2", "white-2"], "text": "Not even downy wool will grow on its rubbery, nonconductive patches of skin that prevent electrical shock."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Flaaffy’s wool quality changes so that it can generate a high amount of static electricity with a small amount of wool. The bare and slick parts of its hide are shielded against electricity."}, {"versions": ["ultra-sun"], "text": "In the places on its body where fleece doesn’t grow, its skin is rubbery and doesn’t conduct electricity. Those spots are safe to touch."}, {"versions": ["ultra-moon"], "text": "It stores electricity in its fluffy fleece. If it stores up too much, it will start to go bald in those patches."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/180.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/180.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/180.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/180.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/180.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/180.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/180.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/180.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/180.png", "shiny": "https://raw.githubuser