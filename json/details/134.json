{"height": 10, "weight": 290, "base_experience": 184, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Bubble Jet Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "シャワーズ"}, {"language": "ja-roma", "name": "Showers"}, {"language": "ko", "name": "샤미드"}, {"language": "zh-hant", "name": "水伊布"}, {"language": "fr", "name": "Aquali"}, {"language": "de", "name": "Aquana"}, {"language": "es", "name": "Vaporeon"}, {"language": "it", "name": "Vaporeon"}, {"language": "ja", "name": "シャワーズ"}, {"language": "zh-hans", "name": "水伊布"}, {"language": "es-419", "name": "Vaporeon"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Lives close to water. Its long tail is ridged with a fin which is often mistaken for a mermaid's."}, {"versions": ["yellow"], "text": "Its cell structure is similar to water molecules. It will melt away and become invis­ ible in water."}, {"versions": ["gold"], "text": "When VAPOREON's fins begin to vi­ brate, it is a sign that rain will come within a few hours."}, {"versions": ["silver"], "text": "It prefers beauti­ ful shores. With cells similar to water molecules, it could melt in water."}, {"versions": ["crystal"], "text": "As it uses the fins on the tip of its tail to swim, it blends with the water perfectly."}, {"versions": ["ruby", "sapphire"], "text": "VAPOREON underwent a spontaneous mutation and grew fins and gills that allow it to live underwater. This POKéMON has the ability to freely control water."}, {"versions": ["emerald"], "text": "VAPOREON underwent a spontaneous mutation and grew fins and gills that allow them to live underwater. They have the ability to freely control water."}, {"versions": ["firered", "shield"], "text": "Its body’s cellular structure is similar to the molecular composition of water. It can melt invisibly in water."}, {"versions": ["leafgreen"], "text": "Lives close to water. Its long tail is ridged with a fin which is often mistaken for a mermaid’s."}, {"versions": ["diamond", "pearl", "y"], "text": "It has evolved to be suitable for an aquatic life. It can invisibly melt away into water."}, {"versions": ["platinum", "black", "white"], "text": "Its cell composition is similar to water molecules. As a result, it can melt away into water."}, {"versions": ["heartgold"], "text": "When VAPOREON’s fins begin to vibrate, it is a sign that rain will come within a few hours."}, {"versions": ["soulsilver", "x"], "text": "It prefers beautiful shores. With cells similar to water molecules, it could melt in water."}, {"versions": ["black-2", "white-2"], "text": "Its cell composition is similar to water molecules. As a result, it can’t be seen when it melts away into water."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Vaporeon underwent a spontaneous mutation and grew fins and gills that allow it to live underwater. This Pokémon has the ability to freely control water."}, {"versions": ["sun"], "text": "Its cells are composed of units much like water molecules. It lives close to water and is often mistaken for a mermaid."}, {"versions": ["moon"], "text": "Blending in with the water and erasing all signs of its presence, it patiently waits for its prey, fish Pokémon."}, {"versions": ["ultra-sun"], "text": "Clean, clear waters are its usual habitat. When it’s about to be attacked by an invading enemy, it dives into the water to hide."}, {"versions": ["ultra-moon"], "text": "It detects nearby moisture with its fin. When its fin begins trembling rapidly, that means rain will fall in a few hours."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its cell structure is similar to water molecules. It melts into the water and becomes invisible."}, {"versions": ["sword"], "text": "When Vaporeon’s fins begin to vibrate, it is a sign that rain will come within a few hours."}, {"versions": ["legends-arceus"], "text": "Tests show that its 