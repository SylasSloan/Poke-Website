{"height": 4, "weight": 80, "base_experience": 59, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Dragon Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "タッツー"}, {"language": "ja-roma", "name": "Tattu"}, {"language": "ko", "name": "쏘드라"}, {"language": "zh-hant", "name": "墨海馬"}, {"language": "fr", "name": "Hypotrempe"}, {"language": "de", "name": "Seeper"}, {"language": "es", "name": "Horsea"}, {"language": "it", "name": "Horsea"}, {"language": "ja", "name": "タッツー"}, {"language": "zh-hans", "name": "墨海马"}, {"language": "es-419", "name": "Horsea"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x"], "text": "Known to shoot down flying bugs with precision blasts of ink from the surface of the water."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "If it senses any danger, it will vigorously spray water or a special type of ink from its mouth."}, {"versions": ["gold"], "text": "If attacked by a larger enemy, it quickly swims to safety by adeptly controlling its dorsal fin."}, {"versions": ["silver", "soulsilver"], "text": "Its big, developed fins move rapidly, allowing it to swim backward while still facing forward."}, {"versions": ["crystal"], "text": "When they're in a safe location, they can be seen playfully tangling their tails together."}, {"versions": ["ruby"], "text": "HORSEA eats small insects and moss off of rocks. If the ocean current turns fast, this POKéMON anchors itself by wrapping its tail around rocks or coral to prevent being washed away."}, {"versions": ["sapphire"], "text": "If HORSEA senses danger, it will reflexively spray a dense black ink from its mouth and try to escape. This POKéMON swims by cleverly flapping the fins on its back."}, {"versions": ["emerald"], "text": "By cleverly flicking the fins on its back side to side, it moves in any direction while facing forward. It spits ink to escape if it senses danger."}, {"versions": ["firered"], "text": "It maintains balance using its tail, which is wound up like a coil. It may spray ink from its mouth."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It makes its nest in the shade of corals. If it senses danger, it spits murky ink and flees."}, {"versions": ["heartgold"], "text": "If attacked by a larger enemy, it quickly swims to safety by adeptly controlling its well-developed dorsal fin."}, {"versions": ["omega-ruby"], "text": "Horsea eats small insects and moss off of rocks. If the ocean current turns fast, this Pokémon anchors itself by wrapping its tail around rocks or coral to prevent being washed away."}, {"versions": ["alpha-sapphire"], "text": "If Horsea senses danger, it will reflexively spray a dense black ink from its mouth and try to escape. This Pokémon swims by cleverly flapping the fin on its back."}, {"versions": ["sword"], "text": "Horsea makes its home in oceans with gentle currents. If this Pokémon is under attack, it spits out pitch-black ink and escapes."}, {"versions": ["shield"], "text": "They swim with dance-like motions and cause whirlpools to form. Horsea compete to see which of them can generate the biggest whirlpool."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/116.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/116.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/116.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/116.png"}, "gold": {"normal": "https://raw.github