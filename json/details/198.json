{"height": 5, "weight": 21, "base_experience": 81, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Darkness Pokémon", "capture_rate": 30, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤミカラス"}, {"language": "ja-roma", "name": "Yamikarasu"}, {"language": "ko", "name": "니로우"}, {"language": "zh-hant", "name": "黑暗鴉"}, {"language": "fr", "name": "Cornèbre"}, {"language": "de", "name": "Kramurx"}, {"language": "es", "name": "Murkrow"}, {"language": "it", "name": "Murkrow"}, {"language": "ja", "name": "ヤミカラス"}, {"language": "zh-hans", "name": "黑暗鸦"}, {"language": "es-419", "name": "Murkrow"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "Feared and loathed by many, it is believed to bring misfortune to all those who see it at night."}, {"versions": ["silver", "firered", "soulsilver"], "text": "It is said that when chased, it lures its attacker onto dark mountain trails where the foe will get lost."}, {"versions": ["crystal"], "text": "It hides any shiny object it finds in a secret location. MURKROW and MEOWTH loot one another's stashes."}, {"versions": ["ruby", "sapphire"], "text": "MURKROW was feared and loathed as the alleged bearer of ill fortune. This POKéMON shows strong interest in anything that sparkles or glitters. It will even try to steal rings from women."}, {"versions": ["emerald"], "text": "MURKROW were feared as the alleged bearers of ill fortune. It shows strong interest in anything that sparkles. It will even try to steal rings from women."}, {"versions": ["diamond"], "text": "It is believed that seeing this Pokémon at night will bring about ominous occurrences."}, {"versions": ["pearl"], "text": "It appears near travelers to lure them into deep forests. It is said to carry misfortune."}, {"versions": ["platinum", "black", "white"], "text": "If spotted, it will lure an unwary person into chasing it, then lose the pursuer on mountain trails."}, {"versions": ["black-2", "white-2"], "text": "If spotted, it will lure an unwary person into chasing it then lose the pursuer on mountain trails."}, {"versions": ["x"], "text": "It hides any shiny object it finds in a secret location. Murkrow and Meowth loot one another’s stashes."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Murkrow was feared and loathed as the alleged bearer of ill fortune. This Pokémon shows strong interest in anything that sparkles or glitters. It will even try to steal rings from women."}, {"versions": ["sun"], "text": "They awaken at dusk and take wing in the twilight, leading to the expression, “Get home before the Murkrow fly.”"}, {"versions": ["moon"], "text": "Seen as a symbol of bad luck, it’s generally disliked. Yet it gives presents—objects that sparkle or shine—to Trainers it’s close to."}, {"versions": ["ultra-sun"], "text": "It has a weakness for shiny things. It’s been known to sneak into the nests of Gabite—noted collectors of jewels—in search of treasure."}, {"versions": ["ultra-moon"], "text": "It searches for shiny things for its boss. Murkrow’s presence is said to be unlucky, so many people detest it."}, {"versions": ["legends-arceus"], "text": "Widely shunned as a bearer of ill fortune. Upon crossing paths with this creature, I've been told one must chant ”Workrum, Workrum—bad luck, don't come” as a protective incantation."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/198.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/198.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/198.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/1