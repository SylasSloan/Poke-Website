{"height": 5, "weight": 50, "base_experience": 118, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "special-attack", "value": 1}], "genus": "Symbol Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "medium", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "アンノーン"}, {"language": "ja-roma", "name": "Unknown"}, {"language": "ko", "name": "안농"}, {"language": "zh-hant", "name": "未知圖騰"}, {"language": "fr", "name": "Zarbi"}, {"language": "de", "name": "Icognito"}, {"language": "es", "name": "Unown"}, {"language": "it", "name": "Unown"}, {"language": "ja", "name": "アンノーン"}, {"language": "zh-hans", "name": "未知图腾"}, {"language": "es-419", "name": "Unown"}], "pokedex_entries": [{"versions": ["gold"], "text": "Their shapes look like hieroglyphs on ancient tab­ lets. It is said that the two are somehow related."}, {"versions": ["silver"], "text": "Its flat, thin body is always stuck on walls. Its shape appears to have some mean­ ing."}, {"versions": ["crystal"], "text": "Because different types of UNOWN exist, it is said that they must have a variety of abilities."}, {"versions": ["ruby", "sapphire"], "text": "This POKéMON is shaped like ancient writing. It is a mystery as to which came first, the ancient writings or the various UNOWN. Research into this topic is ongoing but nothing is known."}, {"versions": ["emerald"], "text": "This POKéMON is shaped like ancient text characters. Although research is ongoing, it is a mystery as to which came first, the ancient writings or the various UNOWN."}, {"versions": ["firered", "soulsilver", "x"], "text": "Its flat, thin body is always stuck on walls. Its shape appears to have some meaning."}, {"versions": ["leafgreen", "heartgold"], "text": "Their shapes look like hieroglyphs on ancient tablets. It is said that the two are somehow related."}, {"versions": ["diamond"], "text": "Shaped like ancient writing, it is a huge mystery whether language or UNOWN came first."}, {"versions": ["pearl"], "text": "They seem to communicate among each other telepathically. They are always found stuck on walls."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "When alone, nothing happens. However, if there are two or more, an odd power is said to emerge."}, {"versions": ["y"], "text": "Shaped like ancient writing, it is a huge mystery whether language or Unown came first."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "This Pokémon is shaped like ancient writing. It is a mystery as to which came first, the ancient writings or the various Unown. Research into this topic is ongoing but nothing is known."}, {"versions": ["legends-arceus"], "text": "It is hard to believe these strangely shaped Pokémon are truly living creatures. I've pointed out that the species' many forms resemble writing from other lands; no one will take me seriously."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/201.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/201.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/201.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/201.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/201.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/201.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/201.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/ver