{"height": 11, "weight": 900, "base_experience": 65, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Sea Lion Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "パウワウ"}, {"language": "ja-roma", "name": "Pawou"}, {"language": "ko", "name": "쥬쥬"}, {"language": "zh-hant", "name": "小海獅"}, {"language": "fr", "name": "Otaria"}, {"language": "de", "name": "Jurob"}, {"language": "es", "name": "Seel"}, {"language": "it", "name": "Seel"}, {"language": "ja", "name": "パウワウ"}, {"language": "zh-hans", "name": "小海狮"}, {"language": "es-419", "name": "Seel"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The protruding horn on its head is very hard. It is used for bashing through thick ice."}, {"versions": ["yellow"], "text": "Loves freezing cold conditions. Relishes swimming in a frigid cli­ mate of around 14F degrees."}, {"versions": ["gold"], "text": "Although it can't walk well on land, it is a graceful swimmer. It espe­ cially loves being in frigid seas."}, {"versions": ["silver", "soulsilver"], "text": "In daytime, it is often found asleep on the seabed in shallow waters. Its nostrils close while it swims."}, {"versions": ["crystal"], "text": "The light blue fur that covers it keeps it protected against the cold. It loves iceberg- filled oceans."}, {"versions": ["ruby", "sapphire"], "text": "SEEL hunts for prey in the frigid sea underneath sheets of ice. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head."}, {"versions": ["emerald"], "text": "SEEL hunt for prey in frigid, ice-covered seas. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head."}, {"versions": ["firered"], "text": "Covered with light blue fur, its hide is thick and tough. It is active in bitter cold of minus 40 degrees Fahrenheit."}, {"versions": ["leafgreen"], "text": "The protruding horn on its head is very hard. It is used for bashing through thick icebergs."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice."}, {"versions": ["heartgold"], "text": "Although it can’t walk well on land, it is a graceful swimmer. It especially loves being in frigid seas."}, {"versions": ["black-2", "white-2"], "text": "The colder it gets, the better it feels. It joyfully swims around oceans so cold that they are filled with floating ice."}, {"versions": ["y"], "text": "Covered with light blue fur, its hide is thick and tough. It is active in bitter cold of -40 degrees Fahrenheit."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Seel hunts for prey in the frigid sea underneath sheets of ice. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head."}, {"versions": ["ultra-sun"], "text": "It has always been supposed that Seel live only in cold seas. Their having shown up in Alola is a mystery."}, {"versions": ["ultra-moon"], "text": "Thanks to its thick fat, cold seas don’t bother it at all, but it gets tired pretty easily in warm waters."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Loves freezing-cold conditions. Relishes swimming in a frigid climate of around 14 degrees Fahrenheit."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/86.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/86.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/86.png", "shiny": "https://raw.githubusercon