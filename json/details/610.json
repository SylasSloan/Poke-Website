{"height": 6, "weight": 180, "base_experience": 64, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Tusk Pokémon", "capture_rate": 75, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["monster", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キバゴ"}, {"language": "ja-roma", "name": "Kibago"}, {"language": "ko", "name": "터검니"}, {"language": "zh-hant", "name": "牙牙"}, {"language": "fr", "name": "Coupenotte"}, {"language": "de", "name": "Milza"}, {"language": "es", "name": "Axew"}, {"language": "it", "name": "Axew"}, {"language": "ja", "name": "キバゴ"}, {"language": "zh-hans", "name": "牙牙"}, {"language": "es-419", "name": "Axew"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "They use their tusks to crush the berries they eat. Repeated regrowth makes their tusks strong and sharp."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "They mark their territory by leaving gashes in trees with their tusks. If a tusk breaks, a new one grows in quickly."}, {"versions": ["black-2", "white-2"], "text": "Its large tusks have a tendency to break, but each time they grow back, they grow in harder and sturdier."}, {"versions": ["sword"], "text": "These Pokémon nest in the ground and use their tusks to crush hard berries. Crushing berries is also how they test each other’s strength."}, {"versions": ["shield"], "text": "They play with each other by knocking their large tusks together. Their tusks break sometimes, but they grow back so quickly that it isn’t a concern."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/610.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/610.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/mas