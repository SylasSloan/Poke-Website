{"height": 11, "weight": 876, "base_experience": 144, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Ball Roll Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "トドグラー"}, {"language": "ja-roma", "name": "Todoggler"}, {"language": "ko", "name": "씨레오"}, {"language": "zh-hant", "name": "海魔獅"}, {"language": "fr", "name": "Phogleur"}, {"language": "de", "name": "Seejong"}, {"language": "es", "name": "Sealeo"}, {"language": "it", "name": "Sealeo"}, {"language": "ja", "name": "トドグラー"}, {"language": "zh-hans", "name": "海魔狮"}, {"language": "es-419", "name": "Sealeo"}], "pokedex_entries": [{"versions": ["heartgold", "soulsilver", "x"], "text": "It has a very sensitive nose. It touches new things with its nose to examine them."}, {"versions": ["ruby"], "text": "SEALEO has the habit of always juggling on the tip of its nose anything it sees for the first time. This POKéMON occasionally entertains itself by balancing and rolling a SPHEAL on its nose."}, {"versions": ["sapphire"], "text": "SEALEO often balances and rolls things on the tip of its nose. While the POKéMON is rolling something, it checks the object’s aroma and texture to determine whether it likes the object or not."}, {"versions": ["emerald"], "text": "SEALEO live in herds on ice floes. Using its powerful flippers, it shatters ice. It dives into the sea to hunt prey five times a day."}, {"versions": ["firered", "leafgreen"], "text": "It touches new things with its nose to test for smell and feel. It plays by spinning SPHEAL on its nose."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It habitually spins things on its nose. By doing so, it learns textures and odors."}, {"versions": ["black-2", "white-2", "y"], "text": "Be it Spheal or Poké Ball, it will spin any round object on its nose with the greatest of ease."}, {"versions": ["omega-ruby"], "text": "Sealeo has the habit of always juggling on the tip of its nose anything it sees for the first time. This Pokémon occasionally entertains itself by balancing and rolling a Spheal on its nose."}, {"versions": ["alpha-sapphire"], "text": "Sealeo often balances and rolls things on the tip of its nose. While the Pokémon is rolling something, it checks the object’s aroma and texture to determine whether it likes the object or not."}, {"versions": ["sword"], "text": "Sealeo live on top of drift ice. They go swimming when they’re on the hunt, seeking out their prey by scent."}, {"versions": ["shield"], "text": "This Pokémon has a habit of spinning round things on its nose, whether those things are Poké Balls or Spheal."}, {"versions": ["legends-arceus"], "text": "Its white whiskers are very sensitive. Sealeo will balance Spheal on the tip of its nose, checking its scent and its feel to be sure the Spheal is healthy."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/364.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/364.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/364.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/364.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/364.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/364.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/36