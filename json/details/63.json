{"height": 9, "weight": 195, "base_experience": 62, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Psi Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "ケーシィ"}, {"language": "ja-roma", "name": "Casey"}, {"language": "ko", "name": "캐이시"}, {"language": "zh-hant", "name": "凱西"}, {"language": "fr", "name": "Abra"}, {"language": "de", "name": "Abra"}, {"language": "es", "name": "Abra"}, {"language": "it", "name": "Abra"}, {"language": "ja", "name": "ケーシィ"}, {"language": "zh-hans", "name": "凯西"}, {"language": "es-419", "name": "Abra"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Using its ability to read minds, it will identify impending danger and TELEPORT to safety."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Sleeps 18 hours a day. If it senses danger, it will teleport itself to safety even as it sleeps."}, {"versions": ["gold"], "text": "It senses impend­ ing attacks and TELEPORTS away to safety before the actual attacks can strike."}, {"versions": ["silver"], "text": "If it decides to TELEPORT randomly, it creates the illusion that it has created copies of itself."}, {"versions": ["crystal"], "text": "It hypnotizes itself so that it can teleport away when it senses danger, even if it is asleep."}, {"versions": ["ruby"], "text": "ABRA sleeps for eighteen hours a day. However, it can sense the presence of foes even while it is sleeping. In such a situation, this POKéMON immediately teleports to safety."}, {"versions": ["sapphire"], "text": "ABRA needs to sleep for eighteen hours a day. If it doesn’t, this POKéMON loses its ability to use telekinetic powers. If it is attacked, ABRA escapes using TELEPORT while it is still sleeping."}, {"versions": ["emerald"], "text": "A POKéMON that sleeps 18 hours a day. Observation revealed that it uses TELEPORT to change its location once every hour."}, {"versions": ["firered", "x"], "text": "It sleeps for 18 hours a day. It uses a variety of extrasensory powers even while asleep."}, {"versions": ["leafgreen"], "text": "Using its ability to read minds, it will sense impending danger and TELEPORT to safety."}, {"versions": ["diamond"], "text": "It sleeps for 18 hours a day. Even when awake, it teleports itself while remaining seated."}, {"versions": ["pearl"], "text": "Even while asleep, it maintains a telepathic radar. It teleports when it is threatened."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Using its psychic power is such a strain on its brain that it needs to sleep for 18 hours a day."}, {"versions": ["heartgold", "y"], "text": "It senses impending attacks and teleports away to safety before the actual attacks can strike."}, {"versions": ["soulsilver"], "text": "If it decides to teleport randomly, it evokes the illusion that it has created copies of itself."}, {"versions": ["omega-ruby"], "text": "Abra sleeps for eighteen hours a day. However, it can sense the presence of foes even while it is sleeping. In such a situation, this Pokémon immediately teleports to safety."}, {"versions": ["alpha-sapphire"], "text": "Abra needs to sleep for eighteen hours a day. If it doesn’t, this Pokémon loses its ability to use telekinetic powers. If it is attacked, Abra escapes using Teleport while it is still sleeping."}, {"versions": ["sun"], "text": "It sleeps 18 hours a day. Even while sleeping, it will teleport itself to treetops and pick and eat berries there."}, {"versions": ["moon"], "text": "It can teleport itself to safety while it’s asleep, but when it wakes, it doesn’t know where it is, so it panics."}, {"versions": ["ultra-sun"], "text": "It uses various psychic powers even while it’s sleeping, so you can’t tell whether or not it’s awake."}, {"versions": ["ultra-moon"], "text": "It can read others’ minds and will teleport away when danger approaches. You must clear your mind if you want to catch it."}, {"versions": ["sword"], "text": "This Pokémon uses its psychic powers while it sleeps. The contents of Abra’s dreams affect the powers that the Pokémon wields."}, {"versions": ["shield"], "text": "Abra can teleport in its sleep. Apparently the more deeply Abra sleeps, the farther its teleportations go."}, {"versions": ["legends-arceus"], "text": "Spends 18 hours of the day sleeping. Even while asleep, Abra can control its psychic powers—should danger approach, the Pokémon will simply teleport away."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/63.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/63.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/63.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/63.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/63.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/63.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/63.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/63.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/63.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/63.png"}, "firered-l