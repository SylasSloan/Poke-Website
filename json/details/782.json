{"height": 6, "weight": 297, "base_experience": 60, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Scaly Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ジャラコ"}, {"language": "ja-roma", "name": "Jyarako"}, {"language": "ko", "name": "짜랑꼬"}, {"language": "zh-hant", "name": "心鱗寶"}, {"language": "fr", "name": "Bébécaille"}, {"language": "de", "name": "Miniras"}, {"language": "es", "name": "Jangmo-o"}, {"language": "it", "name": "Jangmo-o"}, {"language": "ja", "name": "ジャラコ"}, {"language": "zh-hans", "name": "心鳞宝"}, {"language": "es-419", "name": "Jangmo-o"}], "pokedex_entries": [{"versions": ["sun"], "text": "It expresses its feelings by smacking its scales. Metallic sounds echo through the tall mountains where Jangmo-o lives."}, {"versions": ["moon"], "text": "They live in mountains where no trace of humans can be detected. Jangmo-o grow little by little as they battle one another."}, {"versions": ["ultra-sun"], "text": "It smacks the scales on its head against rocks or against the ground to frighten its opponents. It can also contact its friends with these noises."}, {"versions": ["ultra-moon"], "text": "It will never show an enemy its back in battle. Ancient warriors liked Jangmo-o for its valiant disposition and made it one of their own."}, {"versions": ["sword"], "text": "They learn to fight by smashing their head scales together. The dueling strengthens both their skills and their spirits."}, {"versions": ["shield"], "text": "Jangmo-o strikes its scales to communicate with others of its kind. Its scales are actually fur that’s become as hard as metal."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/782.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubuser