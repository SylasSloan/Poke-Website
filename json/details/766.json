{"height": 20, "weight": 828, "base_experience": 172, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Teamwork Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ナゲツケサル"}, {"language": "ja-roma", "name": "Nagetukesaru"}, {"language": "ko", "name": "내던숭이"}, {"language": "zh-hant", "name": "投擲猴"}, {"language": "fr", "name": "Quartermac"}, {"language": "de", "name": "Quartermak"}, {"language": "es", "name": "Passimian"}, {"language": "it", "name": "Passimian"}, {"language": "ja", "name": "ナゲツケサル"}, {"language": "zh-hans", "name": "投掷猴"}, {"language": "es-419", "name": "Passimian"}], "pokedex_entries": [{"versions": ["sun"], "text": "They form groups of roughly 20 individuals. Their mutual bond is remarkable—they will never let down a comrade."}, {"versions": ["moon"], "text": "They battle with hard berries for weapons. Their techniques are passed from the boss to the group, generation upon generation."}, {"versions": ["ultra-sun"], "text": "They use their saliva to stick leaves to their shoulders. You can tell what troop they belong to from the position of the leaves."}, {"versions": ["ultra-moon"], "text": "Berries are its weapons as well as the staple of its diet. The one that can throw a berry the farthest is the boss of the troop."}, {"versions": ["sword"], "text": "Displaying amazing teamwork, they follow the orders of their boss as they all help out in the search for their favorite berries."}, {"versions": ["shield"], "text": "Passimian live in groups of about 20, with each member performing an assigned role. Through cooperation, the group survives."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/766.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubuserconten