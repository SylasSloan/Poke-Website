{"height": 3, "weight": 54, "base_experience": 57, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Mushroom Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "パラス"}, {"language": "ja-roma", "name": "Paras"}, {"language": "ko", "name": "파라스"}, {"language": "zh-hant", "name": "派拉斯"}, {"language": "fr", "name": "Paras"}, {"language": "de", "name": "Paras"}, {"language": "es", "name": "Paras"}, {"language": "it", "name": "Paras"}, {"language": "ja", "name": "パラス"}, {"language": "zh-hans", "name": "派拉斯"}, {"language": "es-419", "name": "Paras"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Burrows to suck tree roots. The mushrooms on its back grow by draw­ ing nutrients from the bug host."}, {"versions": ["yellow", "y", "lets-go-pikachu", "lets-go-eevee"], "text": "Burrows under the ground to gnaw on tree roots. The mushrooms on its back absorb most of the nutrition."}, {"versions": ["gold", "heartgold"], "text": "It is doused with mushroom spores when it is born. As its body grows, mushrooms sprout from its back."}, {"versions": ["silver"], "text": "As its body grows large, oriental mushrooms named tochukaso start sprouting out of its back."}, {"versions": ["crystal"], "text": "The tochukaso growing on this POKéMON's back orders it to extract juice from tree trunks."}, {"versions": ["ruby"], "text": "PARAS has parasitic mushrooms growing on its back called tochukaso. They grow large by drawing nutrients from the BUG POKéMON host. They are highly valued as a medicine for extending life."}, {"versions": ["sapphire"], "text": "PARAS has parasitic mushrooms growing on its back called tochukaso. They grow large by drawing nutrients from this BUG POKéMON host. They are highly valued as a medicine for extending life."}, {"versions": ["emerald"], "text": "A PARAS has parasitic tochukaso mushrooms growing on its back. They grow by drawing nutrients from the host. They are valued as a medicine for long life."}, {"versions": ["firered", "x"], "text": "Growing out of the bug’s back are mushrooms called tochukaso. The mushrooms grow with the bug host."}, {"versions": ["leafgreen"], "text": "Burrows to suck tree roots. The mushrooms on its back grow by drawing nutrients from the bug host."}, {"versions": ["diamond", "pearl", "platinum"], "text": "Mushrooms named tochukaso grow on its back. They grow along with the host PARAS."}, {"versions": ["soulsilver"], "text": "As its body grows, large mushrooms named tochukaso start sprouting out of its back."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "Mushrooms named tochukaso grow on its back. They grow along with the host Paras."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Paras has parasitic mushrooms growing on its back called tochukaso. They grow large by drawing nutrients from this Bug Pokémon host. They are highly valued as a medicine for extending life."}, {"versions": ["sun"], "text": "No matter how much it eats, the mushrooms growing on its back steal away most of the nutrients it consumes."}, {"versions": ["moon"], "text": "Mushrooms called tochukaso sprout from its back. They can be dried and powdered to make a medicine used to extend life."}, {"versions": ["ultra-sun"], "text": "Whether it’s due to a lack of moisture or a lack of nutrients, in Alola the mushrooms on Paras don’t grow up quite right."}, {"versions": ["ultra-moon"], "text": "The mushrooms, known as tochukaso, are controlling the bug. Even if the bug bugs the mushrooms, they tell it to bug off."}, {"versions": ["legends-arceus"], "text": "Sometimes seen at the foot of trees in humid forests. The mushrooms on its back—called tochukaso—are not present on infant specimens and instead emerge as Paras matures."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites