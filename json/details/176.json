{"height": 6, "weight": 32, "base_experience": 142, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Happiness Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["flying", "fairy"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "トゲチック"}, {"language": "ja-roma", "name": "Togechick"}, {"language": "ko", "name": "토게틱"}, {"language": "zh-hant", "name": "波克基古"}, {"language": "fr", "name": "Togetic"}, {"language": "de", "name": "Togetic"}, {"language": "es", "name": "Togetic"}, {"language": "it", "name": "Togetic"}, {"language": "ja", "name": "トゲチック"}, {"language": "zh-hans", "name": "波克基古"}, {"language": "es-419", "name": "Togetic"}], "pokedex_entries": [{"versions": ["white-2", "black", "white", "black-2"], "text": "To share its happiness, it flies around the world seeking kind- hearted people."}, {"versions": ["gold"], "text": "They say that it will appear before kindhearted, car­ ing people and shower them with happiness."}, {"versions": ["silver"], "text": "It grows dispirit­ ed if it is not with kind people. It can float in midair without moving its wings."}, {"versions": ["crystal"], "text": "Although it does not flap its wings very much, it can stay up in the air as it tags along after its trainer."}, {"versions": ["ruby", "sapphire"], "text": "TOGETIC is said to be a POKéMON that brings good fortune. When the POKéMON spots someone who is pure of heart, it is said to appear and share its happiness with that person."}, {"versions": ["emerald"], "text": "It is said to be a POKéMON that brings good fortune. When it spots someone who is pure of heart, a TOGETIC appears and shares its happiness with that person."}, {"versions": ["firered", "soulsilver", "x", "shield"], "text": "It grows dispirited if it is not with kind people. It can float in midair without moving its wings."}, {"versions": ["leafgreen", "heartgold", "y", "sword"], "text": "They say that it will appear before kindhearted, caring people and shower them with happiness."}, {"versions": ["diamond", "pearl"], "text": "It is said to appear in front of kindly people to scatter a glowing down called “joy dust.”"}, {"versions": ["platinum"], "text": "To share its happiness, it flies around the world seeking kind­ hearted people."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Togetic is said to be a Pokémon that brings good fortune. When the Pokémon spots someone who is pure of heart, it is said to appear and share its happiness with that person."}, {"versions": ["legends-arceus"], "text": "No records exist of Togetic being seen in the wilds. Rumors abound that it evolves under the loving care of a trusted human companion, upon whom the Pokémon then bestows great joy."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/176.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/176.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/176.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/176.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/176.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/176.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/176.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/176.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/ve