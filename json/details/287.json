{"height": 8, "weight": 240, "base_experience": 56, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Slacker Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ナマケロ"}, {"language": "ja-roma", "name": "Namakero"}, {"language": "ko", "name": "게을로"}, {"language": "zh-hant", "name": "懶人獺"}, {"language": "fr", "name": "Parecool"}, {"language": "de", "name": "Bummelz"}, {"language": "es", "name": "Slakoth"}, {"language": "it", "name": "Slakoth"}, {"language": "ja", "name": "ナマケロ"}, {"language": "zh-hans", "name": "懒人獭"}, {"language": "es-419", "name": "Slakoth"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SLAKOTH lolls around for over twenty hours every day. Because it moves so little, it does not need much food. This POKéMON’s sole daily meal consists of just three leaves."}, {"versions": ["sapphire"], "text": "SLAKOTH’s heart beats just once a minute. Whatever happens, it is content to loaf around motionless. It is rare to see this POKéMON in motion."}, {"versions": ["emerald"], "text": "It sleeps virtually all day and night long. It doesn’t change its nest its entire life, but it sometimes travels great distances by swimming in rivers."}, {"versions": ["firered", "leafgreen"], "text": "It sleeps for 20 hours every day. Making drowsy those that see it is one of its abilities."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It spends nearly all its time in a day sprawled out. Just seeing it makes one drowsy."}, {"versions": ["heartgold", "soulsilver"], "text": "The way SLAKOTH lolls around makes anyone who watches it feel like doing the same."}, {"versions": ["black-2", "white-2", "y"], "text": "If it eats just three leaves in a day, it is satisfied. Other than that, it sleeps for 20 hours a day."}, {"versions": ["x"], "text": "The way Slakoth lolls around makes anyone who watches it feel like doing the same."}, {"versions": ["omega-ruby"], "text": "Slakoth lolls around for over 20 hours every day. Because it moves so little, it does not need much food. This Pokémon’s sole daily meal consists of just three leaves."}, {"versions": ["alpha-sapphire"], "text": "Slakoth’s heart beats just once a minute. Whatever happens, it is content to loaf around motionless. It is rare to see this Pokémon in motion."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/287.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/287.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/287.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/287.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/287.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/287.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/287.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/287.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/287.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/287.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/spr