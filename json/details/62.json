{"height": 13, "weight": 540, "base_experience": 230, "ev_yield": [{"stat": "defense", "value": 3}], "genus": "Tadpole Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ニョロボン"}, {"language": "ja-roma", "name": "Nyorobon"}, {"language": "ko", "name": "강챙이"}, {"language": "zh-hant", "name": "蚊香泳士"}, {"language": "fr", "name": "Tartard"}, {"language": "de", "name": "Quappo"}, {"language": "es", "name": "Poliwrath"}, {"language": "it", "name": "Poliwrath"}, {"language": "ja", "name": "ニョロボン"}, {"language": "zh-hans", "name": "蚊香泳士"}, {"language": "es-419", "name": "Poliwrath"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "An adept swimmer at both the front crawl and breast stroke. Easily overtakes the best human swimmers."}, {"versions": ["yellow"], "text": "Swims powerfully using all the muscles in its body. It can even overtake champion swimmers."}, {"versions": ["gold", "heartgold"], "text": "This strong and skilled swimmer is even capable of crossing the Pacific Ocean just by kicking."}, {"versions": ["silver"], "text": "Although an ener­ getic, skilled swimmer that uses all of its mus­ cles, it lives on dry land."}, {"versions": ["crystal"], "text": "It can use its well-developed arms and legs to run on the surface of the water for a split second."}, {"versions": ["ruby", "sapphire"], "text": "POLIWRATH’s highly developed, brawny muscles never grow fatigued, however much it exercises. It is so tirelessly strong, this POKéMON can swim back and forth across the Pacific Ocean without effort."}, {"versions": ["emerald"], "text": "Its highly developed muscles never grow fatigued, however much it exercises. This POKéMON can swim back and forth across the Pacific Ocean without effort."}, {"versions": ["firered"], "text": "An adept swimmer, it knows the front crawl, butterfly, and more. It is faster than the best human swimmers."}, {"versions": ["leafgreen", "y"], "text": "A swimmer adept at both the front crawl and breaststroke. Easily overtakes the best human swimmers."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "With its extremely tough muscles, it can keep swimming in the Pacific Ocean without resting."}, {"versions": ["soulsilver"], "text": "Although an energetic, skilled swimmer that uses all of its muscles, it lives on dry land."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Poliwrath’s highly developed, brawny muscles never grow fatigued, however much it exercises. It is so tirelessly strong, this Pokémon can swim back and forth across the ocean without effort."}, {"versions": ["sun"], "text": "Poliwrath in the Alola region are strong swimmers that use the breaststroke. Many children learn to swim by imitating Poliwrath."}, {"versions": ["moon"], "text": "Its percentage of body fat is nearly zero. Its body is entirely muscle, which makes it heavy and forces its swimming prowess to develop."}, {"versions": ["ultra-sun"], "text": "It’s quite a gifted swimmer, even among Water-type Pokémon, but it normally spends its time on land."}, {"versions": ["ultra-moon"], "text": "The muscles it has developed through swimming are thick and powerful. When it lands a square punch, it can turn huge boulders to dust."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Swims powerfully using all the muscles in its body. It can even overtake world-class swimmers."}, {"versions": ["sword"], "text": "Its body is solid muscle. When swimming through cold seas, Poliwrath uses its impressive arms to smash through drift ice and plow forward."}, {"versions": ["shield"], "text": "Poliwrath is skilled at both swimming and martial arts. It uses its well-trained arms to dish out powerful punches."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/