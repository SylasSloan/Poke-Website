{"height": 5, "weight": 90, "base_experience": 55, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Poison Pin Pokémon", "capture_rate": 235, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "ニドラン♂"}, {"language": "ja-roma", "name": "Nidoran♂"}, {"language": "ko", "name": "니드런♂"}, {"language": "zh-hant", "name": "尼多朗"}, {"language": "fr", "name": "Nidoran♂"}, {"language": "de", "name": "Nidoran♂"}, {"language": "es", "name": "Nidoran♂"}, {"language": "it", "name": "Nidoran♂"}, {"language": "ja", "name": "ニドラン♂"}, {"language": "zh-hans", "name": "尼多朗"}, {"language": "es-419", "name": "Nidoran♂"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Stiffens its ears to sense danger. The larger its horns, the more powerful its secreted venom."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Its large ears are always kept upright. If it senses danger, it will attack with a poisonous sting."}, {"versions": ["gold", "heartgold"], "text": "It is small, but its horn is filled with poison. It charges then stabs with the horn to inject poison."}, {"versions": ["silver", "soulsilver"], "text": "It raises its big ears to check its surroundings. It will strike first if it senses any danger."}, {"versions": ["crystal"], "text": "It constantly moves its large ears in many directions in order to detect danger right away."}, {"versions": ["ruby", "sapphire"], "text": "The male NIDORAN has developed muscles for moving its ears. Thanks to them, the ears can be freely moved in any direction. Even the slightest sound does not escape this POKéMON’s notice."}, {"versions": ["emerald"], "text": "The male NIDORAN has developed muscles that freely move its ears in any direction. Even the slightest sound does not escape this POKéMON’s notice."}, {"versions": ["firered", "y"], "text": "Its large ears are flapped like wings when it is listening to distant sounds. It extends toxic barbs when angered."}, {"versions": ["leafgreen"], "text": "It stiffens its ears to sense danger. The larger its horns, the more powerful its secreted venom."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It scans its surroundings by raising its ears out of the grass. Its toxic horn is for protection."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Nidoran♂ has developed muscles for moving its ears. Thanks to them, the ears can be freely moved in any direction. Even the slightest sound does not escape this Pokémon’s notice."}, {"versions": ["sword"], "text": "The horn on a male Nidoran’s forehead contains a powerful poison. This is a very cautious Pokémon, always straining its large ears."}, {"versions": ["shield"], "text": "Small but brave, this Pokémon will hold its ground and even risk its life in battle to protect the female it’s friendly with."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/32.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/32.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/32.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/32.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/32.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/32.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/32.png", "shiny": 