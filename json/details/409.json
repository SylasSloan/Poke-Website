{"height": 16, "weight": 1025, "base_experience": 173, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Head Butt Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["monster"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ラムパルド"}, {"language": "ja-roma", "name": "Rampald"}, {"language": "ko", "name": "램펄드"}, {"language": "zh-hant", "name": "戰槌龍"}, {"language": "fr", "name": "Charkos"}, {"language": "de", "name": "Rameidon"}, {"language": "es", "name": "Rampardos"}, {"language": "it", "name": "Rampardos"}, {"language": "ja", "name": "ラムパルド"}, {"language": "zh-hans", "name": "战槌龙"}, {"language": "es-419", "name": "Rampardos"}], "pokedex_entries": [{"versions": ["diamond"], "text": "Its powerful head butt has enough power to shatter even the most durable things upon impact."}, {"versions": ["pearl", "y", "alpha-sapphire"], "text": "Its skull is as hard as iron. It is a brute that tears down jungle trees while catching prey."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "If two were to smash their heads together, their foot-thick skulls would keep them from fainting."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "Its skull withstands impacts of any magnitude. As a result, its brain never gets the chance to grow."}, {"versions": ["sun"], "text": "The result of repeated headbutts is a skull grown thick and hard. However, its brain has shrunk in size compared with Cranidos’s."}, {"versions": ["moon"], "text": "Records exist of a revived fossil that evolved into Rampardos. It proceeded to escape and then destroy a skyscraper with a headbutt."}, {"versions": ["ultra-sun"], "text": "In ancient times, people would dig up fossils of this Pokémon and use its skull, which is harder than steel, to make helmets."}, {"versions": ["ultra-moon"], "text": "This ancient Pokémon used headbutts skillfully. Its brain was really small, so some theories suggest that its stupidity led to its extinction."}, {"versions": ["legends-arceus"], "text": "Very little is known about its biology. Can knock down massive trees by smashing its beautiful, pearl-like crown against them."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/409.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/409.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/409.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/409.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/409.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/409.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/409.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/409.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/409.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/409.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/409.png"}, "x-y": {"normal": "https://raw.githubuse