{"height": 11, "weight": 1105, "base_experience": 147, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Endurance Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コモルー"}, {"language": "ja-roma", "name": "Komoruu"}, {"language": "ko", "name": "쉘곤"}, {"language": "zh-hant", "name": "甲殼龍"}, {"language": "fr", "name": "Drackhaus"}, {"language": "de", "name": "Draschel"}, {"language": "es", "name": "Shelgon"}, {"language": "it", "name": "Shelgon"}, {"language": "ja", "name": "コモルー"}, {"language": "zh-hans", "name": "甲壳龙"}, {"language": "es-419", "name": "Shelgon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "Inside SHELGON’s armor-like shell, cells are in the midst of transformation to create an entirely new body. This POKéMON’s shell is extremely heavy, making its movements sluggish."}, {"versions": ["sapphire"], "text": "Covering SHELGON’s body are outgrowths much like bones. The shell is very hard and bounces off enemy attacks. When awaiting evolution, this POKéMON hides away in a cavern."}, {"versions": ["emerald"], "text": "It hardly eats while it awaits evolution. It becomes hardier by enduring hunger. Its shell peels off the instant it begins to evolve."}, {"versions": ["firered", "leafgreen", "y"], "text": "Its armored body makes all attacks bounce off. The armor is too tough, however, making it heavy and somewhat sluggish."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Within its rugged shell, its cells have begun changing. The shell peels off the instant it evolves."}, {"versions": ["heartgold", "soulsilver"], "text": "It surrounds its body in an iron-hard shell to accumulate enough power to evolve."}, {"versions": ["omega-ruby"], "text": "Inside Shelgon’s armor-like shell, cells are in the midst of transformation to create an entirely new body. This Pokémon’s shell is extremely heavy, making its movements sluggish."}, {"versions": ["alpha-sapphire"], "text": "Covering Shelgon’s body are outgrowths much like bones. The shell is very hard and bounces off enemy attacks. When awaiting evolution, this Pokémon hides away in a cavern."}, {"versions": ["sun"], "text": "The cells within its shell transform with explosive speed, preparing it for evolution."}, {"versions": ["moon"], "text": "They lurk deep within caves—motionless, neither eating nor drinking. Why they don’t die is not known."}, {"versions": ["ultra-sun"], "text": "The cells within its body are changing at a bewildering pace. Its hard shell is made from the same substance as bone."}, {"versions": ["ultra-moon"], "text": "Shelgon lives deep within caves. It stays shut up in its hard shell, dreaming of the day it will be able to fly."}, {"versions": ["sword"], "text": "This Pokémon has covered its body in a hard shell that has the same composition as bone. Shelgon stores energy for evolution."}, {"versions": ["shield"], "text": "Shelgon ignores its hunger entirely, never eating any food. Apparently, Shelgon will evolve once all its energy stores are used up."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/372.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/372.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/372.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/372.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/372.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/s