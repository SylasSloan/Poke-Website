{"height": 12, "weight": 470, "base_experience": 163, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Disaster Pokémon", "capture_rate": 30, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アブソル"}, {"language": "ja-roma", "name": "Absol"}, {"language": "ko", "name": "앱솔"}, {"language": "zh-hant", "name": "阿勃梭魯"}, {"language": "fr", "name": "Absol"}, {"language": "de", "name": "Absol"}, {"language": "es", "name": "Absol"}, {"language": "it", "name": "Absol"}, {"language": "ja", "name": "アブソル"}, {"language": "zh-hans", "name": "阿勃梭鲁"}, {"language": "es-419", "name": "Absol"}], "pokedex_entries": [{"versions": ["ruby"], "text": "Every time ABSOL appears before people, it is followed by a disaster such as an earthquake or a tidal wave. As a result, it came to be known as the disaster POKéMON."}, {"versions": ["sapphire"], "text": "ABSOL has the ability to foretell the coming of natural disasters. It lives in a harsh, rugged mountain environment. This POKéMON very rarely ventures down from the mountains."}, {"versions": ["emerald"], "text": "It sharply senses even subtle changes in the sky and the land to predict natural disasters. It is a long-lived POKéMON that has a life-span of 100 years."}, {"versions": ["firered", "leafgreen"], "text": "It appears when it senses an impending natural disaster. As a result, it was mistaken as a doom-bringer."}, {"versions": ["diamond", "pearl", "x"], "text": "It senses coming disasters and appears before people only to warn them of impending danger."}, {"versions": ["platinum", "black", "white"], "text": "Rumored to sense disasters with its horn, it became a target. It fled deep into the mountains."}, {"versions": ["heartgold", "soulsilver"], "text": "It has the ability to foretell natural disasters. Its life span is over a hundred years."}, {"versions": ["black-2", "white-2"], "text": "It appears from deep in the mountains to warn people about upcoming disasters it has sensed with its horn."}, {"versions": ["y"], "text": "It appears when it senses an impending natural disaster. As a result, it was mistaken as a doom bringer."}, {"versions": ["omega-ruby"], "text": "Every time Absol appears before people, it is followed by a disaster such as an earthquake or a tidal wave. As a result, it came to be known as the disaster Pokémon."}, {"versions": ["alpha-sapphire"], "text": "Absol has the ability to foretell the coming of natural disasters. It lives in a harsh, rugged mountain environment. This Pokémon very rarely ventures down from the mountains."}, {"versions": ["sun"], "text": "Long ago, superstitions were spread about it, saying it brought disaster. This fed a hatred of it, and it was driven deep into the mountains."}, {"versions": ["moon"], "text": "Although it’s said to bring disaster, in actuality, this Pokémon possesses a calm disposition and warns people of any crises that loom."}, {"versions": ["ultra-sun"], "text": "The only thing unlucky about Absol is its appearance. It protects fields and warns people of disaster, so one ought to be grateful for it."}, {"versions": ["ultra-moon"], "text": "The elderly call it the disaster Pokémon and detest it, but interest in its power to predict disasters is on the rise."}, {"versions": ["sword"], "text": "Swift as the wind, Absol races through fields and mountains. Its curved, bow-like horn is acutely sensitive to the warning signs of natural disasters."}, {"versions": ["shield"], "text": "Because of this Pokémon’s ability to detect danger, people mistook Absol as a bringer of doom."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/359.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/359.png"}, "ruby-sapphire": {"normal": "https://raw.