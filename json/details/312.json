{"height": 4, "weight": 42, "base_experience": 142, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Cheering Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マイナン"}, {"language": "ja-roma", "name": "Minun"}, {"language": "ko", "name": "마이농"}, {"language": "zh-hant", "name": "負電拍拍"}, {"language": "fr", "name": "Négapi"}, {"language": "de", "name": "Minun"}, {"language": "es", "name": "Minun"}, {"language": "it", "name": "Minun"}, {"language": "ja", "name": "マイナン"}, {"language": "zh-hans", "name": "負电拍拍"}, {"language": "es-419", "name": "Minun"}], "pokedex_entries": [{"versions": ["ruby"], "text": "MINUN is more concerned about cheering on its partners than its own safety. It shorts out the electricity in its body to create brilliant showers of sparks to cheer on its teammates."}, {"versions": ["sapphire"], "text": "MINUN loves to cheer on its partner in battle. It gives off sparks from its body while it is doing so. If its partner is in trouble, this POKéMON gives off increasing amounts of sparks."}, {"versions": ["emerald"], "text": "At a meeting of POKéMON academics, it was announced that simultaneous exposure to electricity from a PLUSLE and MINUN will promote circulation and boost vitality."}, {"versions": ["firered", "leafgreen"], "text": "Its dislike of water makes it take shelter under the eaves of houses in rain. It uses pom-poms made of sparks for cheering."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It cheers on friends. If its friends are losing, its body lets off more and more sparks."}, {"versions": ["heartgold", "soulsilver"], "text": "Exposure to electricity from MINUN and PLUSLE promotes blood circulation and relaxes muscles."}, {"versions": ["x"], "text": "Exposure to electricity from Minun and Plusle promotes blood circulation and relaxes muscles."},