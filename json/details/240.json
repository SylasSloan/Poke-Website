{"height": 7, "weight": 214, "base_experience": 73, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Live Coal Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["no-eggs"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "ブビィ"}, {"language": "ja-roma", "name": "Buby"}, {"language": "ko", "name": "마그비"}, {"language": "zh-hant", "name": "鴨嘴寶寶"}, {"language": "fr", "name": "Magby"}, {"language": "de", "name": "Magby"}, {"language": "es", "name": "Magby"}, {"language": "it", "name": "Magby"}, {"language": "ja", "name": "ブビィ"}, {"language": "zh-hans", "name": "鸭嘴宝宝"}, {"language": "es-419", "name": "Magby"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "Each and every time it inhales and exhales, hot embers dribble out of its mouth and nostrils."}, {"versions": ["silver"], "text": "It is found in volcanic craters. Its body temp. is over 1100 degrees, so don't under­ estimate it."}, {"versions": ["crystal"], "text": "It naturally spits an 1100-degree flame. It is said when many appear, it heralds a volcanic eruption."}, {"versions": ["ruby", "sapphire"], "text": "MAGBY’s state of health is determined by observing the fire it breathes. If the POKéMON is spouting yellow flames from its mouth, it is in good health. When it is fatigued, black smoke will be mixed in with the flames."}, {"versions": ["emerald"], "text": "If a MAGBY is spouting yellow flames from its mouth, it is in good health. When it is fatigued, black smoke will be mixed in with the flames."}, {"versions": ["firered"], "text": "It is found in volcanic craters. Its body heat exceeds 1,100 degrees Fahrenheit, so don’t underestimate it."}, {"versions": ["diamond", "pearl"], "text": "Its body temperature is around 1,100 degrees F. It is healthy if it is breathing yellow flames."}, {"versions": ["platinum", "black", "white"], "text": "Its magma-like blood circulates throughout its body. Its body’s heat can top 1,100 degrees F."}, {"versions": ["heartgold"], "text": "Each and every time it inhales and exhales, hot embers dribble from its mouth and nostrils."}, {"versions": ["soulsilver"], "text": "It is found in volcanic craters. Its body temperature is over 1,100 degrees Fahrenheit, so don’t underestimate it."}, {"versions": ["black-2", "white-2"], "text": "It’s small, but its body temperature is over 1,100 degrees F. Embers escape its mouth and nose when it breathes."}, {"versions": ["x"], "text": "It’s small, but its body temperature is over 1,100 degrees Fahrenheit. Embers escape its mouth and nose when it breathes."}, {"versions": ["y"], "text": "Its magma-like blood circulates throughout its body. Its body’s heat can top 1,100 degrees Fahrenheit."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Magby’s state of health is determined by observing the fire it breathes. If the Pokémon is spouting yellow flames from its mouth, it is in good health. When it is fatigued, black smoke will be mixed in with the flames."}, {"versions": ["sun"], "text": "Many of these Pokémon can be seen in areas with volcanic activity. Feeding can get them so excited, they exhale flames of 1,100 degrees F."}, {"versions": ["moon"], "text": "A famous potter lives with a Magby. Apparently its soft flames produce fine works."}, {"versions": ["ultra-sun"], "text": "When flames drip from its nose, that means it has a cold. Have it lie down for a nice rest in some magma."}, {"versions": ["ultra-moon"], "text": "Its body temperature is always around 1,100 degrees Fahrenheit. If Magby falls into a small- enough pond, the whole thing will dry up."}, {"versions": ["sword"], "text": "This Pokémon is still small and timid. Whenever Magby gets excited or surprised, flames leak from its mouth and its nose."}, {"versions": ["shield"], "text": "This Pokémon makes its home near volcanoes. At the end of the day, Magby soaks in magma, resting and recovering from the day’s fatigue."}, {"versions": ["legends-arceus"], "text": "This Pokémon lives in volcanic areas. With each breath, sparks spurt from its mouth and nose. When Magby is in good health, its flames gain a yellow tint."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/240.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/240.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/240.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/240.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/240.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/240.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/240.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/240.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/240.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/240.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/240.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/240.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/