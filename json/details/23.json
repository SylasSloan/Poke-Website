{"height": 20, "weight": 69, "base_experience": 58, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Snake Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アーボ"}, {"language": "ja-roma", "name": "Arbo"}, {"language": "ko", "name": "아보"}, {"language": "zh-hant", "name": "阿柏蛇"}, {"language": "fr", "name": "Abo"}, {"language": "de", "name": "Rettan"}, {"language": "es", "name": "Ekans"}, {"language": "it", "name": "Ekans"}, {"language": "ja", "name": "アーボ"}, {"language": "zh-hans", "name": "阿柏蛇"}, {"language": "es-419", "name": "Ekans"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Moves silently and stealthily. Eats the eggs of birds, such as PIDGEY and SPEAROW, whole."}, {"versions": ["yellow", "x", "lets-go-pikachu", "lets-go-eevee"], "text": "The older it gets, the longer it grows. At night, it wraps its long body around tree branches to rest."}, {"versions": ["gold"], "text": "It can freely de­ tach its jaw to swallow large prey whole. It can be­ come too heavy to move, however."}, {"versions": ["silver", "soulsilver"], "text": "It always hides in grass. When first born, it has no poison, so its bite is painful, but harmless."}, {"versions": ["crystal"], "text": "It flutters the tip of its tongue to seek out the scent of prey, then swallows the prey whole."}, {"versions": ["ruby", "sapphire"], "text": "EKANS curls itself up in a spiral while it rests. Assuming this position allows it to quickly respond to a threat from any direction with a glare from its upraised head."}, {"versions": ["emerald"], "text": "An EKANS curls itself up in a spiral while it rests. This position allows it to quickly respond to an enemy from any direction with a threat from its upraised head."}, {"versions": ["firered"], "text": "A very common sight in grassland, etc. It flicks its tongue in and out to sense danger in its surroundings."}, {"versions": ["leafgreen"], "text": "Moving silently and stealthily, it eats the eggs of birds, such as PIDGEY and SPEAROW, whole."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It sneaks through grass without making a sound and strikes unsuspecting prey from behind."}, {"versions": ["heartgold"], "text": "It can freely detach its jaw to swallow large prey whole. It can become too heavy to move, however."}, {"versions": ["y"], "text": "Moving silently and stealthily, it eats the eggs of birds, such as Pidgey and Spearow, whole."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Ekans curls itself up in a spiral while it rests. Assuming this position allows it to quickly respond to a threat from any direction with a glare from its upraised head."}, {"versions": ["ultra-sun"], "text": "By dislocating its jaw, it can swallow prey larger than itself. After a meal, it curls up and rests."}, {"versions": ["ultra-moon"], "text": "The eggs of bird Pokémon are its favorite food. It swallows eggs whole, so sometimes an egg gets stuck, and Ekans faints."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/23.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/23.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/23.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/23.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/23.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/g