{"height": 16, "weight": 550, "base_experience": 159, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Bat Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴルバット"}, {"language": "ja-roma", "name": "Golbat"}, {"language": "ko", "name": "골뱃"}, {"language": "zh-hant", "name": "大嘴蝠"}, {"language": "fr", "name": "Nosferalto"}, {"language": "de", "name": "Golbat"}, {"language": "es", "name": "Golbat"}, {"language": "it", "name": "Golbat"}, {"language": "ja", "name": "ゴルバット"}, {"language": "zh-hans", "name": "大嘴蝠"}, {"language": "es-419", "name": "Golbat"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Once it strikes, it will not stop draining energy from the victim even if it gets too heavy to fly."}, {"versions": ["yellow"], "text": "It attacks in a stealthy manner, without warning. Its sharp fangs are used to bite and suck blood."}, {"versions": ["gold"], "text": "However hard its victim's hide may be, it punctures with sharp fangs and gorges itself with blood."}, {"versions": ["silver", "soulsilver"], "text": "It can drink more than 10 ounces of blood at once. If it has too much, it gets heavy and flies clumsily."}, {"versions": ["crystal"], "text": "When it plunges its fangs into its prey, it instantly draws and gulps down more than ten ounces of blood."}, {"versions": ["ruby"], "text": "GOLBAT loves to drink the blood of living things. It is particularly active in the pitch black of night. This POKéMON flits around in the night skies, seeking fresh blood."}, {"versions": ["sapphire"], "text": "GOLBAT bites down on prey with its four fangs and drinks the victim’s blood. It becomes active on inky dark moonless nights, flying around to attack people and POKéMON."}, {"versions": ["emerald"], "text": "Its fangs easily puncture even thick animal hide. It loves to feast on the blood of people and POKéMON. It flits about in darkness and strikes from behind."}, {"versions": ["firered"], "text": "It clamps down on its prey with needle- sharp fangs and drains over 10 ounces of blood in one gulp."}, {"versions": ["leafgreen", "x"], "text": "Once it bites, it will not stop draining energy from the victim even if it gets too heavy to fly."}, {"versions": ["diamond"], "text": "It loves the blood of humans and Pokémon. It flies around at night in search of neck veins."}, {"versions": ["pearl", "y"], "text": "Once it starts sucking blood, it does not stop until it is full. It flies at night in search of prey."}, {"versions": ["platinum", "black", "white"], "text": "Its sharp fangs puncture the toughest of hides and have small holes for greedily sucking blood."}, {"versions": ["heartgold"], "text": "However hard its victim’s hide may be, it punctures with sharp fangs and gorges itself with blood."}, {"versions": ["black-2", "white-2"], "text": "Flitting around in the dead of night, it sinks its fangs into its prey and drains a nearly fatal amount of blood."}, {"versions": ["omega-ruby"], "text": "Golbat loves to drink the blood of living things. It is particularly active in the pitch black of night. This Pokémon flits around in the night skies, seeking fresh blood."}, {"versions": ["alpha-sapphire"], "text": "Golbat bites down on prey with its four fangs and drinks the victim’s blood. It becomes active on inky dark moonless nights, flying around to attack people and Pokémon."}, {"versions": ["sun"], "text": "Its thick fangs are hollow like straws, making them unexpectedly fragile. These fangs are specialized for sucking blood."}, {"versions": ["moon"], "text": "Sometimes they drink so much blood, they can’t fly anymore. Then they fall to the ground and become food for other Pokémon."}, {"versions": ["ultra-sun"], "text": "Every once in a while, you’ll see a Golbat that’s missing some fangs. This happens when hunger drives it to try biting a Steel-type Pokémon."}, {"versions": ["ultra-moon"], "text": "They can suck down over 10 ounces of blood in one go. They have been known to drink so much blood that they can no longer fly."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "It attacks in a stealthy manner, without warning. Its sharp fangs are used to bite and to suck blood."}, {"versions": ["sword"], "text": "It loves to drink other creatures’ blood. It’s said that if it finds others of its kind going hungry, it sometimes shares the blood it’s gathered."}, {"versions": ["shield"], "text": "Its feet are tiny, but this Pokémon walks skillfully. It sneaks up on sleeping prey before sinking in its fangs and slurping up blood."}, {"versions": ["legends-arceus"], "text": "It sinks its sharp fangs into other creatures and slurps up their blood. A closer look at the fangs reveals that they are hollow and akin to straws."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/42.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/42.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/42.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/42.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/42.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/42.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/42.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/42.png"}}, "