{"height": 15, "weight": 1325, "base_experience": 184, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Bivalve Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "パルシェン"}, {"language": "ja-roma", "name": "Parshen"}, {"language": "ko", "name": "파르셀"}, {"language": "zh-hant", "name": "刺甲貝"}, {"language": "fr", "name": "Crustabri"}, {"language": "de", "name": "Austos"}, {"language": "es", "name": "Cloyster"}, {"language": "it", "name": "Cloyster"}, {"language": "ja", "name": "パルシェン"}, {"language": "zh-hans", "name": "刺甲贝"}, {"language": "es-419", "name": "Cloyster"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "When attacked, it launches its horns in quick volleys. Its innards have never been seen."}, {"versions": ["yellow"], "text": "For protection, it uses its harder- than-diamonds shell. It also shoots spikes from the shell."}, {"versions": ["gold"], "text": "Once it slams its shell shut, it is impossible to open, even by those with superi­ or strength."}, {"versions": ["silver", "soulsilver"], "text": "CLOYSTER that live in seas with harsh tidal currents grow large, sharp spikes on their shells."}, {"versions": ["crystal"], "text": "Even a missile can't break the spikes it uses to stab opponents. They're even hard­ er than its shell."}, {"versions": ["ruby", "sapphire"], "text": "CLOYSTER is capable of swimming in the sea. It does so by swallowing water, then jetting it out toward the rear. This POKéMON shoots spikes from its shell using the same system."}, {"versions": ["emerald"], "text": "It swims in the sea by swallowing water, then jetting it out toward the rear. The CLOYSTER shoots spikes from its shell using the same system."}, {"versions": ["firered", "y", "sword"], "text": "Its shell is extremely hard. It cannot be shattered, even with a bomb. The shell opens only when it is attacking."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It fights by keeping its shell tightly shut for protection and by shooting spikes to repel foes."}, {"versions": ["heartgold", "shield"], "text": "Once it slams its shell shut, it is impossible to open, even by those with superior strength."}, {"versions": ["x"], "text": "Cloyster that live in seas with harsh tidal currents grow large, sharp spikes on their shells."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Cloyster is capable of swimming in the sea. It does so by swallowing water, then jetting it out toward the rear. This Pokémon shoots spikes from its shell using the same system."}, {"versions": ["sun"], "text": "Its hard shell cannot be shattered—not even by a bomb. The contents of the shell remain unknown."}, {"versions": ["moon"], "text": "Excavation of the tombs of ancient hunting tribes has turned up many spears tipped with spikes that had fallen off this Pokémon’s shell."}, {"versions": ["ultra-sun"], "text": "If areas of Cloyster’s very hard shell get damaged, those areas swell, gradually growing into large sharp spikes."}, {"versions": ["ultra-moon"], "text": "Slowpoke tails are its favorite food. It has even been known to come up on land to look for Slowpoke from time to time."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "For protection, it uses its harder-than-diamond shell. It also shoots spikes from the shell."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/91.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/91.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/91.png", "shiny": "https://raw.githubus