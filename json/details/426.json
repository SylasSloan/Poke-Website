{"height": 12, "weight": 150, "base_experience": 174, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Blimp Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "fast-then-very-slow", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "フワライド"}, {"language": "ja-roma", "name": "Fuwaride"}, {"language": "ko", "name": "둥실라이드"}, {"language": "zh-hant", "name": "隨風球"}, {"language": "fr", "name": "Grodrive"}, {"language": "de", "name": "Drifzepeli"}, {"language": "es", "name": "Drifblim"}, {"language": "it", "name": "Drifblim"}, {"language": "ja", "name": "フワライド"}, {"language": "zh-hans", "name": "随风球"}, {"language": "es-419", "name": "Drifblim"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It’s drowzy in daytime, but flies off in the evening in big groups. No one knows where they go."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It carries people and Pokémon when it flies. But since it only drifts, it can end up anywhere."}, {"versions": ["platinum", "black", "white"], "text": "At dusk, swarms of them are carried aloft on winds. When noticed, they suddenly vanish."}, {"versions": ["heartgold", "soulsilver"], "text": "It can generate and release gas within its body. That’s how it can control the altitude of its drift."}, {"versions": ["black-2", "white-2"], "text": "They carry people and Pokémon, but the wind can catch them, so there can’t be a fixed destination."}, {"versions": ["y", "alpha-sapphire"], "text": "It’s drowsy in daytime, but flies off in the evening in big groups. No one knows where they go."}, {"versions": ["sun"], "text": "There was once an incident in which a man took a trip riding a Drifblim, only to go missing."}, {"versions": ["moon"], "text": "Even while under careful observation, large flocks of Drifblim flying at dusk will inexplicably disappear from view."}, {"versions": ["ultra-sun"], "text": "There’s a rumor that if you catch a Drifblim floating on the wind at dusk, you’ll be carried away to the afterlife."}, {"versions": ["ultra-moon"], "text": "The raw material for the gas inside its body is souls. When its body starts to deflate, it’s thought to carry away people and Pokémon."}, {"versions": ["sword"], "text": "Some say this Pokémon is a collection of souls burdened with regrets, silently drifting through the dusk."}, {"versions": ["shield"], "text": "It grabs people and Pokémon and carries them off somewhere. Where do they go? Nobody knows."}, {"versions": ["legends-arceus"], "text": "It drifts along at dusk, perfectly silent. Its transient, melancholy aspect touches some people deeply—every so often, one will come upon a song or poem devoted to Drifblim."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/426.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/426.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/426.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/426.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/426.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/426.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/426.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/426.png", "shiny": "https://