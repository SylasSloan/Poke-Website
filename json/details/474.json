{"height": 9, "weight": 340, "base_experience": 241, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Virtual Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ポリゴンＺ"}, {"language": "ja-roma", "name": "Porygon-Z"}, {"language": "ko", "name": "폴리곤Z"}, {"language": "zh-hant", "name": "多邊獸Ｚ"}, {"language": "fr", "name": "Porygon-Z"}, {"language": "de", "name": "Porygon-Z"}, {"language": "es", "name": "Porygon-Z"}, {"language": "it", "name": "Porygon-Z"}, {"language": "ja", "name": "ポリゴンＺ"}, {"language": "zh-hans", "name": "多边兽乙型"}, {"language": "es-419", "name": "Porygon-Z"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "x", "omega-ruby"], "text": "Additional software was installed to make it a better Pokémon. It began acting oddly, however."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Its programming was modified to enable work in alien dimensions. It did not work as planned."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "Its programming was modified to enable it to travel through alien dimensions. Seems there might have been an error..."}, {"versions": ["sun"], "text": "In order to create a more advanced Pokémon, an additional program was installed, but apparently it contained a defect that makes it move oddly."}, {"versions": ["moon"], "text": "Its program was modified to facilitate extra-dimensional activities, but that led to noticeably strange behavior."}, {"versions": ["ultra-sun"], "text": "Its behavior is noticeably unstable, which is apparently due to the incompetence of the engineer who updated its programming."}, {"versions": ["ultra-moon"], "text": "A faulty update was added to its programming. Its behavior is noticeably strange, so the experiment may have been a failure."}, {"versions": ["sword"], "text": "Porygon-Z had a program ins