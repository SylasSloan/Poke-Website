{"height": 5, "weight": 26, "base_experience": 44, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Water Weed Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["water1", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハスボー"}, {"language": "ja-roma", "name": "Hassboh"}, {"language": "ko", "name": "연꽃몬"}, {"language": "zh-hant", "name": "蓮葉童子"}, {"language": "fr", "name": "Nénupiot"}, {"language": "de", "name": "Loturzel"}, {"language": "es", "name": "Lotad"}, {"language": "it", "name": "Lotad"}, {"language": "ja", "name": "ハスボー"}, {"language": "zh-hans", "name": "莲叶童子"}, {"language": "es-419", "name": "Lotad"}], "pokedex_entries": [{"versions": ["ruby"], "text": "LOTAD live in ponds and lakes, where they float on the surface. It grows weak if its broad leaf dies. On rare occasions, this POKéMON travels on land in search of clean water."}, {"versions": ["sapphire"], "text": "LOTAD is said to have dwelled on land before. However, this POKéMON is thought to have returned to water because the leaf on its head grew large and heavy. It now lives by floating atop the water."}, {"versions": ["emerald"], "text": "This POKéMON lives in ponds with clean water. It is known to ferry small POKéMON across ponds by carrying them on the broad leaf on its head."}, {"versions": ["firered", "leafgreen", "y", "sword"], "text": "It searches about for clean water. If it does not drink water for too long, the leaf on its head wilts."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It looks like an aquatic plant and serves as a ferry to Pokémon that can’t swim."}, {"versions": ["heartgold", "soulsilver", "shield"], "text": "Its leaf grew too large for it to live on land. That is how it began to live floating in the water."}, {"versions": ["omega-ruby"], "text": "Lotad live in ponds and lakes, where they float on the surface. It grows weak if its broad leaf dies. On rare occasions, this Pokémon travels on land in search of clean water."}, {"versions": ["alpha-sapphire"], "text": "Lotad is said to have dwelled on land before. However, this Pokémon is thought to have returned to water because the leaf on its head grew large and heavy. It now lives by floating atop the water."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/270.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/270.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/270.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/270.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/270.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/270.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/270.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/270.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/270.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/270.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/270.png"