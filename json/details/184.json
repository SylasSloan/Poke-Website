{"height": 8, "weight": 285, "base_experience": 189, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Aqua Rabbit Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["water1", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マリルリ"}, {"language": "ja-roma", "name": "Marilli"}, {"language": "ko", "name": "마릴리"}, {"language": "zh-hant", "name": "瑪力露麗"}, {"language": "fr", "name": "Azumarill"}, {"language": "de", "name": "Azumarill"}, {"language": "es", "name": "Azumarill"}, {"language": "it", "name": "Azumarill"}, {"language": "ja", "name": "マリルリ"}, {"language": "zh-hans", "name": "玛力露丽"}, {"language": "es-419", "name": "Azumarill"}], "pokedex_entries": [{"versions": ["gold"], "text": "By keeping still and listening in­ tently, it can tell what is in even wild, fast- moving rivers."}, {"versions": ["silver"], "text": "When it plays in water, it rolls up its elongated ears to prevent their insides from get­ ting wet."}, {"versions": ["crystal"], "text": "The bubble-like pattern on its stomach helps it camouflage itself when it's in the water."}, {"versions": ["ruby"], "text": "AZUMARILL’s long ears are indispensable sensors. By focusing its hearing, this POKéMON can identify what kinds of prey are around, even in rough and fast-running rivers."}, {"versions": ["sapphire"], "text": "AZUMARILL can make balloons out of air. It makes these air balloons if it spots a drowning POKéMON. The air balloons enable the POKéMON in trouble to breathe."}, {"versions": ["emerald"], "text": "It lives in water virtually all day long. Its body color and pattern act as camouflage that makes it tough for enemies to spot in water."}, {"versions": ["firered", "soulsilver"], "text": "When it plays in water, it rolls up its elongated ears to prevent their insides from getting wet."}, {"versions": ["leafgreen"], "text": "By keeping still and listening intently, it can even tell what is in wild, fast-moving rivers."}, {"versions": ["diamond"], "text": "It lives in rivers and lakes. In water, its coloring and patterns trick the vision of foes."}, {"versions": ["pearl", "x"], "text": "Its long ears are superb sensors. It can distinguish the movements of living things on riverbeds."}, {"versions": ["platinum", "black", "white"], "text": "It can spend all day in water, since it can inhale and store a large volume of air."}, {"versions": ["heartgold"], "text": "By keeping still and listening intently, it can tell what is in even wild, fast-moving rivers."}, {"versions": ["black-2", "white-2"], "text": "Its long ears are superb sensors. It can distinguish the movements of things in water and tell what they are."}, {"versions": ["y"], "text": "The bubble-like pattern on its stomach helps it camouflage itself when it’s in the water."}, {"versions": ["omega-ruby"], "text": "Azumarill’s long ears are indispensable sensors. By focusing its hearing, this Pokémon can identify what kinds of prey are around, even in rough and fast-running rivers."}, {"versions": ["alpha-sapphire"], "text": "Azumarill can make balloons out of air. It makes these air balloons if it spots a drowning Pokémon. The air balloons enable the Pokémon in trouble to breathe."}, {"versions": ["sword"], "text": "It spends most of its time in the water. On sunny days, Azumarill floats on the surface of the water and sunbathes."}, {"versions": ["shield"], "text": "These Pokémon create air-filled bubbles. When Azurill play in rivers, Azumarill will cover them with these bubbles."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/184.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/184.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/184.png", "shiny": "ht