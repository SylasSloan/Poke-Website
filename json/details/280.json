{"height": 4, "weight": 66, "base_experience": 40, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Feeling Pokémon", "capture_rate": 235, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["humanshape", "indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ラルトス"}, {"language": "ja-roma", "name": "Ralts"}, {"language": "ko", "name": "랄토스"}, {"language": "zh-hant", "name": "拉魯拉絲"}, {"language": "fr", "name": "Tarsal"}, {"language": "de", "name": "Trasla"}, {"language": "es", "name": "Ralts"}, {"language": "it", "name": "Ralts"}, {"language": "ja", "name": "ラルトス"}, {"language": "zh-hans", "name": "拉鲁拉丝"}, {"language": "es-419", "name": "Ralts"}], "pokedex_entries": [{"versions": ["ruby"], "text": "RALTS senses the emotions of people using the horns on its head. This POKéMON rarely appears before people. But when it does, it draws closer if it senses that the person has a positive disposition."}, {"versions": ["sapphire"], "text": "RALTS has the ability to sense the emotions of people. If its TRAINER is in a cheerful mood, this POKéMON grows cheerful and joyous in the same way."}, {"versions": ["emerald"], "text": "A RALTS has the power to sense the emotions of people and POKéMON with the horns on its head. It takes cover if it senses any hostility."}, {"versions": ["firered", "leafgreen"], "text": "It is highly attuned to the emotions of people and POKéMON. It hides if it senses hostility."}, {"versions": ["diamond", "pearl"], "text": "It uses the horns on its head to sense human emotions. It is said to appear in front of cheerful people."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x", "shield"], "text": "If its horns capture the warm feelings of people or Pokémon, its body warms up slightly."}, {"versions": ["heartgold", "soulsilver"], "text": "The horns on its head provide a strong power that enables it to sense people’s emotions."}, {"versions": ["y", "sword"], "text": "