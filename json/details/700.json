{"height": 10, "weight": 235, "base_experience": 184, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Intertwining Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "es", "name": "Sylveon"}, {"language": "it", "name": "Sylveon"}, {"language": "ja-hrkt", "name": "ニンフィア"}, {"language": "ja-roma", "name": "Nymphia"}, {"language": "ko", "name": "님피아"}, {"language": "zh-hant", "name": "仙子伊布"}, {"language": "fr", "name": "Nymphali"}, {"language": "de", "name": "Feelinara"}, {"language": "ja", "name": "ニンフィア"}, {"language": "zh-hans", "name": "仙子伊布"}, {"language": "es-419", "name": "Sylveon"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "It sends a soothing aura from its ribbonlike feelers to calm fights."}, {"versions": ["y", "alpha-sapphire"], "text": "It wraps its ribbonlike feelers around the arm of its beloved Trainer and walks with him or her."}, {"versions": ["sun"], "text": "Its ribbonlike feelers give off an aura that weakens hostility in its prey, causing them to let down their guard. Then it attacks."}, {"versions": ["moon"], "text": "When this Pokémon sights its prey, it swirls its ribbonlike feelers as a distraction. A moment later, it pounces."}, {"versions": ["ultra-sun"], "text": "Once a fight breaks out, it will unflinchingly charge at dragon Pokémon that are many times larger than itself."}, {"versions": ["ultra-moon"], "text": "Sylveon wraps its ribbonlike feelers around its Trainer’s arm because this touch enables it to read its Trainer’s feelings."}, {"versions": ["sword"], "text": "By releasing enmity-erasing waves from its ribbonlike feelers, Sylveon stops any conflict."}, {"versions": ["shield"], "text": "There’s a Galarian fairy tale that describes a beautiful Sylveon vanquishing a dreadful dragon Pokémon."}, {"versions": ["legends-arceus"], "text": "It emits a soothing aura from its ribbon-shaped or