{"height": 4, "weight": 75, "base_experience": 71, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Spiral Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["water1", "water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "オムナイト"}, {"language": "ja-roma", "name": "Omnite"}, {"language": "ko", "name": "암나이트"}, {"language": "zh-hant", "name": "菊石獸"}, {"language": "fr", "name": "Amonita"}, {"language": "de", "name": "Amonitas"}, {"language": "es", "name": "Omanyte"}, {"language": "it", "name": "Omanyte"}, {"language": "ja", "name": "オムナイト"}, {"language": "zh-hans", "name": "菊石兽"}, {"language": "es-419", "name": "Omanyte"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Although long extinct, in rare cases, it can be genetically resurrected from fossils."}, {"versions": ["yellow"], "text": "An ancient POKéMON that was recovered from a fossil. It swims by cleverly twisting its 10 tentacles about."}, {"versions": ["gold"], "text": "Revived from an ancient fossil, this POKéMON uses air stored in its shell to sink and rise in water."}, {"versions": ["silver"], "text": "This POKéMON from ancient times is said to have navi­ gated the sea by adeptly twisting its 10 tentacles."}, {"versions": ["crystal"], "text": "In prehistoric times, it swam on the sea floor, eating plankton. Its fossils are sometimes found."}, {"versions": ["ruby", "sapphire"], "text": "OMANYTE is one of the ancient and long- since-extinct POKéMON that have been regenerated from fossils by people. If attacked by an enemy, it withdraws itself inside its hard shell."}, {"versions": ["emerald"], "text": "One of the ancient and long-since-extinct POKéMON that have been regenerated from fossils by humans. If attacked, it withdraws into its hard shell."}, {"versions": ["firered"], "text": "A prehistoric POKéMON that lived in the primordial sea, it swims by twisting its 10 tentacles about."}, {"versions": ["leafgreen"], "text": "Although long extinct, in rare cases, it can be genetically regenerated from fossils."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "A Pokémon that was resurrected from a fossil using modern science. It swam in ancient seas."}, {"versions": ["heartgold", "y"], "text": "Revived from an ancient fossil, this Pokémon uses air stored in its shell to sink and rise in water."}, {"versions": ["soulsilver"], "text": "This Pokémon from ancient times is said to have navigated the sea by adeptly twisting its 10 tentacles."}, {"versions": ["x"], "text": "A prehistoric Pokémon that lived in the primordial sea, it swims by twisting its 10 tentacles about."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Omanyte is one of the ancient and long-since-extinct Pokémon that have been regenerated from fossils by people. If attacked by an enemy, it withdraws itself inside its hard shell."}, {"versions": ["ultra-sun"], "text": "Omanyte lived in the seas of antiquity. Its fossils have been found bearing bite marks from Archeops, so apparently Archeops preyed on it."}, {"versions": ["ultra-moon"], "text": "It was restored from an ancient fossil. Those Helix Fossils are excavated from areas that were once oceans long, long ago."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "An ancient Pokémon that was recovered from a fossil. It swam by cleverly twisting its 10 tentacles about."}, {"versions": ["sword"], "text": "Because some Omanyte manage to escape after being restored or are released into the wild by people, this species is becoming a problem."}, {"versions": ["shield"], "text": "This Pokémon is a member of an ancient, extinct species. Omanyte paddles through water with its 10 tentacles, looking like it’s just drifting along."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/138.png",