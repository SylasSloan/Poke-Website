{"height": 8, "weight": 365, "base_experience": 79, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Virtual Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ポリゴン"}, {"language": "ja-roma", "name": "Porygon"}, {"language": "ko", "name": "폴리곤"}, {"language": "zh-hant", "name": "多邊獸"}, {"language": "fr", "name": "Porygon"}, {"language": "de", "name": "Porygon"}, {"language": "es", "name": "Porygon"}, {"language": "it", "name": "Porygon"}, {"language": "ja", "name": "ポリゴン"}, {"language": "zh-hans", "name": "多边兽"}, {"language": "es-419", "name": "Porygon"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A POKéMON that consists entirely of programming code. Capable of moving freely in cyberspace."}, {"versions": ["yellow"], "text": "The only POKéMON people anticipate can fly into space. None has managed the feat yet, however."}, {"versions": ["gold"], "text": "It is a manmade POKéMON. Since it doesn't breathe, people are eager to try it in any environment."}, {"versions": ["silver"], "text": "A manmade POKéMON that came about as a result of re­ search. It is pro­ grammed with only basic motions."}, {"versions": ["crystal"], "text": "An artificial POKéMON created due to extensive research, it can perform only what is in its program."}, {"versions": ["ruby", "sapphire"], "text": "PORYGON is capable of reverting itself entirely back to program data and entering cyberspace. This POKéMON is copy-protected so it cannot be duplicated by copying."}, {"versions": ["emerald"], "text": "It is capable of reverting itself entirely back to program data in order to enter cyberspace. A PORYGON is copy- protected so it cannot be duplicated."}, {"versions": ["firered"], "text": "Using the most advanced technologies, scientists finally succeeded in making the first artificial POKéMON."}, {"versions": ["leafgreen"], "text": "A POKéMON that consists entirely of programming code. It is capable of moving freely in cyberspace."}, {"versions": ["diamond", "pearl"], "text": "The world’s first artificially created Pokémon. It can travel through electronic space."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "A man-made Pokémon created using advanced scientific means. It can move freely in cyberspace."}, {"versions": ["heartgold"], "text": "It is a manmade Pokémon. Since it doesn’t breathe, people are eager to try it in any environment."}, {"versions": ["soulsilver"], "text": "A manmade Pokémon that came about as a result of research. It is programmed with only basic motions."}, {"versions": ["x"], "text": "A man-made Pokémon that came about as a result of research. It is programmed with only basic motions."}, {"versions": ["y"], "text": "A Pokémon that consists entirely of programming code. It is capable of moving freely in cyberspace."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Porygon is capable of reverting itself entirely back to program data and entering cyberspace. This Pokémon is copy protected so it cannot be duplicated by copying."}, {"versions": ["sun"], "text": "Roughly 20 years ago, it was artificially created, utilizing the latest technology of the time."}, {"versions": ["moon"], "text": "It can convert its body into digital data, which enables it to enter cyberspace."}, {"versions": ["ultra-sun"], "text": "This Pokémon was created using the cutting-edge science of 20 years ago, so many parts of it have since become obsolete."}, {"versions": ["ultra-moon"], "text": "It was built 20 years ago by scientists who dreamed of exploring space. Their dreams have yet to come true."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "The only Pokémon that people anticipate can fly into space. None has managed the feat yet, however."}, {"versions": ["sword"], "text": "State-of-the-art technology was used to create Porygon. It was the first artificial Pokémon to be created via computer programming."}, {"versions": ["shield"], "text": "In recent years, this species has been very helpful in cyberspace. These Pokémon will go around checking to make sure no suspicious data exists."}, {"versions": ["legends-arceus"], "text": "It has no discernible heartbeat and does not seem to draw breath, and yet it appears to function without issue. I cannot even begin to explain this utterly bizarre anomaly."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/137.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/137.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/137.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/137.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/137.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/137.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/137.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/137.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/137.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/137.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/spr