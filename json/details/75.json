{"height": 10, "weight": 1050, "base_experience": 137, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Rock Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴローン"}, {"language": "ja-roma", "name": "Golone"}, {"language": "ko", "name": "데구리"}, {"language": "zh-hant", "name": "隆隆石"}, {"language": "fr", "name": "Gravalanch"}, {"language": "de", "name": "Georok"}, {"language": "es", "name": "Graveler"}, {"language": "it", "name": "Graveler"}, {"language": "ja", "name": "ゴローン"}, {"language": "zh-hans", "name": "隆隆石"}, {"language": "es-419", "name": "Graveler"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "y"], "text": "Rolls down slopes to move. It rolls over any obstacle without slowing or changing its direction."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Often seen rolling down mountain trails. Obstacles are just things to roll straight over, not avoid."}, {"versions": ["gold"], "text": "With a free and uncaring nature, it doesn't mind if pieces break off while it rolls down mountains."}, {"versions": ["silver", "soulsilver"], "text": "A slow walker, it rolls to move. It pays no attention to any object that happens to be in its path."}, {"versions": ["crystal"], "text": "It travels by rol­ ling on mountain paths. If it gains too much speed, it stops by running into huge rocks."}, {"versions": ["ruby"], "text": "GRAVELER grows by feeding on rocks. Apparently, it prefers to eat rocks that are covered in moss. This POKéMON eats its way through a ton of rocks on a daily basis."}, {"versions": ["sapphire"], "text": "Rocks are GRAVELER’s favorite food. This POKéMON will climb a mountain from the base to the summit, crunchingly feasting on rocks all the while. Upon reaching the peak, it rolls back down to the bottom."}, {"versions": ["emerald"], "text": "They descend from mountains by tumbling down steep slopes. They are so brutal, they smash aside obstructing trees and massive boulders with thunderous tackles."}, {"versions": ["firered"], "text": "Be careful while hiking on mountain trails. GRAVELER may come rolling down the path without slowing."}, {"versions": ["diamond"], "text": "GRAVELER make their homes on sheer cliff faces by gouging out numerous horizontal holes."}, {"versions": ["pearl"], "text": "It tumbles down slopes, heedless of any body parts chipping off. It eats a ton of rocks daily."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It rolls on mountain paths to move. Once it builds momentum, no Pokémon can stop it without difficulty."}, {"versions": ["heartgold", "x"], "text": "With a free and uncaring nature, it doesn’t mind if pieces break off while it rolls down mountains."}, {"versions": ["omega-ruby"], "text": "Graveler grows by feeding on rocks. Apparently, it prefers to eat rocks that are covered in moss. This Pokémon eats its way through a ton of rocks on a daily basis."}, {"versions": ["alpha-sapphire"], "text": "Rocks are Graveler’s favorite food. This Pokémon will climb a mountain from the base to the summit, crunchingly feasting on rocks all the while. Upon reaching the peak, it rolls back down to the bottom."}, {"versions": ["sun"], "text": "Mossy rocks are its favorite food. It can devour a ton a day while crunching loudly."}, {"versions": ["moon"], "text": "This slow-footed Pokémon moves by curling up and rolling instead of walking. With enough momentum, its speed can exceed 60 mph."}, {"versions": ["ultra-sun"], "text": "It climbs up cliffs as it heads toward the peak of a mountain. As soon as it reaches the summit, it rolls back down the way it came."}, {"versions": ["ultra-moon"], "text": "It travels by rolling down cliffs. If it falls into a river, it will explode with its last gasp."}, {"versions": ["legends-arceus"], "text": "Dwells in holes dug into sheer walls of stone. It enjoys rolling down slopes as though it were a boulder during a rockfall, so keep an eye upward while traversing mountain roads."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/75.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/75.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/75.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/75.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/75.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/75.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/75.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/75.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/75.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/75.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/75.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/75.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapp