{"height": 12, "weight": 666, "base_experience": 172, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Ball Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "マルマイン"}, {"language": "ja-roma", "name": "Marumine"}, {"language": "ko", "name": "붐볼"}, {"language": "zh-hant", "name": "頑皮雷彈"}, {"language": "fr", "name": "Électrode"}, {"language": "de", "name": "Lektrobal"}, {"language": "es", "name": "Electrode"}, {"language": "it", "name": "Electrode"}, {"language": "ja", "name": "マルマイン"}, {"language": "zh-hans", "name": "顽皮雷弹"}, {"language": "es-419", "name": "Electrode"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "It stores electric energy under very high pressure. It often explodes with little or no provocation."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Stores electrical energy inside its body. Even the slightest shock could trigger a huge explosion."}, {"versions": ["gold", "heartgold"], "text": "It is dangerous. If it has too much electricity and has nothing to do, it amuses itself by exploding."}, {"versions": ["silver"], "text": "It stores an over­ flowing amount of electric energy inside its body. Even a small shock makes it explode."}, {"versions": ["crystal"], "text": "The more energy it charges up, the faster it gets. But this also makes it more likely to explode."}, {"versions": ["ruby"], "text": "ELECTRODE eats electricity in the atmosphere. On days when lightning strikes, you can see this POKéMON exploding all over the place from eating too much electricity."}, {"versions": ["sapphire"], "text": "One of ELECTRODE’s characteristics is its attraction to electricity. It is a problematical POKéMON that congregates mostly at electrical power plants to feed on electricity that has just been generated."}, {"versions": ["emerald"], "text": "They appear in great numbers at electric power plants. Because they feed on electricity, they cause massive and chaotic blackouts in nearby cities."}, {"versions": ["firered", "x"], "text": "It explodes in response to even minor stimuli. It is feared, with the nickname of “The Bomb Ball.”"}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It is known to drift on winds if it is bloated to bursting with stored electricity."}, {"versions": ["soulsilver", "y"], "text": "It stores an overflowing amount of electric energy inside its body. Even a small shock makes it explode."}, {"versions": ["omega-ruby"], "text": "Electrode eats electricity in the atmosphere. On days when lightning strikes, you can see this Pokémon exploding all over the place from eating too much electricity."}, {"versions": ["alpha-sapphire"], "text": "One of Electrode’s characteristics is its attraction to electricity. It is a problematical Pokémon that congregates mostly at electrical power plants to feed on electricity that has just been generated."}, {"versions": ["legends-arceus"], "text": "The tissue on the surface of its body is curiously similar in composition to an Apricorn. When irritated, this Pokémon lets loose an electric current equal to 20 lightning bolts."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/101.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/101.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/101.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/101.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon