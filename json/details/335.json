{"height": 13, "weight": 403, "base_experience": 160, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Cat Ferret Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ザングース"}, {"language": "ja-roma", "name": "Zangoose"}, {"language": "ko", "name": "쟝고"}, {"language": "zh-hant", "name": "貓鼬斬"}, {"language": "fr", "name": "Mangriff"}, {"language": "de", "name": "Sengo"}, {"language": "es", "name": "Zangoose"}, {"language": "it", "name": "Zangoose"}, {"language": "ja", "name": "ザングース"}, {"language": "zh-hans", "name": "猫鼬斩"}, {"language": "es-419", "name": "Zangoose"}], "pokedex_entries": [{"versions": ["x", "black", "white"], "text": "It has feuded with Seviper for many generations. Its sharp claws are its biggest weapons."}, {"versions": ["ruby"], "text": "Memories of battling its arch-rival SEVIPER are etched into every cell of ZANGOOSE’s body. This POKéMON adroitly dodges attacks with incredible agility."}, {"versions": ["sapphire"], "text": "ZANGOOSE usually stays on all fours, but when angered, it gets up on its hind legs and extends its claws. This POKéMON shares a bitter rivalry with SEVIPER that dates back over generations."}, {"versions": ["emerald"], "text": "When it battles, it stands on its hind legs and attacks with its sharply clawed forelegs. Its fur bristles if it encounters any SEVIPER."}, {"versions": ["firered", "leafgreen"], "text": "If it comes across a SEVIPER, its fur bristles and it assumes its battle pose. Its sharp claws are its best weapon."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It has feuded with SEVIPER for many generations. Its sharp claws are its biggest weapons."}, {"versions": ["heartgold", "soulsilver"], "text": "Its fur would all stand on end if it smelled a SEVIPER nearby. Its sharp claws tear up its foes."}, {"versions": ["black-2", "white-2"], "text": "It’s Seviper’s archrival. To threaten those it encounters, it fans out the claws on its front paws."}, {"versions": ["y"], "text": "Its fur would all stand on end if it smelled a Seviper nearby. Its sharp claws tear up its foes."}, {"versions": ["omega-ruby"], "text": "Memories of battling its archrival Seviper are etched into every cell of Zangoose’s body. This Pokémon adroitly dodges attacks with incredible agility."}, {"versions": ["alpha-sapphire"], "text": "Zangoose usually stays on all fours, but when angered, it gets up on its hind legs and extends its claws. This Pokémon shares a bitter rivalry with Seviper that dates back over generations."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/335.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/335.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/335.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/335.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/335.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/335.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/335.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/335.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/335.png", "