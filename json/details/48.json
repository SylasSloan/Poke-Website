{"height": 10, "weight": 300, "base_experience": 61, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Insect Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コンパン"}, {"language": "ja-roma", "name": "Kongpang"}, {"language": "ko", "name": "콘팡"}, {"language": "zh-hant", "name": "毛球"}, {"language": "fr", "name": "Mimitoss"}, {"language": "de", "name": "Bluzuk"}, {"language": "es", "name": "Venonat"}, {"language": "it", "name": "Venonat"}, {"language": "ja", "name": "コンパン"}, {"language": "zh-hans", "name": "毛球"}, {"language": "es-419", "name": "Venonat"}], "pokedex_entries": [{"versions": ["white-2", "black-2", "diamond", "pearl", "platinum", "black", "white", "x"], "text": "Its big eyes are actually clusters of tiny eyes. At night, its kind is drawn by light."}, {"versions": ["red", "blue"], "text": "Lives in the shadows of tall trees where it eats insects. It is attracted by light at night."}, {"versions": ["yellow"], "text": "Its large eyes act as radars. In a bright place, you can see that they are clusters of many tiny eyes."}, {"versions": ["gold", "heartgold"], "text": "Its eyes also function as radar units. It catches and eats small bugs that hide in darkness."}, {"versions": ["silver"], "text": "Poison oozes from all over its body. It catches and eats small bugs at night that are at­ tracted by light."}, {"versions": ["crystal"], "text": "The small bugs it eats appear only at night, so it sleeps in a hole in a tree until night falls."}, {"versions": ["ruby", "sapphire"], "text": "VENONAT is said to have evolved with a coat of thin, stiff hair that covers its entire body for protection. It possesses large eyes that never fail to spot even miniscule prey."}, {"versions": ["emerald"], "text": "Its coat of thin, stiff hair that covers its entire body is said to have evolved for protection. Its large eyes never fail to spot even miniscule prey."}, {"versions": ["firered"], "text": "Its eyes act as radar, enabling it to be active in darkness. The eyes can also shoot powerful beams."}, {"versions": ["leafgreen", "y"], "text": "Lives in the shadows of tall trees where it eats bugs. It is attracted by light at night."}, {"versions": ["soulsilver"], "text": "Poison oozes from all over its body. It catches and eats small bugs at night that are attracted by light."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Venonat is said to have evolved with a coat of thin, stiff hair that covers its entire body for protection. It possesses large eyes that never fail to spot even minuscule prey."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its large eyes act as radar. In a bright place, you can see that they are clusters of many tiny eyes."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/48.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/48.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/48.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/48.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/48.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/48.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/48.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/48.png"}}, "ge