{"height": 11, "weight": 339, "base_experience": 225, "ev_yield": [{"stat": "special-defense", "value": 3}], "genus": "Frog Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ニョロトノ"}, {"language": "ja-roma", "name": "Nyorotono"}, {"language": "ko", "name": "왕구리"}, {"language": "zh-hant", "name": "蚊香蛙皇"}, {"language": "fr", "name": "Tarpaud"}, {"language": "de", "name": "Quaxo"}, {"language": "es", "name": "Politoed"}, {"language": "it", "name": "Politoed"}, {"language": "ja", "name": "ニョロトノ"}, {"language": "zh-hans", "name": "蚊香蛙皇"}, {"language": "es-419", "name": "Politoed"}], "pokedex_entries": [{"versions": ["gold"], "text": "If POLIWAG and POLIWHIRL hear its echoing cry, they respond by gather­ ing from far and wide."}, {"versions": ["silver", "firered", "soulsilver", "x"], "text": "Whenever three or more of these get together, they sing in a loud voice that sounds like bellowing."}, {"versions": ["crystal"], "text": "When it expands its throat to croak out a tune, nearby POLIWAG and POLIWHIRL gather immediately."}, {"versions": ["ruby", "sapphire"], "text": "The curled hair on POLITOED’s head is proof of its status as a king. It is said that the longer and more curled the hair, the more respect this POKéMON earns from its peers."}, {"versions": ["emerald"], "text": "The curled hair on its head proves its status as a king. It is said that the longer and curlier the hair, the more respect it earns from its peers."}, {"versions": ["leafgreen", "heartgold"], "text": "If POLIWAG and POLIWHIRL hear its echoing cry, they respond by gathering from far and wide."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It gathers groups of others as their leader. Its cries make POLIWAG obey."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "It gathers groups of others as their leader. Its cries make Poliwag obey."}, {"versions": ["y"], "text": "If Poliwag and Poliwhirl hear its echoing cry, they respond by gathering from far and wide."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "The curled hair on Politoed’s head is proof of its status as a king. It is said that the longer and more curled the hair, the more respect this Pokémon earns from its peers."}, {"versions": ["sun"], "text": "They gather on moonlit nights to form a large chorus. Their cries sound angry and not at all pleasant, but they are certainly distinctive."}, {"versions": ["moon"], "text": "It’s the leader of Poliwag and Poliwhirl. When Politoed roars, they all cower in fear."}, {"versions": ["ultra-sun"], "text": "Although its cries sound like screams, a composer created a beautiful ballad that was influenced by the sounds."}, {"versions": ["ultra-moon"], "text": "The longer and more luxurious the curled hair on its head, the greater the number of Poliwag and Poliwhirl that will obey it."}, {"versions": ["sword"], "text": "At nightfall, these Pokémon appear on the shores of lakes. They announce their territorial claims by letting out cries that sound like shouting."}, {"versions": ["shield"], "text": "The cry of a male is louder than that of a female. Male Politoed with deep, menacing voices find more popularity with the opposite gender."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/186.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/186.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/186.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/186.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/ge