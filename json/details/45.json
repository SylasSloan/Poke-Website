{"height": 12, "weight": 186, "base_experience": 221, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Flower Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ラフレシア"}, {"language": "ja-roma", "name": "Ruffresia"}, {"language": "ko", "name": "라플레시아"}, {"language": "zh-hant", "name": "霸王花"}, {"language": "fr", "name": "Rafflesia"}, {"language": "de", "name": "Giflor"}, {"language": "es", "name": "Vileplume"}, {"language": "it", "name": "Vileplume"}, {"language": "ja", "name": "ラフレシア"}, {"language": "zh-hans", "name": "霸王花"}, {"language": "es-419", "name": "Vileplume"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x", "shield"], "text": "The larger its petals, the more toxic pollen it contains. Its big head is heavy and hard to hold up."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Flaps its broad flower petals to scatter its poisonous pollen. The flapping sound is very loud."}, {"versions": ["gold"], "text": "It has the world's largest petals. With every step, the petals shake out heavy clouds of toxic pollen."}, {"versions": ["silver"], "text": "The bud bursts into bloom with a bang. It then starts scattering allergenic, poi­ sonous pollen."}, {"versions": ["crystal"], "text": "By shaking its big petals, it scat­ ters toxic pollen into the air, turning the air yellow."}, {"versions": ["ruby"], "text": "VILEPLUME’s toxic pollen triggers atrocious allergy attacks. That’s why it is advisable never to approach any attractive flowers in a jungle, however pretty they may be."}, {"versions": ["sapphire"], "text": "VILEPLUME has the world’s largest petals. They are used to attract prey that are then doused with toxic spores. Once the prey are immobilized, this POKéMON catches and devours them."}, {"versions": ["emerald"], "text": "In seasons when it produces more pollen, the air around a VILEPLUME turns yellow with the powder as it walks. The pollen is highly toxic and causes paralysis."}, {"versions": ["firered"], "text": "Its petals are the largest in the world. It fiendishly scatters allergy-causing pollen from its petals."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Its petals are the largest in the world. As it walks, it scatters extremely allergenic pollen."}, {"versions": ["heartgold", "y", "sword"], "text": "It has the world’s largest petals. With every step, the petals shake out heavy clouds of toxic pollen."}, {"versions": ["soulsilver"], "text": "The bud bursts into bloom with a bang. It then starts scattering allergenic, poisonous pollen."}, {"versions": ["omega-ruby"], "text": "Vileplume’s toxic pollen triggers atrocious allergy attacks. That’s why it is advisable never to approach any attractive flowers in a jungle, however pretty they may be."}, {"versions": ["alpha-sapphire"], "text": "Vileplume has the world’s largest petals. They are used to attract prey that are then doused with toxic spores. Once the prey are immobilized, this Pokémon catches and devours them."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/45.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/45.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/45.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/45.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/45.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/mast