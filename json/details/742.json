{"height": 1, "weight": 2, "base_experience": 61, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Bee Fly Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アブリー"}, {"language": "ja-roma", "name": "Abuly"}, {"language": "ko", "name": "에블리"}, {"language": "zh-hant", "name": "萌虻"}, {"language": "fr", "name": "Bombydou"}, {"language": "de", "name": "Wommel"}, {"language": "es", "name": "Cutiefly"}, {"language": "it", "name": "Cutiefly"}, {"language": "ja", "name": "アブリー"}, {"language": "zh-hans", "name": "萌虻"}, {"language": "es-419", "name": "Cutiefly"}], "pokedex_entries": [{"versions": ["sun"], "text": "It feeds on the nectar and pollen of flowers. Because it’s able to sense auras, it can identify which flowers are about to bloom."}, {"versions": ["moon"], "text": "Myriads of Cutiefly flutter above the heads of people who have auras resembling those of flowers."}, {"versions": ["ultra-sun"], "text": "Nectar and pollen are its favorite fare. In fields of flowers, it gets into skirmishes with Butterfree over food."}, {"versions": ["ultra-moon"], "text": "Cutiefly can pick up the auras of living things. It skillfully reads those auras to predict its foes’ movements and make fools of them."}, {"versions": ["sword"], "text": "Nectar and pollen are its favorite fare. You can find Cutiefly hovering around Gossifleur, trying to get some of Gossifleur’s pollen."}, {"versions": ["shield"], "text": "An opponent’s aura can tell Cutiefly what that opponent’s next move will be. Then Cutiefly can glide around the attack and strike back."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/742.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/ma