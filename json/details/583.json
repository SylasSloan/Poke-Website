{"height": 11, "weight": 410, "base_experience": 138, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Icy Snow Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "バニリッチ"}, {"language": "ja-roma", "name": "Vanirich"}, {"language": "ko", "name": "바닐리치"}, {"language": "zh-hant", "name": "多多冰"}, {"language": "fr", "name": "Sorboul"}, {"language": "de", "name": "Gelatroppo"}, {"language": "es", "name": "Vanillish"}, {"language": "it", "name": "Vanillish"}, {"language": "ja", "name": "バニリッチ"}, {"language": "zh-hans", "name": "多多冰"}, {"language": "es-419", "name": "Vanillish"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "Snowy mountains are this Pokémon’s habitat. During an ancient ice age, they moved to southern areas."}, {"versions": ["white"], "text": "It conceals itself from enemy eyes by creating many small ice particles and hiding among them."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "They cool down the surrounding air and create ice particles, which they use to freeze their foes."}, {"versions": ["sun"], "text": "Hot days cause its body to melt. It can be restored by refreezing it, but the process leaves its body slightly warped."}, {"versions": ["moon"], "text": "This Pokémon has existed since the Ice Age. It controls particles of ice, freezes its opponents, and then shatters them with a headbutt."}, {"versions": ["ultra-sun"], "text": "It sprays its enemies with grains of ice to freeze them. Most Vanillish in Alola are smaller than average."}, {"versions": ["ultra-moon"], "text": "This hearty Pokémon survived the Ice Age. It’s incredibly popular in very hot regions."}, {"versions": ["sword"], "text": "By drinking pure water, it grows its icy body. This Pokémon can be hard to find on days with warm, sunny weather."}, {"versions": ["shield"], "text": "It blasts e