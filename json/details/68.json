{"height": 16, "weight": 1300, "base_experience": 227, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Superpower Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "カイリキー"}, {"language": "ja-roma", "name": "Kairiky"}, {"language": "ko", "name": "괴력몬"}, {"language": "zh-hant", "name": "怪力"}, {"language": "fr", "name": "Mackogneur"}, {"language": "de", "name": "Machomei"}, {"language": "es", "name": "Machamp"}, {"language": "it", "name": "Machamp"}, {"language": "ja", "name": "カイリキー"}, {"language": "zh-hans", "name": "怪力"}, {"language": "es-419", "name": "Machamp"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Using its heavy muscles, it throws powerful punches that can send the victim clear over the horizon."}, {"versions": ["yellow"], "text": "One arm alone can move mountains. Using all four arms, this POKéMON fires off awesome punches."}, {"versions": ["gold", "heartgold", "sword"], "text": "It quickly swings its four arms to rock its opponents with ceaseless punches and chops from all angles."}, {"versions": ["silver", "soulsilver", "y"], "text": "It uses its four powerful arms to pin the limbs of its foe, then throws the victim over the horizon."}, {"versions": ["crystal", "shield"], "text": "With four arms that react more quickly than it can think, it can execute many punches at once."}, {"versions": ["ruby"], "text": "MACHAMP has the power to hurl anything aside. However, trying to do any work requiring care and dexterity causes its arms to get tangled. This POKéMON tends to leap into action before it thinks."}, {"versions": ["sapphire"], "text": "MACHAMP is known as the POKéMON that has mastered every kind of martial arts. If it grabs hold of the foe with its four arms, the battle is all but over. The hapless foe is thrown far over the horizon."}, {"versions": ["emerald"], "text": "It is impossible to defend against punches and chops doled out by its four arms. Its fighting spirit flares up when it faces a tough opponent."}, {"versions": ["firered", "x"], "text": "Its four ruggedly developed arms can launch a flurry of 1,000 punches in just two seconds."}, {"versions": ["leafgreen"], "text": "Its superpowerful punches are said to knock the victim flying clear over the horizon."}, {"versions": ["diamond"], "text": "It punches with its four arms at blinding speed. It can launch 1,000 punches in two seconds."}, {"versions": ["pearl"], "text": "It can knock a train flying with a punch. However, it is terrible at delicate work using its fingers."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Its four muscled arms slam foes with powerful punches and chops at blinding speed."}, {"versions": ["omega-ruby"], "text": "Machamp has the power to hurl anything aside. However, trying to do any work requiring care and dexterity causes its arms to get tangled. This Pokémon tends to leap into action before it thinks."}, {"versions": ["alpha-sapphire"], "text": "Machamp is known as the Pokémon that has mastered every kind of martial arts. If it grabs hold of the foe with its four arms, the battle is all but over. The hapless foe is thrown far over the horizon."}, {"versions": ["sun"], "text": "It unleashes megaton-level punches that send opponents flying clear over the horizon."}, {"versions": ["moon"], "text": "It can lift heavy loads with the greatest of ease. It can even heft dump trucks. But its clumsy fingers prevent it from doing any precision work."}, {"versions": ["ultra-sun"], "text": "It grasps its opponents with its four arms and twists them up in an intricate hold. People call it “the Machamp special.”"}, {"versions": ["ultra-moon"], "text": "With four arms, it can attack and defend simultaneously. It’s said to have mastered every martial art in the world."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "One arm alone can move mountains. Using all four arms, this Pokémon fires off awesome punches."}, {"versions": ["legends-arceus"], "text": "In close combat, its four arms afford it offensive and defensive supremacy. In but a blink, this valiant Pokémon can overwhelm its foes with more than 1,000 blows from its fists."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/68.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/68.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/68.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/68.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/68.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/68.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/68.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/68.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/68.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/68.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/68.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i