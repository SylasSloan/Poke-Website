{"height": 12, "weight": 655, "base_experience": 77, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Licking Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ベロリンガ"}, {"language": "ja-roma", "name": "Beroringa"}, {"language": "ko", "name": "내루미"}, {"language": "zh-hant", "name": "大舌頭"}, {"language": "fr", "name": "Excelangue"}, {"language": "de", "name": "Schlurp"}, {"language": "es", "name": "Lickitung"}, {"language": "it", "name": "Lickitung"}, {"language": "ja", "name": "ベロリンガ"}, {"language": "zh-hans", "name": "大舌头"}, {"language": "es-419", "name": "Lickitung"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its tongue can be extended like a chameleon's. It leaves a tingling sensation when it licks enemies."}, {"versions": ["yellow"], "text": "Its tongue spans almost 7 feet and moves more freely than its forelegs. Its licks can cause paralysis."}, {"versions": ["gold"], "text": "Its tongue has well-developed nerves that run to the very tip, so it can be deft­ ly manipulated."}, {"versions": ["silver"], "text": "Its long tongue, slathered with a gooey saliva, sticks to any­ thing, so it is very useful."}, {"versions": ["crystal"], "text": "It has a tongue that is over 6’6’’ long. It uses this long tongue to lick its body clean."}, {"versions": ["ruby", "sapphire"], "text": "Whenever LICKITUNG comes across something new, it will unfailingly give it a lick. It does so because it memorizes things by texture and by taste. It is somewhat put off by sour things."}, {"versions": ["emerald"], "text": "Whenever it sees something unfamiliar, it always licks the object because it memorizes things by texture and taste. It is somewhat put off by sour things."}, {"versions": ["firered", "y"], "text": "Its tongue is twice the length of its body. It can be moved like an arm for grabbing food and attacking."}, {"versions": ["leafgreen"], "text": "Its tongue can be extended like a chameleon’s. It leaves a tingling sensation when it licks enemies."}, {"versions": ["diamond", "pearl"], "text": "Instead of hands, it uses its tongue, which is twice its height. Its sticky saliva grips anything."}, {"versions": ["platinum", "black", "white"], "text": "When it extends its over-six-foot- long tongue, its tail quivers. There is a possibility they are connected."}, {"versions": ["heartgold"], "text": "Its tongue has well-developed nerves that run to the very tip, so it can be deftly manipulated."}, {"versions": ["soulsilver", "x"], "text": "Its long tongue, slathered with a gooey saliva, sticks to anything, so it is very useful."}, {"versions": ["black-2", "white-2"], "text": "Being licked by its long, saliva-covered tongue leaves a tingling sensation. Extending its tongue retracts its tail."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Whenever Lickitung comes across something new, it will unfailingly give it a lick. It does so because it memorizes things by texture and by taste. It is somewhat put off by sour things."}, {"versions": ["ultra-sun"], "text": "It checks out whatever’s around it by licking everything. If you don’t clean off a spot where it’s licked you, you’ll break out in a rash!"}, {"versions": ["ultra-moon"], "text": "It licks filth clean with its tongue. Whatever it licks always stinks afterward, so whether it’s really clean is...questionable."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its tongue spans almost seven feet and moves more freely than its forelegs. Its licks can cause paralysis."}, {"versions": ["sword"], "text": "If this Pokémon’s sticky saliva gets on you and you don’t clean it off, an intense itch will set in. The itch won’t go away, either."}, {"versions": ["shield"], "text": "Bug Pokémon are Lickitung’s main food source. This Pokémon paralyzes its prey with a lick from its long tongue, then swallows the prey whole."}, {"versions": ["legends-arceus"], "text": "Wields its long tongue deftly, as though it were an arm. The Pokémon's viscous saliva, once it has been collected and boiled down, yields a strong and highly useful adhesive."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/108.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/108.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/108.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/108.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/108.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/108.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/108.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/108.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/108.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/108.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/108.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/108.png"}, "ruby-sapphire": {"normal": "https://raw.githubuserco