{"height": 6, "weight": 100, "base_experience": 72, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Cocoon Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コクーン"}, {"language": "ja-roma", "name": "Cocoon"}, {"language": "ko", "name": "딱충이"}, {"language": "zh-hant", "name": "鐵殼蛹"}, {"language": "fr", "name": "Coconfort"}, {"language": "de", "name": "Kokuna"}, {"language": "es", "name": "Kakuna"}, {"language": "it", "name": "Kakuna"}, {"language": "ja", "name": "コクーン"}, {"language": "zh-hans", "name": "铁壳蛹"}, {"language": "es-419", "name": "Kakuna"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Almost incapable of moving, this POKéMON can only harden its shell to protect itself from predators."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Able to move only slightly. When endangered, it may stick out its stinger and poison its enemy."}, {"versions": ["gold", "heartgold"], "text": "Although it is a cocoon, it can move a little. It can extend its poison barb if it is attacked."}, {"versions": ["silver"], "text": "From this form, it will grow into an adult. As its body becomes soft­ er, the external shell hardens."}, {"versions": ["crystal"], "text": "Nearly incapable of movement, it leans against stout trees while waiting for its evolution."}, {"versions": ["ruby", "sapphire"], "text": "KAKUNA remains virtually immobile as it clings to a tree. However, on the inside, it is extremely busy as it prepares for its coming evolution. This is evident from how hot the shell becomes to the touch."}, {"versions": ["emerald"], "text": "It remains virtually immobile while it clings to a tree. However, on the inside, it busily prepares for evolution. This is evident from how hot its shell becomes."}, {"versions": ["firered"], "text": "This POKéMON is in a temporary stage while making its body. It is almost completely unable to move on its own."}, {"versions": ["leafgreen"], "text": "Almost incapable of moving, this POKéMON can only harden its shell to protect itself when it is in danger."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "While awaiting evolution, it hides from predators under leaves and in nooks of branches."}, {"versions": ["soulsilver"], "text": "From this form, it will grow into an adult. As its body becomes softer, the external shell hardens."}, {"versions": ["x"], "text": "Almost incapable of moving, this Pokémon can only harden its shell to protect itself when it is in danger."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Kakuna remains virtually immobile as it clings to a tree. However, on the inside, it is extremely busy as it prepares for its coming evolution. This is evident from how hot the shell becomes to the touch."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/14.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/14.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/14.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/14.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/14.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/14.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/14.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/spr