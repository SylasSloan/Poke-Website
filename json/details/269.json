{"height": 12, "weight": 316, "base_experience": 173, "ev_yield": [{"stat": "special-defense", "value": 3}], "genus": "Poison Moth Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドクケイル"}, {"language": "ja-roma", "name": "Dokucale"}, {"language": "ko", "name": "독케일"}, {"language": "zh-hant", "name": "毒粉蛾"}, {"language": "fr", "name": "Papinox"}, {"language": "de", "name": "Pudox"}, {"language": "es", "name": "Dustox"}, {"language": "it", "name": "Dustox"}, {"language": "ja", "name": "ドクケイル"}, {"language": "zh-hans", "name": "毒粉蛾"}, {"language": "es-419", "name": "Dustox"}], "pokedex_entries": [{"versions": ["ruby"], "text": "DUSTOX is instinctively drawn to light. Swarms of this POKéMON are attracted by the bright lights of cities, where they wreak havoc by stripping the leaves off roadside trees for food."}, {"versions": ["sapphire"], "text": "When DUSTOX flaps its wings, a fine dust is scattered all over. This dust is actually a powerful poison that will even make a pro wrestler sick. This POKéMON searches for food using its antennae like radar."}, {"versions": ["emerald"], "text": "It is a nocturnal POKéMON that flies from fields and mountains to the attraction of streetlights at night. It looses highly toxic powder from its wings."}, {"versions": ["firered", "leafgreen"], "text": "It scatters horribly toxic dust when it senses danger. They tend to gather in the glow of streetlamps at night."}, {"versions": ["diamond", "x"], "text": "A nocturnal Pokémon. Drawn by streetlights, they messily eat the leaves of trees lining boulevards."}, {"versions": ["pearl", "y"], "text": "It violently flutters its wings to scatter toxic dust when attacked. It becomes active after sunset."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Toxic powder is scattered with each flap. At night, it is known to strip leaves off trees lining boulevards."}, {"versions": ["heartgold", "soulsilver"], "text": "It scatters its fine dust all over when it is attacked. It is a nocturnal Pokémon."}, {"versions": ["omega-ruby"], "text": "Dustox is instinctively drawn to light. Swarms of this Pokémon are attracted by the bright lights of cities, where they wreak havoc by stripping the leaves off roadside trees for food."}, {"versions": ["alpha-sapphire"], "text": "When Dustox flaps its wings, a fine dust is scattered all over. This dust is actually a powerful poison that will even make a pro wrestler sick. This Pokémon searches for food using its antennae like radar."}, {"versions": ["legends-arceus"], "text": "Tends to be drawn to bonfires on dark nights. Difficult to chase away from settlements because of the way it scatters highly toxic scales."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/269.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/269.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/269.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/269.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/269.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/269.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/269.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/hea