{"height": 3, "weight": 57, "base_experience": 100, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Jewel Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["fairy", "mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "メレシー"}, {"language": "ja-roma", "name": "Melecie"}, {"language": "ko", "name": "멜리시"}, {"language": "zh-hant", "name": "小碎鑽"}, {"language": "fr", "name": "Strassie"}, {"language": "de", "name": "Rocara"}, {"language": "es", "name": "Carbink"}, {"language": "it", "name": "Carbink"}, {"language": "ja", "name": "メレシー"}, {"language": "zh-hans", "name": "小碎钻"}, {"language": "es-419", "name": "Carbink"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "Born from the temperatures and pressures deep underground, it fires beams from the stone in its head."}, {"versions": ["y", "alpha-sapphire"], "text": "It has slept underground for hundreds of millions of years since its birth. It’s occasionally found during the excavation of caves."}, {"versions": ["sun"], "text": "Born from the high temperatures and pressures deep underground, it defends itself by firing beams from the jewel part of its body."}, {"versions": ["moon"], "text": "Although this Pokémon is not especially rare, its glittering, jewel-draped body draws attention from people."}, {"versions": ["ultra-sun"], "text": "Some say that deep beneath the surface of the world, a pack of Carbink live with their queen in a kingdom of jewels."}, {"versions": ["ultra-moon"], "text": "To keep the jewels on their bodies free of tarnish, packs of Carbink use their soft manes to polish one another’s jewels."}, {"versions": ["sword"], "text": "When beset by attackers, Carbink wipes them all out by firing high-energy beams from the gems embedded in its body."}, {"versions": ["shield"], "text": "It’s said that somewhere in the world, there’s a mineral vein housing a large pack