{"height": 5, "weight": 93, "base_experience": 158, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Blossom Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["fairy", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "チェリム"}, {"language": "ja-roma", "name": "Cherrim"}, {"language": "ko", "name": "체리꼬"}, {"language": "zh-hant", "name": "櫻花兒"}, {"language": "fr", "name": "Ceriflor"}, {"language": "de", "name": "Kinoso"}, {"language": "es", "name": "Cherrim"}, {"language": "it", "name": "Cherrim"}, {"language": "ja", "name": "チェリム"}, {"language": "zh-hans", "name": "樱花儿"}, {"language": "es-419", "name": "Cherrim"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It blooms during times of strong sunlight. It tries to make up for everything it endured as a bud."}, {"versions": ["pearl"], "text": "It is docile as a bud, but turns cheerful when it blooms. It folds back into a bud if sunlight wanes."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y", "alpha-sapphire"], "text": "If it senses strong sunlight, it opens its folded petals to absorb the sun’s rays with its whole body."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "During times of strong sunlight, its bud blooms, its petals open fully, and it becomes very active."}, {"versions": ["sword"], "text": "As a bud, it barely moves. It sits still, placidly waiting for sunlight to appear."}, {"versions": ["shield"], "text": "Its folded petals are pretty tough. Bird Pokémon can peck at them all they want, and Cherrim won’t be bothered at all."}, {"versions": ["legends-arceus"], "text": "Motionless, save for the occasional quiver. A rich array of Pokémon can be found gathered around it, drawn by the scent exuded from Cherrim's folded petals."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprite