{"height": 9, "weight": 185, "base_experience": 168, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Bloom Sickle Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ラランテス"}, {"language": "ja-roma", "name": "Lalantes"}, {"language": "ko", "name": "라란티스"}, {"language": "zh-hant", "name": "蘭螳花"}, {"language": "fr", "name": "Floramantis"}, {"language": "de", "name": "Mantidea"}, {"language": "es", "name": "Lurantis"}, {"language": "it", "name": "Lurantis"}, {"language": "ja", "name": "ラランテス"}, {"language": "zh-hans", "name": "兰螳花"}, {"language": "es-419", "name": "Lurantis"}], "pokedex_entries": [{"versions": ["sun"], "text": "It requires a lot of effort to maintain Lurantis’s vivid coloring, but some collectors enjoy this work and treat it as their hobby."}, {"versions": ["moon"], "text": "It fires beams from its sickle-shaped petals. These beams are powerful enough to cleave through thick metal plates."}, {"versions": ["ultra-sun"], "text": "For self-protection, it pretends to be a bug Pokémon. Both of its arms bear keen-edged petals."}, {"versions": ["ultra-moon"], "text": "As it slashes into its enemies, it looks like it’s dancing. Its elegant appearance has led some to call it the most glamorous Grass Pokémon."}, {"versions": ["sword"], "text": "This Pokémon resembles a beautiful flower. A properly raised Lurantis will have gorgeous, brilliant colors."}, {"versions": ["shield"], "text": "The petals on this Pokémon’s arms are thin and super sharp, and they can fire laser beams if Lurantis gathers light first."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/754.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemo