{"height": 12, "weight": 300, "base_experience": 175, "ev_yield": [{"stat": "hp", "value": 1}, {"stat": "attack", "value": 1}], "genus": "Sludge Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ベトベトン"}, {"language": "ja-roma", "name": "Betbeton"}, {"language": "ko", "name": "질뻐기"}, {"language": "zh-hant", "name": "臭臭泥"}, {"language": "fr", "name": "Grotadmorv"}, {"language": "de", "name": "Sleimok"}, {"language": "es", "name": "Muk"}, {"language": "it", "name": "Muk"}, {"language": "ja", "name": "ベトベトン"}, {"language": "zh-hans", "name": "臭臭泥"}, {"language": "es-419", "name": "Muk"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Thickly covered with a filthy, vile sludge. It is so toxic, even its footprints contain poison."}, {"versions": ["yellow"], "text": "Smells so awful, it can cause fainting. Through degeneration, it lost its sense of smell."}, {"versions": ["gold"], "text": "They love to gath­ er in smelly areas where sludge ac­ cumulates, making the stench around them worse."}, {"versions": ["silver"], "text": "Its body is made of a powerful poi­ son. Touching it accidentally will cause a fever that requires bed rest."}, {"versions": ["crystal"], "text": "As it moves, a very strong poison leaks from it, making the ground there barren for three years."}, {"versions": ["ruby"], "text": "From MUK’s body seeps a foul fluid that gives off a nose-bendingly horrible stench. Just one drop of this POKéMON’s body fluid can turn a pool stagnant and rancid."}, {"versions": ["sapphire"], "text": "This POKéMON’s favorite food is anything that is repugnantly filthy. In dirty towns where people think nothing of throwing away litter on the streets, MUK are certain to gather."}, {"versions": ["emerald"], "text": "It prefers warm and humid habitats. In the summertime, the toxic substances in its body intensify, making MUK reek like putrid kitchen garbage."}, {"versions": ["firered"], "text": "It is usually undetectable because it blends in with the ground. Touching it can cause terrible poisoning."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "A toxic fluid seeps from its body. The fluid instantly kills plants and trees on contact."}, {"versions": ["heartgold", "x"], "text": "They love to gather in smelly areas where sludge accumulates, making the stench around them worse."}, {"versions": ["soulsilver"], "text": "Its body is made of a powerful poison. Touching it accidentally will cause a fever that requires bed rest."}, {"versions": ["black-2", "white-2"], "text": "It’s so stinky! Muk’s body contains toxic elements, and any plant will wilt when it passes by."}, {"versions": ["omega-ruby"], "text": "From Muk’s body seeps a foul fluid that gives off a nose-bendingly horrible stench. Just one drop of this Pokémon’s body fluid can turn a pool stagnant and rancid."}, {"versions": ["alpha-sapphire"], "text": "This Pokémon’s favorite food is anything that is repugnantly filthy. In dirty towns where people think nothing of throwing away litter on the streets, Muk are certain to gather."}, {"versions": ["sun"], "text": "The stench it gives off will make your nose scrunch up. Still, there are Muk fans who think that’s a good thing."}, {"versions": ["moon"], "text": "After recent environmental improvements, this Pokémon is now hardly seen at all. People speculate that it may go extinct at some point."}, {"versions": ["ultra-sun"], "text": "Their food sources have decreased, and their numbers have declined sharply. Sludge ponds are being built to prevent their extinction."}, {"versions": ["ultra-moon"], "text": "Because they scatter germs everywhere, they’ve long been targeted for extermination, leading to a steep decline in their population."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Smells so awful, it can cause fainting. Through degeneration of its nose, it lost its sense of smell."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/89.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/89.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/89.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/89.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/89.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/89.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/89.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/89.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/89.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/89.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/89.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/89.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/89.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/