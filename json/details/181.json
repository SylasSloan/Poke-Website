{"height": 14, "weight": 615, "base_experience": 230, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Light Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "デンリュウ"}, {"language": "ja-roma", "name": "Denryu"}, {"language": "ko", "name": "전룡"}, {"language": "zh-hant", "name": "電龍"}, {"language": "fr", "name": "Pharamp"}, {"language": "de", "name": "Ampharos"}, {"language": "es", "name": "Ampharos"}, {"language": "it", "name": "Ampharos"}, {"language": "ja", "name": "デンリュウ"}, {"language": "zh-hans", "name": "电龙"}, {"language": "es-419", "name": "Ampharos"}], "pokedex_entries": [{"versions": ["gold"], "text": "The tail's tip shines brightly and can be seen from far away. It acts as a beacon for lost people."}, {"versions": ["silver", "firered", "soulsilver"], "text": "The bright light on its tail can be seen far away. It has been treasured since ancient times as a beacon."}, {"versions": ["crystal"], "text": "When it gets dark, the light from its bright, shiny tail can be seen from far away on the ocean's surface."}, {"versions": ["ruby", "sapphire"], "text": "AMPHAROS gives off so much light that it can be seen even from space. People in the old days used the light of this POKéMON to send signals back and forth with others far away."}, {"versions": ["emerald"], "text": "It gives off so much light that it can be seen even from space. People in the old days used its light to send signals back and forth with others far away."}, {"versions": ["leafgreen", "heartgold", "x", "y"], "text": "The tail’s tip shines brightly and can be seen from far away. It acts as a beacon for lost people."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "The tip of its tail shines brightly. In the olden days, people sent signals using the tail’s light."}, {"versions": ["black-2", "white-2"], "text": "T