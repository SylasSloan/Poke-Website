{"height": 12, "weight": 250, "base_experience": 154, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-attack", "value": 1}], "genus": "Dragon Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "シードラ"}, {"language": "ja-roma", "name": "Seadra"}, {"language": "ko", "name": "시드라"}, {"language": "zh-hant", "name": "海刺龍"}, {"language": "fr", "name": "Hypocéan"}, {"language": "de", "name": "Seemon"}, {"language": "es", "name": "Seadra"}, {"language": "it", "name": "Seadra"}, {"language": "ja", "name": "シードラ"}, {"language": "zh-hans", "name": "海刺龙"}, {"language": "es-419", "name": "Seadra"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Capable of swim­ ming backwards by rapidly flapping its wing-like pectoral fins and stout tail."}, {"versions": ["yellow"], "text": "Touching the back fin causes numb­ ness. It hooks its tail to coral to stay in place while sleeping."}, {"versions": ["gold", "heartgold"], "text": "An examination of its cells revealed the presence of a gene not found in HORSEA. It became a hot topic."}, {"versions": ["silver", "soulsilver"], "text": "Its fin-tips leak poison. Its fins and bones are highly valued as ingredients in herbal medicine."}, {"versions": ["crystal"], "text": "The male raises the young. If it is approached, it uses its toxic spikes to fend off the intruder."}, {"versions": ["ruby"], "text": "SEADRA sleeps after wriggling itself between the branches of coral. Those trying to harvest coral are occasionally stung by this POKéMON’s poison barbs if they fail to notice it."}, {"versions": ["sapphire"], "text": "SEADRA generates whirlpools by spinning its body. The whirlpools are strong enough to swallow even fishing boats. This POKéMON weakens prey with these currents, then swallows it whole."}, {"versions": ["emerald"], "text": "The poisonous barbs all over its body are highly valued as ingredients for making traditional herbal medicine. It shows no mercy to anything approaching its nest."}, {"versions": ["firered", "x"], "text": "Its body bristles with sharp spikes. Carelessly trying to touch it could cause fainting from the spikes."}, {"versions": ["leafgreen", "y"], "text": "It is capable of swimming backwards by rapidly flapping its winglike pectoral fins and stout tail."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Its spines provide protection. Its fins and bones are prized as traditional medicine ingredients."}, {"versions": ["black-2", "white-2"], "text": "Its spines provide protection. Its fins and bones are prized as traditional-medicine ingredients."}, {"versions": ["omega-ruby"], "text": "Seadra sleeps after wriggling itself between the branches of coral. Those trying to harvest coral are occasionally stung by this Pokémon’s poison barbs if they fail to notice it."}, {"versions": ["alpha-sapphire"], "text": "Seadra generates whirlpools by spinning its body. The whirlpools are strong enough to swallow even fishing boats. This Pokémon weakens prey with these currents, then swallows it whole."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Touching the back fin causes numbness. It hooks its tail to coral to stay in place while sleeping."}, {"versions": ["sword"], "text": "It’s the males that raise the offspring. While Seadra are raising young, the spines on their backs secrete thicker and stronger poison."}, {"versions": ["shield"], "text": "Seadra’s mouth is slender, but its suction power is strong. In an instant, Seadra can suck in food that’s larger than the opening of its mouth."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/117.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g