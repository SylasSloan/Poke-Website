{"height": 3, "weight": 6, "base_experience": 56, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Cotton Puff Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["fairy", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "モンメン"}, {"language": "ja-roma", "name": "Monmen"}, {"language": "ko", "name": "소미안"}, {"language": "zh-hant", "name": "木棉球"}, {"language": "fr", "name": "Doudouvet"}, {"language": "de", "name": "Waumboll"}, {"language": "es", "name": "Cottonee"}, {"language": "it", "name": "Cottonee"}, {"language": "ja", "name": "モンメン"}, {"language": "zh-hans", "name": "木棉球"}, {"language": "es-419", "name": "Cottonee"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "When attacked, it escapes by shooting cotton from its body. The cotton serves as a decoy to distract the attacker."}, {"versions": ["white"], "text": "They go wherever the wind takes them. On rainy days, their bodies are heavier, so they take shelter beneath big trees."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "Perhaps because they feel more at ease in a group, they stick to others they find. They end up looking like a cloud."}, {"versions": ["sun"], "text": "When it finds others of its kind, they all stick together. When enough of them have collected, the mass resembles a cumulonimbus cloud."}, {"versions": ["moon"], "text": "Pillows and beds stuffed with cotton exhaled by Cottonee are soft and puffy, light and airy— altogether top quality."}, {"versions": ["ultra-sun"], "text": "To protect itself, it shoots cotton from its body. When it gets wet in the rain, its cotton grows moist and heavy, and it can’t move as well."}, {"versions": ["ultra-moon"], "text": "When attacked, it expels cotton from its body to create a diversion. The cotton it loses grows back in quickly."}, {"versions": ["sword"], "text": "It shoots cotton from its body to protect itself. If it gets caught up in hurricane-strength winds, it can get sent to the other side of the Earth."}, {"versions": ["shield"], "text": "Weaving together the cotton of both Cottonee and Eldegoss produces exquisite cloth that’s highly prized by many luxury brands."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/546.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/546.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/546.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/546.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/546.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/546.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/546.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/546.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/546.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/546.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/546.png", "shiny": null}}