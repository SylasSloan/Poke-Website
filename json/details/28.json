{"height": 10, "weight": 295, "base_experience": 158, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Mouse Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "サンドパン"}, {"language": "ja-roma", "name": "Sandpan"}, {"language": "ko", "name": "고지"}, {"language": "zh-hant", "name": "穿山王"}, {"language": "fr", "name": "Sablaireau"}, {"language": "de", "name": "Sandamer"}, {"language": "es", "name": "Sandslash"}, {"language": "it", "name": "Sandslash"}, {"language": "ja", "name": "サンドパン"}, {"language": "zh-hans", "name": "穿山王"}, {"language": "es-419", "name": "Sandslash"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "y"], "text": "Curls up into a spiny ball when threatened. It can roll while curled up to attack or escape."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "It is skilled at slashing enemies with its claws. If broken, they start to grow back in a day."}, {"versions": ["gold", "heartgold"], "text": "In an attempt to hide itself, it will run around at top speed to kick up a blinding dust storm."}, {"versions": ["silver", "soulsilver", "x"], "text": "If it digs at an incredible pace, it may snap off its spikes and claws. They grow back in a day."}, {"versions": ["crystal"], "text": "Adept at climbing trees, it rolls into a spiny ball, then attacks its enemies from above."}, {"versions": ["ruby"], "text": "SANDSLASH’s body is covered by tough spikes, which are hardened sections of its hide. Once a year, the old spikes fall out, to be replaced with new spikes that grow out from beneath the old ones."}, {"versions": ["sapphire"], "text": "SANDSLASH can roll up its body as if it were a ball covered with large spikes. In battle, this POKéMON will try to make the foe flinch by jabbing it with its spines. It then leaps at the stunned foe to tear wildly with its sharp claws."}, {"versions": ["emerald"], "text": "It curls up in a ball to protect itself from enemy attacks. It also curls up to prevent heatstroke during the daytime when temperatures rise sharply."}, {"versions": ["firered"], "text": "It is adept at attacking with the spines on its back and its sharp claws while quickly scurrying about."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It curls up, then rolls into foes with its back. Its sharp spines inflict severe damage."}, {"versions": ["black-2", "white-2"], "text": "The spikes on its body are made up of its hardened hide. It rolls up and attacks foes with its spikes."}, {"versions": ["omega-ruby"], "text": "Sandslash’s body is covered by tough spikes, which are hardened sections of its hide. Once a year, the old spikes fall out, to be replaced with new spikes that grow out from beneath the old ones."}, {"versions": ["alpha-sapphire"], "text": "Sandslash can roll up its body as if it were a ball covered with large spikes. In battle, this Pokémon will try to make the foe flinch by jabbing it with its spines. It then leaps at the stunned foe to tear wildly with its sharp claws."}, {"versions": ["sun"], "text": "Although they are sharp, its claws and spikes often break off. They grow back the next day, so it is not bothered by the temporary loss."}, {"versions": ["moon"], "text": "It uses its claws to climb trees and then curls its body into a spiny ball, ready to drop onto any prey that appears."}, {"versions": ["ultra-sun"], "text": "Its claws and horns often break off. The broken claws and horns can be used to carve plows for tilling farm fields."}, {"versions": ["ultra-moon"], "text": "Thanks to its thick claws, it’s good at climbing trees. There are plenty of Sandslash that park themselves in trees and go right to sleep."}, {"versions": ["sword"], "text": "The drier the area Sandslash lives in, the harder and smoother the Pokémon’s spikes will feel when touched."}, {"versions": ["shield"], "text": "It climbs trees by hooking on with its sharp claws. Sandslash shares the berries it gathers, dropping them down to Sandshrew waiting below the tree."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/28.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/28.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/28.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/28.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/28.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/28.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/28.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/28.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/28.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/28.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/28.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/28.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/