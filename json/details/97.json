{"height": 16, "weight": 756, "base_experience": 169, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Hypnosis Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "スリーパー"}, {"language": "ja-roma", "name": "Sleeper"}, {"language": "ko", "name": "슬리퍼"}, {"language": "zh-hant", "name": "引夢貘人"}, {"language": "fr", "name": "Hypnomade"}, {"language": "de", "name": "Hypno"}, {"language": "es", "name": "Hypno"}, {"language": "it", "name": "Hypno"}, {"language": "ja", "name": "スリーパー"}, {"language": "zh-hans", "name": "引梦貘人"}, {"language": "es-419", "name": "Hypno"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "When it locks eyes with an enemy, it will use a mix of PSI moves such as HYPNOSIS and CONFUSION."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Avoid eye contact if you come across one. It will try to put you to sleep by using its pendulum."}, {"versions": ["gold", "heartgold"], "text": "When it is very hungry, it puts humans it meets to sleep, then it feasts on their dreams."}, {"versions": ["silver"], "text": "Always holding a pendulum that it rocks at a steady rhythm, it causes drowsiness in any­ one nearby."}, {"versions": ["crystal"], "text": "The longer it swings its pendulum, the longer the effects of its hypnosis last."}, {"versions": ["ruby", "sapphire"], "text": "HYPNO holds a pendulum in its hand. The arcing movement and glitter of the pendulum lull the foe into a deep state of hypnosis. While this POKéMON searches for prey, it polishes the pendulum."}, {"versions": ["emerald"], "text": "The arcing movement and glitter of the pendulum in a HYPNO’s hand lull the foe into deep hypnosis. While searching for prey, it polishes the pendulum."}, {"versions": ["firered", "x"], "text": "It carries a pendulum-like device. There once was an incident in which it took away a child it hypnotized."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "Seeing its swinging pendulum can induce sleep in three seconds, even in someone who just woke up."}, {"versions": ["soulsilver"], "text": "Always holding a pendulum that it swings at a steady rhythm, it causes drowsiness in anyone nearby."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Hypno holds a pendulum in its hand. The arcing movement and glitter of the pendulum lull the foe into a deep state of hypnosis. While this Pokémon searches for prey, it polishes the pendulum."}, {"versions": ["sun"], "text": "While it is an extremely dangerous Pokémon, people who are in need of a good, sound sleep call it their savior."}, {"versions": ["moon"], "text": "As a matter of course, it makes anyone it meets fall asleep and has a taste of their dreams. Anyone having a good dream, it carries off."}, {"versions": ["ultra-sun"], "text": "In Alola, Komala is Hypno’s main target. It rarely harms people."}, {"versions": ["ultra-moon"], "text": "There are some Hypno that assist doctors with patients who can’t sleep at night in hospitals."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/97.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/97.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/97.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/97.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/97.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/ma