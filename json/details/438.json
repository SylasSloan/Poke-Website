{"height": 5, "weight": 150, "base_experience": 58, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Bonsai Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["no-eggs"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ウソハチ"}, {"language": "ja-roma", "name": "Usohachi"}, {"language": "ko", "name": "꼬지지"}, {"language": "zh-hant", "name": "盆才怪"}, {"language": "fr", "name": "Manzaï"}, {"language": "de", "name": "Mobai"}, {"language": "es", "name": "Bonsly"}, {"language": "it", "name": "Bonsly"}, {"language": "ja", "name": "ウソハチ"}, {"language": "zh-hans", "name": "盆才怪"}, {"language": "es-419", "name": "Bonsly"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It looks as if it is always crying. It is actually adjusting its body’s fluid levels by eliminating excess."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It prefers arid environments. It leaks water from its eyes to adjust its body’s fluid levels."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y", "alpha-sapphire"], "text": "It prefers an arid atmosphere. It leaks water that looks like tears when adjusting its moisture level."}, {"versions": ["heartgold", "soulsilver"], "text": "In order to adjust the level of fluids in its body, it exudes water from its eyes. This makes it appear to be crying."}, {"versions": ["sun"], "text": "It does not deal well with water, so it lives in dry locales. Since its surroundings tend to lack greenery, it stands out noticeably."}, {"versions": ["moon"], "text": "From its eyes, it can expel excess moisture from its body. This liquid is similar in composition to human sweat."}, {"versions": ["ultra-sun"], "text": "It discharges moisture from its eyes, making it look like it’s crying—apparently an effective way of getting enemies to let down their guard."}, {"versions": ["ultra-moon"], "text": "If its body gets too damp, it will die. So, in a process reminiscent of sweating, its eyes expel moisture."}, {"versions": ["sword"], "text": "It expels both sweat and tears from its eyes. The sweat is a little salty, while the tears have a slight bitterness."}, {"versions": ["shield"], "text": "This Pokémon lives in dry, rocky areas. As its green spheres dry out, their dull luster increases."}, {"versions": ["legends-arceus"], "text": "Its tears elicit sympathy from those who see them, but do not be deceived! This expulsion of body water is merely a physiological mechanism for keeping itself in good health."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/438.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/438.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/438.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/438.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/438.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/438.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/438.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/438.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/438.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://ra