{"height": 3, "weight": 60, "base_experience": 65, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Magnet Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "コイル"}, {"language": "ja-roma", "name": "Coil"}, {"language": "ko", "name": "코일"}, {"language": "zh-hant", "name": "小磁怪"}, {"language": "fr", "name": "Magnéti"}, {"language": "de", "name": "Magnetilo"}, {"language": "es", "name": "Magnemite"}, {"language": "it", "name": "Magnemite"}, {"language": "ja", "name": "コイル"}, {"language": "zh-hans", "name": "小磁怪"}, {"language": "es-419", "name": "Magnemite"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Uses anti-gravity to stay suspended. Appears without warning and uses THUNDER WAVE and similar moves."}, {"versions": ["yellow"], "text": "It is born with the ability to defy gravity. It floats in air on powerful electro­ magnetic waves."}, {"versions": ["gold"], "text": "It is attracted by electromagnetic waves. It may approach trainers if they are using their POKéGEAR."}, {"versions": ["silver"], "text": "The units at the sides of its body generate anti­ gravity energy to keep it aloft in the air."}, {"versions": ["crystal"], "text": "The electricity emitted by the units on each side of its body cause it to become a strong magnet."}, {"versions": ["ruby"], "text": "MAGNEMITE attaches itself to power lines to feed on electricity. If your house has a power outage, check your circuit breakers. You may find a large number of this POKéMON clinging to the breaker box."}, {"versions": ["sapphire"], "text": "MAGNEMITE floats in the air by emitting electromagnetic waves from the units at its sides. These waves block gravity. This POKéMON becomes incapable of flight if its internal electrical supply is depleted."}, {"versions": ["emerald"], "text": "The units at its sides are extremely powerful magnets. They generate enough magnetism to draw in iron objects from over 300 feet away."}, {"versions": ["firered"], "text": "It moves while constantly hovering. It discharges THUNDER WAVE and so on from the units at its sides."}, {"versions": ["leafgreen"], "text": "Uses antigravity to stay suspended. Appears without warning and uses THUNDER WAVE and similar moves."}, {"versions": ["diamond", "pearl"], "text": "The units at its sides generate electromagnetic waves that keep it airborne. It feeds on electricity."}, {"versions": ["platinum", "black", "white"], "text": "The faster the units at its sides rotate, the greater the magnetic force they generate."}, {"versions": ["heartgold"], "text": "It is attracted by electromagnetic waves. It may approach Trainers if they are using their Pokégear."}, {"versions": ["soulsilver", "x"], "text": "The units at the sides of its body generate antigravity energy to keep it aloft in the air."}, {"versions": ["black-2", "white-2"], "text": "The electromagnetic waves emitted by the units at the sides of its head expel antigravity, which allows it to float."}, {"versions": ["y"], "text": "It moves while constantly hovering. It discharges Thunder Wave and so on from the units at its sides."}, {"versions": ["omega-ruby"], "text": "Magnemite attaches itself to power lines to feed on electricity. If your house has a power outage, check your circuit breakers. You may find a large number of this Pokémon clinging to the breaker box."}, {"versions": ["alpha-sapphire"], "text": "Magnemite floats in the air by emitting electromagnetic waves from the units at its sides. These waves block gravity. This Pokémon becomes incapable of flight if its internal electrical supply is depleted."}, {"versions": ["sun"], "text": "They gather in places where electricity is available. They can be found clinging to the steel towers used to support power lines."}, {"versions": ["moon"], "text": "It sends out electromagnetic waves, which let it float through the air. Touching it while it’s eating electricity will give you a full-body shock."}, {"versions": ["ultra-sun"], "text": "It’s frequently the cause of power outages, which is why some power plants send out electrical signals that it can’t stand."}, {"versions": ["ultra-moon"], "text": "Perhaps because electrical lines are often buried these days, the number of Magnemite attacks on power plants has increased."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "It is hatched with the ability to defy gravity. It floats while emitting powerful electromagnetic waves."}, {"versions": ["sword"], "text": "At times, Magnemite runs out of electricity and ends up on the ground. If you give batteries to a grounded Magnemite, it’ll start moving again."}, {"versions": ["shield"], "text": "It subsists on electricity. As Magnemite flies, it emits electromagnetic waves from the units on each side of its body."}, {"versions": ["legends-arceus"], "text": "A bizarre Pokémon with but a single eye embedded in an iron sphere. I suspect this creature levitates due to the magnetism it emits from its arms, which resemble horseshoe-shaped magnets."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/81.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/81.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/81.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/81.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/81.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/sh