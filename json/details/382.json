{"height": 45, "weight": 3520, "base_experience": 302, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Sea Basin Pokémon", "capture_rate": 3, "base_happiness": 0, "hatch_counter": 120, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "カイオーガ"}, {"language": "ja-roma", "name": "Kyogre"}, {"language": "ko", "name": "가이오가"}, {"language": "zh-hant", "name": "蓋歐卡"}, {"language": "fr", "name": "Kyogre"}, {"language": "de", "name": "Kyogre"}, {"language": "es", "name": "Kyogre"}, {"language": "it", "name": "Kyogre"}, {"language": "ja", "name": "カイオーガ"}, {"language": "zh-hans", "name": "盖欧卡"}, {"language": "es-419", "name": "Kyogre"}], "pokedex_entries": [{"versions": ["ruby"], "text": "KYOGRE has the power to create massive rain clouds that cover the entire sky and bring about torrential downpours. This POKéMON saved people who were suffering from droughts."}, {"versions": ["sapphire"], "text": "KYOGRE is named in mythology as the POKéMON that expanded the sea by covering the land with torrential rains and towering tidal waves. It took to sleep after a cataclysmic battle with GROUDON."}, {"versions": ["emerald"], "text": "KYOGRE has appeared in mythology as the creator of the sea. After long years of feuding with GROUDON, it took to sleep at the bottom of the sea."}, {"versions": ["firered", "leafgreen"], "text": "This POKéMON is said to have expanded the sea by bringing heavy rains. It has the power to control water."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It is said to have widened the seas by causing downpours. It had been asleep in a marine trench."}, {"versions": ["heartgold", "soulsilver"], "text": "A mythical Pokémon said to have swelled the seas with rain and tidal waves. It battled with GROUDON."}, {"versions": ["x"], "text": "A mythical Pokémon said to have swelled the seas with rain and tidal waves. It battled with Groudon."}, {"versions": ["omega-ruby"], "text": "Through Primal Reversion and with nature’s full power, it will take back its true form. It can summon storms that cause the sea levels to rise."}, {"versions": ["alpha-sapphire"], "text": "Kyogre is said to be the personification of the sea itself. Legends tell of its many clashes against Groudon, as each sought to gain the power of nature."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/382.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/382.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/382.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/382.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/382.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/382.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/382.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/382.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/382.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/382.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g