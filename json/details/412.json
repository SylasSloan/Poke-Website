{"height": 2, "weight": 34, "base_experience": 45, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Bagworm Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ミノムッチ"}, {"language": "ja-roma", "name": "Minomucchi"}, {"language": "ko", "name": "도롱충이"}, {"language": "zh-hant", "name": "結草兒"}, {"language": "fr", "name": "Cheniti"}, {"language": "de", "name": "Burmy"}, {"language": "es", "name": "Burmy"}, {"language": "it", "name": "Burmy"}, {"language": "ja", "name": "ミノムッチ"}, {"language": "zh-hans", "name": "结草儿"}, {"language": "es-419", "name": "Burmy"}], "pokedex_entries": [{"versions": ["diamond", "x", "omega-ruby"], "text": "To shelter itself from cold, wintry winds, it covers itself with a cloak made of twigs and leaves."}, {"versions": ["pearl", "y", "alpha-sapphire"], "text": "If its cloak is broken in battle, it quickly remakes the cloak with materials nearby."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Even if it is born where there are no cocooning materials, it somehow always ends up with a cloak."}, {"versions": ["heartgold", "soulsilver"], "text": "It covers itself with a cloak to shelter from the cold. When it’s hot, its cloak is thinner."}, {"versions": ["legends-arceus"], "text": "If its cloak is even slightly damaged, Burmy will immediately repair it with whatever is close at hand. The Pokémon within the cloak is scrawny and vulnerable to the cold."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/412.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/412.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/poke