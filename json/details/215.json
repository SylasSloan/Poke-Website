{"height": 9, "weight": 280, "base_experience": 86, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Sharp Claw Pokémon", "capture_rate": 60, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ニューラ"}, {"language": "ja-roma", "name": "Nyula"}, {"language": "ko", "name": "포푸니"}, {"language": "zh-hant", "name": "狃拉"}, {"language": "fr", "name": "Farfuret"}, {"language": "de", "name": "Sniebel"}, {"language": "es", "name": "Sneasel"}, {"language": "it", "name": "Sneasel"}, {"language": "ja", "name": "ニューラ"}, {"language": "zh-hans", "name": "狃拉"}, {"language": "es-419", "name": "Sneasel"}], "pokedex_entries": [{"versions": ["gold"], "text": "Its paws conceal sharp claws. If attacked, it sud­ denly extends the claws and startles its enemy."}, {"versions": ["silver", "firered"], "text": "Vicious in nature, it drives PIDGEY from their nests and feasts on the eggs that are left behind."}, {"versions": ["crystal"], "text": "This cunning POKéMON hides under the cover of darkness, waiting to attack its prey."}, {"versions": ["ruby", "sapphire"], "text": "SNEASEL scales trees by punching its hooked claws into the bark. This POKéMON seeks out unguarded nests and steals eggs for food while the parents are away."}, {"versions": ["emerald"], "text": "A SNEASEL scales trees by punching its hooked claws into the bark. It seeks out unguarded nests and steals eggs for food while the parents are away."}, {"versions": ["leafgreen", "heartgold", "y", "sword"], "text": "Its paws conceal sharp claws. If attacked, it suddenly extends the claws and startles its enemy."}, {"versions": ["diamond", "x"], "text": "It feeds on eggs stolen from nests. Its sharply hooked claws rip vulnerable spots on prey."}, {"versions": ["pearl"], "text": "It is extremely vicious and will not stop attacking until its foe is incapable of moving."}, {"versions": ["platinum", "black", "white"], "text": "A smart and sneaky Pokémon. A pair may work together to steal eggs by having one lure the parents away."}, {"versions": ["soulsilver"], "text": "Vicious in nature, it drives PIDGEY from their nests and scavenges any leftovers it can find."}, {"versions": ["black-2", "white-2"], "text": "A smart and sneaky Pokémon, it makes its opponents flinch by suddenly showing the claws hidden in its paws."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Sneasel scales trees by punching its hooked claws into the bark. This Pokémon seeks out unguarded nests and steals eggs for food while the parents are away."}, {"versions": ["sun", "shield"], "text": "It has a cunning yet savage disposition. It waits for parents to leave their nests, and then it sneaks in to steal their eggs."}, {"versions": ["moon"], "text": "It uses its claws to poke holes in eggs so it can slurp out the insides. Breeders consider it a scourge and will drive it away or eradicate it."}, {"versions": ["ultra-sun"], "text": "They will cooperate to steal eggs from the nests of bird Pokémon, but fights break out to determine which one gets to eat the eggs."}, {"versions": ["ultra-moon"], "text": "It blends into the dark of night to ambush its prey. Sneasel will attack Sandshrew, but its hard skin can cause Sneasel’s claws to snap off."}, {"versions": ["legends-arceus"], "text": "Its sturdy, curved claws are ideal for traversing precipitous cliffs. From the tips of these claws drips a venom that infiltrates the nerves of any prey caught in Sneasel's grasp."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/215.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/215.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/215.png", "shiny": "https://ra