{"height": 14, "weight": 465, "base_experience": 154, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Wild Monkey Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤルキモノ"}, {"language": "ja-roma", "name": "Yarukimono"}, {"language": "ko", "name": "발바로"}, {"language": "zh-hant", "name": "過動猿"}, {"language": "fr", "name": "Vigoroth"}, {"language": "de", "name": "Muntier"}, {"language": "es", "name": "Vigoroth"}, {"language": "it", "name": "Vigoroth"}, {"language": "ja", "name": "ヤルキモノ"}, {"language": "zh-hans", "name": "过动猿"}, {"language": "es-419", "name": "Vigoroth"}], "pokedex_entries": [{"versions": ["ruby"], "text": "VIGOROTH is always itching and agitated to go on a wild rampage. It simply can’t tolerate sitting still for even a minute. This POKéMON’s stress level rises if it can’t be moving constantly."}, {"versions": ["sapphire"], "text": "VIGOROTH is simply incapable of remaining still. Even when it tries to sleep, the blood in its veins grows agitated, compelling this POKéMON to run wild throughout the jungle before it can settle down."}, {"versions": ["emerald"], "text": "It can’t keep still because its blood boils with energy. It runs through the fields and mountains all day to calm itself. If it doesn’t, it can’t sleep at night."}, {"versions": ["firered", "leafgreen"], "text": "It is always hungry because it won’t stop rampaging. Even while it is eating, it can’t keep still."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Its heart beats at a tenfold tempo, so it cannot sit still for even a moment."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "Its stress level rises if it cannot keep moving constantly. Too much stress makes it feel sick."}, {"versions": ["black-2", "white-2", "x"], "text": "Its heartbeat is fast and its blood so agitated that it can’t sit still for one second."}, {"versions": ["omega-ruby"], "text": "Vigoroth is always itching and agitated to go on a wild rampage. It simply can’t tolerate sitting still for even a minute. This Pokémon’s stress level rises if it can’t be moving constantly."}, {"versions": ["alpha-sapphire"], "text": "Vigoroth is simply incapable of remaining still. Even when it tries to sleep, the blood in its veins grows agitated, compelling this Pokémon to run wild throughout the jungle before it can settle down."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/288.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/288.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/288.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/288.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/288.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/288.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/288.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/288.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/288.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/288.png"}}, "generation-ix": {"scarlet-violet"