{"height": 18, "weight": 830, "base_experience": 239, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Heel Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ガオガエン"}, {"language": "ja-roma", "name": "Gaogaen"}, {"language": "ko", "name": "어흥염"}, {"language": "zh-hant", "name": "熾焰咆哮虎"}, {"language": "fr", "name": "Félinferno"}, {"language": "de", "name": "Fuegro"}, {"language": "es", "name": "Incineroar"}, {"language": "it", "name": "Incineroar"}, {"language": "ja", "name": "ガオガエン"}, {"language": "zh-hans", "name": "炽焰咆哮虎"}, {"language": "es-419", "name": "Incineroar"}], "pokedex_entries": [{"versions": ["sun"], "text": "This Pokémon has a violent, selfish disposition. If it’s not in the mood to listen, it will ignore its Trainer’s orders with complete nonchalance."}, {"versions": ["moon"], "text": "After hurling ferocious punches and flinging furious kicks, it finishes opponents off by spewing fire from around its navel."}, {"versions": ["ultra-sun"], "text": "Although it’s rough mannered and egotistical, it finds beating down unworthy opponents boring. It gets motivated for stronger opponents."}, {"versions": ["ultra-moon"], "text": "When its fighting spirit is set alight, the flames around its waist become especially intense."}, {"versions": ["sword"], "text": "It excels at violent, no-holds-barred battles. The temperature of the flames that issue from its navel exceeds 3,600 degrees Fahrenheit."}, {"versions": ["shield"], "text": "Incineroar’s rough and aggressive behavior is its most notable trait, but the way it helps out small Pokémon shows that it has a kind side as well."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/727.png", "shiny": null}}, "generation-v": {"black-white": {"nor