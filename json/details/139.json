{"height": 10, "weight": 350, "base_experience": 173, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Spiral Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["water1", "water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "オムスター"}, {"language": "ja-roma", "name": "Omstar"}, {"language": "ko", "name": "암스타"}, {"language": "zh-hant", "name": "多刺菊石獸"}, {"language": "fr", "name": "Amonistar"}, {"language": "de", "name": "Amoroso"}, {"language": "es", "name": "Omastar"}, {"language": "it", "name": "Omastar"}, {"language": "ja", "name": "オムスター"}, {"language": "zh-hans", "name": "多刺菊石兽"}, {"language": "es-419", "name": "Omastar"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A prehistoric POKéMON that died out when its heavy shell made it impossible to catch prey."}, {"versions": ["yellow"], "text": "Sharp beaks ring its mouth. Its shell was too big for it to move freely, so it became extinct."}, {"versions": ["gold"], "text": "Apparently, it cracked SHELLDER's shell with its sharp fangs and sucked out the insides."}, {"versions": ["silver", "soulsilver", "y"], "text": "Once wrapped around its prey, it never lets go. It eats the prey by tearing at it with sharp fangs."}, {"versions": ["crystal"], "text": "Its heavy shell allowed it to reach only nearby food. This could be the reason it is extinct."}, {"versions": ["ruby", "sapphire"], "text": "OMASTAR uses its tentacles to capture its prey. It is believed to have become extinct because its shell grew too large and heavy, causing its movements to become too slow and ponderous."}, {"versions": ["emerald"], "text": "An OMASTAR uses its tentacles to capture its prey. It is believed to have become extinct because its shell grew too large, making its movements slow and ponderous."}, {"versions": ["firered", "x"], "text": "Its tentacles are highly developed as if they are hands and feet. As soon as it ensnares prey, it bites."}, {"versions": ["leafgreen"], "text": "Despite having strong fangs and tentacles, it went extinct when its heavy shell made it unable to catch prey."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It is thought that this Pokémon became extinct because its spiral shell grew too large."}, {"versions": ["heartgold"], "text": "Apparently, it cracked SHELLDER’s shell with its sharp fangs and sucked out the insides."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Omastar uses its tentacles to capture its prey. It is believed to have become extinct because its shell grew too large and heavy, causing its movements to become too slow and ponderous."}, {"versions": ["ultra-sun"], "text": "Its heavy shell is thought to be the reason this ancient Pokémon died out. It’s apparently a distant ancestor of Octillery."}, {"versions": ["ultra-moon"], "text": "It wraps its prey in its tentacles to immobilize them and then finishes them off with its sharp fangs."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its sharp beak rings its mouth. Its shell was too big for it to move freely, so it became extinct."}, {"versions": ["sword"], "text": "Weighed down by a large and heavy shell, Omastar couldn’t move very fast. Some say it went extinct because it was unable to catch food."}, {"versions": ["shield"], "text": "Omastar’s sharp fangs could crush rock, but the Pokémon can attack only the prey that come within reach of its tentacles."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/139.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/139.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crysta