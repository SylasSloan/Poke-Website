{"height": 10, "weight": 238, "base_experience": 71, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Sea Lily Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "リリーラ"}, {"language": "ja-roma", "name": "Lilyla"}, {"language": "ko", "name": "릴링"}, {"language": "zh-hant", "name": "觸手百合"}, {"language": "fr", "name": "Lilia"}, {"language": "de", "name": "Liliep"}, {"language": "es", "name": "Lileep"}, {"language": "it", "name": "Lileep"}, {"language": "ja", "name": "リリーラ"}, {"language": "zh-hans", "name": "触手百合"}, {"language": "es-419", "name": "Lileep"}], "pokedex_entries": [{"versions": ["black-2", "white-2", "diamond", "pearl", "platinum", "black", "white", "y"], "text": "It lived on the seafloor 100 million years ago and was reanimated scientifically."}, {"versions": ["ruby"], "text": "LILEEP became extinct approximately a hundred million years ago. This ancient POKéMON attaches itself to a rock on the seafloor and catches approaching prey using tentacles shaped like flower petals."}, {"versions": ["sapphire"], "text": "LILEEP is an ancient POKéMON that was regenerated from a fossil. It remains permanently anchored to a rock. From its immobile perch, this POKéMON intently scans for prey with its two eyes."}, {"versions": ["emerald"], "text": "It disguises itself as seaweed by making its tentacles sway. Unsuspecting prey that come too close are swallowed whole. It became extinct 100 million years ago."}, {"versions": ["firered", "leafgreen"], "text": "It became extinct roughly 100 million years ago. It was regenerated from a fossil using advanced techniques."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "It disguises its tentacles as flowers to attract and catch prey. It became extinct in ancient times."}, {"versions": ["omega-ruby"], "text": "Lileep became extinct approximately a hundred million years ago. This ancient Pokémon attaches itself to a rock on the seafloor and catches approaching prey using tentacles shaped like flower petals."}, {"versions": ["alpha-sapphire"], "text": "Lileep is an ancient Pokémon that was regenerated from a fossil. It remains permanently anchored to a rock. From its immobile perch, this Pokémon intently scans for prey with its two eyes."}, {"versions": ["ultra-sun"], "text": "In ancient times, it lived in warm seas. It disguised itself as seaweed to ambush its prey and devoured them whole when they got close."}, {"versions": ["ultra-moon"], "text": "It sticks to rocks with its powerful suckers and can’t be washed away no matter how rough the surf gets."}, {"versions": ["sword"], "text": "This Pokémon was restored from a fossil. Lileep once lived in warm seas that existed approximately 100,000,000 years ago."}, {"versions": ["shield"], "text": "Lileep clings to rocks on the seabed. When prey comes close, this Pokémon entangles it with petallike tentacles."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/345.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/345.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/345.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/345.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/345.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/345.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprit