{"height": 12, "weight": 380, "base_experience": 155, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Beak Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オニドリル"}, {"language": "ja-roma", "name": "Onidrill"}, {"language": "ko", "name": "깨비드릴조"}, {"language": "zh-hant", "name": "大嘴雀"}, {"language": "fr", "name": "Rapasdepic"}, {"language": "de", "name": "Ibitak"}, {"language": "es", "name": "Fearow"}, {"language": "it", "name": "Fearow"}, {"language": "ja", "name": "オニドリル"}, {"language": "zh-hans", "name": "大嘴雀"}, {"language": "es-419", "name": "Fearow"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x"], "text": "With its huge and magnificent wings, it can keep aloft without ever having to land for rest."}, {"versions": ["yellow"], "text": "A POKéMON that dates back many years. If it senses danger, it flies high and away, instantly."}, {"versions": ["gold", "heartgold"], "text": "It shoots itself suddenly high into the sky, then plummets down in one fell swoop to strike its prey."}, {"versions": ["silver", "soulsilver"], "text": "It cleverly uses its thin, long beak to pluck and eat small insects that hide under the ground."}, {"versions": ["crystal"], "text": "It uses its long beak to attack. It has a surprisingly long reach, so it must be treated with caution."}, {"versions": ["ruby", "sapphire"], "text": "FEAROW is recognized by its long neck and elongated beak. They are conveniently shaped for catching prey in soil or water. It deftly moves its long and skinny beak to pluck prey."}, {"versions": ["emerald"], "text": "Its long neck and elongated beak are ideal for catching prey in soil or water. It deftly moves this extended and skinny beak to pluck prey."}, {"versions": ["firered"], "text": "Its huge and magnificent wings can keep it aloft in the sky. It can remain flying a whole day without landing."}, {"versions": ["diamond", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It has the stamina to fly all day on its broad wings. It fights by using its sharp beak."}, {"versions": ["pearl"], "text": "It has the stamina to keep flying all day on its broad wings. It fights by using its sharp beak."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Fearow is recognized by its long neck and elongated beak. They are conveniently shaped for catching prey in soil or water. It deftly moves its long and skinny beak to pluck prey."}, {"versions": ["sun"], "text": "It’s tough and has excellent stamina. It has no problem flying continuously for a whole day carrying a heavy load."}, {"versions": ["moon"], "text": "Drawings of a Pokémon resembling Fearow can be seen in murals from deep in ancient history."}, {"versions": ["ultra-sun"], "text": "Carrying food through Fearow’s territory is dangerous. It will snatch the food away from you in a flash!"}, {"versions": ["ultra-moon"], "text": "In Alola, fish Pokémon are its prey. It can be seen circling above the ocean searching for food."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A Pokémon that dates back many years. If it senses danger, it flies high and away, instantly."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/22.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/22.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/22.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/22.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/ge