{"height": 26, "weight": 2600, "base_experience": 177, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Freezing Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ツンベアー"}, {"language": "ja-roma", "name": "Tunbear"}, {"language": "ko", "name": "툰베어"}, {"language": "zh-hant", "name": "凍原熊"}, {"language": "fr", "name": "Polagriffe"}, {"language": "de", "name": "Siberio"}, {"language": "es", "name": "Beartic"}, {"language": "it", "name": "Beartic"}, {"language": "ja", "name": "ツンベアー"}, {"language": "zh-hans", "name": "冻原熊"}, {"language": "es-419", "name": "Beartic"}], "pokedex_entries": [{"versions": ["black"], "text": "It can make its breath freeze at will. Very able in the water, it swims around in northern seas and catches prey."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "It freezes its breath to create fangs and claws of ice to fight with. Cold northern areas are its habitat."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "They love the cold seas of the north. They create pathways across the ocean waters by freezing their own breath."}, {"versions": ["sword"], "text": "It swims through frigid seas, searching for prey. From its frozen breath, it forms icy fangs that are harder than steel."}, {"versions": ["shield"], "text": "It swims energetically through frigid seas. When it gets tired, it freezes the seawater with its breath so it can rest on the ice."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/614.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/614.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pok