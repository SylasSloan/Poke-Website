{"height": 12, "weight": 470, "base_experience": 147, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Scaly Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ジャランゴ"}, {"language": "ja-roma", "name": "Jyarango"}, {"language": "ko", "name": "짜랑고우"}, {"language": "zh-hant", "name": "鱗甲龍"}, {"language": "fr", "name": "Écaïd"}, {"language": "de", "name": "Mediras"}, {"language": "es", "name": "Hakamo-o"}, {"language": "it", "name": "Hakamo-o"}, {"language": "ja", "name": "ジャランゴ"}, {"language": "zh-hans", "name": "鳞甲龙"}, {"language": "es-419", "name": "Hakamo-o"}], "pokedex_entries": [{"versions": ["sun"], "text": "It leaps at its prey with a courageous shout. Its scaly punches tear its opponents to shreds."}, {"versions": ["moon"], "text": "It sheds and regrows its scales on a continuous basis. The scales become harder and sharper each time they’re regrown."}, {"versions": ["ultra-sun"], "text": "It makes noise by clanging its scales together. When the rhythm has reached its peak, Hakamo-o attacks."}, {"versions": ["ultra-moon"], "text": "The scales it sheds can be molded and processed to make pots and pans. They conduct heat well, so they’re a popular item."}, {"versions": ["sword"], "text": "The scaleless, scarred parts of its body are signs of its strength. It shows them off to defeated opponents."}, {"versions": ["shield"], "text": "Before attacking its enemies, it clashes its scales together and roars. Its sharp claws shred the opposition."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/783.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/783.png", "shiny": "https://raw.gi