{"height": 15, "weight": 682, "base_experience": 173, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Plate Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "slow-then-very-fast", "egg_groups": ["water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "アーマルド"}, {"language": "ja-roma", "name": "Armaldo"}, {"language": "ko", "name": "아말도"}, {"language": "zh-hant", "name": "太古盔甲"}, {"language": "fr", "name": "Armaldo"}, {"language": "de", "name": "Armaldo"}, {"language": "es", "name": "Armaldo"}, {"language": "it", "name": "Armaldo"}, {"language": "ja", "name": "アーマルド"}, {"language": "zh-hans", "name": "太古盔甲"}, {"language": "es-419", "name": "Armaldo"}], "pokedex_entries": [{"versions": ["ruby"], "text": "ARMALDO’s tough armor makes all attacks bounce off. This POKéMON’s two enormous claws can be freely extended or contracted. They have the power to punch right through a steel slab."}, {"versions": ["sapphire"], "text": "ARMALDO is a POKéMON species that became extinct in prehistoric times. This POKéMON is said to have walked on its hind legs, which would have been more convenient for life on land."}, {"versions": ["emerald"], "text": "ARMALDO usually lives on land. However, when it hunts for prey, it dives beneath the ocean. It swims around using its two large wings."}, {"versions": ["firered", "leafgreen", "y"], "text": "Protected by a hard shell, its body is very sturdy. It skewers prey with its claws to feed."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It went ashore after evolving. Its entire body is clad in a sturdy armor."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "Its enormous, retractable claws can cut through most anything. Its entire body is clad in sturdy plates."}, {"versions": ["omega-ruby"], "text": "Armaldo’s tough armor makes all attacks bounce off. This Pokémon’s two enormous claws can be freely extended or contracted. They have the power to punch right through a steel slab."}, {"versions": ["alpha-sapphire"], "text": "Armaldo is a Pokémon species that became extinct in prehistoric times. This Pokémon is said to have walked on its hind legs, which would have been more convenient for life on land."}, {"versions": ["ultra-sun"], "text": "It lived on land and went out into the sea to hunt for prey. Its sharp claws were its greatest weapon."}, {"versions": ["ultra-moon"], "text": "Armaldo adapted from living in water to living on land. It has been determined that it is the ancestor of some bug Pokémon."}, {"versions": ["sword"], "text": "After evolution, this Pokémon emerged onto land. Its lower body has become stronger, and blows from its tail are devastating."}, {"versions": ["shield"], "text": "Though it lives on land, it’s also a good swimmer. It dives into the ocean in search of prey, using its sharp claws to take down its quarry."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/348.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/348.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/348.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/348.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/348.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/348.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/348.png", "shi