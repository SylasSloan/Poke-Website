{"height": 11, "weight": 206, "base_experience": 172, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Humming Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["flying", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "チルタリス"}, {"language": "ja-roma", "name": "Tyltalis"}, {"language": "ko", "name": "파비코리"}, {"language": "zh-hant", "name": "七夕青鳥"}, {"language": "fr", "name": "Altaria"}, {"language": "de", "name": "Altaria"}, {"language": "es", "name": "Altaria"}, {"language": "it", "name": "Altaria"}, {"language": "ja", "name": "チルタリス"}, {"language": "zh-hans", "name": "七夕青鸟"}, {"language": "es-419", "name": "Altaria"}], "pokedex_entries": [{"versions": ["ruby"], "text": "ALTARIA dances and wheels through the sky among billowing, cotton-like clouds. By singing melodies in its crystal-clear voice, this POKéMON makes its listeners experience dreamy wonderment."}, {"versions": ["sapphire"], "text": "ALTARIA sings in a gorgeous soprano. Its wings are like cotton clouds. This POKéMON catches updrafts with its buoyant wings and soars way up into the wild blue yonder."}, {"versions": ["emerald"], "text": "It hums in a beautiful soprano voice. It flies among white clouds in the blue sky. It launches intensely hot fireballs from its mouth."}, {"versions": ["firered", "leafgreen"], "text": "If you hear a beautiful melody trilling deep among mountains far from people, it is ALTARIA’s humming."}, {"versions": ["diamond", "pearl"], "text": "It looks like a fluffy cloud when it is in flight. It hums with its soprano voice."}, {"versions": ["platinum", "black", "white"], "text": "If it bonds with a person, it will gently envelop the friend with its soft wings, then hum."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "It flies gracefully through the sky. Its melodic humming makes you feel like you’re in a dream."}, {"versions": ["black-2", "white-2", "y"], "