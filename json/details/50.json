{"height": 2, "weight": 8, "base_experience": 53, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Mole Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ディグダ"}, {"language": "ja-roma", "name": "Digda"}, {"language": "ko", "name": "디그다"}, {"language": "zh-hant", "name": "地鼠"}, {"language": "fr", "name": "Taupiqueur"}, {"language": "de", "name": "Digda"}, {"language": "es", "name": "Diglett"}, {"language": "it", "name": "Diglett"}, {"language": "ja", "name": "ディグダ"}, {"language": "zh-hans", "name": "地鼠"}, {"language": "es-419", "name": "Diglett"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Lives about one yard underground where it feeds on plant roots. It sometimes appears above ground."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "It prefers dark places. It spends most of its time underground, though it may pop up in caves."}, {"versions": ["gold", "heartgold", "y"], "text": "Its skin is very thin. If it is exposed to light, its blood heats up, causing it to grow weak."}, {"versions": ["silver"], "text": "If a DIGLETT DIGS through a field, it leaves the soil perfectly tilled and ideal for planting crops."}, {"versions": ["crystal"], "text": "It digs under­ ground and chews on tree roots, sticking its head out only when the sun isn't bright."}, {"versions": ["ruby", "sapphire"], "text": "DIGLETT are raised in most farms. The reason is simple - wherever this POKéMON burrows, the soil is left perfectly tilled for planting crops. This soil is made ideal for growing delicious vegetables."}, {"versions": ["emerald"], "text": "DIGLETT are raised in most farms. The reason is simple--wherever they burrow, the soil is left perfectly tilled for growing delicious crops."}, {"versions": ["firered", "shield"], "text": "It burrows through the ground at a shallow depth. It leaves raised earth in its wake, making it easy to spot."}, {"versions": ["leafgreen", "x"], "text": "Lives about one yard underground where it feeds on plant roots. It sometimes appears aboveground."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "A Pokémon that lives underground. Because of its dark habitat, it is repelled by bright sunlight."}, {"versions": ["soulsilver"], "text": "If a DIGLETT digs through a field, it leaves the soil perfectly tilled and ideal for planting crops."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Diglett are raised in most farms. The reason is simple— wherever this Pokémon burrows, the soil is left perfectly tilled for planting crops. This soil is made ideal for growing delicious vegetables."}, {"versions": ["sun"], "text": "It chews on plant roots underground. Farmers whose vegetables are vulnerable find it can be quite a pest."}, {"versions": ["moon"], "text": "Many farmers cherish and nurture Diglett because its droppings enrich the soil it lives in."}, {"versions": ["ultra-sun"], "text": "It travels through tunnels that it digs underground. It hates sunlight, so it comes out only after the sun goes down."}, {"versions": ["ultra-moon"], "text": "Around their crops, farmers plant the kind of tree that Diglett like to eat as a way of getting Diglett to plow the fields for them."}, {"versions": ["sword"], "text": "If a Diglett digs through a field, it leaves the soil perfectly tilled and ideal for planting crops."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/50.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/50.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/50.pn