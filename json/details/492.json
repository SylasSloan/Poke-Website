{"height": 2, "weight": 21, "base_experience": 270, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Gratitude Pokémon", "capture_rate": 45, "base_happiness": 100, "hatch_counter": 120, "growth_rate": "medium-slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "シェイミ"}, {"language": "ja-roma", "name": "Shaymin"}, {"language": "ko", "name": "쉐이미"}, {"language": "zh-hant", "name": "謝米"}, {"language": "fr", "name": "Shaymin"}, {"language": "de", "name": "Shaymin"}, {"language": "es", "name": "Shaymin"}, {"language": "it", "name": "Shaymin"}, {"language": "ja", "name": "シェイミ"}, {"language": "zh-hans", "name": "谢米"}, {"language": "es-419", "name": "Shaymin"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It lives in flower patches and avoids detection by curling up to look like a flowering plant."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It can dissolve toxins in the air to instantly transform ruined land into a lush field of flowers."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "The flowers all over its body burst into bloom if it is lovingly hugged and senses gratitude."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "The blooming of Gracidea flowers confers the power of flight upon it. Feelings of gratitude are the message it delivers."}, {"versions": ["legends-arceus"], "text": "When the turning of seasons brings the cruel winter to its end and the joyous people give thanks to the heavens, Shaymin appears and covers the withered land with flowers."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/492.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/492.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/Pok