{"height": 8, "weight": 202, "base_experience": 97, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Emotion Pokémon", "capture_rate": 120, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["humanshape", "indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キルリア"}, {"language": "ja-roma", "name": "Kirlia"}, {"language": "ko", "name": "킬리아"}, {"language": "zh-hant", "name": "奇魯莉安"}, {"language": "fr", "name": "Kirlia"}, {"language": "de", "name": "Kirlia"}, {"language": "es", "name": "Kirlia"}, {"language": "it", "name": "Kirlia"}, {"language": "ja", "name": "キルリア"}, {"language": "zh-hans", "name": "奇鲁莉安"}, {"language": "es-419", "name": "Kirlia"}], "pokedex_entries": [{"versions": ["ruby"], "text": "It is said that a KIRLIA that is exposed to the positive emotions of its TRAINER grows beautiful. This POKéMON controls psychokinetic powers with its highly developed brain."}, {"versions": ["sapphire"], "text": "KIRLIA uses the horns on its head to amplify its psychokinetic power. When the POKéMON uses its power, the air around it becomes distorted, creating mirages of nonexistent scenery."}, {"versions": ["emerald"], "text": "A KIRLIA has the psychic power to create a rip in the dimensions and see into the future. It is said to dance with pleasure on sunny mornings."}, {"versions": ["firered", "leafgreen"], "text": "The cheerful spirit of its TRAINER gives it energy for its psychokinetic power. It spins and dances when happy."}, {"versions": ["diamond", "pearl"], "text": "It is highly perceptive of its Trainer’s feelings. It dances when it is feeling happy."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "sword"], "text": "If its Trainer becomes happy, it overflows with energy, dancing joyously while spinning about."}, {"versions": ["heartgold", "soulsilver", "y", "shield"], "text": "It has a psychic power that enables it to distort the space around it and see into the future."}