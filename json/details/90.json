{"height": 3, "weight": 40, "base_experience": 61, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Bivalve Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "シェルダー"}, {"language": "ja-roma", "name": "Shellder"}, {"language": "ko", "name": "셀러"}, {"language": "zh-hant", "name": "大舌貝"}, {"language": "fr", "name": "Kokiyas"}, {"language": "de", "name": "Muschas"}, {"language": "es", "name": "Shellder"}, {"language": "it", "name": "Shellder"}, {"language": "ja", "name": "シェルダー"}, {"language": "zh-hans", "name": "大舌贝"}, {"language": "es-419", "name": "Shellder"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x", "shield"], "text": "Its hard shell repels any kind of attack. It is vulnerable only when its shell is open."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "The shell can withstand any attack. However, when it is open, the tender body is exposed."}, {"versions": ["gold"], "text": "It swims facing backward by open­ ing and closing its two-piece shell. It is surprisingly fast."}, {"versions": ["silver", "soulsilver"], "text": "Grains of sand trapped in its shells mix with its body fluids to form beautiful pearls."}, {"versions": ["crystal", "y"], "text": "Clamping on to an opponent reveals its vulnerable parts, so it uses this move only as a last resort."}, {"versions": ["ruby", "sapphire"], "text": "At night, this POKéMON uses its broad tongue to burrow a hole in the seafloor sand and then sleep in it. While it is sleeping, SHELLDER closes its shell, but leaves its tongue hanging out."}, {"versions": ["emerald"], "text": "At night, it burrows a hole in the seafloor with its broad tongue to make a place to sleep. While asleep, it closes its shell, but leaves its tongue hanging out."}, {"versions": ["firered"], "text": "It is encased in a shell that is harder than diamond. Inside, however, it is surprisingly tender."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It swims backward by opening and closing its two shells. Its large tongue is always kept hanging out."}, {"versions": ["heartgold", "sword"], "text": "It swims facing backward by opening and closing its two-piece shell. It is surprisingly fast."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "At night, this Pokémon uses its broad tongue to burrow a hole in the seafloor sand and then sleep in it. While it is sleeping, Shellder closes its shell, but leaves its tongue hanging out."}, {"versions": ["sun"], "text": "The hardness of its shell surpasses the hardness of a diamond. In days gone by, people used the shells to make shields."}, {"versions": ["moon"], "text": "This Pokémon’s tongue is always hanging out. It uses its tongue with great dexterity to dig up sand from the seabed in its search for food."}, {"versions": ["ultra-sun"], "text": "The sand that accumulates inside its shell eventually becomes a pearl. But the pearl gets in the way, so it spits it out and discards it."}, {"versions": ["ultra-moon"], "text": "Even when its shell is closed, its tongue still hangs out. If you give its tongue a good yank, the shock will cause Shellder to open its shell."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/90.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/90.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/90.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/90.png"}, "gold": {"normal": "https://raw.githubusercontent.com/Pok