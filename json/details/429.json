{"height": 9, "weight": 44, "base_experience": 173, "ev_yield": [{"stat": "special-attack", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Magical Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ムウマージ"}, {"language": "ja-roma", "name": "Mumargi"}, {"language": "ko", "name": "무우마직"}, {"language": "zh-hant", "name": "夢妖魔"}, {"language": "fr", "name": "Magirêve"}, {"language": "de", "name": "Traunmagil"}, {"language": "es", "name": "Mismagius"}, {"language": "it", "name": "Mismagius"}, {"language": "ja", "name": "ムウマージ"}, {"language": "zh-hans", "name": "梦妖魔"}, {"language": "es-419", "name": "Mismagius"}], "pokedex_entries": [{"versions": ["diamond"], "text": "Its cries sound like incantations. Those hearing it are tormented by headaches and hallucinations."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It chants incantations. While they usually torment targets, some chants bring happiness."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Its cry sounds like an incantation. It is said the cry may rarely be imbued with happiness-giving power."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "Its cries sound like incantations to torment the foe. It appears where you least expect it."}, {"versions": ["sun"], "text": "It appears as if from nowhere—muttering incantations, placing curses, and giving people terrifying visions."}, {"versions": ["moon"], "text": "Mismagius have been known to cast spells to make people fall in love, so some people search for this Pokémon as if their life depended on it."}, {"versions": ["ultra-sun"], "text": "Feared for its wrath and the curses it spreads, this Pokémon will also, on a whim, cast spells that help people."}, {"versions": ["ultra-moon"], "text": "Its muttered curses can cause awful headaches or terrifying visions that torment others."}, {"versions": ["legends-arceus"], "text": "The incantations Mismagius chants can ward against misfortune, so a custom exists of inviting it into one's home. Incur the Pokémon's displeasure, however, and disaster will surely ensue."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/429.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/429.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/429.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/429.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/429.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/429.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/429.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/429.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/429.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/429.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/429.png"}, "x-y": {"normal": "ht