{"height": 14, "weight": 620, "base_experience": 227, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Drill Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "ニドキング"}, {"language": "ja-roma", "name": "Nidoking"}, {"language": "ko", "name": "니드킹"}, {"language": "zh-hant", "name": "尼多王"}, {"language": "fr", "name": "Nidoking"}, {"language": "de", "name": "Nidoking"}, {"language": "es", "name": "Nidoking"}, {"language": "it", "name": "Nidoking"}, {"language": "ja", "name": "ニドキング"}, {"language": "zh-hans", "name": "尼多王"}, {"language": "es-419", "name": "Nidoking"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "It uses its powerful tail in battle to smash, constrict, then break the prey's bones."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Its steel-like hide adds to its powerful tackle. Its horns are so hard, they can pierce a diamond."}, {"versions": ["gold", "heartgold"], "text": "It swings its big tail around during battle. If its foe flinches, it will charge with its sturdy body."}, {"versions": ["silver"], "text": "Its tail is thick and powerful. If it binds an enemy, it can snap the victim's spine quite easily."}, {"versions": ["crystal"], "text": "It uses its thick arms, legs and tail to attack forcefully. Melee combat is its specialty."}, {"versions": ["ruby", "sapphire"], "text": "NIDOKING’s thick tail packs enormously destructive power. With one swing, it can topple a metal transmission tower. Once this POKéMON goes on a rampage, there is no stopping it."}, {"versions": ["emerald"], "text": "A NIDOKING’s thick tail packs enormously destructive power capable of toppling a metal transmission tower. Once it goes on a rampage, there is no stopping it."}, {"versions": ["firered"], "text": "It is recognized by its rock-hard hide and its extended horn. Be careful with the horn as it contains venom."}, {"versions": ["leafgreen"], "text": "It uses its powerful tail in battle to smash, constrict, then break the prey’s bones."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "One swing of its mighty tail can snap a telephone pole as if it were a matchstick."}, {"versions": ["soulsilver"], "text": "Its tail is thick and powerful. If it binds an enemy, it can render the victim helpless quite easily."}, {"versions": ["x"], "text": "It is recognized by its rock-hard hide and its extended horn. Be careful with the horn, as it contains venom."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Nidoking’s thick tail packs enormously destructive power. With one swing, it can topple a metal transmission tower. Once this Pokémon goes on a rampage, there is no stopping it."}, {"versions": ["sword"], "text": "When it goes on a rampage, it’s impossible to control. But in the presence of a Nidoqueen it’s lived with for a long time, Nidoking calms down."}, {"versions": ["shield"], "text": "Nidoking prides itself on its strength. It’s forceful and spirited in battle, making use of its thick tail and diamond-crushing horn."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/34.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/34.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/34.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/34.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/34.png", "shiny": "https://raw.githu