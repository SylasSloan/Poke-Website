{"height": 14, "weight": 750, "base_experience": 151, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Water Fish Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヌオー"}, {"language": "ja-roma", "name": "Nuoh"}, {"language": "ko", "name": "누오"}, {"language": "zh-hant", "name": "沼王"}, {"language": "fr", "name": "Maraiste"}, {"language": "de", "name": "Morlord"}, {"language": "es", "name": "Quagsire"}, {"language": "it", "name": "Quagsire"}, {"language": "ja", "name": "ヌオー"}, {"language": "zh-hans", "name": "沼王"}, {"language": "es-419", "name": "Quagsire"}], "pokedex_entries": [{"versions": ["gold"], "text": "This carefree POKéMON has an easy-going nature. While swimming, it always bumps into boat hulls."}, {"versions": ["silver"], "text": "Due to its relaxed and carefree atti­ tude, it often bumps its head on boulders and boat hulls as it swims."}, {"versions": ["crystal", "shield"], "text": "Its body is always slimy. It often bangs its head on the river bottom as it swims but seems not to care."}, {"versions": ["ruby", "sapphire"], "text": "QUAGSIRE hunts for food by leaving its mouth wide open in water and waiting for its prey to blunder in unaware. Because the POKéMON does not move, it does not get very hungry."}, {"versions": ["emerald"], "text": "A QUAGSIRE hunts by leaving its mouth wide open in water and waiting for its prey to blunder in. Because it doesn’t move, it does not get very hungry."}, {"versions": ["firered", "soulsilver"], "text": "Due to its relaxed and carefree attitude, it often bumps its head on boulders and boat hulls as it swims."}, {"versions": ["leafgreen"], "text": "This carefree POKéMON has an easygoing nature. While swimming, it always bumps into boat hulls."}, {"versions": ["diamond", "x"], "text": "It has a sluggish nature. It lies at the river’s bottom, waiting for prey to stray into its mouth."}, {"versions": ["pearl"], "text": "A dim-witted Pokémon. It doesn’t care if it bumps its head into boats or rocks while swimming."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "sword"], "text": "It has an easygoing nature. It doesn’t care if it bumps its head on boats and boulders while swimming."}, {"versions": ["heartgold"], "text": "This carefree Pokémon has an easy-going nature. While swimming, it always bumps into boat hulls."}, {"versions": ["y"], "text": "This carefree Pokémon has an easygoing nature. While swimming, it always bumps into boat hulls."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Quagsire hunts for food by leaving its mouth wide open in water and waiting for its prey to blunder in unaware. Because the Pokémon does not move, it does not get very hungry."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/195.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/195.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/195.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/195.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/195.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/195.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/195.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/195.png"}, "ruby-sapphire": {"normal": "https://raw.githubus