{"height": 14, "weight": 406, "base_experience": 159, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Human Shape Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ルージュラ"}, {"language": "ja-roma", "name": "Rougela"}, {"language": "ko", "name": "루주라"}, {"language": "zh-hant", "name": "迷唇姐"}, {"language": "fr", "name": "Lippoutou"}, {"language": "de", "name": "Rossana"}, {"language": "es", "name": "Jynx"}, {"language": "it", "name": "Jynx"}, {"language": "ja", "name": "ルージュラ"}, {"language": "zh-hans", "name": "迷唇姐"}, {"language": "es-419", "name": "Jynx"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "It seductively wiggles its hips as it walks. It can cause people to dance in unison with it."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Appears to move to a rhythm of its own, as if it were dancing. It wiggles its hips as it walks."}, {"versions": ["gold"], "text": "It rocks its body rhythmically. It appears to alter the rhythm depend­ ing on how it is feeling."}, {"versions": ["silver"], "text": "It speaks a lan­ guage similar to that of humans. However, it seems to use dancing to communicate."}, {"versions": ["crystal"], "text": "It has several different cry pat­ terns, each of which seems to have its own meaning."}, {"versions": ["ruby", "sapphire"], "text": "JYNX walks rhythmically, swaying and shaking its hips as if it were dancing. Its motions are so bouncingly alluring, people seeing it are compelled to shake their hips without giving any thought to what they are doing."}, {"versions": ["emerald"], "text": "A JYNX sashays rhythmically as if it were dancing. Its motions are so bouncingly alluring, people seeing it are compelled to shake their hips without noticing."}, {"versions": ["firered", "y"], "text": "It speaks using a language that sounds human. Research is under way to determine what is being said."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Its cries sound like human speech. However, it is impossible to tell what it is trying to say."}, {"versions": ["heartgold"], "text": "It rocks its body rhythmically. It appears to alter the rhythm depending on how it is feeling."}, {"versions": ["soulsilver"], "text": "It speaks a language similar to that of humans. However, it seems to use dancing to communicate."}, {"versions": ["x"], "text": "It wiggles its hips as it walks. It can cause people to dance in unison with it."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Jynx walks rhythmically, swaying and shaking its hips as if it were dancing. Its motions are so bouncingly alluring, people seeing it are compelled to shake their hips without giving any thought to what they are doing."}, {"versions": ["ultra-sun"], "text": "It sways its hips to a rhythm all its own. The precise movements of Jynx living in Alola are truly wonderful."}, {"versions": ["ultra-moon"], "text": "Its strange cries sound like human language. There are some musicians who compose songs for Jynx to sing."}, {"versions": ["sword"], "text": "In certain parts of Galar, Jynx was once feared and worshiped as the Queen of Ice."}, {"versions": ["shield"], "text": "The Jynx of Galar often have beautiful and delicate voices. Some of these Pokémon have even gathered a fan base."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/124.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/124.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/124.png", "shiny": "https://raw.git