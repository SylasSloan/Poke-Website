{"height": 15, "weight": 540, "base_experience": 175, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Single Horn Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヘラクロス"}, {"language": "ja-roma", "name": "Heracros"}, {"language": "ko", "name": "헤라크로스"}, {"language": "zh-hant", "name": "赫拉克羅斯"}, {"language": "fr", "name": "Scarhino"}, {"language": "de", "name": "Skaraborn"}, {"language": "es", "name": "Heracross"}, {"language": "it", "name": "Heracross"}, {"language": "ja", "name": "ヘラクロス"}, {"language": "zh-hans", "name": "赫拉克罗斯"}, {"language": "es-419", "name": "Heracross"}], "pokedex_entries": [{"versions": ["gold"], "text": "This powerful POKéMON thrusts its prized horn under its enemies’ bellies then lifts and throws them."}, {"versions": ["silver", "firered"], "text": "Usually docile, but if disturbed while sipping honey, it chases off the intruder with its horn."}, {"versions": ["crystal"], "text": "With its Herculean powers, it can easily throw arou­ nd an object that is 100 times its own weight."}, {"versions": ["ruby"], "text": "HERACROSS charges in a straight line at its foe, slips beneath the foe’s grasp, and then scoops up and hurls the opponent with its mighty horn. This POKéMON even has enough power to topple a massive tree."}, {"versions": ["sapphire"], "text": "HERACROSS has sharp claws on its feet. These are planted firmly into the ground or the bark of a tree, giving the POKéMON a secure and solid footing to forcefully fling away foes with its proud horn."}, {"versions": ["emerald"], "text": "They gather in forests seeking the sweet sap of trees. It is completely clad in a steel-hard shell. It is proud of its horn, which it uses to fling foes."}, {"versions": ["leafgreen"], "text": "This powerful POKéMON thrusts its prized horn under its enemies’ bellies, then lifts and throws them."}, {"versions": ["diamond"], "text": "It gathers in forests to search for tree sap, its favorite food. It’s strong enough to hurl foes."}, {"versions": ["pearl"], "text": "With powerful legs and claws, it generates enough power to hurl foes over great distances."}, {"versions": ["platinum", "black", "white"], "text": "It loves sweet honey. To keep all the honey to itself, it hurls rivals away with its prized horn."}, {"versions": ["heartgold", "x"], "text": "This powerful Pokémon thrusts its prized horn under its enemies’ bellies, then lifts and throws them."}, {"versions": ["soulsilver"], "text": "It is usually docile, but if it is disturbed while sipping honey, it chases off the intruder with its horn."}, {"versions": ["black-2", "white-2"], "text": "No matter how heavy its opponents, it flings them far away with its prized horn."}, {"versions": ["y"], "text": "With its Herculean powers, it can easily throw around an object that is 100 times its own weight."}, {"versions": ["omega-ruby"], "text": "Heracross charges in a straight line at its foe, slips beneath the foe’s grasp, and then scoops up and hurls the opponent with its mighty horn. This Pokémon even has enough power to topple a massive tree."}, {"versions": ["alpha-sapphire"], "text": "Heracross has sharp claws on its feet. These are planted firmly into the ground or the bark of a tree, giving the Pokémon a secure and solid footing to forcefully fling away foes with its proud horn."}, {"versions": ["ultra-sun"], "text": "It’s proud of its thick horn. In Alola, its biggest rival is Vikavolt, which it’s always fighting with."}, {"versions": ["ultra-moon"], "text": "It roams through forests searching for sweet nectar. Although it boasts fantastic physical strength, it’s not that good at flying."}, {"versions": ["sword"], "text": "Heracross loves sweet sap and will go looking through forests for it. The Pokémon uses its two antennae to pick up scents as it searches."}, {"versions": ["shield"], "text": "This Pokémon takes pride in its strength, which allows it to lift things 100 times heavier than itself with no trouble at all."}, {"versions": ["legends-arceus"], "text": "This Pokémon has an unparalleled horn. Heracross itself demonstrates tremendous power—it's capable of throwing several people trained in the traditional arts of war at once."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/214.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/214.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/214.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/214.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/214.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/214.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/214.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/214.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/214.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/214.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/214.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamon