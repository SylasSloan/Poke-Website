{"height": 5, "weight": 115, "base_experience": 71, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Shellfish Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["water1", "water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "カブト"}, {"language": "ja-roma", "name": "Kabuto"}, {"language": "ko", "name": "투구"}, {"language": "zh-hant", "name": "化石盔"}, {"language": "fr", "name": "Kabuto"}, {"language": "de", "name": "Kabuto"}, {"language": "es", "name": "Kabuto"}, {"language": "it", "name": "Kabuto"}, {"language": "ja", "name": "カブト"}, {"language": "zh-hans", "name": "化石盔"}, {"language": "es-419", "name": "Kabuto"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A POKéMON that was resurrected from a fossil found in what was once the ocean floor eons ago."}, {"versions": ["yellow"], "text": "A POKéMON that was recovered from a fossil. It uses the eyes on its back while hiding on the sea floor."}, {"versions": ["gold", "heartgold"], "text": "On rare occasions, some have been found as fossils which they became while hiding on the ocean floor."}, {"versions": ["silver"], "text": "This POKéMON lived in ancient times. On rare occasions, it has been discovered as a living fossil."}, {"versions": ["crystal"], "text": "Three hundred million years ago, it hid on the sea floor. It also has eyes on its back that glow."}, {"versions": ["ruby", "sapphire"], "text": "KABUTO is a POKéMON that has been regenerated from a fossil. However, in extremely rare cases, living examples have been discovered. The POKéMON has not changed at all for 300 million years."}, {"versions": ["emerald"], "text": "It is a POKéMON that has been regenerated from a fossil. However, in rare cases, living examples have been discovered. KABUTO have not changed for 300 million years."}, {"versions": ["firered"], "text": "This POKéMON was regenerated from the fossil of an ancient creature. It protects itself with a hard shell."}, {"versions": ["leafgreen"], "text": "A POKéMON that was regenerated from a fossil found in what was once the ocean floor long ago."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It is thought to have inhabited beaches 300 million years ago. It is protected by a stiff shell."}, {"versions": ["soulsilver"], "text": "This Pokémon lived in ancient times. On rare occasions, it has been discovered as a living fossil."}, {"versions": ["y"], "text": "This Pokémon was regenerated from the fossil of an ancient creature. It protects itself with a hard shell."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Kabuto is a Pokémon that has been regenerated from a fossil. However, in extremely rare cases, living examples have been discovered. The Pokémon has not changed at all for 300 million years."}, {"versions": ["ultra-sun"], "text": "This Pokémon thrived 300 million years ago. It’s said that living specimens can still be seen in a certain region—a rare sight."}, {"versions": ["ultra-moon"], "text": "This Pokémon became extinct everywhere, except in a few areas. It protects itself with its hard shell."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A Pokémon that was recovered from a fossil. It used the eyes on its back while hiding on the seafloor."}, {"versions": ["sword"], "text": "This species is almost entirely extinct. Kabuto molt every three days, making their shells harder and harder."}, {"versions": ["shield"], "text": "While some say this species has gone extinct, Kabuto sightings are apparently fairly common in some places."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/140.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/140.png", "shiny": null}}, "generation