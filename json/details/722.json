{"height": 3, "weight": 15, "base_experience": 64, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Grass Quill Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "モクロー"}, {"language": "ja-roma", "name": "Mokuroh"}, {"language": "ko", "name": "나몰빼미"}, {"language": "zh-hant", "name": "木木梟"}, {"language": "fr", "name": "Brindibou"}, {"language": "de", "name": "Bauz"}, {"language": "es", "name": "Rowlet"}, {"language": "it", "name": "Rowlet"}, {"language": "ja", "name": "モクロー"}, {"language": "zh-hans", "name": "木木枭"}, {"language": "es-419", "name": "Rowlet"}], "pokedex_entries": [{"versions": ["sun"], "text": "This wary Pokémon uses photosynthesis to store up energy during the day, while becoming active at night."}, {"versions": ["moon"], "text": "Silently it glides, drawing near its targets. Before they even notice it, it begins to pelt them with vicious kicks."}, {"versions": ["ultra-sun"], "text": "It sends its feathers, which are as sharp as blades, flying in attack. Its legs are strong, so its kicks are also formidable."}, {"versions": ["ultra-moon"], "text": "It feels relaxed in tight, dark places and has been known to use its Trainer’s pocket or bag as a nest."}, {"versions": ["sword"], "text": "At a distance, it launches its sharp feathers while flying about. If the enemy gets too close, Rowlet switches tactics and delivers vicious kicks."}, {"versions": ["shield"], "text": "During the day, it builds up energy via photosynthesis. At night, it flies silently through the sky, on the prowl for prey."}, {"versions": ["legends-arceus"], "text": "Flies noiselessly on delicate wings. It has mastered the art of deftly launching dagger-sharp feathers from those same wings."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generati