{"height": 13, "weight": 390, "base_experience": 158, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Goldfish Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アズマオウ"}, {"language": "ja-roma", "name": "Azumao"}, {"language": "ko", "name": "왕콘치"}, {"language": "zh-hant", "name": "金魚王"}, {"language": "fr", "name": "Poissoroy"}, {"language": "de", "name": "Golking"}, {"language": "es", "name": "Seaking"}, {"language": "it", "name": "Seaking"}, {"language": "ja", "name": "アズマオウ"}, {"language": "zh-hans", "name": "金鱼王"}, {"language": "es-419", "name": "Seaking"}], "pokedex_entries": [{"versions": ["white-2", "platinum", "black", "white", "black-2", "sword"], "text": "In autumn, its body becomes more fatty in preparing to propose to a mate. It takes on beautiful colors."}, {"versions": ["red", "blue"], "text": "In the autumn spawning season, they can be seen swimming power­ fully up rivers and creeks."}, {"versions": ["yellow"], "text": "It is the male's job to make a nest by carving out boulders in a stream using the horn on its head."}, {"versions": ["gold"], "text": "During spawning season, SEAKING gather from all over, coloring the rivers a brilliant red."}, {"versions": ["silver", "soulsilver", "shield"], "text": "Using its horn, it bores holes in riverbed boulders, making nests to prevent its eggs from washing away."}, {"versions": ["crystal"], "text": "When autumn comes, the males patrol the area around their nests in order to protect their offspring."}, {"versions": ["ruby"], "text": "In the autumn, SEAKING males can be seen performing courtship dances in riverbeds to woo females. During this season, this POKéMON’s body coloration is at its most beautiful."}, {"versions": ["sapphire"], "text": "SEAKING is very protective of its eggs. The male and female will take turns patrolling around their nest and eggs. The guarding of eggs by these POKéMON goes on for over a month."}, {"versions": ["emerald"], "text": "It punches holes in boulders on stream­ beds. This is a clever innovation that prevents its eggs from being attacked or washed away by the current."}, {"versions": ["firered"], "text": "The horn on its head is sharp like a drill. It bores a hole in a boulder to make its nest."}, {"versions": ["leafgreen", "x"], "text": "In the autumn spawning season, they can be seen swimming powerfully up rivers and creeks."}, {"versions": ["diamond", "y"], "text": "It makes its nest by hollowing out boulders in streams with its horn. It defends its eggs with its life."}, {"versions": ["pearl"], "text": "To protect its family, it will fight with its drill-sharp horn. It lives in hollowed rocks in streams."}, {"versions": ["heartgold"], "text": "During spawning season, SEAKING gather from all over, causing rivers to appear a brilliant red."}, {"versions": ["omega-ruby"], "text": "In the autumn, Seaking males can be seen performing courtship dances in riverbeds to woo females. During this season, this Pokémon’s body coloration is at its most beautiful."}, {"versions": ["alpha-sapphire"], "text": "Seaking is very protective of its eggs. The male and female will take turns patrolling around their nest and eggs. The guarding of eggs by these Pokémon goes on for over a month."}, {"versions": ["sun"], "text": "When the weather grows cold, its whole body flushes a deep red. This sight serves as a poetic reminder that autumn has arrived."}, {"versions": ["moon"], "text": "Trainers who are crazy for Seaking are divided into horn enthusiasts and fin enthusiasts. The two groups do not get along well."}, {"versions": ["ultra-sun"], "text": "Its horn spins like a drill to steadily hollow out rocks—even harder ones. The coloration of the male is more vivid."}, {"versions": ["ultra-moon"], "text": "To attract females, males dance on the river’s floor. The females gather around the male that dances most gracefully."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "It is the male’s job to make a nest by carving out boulders in a stream using the horn on its head."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/119.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/119.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/119.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/119.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/119.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/119.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/119.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/119.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/119.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/119.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/119.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/119.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/spr