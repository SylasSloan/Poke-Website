{"height": 17, "weight": 270, "base_experience": 170, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Deep Sea Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハンテール"}, {"language": "ja-roma", "name": "Huntail"}, {"language": "ko", "name": "헌테일"}, {"language": "zh-hant", "name": "獵斑魚"}, {"language": "fr", "name": "Serpang"}, {"language": "de", "name": "Aalabyss"}, {"language": "es", "name": "Huntail"}, {"language": "it", "name": "Huntail"}, {"language": "ja", "name": "ハンテール"}, {"language": "zh-hans", "name": "猎斑鱼"}, {"language": "es-419", "name": "Huntail"}], "pokedex_entries": [{"versions": ["ruby"], "text": "HUNTAIL’s presence went unnoticed by people for a long time because it lives at extreme depths in the sea. This POKéMON’s eyes can see clearly even in the murky dark depths of the ocean."}, {"versions": ["sapphire"], "text": "HUNTAIL’s tail is shaped like a fish. It uses the tail to attract prey, then swallows the prey whole with its large, gaping mouth. This POKéMON swims by wiggling its slender body like a snake."}, {"versions": ["emerald"], "text": "To withstand the crushing pressure of water deep under the sea, its spine is very thick and sturdy. Its tail, which is shaped like a small fish, has eyes that light up."}, {"versions": ["firered", "leafgreen", "x"], "text": "It lives deep in the sea where no light ever filters down. It lights up its small fishlike tail to attract prey."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It lives deep in the sea. With a tail shaped like a small fish, it attracts unsuspecting prey."}, {"versions": ["heartgold", "soulsilver"], "text": "It lives deep in the pitch-dark sea. It attracts prey by moving its tail in mimicry of a small animal."}, {"versions": ["omega-ruby"], "text": "Huntail’s presence went unnoticed by people for a long time because it lives at extreme depths in the sea. This Pokémon’s eyes can see clearly even in the murky dark depths of the ocean."}, {"versions": ["alpha-sapphire"], "text": "Huntail’s tail is shaped like a fish. It uses the tail to attract prey, then swallows the prey whole with its large, gaping mouth. This Pokémon swims by wiggling its slender body like a snake."}, {"versions": ["ultra-sun"], "text": "It’s not the strongest swimmer. It wags its tail to lure in its prey and then gulps them down as soon as they get close."}, {"versions": ["ultra-moon"], "text": "Deep seas are their habitat. According to tradition, when Huntail wash up onshore, something unfortunate will happen."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/367.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/367.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/367.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/367.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/367.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/367.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/367.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/367.png"}, "platinum": {"normal": "https://raw.githubu