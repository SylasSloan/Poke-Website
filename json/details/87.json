{"height": 17, "weight": 1200, "base_experience": 166, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Sea Lion Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ジュゴン"}, {"language": "ja-roma", "name": "Jugon"}, {"language": "ko", "name": "쥬레곤"}, {"language": "zh-hant", "name": "白海獅"}, {"language": "fr", "name": "Lamantine"}, {"language": "de", "name": "Jugong"}, {"language": "es", "name": "Dewgong"}, {"language": "it", "name": "Dewgong"}, {"language": "ja", "name": "ジュゴン"}, {"language": "zh-hans", "name": "白海狮"}, {"language": "es-419", "name": "Dewgong"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Stores thermal energy in its body. Swims at a steady 8 knots even in intensely cold waters."}, {"versions": ["yellow"], "text": "Its entire body is a snowy-white. Unharmed by even intense cold, it swims powerfully in icy waters."}, {"versions": ["gold", "heartgold", "y"], "text": "Its streamlined body has little drag in water. The colder the temperature, the friskier it gets."}, {"versions": ["silver", "soulsilver"], "text": "It loves frigid seas with ice floes. It uses its long tail to change swimming direction quickly."}, {"versions": ["crystal"], "text": "It sleeps under shallow ocean waters during the day, then looks for food at night when it's cold."}, {"versions": ["ruby", "sapphire"], "text": "DEWGONG loves to snooze on bitterly cold ice. The sight of this POKéMON sleeping on a glacier was mistakenly thought to be a mermaid by a mariner long ago."}, {"versions": ["emerald"], "text": "It loves to snooze on bitterly cold ice. The sight of this POKéMON sleeping on a glacier was mistakenly thought to be a mermaid by a mariner long ago."}, {"versions": ["firered", "x"], "text": "Its body is covered with a pure white fur. The colder the weather, the more active it becomes."}, {"versions": ["leafgreen"], "text": "It stores thermal energy in the body. It swims at a steady eight knots even in intensely cold waters."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "In snow, the pure white coat covering its body obscures it from predators."}, {"versions": ["black-2", "white-2"], "text": "Its streamlined body has low resistance, and it swims around cold oceans at a speed of eight knots."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Dewgong loves to snooze on bitterly cold ice. The sight of this Pokémon sleeping on a glacier was mistakenly thought to be a mermaid by a mariner long ago."}, {"versions": ["ultra-sun"], "text": "It swims through the ocean at a speed of eight knots, searching for Pokémon that will become its prey. It’s especially fond of Wishiwashi."}, {"versions": ["ultra-moon"], "text": "It sunbathes on the beach after meals. The rise in its body temperature helps its digestion."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Its entire body is a snowy white. Unharmed by even intense cold, it swims powerfully in icy waters."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/87.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/87.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/87.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/87.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/87.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/87.png"}, "sil