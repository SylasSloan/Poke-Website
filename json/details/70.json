{"height": 10, "weight": 64, "base_experience": 137, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Flycatcher Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ウツドン"}, {"language": "ja-roma", "name": "Utsudon"}, {"language": "ko", "name": "우츠동"}, {"language": "zh-hant", "name": "口呆花"}, {"language": "fr", "name": "Boustiflor"}, {"language": "de", "name": "Ultrigaria"}, {"language": "es", "name": "Weepinbell"}, {"language": "it", "name": "Weepinbell"}, {"language": "ja", "name": "ウツドン"}, {"language": "zh-hans", "name": "口呆花"}, {"language": "es-419", "name": "Weepinbell"}], "pokedex_entries": [{"versions": ["white-2", "diamond", "pearl", "platinum", "black", "white", "black-2"], "text": "A Pokémon that appears to be a plant. It captures unwary prey by dousing them with a toxic powder."}, {"versions": ["red", "blue", "leafgreen"], "text": "It spits out POISONPOWDER to immobilize the enemy and then finishes it with a spray of ACID."}, {"versions": ["yellow"], "text": "When hungry, it swallows anything that moves. Its hapless prey is melted inside by strong acids."}, {"versions": ["gold"], "text": "Even though it is filled with ACID, it does not melt because it also oozes a neutral­ izing fluid."}, {"versions": ["silver", "soulsilver"], "text": "If its prey is bigger than its mouth, it slices up the victim with sharp leaves, then eats every morsel."}, {"versions": ["crystal"], "text": "When it's hungry, it swings its razor-sharp leaves, slicing up any unlucky object nearby for food."}, {"versions": ["ruby", "sapphire"], "text": "WEEPINBELL has a large hook on its rear end. At night, the POKéMON hooks on to a tree branch and goes to sleep. If it moves around in its sleep, it may wake up to find itself on the ground."}, {"versions": ["emerald"], "text": "At night, a WEEPINBELL hangs on to a tree branch with its hooked rear and sleeps. If it moves around in its sleep, it may wake up to find itself on the ground."}, {"versions": ["firered", "x"], "text": "The leafy parts act as cutters for slashing foes. It spits a fluid that dissolves everything."}, {"versions": ["heartgold"], "text": "Even though it is filled with acid, it does not melt because it also oozes a protective fluid."}, {"versions": ["y"], "text": "It spits out Poison Powder to immobilize the enemy and then finishes it with a spray of Acid."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Weepinbell has a large hook on its rear end. At night, the Pokémon hooks on to a tree branch and goes to sleep. If it moves around in its sleep, it may wake up to find itself on the ground."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "When hungry, it swallows anything that moves. Its hapless prey is dissolved by strong acids."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/70.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/70.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/70.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/70.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/70.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/70.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/70.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/