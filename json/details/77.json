{"height": 10, "weight": 300, "base_experience": 82, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Fire Horse Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ポニータ"}, {"language": "ja-roma", "name": "Ponyta"}, {"language": "ko", "name": "포니타"}, {"language": "zh-hant", "name": "小火馬"}, {"language": "fr", "name": "Ponyta"}, {"language": "de", "name": "Ponita"}, {"language": "es", "name": "Ponyta"}, {"language": "it", "name": "Ponyta"}, {"language": "ja", "name": "ポニータ"}, {"language": "zh-hans", "name": "小火马"}, {"language": "es-419", "name": "Ponyta"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its hooves are 10 times harder than diamonds. It can trample anything completely flat in little time."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Capable of jumping incredibly high. Its hooves and sturdy legs absorb the impact of a hard landing."}, {"versions": ["gold"], "text": "It is a weak run­ ner immediately after birth. It gradually becomes faster by chasing after its parents."}, {"versions": ["silver"], "text": "Its hind legs, which have hard­ er-than-diamond hooves, kick back at any presence it senses behind it."}, {"versions": ["crystal"], "text": "Training by jumping over grass that grows longer every day has made it a world-class jumper."}, {"versions": ["ruby", "sapphire"], "text": "PONYTA is very weak at birth. It can barely stand up. This POKéMON becomes stronger by stumbling and falling to keep up with its parent."}, {"versions": ["emerald"], "text": "A PONYTA is very weak at birth. It can barely stand up. Its legs become stronger as it stumbles and falls while trying to keep up with its parent."}, {"versions": ["firered"], "text": "Its body is light, and its legs are incredibly powerful. It can clear Ayers Rock in one leap."}, {"versions": ["leafgreen"], "text": "Its hooves are ten times harder than diamond. It can trample anything completely flat in little time."}, {"versions": ["diamond"], "text": "About an hour after birth, its fiery mane and tail grow out, giving it an impressive appearance."}, {"versions": ["pearl", "y"], "text": "Its legs grow strong while it chases after its parent. It runs in fields and mountains all day."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x"], "text": "As a newborn, it can barely stand. However, through galloping, its legs are made tougher and faster."}, {"versions": ["heartgold"], "text": "It is a weak runner immediately after birth. It gradually becomes faster by chasing after its parents."}, {"versions": ["soulsilver"], "text": "Its hind legs, which have hooves that are harder than diamond, kick back at any presence it senses behind it."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Ponyta is very weak at birth. It can barely stand up. This Pokémon becomes stronger by stumbling and falling to keep up with its parent."}, {"versions": ["sword"], "text": "It can’t run properly when it’s newly born. As it races around with others of its kind, its legs grow stronger."}, {"versions": ["shield"], "text": "If you’ve been accepted by Ponyta, its burning mane is mysteriously no longer hot to the touch."}, {"versions": ["legends-arceus"], "text": "These Pokémon live in herds out in the grassland. Newborn foals lack their fiery manes, which will develop about an hour after birth."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/77.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/77.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/77.png", "shiny