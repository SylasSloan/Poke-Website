{"height": 3, "weight": 65, "base_experience": 65, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Evolution Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "イーブイ"}, {"language": "ja-roma", "name": "Eievui"}, {"language": "ko", "name": "이브이"}, {"language": "zh-hant", "name": "伊布"}, {"language": "fr", "name": "Évoli"}, {"language": "de", "name": "Evoli"}, {"language": "es", "name": "Eevee"}, {"language": "it", "name": "Eevee"}, {"language": "ja", "name": "イーブイ"}, {"language": "zh-hans", "name": "伊布"}, {"language": "es-419", "name": "Eevee"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its genetic code is irregular. It may mutate if it is exposed to radiation from element STONEs."}, {"versions": ["yellow"], "text": "Its genetic code is unstable, so it could evolve in a variety of ways. There are only a few alive."}, {"versions": ["gold"], "text": "It has the ability to alter the com­ position of its body to suit its surrounding envi­ ronment."}, {"versions": ["silver"], "text": "Its irregularly configured DNA is affected by its surroundings. It evolves if its en­ vironment changes."}, {"versions": ["crystal"], "text": "Its ability to evolve into many forms allows it to adapt smoothly and perfectly to any environment."}, {"versions": ["ruby", "sapphire"], "text": "EEVEE has an unstable genetic makeup that suddenly mutates due to the environment in which it lives. Radiation from various STONES causes this POKéMON to evolve."}, {"versions": ["emerald"], "text": "An EEVEE has an unstable genetic makeup that suddenly mutates due to its environment. Radiation from various STONES causes this POKéMON to evolve."}, {"versions": ["firered"], "text": "An extremely rare POKéMON that may evolve in a number of different ways depending on stimuli."}, {"versions": ["leafgreen"], "text": "Its genetic code is irregular. It may mutate if it is exposed to radiation from element STONES."}, {"versions": ["diamond", "pearl", "x"], "text": "A rare Pokémon that adapts to harsh environments by taking on different evolutionary forms."}, {"versions": ["platinum", "black", "white"], "text": "Because its genetic makeup is irregular, it quickly changes its form due to a variety of causes."}, {"versions": ["heartgold", "sword"], "text": "It has the ability to alter the composition of its body to suit its surrounding environment."}, {"versions": ["soulsilver"], "text": "Its irregularly configured DNA is affected by its surroundings. It evolves if its environment changes."}, {"versions": ["black-2", "white-2", "y", "shield"], "text": "Thanks to its unstable genetic makeup, this special Pokémon conceals many different possible evolutions."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Eevee has an unstable genetic makeup that suddenly mutates due to the environment in which it lives. Radiation from various stones causes this Pokémon to evolve."}, {"versions": ["sun"], "text": "Possessing an unbalanced and unstable genetic makeup, it conceals many possible evolutions."}, {"versions": ["moon"], "text": "Current studies show it can evolve into an incredible eight different species of Pokémon."}, {"versions": ["ultra-sun"], "text": "The question of why only Eevee has such unstable genes has still not been solved."}, {"versions": ["ultra-moon"], "text": "Its genes are easily influenced by its surroundings. Even its face starts to look like that of its Trainer."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "It can evolve into a variety of forms. Eevee’s genes are the key to solving the mysteries of Pokémon evolution."}, {"versions": ["legends-arceus"], "text": "Harbors the potential to evolve into manifold forms. Within Eevee lies the key to the mysteries of Pokémon evolution—I'm certain of it."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.github