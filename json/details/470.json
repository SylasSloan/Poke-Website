{"height": 10, "weight": 255, "base_experience": 184, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Verdant Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "リーフィア"}, {"language": "ja-roma", "name": "Leafia"}, {"language": "ko", "name": "리피아"}, {"language": "zh-hant", "name": "葉伊布"}, {"language": "fr", "name": "Phyllali"}, {"language": "de", "name": "Folipurba"}, {"language": "es", "name": "Leafeon"}, {"language": "it", "name": "Leafeon"}, {"language": "ja", "name": "リーフィア"}, {"language": "zh-hans", "name": "叶伊布"}, {"language": "es-419", "name": "Leafeon"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "y", "alpha-sapphire"], "text": "Just like a plant, it uses photosynthesis. As a result, it is always enveloped in clear air."}, {"versions": ["platinum", "black", "white"], "text": "It basically does not fight. With cells similar to those of plants, it can perform photosynthesis."}, {"versions": ["heartgold", "soulsilver"], "text": "When you see LEAFEON asleep in a patch of sunshine, you’ll know it is using photosynthesis to produce clean air."}, {"versions": ["black-2", "white-2"], "text": "With cells similar to those of plants, it performs photosynthesis inside its body and creates pure air."}, {"versions": ["x", "omega-ruby"], "text": "When you see Leafeon asleep in a patch of sunshine, you’ll know it is using photosynthesis to produce clean air."}, {"versions": ["sun"], "text": "Its cellular composition is closer to that of a plant than an animal. It uses photosynthesis to produce its energy supply without eating food."}, {"versions": ["moon"], "text": "The younger they are, the more they smell like fresh grass. With age, their fragrance takes on the odor of fallen leaves."}, {"versions": ["ultra-sun"], "text": "Although it doesn’t like disputes, it will sharpen the leaf on its tail into a blade and fight if it has to protect its friends."}, {"versions": ["ultra-moon"], "text": "It gets its nutrition from photosynthesis. It lives a quiet life deep in forests where clean rivers flow."}, {"versions": ["sword"], "text": "Galarians favor the distinctive aroma that drifts from this Pokémon’s leaves. There’s a popular perfume made using that scent."}, {"versions": ["shield"], "text": "This Pokémon’s tail is blade sharp, with a fantastic cutting edge that can slice right though large trees."}, {"versions": ["legends-arceus"], "text": "Cells similar to those of plants have been found in its fur. Its hard tail can fell a large tree with one stroke, and the tail's sharpness exceeds even that of a sword crafted by a master."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/470.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/470.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/470.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/470.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/470.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/470.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/470.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/470.png", "shiny": "https://raw.githubus