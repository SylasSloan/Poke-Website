{"height": 10, "weight": 295, "base_experience": 142, "ev_yield": [{"stat": "attack", "value": 2}, {"stat": "defense", "value": 1}], "genus": "Mushroom Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "パラセクト"}, {"language": "ja-roma", "name": "Parasect"}, {"language": "ko", "name": "파라섹트"}, {"language": "zh-hant", "name": "派拉斯特"}, {"language": "fr", "name": "Parasect"}, {"language": "de", "name": "Parasek"}, {"language": "es", "name": "Parasect"}, {"language": "it", "name": "Parasect"}, {"language": "ja", "name": "パラセクト"}, {"language": "zh-hans", "name": "派拉斯特"}, {"language": "es-419", "name": "Parasect"}], "pokedex_entries": [{"versions": ["gold"], "text": "It stays mostly in dark, damp places, the preference not of the bug, but of the big mush­ rooms on its back."}, {"versions": ["silver"], "text": "The larger the mushroom on its back grows, the stronger the mush­ room spores it scatters."}, {"versions": ["red", "blue", "leafgreen"], "text": "A host-parasite pair in which the parasite mushroom has taken over the host bug. Prefers damp places."}, {"versions": ["yellow"], "text": "The bug host is drained of energy by the mushrooms on its back. They appear to do all the thinking."}, {"versions": ["crystal"], "text": "When nothing's left to extract from the bug, the mushrooms on its back leave spores on the bug's egg."}, {"versions": ["ruby", "sapphire"], "text": "PARASECT is known to infest large trees en masse and drain nutrients from the lower trunk and roots. When an infested tree dies, they move onto another tree all at once."}, {"versions": ["emerald"], "text": "PARASECT are known to infest the roots of large trees en masse and drain nutrients. When an infested tree dies, they move onto another tree all at once."}, {"versions": ["firered"], "text": "It scatters toxic spores from the mushroom cap. In China, the spores are used as herbal medicine."}, {"versions": ["diamond", "platinum"], "text": "A mushroom grown larger than the host’s body controls PARASECT. It scatters poisonous spores."}, {"versions": ["pearl"], "text": "It is controlled by a mushroom grown larger than the bug body. It is said to prefer damp places."}, {"versions": ["heartgold"], "text": "It stays mostly in dark, damp places, the preference not of the bug, but of the big mushroom on its back."}, {"versions": ["soulsilver", "y"], "text": "The larger the mushroom on its back grows, the stronger the mushroom spores it scatters."}, {"versions": ["black", "white", "black-2", "white-2", "x"], "text": "A mushroom grown larger than the host’s body controls Parasect. It scatters poisonous spores."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Parasect is known to infest large trees en masse and drain nutrients from the lower trunk and roots. When an infested tree dies, they move onto another tree all at once."}, {"versions": ["sun"], "text": "The large mushroom on its back controls it. It often fights over territory with Shiinotic."}, {"versions": ["moon"], "text": "It scatters toxic spores from its mushroom cap. Once harvested, these spores can be steeped and boiled down to prepare herbal medicines."}, {"versions": ["ultra-sun"], "text": "The bug is mostly dead, with the mushroom on its back having become the main body. If the mushroom comes off, the bug stops moving."}, {"versions": ["ultra-moon"], "text": "Its poisonous spores are also used in traditional medicine. Apparently, spores produced in Alola are not of very good quality."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "The bug host is drained of energy by the mushroom on its back. The mushroom appears to do all the thinking."}, {"versions": ["legends-arceus"], "text": "Mushroom-lacking specimens of this Pokémon lie unmoving in the forest, lending credence to the hypothesis that the large mushroom is in control of Parasect's actions."}], 