{"height": 17, "weight": 505, "base_experience": 163, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Armor Bird Pokémon", "capture_rate": 25, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "エアームド"}, {"language": "ja-roma", "name": "Airmd"}, {"language": "ko", "name": "무장조"}, {"language": "zh-hant", "name": "盔甲鳥"}, {"language": "fr", "name": "Airmure"}, {"language": "de", "name": "Panzaeron"}, {"language": "es", "name": "Skarmory"}, {"language": "it", "name": "Skarmory"}, {"language": "ja", "name": "エアームド"}, {"language": "zh-hans", "name": "盔甲鸟"}, {"language": "es-419", "name": "Skarmory"}], "pokedex_entries": [{"versions": ["gold", "heartgold"], "text": "Its sturdy wings look heavy, but they are actually hollow and light, allowing it to fly freely in the sky."}, {"versions": ["silver", "firered", "soulsilver", "x"], "text": "After nesting in bramble bushes, the wings of its chicks grow hard from scratches by thorns."}, {"versions": ["crystal"], "text": "The feathers that it sheds are very sharp. It is said that people once used the feathers as swords."}, {"versions": ["ruby"], "text": "SKARMORY is entirely encased in hard, protective armor. This POKéMON flies at close to 190 mph. It slashes foes with its wings that possess swordlike cutting edges."}, {"versions": ["sapphire"], "text": "SKARMORY’s steel wings become tattered and bashed in from repeated battles. Once a year, the battered wings grow back completely, restoring the cutting edges to their pristine state."}, {"versions": ["emerald"], "text": "A POKéMON that has a body and wings of steel. People in the past used feathers fallen from SKARMORY to make swords and knives."}, {"versions": ["leafgreen"], "text": "Its sturdy wings look heavy, but its bones are hollow and light, allowing it to fly freely in the sky."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "Despite being clad entirely in iron-hard armor, it flies at speeds over 180 mph."}, {"versions": ["black-2", "white-2"], "text": "Its heavy-looking iron body is actually thin and light, so it can fly at speeds over 180 mph."}, {"versions": ["omega-ruby"], "text": "Skarmory is entirely encased in hard, protective armor. This Pokémon flies at close to 190 mph. It slashes foes with its wings that possess swordlike cutting edges."}, {"versions": ["alpha-sapphire"], "text": "Skarmory’s steel wings become tattered and bashed in from repeated battles. Once a year, the battered wings grow back completely, restoring the cutting edges to their pristine state."}, {"versions": ["sun"], "text": "Its feathers, which fall off as it grows, are thin and sharp. In times long past, warriors used them as swords."}, {"versions": ["moon"], "text": "Its metal body is sturdy, but it does rust rather easily. So on rainy days, this Pokémon prefers to stay put in its nest."}, {"versions": ["ultra-sun"], "text": "The wing feathers it sheds can be processed and made into knives whose sharpness is recognized by the finest chefs."}, {"versions": ["ultra-moon"], "text": "Its body is draped in steel armor. It looks heavy, but it can fly at speeds of up to 185 miles an hour!"}, {"versions": ["sword"], "text": "The pointed feathers of these Pokémon are sharper than swords. Skarmory and Corviknight fight viciously over territory."}, {"versions": ["shield"], "text": "People fashion swords from Skarmory’s shed feathers, so this Pokémon is a popular element in heraldic designs."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/227.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/227.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/227.png",