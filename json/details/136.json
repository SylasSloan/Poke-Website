{"height": 9, "weight": 250, "base_experience": 184, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Flame Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ブースター"}, {"language": "ja-roma", "name": "Booster"}, {"language": "ko", "name": "부스터"}, {"language": "zh-hant", "name": "火伊布"}, {"language": "fr", "name": "Pyroli"}, {"language": "de", "name": "Flamara"}, {"language": "es", "name": "Flareon"}, {"language": "it", "name": "Flareon"}, {"language": "ja", "name": "ブースター"}, {"language": "zh-hans", "name": "火伊布"}, {"language": "es-419", "name": "Flareon"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "When storing thermal energy in its body, its temperature could soar to over 1600 degrees."}, {"versions": ["yellow"], "text": "It has a flame chamber inside its body. It inhales, then blows out fire that is over 3,000F degrees."}, {"versions": ["gold"], "text": "It stores some of the air it inhales in its internal flame pouch, which heats it to over 3,000 degrees."}, {"versions": ["silver"], "text": "It fluffs out its fur collar to cool down its body temperature, which can reach 1,650 degrees."}, {"versions": ["crystal"], "text": "Once it has stored up enough heat, this POKéMON's body temperature can reach up to 1700 degrees."}, {"versions": ["ruby", "sapphire"], "text": "FLAREON’s fluffy fur has a functional purpose - it releases heat into the air so that its body does not get excessively hot. This POKéMON’s body temperature can rise to a maximum of 1,650 degrees F."}, {"versions": ["emerald"], "text": "FLAREON’s fluffy fur releases heat into the air so that its body does not get excessively hot. Its body temperature can rise to a maximum of 1,650 degrees F."}, {"versions": ["firered"], "text": "It has a flame bag inside its body. After inhaling deeply, it blows out flames of nearly 3,100 degrees Fahrenheit."}, {"versions": ["leafgreen"], "text": "When storing thermal energy in its body, its temperature can soar to over 1,600 degrees Fahrenheit."}, {"versions": ["diamond", "pearl", "x"], "text": "It has a flame sac in its body. Its body temperature tops 1,650 degrees Fahrenheit before battle."}, {"versions": ["platinum", "black", "white"], "text": "Inhaled air is heated in the flame sac in its body to an intense fire over 3,000 degrees Fahrenheit."}, {"versions": ["heartgold", "shield"], "text": "It stores some of the air it inhales in its internal flame pouch, which heats it to over 3,000 degrees Fahrenheit."}, {"versions": ["soulsilver"], "text": "It fluffs out its fur collar to cool down its body temperature, which can reach 1,650 degrees Fahrenheit."}, {"versions": ["black-2", "white-2"], "text": "Inhaled air is carried to its flame sac, heated, and exhaled as fire that reaches over 3,000 degrees F."}, {"versions": ["y"], "text": "It has a flame bag inside its body. After inhaling deeply, it blows out flames of nearly 3,000 degrees Fahrenheit."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Flareon’s fluffy fur has a functional purpose—it releases heat into the air so that its body does not get excessively hot. This Pokémon’s body temperature can rise to a maximum of 1,650 degrees Fahrenheit."}, {"versions": ["sun"], "text": "When it catches prey or finds berries, it breathes fire on them until they’re well done, and then it gobbles them up."}, {"versions": ["moon"], "text": "Its average body temperature is between 1,300 and 1,500 degrees Fahrenheit. In its internal flame sac, temperatures reach 3,000 degrees."}, {"versions": ["ultra-sun"], "text": "If it inhales deeply, that’s a sign it’s about to attack. Prepare to be hit by flames of over 3,000 degrees Fahrenheit!"}, {"versions": ["ultra-moon"], "text": "The flame chamber inside its body ignites when Flareon gets agitated, reaching temperatures of up to 1,650 degrees Fahrenheit."}, {"versions": ["lets-go-pikac