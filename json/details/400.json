{"height": 10, "weight": 315, "base_experience": 144, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Beaver Pokémon", "capture_rate": 127, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ビーダル"}, {"language": "ja-roma", "name": "Beadaru"}, {"language": "ko", "name": "비버통"}, {"language": "zh-hant", "name": "大尾狸"}, {"language": "fr", "name": "Castorno"}, {"language": "de", "name": "Bidifas"}, {"language": "es", "name": "Bibarel"}, {"language": "it", "name": "Bibarel"}, {"language": "ja", "name": "ビーダル"}, {"language": "zh-hans", "name": "大尾狸"}, {"language": "es-419", "name": "Bibarel"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "It makes its nest by damming streams with bark and mud. It is known as an industrious worker."}, {"versions": ["pearl"], "text": "While its movements out of water are sluggish, it can swim as fast as any FEEBAS."}, {"versions": ["platinum"], "text": "A river dammed by BIBAREL will never overflow its banks, which is appreciated by people nearby."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "It busily makes its nest with stacks of branches and roots it has cut up with its sharp incisors."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "A river dammed by Bibarel will never overflow its banks, which is appreciated by people nearby."}, {"versions": ["legends-arceus"], "text": "Bibarel fur repels water and is also a fantastic material for heat retention. These Pokémon create dams on rivers to live in."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/400.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/400.png"}, "heartgold-soulsilver": {"