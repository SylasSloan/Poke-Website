{"height": 9, "weight": 455, "base_experience": 67, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Jellyfish Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "メノクラゲ"}, {"language": "ja-roma", "name": "Menokurage"}, {"language": "ko", "name": "왕눈해"}, {"language": "zh-hant", "name": "瑪瑙水母"}, {"language": "fr", "name": "Tentacool"}, {"language": "de", "name": "Tentacha"}, {"language": "es", "name": "Tentacool"}, {"language": "it", "name": "Tentacool"}, {"language": "ja", "name": "メノクラゲ"}, {"language": "zh-hans", "name": "玛瑙水母"}, {"language": "es-419", "name": "Tentacool"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Drifts in shallow seas. Anglers who hook them by accident are often punished by its stinging acid."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "It can sometimes be found all dry and shriveled up on a beach. Toss it back into the sea to revive it."}, {"versions": ["gold", "heartgold"], "text": "When the tide goes out, dehydrated TENTACOOL remains can be found washed up on the shore."}, {"versions": ["silver"], "text": "It drifts aimless­ ly in waves. Very difficult to see in water, it may not be noticed until it stings."}, {"versions": ["crystal"], "text": "As it floats along on the waves, it uses its toxic feelers to stab anything it touches."}, {"versions": ["ruby"], "text": "TENTACOOL’s body is largely composed of water. If it is removed from the sea, it dries up like parchment. If this POKéMON happens to become dehydrated, put it back into the sea."}, {"versions": ["sapphire"], "text": "TENTACOOL absorbs sunlight and refracts it using water inside its body to convert it into beam energy. This POKéMON shoots beams from its crystal-like eyes."}, {"versions": ["emerald"], "text": "Its body is almost entirely composed of water. It ensnares its foe with its two long tentacles, then stabs with the poison stingers at their tips."}, {"versions": ["firered"], "text": "Its eyes are as transparent as crystals. From them, it shoots mysterious beams of light."}, {"versions": ["leafgreen", "y"], "text": "Drifts in shallow seas. Anglers who hook them by accident are often punished by their stingers."}, {"versions": ["diamond", "x"], "text": "Its body is virtually composed of water. It shoots strange beams from its crystal-like eyes."}, {"versions": ["pearl"], "text": "It drifts in sea currents. Countless fishermen are hurt by its poison stingers."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Because its body is almost entirely composed of water, it shrivels up if it is washed ashore."}, {"versions": ["soulsilver"], "text": "It drifts aimlessly in waves. Very difficult to see in water, it may not be noticed until it stings."}, {"versions": ["omega-ruby"], "text": "Tentacool’s body is largely composed of water. If it is removed from the sea, it dries up like parchment. If this Pokémon happens to become dehydrated, put it back into the sea."}, {"versions": ["alpha-sapphire"], "text": "Tentacool absorbs sunlight and refracts it using water inside its body to convert it into beam energy. This Pokémon shoots beams from the small round organ above its eyes."}, {"versions": ["sun"], "text": "They can be found lying dehydrated on beaches, but they are often still alive. When soaked in water, they will revive."}, {"versions": ["moon"], "text": "It drifts in shallow seas, such as the areas near beaches. If you get bitten or stabbed by its toxic tentacles, rush to the hospital."}, {"versions": ["ultra-sun"], "text": "It drifts through the sea searching for prey. Its poisonous tentacles break off sometimes, but after a while, they grow back."}, {"versions": ["ultra-moon"], "text": "Its body is 99% water. The remaining 1% contains the organ that makes its poison."}, {"versions": ["sword"], "text": "Tentacool is not a particularly strong swimmer. It drifts across the surface of shallow seas as it searches for prey."}, {"versions": ["shield"], "text": "This Pokémon is mostly made of water. A Tentacool out in the ocean is very hard to spot, because its body blends in with the sea."}, {"versions": ["legends-arceus"], "text": "They fire beams from the glassy, magenta orbs that resemble eyes atop their heads, and they drift in shallow seas. During low tide, they can sometimes be found on beaches, desiccated."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/72.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/72.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/72.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/72.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/72.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/72.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/72.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/72.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/72.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/72.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/Poke