{"height": 6, "weight": 150, "base_experience": 64, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Goldfish Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "トサキント"}, {"language": "ja-roma", "name": "Tosakinto"}, {"language": "ko", "name": "콘치"}, {"language": "zh-hant", "name": "角金魚"}, {"language": "fr", "name": "Poissirène"}, {"language": "de", "name": "Goldini"}, {"language": "es", "name": "Goldeen"}, {"language": "it", "name": "Goldeen"}, {"language": "ja", "name": "トサキント"}, {"language": "zh-hans", "name": "角金鱼"}, {"language": "es-419", "name": "Goldeen"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its tail fin billows like an elegant ballroom dress, giving it the nickname of the Water Queen."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "When it is time for them to lay eggs, they can be seen swimming up rivers and falls in large groups."}, {"versions": ["gold"], "text": "Its dorsal, pecto­ ral and tail fins wave elegantly in water. That is why it is known as the water dancer."}, {"versions": ["silver"], "text": "A strong swimmer, it is capable of swimming nonstop up fast streams at a steady speed of five knots."}, {"versions": ["crystal"], "text": "During spawning season, they swim gracefully in the water, searching for their perfect mate."}, {"versions": ["ruby"], "text": "GOLDEEN is a very beautiful POKéMON with fins that billow elegantly in water. However, don’t let your guard down around this POKéMON - it could ram you powerfully with its horn."}, {"versions": ["sapphire"], "text": "GOLDEEN loves swimming wild and free in rivers and ponds. If one of these POKéMON is placed in an aquarium, it will shatter even the thickest glass with one ram of its horn and make its escape."}, {"versions": ["emerald"], "text": "In the springtime, schools of GOLDEEN can be seen swimming up falls and rivers. It metes out staggering damage with its single horn."}, {"versions": ["firered", "shield"], "text": "Its dorsal and pectoral fins are strongly developed like muscles. It can swim at a speed of five knots."}, {"versions": ["leafgreen"], "text": "Its tail fin billows like an elegant ballroom dress, giving it the nickname of “The Water Queen.”"}, {"versions": ["diamond"], "text": "It swims elegantly by flittering its tail fin as if it were a dress. It has the look of a queen."}, {"versions": ["pearl", "x"], "text": "It swims at a steady 5 knots. If it senses danger, it will strike back with its sharp horn."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Though it appears very elegant when swimming with fins unfurled, it can jab powerfully with its horn."}, {"versions": ["heartgold"], "text": "Its dorsal, pectoral and tail fins wave elegantly in water. That is why it is known as the water dancer."}, {"versions": ["soulsilver"], "text": "A strong swimmer, it is capable of swimming nonstop up fast streams at a steady speed of five knots per hour."}, {"versions": ["y"], "text": "Its dorsal, pectoral, and tail fins wave elegantly in water. That is why it is known as the water dancer."}, {"versions": ["omega-ruby"], "text": "Goldeen is a very beautiful Pokémon with fins that billow elegantly in water. However, don’t let your guard down around this Pokémon—it could ram you powerfully with its horn."}, {"versions": ["alpha-sapphire"], "text": "Goldeen loves swimming wild and free in rivers and ponds. If one of these Pokémon is placed in an aquarium, it will shatter even the thickest glass with one ram of its horn and make its escape."}, {"versions": ["sun"], "text": "When the weather grows warm, they form groups and swim upriver. This sight serves as a poetic reminder that spring has arrived."}, {"versions": ["moon"], "text": "Spellbound by the length of its horn and the beauty of its fins, many strange Trainers raise Goldeen and nothing but Goldeen."}, {"versions": ["ultra-sun"], "text": "Although known for their splendid tail fins, Goldeen apparently compete among themselves to see whose horn is thickest and sharpest."}, {"versions": ["ultra-moon"], "text": "The way it swims along fluttering its dress-like fins has earned it the name “princess of the water.”"}, {"versions": ["sword"], "text": "Its dorsal, pectoral, and tail fins wave elegantly in water. That is why it is known as the Water Dancer."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/118.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/118.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/118.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/118.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/118.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/118.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/118.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/118.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/118.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/118.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/s