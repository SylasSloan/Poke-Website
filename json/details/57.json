{"height": 10, "weight": 320, "base_experience": 159, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Pig Monkey Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オコリザル"}, {"language": "ja-roma", "name": "Okorizaru"}, {"language": "ko", "name": "성원숭"}, {"language": "zh-hant", "name": "火爆猴"}, {"language": "fr", "name": "Colossinge"}, {"language": "de", "name": "Rasaff"}, {"language": "es", "name": "Primeape"}, {"language": "it", "name": "Primeape"}, {"language": "ja", "name": "オコリザル"}, {"language": "zh-hans", "name": "火暴猴"}, {"language": "es-419", "name": "Primeape"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Always furious and tenacious to boot. It will not abandon chasing its quarry until it is caught."}, {"versions": ["yellow", "x", "lets-go-pikachu", "lets-go-eevee"], "text": "It stops being angry only when nobody else is around. To view this moment is very difficult."}, {"versions": ["gold", "heartgold"], "text": "If approached while asleep, it may awaken and angrily give chase in a groggy state of semi-sleep."}, {"versions": ["silver", "soulsilver"], "text": "It becomes wildly furious if it even senses someone looking at it. It chases anyone that meets its glare."}, {"versions": ["crystal"], "text": "It will beat up anyone who makes it mad, even if it has to chase them until the end of the world."}, {"versions": ["ruby", "sapphire"], "text": "When PRIMEAPE becomes furious, its blood circulation is boosted. In turn, its muscles are made even stronger. However, it also becomes much less intelligent at the same time."}, {"versions": ["emerald"], "text": "When it becomes furious, its blood circulation becomes more robust, and its muscles are made stronger. But it also becomes much less intelligent."}, {"versions": ["firered", "y"], "text": "It is always outrageously furious. If it gives chase, it will tenaciously track the target no matter how far."}, {"versions": ["leafgreen"], "text": "Always furious and tenacious to boot. It will not abandon chasing its quarry until it catches up."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It grows angry if you see its eyes and gets angrier if you run. If you beat it, it gets even madder."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "When Primeape becomes furious, its blood circulation is boosted. In turn, its muscles are made even stronger. However, it also becomes much less intelligent at the same time."}, {"versions": ["sun"], "text": "It has been known to become so angry that it dies as a result. Its face looks peaceful in death, however."}, {"versions": ["moon"], "text": "Some researchers theorize that Primeape remains angry even when inside a Poké Ball."}, {"versions": ["ultra-sun"], "text": "It will never forgive opponents who have angered it. Even after it has beaten them down until they can’t move, it never ever forgives."}, {"versions": ["ultra-moon"], "text": "The blood vessels in its brain are sturdier than those of other Pokémon, so it can stay healthy despite its constant raging."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/57.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/57.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/57.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/57.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/57.png", "shiny": "https://raw.github