{"height": 6, "weight": 152, "base_experience": 59, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Lightning Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ラクライ"}, {"language": "ja-roma", "name": "Rakurai"}, {"language": "ko", "name": "썬더라이"}, {"language": "zh-hant", "name": "落雷獸"}, {"language": "fr", "name": "Dynavolt"}, {"language": "de", "name": "Frizelbliz"}, {"language": "es", "name": "Electrike"}, {"language": "it", "name": "Electrike"}, {"language": "ja", "name": "ラクライ"}, {"language": "zh-hans", "name": "落雷兽"}, {"language": "es-419", "name": "Electrike"}], "pokedex_entries": [{"versions": ["ruby"], "text": "ELECTRIKE stores electricity in its long body hair. This POKéMON stimulates its leg muscles with electric charges. These jolts of power give its legs explosive acceleration performance."}, {"versions": ["sapphire"], "text": "ELECTRIKE runs faster than the human eye can follow. The friction from running is converted into electricity, which is then stored in this POKéMON’s fur."}, {"versions": ["emerald"], "text": "It generates electricity using friction from the atmosphere. In seasons with especially arid air, its entire body blazes with violent showers of sparks."}, {"versions": ["firered", "leafgreen", "y", "sword"], "text": "It stores static electricity in its fur for discharging. It gives off sparks if a storm approaches."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Using electricity stored in its fur, it stimulates its muscles to heighten its reaction speed."}, {"versions": ["heartgold", "soulsilver", "shield"], "text": "It stores electricity in its fur. It gives off sparks from all over its body in seasons when the air is dry."}, {"versions": ["omega-ruby"], "text": "Electrike stores electricity in its long body hair. This Pokémon stimulates its leg m