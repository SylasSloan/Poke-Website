{"height": 4, "weight": 85, "base_experience": 88, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Aqua Mouse Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["water1", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マリル"}, {"language": "ja-roma", "name": "Maril"}, {"language": "ko", "name": "마릴"}, {"language": "zh-hant", "name": "瑪力露"}, {"language": "fr", "name": "Marill"}, {"language": "de", "name": "Marill"}, {"language": "es", "name": "Marill"}, {"language": "it", "name": "Marill"}, {"language": "ja", "name": "マリル"}, {"language": "zh-hans", "name": "玛力露"}, {"language": "es-419", "name": "Marill"}], "pokedex_entries": [{"versions": ["gold"], "text": "The tip of its tail, which con­ tains oil that is lighter than wa­ ter, lets it swim without drowning."}, {"versions": ["silver", "firered", "soulsilver"], "text": "The end of its tail serves as a buoy that keeps it from drowning, even in a vicious current."}, {"versions": ["crystal", "x"], "text": "The fur on its body naturally repels water. It can stay dry, even when it plays in the water."}, {"versions": ["ruby"], "text": "MARILL’s oil-filled tail acts much like a life preserver. If you see just its tail bobbing on the water’s surface, it’s a sure indication that this POKéMON is diving beneath the water to feed on aquatic plants."}, {"versions": ["sapphire"], "text": "When fishing for food at the edge of a fast-running stream, MARILL wraps its tail around the trunk of a tree. This POKéMON’s tail is flexible and configured to stretch."}, {"versions": ["emerald"], "text": "Its body is covered with water-repellent fur. Because of the fur, it can swim through water at high speed without being slowed by the water’s resistance."}, {"versions": ["leafgreen", "heartgold"], "text": "The tip of its tail, which contains oil that is lighter than water, lets it swim without drowning."}, {"versions": ["diamond"], "text": "Using its tail as a float, it dives underwater. It likes eating plants that grow on river bottoms."}, {"versions": ["pearl", "y"], "text": "The tip of its tail is filled with oil that is lighter than water, so it acts as a float."}, {"versions": ["platinum"], "text": "The oil-filled end of its tail floats on water. It keeps MARILL from drowning even in a strong current."}, {"versions": ["black", "white"], "text": "The oil-filled end of its tail floats on water. It keeps Marill from drowning even in a strong current."}, {"versions": ["black-2", "white-2"], "text": "The oil-filled tail functions as a buoy, so it’s fine even in rivers with strong currents."}, {"versions": ["omega-ruby"], "text": "Marill’s oil-filled tail acts much like a life preserver. If you see just its tail bobbing on the water’s surface, it’s a sure indication that this Pokémon is diving beneath the water to feed on aquatic plants."}, {"versions": ["alpha-sapphire"], "text": "When fishing for food at the edge of a fast-running stream, Marill wraps its tail around the trunk of a tree. This Pokémon’s tail is flexible and configured to stretch."}, {"versions": ["sword"], "text": "This Pokémon uses its round tail as a float. The ball of Marill’s tail is filled with nutrients that have been turned into an oil."}, {"versions": ["shield"], "text": "Even after Marill swims in a cold sea, its water- repellent fur dries almost as soon as Marill leaves the water. That’s why this Pokémon is never cold."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/183.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/183.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/183.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g