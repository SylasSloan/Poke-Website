{"height": 6, "weight": 70, "base_experience": 68, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Boxing Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マケンカニ"}, {"language": "ja-roma", "name": "Makenkani"}, {"language": "ko", "name": "오기지게"}, {"language": "zh-hant", "name": "好勝蟹"}, {"language": "fr", "name": "Crabagarre"}, {"language": "de", "name": "Krabbox"}, {"language": "es", "name": "Crabrawler"}, {"language": "it", "name": "Crabrawler"}, {"language": "ja", "name": "マケンカニ"}, {"language": "zh-hans", "name": "好胜蟹"}, {"language": "es-419", "name": "Crabrawler"}], "pokedex_entries": [{"versions": ["sun"], "text": "While guarding its weak points with its pincers, it looks for an opening and unleashes punches. When it loses, it foams at the mouth and faints."}, {"versions": ["moon"], "text": "It punches so much, its pincers often come off from overuse, but they grow back quickly. What little meat they contain is rich and delicious."}, {"versions": ["ultra-sun"], "text": "Its hard pincers are well suited to both offense and defense. Fights between two Crabrawler are like boxing matches."}, {"versions": ["ultra-moon"], "text": "Crabrawler has been known to mistake Exeggutor for a coconut tree and climb it. The enraged Exeggutor shakes it off and stomps it."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/739.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/739.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/739.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com