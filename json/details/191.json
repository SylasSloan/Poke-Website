{"height": 3, "weight": 18, "base_experience": 36, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Seed Pokémon", "capture_rate": 235, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヒマナッツ"}, {"language": "ja-roma", "name": "Himanuts"}, {"language": "ko", "name": "해너츠"}, {"language": "zh-hant", "name": "向日種子"}, {"language": "fr", "name": "Tournegrin"}, {"language": "de", "name": "Sonnkern"}, {"language": "es", "name": "Sunkern"}, {"language": "it", "name": "Sunkern"}, {"language": "ja", "name": "ヒマナッツ"}, {"language": "zh-hans", "name": "向日种子"}, {"language": "es-419", "name": "Sunkern"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It may drop out of the sky suddenly. If attacked by a SPEAROW, it will violently shake its leaves."}, {"versions": ["silver"], "text": "It lives by drink­ ing only dewdrops from under the leaves of plants. It is said that it eats nothing else."}, {"versions": ["crystal"], "text": "It is very weak. Its only means of defense is to shake its leaves desperately at its attacker."}, {"versions": ["ruby", "sapphire"], "text": "SUNKERN tries to move as little as it possibly can. It does so because it tries to conserve all the nutrients it has stored in its body for its evolution. It will not eat a thing, subsisting only on morning dew."}, {"versions": ["emerald"], "text": "SUNKERN try to minimize movement to conserve the nutrients they have stored in their bodies for evolution. They will not eat, subsisting only on morning dew."}, {"versions": ["firered", "soulsilver", "y"], "text": "It lives by drinking only dewdrops from under the leaves of plants. It is said that it eats nothing else."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It suddenly falls out of the sky in the morning. A year after a cold summer, their population explodes."}, {"versions": ["heartgold"], "text": "It may plummet from the sky. If attacked by a SPEAROW, it will violently shake its leaves."}, {"versions": ["black-2", "white-2"], "text": "It suddenly falls out of the sky in the morning. Knowing it’s weak, it simply feeds until it evolves."}, {"versions": ["x"], "text": "It may plummet from the sky. If attacked by a Spearow, it will violently shake its leaves."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Sunkern tries to move as little as it possibly can. It does so because it tries to conserve all the nutrients it has stored in its body for its evolution. It will not eat a thing, subsisting only on morning dew."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/191.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/191.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/191.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/191.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/191.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/191.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/191.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/191.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/191.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versi