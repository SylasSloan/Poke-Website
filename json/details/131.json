{"height": 25, "weight": 2200, "base_experience": 187, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Transport Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["monster", "water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ラプラス"}, {"language": "ja-roma", "name": "Laplace"}, {"language": "ko", "name": "라프라스"}, {"language": "zh-hant", "name": "拉普拉斯"}, {"language": "fr", "name": "Lokhlass"}, {"language": "de", "name": "Lapras"}, {"language": "es", "name": "Lapras"}, {"language": "it", "name": "Lapras"}, {"language": "ja", "name": "ラプラス"}, {"language": "zh-hans", "name": "拉普拉斯"}, {"language": "es-419", "name": "Lapras"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A POKéMON that has been over­ hunted almost to extinction. It can ferry people across the water."}, {"versions": ["yellow"], "text": "A gentle soul that can read the minds of people. It can ferry people across the sea on its back."}, {"versions": ["gold"], "text": "They have gentle hearts. Because they rarely fight, many have been caught. Their num­ ber has dwindled."}, {"versions": ["silver", "soulsilver"], "text": "It ferries people across the sea on its back. It may sing an enchanting cry if it is in a good mood."}, {"versions": ["crystal"], "text": "This gentle POKéMON loves to give people rides and provides a ve­ ry comfortable way to get around."}, {"versions": ["ruby", "sapphire"], "text": "People have driven LAPRAS almost to the point of extinction. In the evenings, this POKéMON is said to sing plaintively as it seeks what few others of its kind still remain."}, {"versions": ["emerald"], "text": "People have driven LAPRAS almost to the point of extinction. In the evenings, it is said to sing plaintively as it seeks what few others of its kind still remain."}, {"versions": ["firered", "y"], "text": "Its high intelligence enables it to understand human speech. It likes to ferry people on its back."}, {"versions": ["leafgreen"], "text": "A POKéMON that has been overhunted almost to extinction. It can ferry people on its back."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It loves crossing the sea with people and Pokémon on its back. It understands human speech."}, {"versions": ["heartgold", "x"], "text": "They have gentle hearts. Because they rarely fight, many have been caught. Their number has dwindled."}, {"versions": ["black-2", "white-2"], "text": "Able to understand human speech and very intelligent, it loves to swim in the sea with people on its back."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "People have driven Lapras almost to the point of extinction. In the evenings, this Pokémon is said to sing plaintively as it seeks what few others of its kind still remain."}, {"versions": ["sun"], "text": "Its high intelligence enables it to comprehend human speech. When it’s in a good mood, it sings in its beautiful voice."}, {"versions": ["moon"], "text": "These Pokémon were once near extinction due to poaching. Following protective regulations, there is now an overabundance of them."}, {"versions": ["ultra-sun"], "text": "It likes swimming around with people on its back. In the Alola region, it’s an important means of transportation over water."}, {"versions": ["ultra-moon"], "text": "They’ve been so cherished that there’s now an overabundance. The fish Pokémon population has declined in waters with too many Lapras."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A gentle soul that can understand human speech. It can ferry people across the sea on its back."}, {"versions": ["sword"], "text": "A smart and kindhearted Pokémon, it glides across the surface of the sea while its beautiful song echoes around it."}, {"versions": ["shield"], "text": "Crossing icy seas is no issue for this cold-resistant Pokémon. Its smooth skin is a little cool to the touch."}], "sprites_by_gen": {"generation-i": {"red-blue": {