{"height": 9, "weight": 285, "base_experience": 168, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "special-attack", "value": 1}], "genus": "Jet Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オクタン"}, {"language": "ja-roma", "name": "Okutank"}, {"language": "ko", "name": "대포무노"}, {"language": "zh-hant", "name": "章魚桶"}, {"language": "fr", "name": "Octillery"}, {"language": "de", "name": "Octillery"}, {"language": "es", "name": "Octillery"}, {"language": "it", "name": "Octillery"}, {"language": "ja", "name": "オクタン"}, {"language": "zh-hans", "name": "章鱼桶"}, {"language": "es-419", "name": "Octillery"}], "pokedex_entries": [{"versions": ["gold"], "text": "It traps enemies with its suction- cupped tentacles then smashes them with its rock-hard head."}, {"versions": ["silver"], "text": "It instinctively sneaks into rocky holes. If it gets sleepy, it steals the nest of a fel­ low OCTILLERY."}, {"versions": ["crystal"], "text": "Its instinct is to bury itself in holes. It often steals the nesting holes of others to sleep in them."}, {"versions": ["ruby", "sapphire"], "text": "OCTILLERY grabs onto its foe using its tentacles. This POKéMON tries to immobilize it before delivering the finishing blow. If the foe turns out to be too strong, OCTILLERY spews ink to escape."}, {"versions": ["emerald"], "text": "It ensnares its foe with its suction- cupped tentacles before delivering the finishing blow. If the foe turns out to be too strong, it spews ink to escape."}, {"versions": ["firered", "soulsilver"], "text": "It instinctively sneaks into rocky holes. If it gets sleepy, it steals the nest of a fellow OCTILLERY."}, {"versions": ["leafgreen", "shield"], "text": "It traps enemies with its suction-cupped tentacles, then smashes them with its rock-hard head."}, {"versions": ["diamond"], "text": "It lives in the gaps of boulders and in holes on the seafloor. Its suction cups grip prey tightly."}, {"versions": ["pearl"], "text": "It obscures its foe’s vision by spitting a cloud of murky ink. It makes its nest among boulders."}, {"versions": ["platinum", "black", "white"], "text": "It loves to lurk inside holes in rocks. It sometimes sprays ink on prey by sticking out only its mouth."}, {"versions": ["heartgold", "y"], "text": "It traps foes with the suction cups on its tentacles, then smashes them with its rock-hard head."}, {"versions": ["black-2", "white-2", "x", "sword"], "text": "It has a tendency to want to be in holes. It prefers rock crags or pots and sprays ink from them before attacking."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Octillery grabs onto its foe using its tentacles. This Pokémon tries to immobilize it before delivering the finishing blow. If the foe turns out to be too strong, Octillery spews ink to escape."}, {"versions": ["ultra-sun"], "text": "The ink it spits when escaping is special. It contains a substance that dulls the sense of smell, so Pokémon with keen noses get lost."}, {"versions": ["ultra-moon"], "text": "It usually sleeps in caves. The pitch-black ink that Octillery spits is also used for cooking."}, {"versions": ["legends-arceus"], "text": "While Octillery still shoots water from its mouth, the drastic anatomical difference between it and Remoraid meant that for a long time, no one believed the former evolved from the latter."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/224.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/224.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/224.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/v