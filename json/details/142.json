{"height": 18, "weight": 590, "base_experience": 180, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Fossil Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "slow", "egg_groups": ["flying"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "プテラ"}, {"language": "ja-roma", "name": "Ptera"}, {"language": "ko", "name": "프테라"}, {"language": "zh-hant", "name": "化石翼龍"}, {"language": "fr", "name": "Ptéra"}, {"language": "de", "name": "Aerodactyl"}, {"language": "es", "name": "Aerodactyl"}, {"language": "it", "name": "Aerodactyl"}, {"language": "ja", "name": "プテラ"}, {"language": "zh-hans", "name": "化石翼龙"}, {"language": "es-419", "name": "Aerodactyl"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A ferocious, pre­ historic POKéMON that goes for the enemy's throat with its serrated saw-like fangs."}, {"versions": ["yellow"], "text": "A savage POKéMON that died out in ancient times. It was resurrected using DNA taken from amber."}, {"versions": ["gold"], "text": "A vicious POKéMON from the distant past, it appears to have flown by spreading its wings and gliding."}, {"versions": ["silver"], "text": "This vicious POKé­ MON is said to have flown in an­ cient skies while shrieking high- pitched cries."}, {"versions": ["crystal"], "text": "In prehistoric times, this POKéMON flew freely and fearlessly through the skies."}, {"versions": ["ruby", "sapphire"], "text": "AERODACTYL is a POKéMON from the age of dinosaurs. It was regenerated from genetic material extracted from amber. It is imagined to have been the king of the skies in ancient times."}, {"versions": ["emerald"], "text": "AERODACTYL is a POKéMON from the age of dinosaurs. It was regenerated from DNA extracted from amber. It is imagined to have been the king of the skies."}, {"versions": ["firered", "x"], "text": "It was regenerated from a dinosaur’s genetic matter that was found in amber. It flies with high-pitched cries."}, {"versions": ["leafgreen"], "text": "A ferocious, prehistoric POKéMON that goes for the enemy’s throat with its serrated, sawlike fangs."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "A Pokémon that roamed the skies in the dinosaur era. Its teeth are like saw blades."}, {"versions": ["heartgold"], "text": "A vicious Pokémon from the distant past, it appears to have flown by spreading its wings and gliding."}, {"versions": ["soulsilver", "y"], "text": "This vicious Pokémon is said to have flown in ancient skies while shrieking high-pitched cries."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Aerodactyl is a Pokémon from the age of dinosaurs. It was regenerated from genetic material extracted from amber. It is imagined to have been the king of the skies in ancient times."}, {"versions": ["sun"], "text": "A Pokémon from the age of the dinosaurs. It used its sawlike fangs to shred its prey before eating them."}, {"versions": ["moon"], "text": "In ancient times, it ruled the skies. A widely accepted theory is that it went extinct due to a large meteor impact."}, {"versions": ["ultra-sun"], "text": "Restored from DNA found in amber, this Pokémon exhibited ferocity that was greater than expected. Some casualties resulted."}, {"versions": ["ultra-moon"], "text": "It flew through the open skies over the ancient continent as if they were its own. When it touched ground, its walk was weak and slow."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A savage Pokémon that died out in ancient times. It was resurrected using DNA taken from amber."}, {"versions": ["sword"], "text": "This is a ferocious Pokémon from ancient times. Apparently even modern technology is incapable of producing a perfectly restored specimen."}, {"versions": ["shield"], "text": "Aerodactyl’s sawlike fangs can shred skin to tatters—even the skin of Steel-type Pokémon."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercon