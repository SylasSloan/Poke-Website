{"height": 13, "weight": 405, "base_experience": 173, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Shellfish Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["water1", "water3"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "カブトプス"}, {"language": "ja-roma", "name": "Kabutops"}, {"language": "ko", "name": "투구푸스"}, {"language": "zh-hant", "name": "鐮刀盔"}, {"language": "fr", "name": "Kabutops"}, {"language": "de", "name": "Kabutops"}, {"language": "es", "name": "Kabutops"}, {"language": "it", "name": "Kabutops"}, {"language": "ja", "name": "カブトプス"}, {"language": "zh-hans", "name": "镰刀盔"}, {"language": "es-419", "name": "Kabutops"}], "pokedex_entries": [{"versions": ["sword"], "text": "Kabutops slices its prey apart and sucks out the fluids. The discarded body parts become food for other Pokémon."}, {"versions": ["red", "blue"], "text": "Its sleek shape is perfect for swim­ ming. It slashes prey with its claws and drains the body fluids."}, {"versions": ["yellow", "y"], "text": "A slim and fast swimmer. It slices its prey with its sharp sickles and drinks the body fluids."}, {"versions": ["gold", "heartgold", "x"], "text": "In the water, it tucks in its limbs to become more compact, then it wiggles its shell to swim fast."}, {"versions": ["silver"], "text": "With sharp claws, this ferocious, ancient POKéMON rips apart prey and sucks their body fluids."}, {"versions": ["crystal"], "text": "It was able to swim quickly thro­ ugh the water by compactly folding up its razor-sharp sickles."}, {"versions": ["ruby", "sapphire"], "text": "KABUTOPS swam underwater to hunt for its prey in ancient times. The POKéMON was apparently evolving from being a water-dweller to living on land as evident from the beginnings of change in its gills and legs."}, {"versions": ["emerald"], "text": "KABUTOPS once swam underwater to hunt for prey. It was apparently evolving from being a water dweller to living on land as evident from changes in its gills and legs."}, {"versions": ["firered"], "text": "It swims freely through water. It catches prey with its scythe-like arms and drains the victim’s fluids."}, {"versions": ["leafgreen"], "text": "Its sleek shape is perfect for swimming. It slashes prey with its claws and drains their fluids."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It is thought that this Pokémon came onto land because its prey adapted to life on land."}, {"versions": ["soulsilver"], "text": "With sharp claws, this ferocious, ancient Pokémon rips apart prey and sucks their body fluids."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Kabutops swam underwater to hunt for its prey in ancient times. The Pokémon was apparently evolving from being a water dweller to living on land as evident from the beginnings of change in its gills and legs."}, {"versions": ["ultra-sun"], "text": "Its body had begun to change so it could function on land. But it didn’t adapt in time and went extinct."}, {"versions": ["ultra-moon"], "text": "It swims at speeds of roughly 29 knots, quickly closing in on its prey and slashing into them with its scythes to finish them off."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A slim and fast swimmer. It sliced its prey with its sharp sickles and drank the body fluids."}, {"versions": ["shield"], "text": "The cause behind the extinction of this species is unknown. Kabutops were aggressive Pokémon that inhabited warm seas."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/141.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/141.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/