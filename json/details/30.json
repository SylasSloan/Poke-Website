{"height": 8, "weight": 200, "base_experience": 128, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Poison Pin Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["no-eggs"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ニドリーナ"}, {"language": "ja-roma", "name": "Nidorina"}, {"language": "ko", "name": "니드리나"}, {"language": "zh-hant", "name": "尼多娜"}, {"language": "fr", "name": "Nidorina"}, {"language": "de", "name": "Nidorina"}, {"language": "es", "name": "Nidorina"}, {"language": "it", "name": "Nidorina"}, {"language": "ja", "name": "ニドリーナ"}, {"language": "zh-hans", "name": "尼多娜"}, {"language": "es-419", "name": "Nidorina"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The female's horn develops slowly. Prefers physical attacks such as clawing and biting."}, {"versions": ["yellow"], "text": "When resting deep in its burrow, its thorns always retract. This is proof that it is relaxed."}, {"versions": ["gold"], "text": "When feeding its young, it first chews and tender­ izes the food, then spits it out for the offspring."}, {"versions": ["silver", "soulsilver"], "text": "It has a calm and caring nature. Because its horn grows slowly, it prefers not to fight."}, {"versions": ["crystal"], "text": "It has a docile nature. If it is threatened with attack, it raises the barbs that are all over its body."}, {"versions": ["ruby", "sapphire"], "text": "When NIDORINA are with their friends or family, they keep their barbs tucked away to prevent hurting each other. This POKéMON appears to become nervous if separated from the others."}, {"versions": ["emerald"], "text": "When it is with its friends or family, its barbs are tucked away to prevent injury. It appears to become nervous if separated from the others."}, {"versions": ["firered", "x"], "text": "The female has a gentle temperament. It emits ultrasonic cries that have the power to befuddle foes."}, {"versions": ["leafgreen"], "text": "The female’s horns develop slowly. Prefers physical attacks such as clawing and biting."}, {"versions": ["diamond", "pearl", "platinum"], "text": "When it senses danger, it raises all the barbs on its body. These barbs grow slower than NIDORINO’s."}, {"versions": ["heartgold", "y"], "text": "When feeding its young, it first chews the food into a paste, then spits it out for the offspring."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "When it senses danger, it raises all the barbs on its body. These barbs grow slower than Nidorino’s."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "When Nidorina are with their friends or family, they keep their barbs tucked away to prevent hurting each other. This Pokémon appears to become nervous if separated from the others."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "When resting deep in its burrow, its barbs always retract. This is proof that it is relaxed."}, {"versions": ["sword"], "text": "The horn on its head has atrophied. It’s thought that this happens so Nidorina’s children won’t get poked while their mother is feeding them."}, {"versions": ["shield"], "text": "If the group is threatened, these Pokémon will band together to assault enemies with a chorus of ultrasonic waves."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/30.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/30.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/30.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/30.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/mas