{"height": 8, "weight": 208, "base_experience": 61, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Savage Pokémon", "capture_rate": 225, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キバニア"}, {"language": "ja-roma", "name": "Kibanha"}, {"language": "ko", "name": "샤프니아"}, {"language": "zh-hant", "name": "利牙魚"}, {"language": "fr", "name": "Carvanha"}, {"language": "de", "name": "Kanivanha"}, {"language": "es", "name": "Carvanha"}, {"language": "it", "name": "Carvanha"}, {"language": "ja", "name": "キバニア"}, {"language": "zh-hans", "name": "利牙鱼"}, {"language": "es-419", "name": "Carvanha"}], "pokedex_entries": [{"versions": ["ruby"], "text": "CARVANHA’s strongly developed jaws and its sharply pointed fangs pack the destructive power to rip out boat hulls. Many boats have been attacked and sunk by this POKéMON."}, {"versions": ["sapphire"], "text": "If anything invades CARVANHA’s territory, it will swarm and tear at the intruder with its pointed fangs. On its own, however, this POKéMON turns suddenly timid."}, {"versions": ["emerald"], "text": "CARVANHA attack ships in swarms, making them sink. Although it is said to be a very vicious POKéMON, it timidly flees as soon as it finds itself alone."}, {"versions": ["firered", "leafgreen", "y"], "text": "It lives in massive rivers that course through jungles. It swarms prey that enter its territory."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "They swarm any foe that invades their territory. Their sharp fangs can tear out boat hulls."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "They form packs to attack boats and rip out their hulls to sink them. They live in rivers in the jungle."}, {"versions": ["omega-ruby"], "text": "Carvanha’s strongly developed jaws and its sharply pointed fangs pack the destructive power to rip out boat hulls. Many boats have been attacked and sunk by this Pokémon."}, {"versions": ["alpha-sapphire"], "text": "If anything invades Carvanha’s territory, it will swarm and tear at the intruder with its pointed fangs. On its own, however, this Pokémon turns suddenly timid."}, {"versions": ["sun"], "text": "Each school has its own territory. Any intruders are mercilessly attacked with fangs bared."}, {"versions": ["moon"], "text": "If they scent the faintest trace of blood, they rush to attack en masse. When alone, they’re rather cowardly."}, {"versions": ["ultra-sun"], "text": "They’re such cowards that they won’t hunt alone. When five or so of them get together, they suddenly turn ferocious!"}, {"versions": ["ultra-moon"], "text": "With its sturdy jaws and fangs, it can easily chomp wooden boats to splinters. It fights with Basculin over food."}, {"versions": ["sword"], "text": "It won’t attack while it’s alone—not even if it spots prey. Instead, it waits for other Carvanha to join it, and then the Pokémon attack as a group."}, {"versions": ["shield"], "text": "These Pokémon have sharp fangs and powerful jaws. Sailors avoid Carvanha dens at all costs."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/318.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/318.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/318.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/318.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/318.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/vers