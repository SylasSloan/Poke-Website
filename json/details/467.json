{"height": 16, "weight": 680, "base_experience": 243, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Blast Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "ブーバーン"}, {"language": "ja-roma", "name": "Booburn"}, {"language": "ko", "name": "마그마번"}, {"language": "zh-hant", "name": "鴨嘴炎獸"}, {"language": "fr", "name": "Maganon"}, {"language": "de", "name": "Magbrant"}, {"language": "es", "name": "Magmortar"}, {"language": "it", "name": "Magmortar"}, {"language": "ja", "name": "ブーバーン"}, {"language": "zh-hans", "name": "鸭嘴炎兽"}, {"language": "es-419", "name": "Magmortar"}], "pokedex_entries": [{"versions": ["diamond", "pearl"], "text": "It blasts fireballs of over 3,600 degrees F from the ends of its arms. It lives in volcanic craters."}, {"versions": ["platinum", "black", "white"], "text": "When launching 3,600 degrees F fireballs, its body takes on a whitish hue from the intense heat."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "It blasts fireballs of over 3,600 degrees Fahrenheit out of its arms. Its breath also sears and sizzles."}, {"versions": ["black-2", "white-2"], "text": "When shooting 3,600 degree F fireballs from its arms, its body takes on a whitish hue from the intense heat."}, {"versions": ["x", "omega-ruby"], "text": "It blasts fireballs of over 3,600 degrees Fahrenheit from the ends of its arms. It lives in volcanic craters."}, {"versions": ["sun"], "text": "They dwell in volcanic craters. According to what is known, a single pair of male and female Magmortar lives in one volcano."}, {"versions": ["moon"], "text": "From its arm, it launches fireballs hotter than 3,500 degrees Fahrenheit. Its arm starts to melt when it fires a whole barrage."}, {"versions": ["ultra-sun"], "text": "There are still quite a few factories that rely on the flames provided by Magmortar to process 