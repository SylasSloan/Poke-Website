{"height": 11, "weight": 648, "base_experience": 86, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Fly Scorpion Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "グライガー"}, {"language": "ja-roma", "name": "Gliger"}, {"language": "ko", "name": "글라이거"}, {"language": "zh-hant", "name": "天蠍"}, {"language": "fr", "name": "Scorplane"}, {"language": "de", "name": "Skorgla"}, {"language": "es", "name": "Gligar"}, {"language": "it", "name": "Gligar"}, {"language": "ja", "name": "グライガー"}, {"language": "zh-hans", "name": "天蝎"}, {"language": "es-419", "name": "Gligar"}], "pokedex_entries": [{"versions": ["gold"], "text": "It flies straight at its target's face then clamps down on the star­ tled victim to inject poison."}, {"versions": ["silver", "firered", "soulsilver", "x"], "text": "It usually clings to cliffs. When it spots its prey, it spreads its wings and glides down to attack."}, {"versions": ["crystal"], "text": "It builds its nest on a steep cliff. When it is done gliding, it hops along the ground back to its nest."}, {"versions": ["ruby", "sapphire"], "text": "GLIGAR glides through the air without a sound as if it were sliding. This POKéMON hangs on to the face of its foe using its clawed hind legs and the large pincers on its forelegs, then injects the prey with its poison barb."}, {"versions": ["emerald"], "text": "It glides without making a single sound. It grasps the face of its foe using its hind and large front claws, then stabs with its poison barb."}, {"versions": ["leafgreen", "heartgold", "y"], "text": "It flies straight at its target’s face, then clamps down on the startled victim to inject poison."}, {"versions": ["diamond", "pearl"], "text": "It sails on the winds with its limbs extended to strike from the sky. It aims for the prey’s face."}, {"versions": ["platinum", "black", "white"], "text": "It glides as if 