{"height": 6, "weight": 124, "base_experience": 60, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Tadpole Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ニョロモ"}, {"language": "ja-roma", "name": "Nyoromo"}, {"language": "ko", "name": "발챙이"}, {"language": "zh-hant", "name": "蚊香蝌蚪"}, {"language": "fr", "name": "Ptitard"}, {"language": "de", "name": "Quapsel"}, {"language": "es", "name": "Poliwag"}, {"language": "it", "name": "Poliwag"}, {"language": "ja", "name": "ニョロモ"}, {"language": "zh-hans", "name": "蚊香蝌蚪"}, {"language": "es-419", "name": "Poliwag"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its newly grown legs prevent it from running. It appears to prefer swimming than trying to stand."}, {"versions": ["yellow", "y", "lets-go-pikachu", "lets-go-eevee"], "text": "The direction of the spiral on the belly differs by area. It is more adept at swimming than walking."}, {"versions": ["gold"], "text": "Because it is in­ ept at walking on its newly grown legs, it always swims around in water."}, {"versions": ["silver", "soulsilver"], "text": "The direction of its belly spiral differs by area. The equator is thought to have an effect on this."}, {"versions": ["crystal"], "text": "The swirl on its belly is its insides showing through the skin. It looks clearer after it eats."}, {"versions": ["ruby", "sapphire"], "text": "POLIWAG has a very thin skin. It is possible to see the POKéMON’s spiral innards right through the skin. Despite its thinness, however, the skin is also very flexible. Even sharp fangs bounce right off it."}, {"versions": ["emerald"], "text": "It is possible to see this POKéMON’s spiral innards right through its thin skin. However, the skin is also very flexible. Even sharp fangs bounce right off it."}, {"versions": ["firered", "x"], "text": "Its slick black skin is thin and damp. A part of its internal organs can be seen through the skin as a spiral pattern."}, {"versions": ["leafgreen"], "text": "Its newly grown legs prevent it from walking well. It appears to prefer swimming over walking."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Its skin is so thin, its internal organs are visible. It has trouble walking on its newly grown feet."}, {"versions": ["heartgold"], "text": "Because it is inept at walking on its newly grown legs, it always swims around in water."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Poliwag has a very thin skin. It is possible to see the Pokémon’s spiral innards right through the skin. Despite its thinness, however, the skin is also very flexible. Even sharp fangs bounce right off it."}, {"versions": ["sun"], "text": "The swirl on its belly is its internal organs showing through. If the swirl is tinged white, that means it’s affected by some disease."}, {"versions": ["moon"], "text": "It’s still not very good at walking. Its Trainers should train this Pokémon to walk every day."}, {"versions": ["ultra-sun"], "text": "Despite the danger, it wants to come up on land. So it does its best to waddle along, but when an enemy finds it, it rushes back to the water."}, {"versions": ["ultra-moon"], "text": "The direction of the swirl on their stomachs differs depending on where they live. Poliwag aficionados can tell them apart at a glance."}, {"versions": ["sword"], "text": "For Poliwag, swimming is easier than walking. The swirl pattern on its belly is actually part of the Pokémon’s innards showing through the skin."}, {"versions": ["shield"], "text": "In rivers with fast-flowing water, this Pokémon will cling to a rock by using its thick lips, which act like a suction cup."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/60.png", "shiny": null}, "yel