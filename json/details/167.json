{"height": 5, "weight": 85, "base_experience": 50, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "String Spit Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "fast", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "イトマル"}, {"language": "ja-roma", "name": "Itomaru"}, {"language": "ko", "name": "페이검"}, {"language": "zh-hant", "name": "圓絲蛛"}, {"language": "fr", "name": "Mimigal"}, {"language": "de", "name": "Webarak"}, {"language": "es", "name": "Spinarak"}, {"language": "it", "name": "Spinarak"}, {"language": "ja", "name": "イトマル"}, {"language": "zh-hans", "name": "圆丝蛛"}, {"language": "es-419", "name": "Spinarak"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "It lies still in the same pose for days in its web, waiting for its unsuspecting prey to wander close."}, {"versions": ["silver"], "text": "It spins a web using fine--but durable--thread. It then waits pa­ tiently for prey to be trapped."}, {"versions": ["crystal"], "text": "If prey becomes ensnared in its nest of spun string, it waits motionlessly until it becomes dark."}, {"versions": ["ruby", "sapphire"], "text": "The web spun by SPINARAK can be considered its second nervous system. It is said that this POKéMON can determine what kind of prey is touching its web just by the tiny vibrations it feels through the web’s strands."}, {"versions": ["emerald"], "text": "The web it spins can be considered its second nervous system. It is said that a SPINARAK determines its prey by the tiny vibrations it feels through the web."}, {"versions": ["firered"], "text": "It spins a web using fine--but durable-- thread. It then waits patiently for prey to be trapped."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It sets a trap by spinning a web with thin but strong silk. It waits motionlessly for prey to arrive."}, {"versions": ["soulsilver", "x"], "text": "It spins a web using fine--but durable--thread. It then waits patiently for prey to be trapped."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "The web spun by Spinarak can be considered its second nervous system. It is said that this Pokémon can determine what kind of prey is touching its web just by the tiny vibrations it feels through the web’s strands."}, {"versions": ["sun"], "text": "It waits intently until its preferred prey, Cutiefly, gets caught in its web. In fact, it’s quite a patient Pokémon."}, {"versions": ["moon"], "text": "Some fishermen weave its sturdy thread into nets to catch fish Pokémon."}, {"versions": ["ultra-sun"], "text": "With threads from its mouth, it fashions sturdy webs that won’t break even if you set a rock on them."}, {"versions": ["ultra-moon"], "text": "Although the poison from its fangs isn’t that strong, it’s potent enough to weaken prey that gets caught in its web."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/167.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/167.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/167.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/167.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/167.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/167.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/167.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pok