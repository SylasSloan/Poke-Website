{"height": 11, "weight": 800, "base_experience": 182, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Mysterious Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water3"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "スターミー"}, {"language": "ja-roma", "name": "Starmie"}, {"language": "ko", "name": "아쿠스타"}, {"language": "zh-hant", "name": "寶石海星"}, {"language": "fr", "name": "Staross"}, {"language": "de", "name": "Starmie"}, {"language": "es", "name": "Starmie"}, {"language": "it", "name": "Starmie"}, {"language": "ja", "name": "スターミー"}, {"language": "zh-hans", "name": "宝石海星"}, {"language": "es-419", "name": "Starmie"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x"], "text": "Its central core glows with the seven colors of the rainbow. Some people value the core as a gem."}, {"versions": ["yellow"], "text": "The center section is named the core. People think it is communicating when it glows in 7 colors."}, {"versions": ["gold"], "text": "The center section of its body is called the core. It glows in a dif­ ferent color each time it is seen."}, {"versions": ["silver"], "text": "Regardless of the environment it lives in, its body grows to form a symmetrical geo­ metric shape."}, {"versions": ["crystal"], "text": "It is said that it uses the seven- colored core of its body to send electric waves into outer space."}, {"versions": ["ruby"], "text": "STARMIE’s center section - the core - glows brightly in seven colors. Because of its luminous nature, this POKéMON has been given the nickname “the gem of the sea.”"}, {"versions": ["sapphire"], "text": "STARMIE swims through water by spinning its star-shaped body as if it were a propeller on a ship. The core at the center of this POKéMON’s body glows in seven colors."}, {"versions": ["emerald"], "text": "People in ancient times imagined that STARMIE were transformed from the reflections of stars that twinkled on gentle waves at night."}, {"versions": ["firered"], "text": "This POKéMON has a geometric body. Because of its body, the locals suspect that it is an alien creature."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "At the center of its body is a red core, which sends mysterious radio signals into the night sky."}, {"versions": ["heartgold"], "text": "The middle section of its body is called the core. It glows in a different color each time it is seen."}, {"versions": ["soulsilver"], "text": "Regardless of the environment it lives in, its body grows to form a symmetrical geometric shape."}, {"versions": ["black-2", "white-2"], "text": "Its core shines in many colors and sends radio signals into space to communicate with something."}, {"versions": ["omega-ruby"], "text": "Starmie’s center section—the core—glows brightly in seven colors. Because of its luminous nature, this Pokémon has been given the nickname “the gem of the sea.”"}, {"versions": ["alpha-sapphire"], "text": "Starmie swims through water by spinning its star-shaped body as if it were a propeller on a ship. The core at the center of this Pokémon’s body glows in seven colors."}, {"versions": ["sun"], "text": "Its shining core is thought to receive and transmit enigmatic signals. It has been known to cause headaches in those who approach it."}, {"versions": ["moon"], "text": "Its unusual body shape, reminiscent of abstract art, led local people to spread rumors that this Pokémon may be an invader from outer space."}, {"versions": ["ultra-sun"], "text": "Its sparkling core is called “the gem of the sea.” This core can be made into high-priced accessories that are traded in secret."}, {"versions": ["ultra-moon"], "text": "It rotates its geometrically shaped body to swim through the water. It always seems to be sending out mysterious radio waves."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "The center section is named the core. People think it is communicating when it glows in seven colors."}, {"versions": ["sword"], "text": "This Pokémon has an organ known as its core. The organ glows in seven colors when Starmie is unleashing its potent psychic powers."}, {"versions": ["shield"], "text": "Starmie swims by spinning its body at high speed. As this Pokémon cruises through the ocean, it absorbs tiny plankton."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/121.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/121.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/121.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/121.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/121.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/121.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/121.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/121.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/121.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/121.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/121.png", "shiny": "https://raw.githubusercontent.com/PokeAPI