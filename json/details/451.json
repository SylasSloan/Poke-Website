{"height": 8, "weight": 120, "base_experience": 66, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Scorpion Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["bug", "water3"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "スコルピ"}, {"language": "ja-roma", "name": "Scorupi"}, {"language": "ko", "name": "스콜피"}, {"language": "zh-hant", "name": "鉗尾蠍"}, {"language": "fr", "name": "Rapion"}, {"language": "de", "name": "Pionskora"}, {"language": "es", "name": "Skorupi"}, {"language": "it", "name": "Skorupi"}, {"language": "ja", "name": "スコルピ"}, {"language": "zh-hans", "name": "钳尾蝎"}, {"language": "es-419", "name": "Skorupi"}], "pokedex_entries": [{"versions": ["diamond", "x", "omega-ruby"], "text": "It grips prey with its tail claws and injects poison. It tenaciously hangs on until the poison takes."}, {"versions": ["pearl"], "text": "It lives in arid lands. It buries itself in sand and lies in wait for unsuspecting prey."}, {"versions": ["platinum", "black", "white"], "text": "As soon as the tail claws close, its needle tips secrete poison. It can survive a year without food."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "It burrows under the sand to lie in wait for prey. Its tail claws can inject its prey with a savage poison."}, {"versions": ["black-2", "white-2"], "text": "It lives in arid regions and can go without food for a year while waiting for prey."}, {"versions": ["sword"], "text": "After burrowing into the sand, it waits patiently for prey to come near. This Pokémon and Sizzlipede share common descent."}, {"versions": ["shield"], "text": "It attacks using the claws on its tail. Once locked in its grip, its prey is unable to move as this Pokémon’s poison seeps in."}, {"versions": ["legends-arceus"], "text": "Its claws are not only razor-sharp but poisonous, making Skorupi a highly dangerous Pokémon. It seems to be weakened by cold temperatures, how