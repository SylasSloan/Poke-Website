{"height": 5, "weight": 804, "base_experience": 165, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Coal Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コータス"}, {"language": "ja-roma", "name": "Cotoise"}, {"language": "ko", "name": "코터스"}, {"language": "zh-hant", "name": "煤炭龜"}, {"language": "fr", "name": "Chartor"}, {"language": "de", "name": "Qurtel"}, {"language": "es", "name": "Torkoal"}, {"language": "it", "name": "Torkoal"}, {"language": "ja", "name": "コータス"}, {"language": "zh-hans", "name": "煤炭龟"}, {"language": "es-419", "name": "Torkoal"}], "pokedex_entries": [{"versions": ["ruby"], "text": "TORKOAL digs through mountains in search of coal. If it finds some, it fills hollow spaces on its shell with the coal and burns it. If it is attacked, this POKéMON spouts thick black smoke to beat a retreat."}, {"versions": ["sapphire"], "text": "TORKOAL generates energy by burning coal. It grows weaker as the fire dies down. When it is preparing for battle, this POKéMON burns more coal."}, {"versions": ["emerald"], "text": "It battles using energy it gets from burning coal. When loosing smoke from its nostrils, it lets off a sound that is similar to a locomotive’s horn."}, {"versions": ["firered", "leafgreen"], "text": "It burns coal inside its shell. If it is attacked, it belches thick, black smoke and flees."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y", "sword"], "text": "It burns coal inside its shell for energy. It blows out black soot if it is endangered."}, {"versions": ["heartgold", "soulsilver", "x", "shield"], "text": "You find abandoned coal mines full of them. They dig tirelessly in search of coal."}, {"versions": ["omega-ruby"], "text": "Torkoal digs through mountains in search of coal. If it finds some, it fills hollow spaces on its shell with the coal and burns it. If it is attacked, this Pokémon spouts thick black smoke to beat a retreat."}, {"versions": ["alpha-sapphire"], "text": "Torkoal generates energy by burning coal. It grows weaker as the fire dies down. When it is preparing for battle, this Pokémon burns more coal."}, {"versions": ["sun"], "text": "Coal is the source of Torkoal’s energy. Large amounts of coal can be found in the mountains where they live."}, {"versions": ["moon"], "text": "If the fire burning within its shell goes out, it will die. Those who wish to raise one in their home must always keep something flammable at hand."}, {"versions": ["ultra-sun"], "text": "You can tell how it’s feeling by the smoke spouting from its shell. Tremendous velocity is a sign of good health."}, {"versions": ["ultra-moon"], "text": "It burns coal to produce energy. When it has burned through all of its coal, it becomes unable to move."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/324.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/324.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/324.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/324.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/324.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/324.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/324.png", "shiny": "https://raw.githubusercontent.c