{"height": 6, "weight": 78, "base_experience": 60, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Fairy Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["ground", "fairy"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ブルー"}, {"language": "ja-roma", "name": "Bulu"}, {"language": "ko", "name": "블루"}, {"language": "zh-hant", "name": "布魯"}, {"language": "fr", "name": "Snubbull"}, {"language": "de", "name": "Snubbull"}, {"language": "es", "name": "Snubbull"}, {"language": "it", "name": "Snubbull"}, {"language": "ja", "name": "ブルー"}, {"language": "zh-hans", "name": "布鲁"}, {"language": "es-419", "name": "Snubbull"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold"], "text": "Although it looks frightening, it is actually kind and affectionate. It is very popular among women."}, {"versions": ["silver"], "text": "It has an active, playful nature. Many women like to frolic with it because of its af­ fectionate ways."}, {"versions": ["crystal"], "text": "In truth, it is a cowardly POKéMON. It growls eagerly in order to hide its fear from its opponent."}, {"versions": ["ruby", "sapphire"], "text": "By baring its fangs and making a scary face, SNUBBULL sends smaller POKéMON scurrying away in terror. However, this POKéMON seems a little sad at making its foes flee."}, {"versions": ["emerald"], "text": "By baring its fangs and making a scary face, it sends smaller POKéMON scurrying in terror. The SNUBBULL does seem a little sad at making its foes flee."}, {"versions": ["firered", "soulsilver", "x"], "text": "It has an active, playful nature. Many women like to frolic with it because of its affectionate ways."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "Small Pokémon flee from its scary face. It is, however, considered by women to be cute."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "By baring its fangs and making a scary face, Snubbull sends smaller Pokémon scurrying away in terror. However, this Pokémon seems a little sad at making its foes flee."}, {"versions": ["sun"], "text": "Despite its intimidating face, it’s quite cowardly. Its desperate attempts to appear threatening make it popular with people."}, {"versions": ["moon"], "text": "Its growls make its opponents uneasy. This laid-back Pokémon tends to sleep half the day."}, {"versions": ["ultra-sun"], "text": "It grows close to others easily and is also easily spoiled. The disparity between its face and its actions makes many young people wild about it."}, {"versions": ["ultra-moon"], "text": "In contrast to its appearance, it’s quite timid. When playing with other puppy Pokémon, it sometimes gets bullied."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/209.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/209.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/209.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/209.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/209.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/209.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/209.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/209.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/ve