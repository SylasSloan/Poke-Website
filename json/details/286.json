{"height": 12, "weight": 392, "base_experience": 161, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Mushroom Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "fast-then-very-slow", "egg_groups": ["fairy", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キノガッサ"}, {"language": "ja-roma", "name": "Kinogassa"}, {"language": "ko", "name": "버섯모"}, {"language": "zh-hant", "name": "斗笠菇"}, {"language": "fr", "name": "Chapignon"}, {"language": "de", "name": "Kapilz"}, {"language": "es", "name": "Breloom"}, {"language": "it", "name": "Breloom"}, {"language": "ja", "name": "キノガッサ"}, {"language": "zh-hans", "name": "斗笠菇"}, {"language": "es-419", "name": "Breloom"}], "pokedex_entries": [{"versions": ["ruby"], "text": "BRELOOM closes in on its foe with light and sprightly footwork, then throws punches with its stretchy arms. This POKéMON’s fighting technique puts boxers to shame."}, {"versions": ["sapphire"], "text": "The seeds ringing BRELOOM’s tail are made of hardened toxic spores. It is horrible to eat the seeds. Just taking a bite of this POKéMON’s seed will cause your stomach to rumble."}, {"versions": ["emerald"], "text": "It scatters spores from holes in the cap on its head. It loves warm and humid climates. It feeds on trees and plants in fields and forests."}, {"versions": ["firered", "leafgreen"], "text": "The seeds on its tail are made of toxic spores. It knocks out foes with quick, virtually invisible punches."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Its short arms stretch when it throws punches. Its technique is equal to that of pro boxers."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It scatters poisonous spores and throws powerful punches while its foe is hampered by inhaled spores."}, {"versions": ["omega-ruby"], "text": "Breloom closes in on its foe with light and sprightly footwork, then throws punches with its stretchy arms. This Pokémon’s fighting technique puts boxers to shame."}, {"versions": ["alpha-sapphire"], "text": "The seeds ringing Breloom’s tail are made of hardened toxic spores. It is horrible to eat the seeds. Just taking a bite of this Pokémon’s seed will cause your stomach to rumble."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/286.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/286.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/286.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/286.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/286.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/286.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/286.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/286.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/286.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/286.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/286.png", "shiny": null}}, "generation-v": {"black-white": {"normal"