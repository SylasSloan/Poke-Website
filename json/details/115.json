{"height": 22, "weight": 800, "base_experience": 172, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Parent Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["monster"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ガルーラ"}, {"language": "ja-roma", "name": "Garura"}, {"language": "ko", "name": "캥카"}, {"language": "zh-hant", "name": "袋獸"}, {"language": "fr", "name": "Kangourex"}, {"language": "de", "name": "Kangama"}, {"language": "es", "name": "Kangaskhan"}, {"language": "it", "name": "Kangaskhan"}, {"language": "ja", "name": "ガルーラ"}, {"language": "zh-hans", "name": "袋兽"}, {"language": "es-419", "name": "Kangaskhan"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The infant rarely ventures out of its mother's protective pouch until it is 3 years old."}, {"versions": ["yellow"], "text": "Raises its young in its belly pouch. Won't run from any fight to keep its young protected."}, {"versions": ["gold", "heartgold", "y"], "text": "If it is safe, the young gets out of the belly pouch to play. The adult keeps a close eye on the youngster."}, {"versions": ["silver", "soulsilver"], "text": "To protect its young, it will never give up during battle, no matter how badly wounded it is."}, {"versions": ["crystal"], "text": "To avoid crushing the baby it carries in its pouch, it always sleeps standing up."}, {"versions": ["ruby", "sapphire"], "text": "If you come across a young KANGASKHAN playing by itself, you must never disturb it or attempt to catch it. The baby POKéMON’s parent is sure to be in the area, and it will become violently enraged at you."}, {"versions": ["emerald"], "text": "If you come across a young KANGASKHAN playing by itself, never try to catch it. The baby’s parent is sure to be in the area, and it will become violently enraged."}, {"versions": ["firered"], "text": "The female raises its offspring in a pouch on its belly. It is skilled at attacking using COMET PUNCH."}, {"versions": ["leafgreen"], "text": "The infant rarely ventures out of its mother’s protective pouch until it is three years old."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It raises its offspring in its belly pouch. It lets the baby out to play only when it feels safe."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "If you come across a young Kangaskhan playing by itself, you must never disturb it or attempt to catch it. The baby Pokémon’s parent is sure to be in the area, and it will become violently enraged at you."}, {"versions": ["sun"], "text": "Kangaskhan’s maternal love is so deep that it will brave death to protect its offspring."}, {"versions": ["moon"], "text": "The child in its pouch leaves home after roughly three years. That is the only time the mother is heard to cry wildly."}, {"versions": ["ultra-sun"], "text": "Kangaskhan protects its child by keeping it in its pouch. It has zero forgiveness for those who harm its child and will beat them down."}, {"versions": ["ultra-moon"], "text": "You shouldn’t get close to the child when it’s playing outside its mother’s pouch. Its mother is always nearby watching over it."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Raises its young in its belly pouch. Won’t run from any fight to keep its young protected."}, {"versions": ["sword"], "text": "Although it’s carrying its baby in a pouch on its belly, Kangaskhan is swift on its feet. It intimidates its opponents with quick jabs."}, {"versions": ["shield"], "text": "There are records of a lost human child being raised by a childless Kangaskhan."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/115.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/115.png", "s