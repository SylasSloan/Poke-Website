{"height": 6, "weight": 120, "base_experience": 60, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Mouse Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "サンド"}, {"language": "ja-roma", "name": "Sand"}, {"language": "ko", "name": "모래두지"}, {"language": "zh-hant", "name": "穿山鼠"}, {"language": "fr", "name": "Sabelette"}, {"language": "de", "name": "Sandan"}, {"language": "es", "name": "Sandshrew"}, {"language": "it", "name": "Sandshrew"}, {"language": "ja", "name": "サンド"}, {"language": "zh-hans", "name": "穿山鼠"}, {"language": "es-419", "name": "Sandshrew"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Burrows deep underground in arid locations far from water. It only emerges to hunt for food."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Its body is dry. When it gets cold at night, its hide is said to become coated with a fine dew."}, {"versions": ["gold"], "text": "If it fell from a great height, this POKéMON could save itself by rolling into a ball and bouncing."}, {"versions": ["silver", "soulsilver", "y"], "text": "Disliking water, it lives in deep burrows in arid areas. It can roll itself instantly into a ball."}, {"versions": ["crystal"], "text": "It prefers dry, sandy places because it uses the sand to protect itself when threatened."}, {"versions": ["ruby"], "text": "SANDSHREW’s body is configured to absorb water without waste, enabling it to survive in an arid desert. This POKéMON curls up to protect itself from its enemies."}, {"versions": ["sapphire"], "text": "SANDSHREW has a very dry hide that is extremely tough. The POKéMON can roll into a ball that repels any attack. At night, it burrows into the desert sand to sleep."}, {"versions": ["emerald"], "text": "When it curls up in a ball, it can make any attack bounce off harmlessly. Its hide has turned tough and solid as a result of living in the desert."}, {"versions": ["firered", "x"], "text": "It burrows and lives underground. If threatened, it curls itself up into a ball for protection."}, {"versions": ["leafgreen"], "text": "Burrows deep underground in arid locations far from water. It only emerges to hunt for prey."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "To protect itself from attackers, it curls up into a ball. It lives in arid regions with minimal rainfall."}, {"versions": ["heartgold"], "text": "If it fell from a great height, this Pokémon could save itself by rolling into a ball and bouncing."}, {"versions": ["black-2", "white-2"], "text": "It digs deep burrows to live in. When in danger, it rolls up its body to withstand attacks."}, {"versions": ["omega-ruby"], "text": "Sandshrew’s body is configured to absorb water without waste, enabling it to survive in an arid desert. This Pokémon curls up to protect itself from its enemies."}, {"versions": ["alpha-sapphire"], "text": "Sandshrew has a very dry hide that is extremely tough. The Pokémon can roll into a ball that repels any attack. At night, it burrows into the desert sand to sleep."}, {"versions": ["sun"], "text": "It can roll its body into a ball. It moves through the desert by rolling at high speeds."}, {"versions": ["moon"], "text": "It usually makes its home in deserts and arid zones, where rain does not fall. It digs holes to catch Bug-type Pokémon."}, {"versions": ["ultra-sun"], "text": "It lives in areas of limited rainfall. When danger approaches, it curls up into a ball to protect its soft stomach."}, {"versions": ["ultra-moon"], "text": "When its skin gets wrinkled from moisture, it heads for a volcano. It lies flat on a spot with a lot of geothermal heat and dries itself out."}, {"versions": ["sword"], "text": "It loves to bathe in the grit of dry, sandy areas. By sand bathing, the Pokémon rids itself of dirt and moisture clinging to its body."}, {"versions": ["shield"], "text": "It burrows into the ground to create its nest. If hard stones impede its tunneling, it uses its sharp claws to shatter them and then carries on digging."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/27.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/27.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/27.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/27.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/27.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/27.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/27.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/27.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/27.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/27.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/27.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/27.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions