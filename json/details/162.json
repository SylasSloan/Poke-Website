{"height": 18, "weight": 325, "base_experience": 145, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Long Body Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オオタチ"}, {"language": "ja-roma", "name": "Ootachi"}, {"language": "ko", "name": "다꼬리"}, {"language": "zh-hant", "name": "大尾立"}, {"language": "fr", "name": "Fouinar"}, {"language": "de", "name": "Wiesenior"}, {"language": "es", "name": "Furret"}, {"language": "it", "name": "Furret"}, {"language": "ja", "name": "オオタチ"}, {"language": "zh-hans", "name": "大尾立"}, {"language": "es-419", "name": "Furret"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It makes a nest to suit its long and skinny body. The nest is impossible for other POKéMON to enter."}, {"versions": ["silver"], "text": "There is no tell­ ing where the tail begins. Despite its short legs, it is quick at hunt­ ing RATTATA."}, {"versions": ["crystal"], "text": "It lives in narrow burrows that fit its slim body. The deeper the nests go, the more maze­ like they become."}, {"versions": ["ruby", "sapphire"], "text": "FURRET has a very slim build. When under attack, it can slickly squirm through narrow spaces and get away. In spite of its short limbs, this POKéMON is very nimble and fleet."}, {"versions": ["emerald"], "text": "A FURRET has a very slim build. When under attack, it can squirm through narrow spaces and get away. In spite of its short limbs, it is very nimble and fleet."}, {"versions": ["firered"], "text": "There is no telling where its tail begins. Despite its short legs, it is quick at hunting RATTATA."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "The mother puts its offspring to sleep by curling up around them. It corners foes with speed."}, {"versions": ["heartgold", "y"], "text": "It makes a nest to suit its long and skinny body. The nest is impossible for other Pokémon to enter."}, {"versions": ["soulsilver"], "text": "There is no telling where the tail begins. Despite its short legs, it is quick and likes to chase RATTATA."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Furret has a very slim build. When under attack, it can slickly squirm through narrow spaces and get away. In spite of its short limbs, this Pokémon is very nimble and fleet."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/162.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/162.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/162.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/162.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/162.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/162.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/162.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/162.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/162.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/162.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diam