{"height": 6, "weight": 74, "base_experience": 40, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Fish Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヒンバス"}, {"language": "ja-roma", "name": "Hinbass"}, {"language": "ko", "name": "빈티나"}, {"language": "zh-hant", "name": "醜醜魚"}, {"language": "fr", "name": "Barpau"}, {"language": "de", "name": "Barschwa"}, {"language": "es", "name": "Feebas"}, {"language": "it", "name": "Feebas"}, {"language": "ja", "name": "ヒンバス"}, {"language": "zh-hans", "name": "丑丑鱼"}, {"language": "es-419", "name": "Feebas"}], "pokedex_entries": [{"versions": ["ruby"], "text": "FEEBAS’s fins are ragged and tattered from the start of its life. Because of its shoddy appearance, this POKéMON is largely ignored. It is capable of living in both the sea and in rivers."}, {"versions": ["sapphire"], "text": "While FEEBAS’s body is in tatters, it has a hardy and tenacious life force that enables it to live anywhere. However, this POKéMON is also slow and dimwitted, making it an easy catch."}, {"versions": ["emerald"], "text": "FEEBAS live in ponds that are heavily infested with weeds. Because of its hopelessly shabby appearance, it seems as if few TRAINERS raise it."}, {"versions": ["firered", "leafgreen"], "text": "Ridiculed for its shabby appearance, it is ignored by researchers. It lives in ponds choked with weeds."}, {"versions": ["diamond"], "text": "It is famous for its shabby appearance. While populous, they tend to cluster in set locations."}, {"versions": ["pearl", "x"], "text": "It eats anything, so it can even live in polluted streams and lakes. No one pays any attention to it."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "shield"], "text": "It is a shabby and ugly Pokémon. However, it is very hardy and can survive on little water."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It is the shabbiest Pokémon of all. It forms in schools and lives at the bottom of rivers."}, {"versions": ["omega-ruby"], "text": "Feebas’s fins are ragged and tattered from the start of its life. Because of its shoddy appearance, this Pokémon is largely ignored. It is capable of living in both the sea and in rivers."}, {"versions": ["alpha-sapphire"], "text": "While Feebas’s body is in tatters, it has a hardy and tenacious life force that enables it to live anywhere. However, this Pokémon is also slow and dimwitted, making it an easy catch."}, {"versions": ["sun"], "text": "A tough Pokémon that is perfectly fine even in dirty water. However, due to its ragged, shabby appearance, it isn’t popular."}, {"versions": ["moon", "sword"], "text": "Although unattractive and unpopular, this Pokémon’s marvelous vitality has made it a subject of research."}, {"versions": ["ultra-sun"], "text": "They look ragged, so no one catches them. They look like they’d taste bad, so predators won’t eat them. And their numbers continue to grow."}, {"versions": ["ultra-moon"], "text": "Because of its wretched appearance, most people pay it no attention, but there are some who collect Feebas—and Feebas alone!"}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/349.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/349.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/349.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/349.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/349.