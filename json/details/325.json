{"height": 7, "weight": 306, "base_experience": 66, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Bounce Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "バネブー"}, {"language": "ja-roma", "name": "Baneboo"}, {"language": "ko", "name": "피그점프"}, {"language": "zh-hant", "name": "跳跳豬"}, {"language": "fr", "name": "Spoink"}, {"language": "de", "name": "Spoink"}, {"language": "es", "name": "Spoink"}, {"language": "it", "name": "Spoink"}, {"language": "ja", "name": "バネブー"}, {"language": "zh-hans", "name": "跳跳猪"}, {"language": "es-419", "name": "Spoink"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SPOINK bounces around on its tail. The shock of its bouncing makes its heart pump. As a result, this POKéMON cannot afford to stop bouncing - if it stops, its heart will stop."}, {"versions": ["sapphire"], "text": "SPOINK keeps a pearl on top of its head. The pearl functions to amplify this POKéMON’s psychokinetic powers. It is therefore on a constant search for a bigger pearl."}, {"versions": ["emerald"], "text": "A POKéMON that manipulates psychic power at will. It doesn’t stop bouncing even when it is asleep. It loves eating mushrooms that grow underground."}, {"versions": ["firered", "leafgreen"], "text": "It apparently dies if it stops bouncing about. It carries a pearl from CLAMPERL on its head."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "It bounces constantly, using its tail like a spring. The shock of bouncing keeps its heart beating."}, {"versions": ["heartgold", "soulsilver"], "text": "It bounces around on its tail to keep its heart pumping. It carries a pearl from CLAMPERL on its head."}, {"versions": ["black-2", "white-2"], "text": "Using its tail like a spring, it keeps its heart beating by bouncing constantly. If it stops, it dies."}, {"versions": ["y"], "text": "It bounces around on its tail to keep its heart pumping. It carries a pearl from Clamperl on its head."}, {"versions": ["omega-ruby"], "text": "Spoink bounces around on its tail. The shock of its bouncing makes its heart pump. As a result, this Pokémon cannot afford to stop bouncing—if it stops, its heart will stop."}, {"versions": ["alpha-sapphire"], "text": "Spoink keeps a pearl on top of its head. The pearl functions to amplify this Pokémon’s psychokinetic powers. It is therefore on a constant search for a bigger pearl."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/325.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/325.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/325.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/325.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/325.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/325.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/325.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/325.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/325.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/325.pn