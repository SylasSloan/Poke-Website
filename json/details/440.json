{"height": 6, "weight": 244, "base_experience": 110, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Playhouse Pokémon", "capture_rate": 130, "base_happiness": 140, "hatch_counter": 40, "growth_rate": "fast", "egg_groups": ["no-eggs"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ピンプク"}, {"language": "ja-roma", "name": "Pinpuku"}, {"language": "ko", "name": "핑복"}, {"language": "zh-hant", "name": "小福蛋"}, {"language": "fr", "name": "Ptiravi"}, {"language": "de", "name": "Wonneira"}, {"language": "es", "name": "Happiny"}, {"language": "it", "name": "Happiny"}, {"language": "ja", "name": "ピンプク"}, {"language": "zh-hans", "name": "小福蛋"}, {"language": "es-419", "name": "Happiny"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It loves round white things. It carries an egg-shaped rock in imitation of CHANSEY."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It carries a round, egg-shaped rock in its belly pouch and gives the rock to its friends."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It likes to carry around a small rock. It may wander around others’ feet and cause them to stumble."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "It carefully carries a round, white rock that it thinks is an egg. It’s bothered by how curly its hair looks."}, {"versions": ["sun"], "text": "It carries a round white rock in its belly pouch. If it gets along well with someone, it will sometimes give that person the rock."}, {"versions": ["moon"], "text": "It’s too small to lay eggs yet. As a surrogate, it searches out round white stones."}, {"versions": ["ultra-sun"], "text": "Usually it’s a well-behaved Pokémon, but if you take its round rock away, it will cry and fuss and throw a big old tantrum."}, {"versions": ["ultra-moon"], "text": "When it sees something round and white, Happiny puts it into the pouch on its stomach. It sometimes becomes overloaded and can’t move."}, {"versions": ["sword"], "text": "Mimicking Chansey, Happiny will place an egg- shaped stone in its belly pouch. Happiny will treasure this stone."}, {"versions": ["shield"], "text": "Happiny’s willing to lend its precious round stone to those it’s friendly with, but if the stone isn’t returned, Happiny will cry and throw a tantrum."}, {"versions": ["legends-arceus"], "text": "In imitation of Chansey, it keeps a round stone tucked into its belly pouch and cherishes it dearly. It gets along well with children and will sometimes play house with them for fun."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/440.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/440.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/440.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/440.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/440.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/440.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/440.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/440.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/440.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.