{"height": 9, "weight": 265, "base_experience": 184, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Sun Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "エーフィ"}, {"language": "ja-roma", "name": "Eifie"}, {"language": "ko", "name": "에브이"}, {"language": "zh-hant", "name": "太陽伊布"}, {"language": "fr", "name": "Mentali"}, {"language": "de", "name": "Psiana"}, {"language": "es", "name": "Espeon"}, {"language": "it", "name": "Espeon"}, {"language": "ja", "name": "エーフィ"}, {"language": "zh-hans", "name": "太阳伊布"}, {"language": "es-419", "name": "Espeon"}], "pokedex_entries": [{"versions": ["black", "platinum", "white"], "text": "Its fur is so sensitive, it can sense minute shifts in the air and predict the weather."}, {"versions": ["gold"], "text": "It uses the fine hair that covers its body to sense air currents and predict its ene­ my's actions."}, {"versions": ["silver"], "text": "By reading air currents, it can predict things such as the weath­ er or its foe's next move."}, {"versions": ["crystal"], "text": "The tip of its forked tail quivers when it is predicting its opponent's next move."}, {"versions": ["ruby", "sapphire"], "text": "ESPEON is extremely loyal to any TRAINER it considers to be worthy. It is said that this POKéMON developed its precognitive powers to protect its TRAINER from harm."}, {"versions": ["emerald"], "text": "An ESPEON is extremely loyal to any TRAINER it considers to be worthy. It is said to have developed precognitive powers to protect its TRAINER from harm."}, {"versions": ["firered", "soulsilver", "sword"], "text": "By reading air currents, it can predict things such as the weather or its foe’s next move."}, {"versions": ["leafgreen", "heartgold"], "text": "It uses the fine hair that covers its body to sense air currents and predict its enemy’s actions."}, {"versions": ["diamond", "pearl"], "text": "Its fur has the look and feel of velvet. The orb on its forehead glows when it uses psycho-power."}, {"versions": ["black-2", "white-2", "y"], "text": "Its fur is so sensitive, it can feel minute shifts in the air and predict the weather...and its foes’ thoughts."}, {"versions": ["x"], "text": "The tip of its forked tail quivers when it is predicting its opponent’s next move."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Espeon is extremely loyal to any Trainer it considers to be worthy. It is said that this Pokémon developed its precognitive powers to protect its Trainer from harm."}, {"versions": ["sun"], "text": "It can instantaneously sense its opponent’s movements by feeling air currents with its fine fur."}, {"versions": ["moon", "shield"], "text": "It unleashes psychic power from the orb on its forehead. When its power is exhausted, the orb grows dull and dark."}, {"versions": ["ultra-sun"], "text": "Although it originally had no powers at all, people say its precognitive faculties were awakened by its need to protect itself."}, {"versions": ["ultra-moon"], "text": "Psychic power builds up in the orb on its forehead as it bathes in the sunshine. Espeon is not good at battling at night."}, {"versions": ["legends-arceus"], "text": "Wields an arcane power with which it can predict the weather and even people's thoughts. When bathed in sunshine, the scarlet orb on its brow glows and builds energy."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/196.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/196.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/196.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny