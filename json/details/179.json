{"height": 6, "weight": 78, "base_experience": 56, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Wool Pokémon", "capture_rate": 235, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "メリープ"}, {"language": "ja-roma", "name": "Merriep"}, {"language": "ko", "name": "메리프"}, {"language": "zh-hant", "name": "咩利羊"}, {"language": "fr", "name": "Wattouat"}, {"language": "de", "name": "Voltilamm"}, {"language": "es", "name": "Mareep"}, {"language": "it", "name": "Mareep"}, {"language": "ja", "name": "メリープ"}, {"language": "zh-hans", "name": "咩利羊"}, {"language": "es-419", "name": "Mareep"}], "pokedex_entries": [{"versions": ["gold"], "text": "If static elec­ tricity builds in its body, its fleece doubles in volume. Touching it will shock you."}, {"versions": ["silver", "firered", "soulsilver"], "text": "Its fleece grows continually. In the summer, the fleece is fully shed, but it grows back in a week."}, {"versions": ["crystal", "y"], "text": "It stores lots of air in its soft fur, allowing it to stay cool in summer and warm in winter."}, {"versions": ["ruby", "sapphire"], "text": "MAREEP’s fluffy coat of wool rubs together and builds a static charge. The more static electricity is charged, the more brightly the lightbulb at the tip of its tail grows."}, {"versions": ["emerald"], "text": "Its fluffy wool rubs together and builds a static charge. The more energy is charged, the more brightly the lightbulb at the tip of its tail glows."}, {"versions": ["leafgreen", "heartgold"], "text": "If static electricity builds in its body, its fleece doubles in volume. Touching it will shock you."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "Its fluffy coat swells to double when static electricity builds up. Touching it can be shocking."}, {"versions": ["black-2", "white-2"], "text": "When cold weather increases static 