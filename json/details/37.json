{"height": 6, "weight": 99, "base_experience": 60, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Fox Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ロコン"}, {"language": "ja-roma", "name": "Rokon"}, {"language": "ko", "name": "식스테일"}, {"language": "zh-hant", "name": "六尾"}, {"language": "fr", "name": "Goupix"}, {"language": "de", "name": "Vulpix"}, {"language": "es", "name": "Vulpix"}, {"language": "it", "name": "Vulpix"}, {"language": "ja", "name": "ロコン"}, {"language": "zh-hans", "name": "六尾"}, {"language": "es-419", "name": "Vulpix"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "At the time of birth, it has just one tail. The tail splits from its tip as it grows older."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Both its fur and its tails are beautiful. As it grows, the tails split and form more tails."}, {"versions": ["gold", "heartgold"], "text": "As it develops, its single white tail gains color and splits into six. It is quite warm and cuddly."}, {"versions": ["silver", "soulsilver"], "text": "If it is attacked by an enemy that is stronger than itself, it feigns injury to fool the enemy and escapes."}, {"versions": ["crystal"], "text": "As its body grows larger, its six warm tails become more beautiful, with a more luxur­ ious coat of fur."}, {"versions": ["ruby"], "text": "At the time of its birth, VULPIX has one white tail. The tail separates into six if this POKéMON receives plenty of love from its TRAINER. The six tails become magnificently curled."}, {"versions": ["sapphire"], "text": "Inside VULPIX’s body burns a flame that never goes out. During the daytime, when the temperatures rise, this POKéMON releases flames from its mouth to prevent its body from growing too hot."}, {"versions": ["emerald"], "text": "It can freely control fire, making fiery orbs fly like will-o’-the-wisps. Just before evolution, its six tails grow hot as if on fire."}, {"versions": ["firered", "y", "sword"], "text": "While young, it has six gorgeous tails. When it grows, several new tails are sprouted."}, {"versions": ["leafgreen"], "text": "When it is born, it has just one snow- white tail. The tail splits from its tip as it grows older."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It controls balls of fire. As it grows, its six tails split from their tips to make more tails."}, {"versions": ["black-2", "white-2", "shield"], "text": "As each tail grows, its fur becomes more lustrous. When held, it feels slightly warm."}, {"versions": ["x"], "text": "When it is born, it has just one snow-white tail. The tail splits from its tip as it grows older."}, {"versions": ["omega-ruby"], "text": "At the time of its birth, Vulpix has one white tail. The tail separates into six if this Pokémon receives plenty of love from its Trainer. The six tails become magnificently curled."}, {"versions": ["alpha-sapphire"], "text": "Inside Vulpix’s body burns a flame that never goes out. During the daytime, when the temperatures rise, this Pokémon releases flames from its mouth to prevent its body from growing too hot."}, {"versions": ["sun"], "text": "Its beautiful fur and tails have made it very popular. As it grows, its tails split to form more tails."}, {"versions": ["moon"], "text": "From its mouth spew flames that seem to resemble the spirits of the deceased. Some people mistakenly think this fire is a ghost."}, {"versions": ["ultra-sun"], "text": "Its beautiful tails have made it very popular. However, if it’s not brushed diligently, it will be a mass of tangles before you know it."}, {"versions": ["ultra-moon"], "text": "It manipulates balls of fire to catch its prey. If you raise one from when it’s young, it will grow close to you like a puppy Pokémon."}, {"versions": ["legends-arceus"], "text": "In its belly burns a fire, which Vulpix spits out in the form of fireballs. When young, this Pokémon has but one white tail. As the Pokémon matures, this single tail splits into six."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/37.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/37.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/37.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/37.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/37.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/37.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/37.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/37.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/37.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/37.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/37.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/37.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/