{"height": 14, "weight": 884, "base_experience": 172, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "speed", "value": 1}], "genus": "Wild Bull Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "ケンタロス"}, {"language": "ja-roma", "name": "Kentauros"}, {"language": "ko", "name": "켄타로스"}, {"language": "zh-hant", "name": "肯泰羅"}, {"language": "fr", "name": "Tauros"}, {"language": "de", "name": "Tauros"}, {"language": "es", "name": "Tauros"}, {"language": "it", "name": "Tauros"}, {"language": "ja", "name": "ケンタロス"}, {"language": "zh-hans", "name": "肯泰罗"}, {"language": "es-419", "name": "Tauros"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "When it targets an enemy, it charges furiously while whipping its body with its long tails."}, {"versions": ["yellow"], "text": "A rowdy POKéMON with a lot of stamina. Once running, it won't stop until it hits something."}, {"versions": ["gold"], "text": "They fight each other by locking horns. The herd's protector takes pride in its bat­ tle-scarred horns."}, {"versions": ["silver", "soulsilver", "x"], "text": "After heightening its will to fight by whipping itself with its three tails, it charges at full speed."}, {"versions": ["crystal"], "text": "These violent POKéMON fight with other mem­ bers of their herd in order to prove their strength."}, {"versions": ["ruby", "sapphire"], "text": "This POKéMON is not satisfied unless it is rampaging at all times. If there is no opponent for TAUROS to battle, it will charge at thick trees and knock them down to calm itself."}, {"versions": ["emerald"], "text": "It is not satisfied unless it is rampaging at all times. If there is no opponent for TAUROS to battle, it will charge at thick trees and knock them down to calm itself."}, {"versions": ["firered"], "text": "When it is about to TACKLE, it whips its body repeatedly with its three long tails."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Once it takes aim at its foe, it makes a headlong charge. It is famous for its violent nature."}, {"versions": ["heartgold"], "text": "They fight each other by locking horns. The herd’s protector takes pride in its battle-scarred horns."}, {"versions": ["y"], "text": "When it is about to tackle, it whips its body repeatedly with its three long tails."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "This Pokémon is not satisfied unless it is rampaging at all times. If there is no opponent for Tauros to battle, it will charge at thick trees and knock them down to calm itself."}, {"versions": ["sun"], "text": "Historically, people in areas all over the world have ridden Tauros, but the practice is said to have started in Alola."}, {"versions": ["moon"], "text": "Although it’s known to be a fierce Pokémon, Tauros in the Alola region are said to possess a measure of calmness."}, {"versions": ["ultra-sun"], "text": "They live in groups. The one with the longest, thickest, and most-scarred horns is the boss of the herd."}, {"versions": ["ultra-moon"], "text": "The climate seems to be related to the reason Tauros in Alola are a little calmer than those in other regions."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A rowdy Pokémon with a lot of stamina. Once running, it won’t stop until it hits something."}, {"versions": ["sword"], "text": "When Tauros begins whipping itself with its tails, it’s a warning that the Pokémon is about to charge with astounding speed."}, {"versions": ["shield"], "text": "The Tauros of the Galar region are volatile in nature, and they won’t allow people to ride on their backs."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/128.png", "shiny": null}, "yellow": {"normal": "https://raw.gith