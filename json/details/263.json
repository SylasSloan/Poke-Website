{"height": 4, "weight": 175, "base_experience": 56, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Tiny Raccoon Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ジグザグマ"}, {"language": "ja-roma", "name": "Jiguzaguma"}, {"language": "ko", "name": "지그제구리"}, {"language": "zh-hant", "name": "蛇紋熊"}, {"language": "fr", "name": "Zigzaton"}, {"language": "de", "name": "Zigzachs"}, {"language": "es", "name": "Zigzagoon"}, {"language": "it", "name": "Zigzagoon"}, {"language": "ja", "name": "ジグザグマ"}, {"language": "zh-hans", "name": "蛇纹熊"}, {"language": "es-419", "name": "Zigzagoon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "ZIGZAGOON restlessly wanders everywhere at all times. This POKéMON does so because it is very curious. It becomes interested in anything that it happens to see."}, {"versions": ["sapphire"], "text": "The hair on ZIGZAGOON’s back is bristly. It rubs the hard back hair against trees to leave its territorial markings. This POKéMON may play dead to fool foes in battle."}, {"versions": ["emerald"], "text": "Rubbing its nose against the ground, it always wanders about back and forth in search of something. It is distinguished by the zigzag footprints it leaves."}, {"versions": ["firered", "leafgreen"], "text": "A POKéMON with abundant curiosity. It shows an interest in everything, so it always zigs and zags."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It walks in zigzag fashion. It is good at finding items in the grass and even in the ground."}, {"versions": ["heartgold", "soulsilver"], "text": "It gets interested in everything, which is why it zigs and zags. It is good at finding items."}, {"versions": ["x"], "text": "It walks in zigzag fashion. It’s good at finding items in the grass and even in the ground."}, {"versions": ["y"], "text": "A Pokémon with abundant curiosity. It shows an interest in everything, so it always zigzags."}, {"versions": ["omega-ruby"], "text": "Zigzagoon restlessly wanders everywhere at all times. This Pokémon does so because it is very curious. It becomes interested in anything that it happens to see."}, {"versions": ["alpha-sapphire"], "text": "The hair on Zigzagoon’s back is bristly. It rubs the hard back hair against trees to leave its territorial markings. This Pokémon may play dead to fool foes in battle."}, {"versions": ["sword"], "text": "It marks its territory by rubbing its bristly fur on trees. This variety of Zigzagoon is friendlier and calmer than the kind native to Galar."}, {"versions": ["shield"], "text": "Zigzagoon that adapted to regions outside Galar acquired this appearance. If you’ve lost something, this Pokémon can likely find it."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/263.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/263.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/263.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/263.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/263.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/263.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/263.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/