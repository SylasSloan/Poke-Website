{"height": 34, "weight": 2300, "base_experience": 306, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Sunne Pokémon", "capture_rate": 45, "base_happiness": 0, "hatch_counter": 120, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ソルガレオ"}, {"language": "ja-roma", "name": "Solgaleo"}, {"language": "ko", "name": "솔가레오"}, {"language": "zh-hant", "name": "索爾迦雷歐"}, {"language": "fr", "name": "Solgaleo"}, {"language": "de", "name": "Solgaleo"}, {"language": "es", "name": "Solgaleo"}, {"language": "it", "name": "Solgaleo"}, {"language": "ja", "name": "ソルガレオ"}, {"language": "zh-hans", "name": "索尔迦雷欧"}, {"language": "es-419", "name": "Solgaleo"}], "pokedex_entries": [{"versions": ["sun"], "text": "It is said to live in another world. The intense light it radiates from the surface of its body can make the darkest of nights light up like midday."}, {"versions": ["moon"], "text": "This Pokémon is said to be a male evolution of Cosmog. At the activation of its third eye, it departs for another world."}, {"versions": ["ultra-sun"], "text": "Sometimes the result of its opening an Ultra Wormhole is that energy and life-forms from other worlds are called here to this world."}, {"versions": ["ultra-moon"], "text": "In writings from the distant past, it’s called by the name “the beast that devours the sun.”"}, {"versions": ["sword"], "text": "When light radiates from its body, this Pokémon could almost appear to be the sun. It will dispel any darkness and light up the world."}, {"versions": ["shield"], "text": "Solgaleo was once known as the Beast That Devours the Sun. Energy in the form of light radiates boundlessly from it."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/791.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI