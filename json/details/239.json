{"height": 6, "weight": 235, "base_experience": 72, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Electric Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["no-eggs"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "エレキッド"}, {"language": "ja-roma", "name": "Elekid"}, {"language": "ko", "name": "에레키드"}, {"language": "zh-hant", "name": "電擊怪"}, {"language": "fr", "name": "Élekid"}, {"language": "de", "name": "Elekid"}, {"language": "es", "name": "Elekid"}, {"language": "it", "name": "Elekid"}, {"language": "ja", "name": "エレキッド"}, {"language": "zh-hans", "name": "电击怪"}, {"language": "es-419", "name": "Elekid"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It rotates its arms to generate electricity, but it tires easily, so it charges up only a little bit."}, {"versions": ["silver", "firered"], "text": "Even in the most vicious storm, this POKéMON plays happily if thunder rumbles in the sky."}, {"versions": ["crystal"], "text": "It loves violent thunder. The space between its horns flickers bluish- white when it is charging energy."}, {"versions": ["ruby", "sapphire"], "text": "ELEKID stores electricity in its body. If it touches metal and accidentally discharges all its built-up electricity, this POKéMON begins swinging its arms in circles to recharge itself."}, {"versions": ["emerald"], "text": "If it touches metal and discharges the electricity it has stored in its body, an ELEKID begins swinging its arms in circles to recharge itself."}, {"versions": ["diamond", "pearl", "x"], "text": "It generates electricity by whirling its arms. However, it can’t store the energy it makes."}, {"versions": ["platinum", "black", "white"], "text": "A weak electric current flows between its horns. Sticking a hand there shocks the unwary."}, {"versions": ["heartgold"], "text": "It rotates its arms to generate electricity, but it tires easily, so it only charges up a little bit."}, {"versions": ["soulsilver"], "text": "Even in the most vicious storm, this Pokémon plays happily if thunder rumbles in the sky."}, {"versions": ["black-2", "white-2", "y"], "text": "Spinning its arms around to generate electricity makes the area between its horns shine light blue."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Elekid stores electricity in its body. If it touches metal and accidentally discharges all its built-up electricity, this Pokémon begins swinging its arms in circles to recharge itself."}, {"versions": ["sun"], "text": "When it’s in a house, electrical outlets serve as its baby bottles. It sucks down electricity."}, {"versions": ["moon"], "text": "This Pokémon is constantly fighting with Togedemaru that try to steal its electricity. It’s a pretty even match."}, {"versions": ["ultra-sun"], "text": "When it hears the crash of thunder, Elekid’s mood improves. It can be useful to record that sound and play it when Elekid’s feeling down."}, {"versions": ["ultra-moon"], "text": "When its horns shine a bluish white, that’s the sign it’s fully charged. You’ll get a shocking jolt if you touch it!"}, {"versions": ["sword"], "text": "When a storm approaches, this Pokémon gets restless. Once Elekid hears the sound of thunder, it gets full-on rowdy."}, {"versions": ["shield"], "text": "It’s not good at storing electricity yet. This Pokémon sneaks into people’s homes, looking for electrical outlets to eat electricity from."}, {"versions": ["legends-arceus"], "text": "They generate electricity by spinning their arms. During a thunderstorm, if one hears the lively voices of children out in the wilderness, what one is actually hearing are the voices of Elekid."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/239.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/