{"height": 4, "weight": 52, "base_experience": 63, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Penguin Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["water1", "ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ポッチャマ"}, {"language": "ja-roma", "name": "Pochama"}, {"language": "ko", "name": "팽도리"}, {"language": "zh-hant", "name": "波加曼"}, {"language": "fr", "name": "Tiplouf"}, {"language": "de", "name": "Plinfa"}, {"language": "es", "name": "Piplup"}, {"language": "it", "name": "Piplup"}, {"language": "ja", "name": "ポッチャマ"}, {"language": "zh-hans", "name": "波加曼"}, {"language": "es-419", "name": "Piplup"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "Because it is very proud, it hates accepting food from people. Its thick down guards it from cold."}, {"versions": ["pearl"], "text": "It lives along shores in northern countries. A skilled swimmer, it dives for over 10 minutes to hunt."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "A poor walker, it often falls down. However, its strong pride makes it puff up its chest without a care."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "It doesn’t like to be taken care of. It’s difficult to bond with since it won’t listen to its Trainer."}, {"versions": ["legends-arceus"], "text": "Prefers cold climes and appears along coasts. It's an adorable little thing—as cute as any child—but it's also prideful, unwilling to accept handouts from people."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/393.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/393.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.