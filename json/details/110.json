{"height": 12, "weight": 95, "base_experience": 172, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Poison Gas Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マタドガス"}, {"language": "ja-roma", "name": "Matadogas"}, {"language": "ko", "name": "또도가스"}, {"language": "zh-hant", "name": "雙彈瓦斯"}, {"language": "fr", "name": "Smogogo"}, {"language": "de", "name": "Smogmog"}, {"language": "es", "name": "Weezing"}, {"language": "it", "name": "Weezing"}, {"language": "ja", "name": "マタドガス"}, {"language": "zh-hans", "name": "双弹瓦斯"}, {"language": "es-419", "name": "Weezing"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Where two kinds of poison gases meet, 2 KOFFINGs can fuse into a WEEZING over many years."}, {"versions": ["yellow"], "text": "It lives and grows by absorbing dust, germs and poison gases that are contained in toxic waste and garbage."}, {"versions": ["gold"], "text": "If one of the twin KOFFING inflates, the other one deflates. It con­ stantly mixes its poisonous gases."}, {"versions": ["silver"], "text": "Top-grade perfume is made using its internal poison gases by diluting them to the high­ est level."}, {"versions": ["crystal"], "text": "When it inhales poisonous gases from garbage, its body expands, and its insides smell much worse."}, {"versions": ["ruby"], "text": "WEEZING loves the gases given off by rotted kitchen garbage. This POKéMON will find a dirty, unkempt house and make it its home. At night, when the people in the house are asleep, it will go through the trash."}, {"versions": ["sapphire"], "text": "WEEZING alternately shrinks and inflates its twin bodies to mix together toxic gases inside. The more the gases are mixed, the more powerful the toxins become. The POKéMON also becomes more putrid."}, {"versions": ["emerald"], "text": "By diluting its toxic gases with a special process, the highest grade of perfume can be extracted. To WEEZING, gases emanating from garbage are the ultimate feast."}, {"versions": ["firered"], "text": "Very rarely, a sudden mutation can result in two small KOFFING twins becoming conjoined as a WEEZING."}, {"versions": ["leafgreen"], "text": "Where two kinds of poison gases meet, two KOFFING can fuse into a WEEZING over many years."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It grows by feeding on gases released by garbage. Though very rare, triplets have been found."}, {"versions": ["heartgold"], "text": "If one of the twin KOFFING inflates, the other one deflates. It constantly mixes its poisonous gases."}, {"versions": ["soulsilver"], "text": "Top-grade perfume is made using its internal poison gases by diluting them to the highest level."}, {"versions": ["black-2", "white-2"], "text": "Inhaling toxic fumes from trash and mixing them inside its body lets it spread an even fouler stench."}, {"versions": ["x"], "text": "If one of the twin Koffing inflates, the other one deflates. It constantly mixes its poisonous gases."}, {"versions": ["y"], "text": "Very rarely, a sudden mutation can result in two small Koffing twins becoming conjoined as a Weezing."}, {"versions": ["omega-ruby"], "text": "Weezing loves the gases given off by rotted kitchen garbage. This Pokémon will find a dirty, unkempt house and make it its home. At night, when the people in the house are asleep, it will go through the trash."}, {"versions": ["alpha-sapphire"], "text": "Weezing alternately shrinks and inflates its twin bodies to mix together toxic gases inside. The more the gases are mixed, the more powerful the toxins become. The Pokémon also becomes more putrid."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "This Pokémon lives and grows by absorbing poison gas, dust, and germs that exist inside garbage."}, {"versions": ["sword"], "text": "It mixes gases between its two bodies. It’s said that these Pokémon were seen all over the Galar region back in the day."}, {"versions": ["shield"], "text": "It can’t suck in air quite as well as a Galarian Weezing, but the toxins it creates are more potent than those of its counterpart."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/110.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/110.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/110.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/110.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/110.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/110.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/110.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/110.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/110.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/110.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/110.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/110.png"}, "ruby-sapphire": {"norm