{"height": 8, "weight": 196, "base_experience": 64, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Duck Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コダック"}, {"language": "ja-roma", "name": "Koduck"}, {"language": "ko", "name": "고라파덕"}, {"language": "zh-hant", "name": "可達鴨"}, {"language": "fr", "name": "Psykokwak"}, {"language": "de", "name": "Enton"}, {"language": "es", "name": "Psyduck"}, {"language": "it", "name": "Psyduck"}, {"language": "ja", "name": "コダック"}, {"language": "zh-hans", "name": "可达鸭"}, {"language": "es-419", "name": "Psyduck"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "While lulling its enemies with its vacant look, this wily POKéMON will use psychokinetic powers."}, {"versions": ["yellow"], "text": "Always tormented by headaches. It uses psychic powers, but it is not known if it intends to do so."}, {"versions": ["gold"], "text": "It has mystical powers but doesn't recall that it has used them. That is why it always looks puzzled."}, {"versions": ["silver", "soulsilver"], "text": "If its chronic headache peaks, it may exhibit odd powers. It seems unable to recall such an episode."}, {"versions": ["crystal"], "text": "The only time it can use its psy­ chic power is when its sleeping brain cells happen to wake."}, {"versions": ["ruby"], "text": "PSYDUCK uses a mysterious power. When it does so, this POKéMON generates brain waves that are supposedly only seen in sleepers. This discovery spurred controversy among scholars."}, {"versions": ["sapphire"], "text": "If it uses its mysterious power, PSYDUCK can’t remember having done so. It apparently can’t form a memory of such an event because it goes into an altered state that is much like deep sleep."}, {"versions": ["emerald"], "text": "When its headache intensifies, it starts using strange powers. However, it has no recollection of its powers, so it always looks befuddled and bewildered."}, {"versions": ["firered", "x"], "text": "It is constantly wracked by a headache. When the headache turns intense, it begins using mysterious powers."}, {"versions": ["diamond"], "text": "If its usual headache worsens, it starts exhibiting odd powers. It can’t remember doing so, however."}, {"versions": ["pearl"], "text": "It never remembers using its odd powers, so it always tilts its head in puzzlement."}, {"versions": ["platinum", "black", "white"], "text": "Overwhelmed by enigmatic abilities, it suffers a constant headache. It sometimes uses mysterious powers."}, {"versions": ["heartgold", "y"], "text": "It has mystical powers but doesn’t recall that it has used them. That is why it always looks puzzled."}, {"versions": ["black-2", "white-2"], "text": "When headaches stimulate its brain cells, which are usually inactive, it can use a mysterious power."}, {"versions": ["omega-ruby"], "text": "Psyduck uses a mysterious power. When it does so, this Pokémon generates brain waves that are supposedly only seen in sleepers. This discovery spurred controversy among scholars."}, {"versions": ["alpha-sapphire"], "text": "If it uses its mysterious power, Psyduck can’t remember having done so. It apparently can’t form a memory of such an event because it goes into an altered state that is much like deep sleep."}, {"versions": ["sun"], "text": "As a result of headaches so fierce they cause it to cry, it sometimes uses psychokinesis without meaning to."}, {"versions": ["moon"], "text": "This Pokémon is troubled by constant headaches. The more pain it’s in, the more powerful its psychokinesis becomes."}, {"versions": ["ultra-sun"], "text": "Using psychokinesis gives it a headache, so it normally passes the time spacing out and doing as little as possible."}, {"versions": ["ultra-moon"], "text": "It has been found that its brain cells are 10 times more active when Psyduck is experiencing a headache."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Always tormented by headaches. It uses psychic powers, but whether it intends to do so is not known."}, {"versions": ["sword"], "text": "Psyduck is constantly beset by headaches. If the Pokémon lets its strange power erupt, apparently the pain subsides for a while."}, {"versions": ["shield"], "text": "As Psyduck gets stressed out, its headache gets progressively worse. It uses intense psychic energy to overwhelm those around it."}, {"versions": ["legends-arceus"], "text": "Suffers perpetual headaches. If the agony grows too great, Psyduck's latent power erupts, contrary to Psyduck's intent. Ergo, I am exploring ways to ease the pain."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/54.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/54.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/54.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/54.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/54.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/54.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/54.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/54.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/eme