{"height": 11, "weight": 300, "base_experience": 172, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Electric Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "エレブー"}, {"language": "ja-roma", "name": "Eleboo"}, {"language": "ko", "name": "에레브"}, {"language": "zh-hant", "name": "電擊獸"}, {"language": "fr", "name": "Élektek"}, {"language": "de", "name": "Elektek"}, {"language": "es", "name": "Electabuzz"}, {"language": "it", "name": "Electabuzz"}, {"language": "ja", "name": "エレブー"}, {"language": "zh-hans", "name": "电击兽"}, {"language": "es-419", "name": "Electabuzz"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Normally found near power plants, they can wander away and cause major blackouts in cities."}, {"versions": ["yellow"], "text": "If a major power outage occurs, it is certain that this POKéMON has eaten electricity at a power plant."}, {"versions": ["gold"], "text": "Electricity runs across the surface of its body. In darkness, its en­ tire body glows a whitish-blue."}, {"versions": ["silver"], "text": "Its body constant­ ly discharges electricity. Get­ ting close to it will make your hair stand on end."}, {"versions": ["crystal"], "text": "When two ELECTABUZZ touch, they control the electric currents to communicate their feelings."}, {"versions": ["ruby", "sapphire"], "text": "When a storm arrives, gangs of this POKéMON compete with each other to scale heights that are likely to be stricken by lightning bolts. Some towns use ELECTABUZZ in place of lightning rods."}, {"versions": ["emerald"], "text": "When a storm approaches, it competes with others to scale heights that are likely to be stricken by lightning. Some towns use ELECTABUZZ in place of lightning rods."}, {"versions": ["firered", "y"], "text": "It loves to feed on strong electricity. It occasionally appears around large power plants and so on."}, {"versions": ["diamond", "pearl"], "text": "Half of all blackouts occur when this Pokémon appears at power plants and eats electricity."}, {"versions": ["platinum", "black", "white"], "text": "It windmills its arms to slightly boost its punches. Foes have been known to escape in the meantime."}, {"versions": ["heartgold"], "text": "Electricity runs across the surface of its body. In darkness, its entire body glows a whitish-blue."}, {"versions": ["soulsilver"], "text": "Its body constantly discharges electricity. Getting close to it will make your hair stand on end."}, {"versions": ["black-2", "white-2"], "text": "Research is progressing on storing lightning in Electabuzz so this energy can be used at any time."}, {"versions": ["x"], "text": "Electricity runs across the surface of its body. In darkness, its entire body glows a whitish blue."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "When a storm arrives, gangs of this Pokémon compete with each other to scale heights that are likely to be stricken by lightning bolts. Some towns use Electabuzz in place of lightning rods."}, {"versions": ["sun"], "text": "Half of all sudden blackouts are caused by Electabuzz gathering at electric power plants and gobbling up electricity."}, {"versions": ["moon"], "text": "Electricity leaks from it in amounts far greater than the amount of electricity it eats."}, {"versions": ["ultra-sun"], "text": "Electricity permeates its body. It swings its arms round and round to charge up electricity before unleashing a punch."}, {"versions": ["ultra-moon"], "text": "While it’s often blamed for power outages, the truth is the cause of outages is more often an error on the part of the electric company."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "If a major power outage occurs, it is certain that this Pokémon has eaten electricity at a power plant."}, {"versions": ["sword"], "text": "Many power plants keep Ground-type Pokémon around as a defense against Electabuzz that come seeking electricity."}, {"versions": ["shield"], "text": "With the coming of a storm, many of these Pokémon will gather under tall trees and sit there waiting for lightning to strike."}, {"versions": ["legends-arceus"], "text": "Feeds on electrical energy. During sudden showers beneath looming thunderclouds, one can observe Electabuzz scaling tall trees, where the Pokémon will then wait for lightning to strike."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/125.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/125.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/125.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/125.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/125.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/125.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/125.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/125.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/125.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/125.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/version