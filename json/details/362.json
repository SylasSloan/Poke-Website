{"height": 15, "weight": 2565, "base_experience": 168, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Face Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["fairy", "mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "オニゴーリ"}, {"language": "ja-roma", "name": "Onigohri"}, {"language": "ko", "name": "얼음귀신"}, {"language": "zh-hant", "name": "冰鬼護"}, {"language": "fr", "name": "Oniglali"}, {"language": "de", "name": "Firnontor"}, {"language": "es", "name": "Glalie"}, {"language": "it", "name": "Glalie"}, {"language": "ja", "name": "オニゴーリ"}, {"language": "zh-hans", "name": "冰鬼护"}, {"language": "es-419", "name": "Glalie"}], "pokedex_entries": [{"versions": ["ruby"], "text": "GLALIE has a body made of rock, which it hardens with an armor of ice. This POKéMON has the ability to freeze moisture in the atmosphere into any shape it desires."}, {"versions": ["sapphire"], "text": "GLALIE has the ability to freely control ice. For example, it can instantly freeze its foe solid. After immobilizing its foe in ice, this POKéMON enjoys eating it in leisurely fashion."}, {"versions": ["emerald"], "text": "A GLALIE has the power to instantaneously freeze moisture in the atmosphere. A dazzling cloud of diamondlike ice crystals forms around its body."}, {"versions": ["firered", "leafgreen", "sword"], "text": "It has a body of ice that won’t melt, even with fire. It can instantly freeze moisture in the atmosphere."}, {"versions": ["diamond", "pearl"], "text": "To protect itself, it clads its body in an armor of ice, made by freezing moisture in the air."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It prevents prey from escaping by instantaneously freezing moisture in the air."}, {"versions": ["heartgold", "soulsilver", "y", "shield"], "text": "It can instantly freeze moisture in the atmosphere. It uses this power to freeze its foes."}, {"versions": ["x"], "text": "To protect itself, it clad its body in an armor of ice, made by freezing moisture in the air."}, {"versions": ["omega-ruby"], "text": "Glalie has a body made of rock, which it hardens with an armor of ice. This Pokémon has the ability to freeze moisture in the atmosphere into any shape it desires."}, {"versions": ["alpha-sapphire"], "text": "Glalie has the ability to freely control ice. For example, it can instantly freeze its prey solid. After immobilizing its prey in ice, this Pokémon enjoys eating it in leisurely fashion."}, {"versions": ["sun"], "text": "Legend says a boulder on an icy mountain absorbed the distress and regrets of a stranded mountaineer, giving rise to Glalie."}, {"versions": ["moon"], "text": "Its prey is instantaneously frozen stiff by the cold air it exhales from its huge mouth. While they’re in that frozen state, it gobbles them up."}, {"versions": ["ultra-sun"], "text": "It freezes its prey and chews them whole. However, it prefers to eat Pokémon like Vanillite that are already frozen."}, {"versions": ["ultra-moon"], "text": "Its actual body is a rock that isn’t particularly hard. Glalie absorbs moisture from the air and drapes itself in an armor of ice."}, {"versions": ["legends-arceus"], "text": "It covers its body with an armor of ice harder than steel. Uses its breath to freeze prey, which it then devours as if they were frozen desserts."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/362.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/362.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/362.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/362.png"}}, "generation-i