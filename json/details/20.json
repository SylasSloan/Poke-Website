{"height": 7, "weight": 185, "base_experience": 145, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Mouse Pokémon", "capture_rate": 127, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ラッタ"}, {"language": "ja-roma", "name": "Ratta"}, {"language": "ko", "name": "레트라"}, {"language": "zh-hant", "name": "拉達"}, {"language": "fr", "name": "Rattatac"}, {"language": "de", "name": "Rattikarl"}, {"language": "es", "name": "Raticate"}, {"language": "it", "name": "Raticate"}, {"language": "ja", "name": "ラッタ"}, {"language": "zh-hans", "name": "拉达"}, {"language": "es-419", "name": "Raticate"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "It uses its whis­ kers to maintain its balance. It apparently slows down if they are cut off."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Its hind feet are webbed. They act as flippers, so it can swim in rivers and hunt for prey."}, {"versions": ["gold"], "text": "Gnaws on anything with its tough fangs. It can even topple concrete buildings by gnaw­ ing on them."}, {"versions": ["silver"], "text": "Its whiskers help it to maintain balance. Its fangs never stop grow­ ing, so it gnaws to pare them down."}, {"versions": ["crystal"], "text": "The webs on its hind legs enable it to cross rivers. It search­ es wide areas for food."}, {"versions": ["ruby", "sapphire"], "text": "RATICATE’s sturdy fangs grow steadily. To keep them ground down, it gnaws on rocks and logs. It may even chew on the walls of houses."}, {"versions": ["emerald"], "text": "A RATICATE’s sturdy fangs grow steadily. To keep them ground down, it gnaws on rocks and logs. It may even chew on the walls of houses."}, {"versions": ["firered"], "text": "Its rear feet have three toes each. They are webbed, enabling it to swim across rivers."}, {"versions": ["leafgreen"], "text": "It uses its whiskers to maintain its balance. It apparently slows down if they are cut off."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "It whittles its constantly growing fangs by gnawing on hard things. It can chew apart cinder walls."}, {"versions": ["heartgold"], "text": "Gnaws on anything with its tough fangs. It can even topple concrete buildings by gnawing on them."}, {"versions": ["soulsilver"], "text": "Its whiskers help it to maintain balance. Its fangs never stop growing, so it gnaws to pare them down."}, {"versions": ["black-2", "white-2"], "text": "With its long fangs, this surprisingly violent Pokémon can gnaw away even thick concrete with ease."}, {"versions": ["y"], "text": "The webs on its hind legs enable it to cross rivers. It searches wide areas for food."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Raticate’s sturdy fangs grow steadily. To keep them ground down, it gnaws on rocks and logs. It may even chew on the walls of houses."}, {"versions": ["sun"], "text": "Its hind feet are webbed, so it’s a strong swimmer. It can cross rivers and sometimes even oceans."}, {"versions": ["moon"], "text": "Its disposition is far more violent than its looks would suggest. Don’t let your hand get too close to its face, as it could bite your hand clean off."}, {"versions": ["ultra-sun"], "text": "People say that it fled from its enemies by using its small webbed hind feet to swim from island to island in Alola."}, {"versions": ["ultra-moon"], "text": "Its whiskers are essential for maintaining its balance. No matter how friendly you are, it will get angry and bite you if you touch its whiskers."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/20.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/20.png", "shiny": null}}, "generation-ii": {"crystal": {"no