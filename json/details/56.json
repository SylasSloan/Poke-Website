{"height": 5, "weight": 280, "base_experience": 61, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Pig Monkey Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マンキー"}, {"language": "ja-roma", "name": "Mankey"}, {"language": "ko", "name": "망키"}, {"language": "zh-hant", "name": "猴怪"}, {"language": "fr", "name": "Férosinge"}, {"language": "de", "name": "Menki"}, {"language": "es", "name": "Mankey"}, {"language": "it", "name": "Mankey"}, {"language": "ja", "name": "マンキー"}, {"language": "zh-hans", "name": "猴怪"}, {"language": "es-419", "name": "Mankey"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Extremely quick to anger. It could be docile one moment then thrashing away the next instant."}, {"versions": ["yellow"], "text": "An agile POKéMON that lives in trees. It angers easily and will not hesitate to attack anything."}, {"versions": ["gold", "heartgold"], "text": "It is extremely ill-tempered. Groups of them will attack any handy target for no reason."}, {"versions": ["silver"], "text": "It's unsafe to ap­ proach if it gets violently enraged for no reason and can't distinguish friends from foes."}, {"versions": ["crystal"], "text": "It lives in groups in the treetops. If it loses sight of its group, it becomes infuriated by its loneliness."}, {"versions": ["ruby", "sapphire"], "text": "When MANKEY starts shaking and its nasal breathing turns rough, it’s a sure sign that it is becoming angry. However, because it goes into a towering rage almost instantly, it is impossible for anyone to flee its wrath."}, {"versions": ["emerald"], "text": "When it starts shaking and its nasal breathing turns rough, it’s a sure sign of anger. However, since this happens instantly, there is no time to flee."}, {"versions": ["firered"], "text": "Light and agile on its feet, and ferocious in temperament. When angered, it flies into an uncontrollable frenzy."}, {"versions": ["leafgreen"], "text": "Extremely quick to anger. It could be docile one moment, then thrashing away the next instant."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It lives in treetop colonies. If one becomes enraged, the whole colony rampages for no reason."}, {"versions": ["soulsilver", "x"], "text": "It’s unsafe to approach if it gets violently enraged for no reason and can’t distinguish friends from foes."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "When Mankey starts shaking and its nasal breathing turns rough, it’s a sure sign that it is becoming angry. However, because it goes into a towering rage almost instantly, it is impossible for anyone to flee its wrath."}, {"versions": ["sun"], "text": "It can spontaneously become enraged. Everyone near it clears out as it rampages, and the resulting loneliness makes it angrier still."}, {"versions": ["moon"], "text": "Its raging tires it out and causes it to fall asleep, but the anger resonating in its dreams causes it to wake up—which infuriates it all over again."}, {"versions": ["ultra-sun"], "text": "The smallest of things could cause it to lose its temper. Because it doesn’t hold in its stress, this Pokémon can live a long time."}, {"versions": ["ultra-moon"], "text": "If one gets angry, all the others around it will get angry, so silence is a rare visitor in a troop of Mankey."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "An agile Pokémon that lives in trees. It angers easily and will not hesitate to attack anything."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/56.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/56.png", "shiny": null}}, "generation-ii": {"crystal":