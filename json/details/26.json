{"height": 8, "weight": 300, "base_experience": 218, "ev_yield": [{"stat": "speed", "value": 3}], "genus": "Mouse Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "medium", "egg_groups": ["ground", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ライチュウ"}, {"language": "ja-roma", "name": "Raichu"}, {"language": "ko", "name": "라이츄"}, {"language": "zh-hant", "name": "雷丘"}, {"language": "fr", "name": "Raichu"}, {"language": "de", "name": "Raichu"}, {"language": "es", "name": "Raichu"}, {"language": "it", "name": "Raichu"}, {"language": "ja", "name": "ライチュウ"}, {"language": "zh-hans", "name": "雷丘"}, {"language": "es-419", "name": "Raichu"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its long tail serves as a ground to protect itself from its own high voltage power."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "When electricity builds up inside its body, it becomes feisty. It also glows in the dark."}, {"versions": ["gold"], "text": "When its electric­ ity builds, its muscles are stimu­ lated, and it be­ comes more aggres­ sive than usual."}, {"versions": ["silver", "soulsilver"], "text": "If the electric pouches in its cheeks become fully charged, both ears will stand straight up."}, {"versions": ["crystal"], "text": "If its electric pouches run empty, it raises its tail to gather electri­ city from the atmosphere."}, {"versions": ["ruby"], "text": "If the electrical sacks become excessively charged, RAICHU plants its tail in the ground and discharges. Scorched patches of ground will be found near this POKéMON’s nest."}, {"versions": ["sapphire"], "text": "This POKéMON exudes a weak electrical charge from all over its body that makes it take on a slight glow in darkness. RAICHU searches for electricity by planting its tail in the ground."}, {"versions": ["emerald"], "text": "If it stores too much electricity, its behavior turns aggressive. To avoid this, it occasionally discharges excess energy and calms itself down."}, {"versions": ["firered"], "text": "Its electric charges can reach even 100,000 volts. Careless contact can cause even an Indian elephant to faint."}, {"versions": ["leafgreen", "sword"], "text": "Its long tail serves as a ground to protect itself from its own high-voltage power."}, {"versions": ["diamond"], "text": "It turns aggressive if it has too much electricity in its body. It discharges power through its tail."}, {"versions": ["pearl", "y"], "text": "It can loose 100,000-volt bursts of electricity, instantly downing foes several times its size."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Its tail discharges electricity into the ground, protecting it from getting shocked."}, {"versions": ["heartgold", "x"], "text": "When its electricity builds, its muscles are stimulated, and it becomes more aggressive than usual."}, {"versions": ["omega-ruby"], "text": "If the electrical sacs become excessively charged, Raichu plants its tail in the ground and discharges. Scorched patches of ground will be found near this Pokémon’s nest."}, {"versions": ["alpha-sapphire"], "text": "This Pokémon exudes a weak electrical charge from all over its body that makes it take on a slight glow in darkness. Raichu plants its tail in the ground to discharge electricity."}, {"versions": ["sun"], "text": "It unleashes electric shocks that can reach 100,000 volts. When agitated, it can knock out even an Indian elephant."}, {"versions": ["moon"], "text": "It becomes aggressive when it has electricity stored up. At such times, even its Trainer has to take care to avoid being attacked."}, {"versions": ["ultra-sun"], "text": "As electricity builds up inside its body, it becomes more aggressive. One theory is that the electricity buildup is actually causing stress."}, {"versions": ["ultra-moon"], "text": "Because so many Trainers like the way Pikachu looks, you don’t see this Pokémon very often."}, {"versions": ["shield"], "text": "If its electric pouches run empty, it raises its tail to gather electricity from the atmosphere."}, {"versions": ["legends-arceus"], "text": "It can discharge bursts of electricity exceeding 100,000 volts— a single strike with that amount of power would incapacitate one of the Copperajah of my homeland."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/26.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/26.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/26.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/26.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/26.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/26.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/26.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/26.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/26.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/26.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/26.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokem