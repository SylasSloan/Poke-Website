{"height": 10, "weight": 255, "base_experience": 134, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Cricket Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コロトック"}, {"language": "ja-roma", "name": "Korotock"}, {"language": "ko", "name": "귀뚤톡크"}, {"language": "zh-hant", "name": "音箱蟀"}, {"language": "fr", "name": "Mélokrik"}, {"language": "de", "name": "Zirpeise"}, {"language": "es", "name": "Kricketune"}, {"language": "it", "name": "Kricketune"}, {"language": "ja", "name": "コロトック"}, {"language": "zh-hans", "name": "音箱蟀"}, {"language": "es-419", "name": "Kricketune"}], "pokedex_entries": [{"versions": ["diamond", "x", "omega-ruby"], "text": "It crosses its knifelike arms in front of its chest when it cries. It can compose melodies ad lib."}, {"versions": ["pearl", "y", "alpha-sapphire"], "text": "It signals its emotions with its melodies. Scientists are studying these melodic patterns."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "There is a village that hosts a contest based on the amazingly variable cries of this Pokémon."}, {"versions": ["heartgold", "soulsilver"], "text": "By allowing its cry to resonate in the hollow of its belly, it produces a captivating sound."}, {"versions": ["legends-arceus"], "text": "It uses its cutlass-like arms to produce sound, the melody of which varies from individual to individual. It is a worthwhile endeavor to seek out one's favorite tunes."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/402.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/402.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/