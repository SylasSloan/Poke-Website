{"height": 4, "weight": 44, "base_experience": 60, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Larva Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アゴジムシ"}, {"language": "ja-roma", "name": "Agojimushi"}, {"language": "ko", "name": "턱지충이"}, {"language": "zh-hant", "name": "強顎雞母蟲"}, {"language": "fr", "name": "Larvibule"}, {"language": "de", "name": "Mabula"}, {"language": "es", "name": "Grubbin"}, {"language": "it", "name": "Grubbin"}, {"language": "ja", "name": "アゴジムシ"}, {"language": "zh-hans", "name": "强颚鸡母虫"}, {"language": "es-419", "name": "Grubbin"}], "pokedex_entries": [{"versions": ["sun"], "text": "Its strong jaw enables it to scrape trees and slurp out the sap. It normally lives underground."}, {"versions": ["moon"], "text": "They often gather near places frequented by electric Pokémon in order to avoid being attacked by bird Pokémon."}, {"versions": ["ultra-sun"], "text": "If you find its nest, you shouldn’t stick your hand inside. You’ll get bitten by an irritated Grubbin."}, {"versions": ["ultra-moon"], "text": "It spits a sticky thread to stop opponents in their tracks, and then it grabs them in its sharp, sturdy mandibles to take them down."}, {"versions": ["sword"], "text": "Its natural enemies, like Rookidee, may flee rather than risk getting caught in its large mandibles that can snap thick tree branches."}, {"versions": ["shield"], "text": "It uses its big jaws to dig nests into the forest floor, and it loves to feed on sweet tree sap."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/736.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/736.png", "shin