{"height": 5, "weight": 325, "base_experience": 147, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Rushing Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マッスグマ"}, {"language": "ja-roma", "name": "Massuguma"}, {"language": "ko", "name": "직구리"}, {"language": "zh-hant", "name": "直衝熊"}, {"language": "fr", "name": "Linéon"}, {"language": "de", "name": "Geradaks"}, {"language": "es", "name": "Linoone"}, {"language": "it", "name": "Linoone"}, {"language": "ja", "name": "マッスグマ"}, {"language": "zh-hans", "name": "直冲熊"}, {"language": "es-419", "name": "Linoone"}], "pokedex_entries": [{"versions": ["ruby"], "text": "LINOONE always runs full speed and only in straight lines. If facing an obstacle, it makes a right-angle turn to evade it. This POKéMON is very challenged by gently curving roads."}, {"versions": ["sapphire"], "text": "When hunting, LINOONE will make a beeline straight for the prey at a full run. While this POKéMON is capable of topping 60 mph, it has to come to a screeching halt before it can turn."}, {"versions": ["emerald"], "text": "It is exceedingly fast if it only has to run in a straight line. When it spots pond- dwelling prey underwater, it quickly leaps in and catches it with its sharp claws."}, {"versions": ["firered", "leafgreen"], "text": "When running in a straight line, it can top 60 miles per hour. However, it has a tough time with curved roads."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It charges prey at speeds over 60 mph. However, because it can only run straight, it often fails."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "When running in a straight line, it can easily top 60 miles an hour. It has a tough time with curved roads."}, {"versions": ["omega-ruby"], "text": "Linoone always runs full speed and only in straight lines. 