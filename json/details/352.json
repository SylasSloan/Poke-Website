{"height": 10, "weight": 220, "base_experience": 154, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Color Swap Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カクレオン"}, {"language": "ja-roma", "name": "Kakureon"}, {"language": "ko", "name": "켈리몬"}, {"language": "zh-hant", "name": "變隱龍"}, {"language": "fr", "name": "Kecleon"}, {"language": "de", "name": "Kecleon"}, {"language": "es", "name": "Kecleon"}, {"language": "it", "name": "Kecleon"}, {"language": "ja", "name": "カクレオン"}, {"language": "zh-hans", "name": "变隐龙"}, {"language": "es-419", "name": "Kecleon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "KECLEON is capable of changing its body colors at will to blend in with its surroundings. There is one exception - this POKéMON can’t change the zigzag pattern on its belly."}, {"versions": ["sapphire"], "text": "KECLEON alters its body coloration to blend in with its surroundings, allowing it to sneak up on its prey unnoticed. Then it lashes out with its long, stretchy tongue to instantly ensnare the unsuspecting target."}, {"versions": ["emerald"], "text": "A POKéMON that has the ability to alter its body colors to match its surroundings. A KECLEON reverts to its original colors if it is startled."}, {"versions": ["firered", "leafgreen"], "text": "It changes body color to blend in with its surroundings. It also changes color if it is happy or sad."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It can freely change its body’s color. The zigzag pattern on its belly doesn’t change, however."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It changes its shading to match its surroundings so it can sneak up on prey. Only its belly patterns stay fixed."}, {"versions": ["omega-ruby"], "text": "Kecleon is capable of changing its body colors at will to blend in with its surroundings. There is one exception—this Pokémon can’t change the zigzag pattern on its belly."}, {"versions": ["alpha-sapphire"], "text": "Kecleon alters its body coloration to blend in with its surroundings, allowing it to sneak up on its prey unnoticed. Then it lashes out with its long, stretchy tongue to instantly ensnare the unsuspecting target."}, {"versions": ["ultra-sun"], "text": "It changes its hue to blend into its surroundings. If no one takes notice of it for too long, it will pout and never reveal itself."}, {"versions": ["ultra-moon"], "text": "Its color changes for concealment and also when its mood or health changes. The darker the color, the healthier it is."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/352.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/352.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/352.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/352.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/352.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/352.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/352.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/352.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/