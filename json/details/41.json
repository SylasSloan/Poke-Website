{"height": 8, "weight": 75, "base_experience": 49, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Bat Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ズバット"}, {"language": "ja-roma", "name": "Zubat"}, {"language": "ko", "name": "주뱃"}, {"language": "zh-hant", "name": "超音蝠"}, {"language": "fr", "name": "Nosferapti"}, {"language": "de", "name": "Zubat"}, {"language": "es", "name": "Zubat"}, {"language": "it", "name": "Zubat"}, {"language": "ja", "name": "ズバット"}, {"language": "zh-hans", "name": "超音蝠"}, {"language": "es-419", "name": "Zubat"}], "pokedex_entries": [{"versions": ["y"], "text": "It has no eyes. Instead, it relies on its ultrasonic cries for echolocation to flit about in darkness."}, {"versions": ["red", "blue"], "text": "Forms colonies in perpetually dark places. Uses ultrasonic waves to identify and approach targets."}, {"versions": ["yellow"], "text": "Emits ultrasonic cries while it flies. They act as a sonar used to check for ob­ jects in its way."}, {"versions": ["gold"], "text": "While flying, it constantly emits ultrasonic waves from its mouth to check its sur­ roundings."}, {"versions": ["silver", "soulsilver"], "text": "Capable of flying safely in dark places, it emits ultrasonic cries to check for any obstacles."}, {"versions": ["crystal"], "text": "During the day, it gathers with others and hangs from the ceilings of old buildings and caves."}, {"versions": ["ruby"], "text": "ZUBAT remains quietly unmoving in a dark spot during the bright daylight hours. It does so because prolonged exposure to the sun causes its body to become slightly burned."}, {"versions": ["sapphire"], "text": "ZUBAT avoids sunlight because exposure causes it to become unhealthy. During the daytime, it stays in caves or under the eaves of old houses, sleeping while hanging upside down."}, {"versions": ["emerald"], "text": "While living in pitch-black caverns, their eyes gradually grew shut and deprived them of vision. They use ultrasonic waves to detect obstacles."}, {"versions": ["firered"], "text": "It has no eyes. Instead, it relies on its ultrasonic cries for echo location to flit about in darkness."}, {"versions": ["leafgreen"], "text": "It forms colonies in perpetually dark places and uses ultrasonic waves to identify and approach targets."}, {"versions": ["diamond", "x"], "text": "Even though it has no eyes, it can sense obstacles using ultrasonic waves it emits from its mouth."}, {"versions": ["pearl"], "text": "Disliking sunlight, it sleeps deep in forests and caves until sundown."}, {"versions": ["platinum", "black", "white"], "text": "It checks its surroundings and location using reflections of the ultrasonic waves from its mouth."}, {"versions": ["heartgold"], "text": "While flying, it constantly emits ultrasonic waves from its mouth to check its surroundings."}, {"versions": ["black-2", "white-2"], "text": "It does not need eyes, because it emits ultrasonic waves to check its surroundings while it flies."}, {"versions": ["omega-ruby"], "text": "Zubat remains quietly unmoving in a dark spot during the bright daylight hours. It does so because prolonged exposure to the sun causes its body to become slightly burned."}, {"versions": ["alpha-sapphire"], "text": "Zubat avoids sunlight because exposure causes it to become unhealthy. During the daytime, it stays in caves or under the eaves of old houses, sleeping while hanging upside down."}, {"versions": ["sun"], "text": "It sleeps in caves during the day. It has no eyes, so to check its surroundings while flying, it emits ultrasonic waves."}, {"versions": ["moon"], "text": "When exposed to sunlight, they suffer burns. The frequency of their ultrasonic waves can differ slightly from colony to colony."}, {"versions": ["ultra-sun"], "text": "It has no eyeballs, so it can’t see. It checks its surroundings via the ultrasonic waves it emits from its mouth."}, {"versions": ["ultra-moon"], "text": "Their skin is so thin that they’ll be burned if sunlight hits them. When it gets cold out, they gather together to warm one another’s bodies."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Emits ultrasonic cries while it flies. They act as a sonar used to check for objects in its way."}, {"versions": ["sword"], "text": "It emits ultrasonic waves from its mouth to check its surroundings. Even in tight caves, Zubat flies around with skill."}, {"versions": ["shield"], "text": "Zubat live in caves, down where the sun’s light won’t reach. In the morning, they gather together to keep each other warm as they sleep."}, {"versions": ["legends-arceus"], "text": "Makes its home in gloomy caves. Atrophied eyes have left this Pokémon blind, so it scans its surroundings via sound waves that it emits from its mouth as it flies."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/41.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/41.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/41.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/41.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/41.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/41.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/41.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/ve