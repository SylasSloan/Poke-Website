{"height": 9, "weight": 305, "base_experience": 127, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Spark Pokémon", "capture_rate": 120, "base_happiness": 100, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ルクシオ"}, {"language": "ja-roma", "name": "Luxio"}, {"language": "ko", "name": "럭시오"}, {"language": "zh-hant", "name": "勒克貓"}, {"language": "fr", "name": "Luxio"}, {"language": "de", "name": "Luxio"}, {"language": "es", "name": "Luxio"}, {"language": "it", "name": "Luxio"}, {"language": "ja", "name": "ルクシオ"}, {"language": "zh-hans", "name": "勒克猫"}, {"language": "es-419", "name": "Luxio"}], "pokedex_entries": [{"versions": ["diamond", "x", "omega-ruby"], "text": "Its claws loose electricity with enough amperage to cause fainting. They live in small groups."}, {"versions": ["pearl"], "text": "It rests its forelegs on others to communicate with rhythmic electric pulses from its claws."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "y", "alpha-sapphire"], "text": "Strong electricity courses through the tips of its sharp claws. A light scratch causes fainting in foes."}, {"versions": ["heartgold", "soulsilver"], "text": "By gathering their tails together, they collectively generate powerful electricity from their claws."}, {"versions": ["sword"], "text": "By joining its tail with that of another Luxio, this Pokémon can receive some of the other Luxio’s electricity and power up its own electric blasts."}, {"versions": ["shield"], "text": "Upon encountering an opponent, this Pokémon prepares for battle by extending its claws, which can put out 1,000,000 volts of electricity."}, {"versions": ["legends-arceus"], "text": "Proudly uses its electrified claws as weapons. It seems to be a gracious Pokémon, evenly sharing the spoils of the hunt with others of its kind."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubuser