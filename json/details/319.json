{"height": 18, "weight": 888, "base_experience": 161, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Brutal Pokémon", "capture_rate": 60, "base_happiness": 35, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "サメハダー"}, {"language": "ja-roma", "name": "Samehader"}, {"language": "ko", "name": "샤크니아"}, {"language": "zh-hant", "name": "巨牙鯊"}, {"language": "fr", "name": "Sharpedo"}, {"language": "de", "name": "Tohaido"}, {"language": "es", "name": "Sharpedo"}, {"language": "it", "name": "Sharpedo"}, {"language": "ja", "name": "サメハダー"}, {"language": "zh-hans", "name": "巨牙鲨"}, {"language": "es-419", "name": "Sharpedo"}], "pokedex_entries": [{"versions": ["ruby"], "text": "Nicknamed “the bully of the sea,” SHARPEDO is widely feared. Its cruel fangs grow back immediately if they snap off. Just one of these POKéMON can thoroughly tear apart a supertanker."}, {"versions": ["sapphire"], "text": "SHARPEDO can swim at speeds of up to 75 mph by jetting seawater out of its backside. This POKéMON’s drawback is its inability to swim long distances."}, {"versions": ["emerald"], "text": "The vicious and sly gangster of the sea. Its skin is specially textured to minimize drag in water. Its speed tops out at over 75 miles per hour."}, {"versions": ["firered", "leafgreen"], "text": "The ruffian of the seas, it has fangs that crunch through iron. It swims by jetting water from its rear."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Its fangs rip through sheet iron. It swims at 75 mph and is known as “The Bully of the Sea.”"}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It can swim at speeds of 75 mph by jetting seawater through its body. It is the bandit of the sea."}, {"versions": ["omega-ruby"], "text": "Nicknamed “the bully of the sea,” Sharpedo is widely feared. Its cruel fangs grow back immediately if they snap off. Just one of these Pokémon can thoroughly tear apart a supertanker."}, {"versions": ["alpha-sapphire"], "text": "Sharpedo can swim at speeds of up to 75 mph by jetting seawater out of its backside. This Pokémon’s drawback is its inability to swim long distances."}, {"versions": ["sun"], "text": "It pursues its prey at speeds of 75 mph and finishes them off with fangs that can crush iron. It is known as the bully of the sea."}, {"versions": ["moon"], "text": "It has a sad history. In the past, its dorsal fin was a treasured foodstuff, so this Pokémon became a victim of overfishing."}, {"versions": ["ultra-sun"], "text": "People believe that carrying one of its discarded fangs will prevent mishaps at sea, so the fangs are made into accessories."}, {"versions": ["ultra-moon"], "text": "It drinks in seawater and jets it from its rear to propel itself. It’s very sensitive to the scent of blood."}, {"versions": ["sword"], "text": "As soon as it catches the scent of prey, Sharpedo will jet seawater from its backside, hurtling toward the target to attack at 75 mph."}, {"versions": ["shield"], "text": "This Pokémon is known as the Bully of the Sea. Any ship entering the waters Sharpedo calls home will be attacked—no exceptions."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/319.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/319.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/319.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/319.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/319.png", "shin