{"height": 6, "weight": 325, "base_experience": 180, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Virtual Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ポリゴン２"}, {"language": "ja-roma", "name": "Porygon2"}, {"language": "ko", "name": "폴리곤2"}, {"language": "zh-hant", "name": "多邊獸Ⅱ"}, {"language": "fr", "name": "Porygon2"}, {"language": "de", "name": "Porygon2"}, {"language": "es", "name": "Porygon2"}, {"language": "it", "name": "Porygon2"}, {"language": "ja", "name": "ポリゴン２"}, {"language": "zh-hans", "name": "多边兽２型"}, {"language": "es-419", "name": "Porygon2"}], "pokedex_entries": [{"versions": ["gold"], "text": "This upgraded version of PORYGON is designed for space exploration. It can't fly, though."}, {"versions": ["silver"], "text": "Further research enhanced its abil­ ities. Sometimes, it may exhibit motions that were not programmed."}, {"versions": ["crystal"], "text": "This manmade POKéMON evolved from the latest technology. It may have unprog­ rammed reactions."}, {"versions": ["ruby", "sapphire"], "text": "PORYGON2 was created by humans using the power of science. The man-made POKéMON has been endowed with artificial intelligence that enables it to learn new gestures and emotions on its own."}, {"versions": ["emerald"], "text": "It was created by humans using the power of science. It has been given artificial intelligence that enables it to learn new gestures and emotions on its own."}, {"versions": ["firered", "soulsilver", "x"], "text": "Further research enhanced its abilities. Sometimes, it may exhibit motions that were not programmed."}, {"versions": ["leafgreen"], "text": "This upgraded version of PORYGON is designed for space exploration. However, it can’t even fly."}, {"versions": ["diamond", "pearl", "y"], "text": "With planetary development software installed, it became capable of working in space."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It was upgraded to enable the exploration of other planets. However, it failed to measure up."}, {"versions": ["heartgold"], "text": "This upgraded version of PORYGON is designed for space exploration. It can’t fly, however."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Porygon2 was created by humans using the power of science. The man-made Pokémon has been endowed with artificial intelligence that enables it to learn new gestures and emotions on its own."}, {"versions": ["sun"], "text": "For the purposes of planetary development, Porygon was updated with the most cutting-edge technology available."}, {"versions": ["moon"], "text": "Porygon was updated to a new version in readiness for planetary development. But that dream remains unrealized as yet."}, {"versions": ["ultra-sun"], "text": "AI has been installed in it. It learns various things all on its own, but it even remembers things it doesn’t need to know."}, {"versions": ["ultra-moon"], "text": "Even though it doesn’t die in the vacuum of space, it can’t move around very well in zero gravity."}, {"versions": ["sword"], "text": "This is a Porygon that was updated with special data. Porygon2 develops itself by learning about many different subjects all on its own."}, {"versions": ["shield"], "text": "After artificial intelligence was implemented in Porygon2, the Pokémon began using a strange language that only other Porygon2 understand."}, {"versions": ["legends-arceus"], "text": "A bizarre item caused this Pokémon to evolve. While it now exhibits many new gestures and expressions, its biology remains inscrutable."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/233.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/233.png"},