{"height": 3, "weight": 18, "base_experience": 50, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Tiny Bird Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ポッポ"}, {"language": "ja-roma", "name": "Poppo"}, {"language": "ko", "name": "구구"}, {"language": "zh-hant", "name": "波波"}, {"language": "fr", "name": "Roucool"}, {"language": "de", "name": "Taubsi"}, {"language": "es", "name": "Pidgey"}, {"language": "it", "name": "Pidgey"}, {"language": "ja", "name": "ポッポ"}, {"language": "zh-hans", "name": "波波"}, {"language": "es-419", "name": "Pidgey"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen", "x"], "text": "A common sight in forests and woods. It flaps its wings at ground level to kick up blinding sand."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "Very docile. If attacked, it will often kick up sand to protect itself rather than fight back."}, {"versions": ["gold"], "text": "It usually hides in tall grass. Be­ cause it dislikes fighting, it pro­ tects itself by kicking up sand."}, {"versions": ["silver"], "text": "Common in grassy areas and forests, it is very docile and will chase off enemies by flap­ ping up sand."}, {"versions": ["crystal"], "text": "It rapidly flaps its wings in the grass, stirring up a dust cloud that drives insect prey out into the open."}, {"versions": ["ruby", "sapphire"], "text": "PIDGEY has an extremely sharp sense of direction. It is capable of unerringly returning home to its nest, however far it may be removed from its familiar surroundings."}, {"versions": ["emerald"], "text": "It has an extremely sharp sense of direction. It can unerringly return home to its nest, however far it may be removed from its familiar surroundings."}, {"versions": ["firered"], "text": "Does not like to fight. It hides in tall grass and so on, foraging for food such as small bugs."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It is docile and prefers to avoid conflict. If disturbed, however, it can ferociously strike back."}, {"versions": ["heartgold"], "text": "It usually hides in tall grass. Because it dislikes fighting, it protects itself by kicking up sand."}, {"versions": ["soulsilver"], "text": "Common in grassy areas and forests, it is very docile and will chase off enemies by flapping up sand."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Pidgey has an extremely sharp sense of direction. It is capable of unerringly returning home to its nest, however far it may be removed from its familiar surroundings."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/16.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/16.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/16.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/16.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/16.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/16.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/16.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/16.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/genera