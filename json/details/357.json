{"height": 20, "weight": 1000, "base_experience": 161, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Fruit Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["monster", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "トロピウス"}, {"language": "ja-roma", "name": "Tropius"}, {"language": "ko", "name": "트로피우스"}, {"language": "zh-hant", "name": "熱帶龍"}, {"language": "fr", "name": "Tropius"}, {"language": "de", "name": "Tropius"}, {"language": "es", "name": "Tropius"}, {"language": "it", "name": "Tropius"}, {"language": "ja", "name": "トロピウス"}, {"language": "zh-hans", "name": "热带龙"}, {"language": "es-419", "name": "Tropius"}], "pokedex_entries": [{"versions": ["leafgreen", "firered"], "text": "It lives in tropical jungles. The bunch of fruit around its neck is delicious. The fruit grows twice a year."}, {"versions": ["ruby"], "text": "The bunches of fruit around TROPIUS’s neck are very popular with children. This POKéMON loves fruit, and eats it continuously. Apparently, its love for fruit resulted in its own outgrowth of fruit."}, {"versions": ["sapphire"], "text": "Children of the southern tropics eat as snacks the fruit that grows in bunches around the neck of TROPIUS. This POKéMON flies by flapping the leaves on its back as if they were wings."}, {"versions": ["emerald"], "text": "It flies by flapping its broad leaves. The bunch of fruit that grows around its neck is deliciously sweet. In the spring, it scatters pollen from its neck."}, {"versions": ["diamond", "pearl"], "text": "Because it continually ate only its favorite fruit, the fruit started growing around its neck."}, {"versions": ["platinum", "black", "white"], "text": "Delicious fruits grew out from around its neck because it always ate the same kind of fruit."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "The bunch of fruit around its neck ripens twice a year and is delicious. It’s a highly favored tropical snack."}, {"versions": ["black-2", "white-2", "x"], "text": "It flies by flapping its broad leaves and gives the sweet, delicious fruit around its neck to children."}, {"versions": ["omega-ruby"], "text": "The bunches of fruit around Tropius’s neck are very popular with children. This Pokémon loves fruit, and eats it continuously. Apparently, its love for fruit resulted in its own outgrowth of fruit."}, {"versions": ["alpha-sapphire"], "text": "Children of the southern tropics eat as snacks the fruit that grows in bunches around the neck of Tropius. This Pokémon flies by flapping the leaves on its back as if they were wings."}, {"versions": ["ultra-sun"], "text": "The bunches of fruit growing around the necks of Tropius in Alola are especially sweet compared to those in other regions."}, {"versions": ["ultra-moon"], "text": "Bunches of delicious fruit grow around its neck. In warm areas, many ranches raise Tropius."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/357.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/357.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/357.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/357.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/357.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/357.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/357.png", "shiny"