{"height": 11, "weight": 250, "base_experience": 142, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Big Jaw Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "water1"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "アリゲイツ"}, {"language": "ja-roma", "name": "Alligates"}, {"language": "ko", "name": "엘리게이"}, {"language": "zh-hant", "name": "藍鱷"}, {"language": "fr", "name": "Crocrodil"}, {"language": "de", "name": "Tyracroc"}, {"language": "es", "name": "Croconaw"}, {"language": "it", "name": "Croconaw"}, {"language": "ja", "name": "アリゲイツ"}, {"language": "zh-hans", "name": "蓝鳄"}, {"language": "es-419", "name": "Croconaw"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "x"], "text": "If it loses a fang, a new one grows back in its place. There are always 48 fangs lining its mouth."}, {"versions": ["silver", "firered", "soulsilver"], "text": "It opens its huge jaws wide when attacking. If it loses any fangs while biting, they grow back in."}, {"versions": ["crystal"], "text": "The tips of its fangs are slanted backward. Once those fangs clamp down, the prey has no hope of escape."}, {"versions": ["ruby", "sapphire"], "text": "Once CROCONAW has clamped its jaws on its foe, it will absolutely not let go. Because the tips of its fangs are forked back like barbed fishhooks, they become impossible to remove when they have sunk in."}, {"versions": ["emerald"], "text": "Once its jaws clamp down on its foe, it will absolutely not let go. Because the tips of its fangs are forked back like fishhooks, they become irremovably embedded."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "Once it bites down, it won’t let go until it loses its fangs. New fangs quickly grow into place."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Once Croconaw has clamped its jaws on