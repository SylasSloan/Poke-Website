{"height": 14, "weight": 502, "base_experience": 159, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Punching Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "エビワラー"}, {"language": "ja-roma", "name": "Ebiwalar"}, {"language": "ko", "name": "홍수몬"}, {"language": "zh-hant", "name": "快拳郎"}, {"language": "fr", "name": "Tygnon"}, {"language": "de", "name": "Nockchan"}, {"language": "es", "name": "Hitmonchan"}, {"language": "it", "name": "Hitmonchan"}, {"language": "ja", "name": "エビワラー"}, {"language": "zh-hans", "name": "快拳郎"}, {"language": "es-419", "name": "Hitmonchan"}], "pokedex_entries": [{"versions": ["pearl", "diamond", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "The arm-twisting punches it throws pulverize even concrete. It rests after three minutes of fighting."}, {"versions": ["red", "blue"], "text": "While apparently doing nothing, it fires punches in lightning fast volleys that are impossible to see."}, {"versions": ["yellow"], "text": "Punches in cork­ screw fashion. It can punch its way through a concrete wall in the same way as a drill."}, {"versions": ["gold", "heartgold", "shield"], "text": "Its punches slice the air. However, it seems to need a short break after fighting for three minutes."}, {"versions": ["silver", "soulsilver", "sword"], "text": "Its punches slice the air. They are launched at such high speed, even a slight graze could cause a burn."}, {"versions": ["crystal"], "text": "To increase the strength of all its punch moves, it spins its arms just before making contact."}, {"versions": ["ruby", "sapphire"], "text": "HITMONCHAN is said to possess the spirit of a boxer who had been working towards a world championship. This POKéMON has an indomitable spirit and will never give up in the face of adversity."}, {"versions": ["emerald"], "text": "A HITMONCHAN is said to p