{"height": 16, "weight": 1, "base_experience": 142, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Gas Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴースト"}, {"language": "ja-roma", "name": "Ghost"}, {"language": "ko", "name": "고우스트"}, {"language": "zh-hant", "name": "鬼斯通"}, {"language": "fr", "name": "Spectrum"}, {"language": "de", "name": "Alpollo"}, {"language": "es", "name": "Haunter"}, {"language": "it", "name": "Haunter"}, {"language": "ja", "name": "ゴースト"}, {"language": "zh-hans", "name": "鬼斯通"}, {"language": "es-419", "name": "Haunter"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Because of its ability to slip through block walls, it is said to be from an­ other dimension."}, {"versions": ["yellow"], "text": "By licking, it saps the victim's life. It causes shaking that won't stop until the victim's demise."}, {"versions": ["gold", "heartgold"], "text": "In total darkness, where nothing is visible, HAUNTER lurks, silently stalking its next victim."}, {"versions": ["silver"], "text": "Its tongue is made of gas. If licked, its victim starts shaking constantly until death even­ tually comes."}, {"versions": ["crystal"], "text": "It hides in the dark, planning to take the life of the next living thing that wanders close by."}, {"versions": ["ruby", "sapphire"], "text": "HAUNTER is a dangerous POKéMON. If one beckons you while floating in darkness, you must never approach it. This POKéMON will try to lick you with its tongue and steal your life away."}, {"versions": ["emerald"], "text": "If a HAUNTER beckons you while it is floating in darkness, don’t approach it. This POKéMON will try to lick you with its tongue and steal your life away."}, {"versions": ["firered"], "text": "If you get the feeling of being watched in darkness when nobody is around, HAUNTER is there."}, {"versions": ["leafgreen"], "text": "Because of its ability to slip through block walls, it is said to be from another dimension."}, {"versions": ["diamond"], "text": "It can slip through any obstacle. It lurks inside walls to keep an eye on its foes."}, {"versions": ["pearl", "y"], "text": "It licks with its gaseous tongue to steal the victim’s life force. It lurks in darkness for prey."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It likes to lurk in the dark and tap shoulders with a gaseous hand. Its touch causes endless shuddering."}, {"versions": ["soulsilver", "sword"], "text": "Its tongue is made of gas. If licked, its victim starts shaking constantly until death eventually comes."}, {"versions": ["x", "shield"], "text": "If you get the feeling of being watched in darkness when nobody is around, Haunter is there."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Haunter is a dangerous Pokémon. If one beckons you while floating in darkness, you must never approach it. This Pokémon will try to lick you with its tongue and steal your life away."}, {"versions": ["sun"], "text": "It strikes at humans from total darkness. Those licked by its cold tongue grow weaker with each passing day until they die."}, {"versions": ["moon"], "text": "It fears the light and revels in the dark. It may be on the verge of extinction in cities that stay brightly lit at night."}, {"versions": ["ultra-sun"], "text": "On moonless nights, Haunter searches for someone to curse, so it’s best not to go out walking around."}, {"versions": ["ultra-moon"], "text": "It’s dangerous to go outside alone on nights when you’re feeling sad. Haunter will catch you, and you won’t be able to go back home."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "By licking, it saps the victim’s life. It causes shaking that won’t stop until the victim’s demise."}, {"versions": ["legends-arceus"], "text": "This frightful, malevolent spirit can glide through walls, appearing wherever it likes. According to rumor, victims of a Haunter's lick will wither to death day by day."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/93.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/93.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/93.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/93.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/93.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/93.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/93.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/93.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/93.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/93.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/93.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/93.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/93.png", "shiny": "http