{"height": 7, "weight": 295, "base_experience": 66, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Sea Weasel Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ブイゼル"}, {"language": "ja-roma", "name": "Buoysel"}, {"language": "ko", "name": "브이젤"}, {"language": "zh-hant", "name": "泳圈鼬"}, {"language": "fr", "name": "Mustébouée"}, {"language": "de", "name": "Bamelin"}, {"language": "es", "name": "Buizel"}, {"language": "it", "name": "Buizel"}, {"language": "ja", "name": "ブイゼル"}, {"language": "zh-hans", "name": "泳圈鼬"}, {"language": "es-419", "name": "Buizel"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It has a flotation sac that is like an inflatable collar. It floats on water with its head out."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It swims by rotating its two tails like a screw. When it dives, its flotation sac collapses."}, {"versions": ["platinum", "black", "white"], "text": "It spins its two tails like a screw to propel itself through water. The tails also slice clinging seaweed."}, {"versions": ["heartgold", "soulsilver"], "text": "It inflates its flotation sac, keeping its face above water in order to watch for prey movement."}, {"versions": ["black-2", "white-2", "y", "alpha-sapphire"], "text": "It inflates the flotation sac around its neck and pokes its head out of the water to see what is going on."}, {"versions": ["legends-arceus"], "text": "It moves freely in the water by spinning its forked tail for propulsion. The resemblance to the screw of a steamboat is coincidental."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/418.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/s