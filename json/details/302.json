{"height": 5, "weight": 110, "base_experience": 133, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Darkness Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "medium-slow", "egg_groups": ["humanshape"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤミラミ"}, {"language": "ja-roma", "name": "Yamirami"}, {"language": "ko", "name": "깜까미"}, {"language": "zh-hant", "name": "勾魂眼"}, {"language": "fr", "name": "Ténéfix"}, {"language": "de", "name": "Zobiris"}, {"language": "es", "name": "Sableye"}, {"language": "it", "name": "Sableye"}, {"language": "ja", "name": "ヤミラミ"}, {"language": "zh-hans", "name": "勾魂眼"}, {"language": "es-419", "name": "Sableye"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SABLEYE lead quiet lives deep inside caverns. They are feared, however, because these POKéMON are thought to steal the spirits of people when their eyes burn with a sinister glow in the darkness."}, {"versions": ["sapphire"], "text": "SABLEYE digs the ground with sharpened claws to find rocks that it eats. Substances in the eaten rocks crystallize and rise up to the POKéMON’s body surface."}, {"versions": ["emerald"], "text": "It digs branching holes in caves using its sharp claws in search of food--raw gems. A SABLEYE lurks in darkness and is seen only rarely."}, {"versions": ["firered", "leafgreen", "shield"], "text": "It feeds on gemstone crystals. In darkness, its eyes sparkle with the glitter of jewels."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It hides in the darkness of caves. Its diet of gems has transformed its eyes into gemstones."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It dwells in the darkness of caves. It uses its sharp claws to dig up gems to nourish itself."}, {"versions": ["omega-ruby"], "text": "Sableye lead quiet lives deep inside caverns. They are feared, however, because these Pokémon are thought to steal the spirits of people when their eyes burn with a sinister glow in the darkness."}, {"versions": ["alpha-sapphire"], "text": "Sableye digs the ground with sharpened claws to find rocks that it eats. Substances in the eaten rocks crystallize and rise up to the Pokémon’s body surface."}, {"versions": ["sun"], "text": "It’s a fiend for gemstones, so it stalks Carbink. Unfortunately, Gabite almost always grabs them first."}, {"versions": ["moon", "sword"], "text": "This Pokémon is feared. When its gemstone eyes begin to glow with a sinister shine, it’s believed that Sableye will steal people’s spirits away."}, {"versions": ["ultra-sun"], "text": "It digs through the ground with its hard claws and crunches down gems with its thick pointy teeth. Carbink is its favorite food."}, {"versions": ["ultra-moon"], "text": "Materials from gems it has eaten float to the surface of its body and can form an infinite number of patterns among individuals."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/302.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/302.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/302.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/302.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/302.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/302.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/ge