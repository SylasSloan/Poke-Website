{"height": 19, "weight": 1550, "base_experience": 194, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Legendary Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["ground"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "ウインディ"}, {"language": "ja-roma", "name": "Windie"}, {"language": "ko", "name": "윈디"}, {"language": "zh-hant", "name": "風速狗"}, {"language": "fr", "name": "Arcanin"}, {"language": "de", "name": "Arkani"}, {"language": "es", "name": "Arcanine"}, {"language": "it", "name": "Arcanine"}, {"language": "ja", "name": "ウインディ"}, {"language": "zh-hans", "name": "风速狗"}, {"language": "es-419", "name": "Arcanine"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A POKéMON that has been admired since the past for its beauty. It runs agilely as if on wings."}, {"versions": ["yellow"], "text": "A legendary POKé­ MON in China. Many people are charmed by its grace and beauty while running."}, {"versions": ["gold"], "text": "This legendary Chinese POKEMON is considered magnif­ icent. Many people are enchanted by its grand mane."}, {"versions": ["silver"], "text": "Its magnificent bark conveys a sense of majesty. Anyone hearing it can't help but grovel before it."}, {"versions": ["crystal"], "text": "An ancient picture scroll shows that people were attracted to its movement as it ran through prairies."}, {"versions": ["ruby", "sapphire"], "text": "ARCANINE is known for its high speed. It is said to be capable of running over 6,200 miles in a single day and night. The fire that blazes wildly within this POKéMON’s body is its source of power."}, {"versions": ["emerald"], "text": "This fleet-footed POKéMON is said to run over 6,200 miles in a single day and night. The fire that blazes wildly within its body is its source of power."}, {"versions": ["firered"], "text": "A POKéMON that is described in Chinese legends. It is said to race at an unbelievable speed."}, {"versions": ["leafgreen"], "text": "A POKéMON that has long been admired for its beauty. It runs agilely as if on wings."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Its proud and regal appearance has captured the hearts of people since long ago."}, {"versions": ["heartgold"], "text": "This legendary Chinese Pokémon is considered magnificent. Many people are enchanted by its grand mane."}, {"versions": ["soulsilver", "y"], "text": "Its magnificent bark conveys a sense of majesty. Anyone hearing it can’t help but grovel before it."}, {"versions": ["black-2", "white-2", "sword"], "text": "The sight of it running over 6,200 miles in a single day and night has captivated many people."}, {"versions": ["x", "shield"], "text": "A Pokémon that has long been admired for its beauty. It runs agilely as if on wings."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Arcanine is known for its high speed. It is said to be capable of running over 6,200 miles in a single day and night. The fire that blazes wildly within this Pokémon’s body is its source of power."}, {"versions": ["sun"], "text": "Overflowing with beauty and majesty, this strong Pokémon appears in ancient Eastern folklore."}, {"versions": ["moon"], "text": "The fire burning inside its body serves as the energy to fuel it as it runs great distances. It appears in many legends."}, {"versions": ["ultra-sun"], "text": "Legends tell of its fighting alongside a general and conquering a whole country."}, {"versions": ["ultra-moon"], "text": "There are so many old tales about them that they’re called legendary Pokémon, but there are way more of them around than you’d expect."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A legendary Pokémon in the East. Many people are charmed by the grace and beauty of its running."}, {"versions": ["legends-arceus"], "text": "Snaps at its foes with fangs cloaked in blazing flame. Despite its bulk, it deftly feints every which way, leading opponents on a deceptively merry chase as it all but dances around them."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/59.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/59.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/59.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/59.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/59.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/59.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/59.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/59.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/59.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/59.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/59.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/59.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/59.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprit