{"height": 14, "weight": 356, "base_experience": 137, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Five Star Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "fast", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "レディアン"}, {"language": "ja-roma", "name": "Redian"}, {"language": "ko", "name": "레디안"}, {"language": "zh-hant", "name": "安瓢蟲"}, {"language": "fr", "name": "Coxyclaque"}, {"language": "de", "name": "Ledian"}, {"language": "es", "name": "Ledian"}, {"language": "it", "name": "Ledian"}, {"language": "ja", "name": "レディアン"}, {"language": "zh-hans", "name": "安瓢虫"}, {"language": "es-419", "name": "Ledian"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "x"], "text": "When the stars flicker in the night sky, it flutters about, scattering a glowing powder."}, {"versions": ["silver", "firered"], "text": "The star patterns on its back grow larger or smaller depending on the number of stars in the night sky."}, {"versions": ["crystal"], "text": "In the daytime when it gets warm, it curls up inside a big leaf and drifts off into a deep slumber."}, {"versions": ["ruby", "sapphire"], "text": "It is said that in lands with clean air, where the stars fill the sky, there live LEDIAN in countless numbers. There is a good reason for this - the POKéMON uses the light of the stars as its energy."}, {"versions": ["emerald"], "text": "It is said that in lands with clean air, where the stars fill the sky, there live many LEDIAN. For good reason, they use the light of the stars as energy."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It uses starlight as energy. When more stars appear at night, the patterns on its back grow larger."}, {"versions": ["soulsilver", "y"], "text": "The spot patterns on its back grow larger or smaller depending on the number of stars in the night sky."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "It is said that in lands with clean air, where the stars fill the sky, there live Ledian in countless numbers. There is a good reason for this—the Pokémon uses the light of the stars as its energy."}, {"versions": ["sun"], "text": "While it’s believed that starlight provides it with energy, this Pokémon also loves to eat berries. In the daytime, it curls up in the grass to sleep."}, {"versions": ["moon"], "text": "In battle, it throws punches with all four arms. The power of each individual blow is piddly, so it aims to win by quantity rather than quality."}, {"versions": ["ultra-sun"], "text": "It’s said that the patterns on its back are related to the stars in the night sky, but the details of that relationship remain unclear."}, {"versions": ["ultra-moon"], "text": "It flies through the night sky, sprinkling sparkly dust. According to some, if that dust sticks to you, good things will happen to you."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/166.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/166.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/166.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/166.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/166.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/166.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/166.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/spri