{"height": 10, "weight": 334, "base_experience": 123, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Desert Croc Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ワルビル"}, {"language": "ja-roma", "name": "Waruvile"}, {"language": "ko", "name": "악비르"}, {"language": "zh-hant", "name": "混混鱷"}, {"language": "fr", "name": "Escroco"}, {"language": "de", "name": "Rokkaiman"}, {"language": "es", "name": "Krokorok"}, {"language": "it", "name": "Krokorok"}, {"language": "ja", "name": "ワルビル"}, {"language": "zh-hans", "name": "混混鳄"}, {"language": "es-419", "name": "Krokorok"}], "pokedex_entries": [{"versions": ["black", "x", "omega-ruby"], "text": "They live in groups of a few individuals. Protective membranes shield their eyes from sandstorms."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "The special membrane covering its eyes can sense the heat of objects, so it can see its surroundings even in darkness."}, {"versions": ["black-2", "white-2"], "text": "Protected by thin membranes, their eyes can see even in the dead of night. They live in groups of a few individuals."}, {"versions": ["sun"], "text": "They move in groups of a few individuals. A female is often the leader of the group, and the males will gather food."}, {"versions": ["moon"], "text": "Thanks to the special membrane covering its eyes, it can see its surroundings clearly, even in the middle of the night."}, {"versions": ["ultra-sun"], "text": "Krokorok really hates it when its body gets cold. On nights when the temperature drops, it digs deep into the desert sands."}, {"versions": ["ultra-moon"], "text": "It buries some of its prey in the sand to use as emergency meals when its hunts are unsuccessful."}, {"versions": ["sword"], "text": "Krokorok has specialized eyes that enable it to see in the dark. This ability lets Krokorok hunt in the dead of night wi