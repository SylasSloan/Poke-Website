{"height": 7, "weight": 205, "base_experience": 60, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Land Shark Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["monster", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "フカマル"}, {"language": "ja-roma", "name": "Fukamaru"}, {"language": "ko", "name": "딥상어동"}, {"language": "zh-hant", "name": "圓陸鯊"}, {"language": "fr", "name": "Griknot"}, {"language": "de", "name": "Kaumalat"}, {"language": "es", "name": "Gible"}, {"language": "it", "name": "Gible"}, {"language": "ja", "name": "フカマル"}, {"language": "zh-hans", "name": "圆陆鲨"}, {"language": "es-419", "name": "Gible"}], "pokedex_entries": [{"versions": ["diamond", "y", "alpha-sapphire"], "text": "It nests in small, horizontal holes in cave walls. It pounces to catch prey that stray too close."}, {"versions": ["pearl"], "text": "It once lived in the tropics. To avoid the cold, it lives in caves warmed by geothermal heat."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It attacks using its huge mouth. While its attacks are powerful, it hurts itself out of clumsiness, too."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "It nests in horizontal holes warmed by geothermal heat. Foes who get too close can expect to be pounced on and bitten."}, {"versions": ["sun"], "text": "It lives in caves warmed by geothermal heat. Even so, when the weather gets cold, it will huddle close with others of its kind."}, {"versions": ["moon"], "text": "It skulks in caves, and when prey or an enemy passes by, it leaps out and chomps them. The force of its attack sometimes chips its teeth."}, {"versions": ["ultra-sun"], "text": "It reacts to anything that moves—flies right at it and bites it. Sometimes it injures itself, but it doesn’t care too much."}, {"versions": ["ultra-moon"], "text": "Its original home is an area much hotter than Alola. If you’re planning to live with one, your heating bill will soar."}, {"versions": ["sword"], "text": "Gible prefers to stay in narrow holes in the sides of caves heated by geothermal energy. This way, Gible can stay warm even during a blizzard."}, {"versions": ["shield"], "text": "Gible attacks anything that moves, and it drags whatever it catches into the crevice that is its lair. Despite the big mouth, Gible’s stomach is small."}, {"versions": ["legends-arceus"], "text": "It nests in caves untouched by sunlight. Its sharp teeth may fall out when worn away or after an impact, but they regrow within a few days."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/443.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/443.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/443.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/443.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/443.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/443.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/443.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/443.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/443.png"}}, "gene