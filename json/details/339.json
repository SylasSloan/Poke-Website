{"height": 4, "weight": 19, "base_experience": 58, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Whiskers Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "de", "name": "Schmerbe"}, {"language": "ja-hrkt", "name": "ドジョッチ"}, {"language": "ja-roma", "name": "Dojoach"}, {"language": "ko", "name": "미꾸리"}, {"language": "zh-hant", "name": "泥泥鰍"}, {"language": "fr", "name": "Barloche"}, {"language": "es", "name": "Barboach"}, {"language": "it", "name": "Barboach"}, {"language": "ja", "name": "ドジョッチ"}, {"language": "zh-hans", "name": "泥泥鳅"}, {"language": "es-419", "name": "Barboach"}], "pokedex_entries": [{"versions": ["ruby"], "text": "BARBOACH’s sensitive whiskers serve as a superb radar system. This POKéMON hides in mud, leaving only its two whiskers exposed while it waits for prey to come along."}, {"versions": ["sapphire"], "text": "BARBOACH’s body is covered with a slimy film. If a foe grabs it, this POKéMON just slips out of the enemy’s grip. This POKéMON grows weak if the slimy coating dries up."}, {"versions": ["emerald"], "text": "Its body is covered with a slimy film. The film acts as a barrier to prevent germs in muddy water from entering the BARBOACH’s body."}, {"versions": ["firered", "leafgreen", "shield"], "text": "It probes muddy riverbeds with its two long whiskers. A slimy film protects its body."}, {"versions": ["diamond", "x"], "text": "It coats its entire body with a slimy fluid so it can squirm and slip away if grabbed."}, {"versions": ["pearl", "y"], "text": "Its whiskers make a superb radar. They are used to locate prey, even in the murkiest of water."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "sword"], "text": "Its slimy body is hard to grasp. In one region, it is said to have been born from hardened mud."}, {"versions": ["heartgold", "soulsilver"], "text": "BARBOACH uses its whiskers to taste things just as a person uses his or her tongue to taste things."}, {"versions": ["omega-ruby"], "text": "Barboach’s sensitive whiskers serve as a superb radar system. This Pokémon hides in mud, leaving only its two whiskers exposed while it waits for prey to come along."}, {"versions": ["alpha-sapphire"], "text": "Barboach’s body is covered with a slimy film. If a foe grabs it, this Pokémon just slips out of the enemy’s grip. This Pokémon grows weak if the slimy coating dries up."}, {"versions": ["sun"], "text": "Its two whiskers provide a sensitive radar. Even in muddy waters, it can detect its prey’s location."}, {"versions": ["moon"], "text": "Its slippery body is hard to grasp, so much so that there are festivals where people compete to see how many they can catch barehanded."}, {"versions": ["ultra-sun"], "text": "Its entire body is gooey. When pecked at by bird Pokémon, it slips and slides its way to freedom."}, {"versions": ["ultra-moon"], "text": "Its whiskers are filled with nerves. They can sense smells and flavors just as a person’s nose or tongue would."}, {"versions": ["legends-arceus"], "text": "Makes its home in swamps with murky water. The poor visibility hides this Pokémon from predators, and the slime on its body makes grasping it difficult."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/339.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/339.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/339.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/339.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/version