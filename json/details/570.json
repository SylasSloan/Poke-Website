{"height": 7, "weight": 125, "base_experience": 66, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Tricky Fox Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ゾロア"}, {"language": "ja-roma", "name": "Zorua"}, {"language": "ko", "name": "조로아"}, {"language": "zh-hant", "name": "索羅亞"}, {"language": "fr", "name": "Zorua"}, {"language": "de", "name": "Zorua"}, {"language": "es", "name": "Zorua"}, {"language": "it", "name": "Zorua"}, {"language": "ja", "name": "ゾロア"}, {"language": "zh-hans", "name": "索罗亚"}, {"language": "es-419", "name": "Zorua"}], "pokedex_entries": [{"versions": ["black"], "text": "It changes into the forms of others to surprise them. Apparently, it often transforms into a silent child."}, {"versions": ["white", "y", "alpha-sapphire"], "text": "To protect themselves from danger, they hide their true identities by transforming into people and Pokémon."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "It changes so it looks just like its foe, tricks it, and then uses that opportunity to flee."}, {"versions": ["ultra-sun"], "text": "This Pokémon has a cowardly disposition, so when it’s not around friends, it basically always stays transformed as something else."}, {"versions": ["ultra-moon"], "text": "If a normally talkative child suddenly stops talking, it may have been replaced by Zorua."}, {"versions": ["sword"], "text": "Zorua is a timid Pokémon. This disposition seems to be what led to the development of Zorua’s ability to take on the forms of other creatures."}, {"versions": ["shield"], "text": "Zorua sometimes transforms into a person and goes into cities to search for food. When Zorua does this, it usually takes on the form of a child."}, {"versions": ["legends-arceus"], "text": "A once-departed soul, returned to life in Hisui. Derives power from resentment, which rises as energy atop its head and takes on the forms of foes. In this way, Zorua vents lingering malice."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/570.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/570.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/570.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/570.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/570.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/570.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/570.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/570.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/570.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/570.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/570.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation V", "level_up": [{"level": 1, "label": "Level 1", "name": "Scratch"}, {"level": 1, "label": "Level 1", "name": "L