{"height": 8, "weight": 245, "base_experience": 184, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Lightning Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "サンダース"}, {"language": "ja-roma", "name": "Thunders"}, {"language": "ko", "name": "쥬피썬더"}, {"language": "zh-hant", "name": "雷伊布"}, {"language": "fr", "name": "Voltali"}, {"language": "de", "name": "Blitza"}, {"language": "es", "name": "Jolteon"}, {"language": "it", "name": "Jolteon"}, {"language": "ja", "name": "サンダース"}, {"language": "zh-hans", "name": "雷伊布"}, {"language": "es-419", "name": "Jolteon"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "It accumulates negative ions in the atmosphere to blast out 10000- volt lightning bolts."}, {"versions": ["yellow"], "text": "A sensitive POKé­ MON that easily becomes sad or angry. Every time its mood changes, it charges power."}, {"versions": ["gold", "heartgold"], "text": "It concentrates the weak electric charges emitted by its cells and launches wicked lightning bolts."}, {"versions": ["silver", "soulsilver", "x"], "text": "Every hair on its body starts to stand sharply on end if it becomes charged with electricity."}, {"versions": ["crystal"], "text": "The negatively charged ions generated in its fur create a constant sparking noise."}, {"versions": ["ruby", "sapphire"], "text": "JOLTEON’s cells generate a low level of electricity. This power is amplified by the static electricity of its fur, enabling the POKéMON to drop thunderbolts. The bristling fur is made of electrically charged needles."}, {"versions": ["emerald"], "text": "Its cells generate weak power that is amplified by its fur’s static electricity to drop thunderbolts. The bristling fur is made of electrically charged needles."}, {"versions": ["firered", "sword"], "text": "If it is angered or startled, the fur all over its body bristles like sharp needles that pierce foes."}, {"versions": ["leafgreen", "y", "shield"], "text": "It accumulates negative ions in the atmosphere to blast out 10,000-volt lightning bolts."}, {"versions": ["diamond", "pearl"], "text": "It controls 10,000-volt power and can raise all the fur on its body as if it were sharp needles."}, {"versions": ["platinum", "black", "white"], "text": "If agitated, it uses electricity to straighten out its fur and launch it in small bunches."}, {"versions": ["black-2", "white-2"], "text": "By storing electricity in its body, it can shoot its bristlelike fur like a barrage of missiles."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Jolteon’s cells generate a low level of electricity. This power is amplified by the static electricity of its fur, enabling the Pokémon to drop thunderbolts. The bristling fur is made of electrically charged needles."}, {"versions": ["sun"], "text": "They send out electrical charges of about 10,000 volts. Because they are high-strung, it can be difficult to grow close to them."}, {"versions": ["moon"], "text": "When its fur stands on end, that’s a sign it’s about to give off a jolt of electricity. Take care, as sometimes lightning strikes next to it, too."}, {"versions": ["ultra-sun"], "text": "Its lungs contain an organ that creates electricity. The crackling sound of electricity can be heard when it exhales."}, {"versions": ["ultra-moon"], "text": "Its fur stands on end, becoming like needles it fires at enemies. Once they’re weakened, it finishes them off with a 10,000 volt shock."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A sensitive Pokémon that easily becomes sad or angry. Every time its mood changes, it charges power."}, {"versions": ["legends-arceus"], "text": "Bristles its fur into sharp, needlelike points when enraged. One can hear electricity crackle in its breath when it exhales."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/135.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/135.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/135.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/135.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/135.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/135.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/135.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/135.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/135.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/135.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/135.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/135.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/135.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/135.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubu