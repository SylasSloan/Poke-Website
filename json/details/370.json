{"height": 6, "weight": 87, "base_experience": 116, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Rendezvous Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["water2"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ラブカス"}, {"language": "ja-roma", "name": "Lovecus"}, {"language": "ko", "name": "사랑동이"}, {"language": "zh-hant", "name": "愛心魚"}, {"language": "fr", "name": "Lovdisc"}, {"language": "de", "name": "Liebiskus"}, {"language": "es", "name": "Luvdisc"}, {"language": "it", "name": "Luvdisc"}, {"language": "ja", "name": "ラブカス"}, {"language": "zh-hans", "name": "爱心鱼"}, {"language": "es-419", "name": "Luvdisc"}], "pokedex_entries": [{"versions": ["ruby"], "text": "LUVDISC live in shallow seas in the tropics. This heart-shaped POKéMON earned its name by swimming after loving couples it spotted in the ocean’s waves."}, {"versions": ["sapphire"], "text": "LUVDISC’s heart-shaped body is a symbol of love and romance. It is said that any couple meeting this POKéMON is promised a loving relationship that never ends."}, {"versions": ["emerald"], "text": "LUVDISC make the branches of CORSOLA their nests. There is a custom from long ago of giving a LUVDISC as a gift to express one’s feelings of love."}, {"versions": ["firered", "leafgreen"], "text": "During the spawning season, countless LUVDISC congregate at coral reefs, turning the waters pink."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It lives in warm seas. It is said that a couple finding this Pokémon will be blessed with eternal love."}, {"versions": ["heartgold", "soulsilver"], "text": "Its heart-shaped body makes it popular. In some places, you would give a LUVDISC to someone you love."}, {"versions": ["y"], "text": "During the spawning season, countless Luvdisc congregate at coral reefs, turning the waters pink."}, {"versions": ["omega-ruby"], "text": "Luvdisc live in shallow seas in the tropics. This heart-shaped Pokémon earned its name by swimming after loving couples it spotted in the ocean’s waves."}, {"versions": ["alpha-sapphire"], "text": "Luvdisc’s heart-shaped body is a symbol of love and romance. It is said that any couple meeting this Pokémon is promised a loving relationship that never ends."}, {"versions": ["sun"], "text": "If a Luvdisc is left on its own, it becomes despondent, leaving itself open to attack. That is when Pelipper snatch them up."}, {"versions": ["moon"], "text": "Loving couples have a soft spot for this Pokémon, so honeymoon hotels often release this Pokémon into their pools."}, {"versions": ["ultra-sun"], "text": "There was an era when it was overfished due to the rumor that having one of its heart-shaped scales would enable you to find a sweetheart."}, {"versions": ["ultra-moon"], "text": "Luvdisc makes its home in coral reefs in warm seas. It especially likes sleeping in the space between Corsola’s branches."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/370.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/370.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/370.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/370.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/370.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/370.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/poke