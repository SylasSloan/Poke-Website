{"height": 20, "weight": 820, "base_experience": 234, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "speed", "value": 2}], "genus": "Mystic Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["bug", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "フライゴン"}, {"language": "ja-roma", "name": "Flygon"}, {"language": "ko", "name": "플라이곤"}, {"language": "zh-hant", "name": "沙漠蜻蜓"}, {"language": "fr", "name": "Libégon"}, {"language": "de", "name": "Libelldra"}, {"language": "es", "name": "Flygon"}, {"language": "it", "name": "Flygon"}, {"language": "ja", "name": "フライゴン"}, {"language": "zh-hans", "name": "沙漠蜻蜓"}, {"language": "es-419", "name": "Flygon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "FLYGON is nicknamed “the elemental spirit of the desert.” Because its flapping wings whip up a cloud of sand, this POKéMON is always enveloped in a sandstorm while flying."}, {"versions": ["sapphire"], "text": "FLYGON whips up a sandstorm by flapping its wings. The wings create a series of notes that sound like singing. Because the “singing” is the only thing that can be heard in a sandstorm, this POKéMON is said to be the desert spirit."}, {"versions": ["emerald"], "text": "The flapping of its wings sounds like singing. To prevent detection by enemies, it hides itself by flapping up a cloud of desert sand."}, {"versions": ["firered", "leafgreen", "x"], "text": "It hides itself by kicking up desert sand with its wings. Red covers shield its eyes from sand."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It whips up sandstorms with powerful flaps of its wings. It is known as “The Desert Spirit.”"}, {"versions": ["heartgold", "soulsilver"], "text": "It is nicknamed “The Desert Spirit” because the flapping of its wings sounds like a woman singing."}, {"versions": ["black-2", "white-2", "y"], "text": "Known as “The Desert Spirit,” this Pokémon hides in the sandstorms it causes by beating its wings."}, {"versions": ["omega-ruby"], "text": "Flygon is nicknamed “the elemental spirit of the desert.” Because its flapping wings whip up a cloud of sand, this Pokémon is always enveloped in a sandstorm while flying."}, {"versions": ["alpha-sapphire"], "text": "Flygon whips up a sandstorm by flapping its wings. The wings create a series of notes that sound like singing. Because the “singing” is the only thing that can be heard in a sandstorm, this Pokémon is said to be the desert spirit."}, {"versions": ["sun"], "text": "The flapping of its wings sounds something like singing. Those lured by the sound are enveloped in a sandstorm, becoming Flygon’s prey."}, {"versions": ["moon", "sword"], "text": "This Pokémon hides in the heart of sandstorms it creates and seldom appears where people can see it."}, {"versions": ["ultra-sun"], "text": "By flapping their wings, Flygon cause sandstorms that conceal Krookodile. The team then splits the prey they catch."}, {"versions": ["ultra-moon"], "text": "People continue to have their hearts stolen by its enchanting songs and find themselves stranded in the desert."}, {"versions": ["shield"], "text": "It is nicknamed the Desert Spirit because the flapping of its wings sounds like a woman singing."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/330.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/330.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/330.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/330.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sp