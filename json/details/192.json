{"height": 8, "weight": 85, "base_experience": 149, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Sun Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キマワリ"}, {"language": "ja-roma", "name": "Kimawari"}, {"language": "ko", "name": "해루미"}, {"language": "zh-hant", "name": "向日花怪"}, {"language": "fr", "name": "Héliatronc"}, {"language": "de", "name": "Sonnflora"}, {"language": "es", "name": "Sunflora"}, {"language": "it", "name": "Sunflora"}, {"language": "ja", "name": "キマワリ"}, {"language": "zh-hans", "name": "向日花怪"}, {"language": "es-419", "name": "Sunflora"}], "pokedex_entries": [{"versions": ["gold"], "text": "It converts sun­ light into energy. In the darkness after sunset, it closes its petals and becomes still."}, {"versions": ["silver"], "text": "In the daytime, it rushes about in a hectic manner, but it comes to a com­ plete stop when the sun sets."}, {"versions": ["crystal"], "text": "As the hot season approaches, the petals on this POKéMON's face become more vivid and lively."}, {"versions": ["ruby", "sapphire"], "text": "SUNFLORA converts solar energy into nutrition. It moves around actively in the daytime when it is warm. It stops moving as soon as the sun goes down for the night."}, {"versions": ["emerald"], "text": "SUNFLORA convert solar energy into nutrition. They are highly active in the warm daytime but suddenly stop moving as soon as the sun sets."}, {"versions": ["firered", "soulsilver"], "text": "In the daytime, it rushes about in a hectic manner, but it comes to a complete stop when the sun sets."}, {"versions": ["leafgreen", "heartgold"], "text": "It converts sunlight into energy. In the darkness after sunset, it closes its petals and becomes still."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "It gets energy from warm sunlight and is known for its habit o