{"height": 15, "weight": 140, "base_experience": 145, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Land Snake Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ノコッチ"}, {"language": "ja-roma", "name": "Nokocchi"}, {"language": "ko", "name": "노고치"}, {"language": "zh-hant", "name": "土龍弟弟"}, {"language": "fr", "name": "Insolourdo"}, {"language": "de", "name": "Dummisel"}, {"language": "es", "name": "Dunsparce"}, {"language": "it", "name": "Dunsparce"}, {"language": "ja", "name": "ノコッチ"}, {"language": "zh-hans", "name": "土龙弟弟"}, {"language": "es-419", "name": "Dunsparce"}], "pokedex_entries": [{"versions": ["gold"], "text": "When spotted, this POKéMON escapes backward by furi­ ously boring into the ground with its tail."}, {"versions": ["silver"], "text": "If spotted, it es­ capes by burrowing with its tail. It can float just slightly using its wings."}, {"versions": ["crystal"], "text": "It hides deep inside caves where no light ever reaches it and remains virtually motionless there."}, {"versions": ["ruby", "sapphire"], "text": "DUNSPARCE has a drill for its tail. It uses this tail to burrow into the ground backwards. This POKéMON is known to make its nest in complex shapes deep under the ground."}, {"versions": ["emerald"], "text": "Its drill-tipped tail is used to burrow into the ground backwards. This POKéMON is known to make its nest in complex shapes deep under the ground."}, {"versions": ["firered"], "text": "If spotted, it escapes by burrowing with its tail. It can hover just slightly using its wings."}, {"versions": ["leafgreen"], "text": "When spotted, this POKéMON escapes backward by furiously boring into the ground with its tail."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "It digs into the ground with its tail and makes a mazelike nest. It can fly just a little."}, {"versions": ["heartgold", "x"], "text": "When spotted, this Pokémon escapes backward by furiously boring into the ground with its tail."}, {"versions": ["soulsilver"], "text": "If spotted, it escapes by burrowing with its tail. It can float just slightly using its wings."}, {"versions": ["black-2", "white-2"], "text": "It creates mazes in dark locations. When spotted, it flees into the ground by digging with its tail."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Dunsparce has a drill for its tail. It uses this tail to burrow into the ground backward. This Pokémon is known to make its nest in complex shapes deep under the ground."}, {"versions": ["ultra-sun"], "text": "It travels by digging through the ground. Diglett and Dunsparce share one another’s tunnels happily."}, {"versions": ["ultra-moon"], "text": "When it sees a person, it digs a hole with its tail to make its escape. If you happen to find one, consider yourself lucky."}, {"versions": ["sword"], "text": "This Pokémon’s tiny wings have some scientists saying that Dunsparce used to fly through the sky in ancient times."}, {"versions": ["shield"], "text": "The nests Dunsparce live in are mazes of tunnels. They never get lost in their own nests—they can tell where they are by the scent of the dirt."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/206.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/206.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/206.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/206.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/206.png", "shiny": "https://raw.