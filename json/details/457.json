{"height": 12, "weight": 240, "base_experience": 161, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Neon Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ネオラント"}, {"language": "ja-roma", "name": "Neolant"}, {"language": "ko", "name": "네오라이트"}, {"language": "zh-hant", "name": "霓虹魚"}, {"language": "fr", "name": "Luminéon"}, {"language": "de", "name": "Lumineon"}, {"language": "es", "name": "Lumineon"}, {"language": "it", "name": "Lumineon"}, {"language": "ja", "name": "ネオラント"}, {"language": "zh-hans", "name": "霓虹鱼"}, {"language": "es-419", "name": "Lumineon"}], "pokedex_entries": [{"versions": ["diamond", "x", "omega-ruby"], "text": "It lives on the deep-sea floor. It attracts prey by flashing the patterns on its four tail fins."}, {"versions": ["pearl", "y", "alpha-sapphire"], "text": "To avoid detection by predators, it crawls along the seafloor using the two fins on its chest."}, {"versions": ["platinum"], "text": "It crawls along the seafloor using its long front fins like legs. It competes for food with LANTURN."}, {"versions": ["heartgold", "soulsilver"], "text": "LUMINEON swimming in the darkness of the deep sea look like stars shining in the night sky."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "It crawls along the seafloor using its long front fins like legs. It competes for food with Lanturn."}, {"versions": ["sun"], "text": "With its shining light, it lures its prey close. However, the light also happens to attract ferocious fish Pokémon—its natural predators."}, {"versions": ["moon"], "text": "This deep-sea Pokémon lives at the bottom of the sea. Its fins haul it over the seabed in search of its favorite food—Starmie."}, {"versions": ["ultra-sun"], "text": "Deep down at the bottom of the ocean, prey is scarce. Lumineon get into fierce disputes with Lanturn over food."}, {"versio