{"height": 7, "weight": 10, "base_experience": 87, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Screech Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ムウマ"}, {"language": "ja-roma", "name": "Muma"}, {"language": "ko", "name": "무우마"}, {"language": "zh-hant", "name": "夢妖"}, {"language": "fr", "name": "Feuforêve"}, {"language": "de", "name": "Traunfugil"}, {"language": "es", "name": "Misdreavus"}, {"language": "it", "name": "Misdreavus"}, {"language": "ja", "name": "ムウマ"}, {"language": "zh-hans", "name": "梦妖"}, {"language": "es-419", "name": "Misdreavus"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It likes playing mischievous tricks such as screaming and wailing to startle people at night."}, {"versions": ["silver"], "text": "It loves to bite and yank people's hair from behind without warning, just to see their shocked reactions."}, {"versions": ["crystal"], "text": "It loves to watch people it's scar­ ed. It frightens them by screaming loudly or appear­ ing suddenly."}, {"versions": ["ruby", "sapphire"], "text": "MISDREAVUS frightens people with a creepy, sobbing cry. The POKéMON apparently uses its red spheres to absorb the fearful feelings of foes and turn them into nutrition."}, {"versions": ["emerald"], "text": "A MISDREAVUS frightens people with a creepy, sobbing cry. It apparently uses its red spheres to absorb the fear of foes as its nutrition."}, {"versions": ["firered", "soulsilver"], "text": "It loves to bite and yank people’s hair from behind without warning, just to see their shocked reactions."}, {"versions": ["diamond"], "text": "It loves to sneak up on people late at night, then startle them with its shrieklike cry."}, {"versions": ["pearl", "x"], "text": "It gets nourishment from fear that it absorbs into its red orbs. In daytime, it sleeps in darkness."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "A Pokémon that startles people in the middle of the night. It gathers fear as its energy."}, {"versions": ["heartgold", "y"], "text": "It likes playing mischievous tricks, such as screaming and wailing to startle people at night."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Misdreavus frightens people with a creepy, sobbing cry. The Pokémon apparently uses its red spheres to absorb the fearful feelings of foes and turn them into nutrition."}, {"versions": ["sun"], "text": "It will use any means necessary to frighten people and absorb their life energy. It practices constantly to hone its skill in causing fear."}, {"versions": ["moon"], "text": "If you hear a sobbing sound emanating from a vacant room, it’s undoubtedly a bit of mischief from Misdreavus."}, {"versions": ["ultra-sun"], "text": "What gives meaning to its life is surprising others. If you set your ear against the red orbs around its neck, you can hear shrieking."}, {"versions": ["ultra-moon"], "text": "What makes it happy is imitating the voices of weeping people and scaring everyone. It doesn’t deal well with folks who aren’t easily frightened."}, {"versions": ["legends-arceus"], "text": "It conceals itself in darkness, sending chills up travelers' spines with its childlike weeping. As it observes the frightened travelers with glee, the red orbs upon its chest let off an eerie light."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/200.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/200.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/200.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/sh