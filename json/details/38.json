{"height": 11, "weight": 199, "base_experience": 177, "ev_yield": [{"stat": "special-defense", "value": 1}, {"stat": "speed", "value": 1}], "genus": "Fox Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "キュウコン"}, {"language": "ja-roma", "name": "Kyukon"}, {"language": "ko", "name": "나인테일"}, {"language": "zh-hant", "name": "九尾"}, {"language": "fr", "name": "Feunard"}, {"language": "de", "name": "Vulnona"}, {"language": "es", "name": "Ninetales"}, {"language": "it", "name": "Ninetales"}, {"language": "ja", "name": "キュウコン"}, {"language": "zh-hans", "name": "九尾"}, {"language": "es-419", "name": "Ninetales"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Very smart and very vengeful. Grabbing one of its many tails could result in a 1000-year curse."}, {"versions": ["yellow"], "text": "According to an enduring legend, 9 noble saints were united and reincarnated as this POKéMON."}, {"versions": ["gold", "heartgold"], "text": "Some legends claim that each of its nine tails has its own unique type of special mystical power."}, {"versions": ["silver", "soulsilver"], "text": "Its nine beautiful tails are filled with a wondrous energy that could keep it alive for 1,000 years."}, {"versions": ["crystal"], "text": "It is said to live a thousand years, and each of its tails is loaded with supernatural powers."}, {"versions": ["ruby"], "text": "NINETALES casts a sinister light from its bright red eyes to gain total control over its foe’s mind. This POKéMON is said to live for a thousand years."}, {"versions": ["sapphire"], "text": "Legend has it that NINETALES came into being when nine wizards possessing sacred powers merged into one. This POKéMON is highly intelligent - it can understand human speech."}, {"versions": ["emerald"], "text": "It has long been said that each of the nine tails embody an enchanted power. A long-lived NINETALES will have fur that shines like gold."}, {"versions": ["firered", "x"], "text": "It has nine long tails and fur that gleams gold. It is said to live for 1,000 years."}, {"versions": ["leafgreen", "y", "shield"], "text": "Very smart and very vengeful. Grabbing one of its many tails could result in a 1,000-year curse."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Its nine tails are said to be imbued with a mystic power. It can live for a thousand years."}, {"versions": ["black-2", "white-2"], "text": "Each of its nine tails is imbued with supernatural power, and it can live for a thousand years."}, {"versions": ["omega-ruby"], "text": "Ninetales casts a sinister light from its bright red eyes to gain total control over its foe’s mind. This Pokémon is said to live for a thousand years."}, {"versions": ["alpha-sapphire"], "text": "Legend has it that Ninetales came into being when nine wizards possessing sacred powers merged into one. This Pokémon is highly intelligent—it can understand human speech."}, {"versions": ["sun"], "text": "Legend has it that this mystical Pokémon was formed when nine saints coalesced into one."}, {"versions": ["moon"], "text": "Said to live for a thousand years, this Pokémon uses its supernatural abilities to manipulate fire. It can burn its prey to a crisp as it pleases."}, {"versions": ["ultra-sun"], "text": "It is vindictive and relentless by nature. Those who cross it even once will be cursed for a thousand years, along with their descendants."}, {"versions": ["ultra-moon"], "text": "The flickering flames it spews from its mouth leave its opponents hypnotized. Then, this extremely intelligent Pokémon attacks."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "According to an enduring legend, nine noble saints were united and reincarnated as this Pokémon."}, {"versions": ["sword"], "text": "It is said to live 1,000 years, and each of its tails is loaded with supernatural powers."}, {"versions": [