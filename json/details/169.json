{"height": 18, "weight": 750, "base_experience": 241, "ev_yield": [{"stat": "speed", "value": 3}], "genus": "Bat Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "クロバット"}, {"language": "ja-roma", "name": "Crobat"}, {"language": "ko", "name": "크로뱃"}, {"language": "zh-hant", "name": "叉字蝠"}, {"language": "fr", "name": "Nostenfer"}, {"language": "de", "name": "Iksbat"}, {"language": "es", "name": "Crobat"}, {"language": "it", "name": "Crobat"}, {"language": "ja", "name": "クロバット"}, {"language": "zh-hans", "name": "叉字蝠"}, {"language": "es-419", "name": "Crobat"}], "pokedex_entries": [{"versions": ["y", "black-2", "white-2"], "text": "Having four wings allows it to fly more quickly and quietly so it can sneak up on prey without its noticing."}, {"versions": ["gold"], "text": "It flies so si­ lently through the dark on its four wings that it may not be noticed even when nearby."}, {"versions": ["silver", "firered", "soulsilver"], "text": "The development of wings on its legs enables it to fly fast but also makes it tough to stop and rest."}, {"versions": ["crystal"], "text": "As a result of its pursuit of faster, yet more silent flight, a new set of wings grew on its hind legs."}, {"versions": ["ruby"], "text": "If this POKéMON is flying by fluttering only a pair of wings on either the forelegs or hind legs, it’s proof that CROBAT has been flying a long distance. It switches the wings it uses if it is tired."}, {"versions": ["sapphire"], "text": "CROBAT sneaks up on its intended prey using wings that barely make a sound. This POKéMON rests by hanging on a tree branch with its rear legs that serve as wings."}, {"versions": ["emerald"], "text": "Over the course of evolution, its hind legs turned into wings. By alternately resting its front and rear wings, it can fly all day without having to stop."}, {"versions": ["leafgreen", "heartgold", "x"], "text": "It flies so silently through the dark on its four wings that it may not be noticed even when nearby."}, {"versions": ["diamond"], "text": "Having four wings enables it to fly faster and more quietly. It turns active when the night comes."}, {"versions": ["pearl"], "text": "A Pokémon that gained vastly enhanced flying performance by having its legs turn into wings."}, {"versions": ["platinum", "black", "white"], "text": "The transformation of its legs into wings made it better at flying, but more clumsy at walking."}, {"versions": ["omega-ruby"], "text": "If this Pokémon is flying by fluttering only a pair of wings on either the forelegs or hind legs, it’s proof that Crobat has been flying a long distance. It switches the wings it uses if it is tired."}, {"versions": ["alpha-sapphire"], "text": "Crobat sneaks up on its intended prey using wings that barely make a sound. This Pokémon rests by hanging on a tree branch with its rear legs that serve as wings."}, {"versions": ["sun"], "text": "Both its legs became wings, and as a result, it can’t move well on the ground. All it can do is crawl around."}, {"versions": ["moon"], "text": "Silent and swift in its four-winged flight, it bites down on its prey before they realize what’s happening. In a heartbeat, it drains their blood."}, {"versions": ["ultra-sun"], "text": "Its fangs are so sharp, if it bites you in the dark and sucks your blood, you won’t notice any pain or realize you’ve been bitten."}, {"versions": ["ultra-moon"], "text": "It feeds on the blood of living people and Pokémon. If it can’t drink any blood for even a short while, it becomes weak and unable to fly."}, {"versions": ["sword"], "text": "Both of its legs have turned into wings. Without a sound, Crobat flies swiftly toward its prey and sinks its fangs into the nape of its target’s neck."}, {"versions": ["shield"], "text": "This Pokémon flaps its four wings skillfully. Crobat can fly through cramped caves without needing to slow down."}, {"versions": ["legends-arceus"], "text": "Its hind limbs have become another set of wings. Crobat expertly maneuvers its four wings to dart in exquisite fashion through even the most confined caves without losing any speed."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/169.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/169.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/169.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/169.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/169.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/169.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/169.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/169.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/169.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/169.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/169.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/169.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercont