{"height": 5, "weight": 120, "base_experience": 66, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Angler Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "チョンチー"}, {"language": "ja-roma", "name": "Chonchie"}, {"language": "ko", "name": "초라기"}, {"language": "zh-hant", "name": "燈籠魚"}, {"language": "fr", "name": "Loupio"}, {"language": "de", "name": "Lampi"}, {"language": "es", "name": "Chinchou"}, {"language": "it", "name": "Chinchou"}, {"language": "ja", "name": "チョンチー"}, {"language": "zh-hans", "name": "灯笼鱼"}, {"language": "es-419", "name": "Chinchou"}], "pokedex_entries": [{"versions": ["gold"], "text": "It shoots positive and negative elec­ tricity between the tips of its two antennae and zaps its enemies."}, {"versions": ["silver"], "text": "On the dark ocean floor, its only means of communi­ cation is its constantly flash­ ing lights."}, {"versions": ["crystal"], "text": "Its antennae, whi­ ch evolved from a fin, have both po­ sitive and neg­ ative charges flo­ wing through them."}, {"versions": ["ruby"], "text": "CHINCHOU lets loose positive and negative electrical charges from its two antennas to make its prey faint. This POKéMON flashes its electric lights to exchange signals with others."}, {"versions": ["sapphire"], "text": "CHINCHOU’s two antennas are filled with cells that generate strong electricity. This POKéMON’s cells create so much electrical power, it even makes itself tingle slightly."}, {"versions": ["emerald"], "text": "When it senses danger, it discharges positive and negative electricity from its two antennae. It lives in depths beyond sunlight’s reach."}, {"versions": ["firered", "soulsilver", "x", "shield"], "text": "On the dark ocean floor, its only means of communication is its constantly flashing lights."}, {"versions": ["leafgreen", "heartgold", "y"], "text": "It shoots positive and negative electricity between the tips of its two antennae and zaps its enemies."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It discharges positive and negative electricity from its antenna tips to shock its foes."}, {"versions": ["omega-ruby"], "text": "Chinchou lets loose positive and negative electrical charges from its two antennas to make its prey faint. This Pokémon flashes its electric lights to exchange signals with others."}, {"versions": ["alpha-sapphire"], "text": "Chinchou’s two antennas are filled with cells that generate strong electricity. This Pokémon’s cells create so much electrical power, it even makes itself tingle slightly."}, {"versions": ["sun"], "text": "Its two antennae were originally fins. It discharges electricity to stun its prey before attacking."}, {"versions": ["moon"], "text": "It lives in the depths beyond the reach of sunlight. It flashes lights on its antennae to communicate with others of its kind."}, {"versions": ["ultra-sun"], "text": "Its two antennae glow softly to lure in prey, making it a useful Pokémon for night fishing."}, {"versions": ["ultra-moon"], "text": "Chinchou blink their shining antennae at one another to claim their respective turf."}, {"versions": ["sword"], "text": "Its antennae, which evolved from a fin, have both positive and negative charges flowing through them."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/170.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/170.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/170.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/170.png"}, "silver": {"normal": "https://raw.githubusercontent