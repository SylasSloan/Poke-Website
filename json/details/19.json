{"height": 3, "weight": 35, "base_experience": 51, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Mouse Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コラッタ"}, {"language": "ja-roma", "name": "Koratta"}, {"language": "ko", "name": "꼬렛"}, {"language": "zh-hant", "name": "小拉達"}, {"language": "fr", "name": "Rattata"}, {"language": "de", "name": "Rattfratz"}, {"language": "es", "name": "Rattata"}, {"language": "it", "name": "Rattata"}, {"language": "ja", "name": "コラッタ"}, {"language": "zh-hans", "name": "小拉达"}, {"language": "es-419", "name": "Rattata"}], "pokedex_entries": [{"versions": ["silver"], "text": "Living wherever there is food available, it ceaselessly scav­ enges for edibles the entire day."}, {"versions": ["red", "blue", "leafgreen"], "text": "Bites anything when it attacks. Small and very quick, it is a common sight in many places."}, {"versions": ["yellow"], "text": "Will chew on any­ thing with its fangs. If you see one, it is certain that 40 more live in the area."}, {"versions": ["gold", "heartgold"], "text": "It eats anything. Wherever food is available, it will settle down and produce offspring continuously."}, {"versions": ["crystal"], "text": "This POKéMON's impressive vital­ ity allows it to live anywhere. It also multiplies very quickly."}, {"versions": ["ruby", "sapphire"], "text": "RATTATA is cautious in the extreme. Even while it is asleep, it constantly listens by moving its ears around. It is not picky about where it lives - it will make its nest anywhere."}, {"versions": ["emerald"], "text": "A RATTATA is cautious in the extreme. Even while it is asleep, it constantly moves its ears and listens for danger. It will make its nest anywhere."}, {"versions": ["firered", "y"], "text": "Its fangs are long and very sharp. They grow continuously, so it gnaws on hard things to whittle them down."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "Cautious in the extreme, its hardy vitality lets it live in any kind of environment."}, {"versions": ["soulsilver", "x"], "text": "Living wherever there is food available, it ceaselessly scavenges for edibles the entire day."}, {"versions": ["black-2", "white-2"], "text": "It searches for food all day. It gnaws on hard objects to wear down its fangs, which grow constantly during its lifetime."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Rattata is cautious in the extreme. Even while it is asleep, it constantly listens by moving its ears around. It is not picky about where it lives—it will make its nest anywhere."}, {"versions": ["sun"], "text": "Its incisors continue growing until its death. If its Trainer doesn’t offer it a file to gnaw on, it will gnaw on door frames, table legs, and so on."}, {"versions": ["moon"], "text": "With their strong capacity for survival, they can live in dirty places without concern. Left unchecked, their numbers multiply rapidly."}, {"versions": ["ultra-sun"], "text": "Its incisors grow continuously throughout its life. If its incisors get too long, this Pokémon becomes unable to eat, and it starves to death."}, {"versions": ["ultra-moon"], "text": "This Pokémon is common but hazardous. Its sharp incisors can easily cut right through hard wood."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Will chew on anything with its fangs. If you see one, you can be certain that 40 more live in the area."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/19.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/19.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/ve