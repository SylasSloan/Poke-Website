{"height": 12, "weight": 1800, "base_experience": 241, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Magnet Area Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ジバコイル"}, {"language": "ja-roma", "name": "Jibacoil"}, {"language": "ko", "name": "자포코일"}, {"language": "zh-hant", "name": "自爆磁怪"}, {"language": "fr", "name": "Magnézone"}, {"language": "de", "name": "Magnezone"}, {"language": "es", "name": "Magnezone"}, {"language": "it", "name": "Magnezone"}, {"language": "ja", "name": "ジバコイル"}, {"language": "zh-hans", "name": "自爆磁怪"}, {"language": "es-419", "name": "Magnezone"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "y", "alpha-sapphire"], "text": "It evolved from exposure to a special magnetic field. Three units generate magnetism."}, {"versions": ["platinum"], "text": "A group tried to use scientific means to make MAGNEZONE evolve, but their efforts ended in failure."}, {"versions": ["heartgold", "soulsilver"], "text": "Exposure to a special magnetic field changed MAGNETON’s molecular structure, turning it into MAGNEZONE."}, {"versions": ["black", "white"], "text": "A group tried to use scientific means to make Magnezone evolve, but their efforts ended in failure."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "Sometimes the magnetism emitted by Magnezone is too strong, making them attract each other so they cannot move."}, {"versions": ["sun"], "text": "Three units generate magnetism. There have been many mistaken reports of UFO sightings when Magnezone flies through the night sky."}, {"versions": ["moon"], "text": "As it zooms through the sky, this Pokémon seems to be receiving signals of unknown origin, while transmitting signals of unknown purpose."}, {"versions": ["ultra-sun"], "text": "It uses radar to monitor its territory. Intruders are quickly disposed of with a hyper beam."}, {"versions": ["ultra-moon"], "text": "There are still people who believe that this Pokémon came from outer space. It emanates a powerful magnetic field."}, {"versions": ["sword"], "text": "Some say that Magnezone receives signals from space via the antenna on its head and that it’s being controlled by some mysterious being."}, {"versions": ["shield"], "text": "It’s thought that a special magnetic field changed the molecular structure of this Pokémon’s body, and that’s what caused the Pokémon’s evolution."}, {"versions": ["legends-arceus"], "text": "I theorize that a special magnetic field influenced this Pokémon, changing its molecular structure and causing it to evolve. It emits strange radio waves toward space from its antenna."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/462.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/462.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/462.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/462.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/462.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/462.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/462.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/462.png", "