{"height": 6, "weight": 952, "base_experience": 60, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Iron Ball Pokémon", "capture_rate": 3, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ダンバル"}, {"language": "ja-roma", "name": "Dumbber"}, {"language": "ko", "name": "메탕"}, {"language": "zh-hant", "name": "鐵啞鈴"}, {"language": "fr", "name": "Terhal"}, {"language": "de", "name": "Tanhel"}, {"language": "es", "name": "Beldum"}, {"language": "it", "name": "Beldum"}, {"language": "ja", "name": "ダンバル"}, {"language": "zh-hans", "name": "铁哑铃"}, {"language": "es-419", "name": "Beldum"}], "pokedex_entries": [{"versions": ["platinum", "diamond", "pearl", "black", "white", "y"], "text": "It converses with others by using magnetic pulses. In a swarm, they move in perfect unison."}, {"versions": ["ruby"], "text": "Instead of blood, a powerful magnetic force courses throughout BELDUM’s body. This POKéMON communicates with others by sending controlled pulses of magnetism."}, {"versions": ["sapphire"], "text": "BELDUM keeps itself floating by generating a magnetic force that repels earth’s natural magnetism. When it sleeps, this POKéMON anchors itself to a cliff using the hooks on its rear."}, {"versions": ["emerald"], "text": "When BELDUM gather in a swarm, they move in perfect unison as if they were but one POKéMON. They communicate with each other using brain waves."}, {"versions": ["firered", "leafgreen"], "text": "It uses magnetic waves to converse with its kind. All the cells in its body are magnetic."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "The magnetic force generated by its body repels the ground’s natural magnetism, letting it float."}, {"versions": ["black-2", "white-2"], "text": "Its cells are all magnetic, and it communicates with others by using magnetic pulses."}, {"versions": ["omega-ruby"], "text": "Instead of blood, a powerful magnetic force courses throughout Beldum’s body. This Pokémon communicates with others by sending controlled pulses of magnetism."}, {"versions": ["alpha-sapphire"], "text": "Beldum keeps itself floating by generating a magnetic force that repels earth’s natural magnetism. When it sleeps, this Pokémon anchors itself to a cliff using the hooks on its rear."}, {"versions": ["sun"], "text": "Its cells are all magnets. It uses magnetism to communicate with others of its kind."}, {"versions": ["moon"], "text": "With magnetic traction, it pulls its opponents in close. When they’re in range, it slashes them with its rear claws."}, {"versions": ["ultra-sun"], "text": "Instead of blood, magnetism flows through its body. When it’s feeling bad, try giving it a magnet."}, {"versions": ["ultra-moon"], "text": "If you anger it, it will do more than rampage. It will also burst out strong magnetism, causing nearby machines to break."}, {"versions": ["sword"], "text": "From its rear, Beldum emits a magnetic force that rapidly pulls opponents in. They get skewered on Beldum’s sharp claws."}, {"versions": ["shield"], "text": "The cells in this Pokémon’s body are composed of magnetic material. Instead of blood, magnetic forces flow through Beldum’s body."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/374.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/374.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/374.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/374.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-p