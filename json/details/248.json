{"height": 20, "weight": 2020, "base_experience": 270, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Armor Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "バンギラス"}, {"language": "ja-roma", "name": "Bangiras"}, {"language": "ko", "name": "마기라스"}, {"language": "zh-hant", "name": "班基拉斯"}, {"language": "fr", "name": "Tyranocif"}, {"language": "de", "name": "Despotar"}, {"language": "es", "name": "Tyranitar"}, {"language": "it", "name": "Tyranitar"}, {"language": "ja", "name": "バンギラス"}, {"language": "zh-hans", "name": "班基拉斯"}, {"language": "es-419", "name": "Tyranitar"}], "pokedex_entries": [{"versions": ["gold"], "text": "Its body can't be harmed by any sort of attack, so it is very eager to make challenges against enemies."}, {"versions": ["silver", "soulsilver"], "text": "Extremely strong, it can change the landscape. It has an insolent nature that makes it not care about others."}, {"versions": ["crystal"], "text": "In just one of its mighty hands, it has the power to make the ground shake and moun­ tains crumble."}, {"versions": ["ruby", "sapphire"], "text": "TYRANITAR is so overwhelmingly powerful, it can bring down a whole mountain to make its nest. This POKéMON wanders about in mountains seeking new opponents to fight."}, {"versions": ["emerald"], "text": "A TYRANITAR is so overwhelmingly powerful, it can bring down a whole mountain to make its nest. It roams in mountains seeking new opponents to fight."}, {"versions": ["firered", "leafgreen", "heartgold", "sword"], "text": "Its body can’t be harmed by any sort of attack, so it is very eager to make challenges against enemies."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "If it rampages, it knocks down mountains and buries rivers. Maps must be redrawn afterward."}, {"versions": ["black-2", "white-2", "shield"], "text": "The quakes caused when it walks make even great mountains crumble and change the surrounding terrain."}, {"versions": ["x"], "text": "In just one of its mighty hands, it has the power to make the ground shake and mountains crumble."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Tyranitar is so overwhelmingly powerful, it can bring down a whole mountain to make its nest. This Pokémon wanders about in mountains seeking new opponents to fight."}, {"versions": ["ultra-sun"], "text": "It wanders through the mountains seeking opponents to fight. If it finds an opponent that’s not worthy, Tyranitar ignores it and wanders on."}, {"versions": ["ultra-moon"], "text": "This Pokémon is a mobile disaster, leaving mountains crumbled and houses destroyed in its wake."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/248.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/248.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/248.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/248.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/248.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/248.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/248.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/248.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/genera