{"height": 40, "weight": 165, "base_experience": 147, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Dragon Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハクリュー"}, {"language": "ja-roma", "name": "Hakuryu"}, {"language": "ko", "name": "신뇽"}, {"language": "zh-hant", "name": "哈克龍"}, {"language": "fr", "name": "Draco"}, {"language": "de", "name": "Dragonir"}, {"language": "es", "name": "Dragonair"}, {"language": "it", "name": "Dragonair"}, {"language": "ja", "name": "ハクリュー"}, {"language": "zh-hans", "name": "哈克龙"}, {"language": "es-419", "name": "Dragonair"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A mystical POKéMON that exudes a gentle aura. Has the ability to change climate conditions."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "According to a witness, its body was surrounded by a strange aura that gave it a mystical look."}, {"versions": ["gold", "heartgold"], "text": "They say that if it emits an aura from its whole body, the weather will begin to change instantly."}, {"versions": ["silver"], "text": "Its crystalline orbs appear to give this POKéMON the power to freely control the weather."}, {"versions": ["crystal"], "text": "It is called the divine POKéMON. When its entire body brightens slightly, the weather changes."}, {"versions": ["ruby", "sapphire"], "text": "DRAGONAIR stores an enormous amount of energy inside its body. It is said to alter weather conditions in its vicinity by discharging energy from the crystals on its neck and tail."}, {"versions": ["emerald"], "text": "A DRAGONAIR stores an enormous amount of energy inside its body. It is said to alter the weather around it by loosing energy from the crystals on its neck and tail."}, {"versions": ["firered"], "text": "It is said to live in seas and lakes. Even though it has no wings, it has been seen flying occasionally."}, {"versions": ["leafgreen"], "text": "A mystical POKéMON that exudes a gentle aura. It is said to have the ability to change the weather."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "If its body takes on an aura, the weather changes instantly. It is said to live in seas and lakes."}, {"versions": ["soulsilver", "x"], "text": "Its crystalline orbs appear to give this Pokémon the power to freely control the weather."}, {"versions": ["y"], "text": "A mystical Pokémon that exudes a gentle aura. It is said to have the ability to change the weather."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Dragonair stores an enormous amount of energy inside its body. It is said to alter weather conditions in its vicinity by discharging energy from the crystals on its neck and tail."}, {"versions": ["sun"], "text": "It has long been thought that its crystalline orbs are imbued with the power to control the weather."}, {"versions": ["moon"], "text": "From time immemorial, it has been venerated by agricultural peoples as an entity able to control the weather."}, {"versions": ["ultra-sun"], "text": "Lakes where Dragonair live are filled with offerings from people, because they believe this Pokémon is able to control the weather."}, {"versions": ["ultra-moon"], "text": "Some say that if you see it at the start of the year, flying through the sky and twisting its body, you’ll be healthy all year long."}, {"versions": ["sword"], "text": "This Pokémon lives in pristine oceans and lakes. It can control the weather, and it uses this power to fly into the sky, riding on the wind."}, {"versions": ["shield"], "text": "This Pokémon gathers power in the orbs on its tail and controls the weather. When enshrouded by an aura, Dragonair has a mystical appearance."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generati