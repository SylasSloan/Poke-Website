{"height": 2, "weight": 20, "base_experience": 38, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Polka Dot Pokémon", "capture_rate": 150, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["no-eggs"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ルリリ"}, {"language": "ja-roma", "name": "Ruriri"}, {"language": "ko", "name": "루리리"}, {"language": "zh-hant", "name": "露力麗"}, {"language": "fr", "name": "Azurill"}, {"language": "de", "name": "Azurill"}, {"language": "es", "name": "Azurill"}, {"language": "it", "name": "Azurill"}, {"language": "ja", "name": "ルリリ"}, {"language": "zh-hans", "name": "露力丽"}, {"language": "es-419", "name": "Azurill"}], "pokedex_entries": [{"versions": ["ruby"], "text": "AZURILL spins its tail as if it were a lasso, then hurls it far. The momentum of the throw sends its body flying, too. Using this unique action, one of these POKéMON managed to hurl itself a record 33 feet."}, {"versions": ["sapphire"], "text": "AZURILL’s tail is large and bouncy. It is packed full of the nutrients this POKéMON needs to grow. AZURILL can be seen bouncing and playing on its big, rubbery tail."}, {"versions": ["emerald"], "text": "Its tail, which is packed with nutrition, is very bouncy like a rubber ball. On sunny days they gather at the edge of water and splash about for fun."}, {"versions": ["firered", "leafgreen"], "text": "It battles by flinging around its tail, which is bigger than its body. The tail is a flotation device in water."}, {"versions": ["diamond", "x"], "text": "A Pokémon that lives by water. It moves quickly on land by bouncing on its big tail."}, {"versions": ["pearl"], "text": "Its tail is filled with nutrients necessary for growth. It plays by bouncing on its tail."}, {"versions": ["platinum", "black", "white"], "text": "Its tail bounces like a rubber ball. It flings that tail around to fight opponents bigger than itself."}, {"versions": ["heartgold", "soulsilver"], "text": "Its tail is packed 