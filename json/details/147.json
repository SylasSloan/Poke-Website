{"height": 18, "weight": 33, "base_experience": 60, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Dragon Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ミニリュウ"}, {"language": "ja-roma", "name": "Miniryu"}, {"language": "ko", "name": "미뇽"}, {"language": "zh-hant", "name": "迷你龍"}, {"language": "fr", "name": "Minidraco"}, {"language": "de", "name": "Dratini"}, {"language": "es", "name": "Dratini"}, {"language": "it", "name": "Dratini"}, {"language": "ja", "name": "ミニリュウ"}, {"language": "zh-hans", "name": "迷你龙"}, {"language": "es-419", "name": "Dratini"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Long considered a mythical POKéMON until recently when a small colony was found living underwater."}, {"versions": ["yellow"], "text": "The existence of this mythical POKéMON was only recently confirmed by a fisherman who caught one."}, {"versions": ["gold", "heartgold"], "text": "It is born large to start with. It repeatedly sheds its skin as it steadily grows longer."}, {"versions": ["silver"], "text": "This POKéMON is full of life ener­ gy. It continually sheds its skin and grows steadily larger."}, {"versions": ["crystal"], "text": "It sheds many lay­ ers of skin as it grows larger. Dur­ ing this process, it is protected by a rapid waterfall."}, {"versions": ["ruby", "sapphire"], "text": "DRATINI continually molts and sloughs off its old skin. It does so because the life energy within its body steadily builds to reach uncontrollable levels."}, {"versions": ["emerald"], "text": "A DRATINI continually molts and sloughs off its old skin. It does so because the life energy within its body steadily builds to reach uncontrollable levels."}, {"versions": ["firered"], "text": "Even the young can exceed 6.5 feet in length. It grows larger by repeatedly shedding skin."}, {"versions": ["leafgreen"], "text": "Long considered a mythical POKéMON until recently, when a small colony was found living underwater."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It is called the “Mirage Pokémon” because so few have seen it. Its shed skin has been found."}, {"versions": ["soulsilver", "y"], "text": "This Pokémon is full of life energy. It continually sheds its skin and grows steadily larger."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Dratini continually molts and sloughs off its old skin. It does so because the life energy within its body steadily builds to reach uncontrollable levels."}, {"versions": ["sun"], "text": "It grows by molting repeatedly. Boots made from the tanned cast-off skin are a super luxury item."}, {"versions": ["moon"], "text": "After a 10-hour struggle, a fisherman was able to pull one up and confirm its existence."}, {"versions": ["ultra-sun"], "text": "It’s still weak, so it lurks on the floor of bodies of water, eating whatever food sinks down and living a quiet life."}, {"versions": ["ultra-moon"], "text": "It sheds its skin—almost on a daily basis—and grows larger. Its skin is soft just after it’s been shed."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Long thought to be a myth, this Pokémon’s existence was only recently confirmed by a fisherman who caught one."}, {"versions": ["sword"], "text": "Dratini dwells near bodies of rapidly flowing water, such as the plunge pools of waterfalls. As it grows, Dratini will shed its skin many times."}, {"versions": ["shield"], "text": "This Pokémon was long considered to be no more than a myth. The small lump on a Dratini’s forehead is actually a horn that’s still coming in."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/147.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/spr