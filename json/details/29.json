{"height": 4, "weight": 70, "base_experience": 55, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Poison Pin Pokémon", "capture_rate": 235, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ニドラン♀"}, {"language": "ja-roma", "name": "Nidoran♀"}, {"language": "ko", "name": "니드런♀"}, {"language": "zh-hant", "name": "尼多蘭"}, {"language": "fr", "name": "Nidoran♀"}, {"language": "de", "name": "Nidoran♀"}, {"language": "es", "name": "Nidoran♀"}, {"language": "it", "name": "Nidoran♀"}, {"language": "ja", "name": "ニドラン♀"}, {"language": "zh-hans", "name": "尼多兰"}, {"language": "es-419", "name": "Nidoran♀"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Although small, its venomous barbs render this POKéMON dangerous. The female has smaller horns."}, {"versions": ["yellow"], "text": "A mild-mannered POKéMON that does not like to fight. Beware, its small horns secrete venom."}, {"versions": ["gold"], "text": "The poison hidden in its small horn is extremely po­ tent. Even a tiny scratch can have fatal results."}, {"versions": ["silver"], "text": "Although not very combative, it will torment its foes with poison spikes if it is threat­ ened in any way."}, {"versions": ["crystal"], "text": "Small and very docile, it pro­ tects itself with its small, poison­ ous horn when attacked."}, {"versions": ["ruby", "sapphire"], "text": "NIDORAN has barbs that secrete a powerful poison. They are thought to have developed as protection for this small-bodied POKéMON. When enraged, it releases a horrible toxin from its horn."}, {"versions": ["emerald"], "text": "Its highly toxic barbs are thought to have developed as protection for this small- bodied POKéMON. When enraged, it releases a horrible toxin from its horn."}, {"versions": ["firered"], "text": "Though small, it must be treated with caution because of its powerfully toxic barbs. The female has smaller horns."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "While it does not prefer to fight, even one drop of the poison it secretes from barbs can be fatal."}, {"versions": ["heartgold"], "text": "The poison hidden in its small horn is extremely potent. Even a tiny scratch can have fatal results."}, {"versions": ["soulsilver"], "text": "Although not very combative, it will torment its foes with poison spikes if it is threatened in any way."}, {"versions": ["x"], "text": "Although small, its venomous barbs render this Pokémon dangerous. The female has smaller horns."}, {"versions": ["y"], "text": "Small and very docile, it protects itself with its small, poisonous horn when attacked."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Nidoran♀ has barbs that secrete a powerful poison. They are thought to have developed as protection for this small-bodied Pokémon. When enraged, it releases a horrible toxin from its horn."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A mild-mannered Pokémon that does not like to fight. Beware—its small horn secretes venom."}, {"versions": ["sword"], "text": "Females are more sensitive to smells than males. While foraging, they’ll use their whiskers to check wind direction and stay downwind of predators."}, {"versions": ["shield"], "text": "It uses its hard incisor teeth to crush and eat berries. The tip of a female Nidoran’s horn is a bit more rounded than the tip of a male’s horn."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/29.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/29.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i