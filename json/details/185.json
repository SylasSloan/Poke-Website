{"height": 12, "weight": 380, "base_experience": 144, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Imitation Pokémon", "capture_rate": 65, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ウソッキー"}, {"language": "ja-roma", "name": "Usokkie"}, {"language": "ko", "name": "꼬지모"}, {"language": "zh-hant", "name": "樹才怪"}, {"language": "fr", "name": "Simularbre"}, {"language": "de", "name": "Mogelbaum"}, {"language": "es", "name": "Sudowoodo"}, {"language": "it", "name": "Sudowoodo"}, {"language": "ja", "name": "ウソッキー"}, {"language": "zh-hans", "name": "树才怪"}, {"language": "es-419", "name": "Sudowoodo"}], "pokedex_entries": [{"versions": ["diamond"], "text": "Despite appearing to be a tree, its body is closer to rocks and stones. It is very weak to water."}, {"versions": ["gold"], "text": "Although it always pretends to be a tree, its composi­ tion appears to be closer to a rock than a plant."}, {"versions": ["silver"], "text": "It disguises it­ self as a tree to avoid attack. It hates water, so it will disappear if it starts raining."}, {"versions": ["crystal"], "text": "If a tree branch shakes when there is no wind, it's a SUDOWOODO, not a tree. It hides from the rain."}, {"versions": ["ruby", "sapphire"], "text": "SUDOWOODO camouflages itself as a tree to avoid being attacked by enemies. However, because the forelegs remain green throughout the year, the POKéMON is easily identified as a fake during the winter."}, {"versions": ["emerald"], "text": "It mimics a tree to avoid being attacked by enemies. But since its forelegs remain green throughout the year, it is easily identified as a fake in the winter."}, {"versions": ["firered", "soulsilver", "y", "shield"], "text": "It disguises itself as a tree to avoid attack. It hates water, so it will disappear if it starts raining."}, {"versions": ["leafgreen"], "text": "Although it always pretends to be a tree, its composition appears to be closer to a rock than a plant."}, {"versions": ["pearl"], "text": "It stands along paths pretending to be a tree. If it starts raining, it seems to disappear."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "To avoid being attacked, it does nothing but mimic a tree. It hates water and flees from rain."}, {"versions": ["heartgold", "x"], "text": "Although it always pretends to be a tree, its composition appears more similar to rock than to vegetation."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Sudowoodo camouflages itself as a tree to avoid being attacked by enemies. However, because its hands remain green throughout the year, the Pokémon is easily identified as a fake during the winter."}, {"versions": ["sun"], "text": "To avoid attack, it mimics a tree. It will run off if splashed with water, which it hates."}, {"versions": ["moon"], "text": "Apparently, the larger the green parts of this Pokémon, the more collectors value it. It’s a particular favorite among elderly people."}, {"versions": ["ultra-sun"], "text": "It’s so popular with the elderly that there’s a magazine devoted to this Pokémon. Fans obsess over the particular length and angle of its arms."}, {"versions": ["ultra-moon"], "text": "The result of its holding the same pose all the time is arms that have become supple yet strong."}, {"versions": ["sword"], "text": "If a tree branch shakes when there is no wind, it’s a Sudowoodo, not a tree. It hides from the rain."}, {"versions": ["legends-arceus"], "text": "Though it pretends to be a tree, it fails to fool even children. To the touch, its body feels more like rock than tree bark. Sudowoodo's extreme aversion to water merits special note."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/185.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/