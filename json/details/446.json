{"height": 6, "weight": 1050, "base_experience": 78, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Big Eater Pokémon", "capture_rate": 50, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ゴンベ"}, {"language": "ja-roma", "name": "Gonbe"}, {"language": "ko", "name": "먹고자"}, {"language": "zh-hant", "name": "小卡比獸"}, {"language": "fr", "name": "Goinfrex"}, {"language": "de", "name": "Mampfaxo"}, {"language": "es", "name": "Munchlax"}, {"language": "it", "name": "Munchlax"}, {"language": "ja", "name": "ゴンベ"}, {"language": "zh-hans", "name": "小卡比兽"}, {"language": "es-419", "name": "Munchlax"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It wolfs down its weight in food once a day, swallowing food whole with almost no chewing."}, {"versions": ["pearl", "x", "omega-ruby"], "text": "It hides food under its long body hair. However, it forgets it has hidden the food."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "In its desperation to gulp down food, it forgets about the food it has hidden under its fur."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "It conceals food under the long fur on its body. It carts around this food stash and swallows it without chewing."}, {"versions": ["sun"], "text": "It needs to consume its own weight in food every day. As far as flavor is concerned, it’s indifferent."}, {"versions": ["moon"], "text": "When it finds something that looks like it might be edible, it goes right ahead and swallows it whole. That’s why it gets fatter day by day."}, {"versions": ["ultra-sun"], "text": "It hides food under its long fur, but it sometimes forgets about it and causes a stinky disturbance."}, {"versions": ["ultra-moon"], "text": "Anything that looks edible, Munchlax will go on and swallow whole. Its stomach is tough enough to handle it even if the food has gone rotten."}, {"versions": ["sword"], "text": "Stuffing itself with vast amounts of food is its only concern. Whether the food is rotten or fresh, yummy or tasteless—it does not care."}, {"versions": ["shield"], "text": "It stores food beneath its fur. It might share just one bite, but only if it really trusts you."}, {"versions": ["legends-arceus"], "text": "Its robust stomach allows it to nonchalantly devour even rotted matter. It pays frequent visits to villages, seeking out food scraps intended for compost."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/446.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/446.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/446.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/446.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/446.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/446.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/446.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/446.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/446.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sp