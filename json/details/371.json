{"height": 6, "weight": 421, "base_experience": 60, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Rock Head Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "タツベイ"}, {"language": "ja-roma", "name": "Tatsubay"}, {"language": "ko", "name": "아공이"}, {"language": "zh-hant", "name": "寶貝龍"}, {"language": "fr", "name": "Draby"}, {"language": "de", "name": "Kindwurm"}, {"language": "es", "name": "Bagon"}, {"language": "it", "name": "Bagon"}, {"language": "ja", "name": "タツベイ"}, {"language": "zh-hans", "name": "宝贝龙"}, {"language": "es-419", "name": "Bagon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "BAGON has a dream of one day soaring in the sky. In doomed efforts to fly, this POKéMON hurls itself off cliffs. As a result of its dives, its head has grown tough and as hard as tempered steel."}, {"versions": ["sapphire"], "text": "BAGON harbors a never-ending dream of one day soaring high among the clouds. As if trying to dispel its frustration over its inability to fly, this POKéMON slams its hard head against huge rocks and shatters them into pebbles."}, {"versions": ["emerald"], "text": "Although it is small, this POKéMON is very powerful because its body is a bundle of muscles. It launches head-butts with its ironlike skull."}, {"versions": ["firered", "leafgreen"], "text": "Its steel-hard head can shatter boulders. It longingly hopes for wings to grow so it can fly."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "Dreaming of one day flying, it practices by leaping off cliffs every day."}, {"versions": ["heartgold", "soulsilver"], "text": "Its well-developed neck muscles and ironlike head can smash boulders into pieces."}, {"versions": ["x"], "text": "Its well-developed neck muscles and iron-like head can smash boulders into pieces."}, {"versions": ["omega-ruby"], "text": "Bagon has a dream of one day soaring in the sky. In doomed efforts to fly, this Pokémon hurls itself off cliffs. As a result of its dives, its head has grown tough and as hard as tempered steel."}, {"versions": ["alpha-sapphire"], "text": "Bagon harbors a never-ending dream of one day soaring high among the clouds. As if trying to dispel its frustration over its inability to fly, this Pokémon slams its hard head against huge rocks and shatters them into pebbles."}, {"versions": ["sun"], "text": "Its belief that it will be able to fly one day is apparently the influence of information carried in its genes."}, {"versions": ["moon"], "text": "With its steel-hard stone head, it headbutts indiscriminately. This is because of the stress it feels at being unable to fly."}, {"versions": ["ultra-sun"], "text": "Whenever it sees bird Pokémon flying through the sky, it becomes envious and smashes its surroundings to bits with headbutts."}, {"versions": ["ultra-moon"], "text": "Some theories suggest that its behavior of forcefully bashing its head into things stimulates cells that affect its evolution."}, {"versions": ["sword"], "text": "Bagon jumps off cliffs every day, trying to grow stronger so that someday it will be able to fly."}, {"versions": ["shield"], "text": "Bagon is a solitary Pokémon that doesn’t form groups with others of its kind. It also has a head hard enough to cleave a boulder in one strike."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/371.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/371.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/371.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/rub