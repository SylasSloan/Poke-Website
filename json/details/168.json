{"height": 11, "weight": 335, "base_experience": 140, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Long Leg Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "fast", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アリアドス"}, {"language": "ja-roma", "name": "Ariados"}, {"language": "ko", "name": "아리아도스"}, {"language": "zh-hant", "name": "阿利多斯"}, {"language": "fr", "name": "Migalos"}, {"language": "de", "name": "Ariados"}, {"language": "es", "name": "Ariados"}, {"language": "it", "name": "Ariados"}, {"language": "ja", "name": "アリアドス"}, {"language": "zh-hans", "name": "阿利多斯"}, {"language": "es-419", "name": "Ariados"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "It spins string not only from its rear but also from its mouth. It is hard to tell which end is which."}, {"versions": ["silver", "firered", "soulsilver"], "text": "A single strand of a special string is endlessly spun out of its rear. The string leads back to its nest."}, {"versions": ["crystal"], "text": "Rather than mak­ ing a nest in one specific spot, it wanders in search of food after darkness falls."}, {"versions": ["ruby", "sapphire"], "text": "ARIADOS’s feet are tipped with tiny hooked claws that enable it to scuttle on ceilings and vertical walls. This POKéMON constricts the foe with thin and strong silk webbing."}, {"versions": ["emerald"], "text": "Its feet are tipped with tiny hooked claws that enable it to scuttle on ceilings and vertical walls. It constricts its foe with thin and strong silk webbing."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It attaches silk to its prey and sets it free. Later, it tracks the silk to the prey and its friends."}, {"versions": ["heartgold", "x"], "text": "It spins string not only from its rear but also from its mouth. It’s hard to tell which end is which."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Ariados’s feet are tipped with tiny hooked claws that enable it to scuttle on ceilings and vertical walls. This Pokémon constricts the foe with thin and strong silk webbing."}, {"versions": ["sun"], "text": "There are some areas where people use the string Ariados spins for their own weaving. The resulting cloth is popular for its strength."}, {"versions": ["moon"], "text": "It spins thread from both its rear and its mouth. Then it wraps its prey up in thread and sips their bodily fluids at its leisure."}, {"versions": ["ultra-sun"], "text": "Every night, it wanders around in search of prey, whose movements it restrains by spewing threads before it bites into them with its fangs."}, {"versions": ["ultra-moon"], "text": "It spews threads from its mouth to catch its prey. When night falls, it leaves its web to go hunt aggressively."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/168.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/168.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/168.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/168.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/168.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/168.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/168.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/168.png"}, "ruby-sapphire": {"norm