{"height": 12, "weight": 380, "base_experience": 78, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Clear Wing Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ヤンヤンマ"}, {"language": "ja-roma", "name": "Yanyanma"}, {"language": "ko", "name": "왕자리"}, {"language": "zh-hant", "name": "蜻蜻蜓"}, {"language": "fr", "name": "Yanma"}, {"language": "de", "name": "Yanma"}, {"language": "es", "name": "Yanma"}, {"language": "it", "name": "Yanma"}, {"language": "ja", "name": "ヤンヤンマ"}, {"language": "zh-hans", "name": "蜻蜻蜓"}, {"language": "es-419", "name": "Yanma"}], "pokedex_entries": [{"versions": ["gold"], "text": "If it flaps its wings really fast, it can generate shock waves that will shatter win­ dows in the area."}, {"versions": ["silver", "firered", "soulsilver"], "text": "Its large eyes can scan 360 degrees. It looks in all directions to seek out insects as its prey."}, {"versions": ["crystal"], "text": "It can see in all directions without moving its big eyes, helping it spot attackers and food right away."}, {"versions": ["ruby", "sapphire"], "text": "YANMA is capable of seeing 360 degrees without having to move its eyes. It is a great flier that is adept at making sudden stops and turning midair. This POKéMON uses its flying ability to quickly chase down targeted prey."}, {"versions": ["emerald"], "text": "It can see 360 degrees without moving its eyes. It is a great flier capable of making sudden stops and turning midair to quickly chase down targeted prey."}, {"versions": ["leafgreen", "heartgold", "y"], "text": "If it flaps its wings really fast, it can generate shock waves that will shatter windows in the area."}, {"versions": ["diamond", "pearl", "x"], "text": "Its eyes can see 360 degrees without moving its head. It won’t miss prey--even those behind it."}, {"versions": ["platinum", "black", "white"], "text": "It can hover in one spot by flapping its wings at high speed. It flits about to guard its territory."}, {"versions": ["black-2", "white-2"], "text": "By flapping its wings at high speed, it can fly freely through the air. Even sudden stops are no problem."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Yanma is capable of seeing 360 degrees without having to move its eyes. It is a great flier that is adept at making sudden stops and turning midair. This Pokémon uses its flying ability to quickly chase down targeted prey."}, {"versions": ["legends-arceus"], "text": "Its frail wings are so thin that one can see clear through them. However, during flight these wings exhibit the power to churn air with force enough to launch a house skyward."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/193.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/193.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/193.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/193.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/193.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/193.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/193.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/193.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapp