{"height": 3, "weight": 10, "base_experience": 42, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Balloon Pokémon", "capture_rate": 170, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["no-eggs"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ププリン"}, {"language": "ja-roma", "name": "Pupurin"}, {"language": "ko", "name": "푸푸린"}, {"language": "zh-hant", "name": "寶寶丁"}, {"language": "fr", "name": "Toudoudou"}, {"language": "de", "name": "Fluffeluff"}, {"language": "es", "name": "Igglybuff"}, {"language": "it", "name": "Igglybuff"}, {"language": "ja", "name": "ププリン"}, {"language": "zh-hans", "name": "宝宝丁"}, {"language": "es-419", "name": "Igglybuff"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "It has a very soft body. If it starts to roll, it will bounce all over and be impossible to stop."}, {"versions": ["silver"], "text": "Its extremely flexible and elas­ tic body makes it bounce continuous­ ly--anytime, any­ where."}, {"versions": ["crystal", "x"], "text": "Instead of walking with its short legs, it moves around by bouncing on its soft, tender body."}, {"versions": ["ruby"], "text": "IGGLYBUFF’s vocal chords are not sufficiently developed. It would hurt its throat if it were to sing too much. This POKéMON gargles with freshwater from a clean stream."}, {"versions": ["sapphire"], "text": "IGGLYBUFF has a soft and plushy body that feels very much like a marshmallow. From this body wafts a gently sweet fragrance that soothes and calms the emotions of its foes."}, {"versions": ["emerald"], "text": "Its soft and pliable body is very bouncy. When it sings continuously with all its might, its body steadily turns a deepening pink color."}, {"versions": ["firered", "soulsilver"], "text": "Its extremely flexible and elastic body makes it bounce continuously--anytime, anywhere."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "It has a soft and bouncy body. Once it starts bouncing, it becomes impossible to stop."}, {"versions": ["black-2", "white-2"], "text": "Its body has a faintly sweet scent and is bouncy and soft. If it bounces even once, it cannot stop."}, {"versions": ["omega-ruby"], "text": "Igglybuff’s vocal cords are not sufficiently developed. It would hurt its throat if it were to sing too much. This Pokémon gargles with freshwater from a clean stream."}, {"versions": ["alpha-sapphire"], "text": "Igglybuff has a soft and plushy body that feels very much like a marshmallow. From this body wafts a gently sweet fragrance that soothes and calms the emotions of its foes."}, {"versions": ["sun"], "text": "It likes to sing but is not yet good at it. With praise and encouragement, it will get better little by little."}, {"versions": ["moon"], "text": "It moves by bouncing along. As it moves a lot, it sweats, and its body gives off a sweet aroma."}, {"versions": ["ultra-sun"], "text": "It’s always practicing its singing because it wants to improve. Even when it’s asleep, it keeps singing in its dreams!"}, {"versions": ["ultra-moon"], "text": "Left to its own devices, it will constantly practice singing. You should make it take a break so it doesn’t hurt its throat."}, {"versions": ["sword"], "text": "Igglybuff loves to sing. Its marshmallow-like body gives off a faint sweet smell."}, {"versions": ["shield"], "text": "Taking advantage of the softness of its body, Igglybuff moves as if bouncing. Its body turns a deep pink when its temperature rises."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/174.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/174.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/174.png", "shiny": "https://raw.githubuserconten