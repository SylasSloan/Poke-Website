{"height": 18, "weight": 1386, "base_experience": 243, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Thunderbolt Pokémon", "capture_rate": 30, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "エレキブル"}, {"language": "ja-roma", "name": "Elekible"}, {"language": "ko", "name": "에레키블"}, {"language": "zh-hant", "name": "電擊魔獸"}, {"language": "fr", "name": "Élekable"}, {"language": "de", "name": "Elevoltek"}, {"language": "es", "name": "Electivire"}, {"language": "it", "name": "Electivire"}, {"language": "ja", "name": "エレキブル"}, {"language": "zh-hans", "name": "电击魔兽"}, {"language": "es-419", "name": "Electivire"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "y", "alpha-sapphire"], "text": "It pushes the tips of its two tails against the foe, then lets loose with over 20,000 volts of power."}, {"versions": ["platinum", "black", "white"], "text": "Heedless of enemy attacks, it closes in, shoves its tails onto the foe, then looses high voltage."}, {"versions": ["heartgold", "soulsilver", "x", "omega-ruby"], "text": "As its electric charge amplifies, blue sparks begin to crackle between its horns."}, {"versions": ["black-2", "white-2"], "text": "The instant it presses the tips of its tails onto an opponent, it sends over 20,000 volts of electricity into the foe."}, {"versions": ["sun"], "text": "It pushes the tips of its tails against its foes and then lets loose a high-voltage current. Its foes are burned to a crisp in an instant."}, {"versions": ["moon"], "text": "When it gets excited, it thumps its chest. With every thud, thunder roars and electric sparks shower all around."}, {"versions": ["ultra-sun"], "text": "It grips its tail, which spews electricity, and then beats down opponents with the power of its electrified fist."}, {"versions": ["ultra-moon"], "text": "A single Electivire can provide enough electricity for all the buildings in a big city for a year."}, {"versions": ["sword"], "text": "The amount of electrical energy this Pokémon produces is proportional to the rate of its pulse. The voltage jumps while Electivire is battling."}, {"versions": ["shield"], "text": "In terms of electrical-energy output, Electivire is one of the best among all Electric Pokémon. It discharges high-voltage currents from its tails."}, {"versions": ["legends-arceus"], "text": "Its evolution was induced by an unusual item, and its electrical output rises along with its heart rate. From its tails, it can unleash an electric current measuring 20,000 volts."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/466.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/466.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/466.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/466.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/466.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/466.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/466.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/466.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/466.png"}}, "genera