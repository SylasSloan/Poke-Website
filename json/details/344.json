{"height": 15, "weight": 1080, "base_experience": 175, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Clay Doll Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ネンドール"}, {"language": "ja-roma", "name": "Nendoll"}, {"language": "ko", "name": "점토도리"}, {"language": "zh-hant", "name": "念力土偶"}, {"language": "fr", "name": "Kaorine"}, {"language": "de", "name": "Lepumentas"}, {"language": "es", "name": "Claydol"}, {"language": "it", "name": "Claydol"}, {"language": "ja", "name": "ネンドール"}, {"language": "zh-hans", "name": "念力土偶"}, {"language": "es-419", "name": "Claydol"}], "pokedex_entries": [{"versions": ["ruby"], "text": "CLAYDOL are said to be dolls of mud made by primitive humans and brought to life by exposure to a mysterious ray. This POKéMON moves about while levitating."}, {"versions": ["sapphire"], "text": "CLAYDOL is an enigma that appeared from a clay statue made by an ancient civilization dating back 20,000 years. This POKéMON shoots beams from both its hands."}, {"versions": ["emerald"], "text": "A CLAYDOL sleeps while hovering in midair. Its arms are separate from its body. They are kept floating by the POKéMON’s manipulation of psychic power."}, {"versions": ["firered", "leafgreen", "shield"], "text": "It appears to have been born from clay dolls made by ancient people. It uses telekinesis to float and move."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "An ancient clay figurine that came to life as a Pokémon from exposure to a mysterious ray of light."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It is said that it originates from clay dolls made by an ancient civilization."}, {"versions": ["black-2", "white-2", "sword"], "text": "This mysterious Pokémon started life as an ancient clay figurine made over 20,000 years ago."}, {"versions": ["omega-ruby"], "tex