{"height": 10, "weight": 405, "base_experience": 126, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Big Voice Pokémon", "capture_rate": 120, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドゴーム"}, {"language": "ja-roma", "name": "Dogohmb"}, {"language": "ko", "name": "노공룡"}, {"language": "zh-hant", "name": "吼爆彈"}, {"language": "fr", "name": "Ramboum"}, {"language": "de", "name": "Krakeelo"}, {"language": "es", "name": "Loudred"}, {"language": "it", "name": "Loudred"}, {"language": "ja", "name": "ドゴーム"}, {"language": "zh-hans", "name": "吼爆弹"}, {"language": "es-419", "name": "Loudred"}], "pokedex_entries": [{"versions": ["ruby"], "text": "LOUDRED’s bellowing can completely decimate a wood-frame house. It uses its voice to punish its foes. This POKéMON’s round ears serve as loudspeakers."}, {"versions": ["sapphire"], "text": "LOUDRED shouts while stamping its feet. After it finishes shouting, this POKéMON becomes incapable of hearing anything for a while. This is considered to be a weak point."}, {"versions": ["emerald"], "text": "It positions the round speakers on its head to assail foes with ultrasonic waves at massive volume. It builds power by stomping the ground."}, {"versions": ["firered", "leafgreen"], "text": "When it stamps its feet and bellows, it generates ultrasonic waves that can blow apart a house."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "The shock waves from its cries can tip over trucks. It stamps its feet to power up."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "It shouts loudly by inhaling air, and then uses its well-developed stomach muscles to exhale."}, {"versions": ["omega-ruby"], "text": "Loudred’s bellowing can completely decimate a wood-frame house. It uses its voice to punish its foes. This Pokémon’s round ears serve as loudspeakers."}, {"ve