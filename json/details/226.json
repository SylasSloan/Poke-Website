{"height": 21, "weight": 2200, "base_experience": 170, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Kite Pokémon", "capture_rate": 25, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "slow", "egg_groups": ["water1"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "マンタイン"}, {"language": "ja-roma", "name": "Mantain"}, {"language": "ko", "name": "만타인"}, {"language": "zh-hant", "name": "巨翅飛魚"}, {"language": "fr", "name": "Démanta"}, {"language": "de", "name": "Mantax"}, {"language": "es", "name": "Mantine"}, {"language": "it", "name": "Mantine"}, {"language": "ja", "name": "マンタイン"}, {"language": "zh-hans", "name": "巨翅飞鱼"}, {"language": "es-419", "name": "Mantine"}], "pokedex_entries": [{"versions": ["gold"], "text": "As it majestically swims, it doesn't care if REMORAID attach to it for scavenging its leftovers."}, {"versions": ["silver", "firered", "soulsilver"], "text": "Swimming freely in open seas, it may fly out of the water and over the waves if it builds up enough speed."}, {"versions": ["crystal"], "text": "It swims along freely, eating things that swim into its mouth. Its whole body is very coarse."}, {"versions": ["ruby", "sapphire"], "text": "On sunny days, schools of MANTINE can be seen elegantly leaping over the sea’s waves. This POKéMON is not bothered by the REMORAID that hitches rides."}, {"versions": ["emerald"], "text": "On sunny days, schools of MANTINE can be seen elegantly leaping over the waves. It is not bothered by the REMORAID that hitches rides."}, {"versions": ["leafgreen"], "text": "As it majestically swims, it doesn’t care if REMORAID attach to it to scavenge for its leftovers."}, {"versions": ["diamond"], "text": "When the waves are calm, one may encounter a swarm of MANTINE swimming as if they are in flight."}, {"versions": ["pearl"], "text": "It swims elegantly, mindless of REMORAID hitching on to its broad fins. It has a docile nature."}, {"versions": ["platinum"], "text": "While elegantly swimming in the sea, it ignores REMORAID that cling to its fins seeking food scraps."}, {"versions": ["heartgold"], "text": "As it majestically swims, it doesn’t care if REMORAID attach to it for scavenging its leftovers."}, {"versions": ["black", "white", "y"], "text": "While elegantly swimming in the sea, it ignores Remoraid that cling to its fins seeking food scraps."}, {"versions": ["black-2", "white-2", "x"], "text": "If it builds up enough speed swimming, it can fly over 300 feet out of the water from the surface of the ocean."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "On sunny days, schools of Mantine can be seen elegantly leaping over the sea’s waves. This Pokémon is not bothered by the Remoraid that hitches rides."}, {"versions": ["ultra-sun"], "text": "Postcards and posters featuring Mantine leaping elegantly above the waves are popular souvenirs of Alola."}, {"versions": ["ultra-moon"], "text": "Many people have taken up surfing because they admire how magnificently Mantine swims."}, {"versions": ["sword"], "text": "If it builds up enough speed swimming, it can jump out above the waves and glide for over 300 feet."}, {"versions": ["shield"], "text": "As it majestically swims, it doesn’t care if Remoraid attach to it to scavenge for its leftovers."}, {"versions": ["legends-arceus"], "text": "This calm and gentle Pokémon swims gracefully through the sea. After building speed, it can leap out of the water. It is often misidentified as a bird Pokémon due to this behavior."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/226.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/226.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/226.png", "shiny": "https://raw.githubusercontent.com/P