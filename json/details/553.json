{"height": 15, "weight": 963, "base_experience": 234, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Intimidation Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ワルビアル"}, {"language": "ja-roma", "name": "Waruvial"}, {"language": "ko", "name": "악비아르"}, {"language": "zh-hant", "name": "流氓鱷"}, {"language": "fr", "name": "Crocorible"}, {"language": "de", "name": "Rabigator"}, {"language": "es", "name": "Krookodile"}, {"language": "it", "name": "Krookodile"}, {"language": "ja", "name": "ワルビアル"}, {"language": "zh-hans", "name": "流氓鳄"}, {"language": "es-419", "name": "Krookodile"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "They never allow prey to escape. Their jaws are so powerful, they can crush the body of an automobile."}, {"versions": ["white"], "text": "It can expand the focus of its eyes, enabling it to see objects in the far distance as if it were using binoculars."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "Very violent Pokémon, they try to clamp down on anything that moves in front of their eyes."}, {"versions": ["sun"], "text": "Its unique faculty of sight can detect small prey more than 30 miles away, even in the midst of a sandstorm."}, {"versions": ["moon"], "text": "After clamping down with its powerful jaws, it twists its body around to rip its prey in half."}, {"versions": ["ultra-sun"], "text": "When it spots prey, even at a distance of over 30 miles, it swims through the desert as if it were water, then jumps out and chomps them."}, {"versions": ["ultra-moon"], "text": "It conceals itself in sandstorms that Flygon whip up and waits patiently for prey to appear."}, {"versions": ["sword"], "text": "This Pokémon is known as the Bully of the Sands. Krookodile’s mighty jaws can bite through heavy plates of iron with almost no effort at all."}, {"version