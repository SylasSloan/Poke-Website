{"height": 11, "weight": 346, "base_experience": 395, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Egg Pokémon", "capture_rate": 30, "base_happiness": 140, "hatch_counter": 40, "growth_rate": "fast", "egg_groups": ["fairy"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ラッキー"}, {"language": "ja-roma", "name": "Lucky"}, {"language": "ko", "name": "럭키"}, {"language": "zh-hant", "name": "吉利蛋"}, {"language": "fr", "name": "Leveinard"}, {"language": "de", "name": "Chaneira"}, {"language": "es", "name": "Chansey"}, {"language": "it", "name": "Chansey"}, {"language": "ja", "name": "ラッキー"}, {"language": "zh-hans", "name": "吉利蛋"}, {"language": "es-419", "name": "Chansey"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A rare and elusive POKéMON that is said to bring happiness to those who manage to get it."}, {"versions": ["yellow"], "text": "A gentle and kind­ hearted POKéMON that shares its nutritious eggs if it sees an injured POKéMON."}, {"versions": ["gold", "heartgold"], "text": "It walks carefully to prevent its egg from breaking. However, it is extremely fast at running away."}, {"versions": ["silver"], "text": "Few in number and difficult to cap­ ture, it is said to bring happiness to the trainer who catches it."}, {"versions": ["crystal"], "text": "People try to catch it for its extremely nutritious eggs, but it rarely can be found."}, {"versions": ["ruby", "sapphire"], "text": "CHANSEY lays nutritionally excellent eggs on an everyday basis. The eggs are so delicious, they are easily and eagerly devoured by even those people who have lost their appetite."}, {"versions": ["emerald"], "text": "CHANSEY lay nutritionally excellent eggs every day. The eggs are so delicious, they are eagerly devoured by even those people who have lost their appetite."}, {"versions": ["firered", "y"], "text": "It lays several eggs a day. The eggs are apparently rich in nutrients and extremely delicious."}, {"versions": ["leafgreen"], "text": "A rare and elusive POKéMON that is said to bring happiness to those who manage to catch one."}, {"versions": ["diamond", "x"], "text": "It is said to deliver happiness. Being compassionate, it shares its eggs with injured people."}, {"versions": ["pearl"], "text": "It lays several eggs a day and won’t share them with those who have evil in their hearts."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "A kindly Pokémon that lays highly nutritious eggs and shares them with injured Pokémon or people."}, {"versions": ["soulsilver"], "text": "Being few in number and difficult to capture, it is said to bring happiness to the Trainer who catches it."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Chansey lays nutritionally excellent eggs on an everyday basis. The eggs are so delicious, they are easily and eagerly devoured by even those people who have lost their appetite."}, {"versions": ["sun"], "text": "The eggs laid by Chansey are rich in nutrients and a favorite food of many Pokémon."}, {"versions": ["moon"], "text": "Not only are these Pokémon fast runners, they’re also few in number, so anyone who finds one must be lucky indeed."}, {"versions": ["ultra-sun"], "text": "It seems that other Pokémon’s efforts to take its delicious, nutritious egg away from it caused Chansey to get faster at fleeing."}, {"versions": ["ultra-moon"], "text": "Because the eggs on their bellies have been overharvested by people in the past, the Chansey population remains very small."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A gentle and kindhearted Pokémon that shares its nutritious eggs if it sees an injured Pokémon."}, {"versions": ["sword"], "text": "The egg Chansey carries is not only delicious but also packed with nutrition. It’s used as a high-class cooking ingredient."}, {"versions": ["shield"], "text": "This species was once very slow. To protect their eggs from other creatures, these Pokémon became able to flee quickly."}, {"version