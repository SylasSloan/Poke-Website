{"height": 5, "weight": 17, "base_experience": 54, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Pond Skater Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["water1", "bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アメタマ"}, {"language": "ja-roma", "name": "Ametama"}, {"language": "ko", "name": "비구술"}, {"language": "zh-hant", "name": "溜溜糖球"}, {"language": "fr", "name": "Arakdo"}, {"language": "de", "name": "Gehweiher"}, {"language": "es", "name": "Surskit"}, {"language": "it", "name": "Surskit"}, {"language": "ja", "name": "アメタマ"}, {"language": "zh-hans", "name": "溜溜糖球"}, {"language": "es-419", "name": "Surskit"}], "pokedex_entries": [{"versions": ["ruby"], "text": "From the tips of its feet, SURSKIT secretes an oil that enables it to walk on water as if it were skating. This POKéMON feeds on microscopic organisms in ponds and lakes."}, {"versions": ["sapphire"], "text": "If SURSKIT senses danger, it secretes a thick, sugary syrup from the tip of its head. There are some POKéMON that love eating this syrup."}, {"versions": ["emerald"], "text": "They gather on puddles after evening downpours, gliding across the surface of water as if sliding. It secretes honey with a sweet aroma from its head."}, {"versions": ["firered", "leafgreen", "x"], "text": "They usually live on ponds, but after an evening shower, they may appear on puddles in towns."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It appears as if it is skating on water. It draws prey with a sweet scent from the tip of its head."}, {"versions": ["heartgold", "soulsilver"], "text": "It secretes a thick, sweet-scented syrup from the tip of its head. It lives on weed-choked ponds."}, {"versions": ["omega-ruby"], "text": "From the tips of its feet, Surskit secretes an oil that enables it to walk on water as if it were skating. This Pokémon feeds on microscopic organisms in ponds and lakes."}, {"versions": ["alpha-sapphire"], "text": "If Surskit senses danger, it secretes a thick, sugary syrup from the tip of its head. There are some Pokémon that love eating this syrup."}, {"versions": ["sun"], "text": "It moves as if skating on the surface of the water. It often fights with Dewpider over food."}, {"versions": ["moon"], "text": "When this Pokémon senses danger, a sweet fluid oozes from the tip of its head. The taste of it disgusts bird Pokémon."}, {"versions": ["ultra-sun"], "text": "If it’s in a pinch, it will secrete a sweet liquid from the tip of its head. Syrup made from gathering that liquid is tasty on bread."}, {"versions": ["ultra-moon"], "text": "It lives in ponds and marshes that feature lots of plant life. It often fights with Dewpider, whose habitat and diet are similar."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/283.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/283.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/283.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/283.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/283.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/283.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/283.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generati