{"height": 10, "weight": 270, "base_experience": 184, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Moonlight Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 35, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ブラッキー"}, {"language": "ja-roma", "name": "Bracky"}, {"language": "ko", "name": "블래키"}, {"language": "zh-hant", "name": "月亮伊布"}, {"language": "fr", "name": "Noctali"}, {"language": "de", "name": "Nachtara"}, {"language": "es", "name": "Umbreon"}, {"language": "it", "name": "Umbreon"}, {"language": "ja", "name": "ブラッキー"}, {"language": "zh-hans", "name": "月亮伊布"}, {"language": "es-419", "name": "Umbreon"}], "pokedex_entries": [{"versions": ["gold"], "text": "When agitated, this POKéMON pro­ tects itself by spraying poisonous sweat from its pores."}, {"versions": ["silver", "soulsilver"], "text": "When darkness falls, the rings on the body begin to glow, striking fear in the hearts of anyone nearby."}, {"versions": ["crystal", "shield"], "text": "On the night of a full moon, or when it gets excited, the ring patterns on its body glow yellow."}, {"versions": ["ruby", "sapphire"], "text": "UMBREON evolved as a result of exposure to the moon’s waves. It hides silently in darkness and waits for its foes to make a move. The rings on its body glow when it leaps to attack."}, {"versions": ["emerald"], "text": "UMBREON evolved from exposure to the moon’s energy pulses. It lurks in darkness and waits for its foes to move. The rings on its body glow when it leaps to attack."}, {"versions": ["firered"], "text": "When darkness falls, the rings on its body begin to glow, striking fear in the hearts of anyone nearby."}, {"versions": ["leafgreen"], "text": "When agitated, this POKéMON protects itself by spraying poisonous sweat from its pores."}, {"versions": ["diamond", "pearl"], "text": "The light of the moon changed EEVEE’s genetic structure. It lurks in darkness for prey."}, {"versions": ["platinum", "black", "white"], "text": "When exposed to the moon’s aura, the rings on its body glow faintly and it gains a mysterious power."}, {"versions": ["heartgold"], "text": "When agitated, this Pokémon protects itself by spraying poisonous sweat from its pores."}, {"versions": ["black-2", "white-2", "y"], "text": "When exposed to the moon’s aura, the rings on its body glow faintly and it’s filled with a mysterious power."}, {"versions": ["x"], "text": "The light of the moon changed Eevee’s genetic structure. It lurks in darkness for prey."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Umbreon evolved as a result of exposure to the moon’s waves. It hides silently in darkness and waits for its foes to make a move. The rings on its body glow when it leaps to attack."}, {"versions": ["sun", "sword"], "text": "When this Pokémon becomes angry, its pores secrete a poisonous sweat, which it sprays at its opponent’s eyes."}, {"versions": ["moon"], "text": "With its black fur, it blends into the darkness. It bides its time, and when prey appears, this Pokémon goes for its throat, and then eats it."}, {"versions": ["ultra-sun"], "text": "This Pokémon is nocturnal. Even in total darkness, its large eyes can spot its prey clearly!"}, {"versions": ["ultra-moon"], "text": "It lurks in the dark of night looking for prey. At the moment it pounces, the rings on its body glow dimly but ominously."}, {"versions": ["legends-arceus"], "text": "It is most active in the wee hours of the night, when moonlight bathes the land. Its large eyes can pierce the darkness and perceive prey with absolute clarity."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/197.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/197.png"}, "gold": {"normal": "https://raw.githubusercontent