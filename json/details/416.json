{"height": 12, "weight": 385, "base_experience": 166, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Beehive Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["bug"], "gender_rate": 8, "names": [{"language": "ja-hrkt", "name": "ビークイン"}, {"language": "ja-roma", "name": "Beequen"}, {"language": "ko", "name": "비퀸"}, {"language": "zh-hant", "name": "蜂女王"}, {"language": "fr", "name": "Apireine"}, {"language": "de", "name": "Honweisel"}, {"language": "es", "name": "Vespiquen"}, {"language": "it", "name": "Vespiquen"}, {"language": "ja", "name": "ビークイン"}, {"language": "zh-hans", "name": "蜂女王"}, {"language": "es-419", "name": "Vespiquen"}], "pokedex_entries": [{"versions": ["diamond"], "text": "Its abdomen is a honeycomb for grubs. It raises its grubs on honey collected by COMBEE."}, {"versions": ["pearl"], "text": "When endangered, grubs from its six-cell honeycomb strike back. There is only one in a colony."}, {"versions": ["platinum", "black", "white"], "text": "It releases various pheromones to make the grubs in its body do its bidding while fighting foes."}, {"versions": ["heartgold", "soulsilver"], "text": "It raises grubs in the holes in its body. It secretes pheromones to control COMBEE."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "It houses its colony in cells in its body and releases various pheromones to make those grubs do its bidding."}, {"versions": ["y", "alpha-sapphire"], "text": "Its abdomen is a honeycomb for grubs. It raises its grubs on honey collected by Combee."}, {"versions": ["sword"], "text": "It skillfully commands its grubs in battles with its enemies. The grubs are willing to risk their lives to defend Vespiquen."}, {"versions": ["shield"], "text": "Vespiquen that give off more pheromones have larger swarms of Combee attendants."}, {"versions": ["legends-arceus"], "text": "Commands its subjects to build its hive. It will dispatch any interlopers who dare sneak into its nest and use them as nourishment for itself."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/416.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/416.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/416.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/416.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/416.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/416.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/416.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/416.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/416.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/416.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/416.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/416.png", "shiny": "https://raw.githubusercontent.