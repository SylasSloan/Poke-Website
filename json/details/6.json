{"height": 17, "weight": 905, "base_experience": 240, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Flame Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "dragon"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "リザードン"}, {"language": "ja-roma", "name": "Lizardon"}, {"language": "ko", "name": "리자몽"}, {"language": "zh-hant", "name": "噴火龍"}, {"language": "fr", "name": "Dracaufeu"}, {"language": "de", "name": "Glurak"}, {"language": "es", "name": "Charizard"}, {"language": "it", "name": "Charizard"}, {"language": "ja", "name": "リザードン"}, {"language": "zh-hans", "name": "喷火龙"}, {"language": "es-419", "name": "Charizard"}], "pokedex_entries": [{"versions": ["black", "white", "black-2", "white-2"], "text": "It is said that Charizard’s fire burns hotter if it has experienced harsh battles."}, {"versions": ["red", "blue"], "text": "Spits fire that is hot enough to melt boulders. Known to cause forest fires unintentionally."}, {"versions": ["yellow"], "text": "When expelling a blast of super hot fire, the red flame at the tip of its tail burns more intensely."}, {"versions": ["gold"], "text": "If CHARIZARD be­ comes furious, the flame at the tip of its tail flares up in a whitish- blue color."}, {"versions": ["silver"], "text": "Breathing intense, hot flames, it can melt almost any­ thing. Its breath inflicts terrible pain on enemies."}, {"versions": ["crystal"], "text": "It uses its wings to fly high. The temperature of its fire increases as it gains exper­ ience in battle."}, {"versions": ["ruby", "sapphire"], "text": "CHARIZARD flies around the sky in search of powerful opponents. It breathes fire of such great heat that it melts anything. However, it never turns its fiery breath on any opponent weaker than itself."}, {"versions": ["emerald"], "text": "A CHARIZARD flies about in search of strong opponents. It breathes intense flames that can melt any material. However, it will never torch a weaker foe."}, {"versions": ["firered"], "text": "Its wings can carry this POKéMON close to an altitude of 4,600 feet. It blows out fire at very high temperatures."}, {"versions": ["leafgreen", "sword"], "text": "It spits fire that is hot enough to melt boulders. It may cause forest fires by blowing flames."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It is said that CHARIZARD’s fire burns hotter if it has experienced harsh battles."}, {"versions": ["heartgold"], "text": "If CHARIZARD becomes furious, the flame at the tip of its tail flares up in a light blue shade."}, {"versions": ["soulsilver"], "text": "Breathing intense, hot flames, it can melt almost anything. Its breath inflicts terrible pain on enemies."}, {"versions": ["x"], "text": "When expelling a blast of superhot fire, the red flame at the tip of its tail burns more intensely."}, {"versions": ["y", "shield"], "text": "Its wings can carry this Pokémon close to an altitude of 4,600 feet. It blows out fire at very high temperatures."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Charizard flies around the sky in search of powerful opponents. It breathes fire of such great heat that it melts anything. However, it never turns its fiery breath on any opponent weaker than itself."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "When this Pokémon expels a blast of superhot fire, the red flame at the tip of its tail burns more intensely."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/6.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/6.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/6.png", "shiny": "https://raw.