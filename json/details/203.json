{"height": 15, "weight": 415, "base_experience": 159, "ev_yield": [{"stat": "special-attack", "value": 2}], "genus": "Long Neck Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "キリンリキ"}, {"language": "ja-roma", "name": "Kirinriki"}, {"language": "ko", "name": "키링키"}, {"language": "zh-hant", "name": "麒麟奇"}, {"language": "fr", "name": "Girafarig"}, {"language": "de", "name": "Girafarig"}, {"language": "es", "name": "Girafarig"}, {"language": "it", "name": "Girafarig"}, {"language": "ja", "name": "キリンリキ"}, {"language": "zh-hans", "name": "麒麟奇"}, {"language": "es-419", "name": "Girafarig"}], "pokedex_entries": [{"versions": ["gold", "leafgreen"], "text": "Its tail has a small brain of its own. Beware! If you get close, it may react to your scent and bite."}, {"versions": ["silver", "firered", "soulsilver"], "text": "Its tail, which also contains a small brain, may bite on its own if it notices an alluring smell."}, {"versions": ["crystal"], "text": "When it is in danger, its tail uses some sort of mysterious powers to drive away the enemy."}, {"versions": ["ruby"], "text": "GIRAFARIG’s rear head also has a brain, but it is small. The rear head attacks in response to smells and sounds. Approaching this POKéMON from behind can cause the rear head to suddenly lash out and bite."}, {"versions": ["sapphire"], "text": "GIRAFARIG’s rear head contains a tiny brain that is too small for thinking. However, the rear head doesn’t need to sleep, so it can keep watch over its surroundings 24 hours a day."}, {"versions": ["emerald"], "text": "A GIRAFARIG is an herbivore--it eats grass and tree shoots. While it is eating, its tail makes chewing and swallowing motions as if it were also eating."}, {"versions": ["diamond"], "text": "Its tail also has a small brain. It bites to repel any foe trying to sneak up on it from behind."}, {"versions": ["pearl", "x"], "text": "While it sleeps, the head on its tail keeps watch. The tail doesn’t need to sleep."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "The head on its tail contains a small brain. It can instinctively fight even while facing backward."}, {"versions": ["heartgold", "y"], "text": "Its tail has a small brain of its own. Beware! If you get close, it may react to your scent by biting."}, {"versions": ["omega-ruby"], "text": "Girafarig’s rear head also has a brain, but it is small. The rear head attacks in response to smells and sounds. Approaching this Pokémon from behind can cause the rear head to suddenly lash out and bite."}, {"versions": ["alpha-sapphire"], "text": "Girafarig’s rear head contains a tiny brain that is too small for thinking. However, the rear head doesn’t need to sleep, so it can keep watch over its surroundings 24 hours a day."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/203.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/203.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/203.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/203.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/203.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/203.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/203.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emeral