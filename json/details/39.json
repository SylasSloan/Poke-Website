{"height": 5, "weight": 55, "base_experience": 95, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Balloon Pokémon", "capture_rate": 170, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["fairy"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "プリン"}, {"language": "ja-roma", "name": "Purin"}, {"language": "ko", "name": "푸린"}, {"language": "zh-hant", "name": "胖丁"}, {"language": "fr", "name": "Rondoudou"}, {"language": "de", "name": "Pummeluff"}, {"language": "es", "name": "Jigglypuff"}, {"language": "it", "name": "Jigglypuff"}, {"language": "ja", "name": "プリン"}, {"language": "zh-hans", "name": "胖丁"}, {"language": "es-419", "name": "Jigglypuff"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "When its huge eyes light up, it sings a mysteriously soothing melody that lulls its enemies to sleep."}, {"versions": ["yellow"], "text": "Uses its alluring eyes to enrapture its foe. It then sings a pleasing melody that lulls the foe to sleep."}, {"versions": ["gold"], "text": "If it inflates to SING a lullaby, it can perform longer and cause sure drowsiness in its audience."}, {"versions": ["silver", "soulsilver"], "text": "Looking into its cute, round eyes causes it to sing a relaxing melody, inducing its enemies to sleep."}, {"versions": ["crystal"], "text": "It rolls its cute eyes as it sings a soothing lullaby. Its gentle song puts anyone who hears it to sleep."}, {"versions": ["ruby"], "text": "JIGGLYPUFF’s vocal chords can freely adjust the wavelength of its voice. This POKéMON uses this ability to sing at precisely the right wavelength to make its foes most drowsy."}, {"versions": ["sapphire"], "text": "When this POKéMON sings, it never pauses to breathe. If it is in a battle against an opponent that does not easily fall asleep, JIGGLYPUFF cannot breathe, endangering its life."}, {"versions": ["emerald"], "text": "Nothing can avoid falling asleep hearing a JIGGLYPUFF’s song. The sound waves of its singing voice match the brain waves of someone in a deep sleep."}, {"versions": ["firered", "x"], "text": "It captivates foes with its huge, round eyes, then lulls them to sleep by singing a soothing melody."}, {"versions": ["leafgreen"], "text": "When its huge eyes waver, it sings a mysteriously soothing melody that lulls its enemies to sleep."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "When it wavers its big, round eyes, it begins singing a lullaby that makes everyone drowsy."}, {"versions": ["heartgold", "y"], "text": "If it inflates to sing a lullaby, it can perform longer and cause sure drowsiness in its audience."}, {"versions": ["black-2", "white-2"], "text": "Looking into its cute, round eyes makes it start singing a song so pleasant listeners can’t help but fall asleep."}, {"versions": ["omega-ruby"], "text": "Jigglypuff’s vocal cords can freely adjust the wavelength of its voice. This Pokémon uses this ability to sing at precisely the right wavelength to make its foes most drowsy."}, {"versions": ["alpha-sapphire"], "text": "When this Pokémon sings, it never pauses to breathe. If it is in a battle against an opponent that does not easily fall asleep, Jigglypuff cannot breathe, endangering its life."}, {"versions": ["sun"], "text": "It hugely inflates its stomach and sings a mysterious melody. If you hear this melody, you’ll become sleepy right away."}, {"versions": ["moon"], "text": "Jigglypuff possess a vocal range that exceeds 12 octaves, but each individual’s singing skill depends on its own effort."}, {"versions": ["ultra-sun"], "text": "Recordings of Jigglypuff’s strange lullabies can be purchased from department stores. These CDs can be found near the bedding area."}, {"versions": ["ultra-moon"], "text": "The songs they sing are totally different depending on the region they live in. Some even sound like they’re shouting!"}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Uses its cute round eyes to enrapture its foe. It then sings a pleasing melody that lulls the foe to sleep."}, {"versions": ["sword"], "text": "Jigglypuff has top-notch lung capacity, even by comparison to other Pokémon. It won’t stop singing its lullabies until its foes fall asleep."}, {"versions": ["shield"], "text": "By freely changing the wavelength of its voice, Jigglypuff sings a mysterious melody sure to make any listener sleepy."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/39.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/39.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/39.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/39.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/39.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/39.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/39.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/39.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/39.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/39.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/39.png", "shiny": "htt