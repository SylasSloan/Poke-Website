{"height": 6, "weight": 10, "base_experience": 68, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Poison Gas Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドガース"}, {"language": "ja-roma", "name": "Dogars"}, {"language": "ko", "name": "또가스"}, {"language": "zh-hant", "name": "瓦斯彈"}, {"language": "fr", "name": "Smogo"}, {"language": "de", "name": "Smogon"}, {"language": "es", "name": "Koffing"}, {"language": "it", "name": "Koffing"}, {"language": "ja", "name": "ドガース"}, {"language": "zh-hans", "name": "瓦斯弹"}, {"language": "es-419", "name": "Koffing"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Because it stores several kinds of toxic gases in its body, it is prone to exploding without warning."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "In hot places, its internal gases could expand and explode without any warning. Be very careful!"}, {"versions": ["gold", "heartgold"], "text": "Its thin, filmy body is filled with gases that cause constant sniffles, coughs and teary eyes."}, {"versions": ["silver"], "text": "The poisonous gases it contains are a little bit lighter than air, keeping it slight­ ly airborne."}, {"versions": ["crystal"], "text": "If one gets close enough to it when it expels poison­ ous gas, the gas swirling inside it can be seen."}, {"versions": ["ruby"], "text": "If KOFFING becomes agitated, it raises the toxicity of its internal gases and jets them out from all over its body. This POKéMON may also overinflate its round body, then explode."}, {"versions": ["sapphire"], "text": "KOFFING embodies toxic substances. It mixes the toxins with raw garbage to set off a chemical reaction that results in a terribly powerful poison gas. The higher the temperature, the more gas is concocted by this POKéMON."}, {"versions": ["emerald"], "text": "Getting up close to a KOFFING will give you a chance to observe, through its thin skin, the toxic gases swirling inside. It blows up at the slightest stimulation."}, {"versions": ["firered", "x"], "text": "Its thin, balloon-like body is inflated by horribly toxic gases. It reeks when it is nearby."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "Lighter-than-air gases in its body keep it aloft. The gases not only smell, they are also explosive."}, {"versions": ["soulsilver"], "text": "The poisonous gases it contains are a little bit lighter than air, keeping it slightly airborne."}, {"versions": ["black-2", "white-2"], "text": "Toxic gas is held within its thin, balloon-shaped body, so it can cause massive explosions."}, {"versions": ["omega-ruby"], "text": "If Koffing becomes agitated, it raises the toxicity of its internal gases and jets them out from all over its body. This Pokémon may also overinflate its round body, then explode."}, {"versions": ["alpha-sapphire"], "text": "Koffing embodies toxic substances. It mixes the toxins with raw garbage to set off a chemical reaction that results in a terribly powerful poison gas. The higher the temperature, the more gas is concocted by this Pokémon."}, {"versions": ["sword"], "text": "Its body is full of poisonous gas. It floats into garbage dumps, seeking out the fumes of raw, rotting trash."}, {"versions": ["shield"], "text": "It adores polluted air. Some claim that Koffing used to be more plentiful in the Galar region than they are now."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/109.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/109.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/version