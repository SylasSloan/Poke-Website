{"height": 17, "weight": 2300, "base_experience": 261, "ev_yield": [{"stat": "defense", "value": 3}], "genus": "Rock Peak Pokémon", "capture_rate": 3, "base_happiness": 35, "hatch_counter": 80, "growth_rate": "slow", "egg_groups": ["no-eggs"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "レジロック"}, {"language": "ja-roma", "name": "Regirock"}, {"language": "ko", "name": "레지락"}, {"language": "zh-hant", "name": "雷吉洛克"}, {"language": "fr", "name": "Regirock"}, {"language": "de", "name": "Regirock"}, {"language": "es", "name": "Regirock"}, {"language": "it", "name": "Regirock"}, {"language": "ja", "name": "レジロック"}, {"language": "zh-hans", "name": "雷吉洛克"}, {"language": "es-419", "name": "Regirock"}], "pokedex_entries": [{"versions": ["ruby"], "text": "REGIROCK was sealed away by people long ago. If this POKéMON’s body is damaged in battle, it is said to seek out suitable rocks on its own to repair itself."}, {"versions": ["sapphire"], "text": "REGIROCK’s body is composed entirely of rocks. Recently, a study made the startling discovery that the rocks were all unearthed from different locations."}, {"versions": ["emerald"], "text": "A POKéMON that is made entirely of rocks and boulders. If parts of its body chip off in battle, REGIROCK repairs itself by adding new rocks."}, {"versions": ["firered", "leafgreen"], "text": "It is entirely composed of rocks with no sign of a brain or heart. It is a mystery even to modern scientists."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Its entire body is made of rock. If any part chips off in battle, it attaches rocks to repair itself."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "The same rocks that form its body have been found in ground layers around the world."}, {"versions": ["omega-ruby"], "text": "Regirock was sealed away by people long ago. If this Pokémon’s body is damaged in battle, it is said to seek out suitable rocks on its own to repair itself."}, {"versions": ["alpha-sapphire"], "text": "Regirock’s body is composed entirely of rocks. Recently, a study made the startling discovery that the rocks were all unearthed from different locations."}, {"versions": ["sword"], "text": "Every bit of Regirock’s body is made of stone. As parts of its body erode, this Pokémon sticks rocks to itself to repair what’s been lost."}, {"versions": ["shield"], "text": "Cutting-edge technology was used to study the internals of this Pokémon’s rock body, but nothing was found—not even a brain or a heart."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/377.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/377.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/377.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/377.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/377.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/377.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/377.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/377.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/377.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/g