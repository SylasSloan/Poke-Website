{"height": 14, "weight": 560, "base_experience": 144, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Cave Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["monster", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ガバイト"}, {"language": "ja-roma", "name": "Gabite"}, {"language": "ko", "name": "한바이트"}, {"language": "zh-hant", "name": "尖牙陸鯊"}, {"language": "fr", "name": "Carmache"}, {"language": "de", "name": "Knarksel"}, {"language": "es", "name": "Gabite"}, {"language": "it", "name": "Gabite"}, {"language": "ja", "name": "ガバイト"}, {"language": "zh-hans", "name": "尖牙陆鲨"}, {"language": "es-419", "name": "Gabite"}], "pokedex_entries": [{"versions": ["diamond"], "text": "There is a long-held belief that medicine made from its scales will heal even incurable illnesses."}, {"versions": ["pearl"], "text": "It habitually digs up and hoards gems in its nest. Its loot is constantly targeted by thieves."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "x", "omega-ruby"], "text": "It loves sparkly things. It seeks treasures in caves and hoards the loot in its nest."}, {"versions": ["heartgold", "soulsilver", "y", "alpha-sapphire"], "text": "As it digs to expand its nest, it habitually digs up gems that it then hoards in its nest."}, {"versions": ["sun"], "text": "In rare cases, it molts and sheds its scales. Medicine containing its scales as an ingredient will make a weary body feel invigorated."}, {"versions": ["moon"], "text": "Shiny objects are its passion. It can be found in its cave, scarcely moving, its gaze fixed on the jewels it’s amassed or Carbink it has caught."}, {"versions": ["ultra-sun"], "text": "It loves shiny things. When it finds a Sableye trying to catch a Carbink, Gabite becomes furiously angry and attacks the Sableye."}, {"versions": ["ultra-moon"], "text": "It sheds its skin and gradually grows larger. Its scales can be ground into a powder and used as raw materials for traditional medicine."}, {"versions": ["sword"], "text": "This Pokémon emits ultrasonic waves from a protrusion on either side of its head to probe pitch-dark caves."}, {"versions": ["shield"], "text": "Jewels are buried in the caves these Pokémon nest in, but you’ll be torn apart by claws and fangs the moment you enter one of these caves."}, {"versions": ["legends-arceus"], "text": "Though Gabite are usually of a violent disposition, when I gave one a glass bead it had been eyeing covetously, it suddenly became quite docile."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/444.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/444.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/444.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/444.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/444.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/444.png"}}, "generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/444.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/444.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/444.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal":