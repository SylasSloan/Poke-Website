{"height": 23, "weight": 2538, "base_experience": 166, "ev_yield": [{"stat": "hp", "value": 2}], "genus": "Arm Thrust Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast-then-very-slow", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "ハリテヤマ"}, {"language": "ja-roma", "name": "Hariteyama"}, {"language": "ko", "name": "하리뭉"}, {"language": "zh-hant", "name": "鐵掌力士"}, {"language": "fr", "name": "Hariyama"}, {"language": "de", "name": "Hariyama"}, {"language": "es", "name": "Hariyama"}, {"language": "it", "name": "Hariyama"}, {"language": "ja", "name": "ハリテヤマ"}, {"language": "zh-hans", "name": "铁掌力士"}, {"language": "es-419", "name": "Hariyama"}], "pokedex_entries": [{"versions": ["ruby"], "text": "HARIYAMA practices its straight-arm slaps in any number of locations. One hit of this POKéMON’s powerful, openhanded, straight-arm punches could snap a telephone pole in two."}, {"versions": ["sapphire"], "text": "HARIYAMA’s thick body may appear fat, but it is actually a hunk of solid muscle. If this POKéMON bears down and tightens all its muscles, its body becomes as hard as a rock."}, {"versions": ["emerald"], "text": "It has the habit of challenging others without hesitation to tests of strength. It’s been known to stand on train tracks and stop trains using forearm thrusts."}, {"versions": ["firered", "leafgreen", "x"], "text": "It stomps on the ground to build power. It can send a 10-ton truck flying with a straight-arm punch."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "It loves to match power with big-bodied Pokémon. It can knock a truck flying with its arm thrusts."}, {"versions": ["heartgold", "soulsilver"], "text": "It loves challenging others to tests of strength. It has the power to stop a train with a slap."}, {"versions": ["omega-ruby"], "text": "Hariyama practices its straight-arm slaps in any number of locations. One hit of this Pokémon’s powerful, openhanded, straight-arm punches could snap a telephone pole in two."}, {"versions": ["alpha-sapphire"], "text": "Hariyama’s thick body may appear fat, but it is actually a hunk of solid muscle. If this Pokémon bears down and tightens all its muscles, its body becomes as hard as a rock."}, {"versions": ["sun"], "text": "It is known for its fantastic strength, but as it grows older, it focuses more on training Makuhita."}, {"versions": ["moon"], "text": "They love to compare their freakish strength— strength enough to send a truck flying with a single slap."}, {"versions": ["ultra-sun"], "text": "Although they enjoy comparing their strength, they’re also kind. They value etiquette, praising opponents they battle."}, {"versions": ["ultra-moon"], "text": "Hariyama that are big and fat aren’t necessarily strong. There are some small ones that move nimbly and use moves skillfully."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/297.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/297.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/297.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/297.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/297.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/297.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/297.png", "shiny": "ht