{"height": 4, "weight": 50, "base_experience": 150, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Sky Squirrel Pokémon", "capture_rate": 200, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "zh-hant", "name": "電飛鼠"}, {"language": "ja-hrkt", "name": "エモンガ"}, {"language": "ja-roma", "name": "Emolga"}, {"language": "ko", "name": "에몽가"}, {"language": "fr", "name": "Emolga"}, {"language": "de", "name": "Emolga"}, {"language": "es", "name": "Emolga"}, {"language": "it", "name": "Emolga"}, {"language": "ja", "name": "エモンガ"}, {"language": "zh-hans", "name": "电飞鼠"}, {"language": "es-419", "name": "Emolga"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "The energy made in its cheeks’ electric pouches is stored inside its membrane and released while it is gliding."}, {"versions": ["white", "x", "omega-ruby"], "text": "They live on treetops and glide using the inside of a cape-like membrane while discharging electricity."}, {"versions": ["black-2", "white-2"], "text": "It glides on its outstretched membrane while shocking foes with the electricity stored in the pouches on its cheeks."}, {"versions": ["sun"], "text": "It glides using its cape-like membrane. Electrical energy scatters from it, shocking its friends and foes alike."}, {"versions": ["moon"], "text": "It grills berries and bug Pokémon with electric shocks and makes a meal of them. It usually nests in the holes gouged in trees by Pikipek."}, {"versions": ["ultra-sun"], "text": "They store up electricity to fly through the air. When thunder cracks at night, sometimes there are almost enough of them to blot out the sky."}, {"versions": ["ultra-moon"], "text": "As it flies, it scatters electricity around, so bird Pokémon keep their distance. That’s why Emolga can keep all its food to itself."}, {"versions": ["sword"], "text": "As Emolga flutters through the air, it crackles with electricity. This Pokémon is cute, but it can cause a lot of trouble."}, {"versions": ["shield"], "text": "This Pokémon absolutely loves sweet berries. Sometimes it stuffs its cheeks full of so much food that it can’t fly properly."}], "sprites_by_gen": {"generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/587.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/587.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/587.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/587.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/587.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/587.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/587.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/587.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/587.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/587.png", "shiny": null}}}, "moves_by_generation": [{"label": "Generation V", "level_up": [{"level": 1, "label": "Level 1", "name": "Thunder Shock"}, {"level": 4, "label": "Level 4", "name": "Quick Attack"}, {"level": 7, "label": "Level 7", "name": "T