{"height": 18, "weight": 852, "base_experience": 165, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Triple Bird Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ドードリオ"}, {"language": "ja-roma", "name": "Dodorio"}, {"language": "ko", "name": "두트리오"}, {"language": "zh-hant", "name": "嘟嘟利"}, {"language": "fr", "name": "Dodrio"}, {"language": "de", "name": "Dodri"}, {"language": "es", "name": "Dodrio"}, {"language": "it", "name": "Dodrio"}, {"language": "ja", "name": "ドードリオ"}, {"language": "zh-hans", "name": "嘟嘟利"}, {"language": "es-419", "name": "Dodrio"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Uses its three brains to execute complex plans. While two heads sleep, one head stays awake."}, {"versions": ["yellow"], "text": "One of DODUO's 2 heads splits to form a unique species. It runs close to 40 MPH in prairies."}, {"versions": ["gold"], "text": "It collects data and plans three times as wisely, but it may think too much and be­ come immobilized."}, {"versions": ["silver", "soulsilver"], "text": "If one of the heads gets to eat, the others will be satisfied, too, and they will stop squabbling."}, {"versions": ["crystal", "x"], "text": "An enemy that takes its eyes off any of the three heads--even for a second--will get pecked severely."}, {"versions": ["ruby"], "text": "Watch out if DODRIO’s three heads are looking in three separate directions. It’s a sure sign that it is on its guard. Don’t go near this POKéMON if it’s being wary - it may decide to peck you."}, {"versions": ["sapphire"], "text": "Apparently, the heads aren’t the only parts of the body that DODRIO has three of. It has three sets of hearts and lungs as well, so it is capable of running long distances without rest."}, {"versions": ["emerald"], "text": "A peculiar POKéMON species with three heads. It vigorously races across grassy plains even in arid seasons with little rainfall."}, {"versions": ["firered", "y"], "text": "An odd species that is rarely found. The three heads respectively represent joy, sadness, and anger."}, {"versions": ["leafgreen"], "text": "Uses its three brains to execute complex plans. While two heads sleep, one head is said to stay awake."}, {"versions": ["diamond", "pearl", "platinum"], "text": "When DODUO evolves into this odd breed, one of its heads splits into two. It runs at nearly 40 mph."}, {"versions": ["heartgold"], "text": "It collects data and plans three times as wisely, but it may think too much and fall into a state of immobility."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "When Doduo evolves into this odd breed, one of its heads splits into two. It runs at nearly 40 mph."}, {"versions": ["omega-ruby"], "text": "Watch out if Dodrio’s three heads are looking in three separate directions. It’s a sure sign that it is on its guard. Don’t go near this Pokémon if it’s being wary—it may decide to peck you."}, {"versions": ["alpha-sapphire"], "text": "Apparently, the heads aren’t the only parts of the body that Dodrio has three of. It has three sets of hearts and lungs as well, so it is capable of running long distances without rest."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "One of Doduo’s two heads splits to form a unique species. It runs close to 40 mph in prairies."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/85.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/85.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/85.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/