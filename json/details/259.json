{"height": 7, "weight": 280, "base_experience": 142, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Mud Fish Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "water1"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ヌマクロー"}, {"language": "ja-roma", "name": "Numacraw"}, {"language": "ko", "name": "늪짱이"}, {"language": "zh-hant", "name": "沼躍魚"}, {"language": "fr", "name": "Flobio"}, {"language": "de", "name": "Moorabbel"}, {"language": "es", "name": "Marshtomp"}, {"language": "it", "name": "Marshtomp"}, {"language": "ja", "name": "ヌマクロー"}, {"language": "zh-hans", "name": "沼跃鱼"}, {"language": "es-419", "name": "Marshtomp"}], "pokedex_entries": [{"versions": ["ruby"], "text": "The surface of MARSHTOMP’s body is enveloped by a thin, sticky film that enables it to live on land. This POKéMON plays in mud on beaches when the ocean tide is low."}, {"versions": ["sapphire"], "text": "MARSHTOMP is much faster at traveling through mud than it is at swimming. This POKéMON’s hindquarters exhibit obvious development, giving it the ability to walk on just its hind legs."}, {"versions": ["emerald"], "text": "Its toughened hind legs enable it to stand upright. Because it weakens if its skin dries out, it replenishes fluids by playing in mud."}, {"versions": ["firered", "leafgreen"], "text": "It is at its best when on muddy ground with poor footing. It quickly overwhelms foes struggling in mud."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "Its sturdy legs give it sure footing, even in mud. It burrows into dirt to sleep."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "Living on muddy ground that provides poor footing has made its legs sturdy."}, {"versions": ["omega-ruby"], "text": "The surface of Marshtomp’s body is enveloped by a thin, sticky film that enables it to live on land. This Pokémon plays in mud on beaches