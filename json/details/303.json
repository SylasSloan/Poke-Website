{"height": 6, "weight": 115, "base_experience": 133, "ev_yield": [{"stat": "attack", "value": 1}, {"stat": "defense", "value": 1}], "genus": "Deceiver Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["ground", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "クチート"}, {"language": "ja-roma", "name": "Kucheat"}, {"language": "ko", "name": "입치트"}, {"language": "zh-hant", "name": "大嘴娃"}, {"language": "fr", "name": "Mysdibule"}, {"language": "de", "name": "Flunkifer"}, {"language": "es", "name": "Mawile"}, {"language": "it", "name": "Mawile"}, {"language": "ja", "name": "クチート"}, {"language": "zh-hans", "name": "大嘴娃"}, {"language": "es-419", "name": "Mawile"}], "pokedex_entries": [{"versions": ["ruby"], "text": "MAWHILE’s huge jaws are actually steel horns that have been transformed. Its docile-looking face serves to lull its foe into letting down its guard. When the foe least expects it, MAWHILE chomps it with its gaping jaws."}, {"versions": ["sapphire"], "text": "Don’t be taken in by this POKéMON’s cute face - it’s very dangerous. MAWILE fools the foe into letting down its guard, then chomps down with its massive jaws. The steel jaws are really horns that have been transformed."}, {"versions": ["emerald"], "text": "Its giant jaws are actually steel horns that transformed. It fools foes into complacency with its adorable gestures, then chomps them with its huge jaws."}, {"versions": ["firered", "leafgreen", "x", "sword"], "text": "It uses its docile-looking face to lull foes into complacency, then bites with its huge, relentless jaws."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "y"], "text": "Attached to its head is a huge set of jaws formed by horns. It can chew through iron beams."}, {"versions": ["heartgold", "soulsilver", "shield"], "text": "It chomps with its gaping mouth. Its huge jaws are actually steel horns that have been transformed."}, {"versions": ["omega-ruby"], "text": "Mawile’s huge jaws are actually steel horns that have been transformed. Its docile-looking face serves to lull its foe into letting down its guard. When the foe least expects it, Mawile chomps it with its gaping jaws."}, {"versions": ["alpha-sapphire"], "text": "Don’t be taken in by this Pokémon’s cute face—it’s very dangerous. Mawile fools the foe into letting down its guard, then chomps down with its massive jaws. The steel jaws are really horns that have been transformed."}, {"versions": ["ultra-sun"], "text": "A cunning and terrifying Pokémon, its cuteness makes opponents let down their guard—and then it swallows them whole with its huge jaws."}, {"versions": ["ultra-moon"], "text": "It has two mouths. The big jaws on the back of its head can’t taste anything, so that’s the mouth it uses to eat foods it doesn’t like."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/303.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/303.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/303.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/303.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/303.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/303.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/303.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprite