{"height": 4, "weight": 600, "base_experience": 66, "ev_yield": [{"stat": "defense", "value": 1}], "genus": "Iron Armor Pokémon", "capture_rate": 180, "base_happiness": 35, "hatch_counter": 35, "growth_rate": "slow", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ココドラ"}, {"language": "ja-roma", "name": "Cokodora"}, {"language": "ko", "name": "가보리"}, {"language": "zh-hant", "name": "可可多拉"}, {"language": "fr", "name": "Galekid"}, {"language": "de", "name": "Stollunior"}, {"language": "es", "name": "Aron"}, {"language": "it", "name": "Aron"}, {"language": "ja", "name": "ココドラ"}, {"language": "zh-hans", "name": "可可多拉"}, {"language": "es-419", "name": "Aron"}], "pokedex_entries": [{"versions": ["ruby"], "text": "This POKéMON has a body of steel. To make its body, ARON feeds on iron ore that it digs from mountains. Occasionally, it causes major trouble by eating bridges and rails."}, {"versions": ["sapphire"], "text": "ARON has a body of steel. With one all-out charge, this POKéMON can demolish even a heavy dump truck. The destroyed dump truck then becomes a handy meal for the POKéMON."}, {"versions": ["emerald"], "text": "A POKéMON that is clad in steel armor. A new suit of armor is made when it evolves. The old, discarded armor is salvaged as metal for making iron products."}, {"versions": ["firered", "leafgreen"], "text": "It eats iron to build its steel body. It is a pest that descends from mountains to eat bridges and train tracks."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "It usually lives deep in mountains. However, hunger may drive it to eat railroad tracks and cars."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "When it evolves, it sheds the steel carapace that covered its whole body and develops a new one."}, {"versions": ["black-2", "white-2"], "text": "In order to build up its steel body, it eats iron ore. This pesky Pokémon is known to eat railroad tracks."}, {"versions": ["omega-ruby"], "text": "This Pokémon has a body of steel. To make its body, Aron feeds on iron ore that it digs from mountains. Occasionally, it causes major trouble by eating bridges and rails."}, {"versions": ["alpha-sapphire"], "text": "Aron has a body of steel. With one all-out charge, this Pokémon can demolish even a heavy dump truck. The destroyed dump truck then becomes a handy meal for the Pokémon."}, {"versions": ["sword"], "text": "It eats iron ore—and sometimes railroad tracks— to build up the steel armor that protects its body."}, {"versions": ["shield"], "text": "When Aron evolves, its steel armor peels off. In ancient times, people would collect Aron’s shed armor and make good use of it in their daily lives."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/304.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/304.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/304.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/304.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/304.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/304.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/304.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/304.png"}, "platinum": {"normal": "https://raw.githubuserconten