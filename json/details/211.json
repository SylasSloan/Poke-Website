{"height": 5, "weight": 39, "base_experience": 88, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Balloon Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ハリーセン"}, {"language": "ja-roma", "name": "Harysen"}, {"language": "ko", "name": "침바루"}, {"language": "zh-hant", "name": "千針魚"}, {"language": "fr", "name": "Qwilfish"}, {"language": "de", "name": "Baldorfish"}, {"language": "es", "name": "Qwilfish"}, {"language": "it", "name": "Qwilfish"}, {"language": "ja", "name": "ハリーセン"}, {"language": "zh-hans", "name": "千针鱼"}, {"language": "es-419", "name": "Qwilfish"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "x"], "text": "To fire its poison spikes, it must inflate its body by drinking over 2.6 gallons of water all at once."}, {"versions": ["silver"], "text": "The small spikes covering its body developed from scales. They in­ ject a toxin that causes fainting."}, {"versions": ["crystal"], "text": "When faced with a larger opponent, it swallows as much water as it can to match the opponent's size."}, {"versions": ["ruby", "sapphire"], "text": "QWILFISH sucks in water, inflating itself. This POKéMON uses the pressure of the water it swallowed to shoot toxic quills all at once from all over its body. It finds swimming somewhat challenging."}, {"versions": ["emerald"], "text": "A QWILFISH uses the pressure of water it swallows to shoot toxic quills all at once from all over its body. It finds swimming to be somewhat challenging."}, {"versions": ["firered", "soulsilver", "y", "shield"], "text": "The small spikes covering its body developed from scales. They inject a toxin that causes fainting."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It shoots the poison spines on its body in all directions. Its round form makes it a poor swimmer."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Qwilfish sucks in water, inflating itself. This Pokémon uses the pressure of the water it swallowed to shoot toxic quills all at once from all over its body. It finds swimming somewhat challenging."}, {"versions": ["sword"], "text": "When faced with a larger opponent, it swallows as much water as it can to match the opponent’s size."}, {"versions": ["legends-arceus"], "text": "Fishers detest this troublesome Pokémon because it sprays poison from its spines, getting it everywhere. A different form of Qwilfish lives in other regions."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/211.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/211.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/211.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/211.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/211.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/211.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/211.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/211.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/211.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/211.png"}}, "generation-i