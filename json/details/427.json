{"height": 4, "weight": 55, "base_experience": 70, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Rabbit Pokémon", "capture_rate": 190, "base_happiness": 0, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground", "humanshape"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ミミロル"}, {"language": "ja-roma", "name": "Mimirol"}, {"language": "ko", "name": "이어롤"}, {"language": "zh-hant", "name": "捲捲耳"}, {"language": "fr", "name": "Laporeille"}, {"language": "de", "name": "Haspiror"}, {"language": "es", "name": "Buneary"}, {"language": "it", "name": "Buneary"}, {"language": "ja", "name": "ミミロル"}, {"language": "zh-hans", "name": "卷卷耳"}, {"language": "es-419", "name": "Buneary"}], "pokedex_entries": [{"versions": ["diamond"], "text": "It slams foes by sharply uncoiling its rolled ears. It stings enough to make a grown-up cry in pain."}, {"versions": ["pearl", "y", "alpha-sapphire"], "text": "When it senses danger, it perks up its ears. On cold nights, it sleeps with its head tucked into its fur."}, {"versions": ["platinum", "black", "white", "x", "omega-ruby"], "text": "Its ears are always rolled up. They can be forcefully extended to shatter even a large boulder."}, {"versions": ["heartgold", "soulsilver"], "text": "You can tell how it feels by the way it rolls its ears. When it’s scared, both ears are rolled up."}, {"versions": ["black-2", "white-2"], "text": "By extending its rolled-up ears and striking the ground, it can bound so high it surprises itself."}, {"versions": ["ultra-sun"], "text": "Its arms and legs are weak, but when it rolls its ears up tight and then unleashes them with its full force, it can smash boulders to dust."}, {"versions": ["ultra-moon"], "text": "The reason it keeps one ear rolled up is so it can launch a swift counterattack if it’s attacked by an enemy."}, {"versions": ["sword"], "text": "If both of Buneary’s ears are rolled up, something is wrong with its body or mind. It’s a sure sign the Pokémon is in need of care."}, {"versions": ["shield"], "text": "Buneary can attack by rolling up their ears and then striking with the force created by unrolling them. This attack becomes stronger with training."}, {"versions": ["legends-arceus"], "text": "My hypothesis as to why Buneary rolls up its ears is that its hearing is far too keen. I surmise that the Pokémon protects its hearing by limiting the sound that may enter its ears."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/427.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/427.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/427.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/427.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/427.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/427.png"}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/427.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/427.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/427.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/427.png"}, "x-y": {"normal": "https://raw.githubuse