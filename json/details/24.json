{"height": 35, "weight": 650, "base_experience": 157, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Cobra Pokémon", "capture_rate": 90, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アーボック"}, {"language": "ja-roma", "name": "Arbok"}, {"language": "ko", "name": "아보크"}, {"language": "zh-hant", "name": "阿柏怪"}, {"language": "fr", "name": "Arbok"}, {"language": "de", "name": "Arbok"}, {"language": "es", "name": "Arbok"}, {"language": "it", "name": "Arbok"}, {"language": "ja", "name": "アーボック"}, {"language": "zh-hans", "name": "阿柏怪"}, {"language": "es-419", "name": "Arbok"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "It is rumored that the ferocious warning markings on its belly differ from area to area."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "The frightening patterns on its belly have been studied. Six variations have been confirmed."}, {"versions": ["gold", "heartgold"], "text": "Transfixing prey with the face-like pattern on its belly, it binds and poisons the frightened victim."}, {"versions": ["silver"], "text": "With a very venge­ ful nature, it won't give up the chase, no matter how far, once it targets its prey."}, {"versions": ["crystal", "y"], "text": "To intimidate foes, it spreads its chest wide and makes eerie sounds by expelling air from its mouth."}, {"versions": ["ruby", "sapphire"], "text": "This POKéMON is terrifically strong in order to constrict things with its body. It can even flatten steel oil drums. Once ARBOK wraps its body around its foe, escaping its crunching embrace is impossible."}, {"versions": ["emerald"], "text": "This POKéMON has a terrifically strong constricting power. It can even flatten steel oil drums. Once it wraps its body around its foe, escaping is impossible."}, {"versions": ["firered", "x"], "text": "The pattern on its belly appears to be a frightening face. Weak foes will flee just at the sight of the pattern."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "The pattern on its belly is for intimidation. It constricts foes while they are frozen in fear."}, {"versions": ["soulsilver"], "text": "With a very vengeful nature, it won’t give up the chase, no matter how far, once it targets its prey."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "This Pokémon is terrifically strong in order to constrict things with its body. It can even flatten steel oil drums. Once Arbok wraps its body around its foe, escaping its crunching embrace is impossible."}, {"versions": ["ultra-sun"], "text": "The latest research has determined that there are over 20 possible arrangements of the patterns on its stomach."}, {"versions": ["ultra-moon"], "text": "After stunning its opponents with the pattern on its stomach, it quickly wraps them up in its body and waits for them to stop moving."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/24.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/24.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/24.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/24.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/24.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/24.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-