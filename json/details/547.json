{"height": 7, "weight": 66, "base_experience": 168, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Windveiled Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["fairy", "plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "エルフーン"}, {"language": "ja-roma", "name": "Elfuun"}, {"language": "ko", "name": "엘풍"}, {"language": "zh-hant", "name": "風妖精"}, {"language": "fr", "name": "Farfaduvet"}, {"language": "de", "name": "Elfun"}, {"language": "es", "name": "Whimsicott"}, {"language": "it", "name": "Whimsicott"}, {"language": "ja", "name": "エルフーン"}, {"language": "zh-hans", "name": "风妖精"}, {"language": "es-419", "name": "Whimsicott"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "Like the wind, it can slip through any gap, no matter how small. It leaves balls of white fluff behind."}, {"versions": ["white"], "text": "Riding whirlwinds, they appear. These Pokémon sneak through gaps into houses and cause all sorts of mischief."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "They appear along with whirlwinds. They pull pranks, such as moving furniture and leaving balls of cotton in homes."}, {"versions": ["sun"], "text": "It rides on the wind and slips into people’s homes. After it has turned a room into a cotton- filled mess, it giggles to itself and takes off."}, {"versions": ["moon"], "text": "This Pokémon appears, riding upon the wind. But if the wind gusts up, it’ll blow the cotton on this Pokémon’s head clean off."}, {"versions": ["ultra-sun"], "text": "This nuisance sneaks into people’s homes, where it hides important things and scatters cotton all over the place."}, {"versions": ["ultra-moon"], "text": "Whimsicott doesn’t live in a fixed location. It floats around on whirling winds, appearing all over the place to perform its mischief."}, {"versions": ["sword"], "text": "It scatters cotton all over the place as a prank. If it gets wet, it’ll become too heavy to move and have no choice but to answer for its mischief."}, {"versions": ["shield"], "text": "As long as this Pokémon bathes in sunlight, its cotton keeps growing. If too much cotton fluff builds up, Whimsicott tears it off and scatters it."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/547.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/547.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/547.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/547.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/547.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/547.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/shiny/547.png"}}, "generation-vii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/icons/547.png", "shiny": null}, "ultra-sun-ultra-moon": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/547.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vii/ultra-sun-ultra-moon/shiny/547.png"}}, "generation-viii": {"icons": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-viii/icons/547.png", 