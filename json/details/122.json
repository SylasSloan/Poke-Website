{"height": 13, "weight": 545, "base_experience": 161, "ev_yield": [{"stat": "special-defense", "value": 2}], "genus": "Barrier Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 25, "growth_rate": "medium", "egg_groups": ["humanshape"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "バリヤード"}, {"language": "ja-roma", "name": "Barrierd"}, {"language": "ko", "name": "마임맨"}, {"language": "zh-hant", "name": "魔牆人偶"}, {"language": "fr", "name": "M. Mime"}, {"language": "de", "name": "Pantimos"}, {"language": "es", "name": "Mr. Mime"}, {"language": "it", "name": "Mr. Mime"}, {"language": "ja", "name": "バリヤード"}, {"language": "zh-hans", "name": "魔墙人偶"}, {"language": "es-419", "name": "Mr. Mime"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "If interrupted while it is miming, it will slap around the offender with its broad hands."}, {"versions": ["yellow"], "text": "Always practices its pantomime act. It makes enemies believe something exists that really doesn't."}, {"versions": ["gold"], "text": "A skilled mime from birth, it gains the ability to create invisi­ ble objects as it matures."}, {"versions": ["silver", "soulsilver"], "text": "Its fingertips emit a peculiar force field that hardens air to create an actual wall."}, {"versions": ["crystal"], "text": "It uses the mysterious power it has in its fingers to solidify air into an invisible wall."}, {"versions": ["ruby", "sapphire"], "text": "MR. MIME is a master of pantomime. Its gestures and motions convince watchers that something unseeable actually exists. Once it is believed, it will exist as if it were a real thing."}, {"versions": ["emerald"], "text": "A MR. MIME is a master of pantomime. It can convince others that something unseeable actually exists. Once believed, the imaginary object does become real."}, {"versions": ["firered", "y"], "text": "It is adept at conning people. It is said to be able to create walls out of thin air by miming."}, {"versions": ["leafgreen"], "text": "If interrupted while it is miming, it will suddenly DOUBLESLAP the offender with its broad hands."}, {"versions": ["diamond"], "text": "It is a pantomime expert that can create invisible but solid walls using miming gestures."}, {"versions": ["pearl", "x"], "text": "Emanations from its fingertips solidify the air into invisible walls that repel even harsh attacks."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "It shapes an invisible wall in midair by minutely vibrating its fingertips to stop molecules in the air."}, {"versions": ["heartgold"], "text": "A skilled mime from birth, it gains the ability to create invisible objects as it matures."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Mr. Mime is a master of pantomime. Its gestures and motions convince watchers that something unseeable actually exists. Once the watchers are convinced, the unseeable thing exists as if it were real."}, {"versions": ["ultra-sun"], "text": "Its pantomime skills are wonderful. You may become enraptured while watching it, but next thing you know, Mr. Mime has made a real wall."}, {"versions": ["ultra-moon"], "text": "It creates invisible walls with its pantomiming. If you don’t act impressed, it will attack you with a double slap!"}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Always practicing its pantomime act. It makes enemies believe something exists that really doesn’t."}, {"versions": ["sword"], "text": "The broadness of its hands may be no coincidence—many scientists believe its palms became enlarged specifically for pantomiming."}, {"versions": ["shield"], "text": "It’s known for its top-notch pantomime skills. It protects itself from all sorts of attacks by emitting auras from its fingers to create walls."}, {"versions": ["legends-arceus"], "text": "The behavior of this clown-like Pokémon reminds one of pantomime. It creates invisible walls using a force emitted from its fingertips."}], "sprites_by_gen": {"g