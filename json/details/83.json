{"height": 8, "weight": 150, "base_experience": 132, "ev_yield": [{"stat": "attack", "value": 1}], "genus": "Wild Duck Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["flying", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "カモネギ"}, {"language": "ja-roma", "name": "Kamonegi"}, {"language": "ko", "name": "파오리"}, {"language": "zh-hant", "name": "大蔥鴨"}, {"language": "fr", "name": "Canarticho"}, {"language": "de", "name": "Porenta"}, {"language": "es", "name": "Farfetch’d"}, {"language": "it", "name": "Farfetch’d"}, {"language": "ja", "name": "カモネギ"}, {"language": "zh-hans", "name": "大葱鸭"}, {"language": "es-419", "name": "Farfetch’d"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "The sprig of green onions it holds is its weapon. It is used much like a metal sword."}, {"versions": ["yellow"], "text": "Lives where reedy plants grow. They are rarely seen, so it's thought their numbers are decreasing."}, {"versions": ["gold"], "text": "If anyone tries to disturb where the essential plant sticks grow, it uses its own stick to thwart them."}, {"versions": ["silver"], "text": "If it eats the plant stick it carries as emer­ gency rations, it runs off in search of a new stick."}, {"versions": ["crystal"], "text": "In order to pre­ vent their extinction, more people have made an effort to breed these POKéMON."}, {"versions": ["ruby", "sapphire"], "text": "FARFETCH’D is always seen with a stick from a plant of some sort. Apparently, there are good sticks and bad sticks. This POKéMON has been known to fight with others over sticks."}, {"versions": ["emerald"], "text": "It is always seen with a stick from a plant. Apparently, there are good sticks and bad sticks. This POKéMON occasionally fights with others over choice sticks."}, {"versions": ["firered", "y"], "text": "It always walks about with a plant stalk clamped in its beak. The stalk is used for building its nest."}, {"versions": ["leafgreen", "x"], "text": "The plant stalk it holds is its weapon. The stalk is used like a sword to cut all sorts of things."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It can’t live without the stalk it holds. That’s why it defends the stalk from attackers with its life."}, {"versions": ["heartgold"], "text": "If anyone tries to disturb where the essential plant stalks grow, it uses its own stalk to thwart them."}, {"versions": ["soulsilver"], "text": "If it eats the plant stalk it carries as emergency rations, it runs off in search of a new stalk."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Farfetch’d is always seen with a stalk from a plant of some sort. Apparently, there are good stalks and bad stalks. This Pokémon has been known to fight with others over stalks."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "They live where reedy plants grow. Farfetch’d are rarely seen, so it’s thought their numbers are decreasing."}, {"versions": ["sword"], "text": "The stalk this Pokémon carries in its wings serves as a sword to cut down opponents. In a dire situation, the stalk can also serve as food."}, {"versions": ["shield"], "text": "They use a plant stalk as a weapon, but not all of them use it in the same way. Several distinct styles of stalk fighting have been observed."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/83.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/83.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/83.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny