{"height": 10, "weight": 864, "base_experience": 47, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Guts Pokémon", "capture_rate": 180, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast-then-very-slow", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "マクノシタ"}, {"language": "ja-roma", "name": "Makunoshita"}, {"language": "ko", "name": "마크탕"}, {"language": "zh-hant", "name": "幕下力士"}, {"language": "fr", "name": "Makuhita"}, {"language": "de", "name": "Makuhita"}, {"language": "es", "name": "Makuhita"}, {"language": "it", "name": "Makuhita"}, {"language": "ja", "name": "マクノシタ"}, {"language": "zh-hans", "name": "幕下力士"}, {"language": "es-419", "name": "Makuhita"}], "pokedex_entries": [{"versions": ["ruby"], "text": "MAKUHITA is tenacious - it will keep getting up and attacking its foe however many times it is knocked down. Every time it gets back up, this POKéMON stores more energy in its body for evolving."}, {"versions": ["sapphire"], "text": "MAKUHITA has a tireless spirit - it will never give up hope. It eats a lot of food, gets plenty of sleep, and it trains very rigorously. By living that way, this POKéMON packs its body with energy."}, {"versions": ["emerald"], "text": "It loves to toughen up its body above all else. If you hear quaking rumbles in a cave, it is the sound of MAKUHITA undertaking strenuous training."}, {"versions": ["firered", "leafgreen"], "text": "It grows stronger by enduring harsh training. It is a gutsy POKéMON that can withstand any attack."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It toughens its body by slamming into thick trees. Many snapped trees can be found near its nest."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "It toughens up by slamming into thick trees over and over. It gains a sturdy body and dauntless spirit."}, {"versions": ["y"], "text": "It grows stronger by enduring harsh training. It is a gutsy Pokémon that can withstand any attack."}, {"versions": ["omega-ruby"], "text": "Makuhita is tenacious—it will keep getting up and attacking its foe however many times it is knocked down. Every time it gets back up, this Pokémon stores more energy in its body for evolving."}, {"versions": ["alpha-sapphire"], "text": "Makuhita has a tireless spirit—it will never give up hope. It eats a lot of food, gets plenty of sleep, and it trains very rigorously. By living that way, this Pokémon packs its body with energy."}, {"versions": ["sun"], "text": "It was originally brought in from another region, but now Makuhita from Alola are more famous."}, {"versions": ["moon"], "text": "Their daily routine consists of training together first thing in the morning, eating and napping in the afternoon, and then more training afterward."}, {"versions": ["ultra-sun"], "text": "It practices its slaps by repeatedly slapping tree trunks. It has been known to slap an Exeggutor and get flung away."}, {"versions": ["ultra-moon"], "text": "There’s a rumor of a traditional recipe for stew that Trainers can use to raise strong Makuhita."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/296.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/296.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/296.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/296.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/296.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/dia