{"height": 5, "weight": 73, "base_experience": 64, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Mock Kelp Pokémon", "capture_rate": 225, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["water1", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "クズモー"}, {"language": "ja-roma", "name": "Kuzumo"}, {"language": "ko", "name": "수레기"}, {"language": "zh-hant", "name": "垃垃藻"}, {"language": "fr", "name": "Venalgue"}, {"language": "de", "name": "Algitt"}, {"language": "es", "name": "Skrelp"}, {"language": "it", "name": "Skrelp"}, {"language": "ja", "name": "クズモー"}, {"language": "zh-hans", "name": "垃垃藻"}, {"language": "es-419", "name": "Skrelp"}], "pokedex_entries": [{"versions": ["x", "omega-ruby"], "text": "Camouflaged as rotten kelp, they spray liquid poison on prey that approaches unawares and then finish it off."}, {"versions": ["y", "alpha-sapphire"], "text": "It looks just like rotten kelp. It hides from foes while storing up power for its evolution."}, {"versions": ["ultra-sun"], "text": "It vanishes into seaweed and remains perfectly still to avoid attacks from large Pokémon. Rotten seaweed is its main food source."}, {"versions": ["ultra-moon"], "text": "It’s not good at swimming, so it clings to the seaweed. In the Alola region, it’s often found near Dhelmise."}, {"versions": ["sword"], "text": "It drifts in the ocean, blending in with floating seaweed. When other Pokémon come to feast on the seaweed, Skrelp feasts on them instead."}, {"versions": ["shield"], "text": "Skrelp looks like a piece of rotten seaweed, so it can blend in with seaweed drifting on the ocean and avoid being detected by enemies."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/690.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/