{"height": 16, "weight": 1390, "base_experience": 170, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Cave Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 30, "growth_rate": "medium", "egg_groups": ["monster", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "クリムガン"}, {"language": "ja-roma", "name": "Crimgan"}, {"language": "ko", "name": "크리만"}, {"language": "zh-hant", "name": "赤面龍"}, {"language": "fr", "name": "Drakkarmin"}, {"language": "de", "name": "Shardrago"}, {"language": "es", "name": "Druddigon"}, {"language": "it", "name": "Druddigon"}, {"language": "ja", "name": "クリムガン"}, {"language": "zh-hans", "name": "赤面龙"}, {"language": "es-419", "name": "Druddigon"}], "pokedex_entries": [{"versions": ["black", "y", "alpha-sapphire"], "text": "It warms its body by absorbing sunlight with its wings. When its body temperature falls, it can no longer move."}, {"versions": ["white", "x", "omega-ruby"], "text": "It races through narrow caves, using its sharp claws to catch prey. The skin on its face is harder than a rock."}, {"versions": ["black-2", "white-2"], "text": "It runs through the narrow tunnels formed by Excadrill and Onix. It uses its sharp claws to catch prey."}, {"versions": ["ultra-sun"], "text": "The red skin on its face is harder than rock. In narrow caves, it squares off against its enemies and charges face-first right into them."}, {"versions": ["ultra-moon"], "text": "It infiltrates tunnels that Pokémon like Diglett and Dugtrio have dug and quietly waits for prey to pass through."}, {"versions": ["sword"], "text": "Druddigon lives in caves, but it never skips sunbathing—it won’t be able to move if its body gets too cold."}, {"versions": ["shield"], "text": "Druddigon are vicious and cunning. They take up residence in nests dug out by other Pokémon, treating the stolen nests as their own lairs."}], "sprites_by_gen": {"generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sp