{"height": 15, "weight": 395, "base_experience": 216, "ev_yield": [{"stat": "speed", "value": 3}], "genus": "Bird Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["flying"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ピジョット"}, {"language": "ja-roma", "name": "Pigeot"}, {"language": "ko", "name": "피죤투"}, {"language": "zh-hant", "name": "大比鳥"}, {"language": "fr", "name": "Roucarnage"}, {"language": "de", "name": "Tauboss"}, {"language": "es", "name": "Pidgeot"}, {"language": "it", "name": "Pidgeot"}, {"language": "ja", "name": "ピジョット"}, {"language": "zh-hans", "name": "大比鸟"}, {"language": "es-419", "name": "Pidgeot"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "When hunting, it skims the surface of water at high speed to pick off unwary prey such as MAGIKARP."}, {"versions": ["yellow"], "text": "This POKéMON flies at Mach 2 speed, seeking prey. Its large talons are feared as wicked weapons."}, {"versions": ["gold", "heartgold"], "text": "Its well-developed chest muscles make it strong enough to whip up a gusty windstorm with just a few flaps."}, {"versions": ["silver", "soulsilver"], "text": "It spreads its beautiful wings wide to frighten its enemies. It can fly at Mach 2 speed."}, {"versions": ["crystal"], "text": "Its outstanding vision allows it to spot splashing MAGIKARP, even while flying at 3300 feet."}, {"versions": ["ruby", "sapphire"], "text": "This POKéMON has a dazzling plumage of beautifully glossy feathers. Many TRAINERS are captivated by the striking beauty of the feathers on its head, compelling them to choose PIDGEOT as their POKéMON."}, {"versions": ["emerald"], "text": "This POKéMON has gorgeous, glossy feathers. Many TRAINERS are so captivated by the beautiful feathers on its head that they choose PIDGEOT as their POKéMON."}, {"versions": ["firered", "y"], "text": "It spreads its gorgeous wings widely to intimidate enemies. It races through the skies at Mach-2 speed."}, {"versions": ["diamond", "pearl", "platinum"], "text": "By flapping its wings with all its might, PIDGEOT can make a gust of wind capable of bending tall trees."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "By flapping its wings with all its might, Pidgeot can make a gust of wind capable of bending tall trees."}, {"versions": ["x"], "text": "When hunting, it skims the surface of water at high speed to pick off unwary prey such as Magikarp."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "This Pokémon has a dazzling plumage of beautifully glossy feathers. Many Trainers are captivated by the striking beauty of the feathers on its head, compelling them to choose Pidgeot as their Pokémon."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "This Pokémon flies at Mach 2 speed, seeking prey. Its large talons are feared as wicked weapons."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/18.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/18.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/18.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/18.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/18.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/18.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/18.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/m