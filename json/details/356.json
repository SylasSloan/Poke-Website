{"height": 16, "weight": 306, "base_experience": 159, "ev_yield": [{"stat": "defense", "value": 1}, {"stat": "special-defense", "value": 1}], "genus": "Beckon Pokémon", "capture_rate": 90, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "サマヨール"}, {"language": "ja-roma", "name": "Samayouru"}, {"language": "ko", "name": "미라몽"}, {"language": "zh-hant", "name": "彷徨夜靈"}, {"language": "fr", "name": "Téraclope"}, {"language": "de", "name": "Zwirrklop"}, {"language": "es", "name": "Dusclops"}, {"language": "it", "name": "Dusclops"}, {"language": "ja", "name": "サマヨール"}, {"language": "zh-hans", "name": "彷徨夜灵"}, {"language": "es-419", "name": "Dusclops"}], "pokedex_entries": [{"versions": ["ruby"], "text": "DUSCLOPS’s body is completely hollow - there is nothing at all inside. It is said that its body is like a black hole. This POKéMON will absorb anything into its body, but nothing will ever come back out."}, {"versions": ["sapphire"], "text": "DUSCLOPS absorbs anything, however large the object may be. This POKéMON hypnotizes its foe by waving its hands in a macabre manner and by bringing its single eye to bear. The hypnotized foe is made to do DUSCLOPS’s bidding."}, {"versions": ["emerald"], "text": "It is thought that its body is hollow with only a spectral ball of fire burning inside. However, no one has been able to confirm this theory as fact."}, {"versions": ["firered", "leafgreen", "sword"], "text": "Its body is entirely hollow. When it opens its mouth, it sucks everything in as if it were a black hole."}, {"versions": ["diamond", "pearl", "y"], "text": "Its body is hollow. It is said that those who look into its body are sucked into the void."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "shield"], "text": "It seeks drifting will-o’-the-wisps and sucks them into its empty body. What happens inside is a mystery."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "Anyone who dares peer into its body to see its spectral ball of fire will have their spirit stolen away."}, {"versions": ["omega-ruby"], "text": "Dusclops’s body is completely hollow—there is nothing at all inside. It is said that its body is like a black hole. This Pokémon will absorb anything into its body, but nothing will ever come back out."}, {"versions": ["alpha-sapphire"], "text": "Dusclops absorbs anything, however large the object may be. This Pokémon hypnotizes its foe by waving its hands in a macabre manner and by bringing its single eye to bear. The hypnotized foe is made to do Dusclops’s bidding."}, {"versions": ["legends-arceus"], "text": "There are rumors that peeking inside its bandage-wrapped body will cause one to get pulled in through the gaps between the bandages, never to return. I've been too scared to verify."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/356.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/356.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/356.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/356.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/356.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/356.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/356.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/