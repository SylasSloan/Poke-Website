{"height": 6, "weight": 163, "base_experience": 48, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Whisper Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["monster", "ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ゴニョニョ"}, {"language": "ja-roma", "name": "Gonyonyo"}, {"language": "ko", "name": "소곤룡"}, {"language": "zh-hant", "name": "咕妞妞"}, {"language": "fr", "name": "Chuchmur"}, {"language": "de", "name": "Flurmel"}, {"language": "es", "name": "Whismur"}, {"language": "it", "name": "Whismur"}, {"language": "ja", "name": "ゴニョニョ"}, {"language": "zh-hans", "name": "咕妞妞"}, {"language": "es-419", "name": "Whismur"}], "pokedex_entries": [{"versions": ["ruby"], "text": "Normally, WHISMUR’s voice is very quiet - it is barely audible even if one is paying close attention. However, if this POKéMON senses danger, it starts crying at an earsplitting volume."}, {"versions": ["sapphire"], "text": "WHISMUR is very timid. If it starts to cry loudly, it becomes startled by its own crying and cries even harder. When it finally stops crying, the POKéMON goes to sleep, all tired out."}, {"versions": ["emerald"], "text": "Its cries equal a jet plane in volume. It inhales through its ear canals. Because of this system, it can cry continually without having to catch its breath."}, {"versions": ["firered", "leafgreen"], "text": "It usually murmurs, but starts crying loudly if it senses danger. It stops when its ear covers are shut."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Usually, its cries are like quiet murmurs. If frightened, it shrieks at the same volume as a jet plane."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "If it senses danger, it scares the foe by crying out with the volume of a jet-plane engine."}, {"versions": ["x"], "text": "It usually murmurs but starts crying loudly if it senses danger. It stops when its ear covers are shut."}, {"versions": ["omega-ruby"], "text": "Normally, Whismur’s voice is very quiet—it is barely audible even if one is paying close attention. However, if this Pokémon senses danger, it starts crying at an earsplitting volume."}, {"versions": ["alpha-sapphire"], "text": "Whismur is very timid. If it starts to cry loudly, it becomes startled by its own crying and cries even harder. When it finally stops crying, the Pokémon goes to sleep, all tired out."}, {"versions": ["sword"], "text": "The cry of a Whismur is over 100 decibels. If you’re close to a Whismur when it lets out a cry, you’ll be stuck with an all-day headache."}, {"versions": ["shield"], "text": "When Whismur cries, the sound of its own voice startles it, making the Pokémon cry even louder. It cries until it’s exhausted, then it falls asleep."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/293.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/293.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/293.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/293.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/293.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/293.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/293.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/gen