{"height": 5, "weight": 215, "base_experience": 60, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Clay Doll Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["mineral"], "gender_rate": -1, "names": [{"language": "ja-hrkt", "name": "ヤジロン"}, {"language": "ja-roma", "name": "Yajilon"}, {"language": "ko", "name": "오뚝군"}, {"language": "zh-hant", "name": "天秤偶"}, {"language": "fr", "name": "Balbuto"}, {"language": "de", "name": "Puppance"}, {"language": "es", "name": "Baltoy"}, {"language": "it", "name": "Baltoy"}, {"language": "ja", "name": "ヤジロン"}, {"language": "zh-hans", "name": "天秤偶"}, {"language": "es-419", "name": "Baltoy"}], "pokedex_entries": [{"versions": ["ruby"], "text": "BALTOY moves while spinning around on its one foot. Primitive wall paintings depicting this POKéMON living among people were discovered in some ancient ruins."}, {"versions": ["sapphire"], "text": "As soon as it spots others of its kind, BALTOY congregates with them and then begins crying noisily in unison. This POKéMON sleeps while cleverly balancing itself on its one foot."}, {"versions": ["emerald"], "text": "A BALTOY moves by spinning on its single foot. It has been depicted in murals adorning the walls of a once-bustling city in an ancient age."}, {"versions": ["firered", "leafgreen", "shield"], "text": "It was discovered in ancient ruins. While moving, it constantly spins. It stands on one foot even when asleep."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "y"], "text": "It moves by spinning on its foot. It is a rare Pokémon that was discovered in ancient ruins."}, {"versions": ["heartgold", "soulsilver"], "text": "It moves while spinning around on its single foot. Some BALTOY have been seen spinning on their heads."}, {"versions": ["black-2", "white-2"], "text": "Discovered in ancient ruins, it moves by spinning around and forms a group when it finds others."}, {"versions": ["x", "sword"], "text": "It moves while spinning around on its single foot. Some Baltoy have been seen spinning on their heads."}, {"versions": ["omega-ruby"], "text": "Baltoy moves while spinning around on its one foot. Primitive wall paintings depicting this Pokémon living among people were discovered in some ancient ruins."}, {"versions": ["alpha-sapphire"], "text": "As soon as it spots others of its kind, Baltoy congregates with them and then begins crying noisily in unison. This Pokémon sleeps while cleverly balancing itself on its one foot."}, {"versions": ["ultra-sun"], "text": "Depictions of Pokémon similar to Baltoy have been found on the walls of caves where primitive humans lived."}, {"versions": ["ultra-moon"], "text": "When they find others of their kind, they cry out loudly and gather together. Large numbers of them can be found in old graveyards."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/343.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/343.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/343.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/343.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/343.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/343.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/343.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/s