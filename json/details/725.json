{"height": 4, "weight": 43, "base_experience": 64, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Fire Cat Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium-slow", "egg_groups": ["ground"], "gender_rate": 1, "names": [{"language": "ja-hrkt", "name": "ニャビー"}, {"language": "ja-roma", "name": "Nyabby"}, {"language": "ko", "name": "냐오불"}, {"language": "zh-hant", "name": "火斑喵"}, {"language": "fr", "name": "Flamiaou"}, {"language": "de", "name": "Flamiau"}, {"language": "es", "name": "Litten"}, {"language": "it", "name": "Litten"}, {"language": "ja", "name": "ニャビー"}, {"language": "zh-hans", "name": "火斑喵"}, {"language": "es-419", "name": "Litten"}], "pokedex_entries": [{"versions": ["sun"], "text": "While grooming itself, it builds up fur inside its stomach. It sets the fur alight and spews fiery attacks, which change based on how it coughs."}, {"versions": ["moon"], "text": "It doesn’t allow its emotions to be easily seen. Earning its trust takes time. It prefers solitude."}, {"versions": ["ultra-sun"], "text": "If you try too hard to get close to it, it won’t open up to you. Even if you do grow close, giving it too much affection is still a no-no."}, {"versions": ["ultra-moon"], "text": "Its coat regrows twice a year. When the time comes, Litten sets its own body on fire and burns away the old fur."}, {"versions": ["sword"], "text": "It spends even the smallest amount of downtime grooming its fur with its tongue. Loose fur gathers in its stomach and serves as fuel for fiery moves."}, {"versions": ["shield"], "text": "Trying to pet Litten before it trusts you will result in a nasty scratch from its sharp claws. Be careful."}], "sprites_by_gen": {"generation-ix": {"scarlet-violet": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ix/scarlet-violet/725.png", "shiny": null}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprite