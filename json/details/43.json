{"height": 5, "weight": 54, "base_experience": 64, "ev_yield": [{"stat": "special-attack", "value": 1}], "genus": "Weed Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["plant"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ナゾノクサ"}, {"language": "ja-roma", "name": "Nazonokusa"}, {"language": "ko", "name": "뚜벅쵸"}, {"language": "zh-hant", "name": "走路草"}, {"language": "fr", "name": "Mystherbe"}, {"language": "de", "name": "Myrapla"}, {"language": "es", "name": "Oddish"}, {"language": "it", "name": "Oddish"}, {"language": "ja", "name": "ナゾノクサ"}, {"language": "zh-hans", "name": "走路草"}, {"language": "es-419", "name": "Oddish"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "During the day, it keeps its face buried in the ground. At night, it wanders around sowing its seeds."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "It may be mistaken for a clump of weeds. If you try to yank it out of the ground, it shrieks horribly."}, {"versions": ["gold"], "text": "Awakened by moon­ light, it roams actively at night. In the day, it stays quietly underground."}, {"versions": ["silver", "soulsilver", "sword"], "text": "If exposed to moonlight, it starts to move. It roams far and wide at night to scatter its seeds."}, {"versions": ["crystal"], "text": "During the day, it stays in the cold underground to avoid the sun. It grows by bath­ ing in moonlight."}, {"versions": ["ruby"], "text": "During the daytime, ODDISH buries itself in soil to absorb nutrients from the ground using its entire body. The more fertile the soil, the glossier its leaves become."}, {"versions": ["sapphire"], "text": "ODDISH searches for fertile, nutrient- rich soil, then plants itself. During the daytime, while it is planted, this POKéMON’s feet are thought to change shape and become similar to the roots of trees."}, {"versions": ["emerald"], "text": "This POKéMON grows by absorbing moonlight. During the daytime, it buries itself in the ground, leaving only its leaves exposed to avoid detection by its enemies."}, {"versions": ["firered", "y"], "text": "Its scientific name is “Oddium Wanderus.” At night, it is said to walk nearly 1,000 feet on its two roots."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "It often plants its root feet in the ground during the day and sows seeds as it walks about at night."}, {"versions": ["heartgold"], "text": "Awakened by moonlight, it roams actively at night. In the day, it stays quietly underground."}, {"versions": ["x", "shield"], "text": "During the day, it stays in the cold underground to avoid the sun. It grows by bathing in moonlight."}, {"versions": ["omega-ruby"], "text": "During the daytime, Oddish buries itself in soil to absorb nutrients from the ground using its entire body. The more fertile the soil, the glossier its leaves become."}, {"versions": ["alpha-sapphire"], "text": "Oddish searches for fertile, nutrient-rich soil, then plants itself. During the daytime, while it is planted, this Pokémon’s feet are thought to change shape and become similar to the roots of trees."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/43.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/43.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/43.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/43.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/43.png", "shiny": "https://raw.gith