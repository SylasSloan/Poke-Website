{"height": 12, "weight": 333, "base_experience": 168, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Rabbit Pokémon", "capture_rate": 60, "base_happiness": 140, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground", "humanshape"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ミミロップ"}, {"language": "ja-roma", "name": "Mimilop"}, {"language": "ko", "name": "이어롭"}, {"language": "zh-hant", "name": "長耳兔"}, {"language": "fr", "name": "Lockpin"}, {"language": "de", "name": "Schlapor"}, {"language": "es", "name": "Lopunny"}, {"language": "it", "name": "Lopunny"}, {"language": "ja", "name": "ミミロップ"}, {"language": "zh-hans", "name": "长耳兔"}, {"language": "es-419", "name": "Lopunny"}], "pokedex_entries": [{"versions": ["diamond"], "text": "An extremely cautious Pokémon. It cloaks its body with its fluffy ear fur when it senses danger."}, {"versions": ["pearl"], "text": "It is very conscious of its looks and never fails to groom its ears. It runs with sprightly jumps."}, {"versions": ["platinum", "black", "white", "y", "alpha-sapphire"], "text": "The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs."}, {"versions": ["heartgold", "soulsilver"], "text": "It sheds its fur twice a year. Its winter fur is soft and fluffy."}, {"versions": ["black-2", "white-2", "x", "omega-ruby"], "text": "Extremely cautious, it quickly bounds off when it senses danger."}, {"versions": ["ultra-sun"], "text": "Lopunny regrows its coat twice a year. Mufflers and hats made from its fur are really warm."}, {"versions": ["ultra-moon"], "text": "It’s notably wary and has a dislike of fighting, but at the same time, it can deliver powerful kicks with its lithe legs."}, {"versions": ["sword"], "text": "Lopunny is constantly monitoring its surroundings. If danger approaches, this Pokémon responds with superdestructive kicks."}, {"versions": ["shield"], "text": "Once hot seasons are over, Lopunny’s coat will be replaced with fur that holds a lot of insulating air in preparation for colder weather."}, {"versions": ["legends-arceus"], "text": "Its fur is warm and yet remarkably light. This Pokémon kicks as though it were a master of karate, driving back its opponents with ease."}], "sprites_by_gen": {"generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/428.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/428.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/428.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/428.png"}, "platinum": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/428.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/platinum/shiny/428.png"}}, "generation-v": {"black-white": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/428.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/shiny/428.png"}}, "generation-vi": {"omegaruby-alphasapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/428.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/omegaruby-alphasapphire/shiny/428.png"}, "x-y": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-vi/x-y/428.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/vers