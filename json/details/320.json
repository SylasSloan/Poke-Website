{"height": 20, "weight": 1300, "base_experience": 80, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Ball Whale Pokémon", "capture_rate": 125, "base_happiness": 70, "hatch_counter": 40, "growth_rate": "fast-then-very-slow", "egg_groups": ["ground", "water2"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ホエルコ"}, {"language": "ja-roma", "name": "Hoeruko"}, {"language": "ko", "name": "고래왕자"}, {"language": "zh-hant", "name": "吼吼鯨"}, {"language": "fr", "name": "Wailmer"}, {"language": "de", "name": "Wailmer"}, {"language": "es", "name": "Wailmer"}, {"language": "it", "name": "Wailmer"}, {"language": "ja", "name": "ホエルコ"}, {"language": "zh-hans", "name": "吼吼鲸"}, {"language": "es-419", "name": "Wailmer"}], "pokedex_entries": [{"versions": ["ruby"], "text": "WAILMER’s nostrils are located above its eyes. This playful POKéMON loves to startle people by forcefully snorting out seawater it stores inside its body out of its nostrils."}, {"versions": ["sapphire"], "text": "WAILMER can store water inside its body to transform itself into a ball for bouncing around on the ground. By filling itself up with more water, this POKéMON can elevate the height of its bounces."}, {"versions": ["emerald"], "text": "While this POKéMON usually lives in the sea, it can survive on land, although not too long. It loses vitality if its body becomes dried out."}, {"versions": ["firered", "leafgreen", "shield"], "text": "When it sucks in a large volume of seawater, it becomes like a big, bouncy ball. It eats a ton of food daily."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "On sunny days, it lands on beaches to bounce like a ball and play. It spouts water from its nose."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "It bounces playfully like a ball. The more seawater it swallows, the higher it bounces."}, {"versions": ["black-2", "white-2", "y"], "text": "It eats one ton of food every day. It plays by shooting stored seawater out its blowholes with great force."}, {"versions": ["omega-ruby"], "text": "Wailmer’s nostrils are located above its eyes. This playful Pokémon loves to startle people by forcefully snorting out seawater it stores inside its body out of its nostrils."}, {"versions": ["alpha-sapphire"], "text": "Wailmer can store water inside its body to transform itself into a ball for bouncing around on the ground. By filling itself up with more water, this Pokémon can elevate the height of its bounces."}, {"versions": ["sun"], "text": "It loves to startle people. It fills itself up with seawater and plays by bouncing around like a ball."}, {"versions": ["moon", "sword"], "text": "It shows off by spraying jets of seawater from the nostrils above its eyes. It eats a solid ton of Wishiwashi every day."}, {"versions": ["ultra-sun"], "text": "It swims along with its mouth open and swallows down seawater along with its food. It sprays excess water out of its nostrils."}, {"versions": ["ultra-moon"], "text": "Due to their memories of when they once lived on land, pods of them will, very rarely, wash up on shore."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/320.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/320.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/320.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/320.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/320.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/320.pn