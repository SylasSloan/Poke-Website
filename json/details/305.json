{"height": 9, "weight": 1200, "base_experience": 151, "ev_yield": [{"stat": "defense", "value": 2}], "genus": "Iron Armor Pokémon", "capture_rate": 90, "base_happiness": 35, "hatch_counter": 35, "growth_rate": "slow", "egg_groups": ["monster"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "コドラ"}, {"language": "ja-roma", "name": "Kodora"}, {"language": "ko", "name": "갱도라"}, {"language": "zh-hant", "name": "可多拉"}, {"language": "fr", "name": "Galegon"}, {"language": "de", "name": "Stollrak"}, {"language": "es", "name": "Lairon"}, {"language": "it", "name": "Lairon"}, {"language": "ja", "name": "コドラ"}, {"language": "zh-hans", "name": "可多拉"}, {"language": "es-419", "name": "Lairon"}], "pokedex_entries": [{"versions": ["ruby"], "text": "LAIRON tempers its steel body by drinking highly nutritious mineral springwater until it is bloated. This POKéMON makes its nest close to springs of delicious water."}, {"versions": ["sapphire"], "text": "LAIRON feeds on iron contained in rocks and water. It makes its nest on mountains where iron ore is buried. As a result, the POKéMON often clashes with humans mining the iron ore."}, {"versions": ["emerald"], "text": "When two LAIRON meet in the wild, they fight for territory by bashing into each other with their steel bodies. The sound of their collision carries for miles."}, {"versions": ["firered", "leafgreen", "y"], "text": "It habitually shows off its strength with the size of sparks it creates by ramming its steel body into boulders."}, {"versions": ["diamond", "pearl", "platinum", "black", "white"], "text": "For food, it digs up iron ore. It smashes its steely body against others to fight over territory."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "It loves iron ore. Groups of them fight for territory by bashing one another with their steel bodies."}, {"versions": ["black-2", "white-2"], "text": "Lairon fight over territory, and when their steel bodies collide, sparks fly."}, {"versions": ["omega-ruby"], "text": "Lairon tempers its steel body by drinking highly nutritious mineral springwater until it is bloated. This Pokémon makes its nest close to springs of delicious water."}, {"versions": ["alpha-sapphire"], "text": "Lairon feeds on iron contained in rocks and water. It makes its nest on mountains where iron ore is buried. As a result, the Pokémon often clashes with humans mining the iron ore."}, {"versions": ["sword"], "text": "Lairon live in mountains brimming with spring water and iron ore, so these Pokémon often came into conflict with humans in the past."}, {"versions": ["shield"], "text": "During territorial disputes, Lairon fight by slamming into each other. Close inspection of their steel armor reveals scratches and dents."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/305.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/305.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/305.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/305.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/305.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/305.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/305.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/shiny/305.png"}, "platinum": {"normal": "https://raw.github