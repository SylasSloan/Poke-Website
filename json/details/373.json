{"height": 15, "weight": 1026, "base_experience": 270, "ev_yield": [{"stat": "attack", "value": 3}], "genus": "Dragon Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 40, "growth_rate": "slow", "egg_groups": ["dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ボーマンダ"}, {"language": "ja-roma", "name": "Bohmander"}, {"language": "ko", "name": "보만다"}, {"language": "zh-hant", "name": "暴飛龍"}, {"language": "fr", "name": "Drattak"}, {"language": "de", "name": "Brutalanda"}, {"language": "es", "name": "Salamence"}, {"language": "it", "name": "Salamence"}, {"language": "ja", "name": "ボーマンダ"}, {"language": "zh-hans", "name": "暴飞龙"}, {"language": "es-419", "name": "Salamence"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SALAMENCE came about as a result of a strong, long-held dream of growing wings. It is said that this powerful desire triggered a sudden mutation in this POKéMON’s cells, causing it to sprout its magnificent wings."}, {"versions": ["sapphire"], "text": "By evolving into SALAMENCE, this POKéMON finally realizes its long-held dream of growing wings. To express its joy, it flies and wheels all over the sky while spouting flames from its mouth."}, {"versions": ["emerald"], "text": "After many long years, its cellular structure underwent a sudden mutation to grow wings. When angered, it loses all thought and rampages out of control."}, {"versions": ["firered", "leafgreen", "x"], "text": "It becomes uncontrollable if it is enraged. It destroys everything with shredding claws and fire."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "As a result of its long-held dream of flying, its cellular structure changed, and wings grew out."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It’s uncontrollable if enraged. It flies around spouting flames and scorching fields and mountains."}, {"versions": ["omega-ruby"], "text": "Salamence came about as a result of a strong, long-held dream of growing wings. It is said that this powerful desire triggered a sudden mutation in this Pokémon’s cells, causing it to sprout its magnificent wings."}, {"versions": ["alpha-sapphire"], "text": "By evolving into Salamence, this Pokémon finally realizes its long-held dream of growing wings. To express its joy, it flies and wheels all over the sky while spouting flames from its mouth."}, {"versions": ["sun"], "text": "When angered, it loses all sense of itself and destroys everything around it. The destruction will continue until Salamence has tired itself out."}, {"versions": ["moon"], "text": "It flies around on its wings, which have grown in at last. In its happiness, it gushes hot flames, burning up the fields it passes over."}, {"versions": ["ultra-sun"], "text": "Overjoyed at finally being able to fly, it flies all over the place and usually doesn’t land until it’s completely exhausted and needs to sleep."}, {"versions": ["ultra-moon"], "text": "Thanks to its fervent wishes, the cells in its body finally mutated, and at last it has its heart’s desire—wings."}, {"versions": ["sword"], "text": "Salamence is an unusual Pokémon in that it was able to evolve a body with wings just by constantly wishing to be able to fly."}, {"versions": ["shield"], "text": "While basking in the joy of flight generally keeps this Pokémon in high spirits, Salamence turns into an uncontrollable menace if something angers it."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/373.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/373.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/373.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions