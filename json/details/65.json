{"height": 15, "weight": 480, "base_experience": 225, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Psi Pokémon", "capture_rate": 50, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium-slow", "egg_groups": ["humanshape"], "gender_rate": 2, "names": [{"language": "ja-hrkt", "name": "フーディン"}, {"language": "ja-roma", "name": "Foodin"}, {"language": "ko", "name": "후딘"}, {"language": "zh-hant", "name": "胡地"}, {"language": "fr", "name": "Alakazam"}, {"language": "de", "name": "Simsala"}, {"language": "es", "name": "Alakazam"}, {"language": "it", "name": "Alakazam"}, {"language": "ja", "name": "フーディン"}, {"language": "zh-hans", "name": "胡地"}, {"language": "es-419", "name": "Alakazam"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "Its brain can out­ perform a super­ computer. Its intelligence quotient is said to be 5,000."}, {"versions": ["yellow"], "text": "A POKéMON that can memorize anything. It never forgets what it learns-- that's why this POKéMON is smart."}, {"versions": ["gold", "heartgold"], "text": "Closing both its eyes heightens all its other senses. This enables it to use its abilities to their extremes."}, {"versions": ["silver"], "text": "Its brain cells multiply continu­ ally until it dies. As a result, it remembers everything."}, {"versions": ["crystal"], "text": "It has an IQ of 5000. It calcu­ lates many things in order to gain the edge in every battle."}, {"versions": ["ruby"], "text": "ALAKAZAM’s brain continually grows, making its head far too heavy to support with its neck. This POKéMON holds its head up using its psychokinetic power instead."}, {"versions": ["sapphire"], "text": "ALAKAZAM’s brain continually grows, infinitely multiplying brain cells. This amazing brain gives this POKéMON an astoundingly high IQ of 5,000. It has a thorough memory of everything that has occurred in the world."}, {"versions": ["emerald"], "text": "While it has strong psychic abilities and high intelligence, an ALAKAZAM’s muscles are very weak. It uses psychic power to move its body."}, {"versions": ["firered"], "text": "It does not like physical attacks very much. Instead, it freely uses extra­ sensory powers to defeat foes."}, {"versions": ["leafgreen", "y"], "text": "Its brain can outperform a supercomputer. Its IQ (intelligence quotient) is said to be around 5,000."}, {"versions": ["diamond"], "text": "Its superb memory lets it recall everything it has experienced from birth. Its IQ exceeds 5,000."}, {"versions": ["pearl"], "text": "Its highly developed brain is on par with a supercomputer. It can use all forms of psychic abilities."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "The spoons clutched in its hands are said to have been created by its psychic powers."}, {"versions": ["soulsilver", "x"], "text": "Its brain cells multiply continually until it dies. As a result, it remembers everything."}, {"versions": ["omega-ruby"], "text": "Alakazam’s brain continually grows, making its head far too heavy to support with its neck. This Pokémon holds its head up using its psychokinetic power instead."}, {"versions": ["alpha-sapphire"], "text": "Alakazam’s brain continually grows, infinitely multiplying brain cells. This amazing brain gives this Pokémon an astoundingly high IQ of 5,000. It has a thorough memory of everything that has occurred in the world."}, {"versions": ["sun"], "text": "It is said to have an IQ of approximately 5,000. Its overflowing psychokinetic powers cause headaches to anyone nearby."}, {"versions": ["moon"], "text": "Its brain cells continue to increase in number until its death. The older the Alakazam, the larger its head."}, {"versions": ["ultra-sun"], "text": "Alakazam uses its psychic powers to make the spoons it carries. Each spoon is an original that there’s only one of in the whole world."}, {"versions": ["ultra-moon"], "text": "If it trusts someone deeply, it will let them have one of its spoons. Anything you eat with that spoon is apparently delicious."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A Pokémon that can memorize anything. It never forgets what it learns—that’s why this Pokémon is smart."}, {"versions": ["sword"], "text": "It has an incredibly high level of intelligence. Some say that Alakazam remembers everything that ever happens to it, from birth till death."}, {"versions": ["shield"], "text": "Alakazam wields potent psychic powers. It’s said that this Pokémon used these powers to create the spoons it holds."}, {"versions": ["legends-arceus"], "text": "The longer Alakazam lives, the larger and heavier its head becomes. Our tests have shown that the strength of its psychic powers correlates positively to the weight of its head."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/65.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/65.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/65.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/65.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/65.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/65.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/65.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/65.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sp