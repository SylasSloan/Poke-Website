{"height": 7, "weight": 177, "base_experience": 151, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Firefly Pokémon", "capture_rate": 150, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "slow-then-very-fast", "egg_groups": ["bug", "humanshape"], "gender_rate": 0, "names": [{"language": "ja-hrkt", "name": "バルビート"}, {"language": "ja-roma", "name": "Barubeat"}, {"language": "ko", "name": "볼비트"}, {"language": "zh-hant", "name": "電螢蟲"}, {"language": "fr", "name": "Muciole"}, {"language": "de", "name": "Volbeat"}, {"language": "es", "name": "Volbeat"}, {"language": "it", "name": "Volbeat"}, {"language": "ja", "name": "バルビート"}, {"language": "zh-hans", "name": "电萤虫"}, {"language": "es-419", "name": "Volbeat"}], "pokedex_entries": [{"versions": ["ruby"], "text": "With the arrival of night, VOLBEAT emits light from its tail. It communicates with others by adjusting the intensity and flashing of its light. This POKéMON is attracted by the sweet aroma of ILLUMISE."}, {"versions": ["sapphire"], "text": "VOLBEAT’s tail glows like a lightbulb. With other VOLBEAT, it uses its tail to draw geometric shapes in the night sky. This POKéMON loves the sweet aroma given off by ILLUMISE."}, {"versions": ["emerald"], "text": "With their taillights lit, VOLBEAT fly in a swarm, drawing geometric designs in the night sky. They move their nests if their pond water becomes dirty."}, {"versions": ["firered", "leafgreen", "y"], "text": "It lives around clean ponds. At night, its rear lights up. It converses with others by flashing its light."}, {"versions": ["diamond", "pearl", "platinum"], "text": "It communicates with others by lighting up its rear at night. It loves ILLUMISE’s sweet aroma."}, {"versions": ["heartgold", "soulsilver"], "text": "It emits light from its tail to communicate. It loves the sweet aroma given off by ILLUMISE."}, {"versions": ["black", "white", "black-2", "white-2", "x"], "text": "It communicates with others by lighting up its rear at night. It loves I