{"height": 4, "weight": 60, "base_experience": 112, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Mouse Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "medium", "egg_groups": ["ground", "fairy"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ピカチュウ"}, {"language": "ja-roma", "name": "Pikachu"}, {"language": "ko", "name": "피카츄"}, {"language": "zh-hant", "name": "皮卡丘"}, {"language": "fr", "name": "Pikachu"}, {"language": "de", "name": "Pikachu"}, {"language": "es", "name": "Pikachu"}, {"language": "it", "name": "Pikachu"}, {"language": "ja", "name": "ピカチュウ"}, {"language": "zh-hans", "name": "皮卡丘"}, {"language": "es-419", "name": "Pikachu"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "When several of these POKéMON gather, their electricity could build and cause lightning storms."}, {"versions": ["yellow"], "text": "It keeps its tail raised to monitor its surroundings. If you yank its tail, it will try to bite you."}, {"versions": ["gold"], "text": "This intelligent POKéMON roasts hard BERRIES with electricity to make them tender enough to eat."}, {"versions": ["silver"], "text": "It raises its tail to check its sur­ roundings. The tail is sometimes struck by light­ ning in this pose."}, {"versions": ["crystal"], "text": "When it is anger­ ed, it immediately discharges the energy stored in the pouches in its cheeks."}, {"versions": ["ruby"], "text": "Whenever PIKACHU comes across something new, it blasts it with a jolt of electricity. If you come across a blackened berry, it’s evidence that this POKéMON mistook the intensity of its charge."}, {"versions": ["sapphire"], "text": "This POKéMON has electricity-storing pouches on its cheeks. These appear to become electrically charged during the night while PIKACHU sleeps. It occasionally discharges electricity when it is dozy after waking up."}, {"versions": ["emerald"], "text": "It stores electricity in the electric sacs on its cheeks. When it releases pent-up energy in a burst, the electric power is equal to a lightning bolt."}, {"versions": ["firered", "y"], "text": "It has small electric sacs on both its cheeks. If threatened, it looses electric charges from the sacs."}, {"versions": ["leafgreen"], "text": "When several of these POKéMON gather, their electricity can build and cause lightning storms."}, {"versions": ["diamond"], "text": "It lives in forests with others. It stores electricity in the pouches on its cheeks."}, {"versions": ["pearl"], "text": "If it looses crackling power from the electric pouches on its cheeks, it is being wary."}, {"versions": ["platinum"], "text": "It occasionally uses an electric shock to recharge a fellow PIKACHU that is in a weakened state."}, {"versions": ["heartgold"], "text": "This intelligent Pokémon roasts hard berries with electricity to make them tender enough to eat."}, {"versions": ["soulsilver", "x"], "text": "It raises its tail to check its surroundings. The tail is sometimes struck by lightning in this pose."}, {"versions": ["black", "white", "black-2", "white-2"], "text": "It occasionally uses an electric shock to recharge a fellow Pikachu that is in a weakened state."}, {"versions": ["omega-ruby"], "text": "Whenever Pikachu comes across something new, it blasts it with a jolt of electricity. If you come across a blackened berry, it’s evidence that this Pokémon mistook the intensity of its charge."}, {"versions": ["alpha-sapphire"], "text": "This Pokémon has electricity-storing pouches on its cheeks. These appear to become electrically charged during the night while Pikachu sleeps. It occasionally discharges electricity when it is dozy after waking up."}, {"versions": ["sun"], "text": "A plan was recently announced to gather many Pikachu and make an electric power plant."}, {"versions": ["moon"], "text": "It’s in its nature to store electricity. It feels stressed now and then if it’s unable to fully discharge the electricity."}, {"versions": ["ultra-sun"], "text": "Its nature is to store up electricity. Forests where nests of Pikachu live are dangerous, since the trees are so often struck by lightning."}, {"versions": ["ultra-moon"], "text": "While sleeping, it generates electricity in the sacs in its cheeks. If it’s not getting enough sleep, it will be able to use only weak electricity."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "This forest-dwelling Pokémon stores electricity in its cheeks, so you’ll feel a tingly shock if you touch it."}, {"versions": ["sword"], "text": "Pikachu that can generate powerful electricity have cheek sacs that are extra soft and super stretchy."}, {"versions": ["shield"], "text": "When Pikachu meet, they’ll touch their tails together and exchange electricity through them as a form of greeting."}, {"versions": ["legends-arceus"], "text": "Possesses cheek sacs in which it stores electricity. This clever forest-dweller roasts tough berries with an electric shock before consuming them."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/25.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/25.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/25.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/25.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/25.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/25.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/s