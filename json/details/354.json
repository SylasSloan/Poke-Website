{"height": 11, "weight": 125, "base_experience": 159, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Marionette Pokémon", "capture_rate": 45, "base_happiness": 35, "hatch_counter": 25, "growth_rate": "fast", "egg_groups": ["indeterminate"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ジュペッタ"}, {"language": "ja-roma", "name": "Juppeta"}, {"language": "ko", "name": "다크펫"}, {"language": "zh-hant", "name": "詛咒娃娃"}, {"language": "fr", "name": "Branette"}, {"language": "de", "name": "Banette"}, {"language": "es", "name": "Banette"}, {"language": "it", "name": "Banette"}, {"language": "ja", "name": "ジュペッタ"}, {"language": "zh-hans", "name": "诅咒娃娃"}, {"language": "es-419", "name": "Banette"}], "pokedex_entries": [{"versions": ["diamond", "pearl", "platinum", "black", "white", "x"], "text": "A doll that became a Pokémon over its grudge from being junked. It seeks the child that disowned it."}, {"versions": ["ruby"], "text": "BANETTE generates energy for laying strong curses by sticking pins into its own body. This POKéMON was originally a pitiful plush doll that was thrown away."}, {"versions": ["sapphire"], "text": "A cursed energy permeated the stuffing of a discarded and forgotten plush doll, giving it new life as BANETTE. The POKéMON’s energy would escape if it were to ever open its mouth."}, {"versions": ["emerald"], "text": "An abandoned plush doll became this POKéMON. They are said to live in garbage dumps and wander about in search of the children that threw them away."}, {"versions": ["firered", "leafgreen"], "text": "Strong feelings of hatred turned a puppet into a POKéMON. If it opens its mouth, its cursed energy escapes."}, {"versions": ["heartgold", "soulsilver"], "text": "This Pokémon developed from an abandoned doll that amassed a grudge. It is seen in dark alleys."}, {"versions": ["black-2", "white-2"], "text": "A doll that became a Pokémon over its grudge of being thrown away. It seeks the child who disowned it."}, {"versions": ["y"],