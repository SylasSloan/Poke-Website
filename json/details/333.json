{"height": 4, "weight": 12, "base_experience": 62, "ev_yield": [{"stat": "special-defense", "value": 1}], "genus": "Cotton Bird Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "slow-then-very-fast", "egg_groups": ["flying", "dragon"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "チルット"}, {"language": "ja-roma", "name": "Tyltto"}, {"language": "ko", "name": "파비코"}, {"language": "zh-hant", "name": "青綿鳥"}, {"language": "fr", "name": "Tylton"}, {"language": "de", "name": "Wablu"}, {"language": "es", "name": "Swablu"}, {"language": "it", "name": "Swablu"}, {"language": "ja", "name": "チルット"}, {"language": "zh-hans", "name": "青绵鸟"}, {"language": "es-419", "name": "Swablu"}], "pokedex_entries": [{"versions": ["ruby"], "text": "SWABLU has light and fluffy wings that are like cottony clouds. This POKéMON is not frightened of people. It lands on the heads of people and sits there like a cotton-fluff hat."}, {"versions": ["sapphire"], "text": "SWABLU loves to make things clean. If it spots something dirty, it will wipe and polish it with its cottony wings. If its wings become dirty, this POKéMON finds a stream and showers itself."}, {"versions": ["emerald"], "text": "A POKéMON that has wings like cottony clouds. After enduring winter, in which little food is available, SWABLU flocks move closer to towns in the spring."}, {"versions": ["firered", "leafgreen", "y"], "text": "It constantly grooms its cotton-like wings. It takes a shower to clean itself if it becomes dirty."}, {"versions": ["diamond", "pearl"], "text": "Its wings are like cotton tufts. If it perches on someone’s head, it looks like a cotton hat."}, {"versions": ["platinum", "black", "white"], "text": "It can’t relax if it or its surroundings are not clean. It wipes off dirt with its wings."}, {"versions": ["heartgold", "soulsilver"], "text": "Its wings bring cottony clouds to mind. It grooms with springwater and loves to sit on heads."}, {"versions": ["black-2", "white-2", "x"], "text": "For some reason, it likes to land on people’s heads softly and act like it’s a hat."}, {"versions": ["omega-ruby"], "text": "Swablu has light and fluffy wings that are like cottony clouds. This Pokémon is not frightened of people. It lands on the heads of people and sits there like a cotton-fluff hat."}, {"versions": ["alpha-sapphire"], "text": "Swablu loves to make things clean. If it spots something dirty, it will wipe and polish it with its cottony wings. If its wings become dirty, this Pokémon finds a stream and showers itself."}, {"versions": ["sword"], "text": "Its cottony wings are full of air, making them light and fluffy to the touch. Swablu takes diligent care of its wings."}, {"versions": ["shield"], "text": "Since Swablu looks like a cumulus cloud, foes can have a hard time finding it. Apparently its wings turned white over many generations."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/333.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/333.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/333.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/333.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/333.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/333.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/333.png", "shiny": "https://raw.githubuserconte