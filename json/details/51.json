{"height": 7, "weight": 333, "base_experience": 149, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Mole Pokémon", "capture_rate": 50, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ダグトリオ"}, {"language": "ja-roma", "name": "Dugtrio"}, {"language": "ko", "name": "닥트리오"}, {"language": "zh-hant", "name": "三地鼠"}, {"language": "fr", "name": "Triopikeur"}, {"language": "de", "name": "Digdri"}, {"language": "es", "name": "Dugtrio"}, {"language": "it", "name": "Dugtrio"}, {"language": "ja", "name": "ダグトリオ"}, {"language": "zh-hans", "name": "三地鼠"}, {"language": "es-419", "name": "Dugtrio"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "A team of DIGLETT triplets. It triggers huge earthquakes by burrowing 60 miles underground."}, {"versions": ["yellow"], "text": "A team of triplets that can burrow over 60 MPH. Due to this, some people think it's an earthquake."}, {"versions": ["gold", "heartgold"], "text": "Its three heads bob separately up and down to loosen the soil nearby, making it easier for it to burrow."}, {"versions": ["silver"], "text": "Extremely power­ ful, they can DIG through even the hardest ground to a depth of over 60 miles."}, {"versions": ["crystal"], "text": "These DIGLETT triplets dig over 60 miles below sea level. No one knows what it's like underground."}, {"versions": ["ruby", "sapphire"], "text": "DUGTRIO are actually triplets that emerged from one body. As a result, each triplet thinks exactly like the other two triplets. They work cooperatively to burrow endlessly."}, {"versions": ["emerald"], "text": "Because the triplets originally split from one body, they think exactly alike. They work cooperatively to burrow endlessly through the ground."}, {"versions": ["firered", "x"], "text": "In battle, it digs through the ground and strikes the unsuspecting foe from an unexpected direction."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2"], "text": "Its three heads move alternately, driving it through tough soil to depths of over 60 miles."}, {"versions": ["soulsilver", "y"], "text": "Extremely powerful, they can dig through even the hardest ground to a depth of over 60 miles."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Dugtrio are actually triplets that emerged from one body. As a result, each triplet thinks exactly like the other two triplets. They work cooperatively to burrow endlessly."}, {"versions": ["sun"], "text": "This set of triplets moves cooperatively. It’s the power of teamwork that enables this Pokémon to dig to a depth of 60 miles."}, {"versions": ["moon"], "text": "Despite the closeness between this Pokémon and farmers and other people, no one has ever seen the parts of it concealed underground."}, {"versions": ["ultra-sun"], "text": "While the three of them normally get along splendidly, on rare occasions a huge fight will break out over which head gets to eat first."}, {"versions": ["ultra-moon"], "text": "Dugtrio’s heads are sleek and smooth and incredibly hard. It can dig through any soil with its headbutts."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "A team of triplets that can burrow to a depth of 60 miles. It’s reported that this triggers an earthquake."}, {"versions": ["sword"], "text": "A team of Diglett triplets. It triggers huge earthquakes by burrowing 60 miles underground."}, {"versions": ["shield"], "text": "These Diglett triplets dig over 60 miles below sea level. No one knows what it’s like underground."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/51.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/51.png", "shiny": null}}, "generation-ii": {"crystal": {"norm