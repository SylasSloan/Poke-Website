{"height": 3, "weight": 20, "base_experience": 41, "ev_yield": [{"stat": "speed", "value": 1}], "genus": "Tiny Mouse Pokémon", "capture_rate": 190, "base_happiness": 70, "hatch_counter": 10, "growth_rate": "medium", "egg_groups": ["no-eggs"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ピチュー"}, {"language": "ja-roma", "name": "Pichu"}, {"language": "ko", "name": "피츄"}, {"language": "zh-hant", "name": "皮丘"}, {"language": "fr", "name": "Pichu"}, {"language": "de", "name": "Pichu"}, {"language": "es", "name": "Pichu"}, {"language": "it", "name": "Pichu"}, {"language": "ja", "name": "ピチュー"}, {"language": "zh-hans", "name": "皮丘"}, {"language": "es-419", "name": "Pichu"}], "pokedex_entries": [{"versions": ["gold", "leafgreen", "heartgold", "y"], "text": "It is not yet skilled at storing electricity. It may send out a jolt if amused or startled."}, {"versions": ["silver", "firered", "soulsilver", "sword"], "text": "Despite its small size, it can zap even adult humans. However, if it does so, it also surprises itself."}, {"versions": ["crystal"], "text": "It is unskilled at storing electric power. Any kind of shock causes it to discharge energy spontaneously."}, {"versions": ["ruby"], "text": "PICHU charges itself with electricity more easily on days with thunderclouds or when the air is very dry. You can hear the crackling of static electricity coming off this POKéMON."}, {"versions": ["sapphire"], "text": "When PICHU plays with others, it may short out electricity with another PICHU, creating a shower of sparks. In that event, this POKéMON will begin crying, startled by the flash of sparks."}, {"versions": ["emerald"], "text": "It is still inept at retaining electricity. When it is startled, it discharges power accidentally. It gets better at holding power as it grows older."}, {"versions": ["diamond"], "text": "The electric pouches on its cheeks are still small. They cannot store much electricity yet."}, {"versions": ["pearl", "x"], "text": "It plays with others by touching tails and setting off sparks. This appears to be a test of courage."}, {"versions": ["platinum", "black", "white", "black-2", "white-2", "shield"], "text": "The electric sacs in its cheeks are small. If even a little electricity leaks, it becomes shocked."}, {"versions": ["omega-ruby"], "text": "Pichu charges itself with electricity more easily on days with thunderclouds or when the air is very dry. You can hear the crackling of static electricity coming off this Pokémon."}, {"versions": ["alpha-sapphire"], "text": "When Pichu plays with others, it may short out electricity with another Pichu, creating a shower of sparks. In that event, this Pokémon will begin crying, startled by the flash of sparks."}, {"versions": ["sun"], "text": "It is not yet skilled at controlling electricity. If you take your eyes off it, it may shock itself."}, {"versions": ["moon"], "text": "Despite this Pokémon’s cute appearance, those who want to live with one should prepare to be on the receiving end of its electric jolts."}, {"versions": ["ultra-sun"], "text": "It still can’t use electricity well. When it’s surprised or excited, it discharges electricity unintentionally."}, {"versions": ["ultra-moon"], "text": "It has electric sacs in its cheeks. When they’re fully charged, Pichu plays very energetically."}, {"versions": ["legends-arceus"], "text": "Pichu stores electricity in the sacs on its cheeks but discharges it inadvertently when agitated or excited. Being yet immature, the Pokémon's handling of electricity is rather inept."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/172.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/172.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/172.png", "shin