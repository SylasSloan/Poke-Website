{"height": 14, "weight": 487, "base_experience": 158, "ev_yield": [{"stat": "attack", "value": 2}], "genus": "Fairy Pokémon", "capture_rate": 75, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "fast", "egg_groups": ["ground", "fairy"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "グランブル"}, {"language": "ja-roma", "name": "Granbulu"}, {"language": "ko", "name": "그랑블루"}, {"language": "zh-hant", "name": "布魯皇"}, {"language": "fr", "name": "Granbull"}, {"language": "de", "name": "Granbull"}, {"language": "es", "name": "Granbull"}, {"language": "it", "name": "Granbull"}, {"language": "ja", "name": "グランブル"}, {"language": "zh-hans", "name": "布鲁皇"}, {"language": "es-419", "name": "Granbull"}], "pokedex_entries": [{"versions": ["gold"], "text": "It is actually timid and easily spooked. If at­ tacked, it flails about to fend off its attacker."}, {"versions": ["silver", "firered"], "text": "Because its fangs are too heavy, it always keeps its head tilted down. However, its BITE is powerful."}, {"versions": ["crystal"], "text": "It can make most any POKéMON run away simply by opening its mouth wide to reveal its big fangs."}, {"versions": ["ruby", "sapphire"], "text": "GRANBULL has a particularly well- developed lower jaw. The enormous fangs are heavy, causing the POKéMON to tip its head back for balance. Unless it is startled, it will not try to bite indiscriminately."}, {"versions": ["emerald"], "text": "It has a particularly well-developed lower jaw. The huge fangs are heavy, causing it to tilt its head. Unless it is startled, it will not try to bite."}, {"versions": ["leafgreen", "heartgold"], "text": "It is actually timid and easily spooked. If attacked, it flails about to fend off its attacker."}, {"versions": ["diamond", "pearl", "platinum", "black", "white", "black-2", "white-2", "x"], "text": "It is timid in spite of its looks. If it becomes enraged, however, it will strike with its huge fangs."}, {"versions": ["soulsilver"], "text": "Because its fangs are too heavy, it always keeps its head tilted down. However, its bite is powerful."}, {"versions": ["y"], "text": "It can make most any Pokémon run away simply by opening its mouth wide to reveal its big fangs."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Granbull has a particularly well-developed lower jaw. The enormous fangs are heavy, causing the Pokémon to tip its head back for balance. Unless it is startled, it will not try to bite indiscriminately."}, {"versions": ["sun"], "text": "Its well-developed lower jaw and heavy fangs are its weapons. As long as it’s not provoked, it rarely bites."}, {"versions": ["moon"], "text": "More timid than Snubbull, this Pokémon is doted on by young people amused at the contrast between its looks and its attitude."}, {"versions": ["ultra-sun"], "text": "While it has powerful jaws, it doesn’t care for disputes, so it rarely has a chance to display their might."}, {"versions": ["ultra-moon"], "text": "Although it’s popular with young people, Granbull is timid and sensitive, so it’s totally incompetent as a watchdog."}], "sprites_by_gen": {"generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/210.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/210.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/210.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/210.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/210.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/210.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.c