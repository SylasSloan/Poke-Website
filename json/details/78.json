{"height": 17, "weight": 950, "base_experience": 175, "ev_yield": [{"stat": "speed", "value": 2}], "genus": "Fire Horse Pokémon", "capture_rate": 60, "base_happiness": 70, "hatch_counter": 20, "growth_rate": "medium", "egg_groups": ["ground"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ギャロップ"}, {"language": "ja-roma", "name": "Gallop"}, {"language": "ko", "name": "날쌩마"}, {"language": "zh-hant", "name": "烈焰馬"}, {"language": "fr", "name": "Galopa"}, {"language": "de", "name": "Gallopa"}, {"language": "es", "name": "Rapidash"}, {"language": "it", "name": "Rapidash"}, {"language": "ja", "name": "ギャロップ"}, {"language": "zh-hans", "name": "烈焰马"}, {"language": "es-419", "name": "Rapidash"}], "pokedex_entries": [{"versions": ["red", "blue", "leafgreen"], "text": "Very competitive, this POKéMON will chase anything that moves fast in the hopes of racing it."}, {"versions": ["yellow"], "text": "Just loves to run. If it sees some­ thing faster than itself, it will give chase at top speed."}, {"versions": ["gold"], "text": "At full gallop, its four hooves barely touch the ground because it moves so incredi­ bly fast."}, {"versions": ["silver"], "text": "With incredible acceleration, it reaches its top speed of 150 mph after running just ten steps."}, {"versions": ["crystal"], "text": "It just loves to gallop. The faster it goes, the long­ er the swaying flames of its mane will become."}, {"versions": ["ruby", "sapphire"], "text": "RAPIDASH usually can be seen casually cantering in the fields and plains. However, when this POKéMON turns serious, its fiery manes flare and blaze as it gallops its way up to 150 mph."}, {"versions": ["emerald"], "text": "It usually canters casually in the fields and plains. But once a RAPIDASH turns serious, its fiery manes flare and blaze as it gallops its way up to 150 mph."}, {"versions": ["firered"], "text": "It can gallop at a top speed of 150 miles per hour. It can race as fast as a bullet train while ablaze."}, {"versions": ["diamond", "y"], "text": "It gallops at nearly 150 mph. With its mane blazing ferociously, it races as if it were an arrow."}, {"versions": ["pearl"], "text": "It has astounding acceleration. From a standstill, it can reach top speed within 10 steps."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "When at an all-out gallop, its blazing mane sparkles, enhancing its beautiful appearance."}, {"versions": ["heartgold"], "text": "At full gallop, its four hooves barely touch the ground because it moves so incredibly fast."}, {"versions": ["soulsilver"], "text": "With incredible acceleration, it reaches its top speed of 150 mph after running just 10 steps."}, {"versions": ["x"], "text": "Very competitive, this Pokémon will chase anything that moves fast in the hopes of racing it."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Rapidash usually can be seen casually cantering in the fields and plains. However, when this Pokémon turns serious, its fiery manes flare and blaze as it gallops its way up to 150 mph."}, {"versions": ["lets-go-pikachu", "lets-go-eevee"], "text": "Just loves to run. If it sees something faster than itself, it will give chase at top speed."}, {"versions": ["sword"], "text": "This Pokémon can be seen galloping through fields at speeds of up to 150 mph, its fiery mane fluttering in the wind."}, {"versions": ["shield"], "text": "The fastest runner becomes the leader, and it decides the herd’s pace and direction of travel."}, {"versions": ["legends-arceus"], "text": "Fiery mane aglow, Rapidash darts like an arrow across the land. This prodigiously swift creature can traverse the vast region of Hisui in a day and a half."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/78.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/gen