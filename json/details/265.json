{"height": 3, "weight": 36, "base_experience": 56, "ev_yield": [{"stat": "hp", "value": 1}], "genus": "Worm Pokémon", "capture_rate": 255, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "ケムッソ"}, {"language": "ja-roma", "name": "Kemusso"}, {"language": "ko", "name": "개무소"}, {"language": "zh-hant", "name": "刺尾蟲"}, {"language": "fr", "name": "Chenipotte"}, {"language": "de", "name": "Waumpel"}, {"language": "es", "name": "Wurmple"}, {"language": "it", "name": "Wurmple"}, {"language": "ja", "name": "ケムッソ"}, {"language": "zh-hans", "name": "刺尾虫"}, {"language": "es-419", "name": "Wurmple"}], "pokedex_entries": [{"versions": ["ruby"], "text": "Using the spikes on its rear end, WURMPLE peels the bark off trees and feeds on the sap that oozes out. This POKéMON’s feet are tipped with suction pads that allow it to cling to glass without slipping."}, {"versions": ["sapphire"], "text": "WURMPLE is targeted by SWELLOW as prey. This POKéMON will try to resist by pointing the spikes on its rear at the attacking predator. It will weaken the foe by leaking poison from the spikes."}, {"versions": ["emerald"], "text": "It sticks to tree branches and eats leaves. The thread it spits from its mouth, which becomes gooey when it touches air, slows the movement of its foes."}, {"versions": ["firered", "leafgreen"], "text": "It lives amidst tall grass and in forests. When attacked, it resists by pointing its venomous spikes at the foe."}, {"versions": ["diamond"], "text": "It loves to eat leaves. If it is attacked by a STARLY, it will defend itself with its spiked rear."}, {"versions": ["pearl"], "text": "It spits a white silk that turns sticky when it contacts air. It is used to immobilize foes."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Often targeted by bird Pokémon, it desperately resists by releasing poison from its tail spikes."}, {"versions": ["heartgold", "soulsilver", "y"], "text": "It lives among the tall grass and in forests. It repels attacks by raising up the spikes on its rear."}, {"versions": ["x"], "text": "It loves to eat leaves. If it is attacked by a Starly, it will defend itself with its spiked rear."}, {"versions": ["omega-ruby"], "text": "Using the spikes on its rear end, Wurmple peels the bark off trees and feeds on the sap that oozes out. This Pokémon’s feet are tipped with suction pads that allow it to cling to glass without slipping."}, {"versions": ["alpha-sapphire"], "text": "Wurmple is targeted by Swellow as prey. This Pokémon will try to resist by pointing the spikes on its rear at the attacking predator. It will weaken the foe by leaking poison from the spikes."}, {"versions": ["legends-arceus"], "text": "Likes sap and is abundant in the wild. Why it evolves into various different forms is unknown. One cannot tell from a Wurmple's appearance which form it will take when it evolves."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/265.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/265.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/265.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/265.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/265.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/265.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions