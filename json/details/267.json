{"height": 10, "weight": 284, "base_experience": 178, "ev_yield": [{"stat": "special-attack", "value": 3}], "genus": "Butterfly Pokémon", "capture_rate": 45, "base_happiness": 70, "hatch_counter": 15, "growth_rate": "medium", "egg_groups": ["bug"], "gender_rate": 4, "names": [{"language": "ja-hrkt", "name": "アゲハント"}, {"language": "ja-roma", "name": "Agehunt"}, {"language": "ko", "name": "뷰티플라이"}, {"language": "zh-hant", "name": "狩獵鳳蝶"}, {"language": "fr", "name": "Charmillon"}, {"language": "de", "name": "Papinella"}, {"language": "es", "name": "Beautifly"}, {"language": "it", "name": "Beautifly"}, {"language": "ja", "name": "アゲハント"}, {"language": "zh-hans", "name": "狩猎凤蝶"}, {"language": "es-419", "name": "Beautifly"}], "pokedex_entries": [{"versions": ["ruby"], "text": "BEAUTIFLY’s favorite food is the sweet pollen of flowers. If you want to see this POKéMON, just leave a potted flower by an open window. BEAUTIFLY is sure to come looking for pollen."}, {"versions": ["sapphire"], "text": "BEAUTIFLY has a long mouth like a coiled needle, which is very convenient for collecting pollen from flowers. This POKéMON rides the spring winds as it flits around gathering pollen."}, {"versions": ["emerald"], "text": "Its colorfully patterned wings are its most prominent feature. It flies through flower-covered fields collecting pollen. It attacks ferociously when angered."}, {"versions": ["firered", "leafgreen"], "text": "Despite its appearance, it has an aggressive nature. It attacks by jabbing with its long, thin mouth."}, {"versions": ["diamond", "y"], "text": "It has an aggressive nature. It stabs prey with its long, narrow mouth to drain the prey’s fluids."}, {"versions": ["pearl"], "text": "When flower fields bloom, it flits around, collecting pollen. Despite its appearance, it is savage."}, {"versions": ["platinum", "black", "white", "black-2", "white-2"], "text": "Despite its looks, it is aggressive. It jabs with its long, thin mouth if disturbed while collecting pollen."}, {"versions": ["heartgold", "soulsilver", "x"], "text": "Vibrantly patterned wings are its prominent feature. It sucks sweet flower nectar with its long mouth."}, {"versions": ["omega-ruby"], "text": "Beautifly’s favorite food is the sweet pollen of flowers. If you want to see this Pokémon, just leave a potted flower by an open window. Beautifly is sure to come looking for pollen."}, {"versions": ["alpha-sapphire"], "text": "Beautifly has a long mouth like a coiled needle, which is very convenient for collecting pollen from flowers. This Pokémon rides the spring winds as it flits around gathering pollen."}, {"versions": ["legends-arceus"], "text": "A colorful and incredibly beautiful but also greedy Pokémon. In an effort to keep its favorite food all to itself, it will chase away Combee as they try to gather nectar."}], "sprites_by_gen": {"generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/267.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/267.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/267.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/shiny/267.png"}}, "generation-iv": {"diamond-pearl": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/267.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/diamond-pearl/shiny/267.png"}, "heartgold-soulsilver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/267.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generati