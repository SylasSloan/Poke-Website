{"height": 13, "weight": 400, "base_experience": 217, "ev_yield": [{"stat": "hp", "value": 3}], "genus": "Fairy Pokémon", "capture_rate": 25, "base_happiness": 140, "hatch_counter": 10, "growth_rate": "fast", "egg_groups": ["fairy"], "gender_rate": 6, "names": [{"language": "ja-hrkt", "name": "ピクシー"}, {"language": "ja-roma", "name": "Pixy"}, {"language": "ko", "name": "픽시"}, {"language": "zh-hant", "name": "皮可西"}, {"language": "fr", "name": "Mélodelfe"}, {"language": "de", "name": "Pixi"}, {"language": "es", "name": "Clefable"}, {"language": "it", "name": "Clefable"}, {"language": "ja", "name": "ピクシー"}, {"language": "zh-hans", "name": "皮可西"}, {"language": "es-419", "name": "Clefable"}], "pokedex_entries": [{"versions": ["red", "blue"], "text": "A timid fairy POKéMON that is rarely seen. It will run and hide the moment it senses people."}, {"versions": ["yellow", "lets-go-pikachu", "lets-go-eevee"], "text": "They appear to be very protective of their own world. It is a kind of fairy, rarely seen by people."}, {"versions": ["gold", "heartgold"], "text": "With its acute hearing, it can pick up sounds from far away. It usually hides in quiet places."}, {"versions": ["silver"], "text": "Its very sensitive ears lets it dis­ tinguish distant sounds. As a re­ sult, it prefers quiet places."}, {"versions": ["crystal"], "text": "Said to live in quiet, remote mountains, this type of fairy has a strong aversion to being seen."}, {"versions": ["ruby", "sapphire"], "text": "CLEFABLE moves by skipping lightly as if it were flying using its wings. Its bouncy step lets it even walk on water. It is known to take strolls on lakes on quiet, moonlit nights."}, {"versions": ["emerald"], "text": "A CLEFABLE uses its wings to skip lightly as if it were flying. Its bouncy step lets it even walk on water. On quiet, moonlit nights, it strolls on lakes."}, {"versions": ["firered"], "text": "It has an acute sense of hearing. It can easily hear a pin being dropped nearly 1,100 yards away."}, {"versions": ["leafgreen"], "text": "A timid fairy POKéMON that is rarely seen, it will run and hide the moment it senses people."}, {"versions": ["diamond"], "text": "Rarely seen by people, it is said to be drawn by the full moon to play at deserted lakes."}, {"versions": ["pearl", "x"], "text": "Its hearing is so acute it can hear a pin drop over half a mile away. It lives on quiet mountains."}, {"versions": ["platinum", "black", "white"], "text": "It is very wary and rarely shows itself to people. Its ears can hear a pin drop over half a mile away."}, {"versions": ["soulsilver"], "text": "Its very sensitive ears let it distinguish distant sounds. As a result, it prefers quiet places."}, {"versions": ["black-2", "white-2", "shield"], "text": "Their ears are sensitive enough to hear a pin drop from over a mile away, so they’re usually found in quiet places."}, {"versions": ["y", "sword"], "text": "A timid fairy Pokémon that is rarely seen, it will run and hide the moment it senses people."}, {"versions": ["omega-ruby", "alpha-sapphire"], "text": "Clefable moves by skipping lightly as if it were flying using its wings. Its bouncy step lets it even walk on water. It is known to take strolls on lakes on quiet, moonlit nights."}, {"versions": ["sun"], "text": "They don’t like to reveal themselves in front of people. They live quietly in packs deep in the mountains."}, {"versions": ["moon"], "text": "According to tradition, people who see a pair of Clefable skipping by can look forward to a happy marriage."}, {"versions": ["ultra-sun"], "text": "It can’t help but hear a pin drop from over half a mile away, so it lives deep in the mountains where there aren’t many people or Pokémon."}, {"versions": ["ultra-moon"], "text": "Some scientists believe that it gazes intently at the sky on nights with a full moon because it’s homesick."}, {"versions": ["legends-arceus"], "text": "Legend says that on clear, quiet nights, it listens for the voices of its kin living on the moon. I, too, often think of my homeland, so far away."}], "sprites_by_gen": {"generation-i": {"red-blue": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/red-blue/36.png", "shiny": null}, "yellow": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-i/yellow/36.png", "shiny": null}}, "generation-ii": {"crystal": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/36.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/crystal/shiny/36.png"}, "gold": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/36.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/gold/shiny/36.png"}, "silver": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/36.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-ii/silver/shiny/36.png"}}, "generation-iii": {"emerald": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/36.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/emerald/shiny/36.png"}, "firered-leafgreen": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/36.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/firered-leafgreen/shiny/36.png"}, "ruby-sapphire": {"normal": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iii/ruby-sapphire/36.png", "shiny": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprite